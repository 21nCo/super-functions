{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "declaration": true, "declarationMap": true, "sourceMap": true, "outDir": "dist", "rootDir": "src",
    "skipLibCheck": true, "verbatimModuleSyntax": true, "types": ["node"]
  },
  "include": ["src/**/*.ts"], "exclude": ["dist", "node_modules", "src/**/*.test.ts"]
}
