{
  "name": "@mailfn/cli",
  "version": "0.1.0",
  "description": "Least-privilege command-line interface for MailFn",
  "type": "module",
  "bin": { "mailfn": "./dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "scripts": { "build": "tsc", "test": "vitest run", "typecheck": "tsc --noEmit", "lint": "tsc --noEmit", "clean": "rm -rf dist" },
  "keywords": ["mailfn", "email", "cli"],
  "author": "21n",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/21nCo/super-functions.git", "directory": "mailfn/cli" },
  "publishConfig": { "access": "public" },
  "dependencies": { "@clifn/core": "0.1.0", "@mailfn/client": "0.1.0" },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.6.0", "vitest": "3.2.4" }
}
