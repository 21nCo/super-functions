{
  "name": "@uifn/adapter-kit",
  "version": "0.0.1",
  "description": "Shared adapter helpers and conformance harness for uifn framework adapters",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run --config vitest.config.ts --pool=forks --maxWorkers=1 --minWorkers=1",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@uifn/core": "0.0.2"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "author": "21n",
  "license": "MIT",
  "engines": {
    "node": ">=20 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "uifn/adapter-kit"
  },
  "publishConfig": {
    "access": "public"
  },
  "uifn": {
    "status": "ga-candidate",
    "layer": "adapter-kit",
    "schemaVersion": 1,
    "sourcePolicy": "clean-room"
  }
}
