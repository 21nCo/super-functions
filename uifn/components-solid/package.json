{
  "name": "@uifn/components-solid",
  "version": "0.0.1",
  "description": "Framework-isolated Solid styled component boundary for uifn",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.mjs", "require": "./dist/index.js" }, "./*": { "types": "./dist/generated/*.d.ts", "import": "./dist/generated/*.mjs", "require": "./dist/generated/*.js" } },
  "scripts": {
    "generate": "node ../../scripts/generate-uifn-components.mjs --write",
    "generate:check": "node ../../scripts/generate-uifn-components.mjs --check",
    "build": "tsup src/index.ts src/generated/*.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run --config vitest.config.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run generate:check && npm run build"
  },
  "dependencies": { "@uifn/components": "0.0.1", "@uifn/solid": "0.0.1", "@uifn/recipes": "0.0.1" },
  "peerDependencies": { "solid-js": ">=1.9.0 <2" },
  "devDependencies": { "solid-js": "1.9.13", "tsup": "^8.0.0", "typescript": "^5.0.0", "vitest": "^3.2.4" },
  "files": ["dist", "README.md"],
  "author": "21n",
  "license": "MIT",
  "engines": { "node": ">=18 <23" },
  "repository": { "type": "git", "url": "git+https://github.com/21nCo/super-functions.git", "directory": "uifn/components-solid" },
  "publishConfig": { "access": "public" },
  "sideEffects": false,
  "uifn": { "status": "ga-candidate", "layer": "components-framework", "framework": "solid", "styling": "styled-open-compounds", "behaviorOwner": "@uifn/solid", "schemaVersion": 1, "sourcePolicy": "clean-room" }
}
