{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uifn-ownership.schema.json",
  "title": "uifn ownership ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ledgerId", "status", "principals", "defaults", "packages", "domServices", "primitiveFamilies", "releaseGates", "accessibility", "securityAndPerformance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ledgerId": { "const": "uifn-ownership-v1" },
    "status": { "const": "active" },
    "principals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "handle", "acceptedScope", "acceptanceEvidence", "escalation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["github-user", "github-team"] },
          "handle": { "type": "string", "pattern": "^@[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)?$" },
          "acceptedScope": { "type": "string", "minLength": 1 },
          "acceptanceEvidence": { "type": "string", "minLength": 1 },
          "escalation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "defectPolicy", "reviewCadenceDays"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "defectPolicy": { "const": "uifn-defect-and-evidence-policy" },
        "reviewCadenceDays": { "type": "integer", "minimum": 1, "maximum": 90 }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "reviewCadenceDays", "lifecycle"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "reviewCadenceDays": { "type": "integer", "minimum": 1, "maximum": 90 },
          "lifecycle": { "type": "string", "minLength": 1 }
        }
      }
    },
    "domServices": { "$ref": "#/$defs/ownedSurfaceList" },
    "primitiveFamilies": { "$ref": "#/$defs/ownedSurfaceList" },
    "releaseGates": { "$ref": "#/$defs/ownedSurfaceList" },
    "accessibility": { "$ref": "#/$defs/ownedSurfaceList" },
    "securityAndPerformance": { "$ref": "#/$defs/ownedSurfaceList" }
  },
  "$defs": {
    "ownedSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "reviewCadenceDays"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "reviewCadenceDays": { "type": "integer", "minimum": 1, "maximum": 90 },
        "implementationOwnerCannotSelfApprove": { "type": "boolean" },
        "lifecycle": { "type": "string", "minLength": 1 }
      }
    },
    "ownedSurfaceList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ownedSurface" }
    }
  }
}
