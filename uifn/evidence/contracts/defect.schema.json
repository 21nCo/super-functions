{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uifn-defect.schema.json",
  "title": "uifn defect record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "severity", "status", "owner", "createdAt", "lastTriagedAt", "affectedRequirements", "affectedEvidence", "targetRelease"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["P0", "P1", "P2", "P3"] },
    "status": { "enum": ["new", "triaged", "mitigated", "resolved", "verified", "closed"] },
    "owner": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "lastTriagedAt": { "type": ["string", "null"], "format": "date-time" },
    "affectedRequirements": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "affectedEvidence": { "type": "array", "items": { "type": "string" } },
    "targetRelease": { "type": "string", "minLength": 1 },
    "accessibility": { "type": "boolean" },
    "exception": { "type": ["object", "null"] }
  }
}
