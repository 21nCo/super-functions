{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@uifn/tokens": ["../tokens/src/index.ts"],
      "@uifn/tokens/*": ["../tokens/src/*"]
    }
  },
  "include": ["src"]
}
