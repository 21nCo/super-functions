{
  "$schema": "https://uifn.dev/schemas/tokens.schema.json",
  "schemaVersion": 1,
  "name": "uifn-high-contrast-dark",
  "mode": "high-contrast-dark",
  "tokens": {
    "color": {
      "surface": {
        "canvas": { "$type": "color", "$value": "oklch(0% 0 0)" },
        "raised": { "$type": "color", "$value": "oklch(12% 0 0)" },
        "sunken": { "$type": "color", "$value": "oklch(6% 0 0)" },
        "overlay": { "$type": "color", "$value": "oklch(16% 0 0)" },
        "depth-0": { "$type": "color", "$value": "oklch(0% 0 0)" },
        "depth-1": { "$type": "color", "$value": "oklch(10% 0 0)" },
        "depth-2": { "$type": "color", "$value": "oklch(16% 0 0)" },
        "depth-3": { "$type": "color", "$value": "oklch(22% 0 0)" },
        "depth-4": { "$type": "color", "$value": "oklch(28% 0 0)" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "oklch(100% 0 0)" },
        "secondary": { "$type": "color", "$value": "oklch(90% 0 0)" },
        "muted": { "$type": "color", "$value": "oklch(78% 0 0)" },
        "disabled": { "$type": "color", "$value": "oklch(62% 0 0)" }
      },
      "border": {
        "subtle": { "$type": "color", "$value": "oklch(62% 0 0)" },
        "default": { "$type": "color", "$value": "oklch(78% 0 0)" },
        "strong": { "$type": "color", "$value": "oklch(100% 0 0)" }
      },
      "accent": {
        "solid": { "$type": "color", "$value": "oklch(78% 0.2 250)" },
        "subtle": { "$type": "color", "$value": "oklch(24% 0.08 250)" },
        "contrast": { "$type": "color", "$value": "oklch(0% 0 0)" }
      },
      "danger": {
        "solid": { "$type": "color", "$value": "oklch(78% 0.22 25)" },
        "subtle": { "$type": "color", "$value": "oklch(24% 0.08 25)" },
        "contrast": { "$type": "color", "$value": "oklch(0% 0 0)" }
      },
      "warning": {
        "solid": { "$type": "color", "$value": "oklch(86% 0.2 80)" },
        "subtle": { "$type": "color", "$value": "oklch(24% 0.08 80)" },
        "contrast": { "$type": "color", "$value": "oklch(0% 0 0)" }
      },
      "success": {
        "solid": { "$type": "color", "$value": "oklch(82% 0.18 145)" },
        "subtle": { "$type": "color", "$value": "oklch(24% 0.08 145)" },
        "contrast": { "$type": "color", "$value": "oklch(0% 0 0)" }
      }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "4px" },
      "md": { "$type": "dimension", "$value": "6px" },
      "lg": { "$type": "dimension", "$value": "8px" },
      "xl": { "$type": "dimension", "$value": "12px" },
      "full": { "$type": "dimension", "$value": "9999px" }
    },
    "density": {
      "compact": { "$type": "number", "$value": 0.875 },
      "comfortable": { "$type": "number", "$value": 1 },
      "spacious": { "$type": "number", "$value": 1.125 }
    },
    "motion": {
      "duration": {
        "fast": { "$type": "duration", "$value": "120ms", "$extensions": { "uifn": { "reducedMotionValue": "0ms" } } },
        "normal": { "$type": "duration", "$value": "180ms", "$extensions": { "uifn": { "reducedMotionValue": "0ms" } } },
        "slow": { "$type": "duration", "$value": "260ms", "$extensions": { "uifn": { "reducedMotionValue": "0ms" } } }
      },
      "easing": {
        "standard": { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)" },
        "entrance": { "$type": "cubicBezier", "$value": "cubic-bezier(0, 0, 0.2, 1)" },
        "exit": { "$type": "cubicBezier", "$value": "cubic-bezier(0.4, 0, 1, 1)" }
      }
    }
  }
}
