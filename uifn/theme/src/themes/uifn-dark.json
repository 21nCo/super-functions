{
  "$schema": "https://uifn.dev/schemas/tokens.schema.json",
  "schemaVersion": 1,
  "name": "uifn-dark",
  "mode": "dark",
  "tokens": {
    "color": {
      "surface": {
        "canvas": { "$type": "color", "$value": "oklch(15% 0.015 250)" },
        "raised": { "$type": "color", "$value": "oklch(20% 0.018 250)" },
        "sunken": { "$type": "color", "$value": "oklch(11% 0.012 250)" },
        "overlay": { "$type": "color", "$value": "oklch(24% 0.02 250)" },
        "depth-0": { "$type": "color", "$value": "oklch(15% 0.015 250)" },
        "depth-1": { "$type": "color", "$value": "oklch(18% 0.016 250)" },
        "depth-2": { "$type": "color", "$value": "oklch(21% 0.018 250)" },
        "depth-3": { "$type": "color", "$value": "oklch(24% 0.02 250)" },
        "depth-4": { "$type": "color", "$value": "oklch(27% 0.022 250)" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "oklch(95% 0.01 250)" },
        "secondary": { "$type": "color", "$value": "oklch(82% 0.012 250)" },
        "muted": { "$type": "color", "$value": "oklch(70% 0.012 250)" },
        "disabled": { "$type": "color", "$value": "oklch(54% 0.01 250)" }
      },
      "border": {
        "subtle": { "$type": "color", "$value": "oklch(28% 0.016 250)" },
        "default": { "$type": "color", "$value": "oklch(38% 0.018 250)" },
        "strong": { "$type": "color", "$value": "oklch(54% 0.02 250)" }
      },
      "accent": {
        "solid": { "$type": "color", "$value": "oklch(70% 0.16 250)" },
        "subtle": { "$type": "color", "$value": "oklch(28% 0.07 250)" },
        "contrast": { "$type": "color", "$value": "oklch(12% 0.01 250)" }
      },
      "danger": {
        "solid": { "$type": "color", "$value": "oklch(70% 0.16 25)" },
        "subtle": { "$type": "color", "$value": "oklch(26% 0.06 25)" },
        "contrast": { "$type": "color", "$value": "oklch(12% 0.01 250)" }
      },
      "warning": {
        "solid": { "$type": "color", "$value": "oklch(76% 0.16 80)" },
        "subtle": { "$type": "color", "$value": "oklch(28% 0.07 80)" },
        "contrast": { "$type": "color", "$value": "oklch(12% 0.01 250)" }
      },
      "success": {
        "solid": { "$type": "color", "$value": "oklch(72% 0.14 145)" },
        "subtle": { "$type": "color", "$value": "oklch(28% 0.06 145)" },
        "contrast": { "$type": "color", "$value": "oklch(12% 0.01 250)" }
      }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "4px" },
      "md": { "$type": "dimension", "$value": "6px" },
      "lg": { "$type": "dimension", "$value": "8px" },
      "xl": { "$type": "dimension", "$value": "12px" },
      "full": { "$type": "dimension", "$value": "9999px" }
    },
    "density": {
      "compact": { "$type": "number", "$value": 0.875 },
      "comfortable": { "$type": "number", "$value": 1 },
      "spacious": { "$type": "number", "$value": 1.125 }
    },
    "motion": {
      "duration": {
        "fast": { "$type": "duration", "$value": "120ms", "$extensions": { "uifn": { "reducedMotionValue": "0ms" } } },
        "normal": { "$type": "duration", "$value": "180ms", "$extensions": { "uifn": { "reducedMotionValue": "0ms" } } },
        "slow": { "$type": "duration", "$value": "260ms", "$extensions": { "uifn": { "reducedMotionValue": "0ms" } } }
      },
      "easing": {
        "standard": { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)" },
        "entrance": { "$type": "cubicBezier", "$value": "cubic-bezier(0, 0, 0.2, 1)" },
        "exit": { "$type": "cubicBezier", "$value": "cubic-bezier(0.4, 0, 1, 1)" }
      }
    }
  }
}
