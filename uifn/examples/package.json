{
  "name": "@uifn/examples",
  "private": true,
  "version": "0.0.0",
  "description": "Example hub and runner commands for uifn Workbench apps",
  "scripts": {
    "dev:react": "npm run dev --workspace @uifn/example-react-workbench",
    "dev:svelte": "npm run dev --workspace @uifn/example-svelte-workbench",
    "dev:solid": "npm run dev --workspace @uifn/example-solid-workbench",
    "build": "turbo run build --filter=@uifn/examples^...",
    "verify": "node ../../scripts/verify-uifn-examples.mjs"
  },
  "dependencies": {
    "@uifn/examples-shared": "*",
    "@uifn/example-react-workbench": "*",
    "@uifn/example-svelte-workbench": "*",
    "@uifn/example-solid-workbench": "*"
  }
}
