{
  "schemaVersion": 1,
  "hook": "useCopyToClipboard",
  "ssr": {
    "safeFallback": {
      "ok": false,
      "errorCode": "clipboard-unavailable"
    },
    "accessesWindowDuringSsr": false
  },
  "client": {
    "successResult": {
      "ok": true,
      "text": "Copied from uifn"
    },
    "failureResult": {
      "ok": false,
      "errorCode": "clipboard-write-failed"
    }
  },
  "frameworks": [
    "react",
    "svelte",
    "solid"
  ]
}
