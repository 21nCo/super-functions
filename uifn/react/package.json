{
  "name": "@uifn/react",
  "version": "0.0.3",
  "description": "Permanently headless React adapter for uifn primitives",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./hooks/use-copy-to-clipboard": {
      "types": "./dist/hooks/use-copy-to-clipboard.d.ts",
      "import": "./dist/hooks/use-copy-to-clipboard.mjs",
      "require": "./dist/hooks/use-copy-to-clipboard.js"
    },
    "./hooks/use-media-query": {
      "types": "./dist/hooks/use-media-query.d.ts",
      "import": "./dist/hooks/use-media-query.mjs",
      "require": "./dist/hooks/use-media-query.js"
    },
    "./*": {
      "types": "./dist/generated/*.d.ts",
      "import": "./dist/generated/*.mjs",
      "require": "./dist/generated/*.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly -p tsconfig.json",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@uifn/adapter-kit": "0.0.1",
    "@uifn/core": "0.0.2",
    "@uifn/dom": "0.0.1"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "15.0.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "jsdom": "^27.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "redent": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "vitest-axe": "^0.1.0"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "primitives",
    "headless",
    "accessible"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "author": "21n",
  "license": "MIT",
  "engines": {
    "node": ">=20 <25"
  },
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "uifn/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "uifn": {
    "status": "ga-candidate",
    "layer": "adapter",
    "styling": "permanently-headless",
    "schemaVersion": 1,
    "sourcePolicy": "clean-room"
  }
}
