{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uifn.dev/schema/catalog/v1/catalog.schema.json",
  "title": "uifn canonical GA catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "catalogVersion", "generatorVersion", "sourcePolicy", "packageGraphId", "frameworks", "implementationStatusPolicy", "primitiveCount", "sourceSha256", "catalogSha256", "primitives"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "catalogId": { "const": "uifn-ga-catalog" },
    "catalogVersion": { "const": "1.0.0" },
    "generatorVersion": { "const": "1.0.0" },
    "sourcePolicy": { "const": "clean-room-original-definition" },
    "packageGraphId": { "const": "uifn-1.0-stable-dag" },
    "frameworks": { "const": ["react", "svelte", "solid"] },
    "implementationStatusPolicy": {
      "type": "object", "additionalProperties": false, "required": ["allowedCurrentStatus", "generatedMetadataIsImplementationEvidence"],
      "properties": { "allowedCurrentStatus": { "const": "implemented" }, "generatedMetadataIsImplementationEvidence": { "const": true } }
    },
    "primitiveCount": { "const": 69 },
    "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "catalogSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "primitives": { "type": "array", "minItems": 69, "maxItems": 69, "items": { "$ref": "primitive.schema.json" } }
  }
}
