{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uifn.dev/schema/catalog/v1/migration.schema.json",
  "title": "uifn catalog schema migration registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "currentSchemaVersion", "migrations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "currentSchemaVersion": { "const": 1 },
    "migrations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "from", "to", "module", "lossless"],
        "properties": { "id": { "type": "string" }, "from": { "type": "integer", "minimum": 0 }, "to": { "type": "integer", "minimum": 1 }, "module": { "type": "string" }, "lossless": { "type": "boolean" } }
      }
    }
  }
}
