{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uifn.dev/schema/catalog/v1/primitive.schema.json",
  "title": "uifn canonical primitive definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "canonicalOrder", "behaviorFamily", "implementationKind",
    "requirementIds", "anatomy", "inputs", "events", "states", "controlledModel", "formSemantics",
    "domServices", "accessibility", "frameworks", "vectors", "docs", "stories", "outputs", "release", "exceptions"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
    "canonicalOrder": { "type": "integer", "minimum": 1, "maximum": 69 },
    "behaviorFamily": { "enum": ["disclosure", "modal-overlay", "menu-navigation", "selection-collection", "forms-input", "range-gesture", "date-color", "status-feedback", "static-foundation"] },
    "implementationKind": { "enum": ["interactive-controller", "typed-static-contract"] },
    "requirementIds": { "type": "array", "minItems": 2, "uniqueItems": true, "contains": { "const": "CAT-001" }, "items": { "type": "string", "pattern": "^[A-Z0-9]+-[0-9]{3}$" } },
    "anatomy": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/part" } },
    "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/input" } },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "states": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/state" } },
    "controlledModel": { "$ref": "#/$defs/controlledModel" },
    "formSemantics": { "$ref": "#/$defs/formSemantics" },
    "domServices": { "type": "array", "uniqueItems": true, "items": { "enum": ["root-scope-modality-tabbability", "dismissable-layer", "focus-scope", "modal-isolation-scroll-lock", "positioning-auto-update", "portal-presence-transitions", "form-bridges-live-regions"] } },
    "accessibility": { "$ref": "#/$defs/accessibility" },
    "frameworks": { "$ref": "#/$defs/frameworks" },
    "vectors": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "pattern": "^TV-[A-Z0-9]+-[0-9]{3}-[PN]$" } },
    "docs": { "$ref": "#/$defs/docs" },
    "stories": { "$ref": "#/$defs/stories" },
    "outputs": { "$ref": "#/$defs/outputs" },
    "release": { "$ref": "#/$defs/release" },
    "exceptions": { "type": "array", "items": { "$ref": "#/$defs/exception" } }
  },
  "$defs": {
    "part": {
      "type": "object", "additionalProperties": false, "required": ["id", "element", "cardinality"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$|^[a-z]+$" },
        "element": { "type": "string", "minLength": 1 },
        "cardinality": { "enum": ["one", "many", "optional"] }
      }
    },
    "input": {
      "type": "object", "additionalProperties": false, "required": ["name", "type", "required", "reactive"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "type": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "reactive": { "const": true }
      }
    },
    "event": {
      "type": "object", "additionalProperties": false, "required": ["type", "source"],
      "properties": {
        "type": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "source": { "const": "controller-or-native-contract" }
      }
    },
    "state": {
      "type": "object", "additionalProperties": false, "required": ["name", "kind"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "kind": { "const": "semantic" } }
    },
    "controlledModel": {
      "type": "object", "additionalProperties": false, "required": ["mode", "valueInputs", "defaultInputs", "changeEvents"],
      "properties": {
        "mode": { "enum": ["none", "native", "single", "multiple", "single-or-multiple", "compound"] },
        "valueInputs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "defaultInputs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "changeEvents": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "formSemantics": {
      "type": "object", "additionalProperties": false, "required": ["participation", "valueShape", "reset", "validation"],
      "properties": {
        "participation": { "enum": ["none", "native", "controller-bridge", "native-file-input"] },
        "valueShape": { "type": "string", "minLength": 1 },
        "reset": { "type": "string", "minLength": 1 },
        "validation": { "type": "string", "minLength": 1 }
      }
    },
    "accessibility": {
      "type": "object", "additionalProperties": false, "required": ["profile", "rules", "primitiveNotes"],
      "properties": {
        "profile": { "enum": ["disclosure", "modal-overlay", "menu-navigation", "selection-collection", "forms-input", "range-gesture", "date-color", "status-feedback", "static-foundation"] },
        "rules": {
          "type": "object", "additionalProperties": false,
          "required": ["normativeBasis", "nativeSemantics", "accessibleName", "description", "keyboard", "pointerTouch", "focus", "announcements", "wcag", "preferences"],
          "properties": {
            "normativeBasis": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
            "nativeSemantics": { "type": "string", "minLength": 1 },
            "accessibleName": { "type": "object", "required": ["required", "sources"], "properties": { "required": { "type": "boolean" }, "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
            "description": { "type": "object", "required": ["supported", "relationships"], "properties": { "supported": { "type": "boolean" }, "relationships": { "type": "array", "items": { "type": "string" } } } },
            "keyboard": { "type": "object", "required": ["model", "keys"], "properties": { "model": { "type": "string", "minLength": 1 }, "keys": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
            "pointerTouch": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "focus": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "announcements": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "wcag": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[1-4]\\.[1-9][0-9]*\\.[1-9][0-9]*$" } },
            "preferences": { "type": "object", "required": ["forcedColors", "reflow", "reducedMotion", "rtl"], "properties": { "forcedColors": { "type": "string" }, "reflow": { "type": "string" }, "reducedMotion": { "type": "string" }, "rtl": { "type": "string" } } }
          }
        },
        "primitiveNotes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "frameworkTarget": {
      "type": "object", "additionalProperties": false, "required": ["headlessPackage", "styledPackage", "compoundRoot", "support", "implementationStatus"],
      "properties": {
        "headlessPackage": { "type": "string", "pattern": "^@uifn/" },
        "styledPackage": { "type": "string", "pattern": "^@uifn/components-" },
        "compoundRoot": { "type": "string", "minLength": 1 },
        "support": { "const": "required" },
        "implementationStatus": { "const": "implemented" }
      }
    },
    "frameworks": {
      "type": "object", "additionalProperties": false, "required": ["react", "svelte", "solid"],
      "properties": { "react": { "$ref": "#/$defs/frameworkTarget" }, "svelte": { "$ref": "#/$defs/frameworkTarget" }, "solid": { "$ref": "#/$defs/frameworkTarget" } }
    },
    "docs": {
      "type": "object", "additionalProperties": false, "required": ["page", "requiredSections", "implementationStatus"],
      "properties": { "page": { "type": "string" }, "requiredSections": { "type": "array", "minItems": 13, "uniqueItems": true, "items": { "type": "string" } }, "implementationStatus": { "const": "implemented" } }
    },
    "stories": {
      "type": "object", "additionalProperties": false, "required": ["requiredScenarios", "implementationStatus"],
      "properties": { "requiredScenarios": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string" } }, "implementationStatus": { "const": "implemented" } }
    },
    "outputs": {
      "type": "object", "additionalProperties": false, "required": ["policy", "core", "headlessPackages", "styledPackages", "sourceInstallTargets"],
      "properties": {
        "policy": { "const": "canonical-package-and-source-targets" },
        "core": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "headlessPackages": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "type": "string" } },
        "styledPackages": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "type": "string" } },
        "sourceInstallTargets": { "type": "object", "additionalProperties": false, "required": ["react", "svelte", "solid"], "properties": { "react": { "type": "string" }, "svelte": { "type": "string" }, "solid": { "type": "string" } } }
      }
    },
    "release": {
      "type": "object", "additionalProperties": false, "required": ["channel", "catalogStatus", "implementationStatus"],
      "properties": { "channel": { "const": "stable-1.0" }, "catalogStatus": { "const": "ga-required" }, "implementationStatus": { "const": "implemented" } }
    },
    "exception": {
      "type": "object", "additionalProperties": false, "required": ["id", "scope", "rationale", "owner", "expiresAt", "vectors"],
      "properties": { "id": { "type": "string" }, "scope": { "type": "string" }, "rationale": { "type": "string" }, "owner": { "type": "string" }, "expiresAt": { "type": "string", "format": "date-time" }, "vectors": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
    }
  }
}
