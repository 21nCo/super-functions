{
  "name": "@extfn/cli",
  "version": "0.1.0",
  "description": "Canonical extfn CLI for development and release workflows",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "extfn": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "echo 'lint not configured'",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "extfn",
    "cli",
    "browser-extension",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "dependencies": {
    "@extfn/vite": "0.1.1",
    "@clifn/core": "0.1.0",
    "@extfn/core": "0.1.0",
    "commander": "^12.1.0",
    "fflate": "^0.8.2",
    "vite": "^5.4.21"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "extfn/cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
