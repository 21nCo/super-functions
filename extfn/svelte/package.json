{
  "name": "@extfn/svelte",
  "version": "0.1.0",
  "description": "Svelte helpers for extfn page and content surfaces",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "echo 'lint not configured'",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "extfn",
    "svelte",
    "browser-extension",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@extfn/core": "0.1.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@types/node": "^22.0.0",
    "jsdom": "^27.4.0",
    "svelte": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "extfn/svelte"
  },
  "publishConfig": {
    "access": "public"
  }
}
