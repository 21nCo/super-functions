{
  "name": "@authfn/client",
  "version": "0.1.1",
  "description": "Typed browser client for authfn",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
