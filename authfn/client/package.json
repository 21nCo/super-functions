  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@authfn/core": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
