{
  "name": "@authfn/examples-social-oauth-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "npm --prefix ../../../../ run build -- --filter=@authfn/examples-shared...",
    "dev": "npm run build:deps && vite --host 127.0.0.1 --port 4012 --strictPort",
    "build": "npm run build:deps && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4012 --strictPort",
    "preview:test": "npm run build && npm run preview"
  },
  "dependencies": {
    "@authfn/client": "*",
    "@authfn/examples-shared": "*",
    "@authfn/svelte": "*",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
