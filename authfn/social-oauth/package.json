{
  "name": "@authfn/social-oauth",
  "version": "0.1.1",
  "description": "Social OAuth plugin for AuthFn",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./apple": {
      "types": "./dist/oauth-support.d.ts",
      "default": "./dist/oauth-support.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "authfn": "0.1.1",
    "@superfunctions/db": "0.1.4",
    "@superfunctions/http": "0.1.3",
    "@superfunctions/oauth-core": "0.0.1",
    "@superfunctions/oauth-flow": "0.0.1",
    "@superfunctions/oauth-http": "0.0.1",
    "@superfunctions/oauth-providers": "0.0.1",
    "@superfunctions/oauth-storage": "0.0.1",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
