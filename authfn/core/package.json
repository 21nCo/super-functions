{
  "name": "authfn",
  "version": "0.1.1",
  "description": "Core authfn contracts and plugin composition primitives",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin-types": {
      "types": "./dist/plugin-types.d.ts",
      "default": "./dist/plugin-types.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "./http/*": {
      "types": "./dist/http/*.d.ts",
      "default": "./dist/http/*.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "default": "./dist/openapi.js"
    },
    "./plugin-runner": {
      "types": "./dist/plugin-runner.d.ts",
      "default": "./dist/plugin-runner.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "echo 'lint not configured'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "authfn",
    "authentication",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "superfunctions": {
    "initFunction": "authfn",
    "schemaVersion": 1,
    "libraryNames": [
      "authfn"
    ]
  },
  "dependencies": {
    "@superfunctions/auth": "0.1.2",
    "@superfunctions/delivery": "0.1.0",
    "@superfunctions/db": "0.1.4",
    "@superfunctions/http": "0.1.3",
    "@superfunctions/http-openapi": "0.0.1",
    "@superfunctions/oauth-storage": "0.0.1",
    "@superfunctions/observability": "0.0.1"
  },
  "devDependencies": {
    "@authfn/api-keys": "0.1.1",
    "@authfn/email-otp": "0.1.1",
    "@authfn/multi-region": "0.1.1",
    "@authfn/native-handoff": "0.1.1",
    "@authfn/password": "0.1.1",
    "@authfn/social-oauth": "0.1.1",
    "@authfn/two-factor": "0.1.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
