{
  "name": "@superfunctions/docs-theme",
  "version": "0.1.0",
  "description": "Shared Fumadocs theme primitives for Superfunctions docs apps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && cp src/tokens.css dist/tokens.css",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "keywords": [
    "docs",
    "theme",
    "fumadocs",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "peerDependencies": {
    "fumadocs-ui": "^15",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12 || ^19.0.0",
    "typescript": "^5.6.0"
  }
}
