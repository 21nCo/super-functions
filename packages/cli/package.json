{
  "name": "@superfunctions/cli",
  "version": "0.1.3",
  "description": "CLI tool for schema management and migrations for Superfunctions libraries",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "superfunctions": "./dist/cli.js",
    "sfs": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "echo 'lint not configured'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@superfunctions/db": "*",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "glob": "^10.3.10",
    "jiti": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.2.4",
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "cli",
    "migration",
    "schema",
    "database",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/superfunctions.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/21nCo/superfunctions/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
