{
  "name": "@superfunctions/admin",
  "version": "0.1.1",
  "description": "Shared administration contracts and runtime for Superfunctions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "review:mutation-risk": "node scripts/risk-review.mjs",
    "verify:sdk-contracts": "node scripts/verify-sdk-contracts.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "mcpfn": "0.0.3"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
