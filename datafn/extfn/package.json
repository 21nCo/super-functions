{
  "name": "@datafn/extfn",
  "version": "0.1.0",
  "description": "DataFn integration plugin and proxy client surface for extfn consumers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "echo 'lint not configured'",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "datafn",
    "extfn",
    "browser-extension",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "dependencies": {
    "@datafn/client": "*",
    "@datafn/core": "*",
    "@superfunctions/extfn": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "datafn/extfn"
  },
  "publishConfig": {
    "access": "public"
  }
}
