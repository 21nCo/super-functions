{
  "name": "@datafn/swift-bridge",
  "version": "0.1.0",
  "type": "module",
  "description": "WKWebView bridge primitives for native-backed DataFn clients",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@datafn/client": "0.1.0",
    "@datafn/core": "0.1.0"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
