{
  "name": "@botfn/persistence-service",
  "version": "1.0.0",
  "description": "Persistence service for bot data using tRPC, Hono, and Cloudflare D1",
  "main": "src/index.cloudflare.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/index.cloudflare.ts",
    "deploy": "wrangler deploy src/index.cloudflare.ts",
    "db:init:remote": "wrangler d1 execute botfn-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute botfn-db --local --file=./schema.sql",
    "db:query:remote": "wrangler d1 execute botfn-db --remote --command",
    "db:query:local": "wrangler d1 execute botfn-db --local --command",
    "build": "tsc"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "zod": "^3.22.0",
    "@trpc/server": "^10.45.0",
    "@trpc/client": "^10.45.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "wrangler": "^3.0.0",
    "@cloudflare/workers-types": "^4.0.0"
  }
}
