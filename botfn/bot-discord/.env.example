# Local development only - for registering Discord commands
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id_here

# Cloudflare secrets (set via: wrangler secret put SECRET_NAME)
# DISCORD_PUBLIC_KEY=your_discord_public_key_here
# DISCORD_CLIENT_ID=your_discord_application_id_here
# GITHUB_APP_ID=your_github_app_id_here
# GITHUB_INSTALLATION_ID=your_github_installation_id_here
# GITHUB_PRIVATE_KEY=your_github_app_private_key_single_line_here
# GITHUB_OWNER=your_github_username_or_org
# GITHUB_REPO=your_github_repo_name
