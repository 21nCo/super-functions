{
  "name": "@botfn/discord-bot",
  "version": "0.0.1",
  "description": "Discord bot with GitHub and Linear integration",
  "main": "src/index.cloudflare.ts",
  "type": "module",
  "scripts": {
    "register-commands": "node register-commands.js",
    "dev": "wrangler dev src/index.cloudflare.ts",
    "deploy": "wrangler deploy src/index.cloudflare.ts",
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "zod": "^3.22.0",
    "@botfn/discord-core": "*",
    "@botfn/github-integration": "*",
    "@botfn/linear-integration": "*",
    "@botfn/shared-types": "*",
    "@botfn/persistence-service": "*",
    "@trpc/client": "^10.45.0",
    "discord.js": "^14.24.0"
  },
  "devDependencies": {
    "dotenv": "^16.3.1",
    "typescript": "^5.0.0",
    "wrangler": "^3.0.0",
    "@cloudflare/workers-types": "^4.0.0",
    "@vitest/coverage-v8": "^3.2.4"
  },
  "author": "21n",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "botfn/bot-discord"
  },
  "publishConfig": {
    "access": "public"
  }
}
