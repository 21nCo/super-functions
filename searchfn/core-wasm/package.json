{
  "name": "@searchfn/core-wasm",
  "version": "0.1.0",
  "description": "Experimental WASM engine wrapper for SearchFn.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "rust"
  ],
  "scripts": {
    "build": "npm run build:wasm && tsup && npm run copy:wasm",
    "build:wasm": "node ./scripts/build-wasm.mjs",
    "build:watch": "tsup --watch",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true }); require('fs').rmSync('.wasm', { recursive: true, force: true })\"",
    "copy:wasm": "node ./scripts/copy-wasm.mjs",
    "test": "npm run build:wasm && vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@searchfn/core": "file:../core"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "fake-indexeddb": "^6.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
