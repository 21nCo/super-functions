{"type":"message","id":"37f6dd0c","parentId":"fdff5c92","timestamp":"2026-10-05T18:20:50.529Z","message":{"role":"toolResult","toolCallId":"call_IAiCBWHTDwTSm6ffzZSa4e7r|fc_055fb762f51dfcfc016ac3ea806d6c87d0acb97591938a356b","toolName":"read","content":[{"type":"text","text":"import type { ViteUserConfig } from \"vitest/config\";\nimport { pathToFileURL, fileURLToPath } from \"node:url\";\nimport { resolve, dirname } from \"node:path\";\nimport { readFileSync } from \"node:fs\";\nimport { docsSiteCorePlugin } from \"./vite\";\n\nconst hint = \"Run DocsFn site tests from a consuming docs workspace, for example npm test --workspace @devfn/docs (or set DOCS_SITE_DIR)\";\nconst sitePackagePath = process.env.DOCS_SITE_DIR\n  ? resolve(process.env.DOCS_SITE_DIR, \"package.json\")\n  : resolve(process.env.npm_package_json ?? resolve(process.cwd(), \"package.json\"));\nlet sitePackage: unknown;\ntry {\n  sitePackage = JSON.parse(readFileSync(sitePackagePath, \"utf8\"));\n} catch {\n  throw new Error(hint);\n}\nif (!sitePackage || typeof sitePackage !== \"object\" || !(\"name\" in sitePackage) ||\n    typeof sitePackage.name !== \"string\" || !sitePackage.name.endsWith(\"/docs\") ||\n    !(\"dependencies\" in sitePackage) || !sitePackage.dependencies ||\n    typeof sitePackage.dependencies !== \"object\" || !(\"@docsfn/core\" in sitePackage.dependencies) ||\n    typeof sitePackage.dependencies[\"@docsfn/core\"] !== \"string\") {\n  throw new Error(hint);\n}\n\nexport default {\n  plugins: [docsSiteCorePlugin(pathToFileURL(sitePackagePath).href)],\n  resolve: { alias: { $lib: resolve(dirname(sitePackagePath), \"src/lib\") } },\n  esbuild: { tsconfigRaw: JSON.stringify({ compilerOptions: { target: \"ES2022\", verbatimModuleSyntax: true } }) },\n  test: { root: fileURLToPath(new URL(\".\", import.meta.url)), include: [\"runtime.test.ts\", \"page.test.ts\", \"blog.test.ts\", \"llms.test.mjs\", \"vite.test.mjs\", \"dependency-owner.test.ts\"] },\n} satisfies ViteUserConfig;\n"}],"isError":false,"timestamp":1791224450529}}
{"type":"message","id":"d0293bfc","parentId":"37f6dd0c","timestamp":"2026-10-05T18:20:50.529Z","message":{"role":"toolResult","toolCallId":"call_gW9y3h7Gzts1de6pXtXfxFzn|fc_055fb762f51dfcfc016ac3ea806d7c87d0aec05e0b5cfa3a6b","toolName":"read","content":[{"type":"text","text":"import assert from 'node:assert/strict';\nimport { mkdtempSync, mkdirSync, writeFileSync } from 'node:fs';\nimport path from 'node:path';\nimport { tmpdir } from 'node:os';\nimport { spawnSync } from 'node:child_process';\nimport { pathToFileURL } from 'node:url';\nconst tree=path.resolve(process.argv[2]);\nconst {withSourceLinks,buildLlmsSiteArtifacts}=await import(pathToFileURL(path.join(tree,'scripts/docs-site/llms.mjs')));\nfor(const product of ['clifn','authfn','filefn']) {\n const cwd=path.join(tree,product,'docs');\n const result=spawnSync(process.execPath,['--input-type=module','--eval','console.log(JSON.stringify([import.meta.resolve(\"@docsfn/core\"),import.meta.resolve(\"@docsfn/provider-fs\")]))'],{cwd,encoding:'utf8'});\n assert.equal(result.status,0,result.stderr);const [coreURL,fsURL]=JSON.parse(result.stdout);\n const core=await import(coreURL),{FsContentProvider}=await import(fsURL);\n const root=mkdtempSync(path.join(tmpdir(),'pr210-sdk-unicode-'));\n for(const sub of ['content/docs/unicode','content/pages','content/blog','content/api','static'])mkdirSync(path.join(root,sub),{recursive:true});\n writeFileSync(path.join(root,'content/docs/unicode/主.md'),'---\\ntitle: Unicode source link\\n---\\nActual published guide.');\n const loaded=await core.loadDocsConfig({cwd});const config={...loaded,content:{...loaded.content,root},site:{...loaded.site,basePath:'/docs',assetsBasePath:'https://assets.invalid/docs'}};\n const manifest=await core.buildManifest(new FsContentProvider({root,...config.content}),config);\n const {llmsTxt}=core.buildLlmsTxtArtifacts(manifest,{includeBlog:false});\n const converted=withSourceLinks(llmsTxt,manifest,product,undefined);\n assert(converted.includes(`https://github.com/21nCo/super-functions/blob/dev/${product}/docs/content/docs/unicode/%E4%B8%BB.md`),converted);\n // Published Core appends each absolute docs path to an origin, not a docs-prefix URL.\n const canonicalUrl='https://public.invalid';\n const unicodeCanonical=core.buildLlmsTxtArtifacts(manifest,{includeBlog:false,canonicalUrl});\n const links=[...unicodeCanonical.llmsTxt.matchAll(/\\]\\((https:[^\\s)]*)\\)/g)].map(m=>new URL(m[1]).href);\n assert(links.includes('https://public.invalid/docs/unicode/%E4%B8%BB'),unicodeCanonical.llmsTxt);\n assert(!unicodeCanonical.llmsTxt.includes('assets.invalid'));\n const canonical=await buildLlmsSiteArtifacts(cwd,{...core,FsContentProvider},{canonicalUrl});\n assert.equal(canonical.canonicalUrl,canonicalUrl);assert(canonical.artifacts.llmsTxt.includes('https://public.invalid/docs'));\n assert(!canonical.artifacts.llmsTxt.includes('assets.invalid'));\n console.log(JSON.stringify({product,coreURL,fsURL,actualSdkUnicodeSourceFallback:true,distinctPublicAssetsOrigins:true,canonicalUrlReturned:true,fixtureRoot:root,qualification:'actual published SDK manifest/build producer; separate native text HTTP receipts establish serving, not live-host configuration'}));\n}\n"}],"isError":false,"timestamp":1791224450529}}
{"type":"message","id":"583ace55","parentId":"d0293bfc","timestamp":"2026-10-05T18:20:50.529Z","message":{"role":"toolResult","toolCallId":"call_QAYr83F7tQWzn6OidIA4wRRj|fc_055fb762f51dfcfc016ac3ea806d8487d098c9fc5607b98fb9","toolName":"read","content":[{"type":"text","text":"import assert from 'node:assert/strict';\nimport path from 'node:path';\nimport { readFileSync, openSync, closeSync } from 'node:fs';\nimport { spawn } from 'node:child_process';\nconst root = process.argv[2];\nconst logPrefix = process.argv[3];\nconst failures = [];\nfor (const [index, product] of ['clifn', 'authfn', 'filefn'].entries()) {\n  const directory = path.join(root, product, 'docs');\n  const port = 6920 + index;\n  const log = openSync(`${logPrefix}-${product}.log`, 'w');\n  const child = spawn('npm', ['exec', '--', 'vite', 'preview', '--host', '127.0.0.1', '--port', String(port), '--strictPort'], { cwd: directory, detached: true, stdio: ['ignore', log, log] });\n  try {\n    let ready = false;\n    for (let i = 0; i < 100; i++) {\n      if (child.exitCode !== null) throw new Error(`preview exited ${child.exitCode}`);\n      try { await fetch(`http://127.0.0.1:${port}/`, { signal: AbortSignal.timeout(1000) }); ready = true; break; } catch {}\n      await new Promise(resolve => setTimeout(resolve, 100));\n    }\n    assert(ready, 'owned preview must be available');\n    for (const file of ['llms.txt', 'llms-full.txt']) {\n      const url = `http://127.0.0.1:${port}/docs/${file}`;\n      const response = await fetch(url);\n      const body = await response.text();\n      console.log(JSON.stringify({ product, publicUrl: `https://${product}.com/docs/${file}`, status: response.status, bytes: Buffer.byteLength(body) }));\n      try {\n        assert.equal(response.status, 200, url);\n        assert.match(response.headers.get('content-type'), /text\\/plain/);\n        assert.equal(body, readFileSync(path.join(directory, 'static', file), 'utf8'), url);\n        assert(!body.includes('https://authfn.superfunctions.dev/llms'), 'obsolete hosted path');\n      } catch (error) { failures.push(error.message); }\n    }\n  } finally {\n    try { process.kill(-child.pid, 'SIGTERM'); } catch (error) { if (error.code !== 'ESRCH') throw error; }\n    await new Promise(resolve => { if (child.exitCode !== null) resolve(); else child.once('exit', resolve); });\n    closeSync(log);\n  }\n}\nassert.deepEqual(failures, []);\n"}],"isError":false,"timestamp":1791224450529}}
