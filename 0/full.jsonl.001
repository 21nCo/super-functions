+    expect(state.attempts).toBe(1);\n+    expect(stderr.join(\"\")).toContain(\"unsafe report omitted\");\n+  } finally {\n+    state.reportless = false;\n+    await rm(root, { recursive: true, force: true });\n+  }\n+});\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /Users/serro/Documents/dev/n/worktrees/superfunctions/PR-170/mcpfn/cli/tests/target-suite-cleanup.test.ts\n","stderr":""},"started_at_ms":1789812833484,"completed_at_ms":1789812833485}}
