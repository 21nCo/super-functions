2457571,\"node_id\":\"MDQ6VXNlcjUyNDU3NTcx\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/52457571?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/thyaravind\",\"html_url\":\"https://github.com/thyaravind\",\"followers_url\":\"https://api.github.com/users/thyaravind/followers\",\"following_url\":\"https://api.github.com/users/thyaravind/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/thyaravind/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/thyaravind/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/thyaravind/subscriptions\",\"organizations_url\":\"https://api.github.com/users/thyaravind/orgs\",\"repos_url\":\"https://api.github.com/users/thyaravind/repos\",\"events_url\":\"https://api.github.com/users/thyaravind/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/thyaravind/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"created_at\":\"2026-09-13T05:24:14Z\",\"updated_at\":\"2026-09-13T05:24:14Z\",\"body\":\"Pushed 933c96a0b: JavaScript CI now uses Node 22, matching the official conformance runner requirement. The failing hosted test explicitly rejected Node 20. Workflow YAML verified. Local test collection was blocked by missing built @superfunctions/oauth-core; no fresh local test pass claimed. Sonar remains a separate outstanding blocker.\",\"author_association\":\"MEMBER\",\"reactions\":{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5651372848/reactions\",\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"hooray\":0,\"confused\":0,\"heart\":0,\"rocket\":0,\"eyes\":0},\"performed_via_github_app\":null,\"minimized\":null},{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5651547075\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/170#issuecomment-5651547075\",\"issue_url\":\"https://api.github.com/repos/21nCo/super-functions/issues/170\",\"id\":5651547075,\"node_id\":\"IC_kwDOP-e7KM8AAAABUNvDww\",\"user\":{\"login\":\"thyaravind\",\"id\":52457571,\"node_id\":\"MDQ6VXNlcjUyNDU3NTcx\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/52457571?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/thyaravind\",\"html_url\":\"https://github.com/thyaravind\",\"followers_url\":\"https://api.github.com/users/thyaravind/followers\",\"following_url\":\"https://api.github.com/users/thyaravind/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/thyaravind/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/thyaravind/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/thyaravind/subscriptions\",\"organizations_url\":\"https://api.github.com/users/thyaravind/orgs\",\"repos_url\":\"https://api.github.com/users/thyaravind/repos\",\"events_url\":\"https://api.github.com/users/thyaravind/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/thyaravind/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"created_at\":\"2026-09-13T06:04:51Z\",\"updated_at\":\"2026-09-13T06:04:51Z\",\"body\":\"Pushed a93ef9c51 for the concrete Sonar findings: explicit locale-independent string comparison for tool inventories; Windows cleanup now resolves SystemRoot/System32/taskkill.exe directly and requires an absolute SystemRoot instead of searching PATH. Script syntax check and comparator behavior checks passed. Windows process cleanup was not executed on this macOS host; package tests remain subject to the previously documented missing built dependencies. Fresh Sonar/CI results are required; no issue or gate was suppressed.\",\"author_association\":\"MEMBER\",\"reactions\":{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5651547075/reactions\",\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"hooray\":0,\"confused\":0,\"heart\":0,\"rocket\":0,\"eyes\":0},\"performed_via_github_app\":null,\"minimized\":null},{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5652355701\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/170#issuecomment-5652355701\",\"issue_url\":\"https://api.github.com/repos/21nCo/super-functions/issues/170\",\"id\":5652355701,\"node_id\":\"IC_kwDOP-e7KM8AAAABUOgadQ\",\"user\":{\"login\":\"thyaravind\",\"id\":52457571,\"node_id\":\"MDQ6VXNlcjUyNDU3NTcx\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/52457571?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/thyaravind\",\"html_url\":\"https://github.com/thyaravind\",\"followers_url\":\"https://api.github.com/users/thyaravind/followers\",\"following_url\":\"https://api.github.com/users/thyaravind/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/thyaravind/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/thyaravind/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/thyaravind/subscriptions\",\"organizations_url\":\"https://api.github.com/users/thyaravind/orgs\",\"repos_url\":\"https://api.github.com/users/thyaravind/repos\",\"events_url\":\"https://api.github.com/users/thyaravind/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/thyaravind/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"created_at\":\"2026-09-13T09:04:44Z\",\"updated_at\":\"2026-09-13T09:04:44Z\",\"body\":\"Merge-readiness check: all current checks pass at a93ef9c51, but newer unresolved reviews include cleanup gating after failed/late credential releases, redaction ordering before truncation, and opaque tokens in custom authorization schemes. Current source confirms these paths need another focused security remediation pass; not merging solely on green checks.\",\"author_association\":\"MEMBER\",\"reactions\":{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5652355701/reactions\",\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"hooray\":0,\"confused\":0,\"heart\":0,\"rocket\":0,\"eyes\":0},\"performed_via_github_app\":null,\"minimized\":null},{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5652393170\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/170#issuecomment-5652393170\",\"issue_url\":\"https://api.github.com/repos/21nCo/super-functions/issues/170\",\"id\":5652393170,\"node_id\":\"IC_kwDOP-e7KM8AAAABUOis0g\",\"user\":{\"login\":\"thyaravind\",\"id\":52457571,\"node_id\":\"MDQ6VXNlcjUyNDU3NTcx\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/52457571?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/thyaravind\",\"html_url\":\"https://github.com/thyaravind\",\"followers_url\":\"https://api.github.com/users/thyaravind/followers\",\"following_url\":\"https://api.github.com/users/thyaravind/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/thyaravind/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/thyaravind/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/thyaravind/subscriptions\",\"organizations_url\":\"https://api.github.com/users/thyaravind/orgs\",\"repos_url\":\"https://api.github.com/users/thyaravind/repos\",\"events_url\":\"https://api.github.com/users/thyaravind/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/thyaravind/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"created_at\":\"2026-09-13T09:14:33Z\",\"updated_at\":\"2026-09-13T09:14:33Z\",\"body\":\"Pushed 3ffdf24bc for the client/target cleanup and opaque-redaction findings. Known secrets are scrubbed before generic redaction/truncation; custom authorization-scheme token components are included. Failed target cleanup now blocks reconnect, including completeAuthorization and failed opens. Late aborted opens drain again after an earlier cleanup snapshot, retaining a retryable close gate on failure. Regression coverage includes the overlapping close/late-open race, callback cleanup failure, truncation-edge redaction and custom scheme reflection. Validation: 25 client tests and 84 testing-package tests passed; all 9 dependency/build tasks passed, and the final client build passed. No new worktrees or dependency installations. This is a scoped security batch, not a declaration that every remaining review finding is resolved: conformance-lease cleanup, CLI error typing and hosted OAuth/reporting findings still require follow-up. Await fresh CI/review; no merge performed.\",\"author_association\":\"MEMBER\",\"reactions\":{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5652393170/reactions\",\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"hooray\":0,\"confused\":0,\"heart\":0,\"rocket\":0,\"eyes\":0},\"performed_via_github_app\":null,\"minimized\":null},{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5652607895\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/170#issuecomment-5652607895\",\"issue_url\":\"https://api.github.com/repos/21nCo/super-functions/issues/170\",\"id\":5652607895,\"node_id\":\"IC_kwDOP-e7KM8AAAABUOvzlw\",\"user\":{\"login\":\"thyaravind\",\"id\":52457571,\"node_id\":\"MDQ6VXNlcjUyNDU3NTcx\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/52457571?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/thyaravind\",\"html_url\":\"https://github.com/thyaravind\",\"followers_url\":\"https://api.github.com/users/thyaravind/followers\",\"following_url\":\"https://api.github.com/users/thyaravind/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/thyaravind/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/thyaravind/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/thyaravind/subscriptions\",\"organizations_url\":\"https://api.github.com/users/thyaravind/orgs\",\"repos_url\":\"https://api.github.com/users/thyaravind/repos\",\"events_url\":\"https://api.github.com/users/thyaravind/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/thyaravind/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"created_at\":\"2026-09-13T10:05:30Z\",\"updated_at\":\"2026-09-13T10:05:30Z\",\"body\":\"Pushed 10d5eac25 for the remaining scoped conformance/CLI/OAuth reporting findings. Conformance credential cleanup retries three times and retains the lease behind McpFnConformanceCleanupError.retryCleanup() after persistent failure (documented). Redacted inspect client errors retain their type/code/phase and runtime exit code 1. Hosted fixtures require case-insensitive Bearer token types, preserve actual final response status, and require registered error callbacks except direct invalid_client rejection. Report normalization checks each HTTP status field independently. Added regression coverage. Validation: 93 testing-package tests and 14 CLI tests passed; dependency graph and final testing/CLI builds passed. The original nested auth dependency was restored after a temporary validation check. No new worktrees or dependency installations. Awaiting fresh hosted checks and review; no merge performed.\",\"author_association\":\"MEMBER\",\"reactions\":{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5652607895/reactions\",\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"hooray\":0,\"confused\":0,\"heart\":0,\"rocket\":0,\"eyes\":0},\"performed_via_github_app\":null,\"minimized\":null},{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5654818896\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/170#issuecomment-5654818896\",\"issue_url\":\"https://api.github.com/repos/21nCo/super-functions/issues/170\",\"id\":5654818896,\"node_id\":\"IC_kwDOP-e7KM8AAAABUQ2wUA\",\"user\":{\"login\":\"thyaravind\",\"id\":52457571,\"node_id\":\"MDQ6VXNlcjUyNDU3NTcx\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/52457571?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/thyaravind\",\"html_url\":\"https://github.com/thyaravind\",\"followers_url\":\"https://api.github.com/users/thyaravind/followers\",\"following_url\":\"https://api.github.com/users/thyaravind/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/thyaravind/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/thyaravind/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/thyaravind/subscriptions\",\"organizations_url\":\"https://api.github.com/users/thyaravind/orgs\",\"repos_url\":\"https://api.github.com/users/thyaravind/repos\",\"events_url\":\"https://api.github.com/users/thyaravind/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/thyaravind/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"created_at\":\"2026-09-13T17:18:37Z\",\"updated_at\":\"2026-09-13T17:18:37Z\",\"body\":\"Pushed b9ec3a7d0ecf79c3d88ec6c77d82671bc4ac7a94.\\n\\nFixed: require HTTP 200 for successful OAuth exchange/refresh, preserve failure response status, clarify Bearer-type failures, validate Bearer headers without echoing credentials, and retain redacted inspect error details/cause. Retain every acquired lease until successful release, block retries after failed cleanup, gate reconnect during pre-open diagnostics, and emit failed connection diagnostics before cleanup propagation. Preserve special-value diagnostics and fixed report fields, use non-expanding masking for short credentials, and bound failure messages under report limits. Corrected ineffective redaction tests and added lifecycle, status, collision, cap and CLI secrecy regressions.\\n\\nVerification: client 26 tests, testing 98 tests, CLI 15 tests passed; affected package typechecks and client/testing builds passed. Existing traversal budgets deliberately fail closed on over-limit inputs rather than emit credential fragments.\\n\\nSkipped: older cleanup/redaction findings already covered by current source were not duplicated. Not attempted: changing the cross-repository Node 20/22 CI coverage policy; the captured JavaScript failure is an unrelated collaboration-test timeout, not a failure in the changed MCP suites. Neither is claimed resolved by this batch.\\n\\nFresh checks/reviews pending. No merge.\\n\",\"author_association\":\"MEMBER\",\"reactions\":{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5654818896/reactions\",\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"hooray\":0,\"confused\":0,\"heart\":0,\"rocket\":0,\"eyes\":0},\"performed_via_github_app\":null,\"minimized\":null},{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5655243756\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/170#issuecomment-5655243756\",\"issue_url\":\"https://api.github.com/repos/21nCo/super-functions/issues/170\",\"id\":5655243756,\"node_id\":\"IC_kwDOP-e7KM8AAAABURQr7A\",\"user\":{\"login\":\"thyaravind\",\"id\":52457571,\"node_id\":\"MDQ6VXNlcjUyNDU3NTcx\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/52457571?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/thyaravind\",\"html_url\":\"https://github.com/thyaravind\",\"followers_url\":\"https://api.github.com/users/thyaravind/followers\",\"following_url\":\"https://api.github.com/users/thyaravind/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/thyaravind/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/thyaravind/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/thyaravind/subscriptions\",\"organizations_url\":\"https://api.github.com/users/thyaravind/orgs\",\"repos_url\":\"https://api.github.com/users/thyaravind/repos\",\"events_url\":\"https://api.github.com/users/thyaravind/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/thyaravind/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"created_at\":\"2026-09-13T18:33:53Z\",\"updated_at\":\"2026-09-13T18:33:53Z\",\"body\":\"Pushed 16b8631011e1a32d3eb59605b6a1d96c75894bc3.\\n\\nFixed bounded raw credential-header traversal before copying/registering secrets, blank OAuth/API-key rejection, stale hosted response-status reporting, cleanup before awaited failure diagnostics, and multibyte-safe minimum report fallback. Added adversarial regression cases and moved the CLI regression into its existing cleanup scope. Verification: client 27, testing 102, CLI 17 tests passed; affected typechecks and client/testing builds passed. Oversized credentials fail with bounded generic errors. Existing cross-repository Node 20/22 coverage policy remains deferred. Merge awaits fresh review/CI.\\n\\nOne review-remediation pass completed. Fresh CI/reviews are pending; no merge or post-push review loop performed. Other PRs are handled separately.\\n\",\"author_association\":\"MEMBER\",\"reactions\":{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5655243756/reactions\",\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"hooray\":0,\"confused\":0,\"heart\":0,\"rocket\":0,\"eyes\":0},\"performed_via_github_app\":null,\"minimized\":null},{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5655495517\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/170#issuecomment-5655495517\",\"issue_url\":\"https://api.github.com/repos/21nCo/super-functions/issues/170\",\"id\":5655495517,\"node_id\":\"IC_kwDOP-e7KM8AAAABURgDXQ\",\"user\":{\"login\":\"thyaravind\",\"id\":52457571,\"node_id\":\"MDQ6VXNlcjUyNDU3NTcx\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/52457571?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/thyaravind\",\"html_url\":\"https://github.com/thyaravind\",\"followers_url\":\"https://api.github.com/users/thyaravind/followers\",\"following_url\":\"https://api.github.com/users/thyaravind/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/thyaravind/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/thyaravind/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/thyaravind/subscriptions\",\"organizations_url\":\"https://api.github.com/users/thyaravind/orgs\",\"repos_url\":\"https://api.github.com/users/thyaravind/repos\",\"events_url\":\"https://api.github.com/users/thyaravind/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/thyaravind/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"created_at\":\"2026-09-13T19:18:20Z\",\"updated_at\":\"2026-09-13T19:18:20Z\",\"body\":\"Pushed bebdc22a248633a1930ec9b5b12d5bc4f3623ff9.\\n\\nFixed live-handle shutdown ordering before retained target credential cleanup; authenticated conformance now scrubs known credentials before truncation, including boundary-spanning values. Enforced UTF-8 per-header limits in pre-redaction collection and compact CLI target-report serialization under explicit/default caps. Strengthened the blank-token regression so missing refresh tokens cannot mask a broken guard, and aligned test formatting. Verification: client 28, testing 104, CLI 18 tests passed; client/testing builds and testing/CLI typechecks passed. Existing Node coverage policy follow-up remains. Merge deferred for fresh CI/review.\\n\\nOne review-remediation pass completed. Fresh CI/reviews are pending; no merge or post-push review loop performed. Other PRs are handled separately.\\n\",\"author_association\":\"MEMBER\",\"reactions\":{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5655495517/reactions\",\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"hooray\":0,\"confused\":0,\"heart\":0,\"rocket\":0,\"eyes\":0},\"performed_via_github_app\":null,\"minimized\":null},{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5655737740\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/170#issuecomment-5655737740\",\"issue_url\":\"https://api.github.com/repos/21nCo/super-functions/issues/170\",\"id\":5655737740,\"node_id\":\"IC_kwDOP-e7KM8AAAABURu1jA\",\"user\":{\"login\":\"thyaravind\",\"id\":52457571,\"node_id\":\"MDQ6VXNlcjUyNDU3NTcx\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/52457571?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/thyaravind\",\"html_url\":\"https://github.com/thyaravind\",\"followers_url\":\"https://api.github.com/users/thyaravind/followers\",\"following_url\":\"https://api.github.com/users/thyaravind/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/thyaravind/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/thyaravind/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/thyaravind/subscriptions\",\"organizations_url\":\"https://api.github.com/users/thyaravind/orgs\",\"repos_url\":\"https://api.github.com/users/thyaravind/repos\",\"events_url\":\"https://api.github.com/users/thyaravind/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/thyaravind/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"created_at\":\"2026-09-13T19:59:03Z\",\"updated_at\":\"2026-09-13T19:59:03Z\",\"body\":\"Pushed 4bb10b48c66da57d2f585a243a43d4e3437beb28.\\n\\nFixed invalid-client authorization redirects being accepted as valid rejection evidence, and retained typed retryable runtime errors for strict cleanup failures. Removed the redundant CLI size guard while documenting the suite newline reservation. Verification: 28 client and 105 testing tests passed, client build and testing typecheck passed. Existing CLI compact-output cap regression remains unchanged. Merge deferred for fresh review/CI.\\n\\nOne review-remediation pass completed. Fresh CI/reviews are pending; no merge or post-push review loop performed. Other PRs are handled separately.\\n\",\"author_association\":\"MEMBER\",\"reactions\":{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5655737740/reactions\",\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"hooray\":0,\"confused\":0,\"heart\":0,\"rocket\":0,\"eyes\":0},\"performed_via_github_app\":null,\"minimized\":null},{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5655999648\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/170#issuecomment-5655999648\",\"issue_url\":\"https://api.github.com/repos/21nCo/super-functions/issues/170\",\"id\":5655999648,\"node_id\":\"IC_kwDOP-e7KM8AAAABUR-0oA\",\"user\":{\"login\":\"thyaravind\",\"id\":52457571,\"node_id\":\"MDQ6VXNlcjUyNDU3NTcx\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/52457571?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/thyaravind\",\"html_url\":\"https://github.com/thyaravind\",\"followers_url\":\"https://api.github.com/users/thyaravind/followers\",\"following_url\":\"https://api.github.com/users/thyaravind/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/thyaravind/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/thyaravind/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/thyaravind/subscriptions\",\"organizations_url\":\"https://api.github.com/users/thyaravind/orgs\",\"repos_url\":\"https://api.github.com/users/thyaravind/repos\",\"events_url\":\"https://api.github.com/users/thyaravind/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/thyaravind/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"created_at\":\"2026-09-13T20:43:20Z\",\"updated_at\":\"2026-09-13T20:43:20Z\",\"body\":\"Pushed 45affe39d9a3d937b96423584a0ec6b746f7034c.\\n\\nFixed: compact target reports are now sized using the compact JSON emitted by the CLI, preserving complete results when pretty JSON would exceed the cap. An explicit permanent close now escalates an in-flight automatic/temporary shutdown and finishes closed.\\n\\nVerification: client tests/build and testing tests/typecheck passed, with focused regressions for shutdown escalation and compact-versus-pretty report bounds. Previously addressed findings remain covered by the existing suites. The previously documented Node-version coverage disposition is unchanged; merge remains deferred pending fresh review and issue-completeness verification.\\n\\n\\nOne review-remediation pass completed. Fresh CI/reviews are pending; no merge or post-push review loop performed. Other PRs are handled separately.\\n\",\"author_association\":\"MEMBER\",\"reactions\":{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5655999648/reactions\",\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"hooray\":0,\"confused\":0,\"heart\":0,\"rocket\":0,\"eyes\":0},\"performed_via_github_app\":null,\"minimized\":null},{\"url\":\"https://api.github.com/repos/21nCo/super-functions/issues/comments/5656073851\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/170#issuecomment-5656073851\",\"issue_url\":\"https://api.github.com/repos/21nCo/super-functions/issues/170\",\"id\":5656073851,\"node_id\":\"IC_kwDOP-e7KM8AAAABUSDWew\",\"user\":{\"login\":\"pullfrog[bot]\",\"id\":226033991,\"node_id\":\"BOT_kgDODXkBRw\",\"avatar_url\":\"https://avatars.githubusercontent.com/in/1768019?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/pullfrog%5Bbot%5D\",\"html_url\":\"https://github.com/apps/pullfrog\",\"followers_url\":\"https://api.github.com/users/pullfrog%5Bbot%5D/followers\",\"following_url\":\"https://api.github.com/users/pullfrog%5Bbot%5D/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/pullfrog%5Bbot%5D/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/pullfrog%5Bbot%5D/starred{/owner}{/repo}\",\"subscript