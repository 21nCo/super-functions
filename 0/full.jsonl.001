{"type":"message","id":"c5c4284a","parentId":"dd39dd85","timestamp":"2026-10-06T11:28:08.726Z","message":{"role":"toolResult","toolCallId":"call_0i87GawbMA3dPaOYqgHf7KYs|fc_055fb762f51dfcfc016ac4db47da5887d09693eaf656928e17","toolName":"read","content":[{"type":"text","text":"import pathlib,json,subprocess,hashlib,os,stat,tarfile,io,datetime,shutil\nA=pathlib.Path(__file__).resolve().parent;T=pathlib.Path('/Users/serro/orca/workspaces/superfunctions/docs-pr-206-review-20260930');V=pathlib.Path(json.loads((A/'ssd-routed-normal-install-admission.json').read_text())['candidate']);review=json.loads((A/'final-current-review-input.json').read_text());source=json.loads((A/'final-current-source-hashes-and-modes.json').read_text());head=review['frozenHead'];base=review['base'];receipt=A/'final-staged-tree-guard.json';assert not receipt.exists()\ndef git(*args,env=None,data=None):return subprocess.check_output(['git','-C',str(T),*args],env=env,input=data,stderr=subprocess.STDOUT).decode().strip()\ndef raw(p):\n if p.is_symlink():return os.readlink(p).encode(),'120000'\n if p.is_file():return p.read_bytes(),'100755' if p.stat().st_mode&stat.S_IXUSR else '100644'\n assert not p.exists(),p\n return None,None\ndef entry(p):\n data,mode=raw(p);return {'sha256':hashlib.sha256(data).hexdigest() if data is not None else None,'gitMode':mode}\nassert git('rev-parse','HEAD')==head and git('branch','--show-current')=='codex/docs-datafn-20260926' and not git('status','--porcelain')\nassert git('remote','get-url','origin')=='https://github.com/21nCo/super-functions.git'\nassert hashlib.sha256((A/'SKILL.md').read_bytes()).hexdigest()=='78e6b66300287085d26e1cf15657a5010c6c93d0c2c23a9d4240064a6cdcd91c'\nledger=json.loads((A.parents[1]/'parent-ledger.json').read_text());assert ledger['digest']=='sha256:b6a6e7a8c670bc5ab12540910401d153e8eedd533d89fd1a1925bc9979112726' and ledger['execution']['current_sequential_sweep']['active_pr']==211\nassert (A/'final-source-review-assessment.md').exists()\nfor name in ['current211-root-normal-npm-ci.receipt.json','current211-secfn-native-contracts.receipt.json','current211-authfn-after-absence-build.receipt.json','current211-real-next-http.receipt.json','current211-real-cloudflare-http.receipt.json','current211-final-authfn-http.receipt.json','current211-final-candidate-metadata-corpus-cli.receipt.json','current211-deployment-sibling-contracts.receipt.json']:assert json.loads((A/name).read_text())['exitCode']==0,name\nclosure=json.loads((A/'current211-root-physical-closures.json').read_text());assert all(not r['failures'] for r in closure['rows'])\nfor p,e in source.items():assert entry(V/p)==e,p\nassert hashlib.sha256((V/'package-lock.json').read_bytes()).hexdigest()==review['lockSha256']\nprotected=json.loads((A/'execution-protected-before-switch.json').read_text())\nfor p,h in protected.items():assert entry(T/p)['sha256']==h,p\ninputs=list(json.loads((A/'candidate-absence-amendment.json').read_text())['entries']);assert all(not (T/p).exists() and not (V/p).exists() for p in inputs)\nrows=[]\ntrackedOriginalAndBase=set(git('ls-tree','-r','--name-only',head).splitlines())|set(git('ls-tree','-r','--name-only',base).splitlines())\nfor p,after in source.items():\n before=entry(T/p)\n if before==after:continue\n assert not p.startswith(('.conduct/','.entire/')) and p!='filefn/server/eng.traineddata' and 'node_modules' not in pathlib.PurePosixPath(p).parts\n if p not in trackedOriginalAndBase:assert not any(part.startswith('__') for part in pathlib.PurePosixPath(p).parts),p\n rows.append({'path':p,'before':before,'after':after})\n# Public Git ancestry fixture, no additional verification root or disabled hooks.\nfixture=pathlib.Path(json.loads((A/'ssd-routed-normal-install-admission.json').read_text())['paths']['tmp'])/'pr211-ancestry-fixture';assert not fixture.exists();fixture.mkdir();env={**os.environ,'GIT_AUTHOR_NAME':'Verification','GIT_AUTHOR_EMAIL':'verification@example.invalid','GIT_COMMITTER_NAME':'Verification','GIT_COMMITTER_EMAIL':'verification@example.invalid'}\ndef fg(*args):return subprocess.check_output(['git','-C',str(fixture),*args],env=env,stderr=subprocess.STDOUT,text=True).strip()\nfg('init');(fixture/'file').write_text('base');fg('add','file');fg('commit','-m','fixture base');fg('checkout','-b','pr');(fixture/'file').write_text('frozen');fg('commit','-am','fixture frozen');frozen=fg('rev-parse','HEAD');fg('checkout','-b','latest','HEAD~1');(fixture/'new').write_text('prerequisite');fg('add','new');fg('commit','-m','fixture prerequisite');latest=fg('rev-parse','HEAD');fg('checkout','pr');fg('merge','--no-commit','--no-ff','-s','ours',latest);assert fg('rev-parse','HEAD')==frozen and fg('rev-parse','MERGE_HEAD')==latest and (fixture/'file').read_text()=='frozen';(fixture/'file').write_text('reviewed');(fixture/'new').write_text('prerequisite');fg('add','file','new');fg('diff','--cached','--check')\n(A/'ordinary-ours-ancestry-fixture.json').write_text(json.dumps({'passed':True,'path':str(fixture),'scope':'normal ours --no-commit ancestry before reviewed source promotion/stage; no production metadata surgery'},indent=2)+'\\n')\n# Archive all exact original changed source preimages and default index, verify before mutation.\narchive=A/'execution-source-pre-promotion.tar.gz';assert not archive.exists()\nwith tarfile.open(archive,'w:gz') as tar:\n for row in rows:\n  p=row['path'];data,mode=raw(T/p)\n  if data is None:continue\n  item=tarfile.TarInfo(p);item.mode=stat.S_IMODE((T/p).lstat().st_mode)\n  if mode=='120000':item.type=tarfile.SYMTYPE;item.linkname=data.decode();tar.addfile(item)\n  else:item.size=len(data);tar.addfile(item,io.BytesIO(data))\nwith tarfile.open(archive,'r:gz') as tar:\n for item in tar.getmembers():\n  row=next(r for r in rows if r['path']==item.name);data=item.linkname.encode() if item.issym() else tar.extractfile(item).read();assert hashlib.sha256(data).hexdigest()==row['before']['sha256'] and item.mode==stat.S_IMODE((T/item.name).lstat().st