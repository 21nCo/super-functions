nitions/CUSTOM_SKILLPLANE_CONTEXT_CREATE.json\n/Users/serro/.composio/tool_definitions/CUSTOM_SKILLPLANE_WORKSPACES_LIST.json\n/Users/serro/.composio/tool_definitions/CUSTOM_SKILLPLANE_SKILL_ARCHIVE.json\n/Users/serro/.composio/tool_definitions/NOTION_FETCH_DATABASE.json\n/Users/serro/.composio/tool_definitions/CUSTOM_SKILLPLANE_CONTEXT_NOTE_UPSERT.json\n/Users/serro/.composio/tool_definitions/CUSTOM_SKILLPLANE_SKILL_ASSET_RETRIEVE.json\n/Users/serro/.composio/tool_definitions/NOTION_RETRIEVE_PAGE.json\n/Users/serro/.composio/tool_definitions/CUSTOM_SKILLPLANE_CONTEXT_KNOWLEDGE_UPDATE.json\n/Users/serro/.composio/tool_definitions/LINEAR_GET_LINEAR_PROJECT.json\n/Users/serro/.composio/tool_definitions/CUSTOM_SKILLPLANE_SKILL_VERSIONS_LIST.json\n💥  services/HttpServerError  • \nCaused by: 404 {\"error\":{\"message\":\"Tool CUSTOM_SKILLPLANE_SKILL_RETRIEVE not found\",\"code\":2401,\"slug\":\"Tool_ToolNotFound\",\"status\":404,\"request_id\":\"27327128-a3a9-4b24-a077-2a58e867958f\",\"suggested_fix\":\"Check your input.\"}} \r\n\r\n◯\r\n╰─ composio-cli\r\n   ~ 3080ms\r\n     name: @composio/cli\r\n     filename: src/bin.ts\n\nUSAGE\n  composio execute \u003cslug\u003e [-d, --data text] [--account selector] [--file path] [--dry-run] [--get-schema] [--parallel]\n\nDESCRIPTION\n  Execute a tool by slug. Validates inputs against cached schemas and checks connections automatically — just try it and it will tell you what to fix.\n\nARGUMENTS\n  \u003cslug\u003e                  Tool slug for single execute, or repeated \u003cslug\u003e -d \u003ctext\u003e pairs when using -p/--parallel\n\nOPTIONS\n  -d, --data \u003ctext\u003e       JSON or JS-style object arguments, e.g. -d '{ repo: \"foo\" }', @file, or - for stdin\n  -p, --parallel          Execute repeated TOOL_SLUG -d \u003ctext\u003e groups concurrently\n  --account \u003cselector\u003e    Select a connected account by alias, word_id, or connected account ID\n  --file \u003cpath\u003e           Inject a local file path into the single file_uploadable input\n  --get-schema            Fetch and print the CLI-facing input schema without executing\n  --dry-run               Validate and preview the tool call without executing\n\nFLAGS\n  --skip-connection-check     Skip the connected-account check\n  --skip-tool-params-check    Skip input validation against cached schema\n  --skip-checks               Skip both checks above\n\nEXAMPLES\n  # Send an email\n  composio execute GMAIL_SEND_EMAIL -d '{ recipient_email: \"a@b.com\", subject: \"Hello\", body: \"World\" }'\n  \n  # Create a GitHub issue with a named account\n  composio execute GITHUB_CREATE_ISSUE --account work -d '{ owner: \"acme\", repo: \"app\", title: \"Bug report\", body: \"Steps to reproduce...\" }'\n  \n  # Preview what a tool call would send without executing\n  composio execute SLACK_SEND_A_MESSAGE_TO_A_SLACK_CHANNEL --dry-run -d '{ channel: \"general\", text: \"Hello team\" }'\n  \n  # Check what inputs a tool needs\n  composio execute GMAIL_SEND_EMAIL --get-schema\n  \n  # Read arguments from a file\n  composio execute GITHUB_CREATE_ISSUE -d @issue.json\n  \n  # Execute multiple tools concurrently\n  composio execute -p GMAIL_SEND_EMAIL -d '{ recipient_email: \"a@b.com\" }' GITHUB_CREATE_AN_ISSUE -d '{ owner: \"acme\", repo: \"app\", title: \"Bug\" }'\n\nSEE ALSO\n  composio search \"\u003cquery\u003e\"               Find tool slugs by use case\n  composio tools info \u003cslug\u003e              Schema summary with jq hints\n  composio link \u003ctoolkit\u003e                 Connect an account for a toolkit\n  composio artifacts cwd                  Print the current session artifact directory\n\n","type":"input_text"}],"type":"custom_tool_call_output"},{"encrypted_content":"REDACTED","id":"rs_05349b17f5ad9d6a016aae5cdff0e487d09ee0382c9a10565d","internal_chat_message_metadata_passthrough":{"turn_id":"01a0b91a-027b-7173-bd75-a52040008bc7"},"summary":[{"text":"**Inspecting session logs for validation commands**","type":"summary_text"}],"type":"reasoning"},{"call_id":"call_38Z4mglmb9mcm19mYB8nnmSy","id":"ctc_05349b17f5ad9d6a016aae5ce2b24887d0bd25c71a015896b0","input":"const r = await tools.exec_command({cmd:\"rg -n -m 5 'CUSTOM_SKILLPLANE_SKILL_RETRIEVE.*workspaceSlug.*21n' /Users/serro/.codex/sessions /Users/serro/.codex/archived_sessions 2\u003e/dev/null | tail -n 10\",\"workdir\":\"/Users/serro/Documents/dev/n/worktrees/superfunctions/PR-170\",\"yield_time_ms\":10000,\"max_output_tokens\":16000}); text(r.output);\n","internal_chat_message_metadata_passthrough":{"create_time":1789811934.619777,"turn_id":"01a0b91a-027b-7173-bd75-a52040008bc7"},"name":"exec","status":"completed","type":"custom_tool_call"},{"call_id":"call_38Z4mglmb9mcm19mYB8nnmSy","id":"ctco_01a0b91a-ec00-7220-b275-942c8b317fb8","internal_chat_message_metadata_passthrough":{"create_time":1789811944.448046,"turn_id":"01a0b91a-027b-7173-bd75-a52040008bc7"},"output":[{"text":"Script completed\nWall time 4.4 seconds\nOutput:\n","type":"input_text"},{"text":"Warning: truncated output (original token count: 16027)\nTotal output lines: 8\n\nWarning: truncated output (original token count: 44577)\nTotal output lines: 10\n\n/Users/serro/.codex/sessions/2026/09/12/rollout-2026-09-12T11-29-28-01a09433-0d85-7c73-b6d3-8256f2b2aa01.jsonl:936:{\"timestamp\":\"2026-09-13T17:30:39.553Z\",\"ordinal\":935,\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call\",\"id\":\"ctc_07a903b2d2a59864016aa6ddb8426887d09463cb8ac70ffeeb\",\"status\":\"completed\",\"call_id\":\"call_gckVhDurxcVoyrGTmHQsgG69\",\"name\":\"exec\",\"input\":\"text(await tools.exec_command({cmd:\\\"export PATH=/Users/serro/.local/bin:/Users/serro/.nvm/versions/node/v22.22.1/bin:/opt/homebrew/bin:$PATH\\\\ncomposio execute CUSTOM_SKILLPLANE_SKILL_RETRIEVE -d '{\\\\\\\"skill\\\\\\\":{\\\\\\\"workspaceSlug\\\\\\\":\\\\\\\"21n\\\\\\\",\\\\\\\"skillSlug\\\\\\\":\\\\\\\"pr-refetch-fix\\\\\\\"},\\\\\\\"caller\\\\\\\":{\\\\\\\"agentId\\\\\\\":\\\\\\\"codex\\\\\\\",\\\\\\\"agentName\\\\\\\":\\\\\\\"Codex\\\\\\\",\\\\\\\"modelProvider\\\\\\\":\\\\\\\"OpenAI\\\\\\\",\\\\\\\"modelName\\\\\\\":\\\\\\\"GPT-6\\\\\\\",\\\\\\\"modelVersion\\\\\\\":\\\\\\\"unknown\\\\\\\",\\\\\\\"clientName\\\\\\\":\\\\\\\"Codex Desktop\\\\\\\",\\\\\\\"clientVersion\\\\\\\":\\\\\\\"unknown\\\\\\\",\\\\\\\"runId\\\\\\\":\\\\\\\"data4-pr178-fix\\\\\\\",\\\\\\\"sessionId\\\\\\\":\\\\\\\"01a09433-0d85-7c73-b6d3-8256f2b2aa01\\\\\\\",\\\\\\\"conversationId\\\\\\\":\\\\\\\"01a09433-0d85-7c73-b6d3-8256f2b2aa01\\\\\\\"}}' \u003e /tmp/data4-live-skill.json\\\\ncat /tmp/data4-live-skill.json\\\",\\\"shell\\\":\\\"/bin/zsh\\\",\\\"login\\\":false,\\\"workdir\\\":\\\"/\\\",\\\"max_output_tokens\\\":6500}));\\n\",\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"01a09bd1-7b0d-7921-b0f2-701aa6793cfc\",\"create_time\":1789320630.387021}}}\n/Users/serro/.codex/sessions/2026/09/12/rollout-2026-09-12T11-29-28-01a09433-0d85-7c73-b6d3-8256f2b2aa01.jsonl:938:{\"timestamp\":\"2026-09-13T17:30:47.720Z\",\"ordinal\":937,\"type\":\"event_msg\",\"payload\":{\"type\":\"item_completed\",\"thread_id\":\"01a09433-0d85-7c73-b6d3-8256f2b2aa01\",\"turn_id\":\"01a09bd1-7b0d-7921-b0f2-701aa6793cfc\",\"item\":{\"type\":\"CommandExecution\",\"id\":\"exec-61ef72fe-73d5-4f24-a973-ccbe826c9c04\",\"process_id\":\"61251\",\"command\":[\"/bin/zsh\",\"-c\",\"export PATH=/Users/serro/.local/bin:/Users/serro/.nvm/versions/node/v22.22.1/bin:/opt/homebrew/bin:$PATH\\ncomposio execute CUSTOM_SKILLPLANE_SKILL_RETRIEVE -d '{\\\"skill\\\":{\\\"workspaceSlug\\\":\\\"21n\\\",\\\"skillSlug\\\":\\\"pr-refetch-fix\\\"},\\\"caller\\\":{\\\"agentId\\\":\\\"codex\\\",\\\"agentName\\\":\\\"Codex\\\",\\\"modelProvider\\\":\\\"OpenAI\\\",\\\"modelName\\\":\\\"GPT-6\\\",\\\"modelVersion\\\":\\\"unknown\\\",\\\"clientName\\\":\\\"Codex Desktop\\\",\\\"clientVersion\\\":\\\"unknown\\\",\\\"runId\\\":\\\"data4-pr178-fix\\\",\\\"sessionId\\\":\\\"01a09433-0d85-7c73-b6d3-8256f2b2aa01\\\",\\\"conversationId\\\":\\\"01a09433-0d85-7c73-b6d3-8256f2b2aa01\\\"}}' \u003e /tmp/data4-live-skill.json\\ncat /tmp/data4-live-skill.json\"],\"cwd\":\"file:///\",\"parsed_cmd\":[{\"type\":\"unknown\",\"cmd\":\"export PATH=/Users/serro/.local/bin:/Users/serro/.nvm/versions/node/v22.22.1/bin:/opt/homebrew/bin:$PATH\\ncomposio execute CUSTOM_SKILLPLANE_SKILL_RETRIEVE -d '{\\\"skill\\\":{\\\"workspaceSlug\\\":\\\"21n\\\",\\\"skillSlug\\\":\\\"pr-refetch-fix\\\"},\\\"caller\\\":{\\\"agentId\\\":\\\"codex\\\",\\\"agentName\\\":\\\"Codex\\\",\\\"modelProvider\\\":\\\"OpenAI\\\",\\\"modelName\\\":\\\"GPT-6\\\",\\\"modelVersion\\\":\\\"unknown\\\",\\\"clientName\\\":\\\"Codex Desktop\\\",\\\"clientVersion\\\":\\\"unknown\\\",\\\"runId\\\":\\\"data4-pr178-fix\\\",\\\"sessionId\\\":\\\"01a09433-0d85-7c73-b6d3-8256f2b2aa01\\\",\\\"conversationId\\\":\\\"01a09433-0d85-7c73-b6d3-8256f2b2aa01\\\"}}' \u003e /tmp/data4-live-skill.json\\ncat /tmp/data4-live-skill.json\"}],\"source\":\"unified_exec_startup\",\"status\":\"completed\",\"stdout\":\"{\\n  \\\"successful\\\": true,\\n  \\\"data\\\": {\\n    \\\"context\\\": null,\\n    \\\"files\\\": [\\n      {\\n        \\\"byteSize\\\": 12265,\\n        \\\"mediaType\\\": \\\"text/markdown; charset=utf-8\\\",\\n        \\\"path\\\": \\\"SKILL.md\\\",\\n        \\\"sha256\\\": \\\"69349d0b23c1be2bd0f8658de8d1ffa784cd86098bd22055004519f5f2f04152\\\"\\n      },\\n      {\\n        \\\"byteSize\\\": 655,\\n        \\\"mediaType\\\": \\\"application/json\\\",\\n        \\\"path\\\": \\\"skill.json\\\",\\n        \\\"sha256\\\": \\\"101d68f641e1e37ebec4e65c5ed5335db5a191c15f5342d42d711ff4468b06f2\\\"\\n      }\\n    ],\\n    \\\"instructions\\\": \\\"---\\\\nname: pr-refetch-fix\\\\ndescription: \\\\\\\"Run exactly one bounded GitHub PR review-remediation pass: fetch all pending review surfaces, validate findings against the exact PR worktree, fix current valid issues, verify, push one reviewed fix commit to the PR, report, and stop without any post-push refetch, CI wait, or reviewer loop.\\\\\\\"\\\\n---\\\\n\\\\n# PR Refetch Fix\\\\n\\\\nRefetch the current GitHub pull-request review queue, fix the findings that remain valid against the exact PR worktree, verify the affected code, push the fixes to the PR once, report, and stop.\\\\n\\\\n## Absolute single-round boundary\\\\n\\\\nThis skill performs exactly one bounded round per invocation.\\\\n\\\\nOne round is:\\\\n\\\\n1. identify the PR, authentication context, exact head branch, and dedicated worktree\\\\n2. fetch the current review surfaces once\\\\n3. classify the fetched findings against the current worktree\\\\n4. trace each valid root cause across affected paths and fix the complete scoped behavior\\\\n5. run proportionate local verification\\\\n6. when fixes were made, create one reviewed commit and push it to the PR head branch\\\\n7. report the result and stop\\\\n\\\\nAfter step 7, the invocation is complete.\\\\n\\\\nDo not:\\\\n\\\\n- refetch review feedback after the push\\\\n- wait for reviewers or bots to analyze the new commit\\\\n- poll CI until completion\\\\n- begin another fetch/fix/test/push cycle\\\\n- keep working because new feedback arrives asynchronously\\\\n- interpret \\\\\\\"latest\\\\\\\", \\\\\\\"complete\\\\\\\", or \\\\\\\"fix pending findings\\\\\\\" as permission for an open-ended loop\\\\n\\\\nA second round requires a new, explicit user invocation. If CI or reviewer checks are still running, report them as pending and stop. If no actionable findings are present, report that and stop. If the round is blocked, report the blocker and stop rather than monitoring for a state change.\\\\n\\\\n## Core review rule\\\\n\\\\nUse current unresolved review threads as the primary queue. Timestamp filtering is secondary.\\\\n\\\\nThe workflow must prevent these failure modes:\\\\n\\\\n- querying only inline comments after a guessed cutoff\\\\n- missing findings in review threads, review bodies, or issue comments\\\\n- ignoring an older unresolved thread that is still valid on the current head\\\\n- treating every unresolved bot comment as valid without inspecting current code\\\\n- fixing against the wrong branch or worktree\\\\n- starting an unbounded post-push review loop\\\\n\\\\n## 1. Identify the PR and authentication context\\\\n\\\\nPreserve the user's established GitHub authentication context for every GitHub command, for example:\\\\n\\\\n```bash\\\\nGH_CONFIG_DIR=~/.config/gh-other\\\\n```\\\\n\\\\nResolve the repository and PR number from the current branch, worktree, supplied PR URL, or explicit user input.\\\\n\\\\n## 2. Use only the PR's corresponding worktree\\\\n\\\\nBefore fetching comments or editing code:\\\\n\\\\n1. locate the PR's dedicated worktree\\\\n2. confirm its checked-out branch equals the PR head branch\\\\n3. inspect its existing tracked, staged, unstaged, and untracked state\\\\n4. preserve unrelated work and artifacts\\\\n\\\\nMinimum checks:\\\\n\\\\n```bash\\\\ngit branch --show-current\\\\ngit status --short\\\\ngit remote -v\\\\n```\\\\n\\\\nTreat that exact worktree as the source of truth for code, validation, staging, and commit decisions. Do not validate comments against a main checkout, base branch, sibling branch, or another PR's worktree.\\\\n\\\\nIf multiple PRs are requested, each PR is a separate round unless the user explicitly defines one bounded multi-PR round.\\\\n\\\\n## 3. Fetch the current review surfaces once\\\\n\\\\nStart with paginated GraphQL review threads. Fetch every page when more than 100 threads may exist.\\\\n\\\\n```bash\\\\nGH_CONFIG_DIR=~/.config/gh-other gh api graphql --paginate -f query='\\\\nquery($endCursor: String) {\\\\n  repository(owner: \\\\\\\"OWNER\\\\\\\", name: \\\\\\\"REPO\\\\\\\") {\\\\n    pullRequest(number: PR_NUMBER) {\\\\n      reviewThreads(first: 100, after: $endCursor) {\\\\n        nodes {\\\\n          id\\\\n          isResolved\\\\n          path\\\\n          comments(first: 20) {\\\\n            nodes {\\\\n              body\\\\n              author { login }\\\\n              createdAt\\\\n              outdated\\\\n              url\\\\n              diffHunk\\\\n              originalLine\\\\n              line\\\\n            }\\\\n            pageInfo { hasNextPage endCursor }\\\\n          }\\\\n        }\\\\n        pageInfo { hasNextPage endCursor }\\\\n      }\\\\n    }\\\\n  }\\\\n}'\\\\n```\\\\n\\\\nCheck every returned `pageInfo`, including nested comment connections. Do not assume `--paginate` traversed a nested GraphQL connection: explicitly follow its cursor if necessary. Complete every required connection. Record the head SHA and ensure it stays unchanged throughout collection; if it changes, discard the inconsistent snapshot and re-establish the exact head before editing.\\\\n\\\\nThen inspect the supplementary surfaces once:\\\\n\\\\n1. PR review bodies\\\\n2. PR issue comments\\\\n3. raw inline review comments when needed for metadata or export\\\\n\\\\n```bash\\\\nGH_CONFIG_DIR=~/.config/gh-other gh pr view PR_NUMBER --repo OWNER/REPO --json headRefOid,reviews,comments,updatedAt,url\\\\n```\\\\n\\\\n```bash\\\\nGH_CONFIG_DIR=~/.config/gh-other gh api --paginate repos/OWNER/REPO/pulls/PR_NUMBER/comments\\\\n```\\\\n\\\\nDo not replace unresolved-thread discovery with only `gh pr view --json comments`, only `pulls/\u003cn\u003e/comments`, or only a timestamp query.\\\\n\\\\n## 4. Use timestamps only as a secondary lens\\\\n\\\\nIf the user explicitly asks for findings since a push:\\\\n\\\\n1. resolve the exact pushed commit SHA\\\\n2. read its absolute UTC timestamp\\\\n3. use that timestamp only to describe which feedback arrived later\\\\n\\\\nStill include an older unresolved thread when it remains actionable on the current head.\\\\n\\\\n## 5. Classify root causes before editing\\\\n\\\\nKeep a compact working ledger keyed by root cause: thread IDs/URLs, snapshot SHA, affected paths, current-code evidence, status, and verification. Keep it in task context unless an artifact is requested.\\\\n\\\\nClassify every relevant finding as exactly one of:\\\\n\\\\n- `Actionable`: a current defect within scope that can be addressed in this round.\\\\n- `Skipped (Already Fixed / Stale)`: current-code evidence shows the behavior is fixed, superseded, or no longer applicable. An outdated hunk alone is not proof; trace its current implementation.\\\\n- `Not Attempted`: a blocked current defect, out-of-scope concern, or external/non-code gate. Distinguish these reasons. A valid blocked defect remains unresolved; do not count it as clean.\\\\n\\\\nDeduplicate comments reporting the same root cause. An unchanged old comment is not evidence that its issue is fixed. Reuse prior verified evidence only when the relevant code and contract remain unchanged.\\\\n\\\\n## 6. Establish the affected contract\\\\n\\\\nFor each actionable root cause, before editing:\\\\n\\\\n1. State the behavior that must hold and the concrete failing case.\\\\n2. Trace its producers, consumers, callers, and sibling implementations in the PR worktree. Inspect equivalent entrypoints such as CLI versus batch operations, gateway versus worker execution, and normal versus retry/recovery paths when relevant.\\\\n3. Identify where the invariant is enforced and what the proposed change could break. For stateful changes, consider ownership, fencing, ordering, partial failure, and cleanup where they affect this contract.\\\\n4. Record which paths need changes, which already satisfy the contract, and the behavioral evidence needed to verify the fix.\\\\n\\\\nThe unit of remediation is the root cause and its affected contract, not the commented line. A directly related defect discovered during this inspection belongs to the same scoped batch even when no reviewer named that line. Record its connection to the snapshot finding. Unrelated discoveries remain out of scope.\\\\n\\\\n## 7. Implement the smallest complete repair\\\\n\\\\nRepair every applicable path identified above. Prefer a shared enforcement point when it simplifies correctness; do not introduce an abstraction solely to satisfy this procedure.\\\\n\\\\nPreserve unrelated dirty work and exclude unrelated untracked and `.conduct/` artifacts. Do not expand into repository-wide cleanup or redesign. If a complete repair requires expanded authority or an unavailable dependency, explain the remaining defect and classify it as blocked rather than presenting a symptom patch as complete.\\\\n\\\\n## 8. Verify behavior and review the fix batch\\\\n\\\\nFor each root cause, demonstrate the previously failing behavior and its corrected outcome with focused regression coverage where practical. Confirm the test would fail on the old behavior, by running it against the old code when safe or by explaining the distinguishing assertion. Do not claim a reproduced failure when it was only reasoned through.\\\\n\\\\nUse evidence appropriate to the contract:\\\\n\\\\n- For SQL, claims, locks, and transactions, prove resulting state and relevant concurrency behavior using a real disposable database when feasible. SQL-text assertions alone do not establish correctness.\\\\n- For retry/recovery, cover the relevant interrupted state and the evidence needed to declare success.\\\\n- For configuration propagation, verify both the executing component's configuration and required secret wiring without deploying.\\\\n- Tests that mutate fixtures must restore prior values and row existence or use isolated disposable fixtures.\\\\n\\\\nIf behavioral verification is unavailable, report the gap explicitly. Test counts, mocks that mirror the implementation, and typechecks are not substitutes for proof of the failing behavior.\\\\n\\\\nAfter editing, review the entire fix diff together with its callers and affected contract before staging. Check for missed sibling paths, newly broken consumers, error/cleanup regressions, and interactions between fixes. Re-run checks when justified by subsequent changes or unresolved concerns. Complete local repair and verification within this single pre-push batch.\\\\n\\\\nRun focused tests first, then proportionate typecheck, lint, test, and build gates. Distinguish change-caused failures, baseline/environment limits, local proof, and external state.\\\\n\\\\nDo not wait for external CI in this skill. A single immediate check snapshot is allowed for reporting; no polling. Skipped, failed, or absent reviewers do not prove coverage.\\\\n\\\\n## 9. Commit and push the fixes exactly once\\\\n\\\\nInvoking this skill authorizes one reviewed commit and one normal push of the fixes produced by this round to the PR head branch. Do not leave completed fixes only in the local worktree. If the fetched snapshot contains no actionable findings and no changes were made, do not create an empty commit or push.\\\\n\\\\nBefore committing:\\\\n\\\\n1. review the exact staged allowlist\\\\n2. run `git diff --cached --check`\\\\n3. confirm unrelated artifacts are excluded\\\\n4. confirm the root-cause ledger identifies evidence for every claimed fix and lists remaining valid defects\\\\n\\\\nCreate exactly one commit for the reviewed fix batch and push it once to the PR head branch. Do not force-push. Verify the local, remote, and PR head SHAs once after pushing.\\\\n\\\\nDo not refetch review feedback after the push. Do not wait for the pushed commit to receive new reviews.\\\\n\\\\n## 10. Reconcile the queue\\\\n\\\\nSeparate remaining code defects from open GitHub thread count. Report how many snapshot threads are fixed/already fixed, still valid, blocked, or unassessed, distinguishing thread counts from deduplicated root causes.\\\\n\\\\nThis skill does not by itself authorize posting replies, resolving threads, or dismissing reviews. If separately authorized by the user, resolve only snapshot threads whose full concern is covered by current-code evidence and the verified PR head; use captured IDs and mutation responses without refetching feedback. Never resolve a valid blocked finding or dismiss a review merely to reduce the count. Otherwise report fixed threads as eligible for resolution while leaving their GitHub state unchanged.\\\\n\\\\n## 11. Report and terminate\\\\n\\\\nReport with these explicit buckets:\\\\n\\\\n- `Fixed`\\\\n- `Skipped (Already Fixed / Stale)`\\\\n- `Not Attempted`\\\\n- `Verification`\\\\n\\\\nFor each fixed root cause, summarize affected paths and behavioral evidence. Include unverified contracts and valid blocked defects; a completed round does not establish merge readiness.\\\\n\\\\nInclude the exact pushed commit SHA and PR URL. If no changes were needed, say explicitly that no commit or push was created. State any pending CI or reviewer checks without waiting for them.\\\\n\\\\nEnd with a clear termination statement such as:\\\\n\\\\n\u003e One review round is complete. No post-push refetch or additional review loop was performed.\\\\n\\\\nThen stop.\\\\n\\\",\\n    \\\"requestId\\\": \\\"mcp:3c335f02-2c81-4758-a251-90f9cb109ee9\\\",\\n    \\\"skill\\\": {\\n      \\\"description\\\": \\\"Run exactly one bounded GitHub PR review-remediation pass: fetch all pending review surfaces, validate findings against the exact PR worktree, fix only current valid issues, verify, optionally commit and push once when authorized, report, and stop without any post-push refetch, CI wait, or reviewer loop.\\\",\\n      \\\"id\\\": \\\"skill:3ba0f6dd-212c-4933-9feb-cf87481a0466\\\",\\n      \\\"name\\\": \\\"PR Refetch Fix\\\",\\n      \\\"slug\\\": \\\"pr-refetch-fix\\\",\\n      \\\"tags\\\": [\\n        \\\"code-review\\\",\\n        \\\"github\\\",\\n        \\\"pull-request\\\",\\n        \\\"remediation\\\",\\n        \\\"single-pass\\\"\\n      ],\\n      \\\"visibility\\\": \\\"workspace\\\",\\n      \\\"workspaceId\\\": \\\"workspace:cf0aa9c5-76c8-4a89-8a9b-66c70676c298\\\",\\n      \\\"workspaceSlug\\\": \\\"21n\\\"\\n    },\\n    \\\"version\\\": {\\n      \\\"byteSize\\\": 5651,\\n      \\\"createdAt\\\": \\\"2026-09-09T17:38:10.122Z\\\",\\n      \\\"digest\\\": \\\"sha256:c6186e4effc2485960cce349697391b44a84ea55d4d58480e0d5f37cfe32286a\\\",\\n      \\\"id\\\": \\\"skill-version:41d2d2e7-7ed7-4a32-9bdd-22e5f42f4c09\\\",\\n      \\\"manifest\\\": {\\n        \\\"byteSize\\\": 5651,\\n        \\\"digest\\\": \\\"sha256:c6186e4effc2485960cce349697391b44a84ea55d4d58480e0d5f37cfe32286a\\\",\\n        \\\"expandedByteSize\\\": 12920,\\n        \\\"fileCount\\\": 2,\\n        \\\"files\\\": [\\n          {\\n            \\\"byteSize\\\": 12265,\\n            \\\"mediaType\\\": \\\"text/markdown; charset=utf-8\\\",\\n            \\\"path\\\": \\\"SKILL.md\\\",\\n            \\\"sha256\\\": \\\"69349d0b23c1be2bd0f8658de8d1ffa784cd86098bd22055004519f5f2f04152\\\"\\n          },\\n          {\\n            \\\"byteSize\\\": 655,\\n            \\\"mediaType\\\": \\\"application/json\\\",\\n            \\\"path\\\": \\\"skill.json\\\",\\n            \\\"sha256\\\": \\\"101d68f641e1e37ebec4e65c5ed5335db5a191c15f5342d42d711ff4468b06f2\\\"\\n          }\\n        ],\\n        \\\"formatVersion\\\": 1\\n      },\\n      \\\"publishedAt\\\": \\\"2026-09-09T17:44:50.457Z\\\",\\n      \\\"revision\\\": 3,\\n      \\\"semanticVersion\\\": \\\"1.1.0\\\",\\n      \\\"state\\\": \\\"published\\\"\\n    }\\n  },\\n  \\\"error\\\": null,\\n  \\\"logId\\\": \\\"log_WVyHxtmjqZog\\\"\\n}\\n\",\"stderr\":\"\",\"aggregated_output\":\"{\\n  \\\"successful\\\": true,\\n  \\\"data\\\": {\\n    \\\"context\\\": null,\\n    \\\"files\\\": [\\n      {\\n        \\\"byteSize\\\": 12265,\\n        \\\"mediaType\\\": \\\"text/markdown; charset=utf-8\\\",\\n        \\\"path\\\": \\\"SKILL.md\\\",\\n        \\\"sha256\\\": \\\"69349d0b23c1be2bd0f8658de8d1ffa784cd86098bd22055004519f5f2f04152\\\"\\n      },\\n      {\\n        \\\"byteSize\\\": 655,\\n        \\\"mediaType\\\": \\\"application/json\\\",\\n        \\\"path\\\": \\\"skill.json\\\",\\n        \\\"sha256\\\": \\\"101d68f641e1e37ebec4e65c5ed5335db5a191c15f5342d42d711ff4468b06f2\\\"\\n      }\\n    ],\\n    \\\"instructions\\\": \\\"---\\\\nname: pr-refetch-fix\\\\ndescription: \\\\\\\"Run exactly one bounded GitHub PR review-remediation pass: fetch all pending review surfaces, validate findings against the exact PR worktree, fix current valid issues, verify, push one reviewed fix commit to the PR, report, and stop without any post-push refetch, CI wait, or reviewer loop.\\\\\\\"\\\\n---\\\\n\\\\n# PR Refetch Fix\\\\n\\\\nRefetch the current GitHub pull-request review queue, fix the findings that remain valid against the exact PR worktree, verify the affected code, push the fixes to the PR once, report, and stop.\\\\n\\\\n## Absolute single-round b…6027 tokens truncated…itory read-only review still permits this reporting step; fixing code, posting GitHub/Linear comments, merging and changing permissions remain separately authorized actions. If the destination is ambiguous, continue the review and clarify only the destination. Do not choose an unrelated workspace or broaden sharing.\\\\n\\\\n## Integrations and Composio fallback\\\\n\\\\nPrefer reachable direct integrations/MCPs for **GitHub, Linear, Notion, and Skillplane**. If any is absent, unreachable, or fails authentication, **try Composio CLI for that service before declaring access blocked**. A direct MCP or browser login failure does not prove the separate Composio connection is unusable. This fallback applies to reading issues/comments, PR metadata/reviews, skills/assets, and authorized Notion updates.\\\\n\\\\nUse a supplied Composio skill when available and read `references/integrations.md` when routing through Composio. Discover and inspect an operation once, then reuse its verified slug/schema and intended account. Batch independent reads, script dependent pagination, and retain full results outside the model context. An existing working `gh` CLI is suitable for GitHub and exact Git operations.\\\\n\\\\nThe `splane` bootstrap must know this fallback **before** it retrieves this skill: direct MCP failure → Composio → intended workspace → live skill and required assets. Do not substitute local cached instructions. When memory lookup is available, search relevant extension/ad hoc notes as well as its registry. A copyable entry-workflow instruction is included in the integration reference; a rule inside an unread skill cannot repair its caller. Do not edit client entry workflows or memories unless authorized.\\\\n\\\\n## 1. Establish the review snapshot\\\\n\\\\nResolve repository, PR number, current head SHA, base SHA, merge base, dependencies, and snapshot time. Read applicable repository instructions. Inventory the current checkout and worktrees before deciding how to inspect code; preserve dirty files, unrelated artifacts, and other agents' work.\\\\n\\\\nRepository review is read-only by default: do not fix, commit, push, merge, close PRs, resolve threads, or post GitHub/Linear comments unless separately requested. Notion analysis publication follows the reporting default above. Necessary regression probes may use temporary files and existing test facilities. Prefer an existing clean exact-head checkout; avoid creating many worktrees or installing duplicate dependencies. Run resource-heavy checks serially. If another agent is editing a checkout, inspect the immutable commit instead.\\\\n\\\\nRead the complete PR diff, affected callers, tests, public types, execution paths, package exports, dependency changes, and relevant docs. Trace important behavior beyond changed lines. Record coverage gaps explicitly; a diff-only review is not a full integration review.\\\\n\\\\n## 2. Ground judgment in the issue and prior implementations\\\\n\\\\nFetch the linked Linear issue, acceptance criteria, design/architecture documents, dependencies, and comments. Resolve attachments and linked documents when material. Treat explicit requirements as the implementation contract; distinguish required architecture from an optional implementation preference. If requirements are inaccessible, mark the review provisional rather than inventing them.\\\\n\\\\nFetch all GitHub review surfaces: paginated unresolved review threads first, then review bodies and PR conversation comments. Save complete raw responses to the analysis evidence directory. Build a compact index of thread ID, author, current path/line, resolution/outdated state, finding summary and source link. Group duplicates by root cause before reading detailed supporting bodies. Load evidence selectively without discarding unmapped comments; do not repeatedly dump whole responses or use truncated output as proof of coverage. For GraphQL, paginate nested comments when necessary too. Classify each relevant finding as current/actionable, already fixed/stale, duplicate, unverified, or non-code/irrelevant. Reproduce or trace current code before adopting a bot finding. A successful reviewer run is not proof of review coverage; a failed run is not a code defect.\\\\n\\\\nWhen comparison is requested or clearly relevant, identify the alternative PRs/sessions for the same issue from issue comments, links, and history. Compare the same acceptance criteria and record each exact head. Distinguish original submission quality, later agent fixes, and fixes supplied by others. Do not attribute current-head test results to older commits or rank unrelated tasks as though they had equal difficulty.\\\\n\\\\n## 3. Separate implementation authorship from analysis provenance\\\\n\\\\nCreate an analysis ID for each fresh assessment, including repeat analyses of the same PR and same head. Preserve it for publication retries. Capture analysis start/completion time, repository/PR, reviewed head/base/merge-base, source snapshot identity, scope, skill slug/version, reviewer client/harness and version, reviewer provider/model/version, reasoning setting, execution environment, task/session ID or link, and attribution source/confidence. Use explicit unknown values where unavailable; never infer hidden metadata. Distinguish the reviewer model from the implementation author model. Record mixed reviewer turns or delegated contributions when material. See the report template for the metadata shape.\\\\n\\\\nA GitHub author or branch name does not establish the implementation model. Correlate issue comments, PR links, session identifiers, transcript metadata, and commits. For local Codex work, use available task/session tools or narrowly search the known session ID under the local Codex session directory. Do not broadly dump unrelated conversations.\\\\n\\\\nRecord harness/client, execution environment, exact model/version when available, source, and confidence. Label user-reported attribution separately from metadata-confirmed attribution. A session may switch models: attribute individual turns or commit ranges, or mark it mixed. Never infer a model from code style or from the model currently performing this review.\\\\n\\\\nUse transcripts to explain observable decisions: requirement missed, shortcut chosen, test omitted, mistaken assumption, and whether later evidence changed the approach. Quote/link the decisive evidence. If the transcript is unavailable, say so; code alone cannot prove why an agent chose an approach. Do not turn one weak PR into a universal claim about a model or harness.\\\\n\\\\n## 4. Verify behavior independently\\\\n\\\\nRun focused existing tests first and add small independent probes for suspected defects. Avoid tests that merely mirror the implementation or trust its own success labels. For example, a negative security fixture must demonstrate that the handler did not execute, not just that a returned lifecycle field says it was rejected.\\\\n\\\\nExercise the public failure path when relevant: malformed or failed input → coordinator → artifact writer/renderer → publisher/consumer, not merely a helper returning an error label. For report/validation products, probe missing or invented evidence, invalid enums, forged verdicts, stale receipts and source identity independently. Mock external mutations and use dummy credential sentinels; review authorization does not authorize live publication to GitHub. Test documented consumer commands/protocols rather than trusting README claims.\\\\n\\\\nProbe relevant boundaries: failure and cancellation paths, partial cleanup and retries, authorization before execution, malformed inputs, schema/reference recursion, untrusted keys as well as values, serialization consistency, generated-project dependencies, and public-runtime compatibility. Choose cases based on the PR's actual contract; this is not a mandatory checklist for unrelated domains.\\\\n\\\\nFor each finding, capture severity (P0 critical, P1 high, P2 material defect, P3 minor), trigger, actual behavior, expected contract, user impact, current file/line or commit link, evidence status, and the narrow complete fix. Deduplicate root causes. Separate reproduced defects from code-traced risks and hypotheses. Failed probes caused by wrong aliases, stale built packages, native ABI mismatches, or missing fixtures are not proof of a product defect.\\\\n\\\\nRun proportionate type/build/package or release gates. Record commands, runtime, exact head, counts, and failures. Retain minimal probe source, fixtures/setup, stdout/stderr, exit status and dependency provenance alongside results; identify reused dependencies versus a clean lockfile install. Distinguish a fixture repository SHA from the PR source SHA. Redact secrets before preserving or uploading evidence. Distinguish local tests, CI on that head, unrelated baseline failures, environmental blocks, and unrun checks. A green focused suite does not establish release readiness. If the head changes during review, identify which results became stale and refresh only what is needed; do not enter an open-ended review loop.\\\\n\\\\n## 5. Rate quality separately from readiness\\\\n\\\\nUse these default dimensions, adapting transparently if the task requires it:\\\\n\\\\n| Dimension | Weight | Evidence |\\\\n|---|---:|---|\\\\n| Issue/design fidelity | 30% | Acceptance coverage and documented architectural constraints |\\\\n| Correctness and safety | 30% | Runtime behavior, failure paths, data/security boundaries |\\\\n| Architecture and maintainability | 20% | Shared production paths, clear ownership, appropriate scope |\\\\n| Verification quality | 15% | Independent regression coverage and meaningful gates |\\\\n| Delivery completeness | 5% | Public contracts, docs, packaging and migration/dependency needs |\\\\n\\\\nScore dimensions 0–10 and show a short rationale; round the overall rating to the nearest 0.5. Anchor ratings: 9–10 exceptional and well verified, 7–8.5 strong foundation with bounded gaps, 5–6.5 material gaps, below 5 major contract/correctness problems. If evidence is insufficient, mark the rating provisional or unscored instead of treating missing access as poor code.\\\\n\\\\nAn average never overrides a blocker. Report **ready**, **needs fixes**, **needs review/verification**, **waiting on dependency**, or **blocked evidence**, with reasons. A 7.5/10 PR can still be unsafe to merge. Credit strong original work even when follow-up fixes are needed.\\\\n\\\\nFor harness/model comparisons, retain issue-level paired evidence, sample counts, uncertainty, original-versus-remediated scores, and model/harness confounding. Keep aggregate scorecards separate from issue-analysis pages. Do not present a few mixed tasks as a controlled benchmark.\\\\n\\\\n## 6. Deliver and publish analysis history\\\\n\\\\nUse the report template for a compact chat verdict plus detailed evidence. State what was checked, strengths, remaining defects, dependency order where relevant, and limits. Preserve a dated analysis snapshot even when the same PR/head was analyzed before; publication retry is not a new analysis.\\\\n\\\\nPublish to Notion by default unless explicitly disabled. Follow `references/notion-publication.md`: reuse the intended hub, issue and PR record; add a distinct analysis child record or section identified by analysis ID; preserve prior findings, scores and reviewer metadata; link reproducible evidence with portable references. Keep the issue comparison at the top and implementation detail/history below. An implementation record may point to the latest completed analysis, but never silently overwrite history or average conflicting analyses. Label same-head reviewer disagreements and new-head re-reviews distinctly.\\\\n\\\\nKeep aggregate harness/model scorecards separate. Distinguish author-performance records from reviewer-analysis records, and do not count multiple analyses of one implementation as independent author samples. Do not update aggregates without a stated denominator and supported attribution.\\\\n\\\\nVerify publication by reading back content **and properties**: analysis ID, full finding set, score/verdict, reviewer/author distinction, reviewed SHA, source/evidence links, relations and history. Report the Notion links only after verification. If both direct access and Composio are blocked, deliver the full local review/evidence, state the exact publication blocker and any partial writes, and retain the same analysis ID for retry. Do not claim that Notion is unchanged if a partial write succeeded.\\\\n\\\\nStop after the requested analysis and its reporting. Fixing or merging is separate unless included in the user's instructions.\\\\n\\\",\\n    \\\"requestId\\\": \\\"mcp:644375c9-8aa2-47d9-8203-53bf90694eec\\\",\\n    \\\"skill\\\": {\\n      \\\"description\\\": \\\"Review a given pull request against its issue and design, reproduce defects, assess code quality and merge readiness, verify agent/model provenance, and compare relevant implementations. Supports structured Notion QA reporting when requested.\\\",\\n      \\\"id\\\": \\\"skill:6bf2b9b6-be2c-4bd1-8d95-c146793e49b9\\\",\\n      \\\"name\\\": \\\"PR Quality Analysis\\\",\\n      \\\"slug\\\": \\\"pr-quality-analysis\\\",\\n      \\\"tags\\\": [\\n        \\\"agent-provenance\\\",\\n        \\\"code-review\\\",\\n        \\\"composio\\\",\\n        \\\"linear\\\",\\n        \\\"notion\\\",\\n        \\\"pull-request\\\",\\n        \\\"quality-analysis\\\"\\n      ],\\n      \\\"visibility\\\": \\\"private\\\",\\n      \\\"workspaceId\\\": \\\"workspace:cf0aa9c5-76c8-4a89-8a9b-66c70676c298\\\",\\n      \\\"workspaceSlug\\\": \\\"21n\\\"\\n    },\\n    \\\"version\\\": {\\n      \\\"byteSize\\\": 15432,\\n      \\\"createdAt\\\": \\\"2026-09-12T16:37:12.568Z\\\",\\n      \\\"digest\\\": \\\"sha256:3a223c0c87bf3ceb755ac4750a55e16b6f19f030bce64dee5c7a44ad6b63734f\\\",\\n      \\\"id\\\": \\\"skill-version:32a2dbde-2519-4e37-bdd3-908d9eb23fb1\\\",\\n      \\\"manifest\\\": {\\n        \\\"byteSize\\\": 15432,\\n        \\\"digest\\\": \\\"sha256:3a223c0c87bf3ceb755ac4750a55e16b6f19f030bce64dee5c7a44ad6b63734f\\\",\\n        \\\"expandedByteSize\\\": 33630,\\n        \\\"fileCount\\\": 5,\\n        \\\"files\\\": [\\n          {\\n            \\\"byteSize\\\": 13738,\\n            \\\"mediaType\\\": \\\"text/markdown; charset=utf-8\\\",\\n            \\\"path\\\": \\\"SKILL.md\\\",\\n            \\\"sha256\\\": \\\"6372a4e61608425a7fc90a14025940e01f1ad78fa7a41c0bed14abb4475f583c\\\"\\n          },\\n          {\\n            \\\"byteSize\\\": 4954,\\n            \\\"mediaType\\\": \\\"text/markdown; charset=utf-8\\\",\\n            \\\"path\\\": \\\"references/integrations.md\\\",\\n            \\\"sha256\\\": \\\"03d69956990937070d95e5211cc86da4f5db47ba61b2a4616a50a72253ad3104\\\"\\n          },\\n          {\\n            \\\"byteSize\\\": 6610,\\n            \\\"mediaType\\\": \\\"text/markdown; charset=utf-8\\\",\\n            \\\"path\\\": \\\"references/notion-publication.md\\\",\\n            \\\"sha256\\\": \\\"4a43250f07522efda869f3ba073e5afc77b5dc780bc54d70dc8393f3f93e9019\\\"\\n          },\\n          {\\n            \\\"byteSize\\\": 7168,\\n            \\\"mediaType\\\": \\\"text/markdown; charset=utf-8\\\",\\n            \\\"path\\\": \\\"references/report-template.md\\\",\\n            \\\"sha256\\\": \\\"8bcd8670dac38b5c3cf8fb4f27d225a6fa854f9be49ec1e915c79ca0e0fba0ea\\\"\\n          },\\n          {\\n            \\\"byteSize\\\": 1160,\\n            \\\"mediaType\\\": \\\"application/json\\\",\\n            \\\"path\\\": \\\"skill.json\\\",\\n            \\\"sha256\\\": \\\"f82c28f1799266e899b695333beed0b73f20fbcde68dab4f88b8567056eaaca0\\\"\\n          }\\n        ],\\n        \\\"formatVersion\\\": 1\\n      },\\n      \\\"publishedAt\\\": \\\"2026-09-12T16:43:35.309Z\\\",\\n      \\\"revision\\\": 2,\\n      \\\"semanticVersion\\\": \\\"2.0.0\\\",\\n      \\\"state\\\": \\\"published\\\"\\n    }\\n  },\\n  \\\"error\\\": null,\\n  \\\"logId\\\": \\\"log_F63GQxH4QHuR\\\"\\n}\\n\"},\"started_at_ms\":1789233618496,\"completed_at_ms\":1789233627245}}\n/Users/serro/.codex/sessions/2026/09/07/rollout-2026-09-07T14-45-31-01a07b26-bb2c-7b32-95a4-8fb6b484fad0.jsonl:8742:{\"timestamp\":\"2026-09-12T17:23:27.956Z\",\"ordinal\":8741,\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call\",\"id\":\"ctc_01c321ccb30d6141016aa58a8bc3a487d0b9508f303d3965bd\",\"status\":\"completed\",\"call_id\":\"call_lO7FyDxaC5gdCLeMRw0Is20o\",\"name\":\"exec\",\"input\":\"const q=s=\u003e\\\"'\\\"+s.replace(/'/g,\\\"'\\\\\\\\''\\\")+\\\"'\\\";\\ntext(await tools.exec_command({cmd:\\\"composio execute CUSTOM_SKILLPLANE_SKILL_RETRIEVE -d \\\"+q(JSON.stringify({caller:load(\\\"scaller\\\"),skill:{workspaceSlug:\\\"21n\\\",skillSlug:\\\"pr-linear-completeness-review\\\"},version:{selector:\\\"semanticVersion\\\",semanticVersion:\\\"1.0.0\\\"}}))+\\\" \u003e /var/folders/cy/t2l5q3kn0wq2zjr9ljyqhwzc0000gn/T/review-skill-ilxs3h6p/readback.json\\\",\\\"max_output_tokens\\\":400,\\\"yield_time_ms\\\":1000}));\\n\",\"internal_chat_message_metadata_passthrough\":{\"turn_