dential: _credential, requestInit, ...transportOptions } = options;\nmcpfn/testing/src/remote-target.ts:610:    redact: (value, redaction) => redactTargetCredentials(authenticated, value, { preserveKeys: true, ...redaction }),\nmcpfn/testing/src/remote-target.ts:624:      const lease = await acquireRemoteCredential(options.credential, context);\nmcpfn/testing/src/remote-target.ts:638:        for (const secret of credentialValues(lease.credential.headers)) {\nmcpfn/testing/src/remote-target.ts:643:        const credentialHeaders = validateRemoteCredentialHeaders(lease.credential.headers);\nmcpfn/testing/src/remote-target.ts:645:        credentialHeaders.forEach((value, name) => headers.set(name, value));\nmcpfn/testing/src/remote-target.ts:651:            // Fetch must not replay credentials to a redirect destination.\nmcpfn/testing/src/remote-target.ts:657:        // Sanitize while the lease still supplies its immutable header snapshot.\nmcpfn/testing/src/remote-target.ts:660:        try { message = redactRemoteCredential(lease.credential, error instanceof Error ? error.message : String(error)); }\nmcpfn/testing/src/remote-target.ts:661:        catch { /* Invalid or oversized credentials must not escape through diagnostics. */ }\nmcpfn/testing/src/remote-target.ts:690:              details: { message: \"Target credential cleanup failed\" },\nmcpfn/testing/src/remote-target.ts:753:    throw new TypeError(\"Authenticated MCP targets require at least one credential header\");\nmcpfn/testing/src/suite.ts:5:  redactTargetCredentials,\nmcpfn/testing/src/suite.ts:70:  redactionOmittedObservedEvents?: number;\nmcpfn/testing/src/suite.ts:92:/** Final cleanup failed. The bounded report is a snapshot; retain this error to retry. */\nmcpfn/testing/src/suite.ts:128:function redactSuiteArtifact<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean } = {}): T {\nmcpfn/testing/src/suite.ts:129:  const scrubbed = target.redact ? target.redact(value, options) : value;\n