k.json',OLD));curLock=json.loads((V/'package-lock.json').read_text());origLock=json.loads((T/'package-lock.json').read_text())\nrelated={k for k in set(oldLock['packages'])|set(curLock['packages']) if oldLock['packages'].get(k)!=curLock['packages'].get(k)}\nframework={'@esbuild/darwin-arm64','@sveltejs/vite-plugin-svelte','@sveltejs/vite-plugin-svelte-inspector','esbuild','fdir','picomatch','vite','@superfunctions/oauth-http'}\nseed=copy.deepcopy(baseLock)\nfor k in sorted(related):\n selected=k=='node_modules/@types/trusted-types' or any(k==f'{p}/docs/node_modules/{name}' for p in ['authfn','filefn'] for name in framework)\n if selected:\n  if k in curLock['packages']:seed['packages'][k]=curLock['packages'][k]\n  else:seed['packages'].pop(k,None)\nfor k,v in origLock['packages'].items():\n if k.startswith('clifn/docs') or k=='node_modules/@clifn/docs':seed['packages'][k]=v\n# Faithful proposal traversal found exact Svelte5.55.7 aria-query5.3.1 peer mismatch.\n# Admit only the already-reviewed official5.3.1 registry map at this actual consumer.\naria=curLock['packages']['botfn/docs/node_modules/aria-query'];assert aria['version']=='5.3.1'\nseed['packages']['clifn/docs/node_modules/aria-query']=aria\nfor product in ['authfn','filefn','clifn']:\n p=f'{product}/docs';meta=json.loads(wanted[p+'/package.json']);row=seed['packages'].setdefault(p,{})\n for key in ['name','version','dependencies','devDependencies','peerDependencies','peerDependenciesMeta']:\n  if key in meta:row[key]=meta[key]\n  else:row.pop(key,None)\nput('package-lock.json',(json.dumps(seed,indent=2)+'\\n').encode(),'focused preliminary consumer/framework/OAuth lock seed; independent normal install not yet admitted')\n# Check exact required current corrections before any candidate source mutation.\nassert b'prefers-reduced-motion: reduce' in wanted['scripts/docs-site/LandingPage.svelte']\nassert b'height > 0' in wanted['scripts/docs-site/layout.ts']\nassert b'options.canonicalUrl' in wanted['scripts/docs