930');A=R/'sequential-20261003T184612Z/PR-213';l=json.loads((R/'parent-ledger.json').read_text());d=json.loads((A/'skill-response.json').read_text());assert d['successful'] and not d['error'];assert l['execution']['current_sequential_sweep']['active_pr']==213 and l['digest']==d['data']['version']['digest'];assert d['data']['version']['revision']==6 and d['data']['version']['semanticVersion']=='1.4.0';assert hashlib.sha256((A/'SKILL.md').read_bytes()).hexdigest()=='78e6b66300287085d26e1cf15657a5010c6c93d0c2c23a9d4240064a6cdcd91c';(A/'prior-ledger.json').write_text(json.dumps(l['prs']['213'],indent=2)+'\\n');(A/'skill-pin-and-caller-receipt.json').write_text(json.dumps({'version':d['data']['version'],'instructionsSha256':hashlib.sha256((A/'SKILL.md').read_bytes()).hexdigest(),'instructionsRead':'complete1-200/201-291 bounded reads','freshRetrieval':True,'priorReadVisibilityAndTimingQualificationsPreserved':True,'caller':'unknown model fields inherited as unknown, not an actual known model assertion; available PI details separately recorded'},indent=2)+'\\n')\nPY\nA=/Users/serro/Documents/dev/n/audits/sf-docs-review-20260930/sequential-20261003T184612Z/PR-213; export GH_CONFIG_DIR=/Users/serro/.config/gh-other; gh auth status > \"$A/auth-context.log\" 2>&1 && gh pr view 213 --repo 21nCo/super-functions --json headRefOid,headRefName,baseRefName,isCrossRepository,state,url > \"$A/identity.json\"","timeout":120}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":1923,"output":797,"cacheRead":210304,"cacheWrite":0,"reasoning":320,"totalTokens":213024,"cost":{"input":0.003846,"output":0.007970000000000001,"cacheRead":0.0210304,"cacheWrite":0,"total":0.032846400000000005}},"stopReason":"toolUse","timestamp":1791286917704,"responseId":"resp_055fb762f51dfcfc016ac4de86541887d08b08bb27dfe0933b","rawStopReason":"completed","thinkingLevel":"high"}}
