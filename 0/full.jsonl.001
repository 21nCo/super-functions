version']=='5.3.1';lock['packages']['devfn/docs/node_modules/aria-query']=copy.deepcopy(aria)\nfor product in ['authfn','filefn','devfn']:\n p=product+'/docs';m=json.loads(wanted[p+'/package.json']);row=lock['packages'].setdefault(p,{})\n for key in ['name','version','dependencies','devDependencies','peerDependencies','peerDependenciesMeta']:\n  if key in m:row[key]=m[key]\n  else:row.pop(key,None)\nassert lock['packages']['packages/db']==baseLock['packages']['packages/db'] and lock['packages']['secfn/core']==baseLock['packages']['secfn/core']\nput('package-lock.json',(json.dumps(lock,indent=2)+'\\n').encode(),'focused candidate owner seed only; independent map/normal-install/physical acceptance still closed')\nassert set(original)<=set(wanted)\nassert b'prefers-reduced-motion: reduce' in wanted['scripts/docs-site/LandingPage.svelte'] and b'height > 0' in wanted['scripts/docs-site/layout.ts']\nassert b'options.canonicalUrl' in wanted['scripts/docs-site/llms.mjs'] and b'manifest, canonicalUrl' in wanted['scripts/docs-site/llms.mjs']\nplan={};patch=[];novel=[]\nfor p,b in sorted(wanted.items()):\n old=physical(p);f=V/p;record=tree(HEAD).get(p) if p in original else tree(BASE).get(p);mode=record['mode'] if record else '100644'\n plan[p]={'beforeSha256':digest(old),'beforePosixMode':f.lstat().st_mode&0o777 if old is not None else None,'afterSha256':digest(b),'gitMode':mode,'owner':owners[p],'contents':b.decode() if b is not None else None}\n if p!='package-lock.json' and '/static/' not in p and old!=b:patch+=list(difflib.unified_diff((old or b'').decode().splitlines(True),(b or b'').decode().splitlines(True),fromfile='retained211/'+p,tofile='planned212/'+p))\n if b is not None and all(b!=blob(ref,p) for ref in [HEAD,BASE,RELATED]) and p!='package-lock.json':novel+=list(difflib.unified_diff((blob(HEAD,p) or blob(RELATED,p) or blob(BASE,p) or b'').decode().splitlines(True),b.decode().splitlines(True),fromfile='reviewed-provenance/'+p,tofile='novel212/'+p))\ndelta={k for k