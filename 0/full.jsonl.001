{"timestamp":"2026-09-21T08:43:57.676Z","ordinal":5717,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b3f5-d570-7a72-b668-401efd539e3b","turn_id":"01a0c31e-6a96-7383-bda9-a191f2448a61","item":{"type":"CommandExecution","id":"exec-342b26a4-30dd-4a61-b161-f50ac73822ff","process_id":"22899","command":["/bin/zsh","-lc","nl -ba mcpfn/testing/src/remote-target.ts | sed -n '1,115p;335,430p;510,565p'\nnl -ba mcpfn/testing/tests/remote-target.test.ts | sed -n '350,400p;890,945p'\nnl -ba mcpfn/testing/src/suite.ts | sed -n '380,475p;535,575p'\nnl -ba mcpfn/testing/tests/suite.test.ts | sed -n '180,235p'"],"cwd":"file:///Users/serro/Documents/dev/n/worktrees/superfunctions/PR-170","parsed_cmd":[{"type":"read","cmd":"nl -ba mcpfn/testing/src/remote-target.ts","name":"remote-target.ts","path":"mcpfn/testing/src/remote-target.ts"},{"type":"read","cmd":"nl -ba mcpfn/testing/tests/remote-target.test.ts","name":"remote-target.test.ts","path":"mcpfn/testing/tests/remote-target.test.ts"},{"type":"read","cmd":"nl -ba mcpfn/testing/src/suite.ts","name":"suite.ts","path":"mcpfn/testing/src/suite.ts"},{"type":"read","cmd":"nl -ba mcpfn/testing/tests/suite.test.ts","name":"suite.test.ts","path":"mcpfn/testing/tests/suite.test.ts"}],"source":"unified_exec_startup","status":"completed","stdout":"     1\timport {\n     2\t  McpFnClientError,\n     3\t  customTarget,\n     4\t  streamableHttpTarget,\n     5\t  type McpFnStreamableHttpTargetOptions,\n     6\t  type McpFnTarget,\n     7\t  type McpFnTransportHandle,\n     8\t} from \"@mcpfn/client\";\n     9\t\n    10\timport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n    11\t\n    12\ttype SecretState = { active: Map<string, number>; scopes: Set<Set<string>> };\n    13\tconst targetSecrets = new WeakMap<McpFnTarget, SecretState>();\n    14\tconst utf8Encoder = new TextEncoder();\n    15\t\n    16\t/** Retain released credentials only for the lifetime of a report operation. */\n    17\texport function beginTargetCredentialRedaction(target: McpFnTarget): () => void {\n    18\t  const state = targetSecrets.get(target);\n    19\t  if (!state) return () => undefined;\n    20\t  const scope = new Set(state.active.keys());\n    21\t  state.scopes.add(scope);\n    22\t  return () => { state.scopes.delete(scope); scope.clear(); };\n    23\t}\n    24\t\n    25\tfunction credentialValues(headers: HeadersInit): Set<string> {\n    26\t  const values = boundedCredentialEntries(headers);\n    27\t  const secrets = new Set<string>();\n    28\t  for (const [header, raw] of values) {\n    29\t    if (!raw.trim()) continue;\n    30\t    secrets.add(raw);\n    31\t    secrets.add(raw.trim());\n    32\t    const normalizedHeader = header.toLowerCase();\n    33\t    if ([\"authorization\", \"proxy-authorization\"].includes(normalizedHeader)) {\n    34\t      addAuthorizationSecrets(raw, secrets);\n    35\t    }\n    36\t    if (normalizedHeader === \"cookie\") addCookieSecrets(raw, secrets);\n    37\t  }\n    38\t  return secrets;\n    39\t}\n    40\t\n    41\tfunction addAuthorizationSecrets(raw: string, secrets: Set<string>): void {\n    42\t  const trimmed = raw.trim();\n    43\t  const separator = trimmed.search(/\\s/);\n    44\t  if (separator <= 0) return;\n    45\t  const scheme = trimmed.slice(0, separator).toLowerCase();\n    46\t  const token = trimmed.slice(separator).trim();\n    47\t  if (token) secrets.add(token);\n    48\t  if (scheme !== \"basic\" || !/^[\\dA-Za-z+/]+={0,2}$/.test(token)) return;\n    49\t  const decoded = Buffer.from(token, \"base64\");\n    50\t  // Round-trip validation avoids interpreting malformed tokens as credentials.\n    51\t  if (stripBase64Padding(decoded.toString(\"base64\")) !== stripBase64Padding(token)) return;\n    52\t  for (const encoding of [\"utf8\", \"latin1\"] as const) {\n    53\t    const pair = decoded.toString(encoding);\n    54\t    const colon = pair.indexOf(\":\");\n    55\t    if (colon < 0) continue;\n    56\t    for (const value of [pair, pair.slice(0, colon), pair.slice(colon + 1)]) {\n    57\t      if (value) secrets.add(value);\n    58\t    }\n    59\t  }\n    60\t}\n    61\t\n    62\tfunction stripBase64Padding(value: string): string {\n    63\t  let end = value.length;\n    64\t  while (end > 0 && value[end - 1] === \"=\") end -= 1;\n    65\t  return value.slice(0, end);\n    66\t}\n    67\t\n    68\tfunction addCookieSecrets(raw: string, secrets: Set<string>): void {\n    69\t  // Cookie values are independently reflectable even though the request\n    70\t  // authenticates with the complete header. RFC 6265 cookie values cannot\n    71\t  // contain comma or semicolon, so both delimiters cover combined entries.\n    72\t  for (const part of raw.split(/[;,]/)) {\n    73\t    const pair = part.trim();\n    74\t    if (!pair) continue;\n    75\t    const equals = pair.indexOf(\"=\");\n    76\t    if (equals < 1) {\n    77\t      throw new TypeError(\"Cookie credential headers must contain name=value pairs\");\n    78\t    }\n    79\t    const value = pair.slice(equals + 1).trim();\n    80\t    if (!value) continue;\n    81\t    secrets.add(value);\n    82\t    addUnquotedCookieSecret(value, secrets);\n    83\t  }\n    84\t}\n    85\t\n    86\tfunction addUnquotedCookieSecret(value: string, secrets: Set<string>): void {\n    87\t  if (!value.startsWith('\"') && !value.endsWith('\"')) return;\n    88\t  if (value.length < 2 || !value.startsWith('\"') || !value.endsWith('\"')) {\n    89\t    throw new TypeError(\"Cookie credential values must use balanced quotes\");\n    90\t  }\n    91\t  const unquoted = value.slice(1, -1);\n    92\t  if (unquoted.includes('\"') || unquoted.includes(\"\\\\\")) {\n    93\t    throw new TypeError(\"Cookie credential values must use RFC 6265 syntax\");\n    94\t  }\n    95\t  if (unquoted) secrets.add(unquoted);\n    96\t}\n    97\t\n    98\texport class McpFnRedactionLimitError extends Error {\n    99\t  constructor(message = \"Credential redaction exceeded its traversal budget\") { super(message); }\n   100\t}\n   101\t\n   102\t/** No typed artifact can preserve this authored structure without exposing a credential. */\n   103\texport class McpFnStructuralCredentialCollisionError extends McpFnRedactionLimitError {\n   104\t  constructor() {\n   105\t    super(\"Credential collides with required artifact structure\");\n   106\t  }\n   107\t}\n   108\t\n   109\t// Only these locally authored envelope paths retain structural keys. Unknown\n   110\t// children (including inspector events and server metadata) are always payloads.\n   111\tconst envelopeKeys: Record<string, Set<string>> = Object.fromEntries(Object.entries({\n   112\t  root: \"formatVersion kind status runtime ok target server capabilities manifestChecked manifestHash total passed failed incomplete droppedResults droppedObservedEvents redactionOmittedObservedEvents incompleteReason failure timeline droppedTimelineEvents results count clientState tools resources resourceTemplates prompts droppedEvents timelineComplete droppedInventoryEntries inventoryComplete suiteVersion exitCode stdout stderr phase outcome code requestId at details payload\",\n   113\t  result: \"formatVersion name operation tool status sideEffect durationMs error droppedObservedEvents redactionOmittedObservedEvents\",\n   114\t  diagnostic: \"phase outcome code requestId at target details\",\n   115\t  inspectorEvent: \"formatVersion source kind at event\",\n   335\t  return result;\n   336\t}\n   337\t\n   338\tfunction assertPayloadSerialization(\n   339\t  value: unknown,\n   340\t  role: string,\n   341\t  finalPass: boolean,\n   342\t  credentialPattern: RegExp | undefined,\n   343\t): void {\n   344\t  if (!finalPass || role !== \"payload\" || !credentialPattern) return;\n   345\t  const serialized = JSON.stringify(value);\n   346\t  if (serialized !== undefined && credentialPattern.test(serialized)) {\n   347\t    throw new McpFnRedactionLimitError(\n   348\t      \"Credential redaction could not guarantee safe serialized output\",\n   349\t    );\n   350\t  }\n   351\t}\n   352\t\n   353\t/** Remove known opaque credential values as well as credential-shaped fields. */\n   354\texport function redactTargetCredentials<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean; redactionMarker?: string } = {}): T {\n   355\t  const state = targetSecrets.get(target);\n   356\t  return scrubCredentials(value, new Set([...(state?.active.keys() ?? []), ...[...(state?.scopes ?? [])].flatMap((scope) => [...scope])]), options.preserveKeys, options.redactionMarker);\n   357\t}\n   358\t\n   359\t/** Redact authenticated conformance output using the acquired credential. */\n   360\texport function redactRemoteCredential<T>(credential: McpFnRemoteCredential, value: T, options: { preserveKeys?: boolean } = {}): T {\n   361\t  return scrubCredentials(value, credentialValues(credential.headers), options.preserveKeys);\n   362\t}\n   363\t\n   364\tconst MAX_CREDENTIAL_HEADERS = 32;\n   365\tconst MAX_CREDENTIAL_HEADER_BYTES = 16_384;\n   366\tconst MAX_CREDENTIAL_HEADER_VALUE_BYTES = 8_192;\n   367\tconst FORBIDDEN_CREDENTIAL_HEADERS = new Set([\n   368\t  \"connection\",\n   369\t  \"content-length\",\n   370\t  \"host\",\n   371\t  \"proxy-connection\",\n   372\t  \"te\",\n   373\t  \"trailer\",\n   374\t  \"transfer-encoding\",\n   375\t  \"upgrade\",\n   376\t]);\n   377\t\n   378\texport type McpFnRemoteCredentialKind = \"api-key\" | \"oauth\" | \"custom\";\n   379\t\n   380\texport interface McpFnRemoteCredential {\n   381\t  /** Credential headers are applied only to the fixed target origin. */\n   382\t  headers: HeadersInit;\n   383\t  kind?: McpFnRemoteCredentialKind;\n   384\t  label?: string;\n   385\t}\n   386\t\n   387\texport interface McpFnRemoteCredentialContext {\n   388\t  url: string;\n   389\t  requestId: string;\n   390\t  signal?: AbortSignal;\n   391\t}\n   392\t\n   393\t/**\n   394\t * Application-owned credential lifecycle for external MCP targets. McpFn\n   395\t * acquires once per target open, revokes before disposal, and never serializes\n   396\t * the returned headers into descriptors or reports. If acquisition rejects, the\n   397\t * provider must roll back its own partial resources; no lease has been returned.\n   398\t */\n   399\texport interface McpFnRemoteCredentialProvider {\n   400\t  acquire(\n   401\t    context: McpFnRemoteCredentialContext,\n   402\t  ): McpFnRemoteCredential | Promise<McpFnRemoteCredential>;\n   403\t  revoke?(\n   404\t    credential: McpFnRemoteCredential,\n   405\t    context: McpFnRemoteCredentialContext,\n   406\t  ): void | Promise<void>;\n   407\t  dispose?(\n   408\t    credential: McpFnRemoteCredential,\n   409\t    context: McpFnRemoteCredentialContext,\n   410\t  ): void | Promise<void>;\n   411\t}\n   412\t\n   413\texport interface McpFnRemoteCredentialLease {\n   414\t  credential: McpFnRemoteCredential;\n   415\t  release(): Promise<void>;\n   416\t  /** The lifecycle stage that most recently prevented credential release. */\n   417\t  cleanupPhase(): \"token-revocation\" | \"transport-close\";\n   418\t}\n   419\t\n   420\texport interface McpFnAuthenticatedHttpTargetOptions\n   421\t  extends Omit<McpFnStreamableHttpTargetOptions, \"authProvider\" | \"requestInit\"> {\n   422\t  credential: McpFnRemoteCredential | McpFnRemoteCredentialProvider;\n   423\t  requestInit?: Omit<RequestInit, \"headers\" | \"redirect\"> & { headers?: HeadersInit };\n   424\t}\n   425\t\n   426\t/** Create a provider for an already-bounded API key or OAuth-derived token. */\n   427\texport function staticRemoteCredentialProvider(\n   428\t  credential: McpFnRemoteCredential,\n   429\t): McpFnRemoteCredentialProvider {\n   430\t  return { acquire: () => credential };\n   510\t  const pendingReleases = new Set<() => Promise<void>>();\n   511\t  const authenticated = customTarget({\n   512\t    kind: \"authenticated-streamable-http\",\n   513\t    descriptor: {\n   514\t      url: descriptorUrl.toString(),\n   515\t      authenticated: true,\n   516\t    },\n   517\t    redact: (value, redaction) => redactTargetCredentials(authenticated, value, { preserveKeys: true, ...redaction }),\n   518\t    async cleanup() {\n   519\t      const results = await Promise.allSettled([...pendingReleases].map(release => release()));\n   520\t      const failures = results.filter((result): result is PromiseRejectedResult => result.status === \"rejected\");\n   521\t      const failure = failures.find(({ reason }) => reason && typeof reason === \"object\" &&\n   522\t        (reason as { phase?: unknown }).phase === \"token-revocation\") ?? failures[0];\n   523\t      if (failure) throw failure.reason;\n   524\t    },\n   525\t    async open(targetContext): Promise<McpFnTransportHandle> {\n   526\t      const context: McpFnRemoteCredentialContext = {\n   527\t        url: targetUrl.toString(),\n   528\t        requestId: targetContext.requestId,\n   529\t        signal: targetContext.signal,\n   530\t      };\n   531\t      const lease = await acquireRemoteCredential(options.credential, context);\n   532\t      const secrets = new Set<string>();\n   533\t      const release = async () => {\n   534\t        try { await lease.release(); }\n   535\t        catch (error) { pendingReleases.add(release); throw error; }\n   536\t        pendingReleases.delete(release);\n   537\t        for (const secret of secrets) {\n   538\t          const count = (state.active.get(secret) ?? 1) - 1;\n   539\t          if (count) state.active.set(secret, count); else state.active.delete(secret);\n   540\t        }\n   541\t        secrets.clear();\n   542\t      };\n   543\t      let handle: McpFnTransportHandle | undefined;\n   544\t      try {\n   545\t        for (const secret of credentialValues(lease.credential.headers)) {\n   546\t          secrets.add(secret);\n   547\t          state.active.set(secret, (state.active.get(secret) ?? 0) + 1);\n   548\t          for (const scope of state.scopes) scope.add(secret);\n   549\t        }\n   550\t        const credentialHeaders = validateRemoteCredentialHeaders(lease.credential.headers);\n   551\t        const headers = new Headers(requestInit?.headers);\n   552\t        credentialHeaders.forEach((value, name) => headers.set(name, value));\n   553\t        const target = streamableHttpTarget(targetUrl, {\n   554\t          ...transportOptions,\n   555\t          requestInit: {\n   556\t            ...requestInit,\n   557\t            headers,\n   558\t            // Fetch must not replay credentials to a redirect destination.\n   559\t            redirect: \"error\",\n   560\t          },\n   561\t        });\n   562\t        handle = await target.open(targetContext);\n   563\t      } catch (error) {\n   564\t        // Sanitize while the lease still supplies its immutable header snapshot.\n   565\t        // Cleanup removes active secrets before the client emits failed-open diagnostics.\n   350\t});\n   351\t\n   352\tit(\"retains failed pre-handle releases for a cleanup retry\", async () => {\n   353\t  const revoke = vi.fn().mockRejectedValueOnce(new Error(\"temporary\")).mockResolvedValue(undefined);\n   354\t  const target = authenticatedHttpTarget(\"http://127.0.0.1:1/mcp\", { credential: {\n   355\t    acquire: () => ({ headers: undefined } as any), revoke,\n   356\t  } });\n   357\t  await expect(target.open({ requestId: \"invalid\", diagnostic: async () => {} })).rejects.toThrow(/cleanup failed/);\n   358\t  await target.cleanup!();\n   359\t  expect(revoke).toHaveBeenCalledTimes(2);\n   360\t});\n   361\tit(\"releases malformed credentials even when inspection fails\", async () => {\n   362\t  const revoke = vi.fn();\n   363\t  const target = authenticatedHttpTarget(\"http://127.0.0.1:1/mcp\", { credential: {\n   364\t    acquire: () => ({ headers: undefined } as any), revoke,\n   365\t  } });\n   366\t  await expect(target.open({ requestId: \"invalid\", diagnostic: async () => {} })).rejects.toThrow();\n   367\t  expect(revoke).toHaveBeenCalledOnce();\n   368\t});\n   369\t\n   370\tit(\"scrubs opaque credentials before generic redaction can truncate their suffix\", async () => {\n   371\t  const {redactRemoteCredential} = await import(\"../src/remote-target.js\");\n   372\t  const token = \"opaque-credential-unique-tail\";\n   373\t  const input = \"data=x \" + \"a\".repeat(262144 - 7 - 8) + token;\n   374\t  // Inputs beyond the explicit budget fail closed before any output is emitted.\n   375\t  expect(() => redactRemoteCredential({headers: {\"x-api-key\": token}}, input)).toThrow(/traversal budget/);\n   376\t});\n   377\tit(\"scrubs token components of custom authorization schemes\", async () => {\n   378\t  const {redactRemoteCredential} = await import(\"../src/remote-target.js\");\n   379\t  expect(redactRemoteCredential({headers: {authorization: \"Token opaque-123\"}}, {echo: \"opaque-123\"})).toEqual({echo: \"[REDACTED]\"});\n   380\t});\n   381\t\n   382\t\n   383\tit(\"retains successful-open leases until revocation succeeds\", async () => {\n   384\t  const revoke = vi.fn().mockRejectedValueOnce(new Error('temporary')).mockResolvedValue(undefined);\n   385\t  const target = authenticatedHttpTarget('http://127.0.0.1:1/mcp', { credential: { acquire: () => ({ headers: { 'x-api-key': 'opaque-key' } }), revoke } });\n   386\t  const handle = await target.open({ requestId: 'lease', diagnostic: async () => {} });\n   387\t  await expect(handle.close!()).rejects.toThrow(/cleanup/);\n   388\t  await target.cleanup!();\n   389\t  expect(revoke).toHaveBeenCalledTimes(2);\n   390\t});\n   391\t\n   392\tit(\"rejects credentials that collide with fixed report values\", async () => {\n   393\t  const { redactRemoteCredential, McpFnRedactionLimitError } = await import('../src/remote-target.js');\n   394\t  for (const secret of ['none', 'http', '0.0.5']) {\n   395\t    const report = { kind: 'mcpfn.target-suite-report', target: { kind: 'authenticated-streamable-http' }, runtime: { packages: { testing: '0.0.5' } }, results: [{ sideEffect: 'none', name: secret }] };\n   396\t    expect(() => redactRemoteCredential(\n   397\t      { headers: { 'x-api-key': secret } },\n   398\t      report,\n   399\t      { preserveKeys: true },\n   400\t    )).toThrow(McpFnRedactionLimitError);\n   890\t    await Promise.all([handle.close!(), handle.close!()]);\n   891\t    expect(close).toHaveBeenCalledOnce();\n   892\t    expect(revoke).toHaveBeenCalledTimes(stage === \"revoke\" ? 2 : 1);\n   893\t    expect(dispose).toHaveBeenCalledTimes(stage === \"dispose\" ? 2 : 1);\n   894\t  } finally { await fixture.close(); }\n   895\t});\n   896\t\n   897\t\n   898\tit.each([\"***\", \"[REDACTED]\", \"#\"])(\"never emits another credential as a generated mask (%s)\", async mask => {\n   899\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   900\t  const credentials = { headers: { \"x-api-key\": \"abc\", \"x-secondary-key\": mask } };\n   901\t  const redacted = redactRemoteCredential(credentials, { value: \"abc\", other: mask });\n   902\t  expect(JSON.stringify(redacted)).not.toContain(\"abc\");\n   903\t  expect(JSON.stringify(redacted)).not.toContain(mask);\n   904\t});\n   905\t\n   906\tit.each([\"foo name\", \"Bearer name\", \"Basic name\"])(\"keeps an opaque API key whole during extraction (%s)\", async secret => {\n   907\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   908\t  const redacted = redactRemoteCredential({ headers: { \"x-api-key\": secret } }, { name: \"name\", echoed: secret });\n   909\t  expect(redacted.name).toBe(\"name\");\n   910\t  expect(JSON.stringify(redacted)).not.toContain(secret);\n   911\t});\n   912\t\n   913\tit.each([\"authorization\", \"Authorization\", \"proxy-authorization\"])(\"extracts recognized bearer credentials from %s\", async header => {\n   914\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   915\t  expect(redactRemoteCredential({ headers: { [header]: \"bEaReR tokenvalue\" } }, { reflected: \"tokenvalue\" }).reflected).not.toBe(\"tokenvalue\");\n   916\t});\n   917\t\n   918\tit(\"extracts independently reflectable Cookie credential values\", async () => {\n   919\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   920\t  const redacted = redactRemoteCredential(\n   921\t    { headers: { Cookie: 'session=opaque-cookie; quoted=\"quoted-cookie\"' } },\n   922\t    { session: \"opaque-cookie\", quoted: \"quoted-cookie\" },\n   923\t  );\n   924\t  expect(JSON.stringify(redacted)).not.toContain(\"opaque-cookie\");\n   925\t  expect(JSON.stringify(redacted)).not.toContain(\"quoted-cookie\");\n   926\t});\n   927\t\n   928\tit.each([\"missing-pair\", 'session=\"unterminated'])(\"rejects ambiguous Cookie credential syntax (%s)\", async cookie => {\n   929\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   930\t  expect(() => redactRemoteCredential({ headers: { Cookie: cookie } }, { value: \"safe\" }))\n   931\t    .toThrow(/Cookie credential/);\n   932\t});\n   933\t\n   934\t\n   935\tit.each([\n   936\t  { name: \"adjacent masks\", secrets: [\"a\", \"b\", \"**\"], input: \"ab\" },\n   937\t  { name: \"deletion joins surrounding text\", secrets: [\"abc\", \"***\", \"xy\"], input: \"xabcy\" },\n   938\t  { name: \"mask joins existing text\", secrets: [\"abc\", \"***x\"], input: \"abcx\" },\n   939\t])(\"checks the final output for $name\", async ({ secrets, input }) => {\n   940\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   941\t  const headers = Object.fromEntries(secrets.map((secret, index) => [`x-secret-${index}`, secret]));\n   942\t  const output = redactRemoteCredential({ headers }, { [input]: input });\n   943\t  for (const [key, value] of Object.entries(output)) {\n   944\t    for (const secret of secrets) {\n   945\t      expect(key).not.toContain(secret);\n   380\tconst suiteStructureValues = [\n   381\t  \"mcpfn.target-suite-report\", \"complete\", \"incomplete\", \"passed\", \"failed\",\n   382\t  \"started\", \"succeeded\", \"none\", \"idempotent\", \"non-idempotent\",\n   383\t  \"mcpfn-preflight\", \"authorization-server\", \"resource-server\", \"mcp-initialization\",\n   384\t  \"scenario\", \"upstream-conformance\", \"resource-discovery\",\n   385\t  \"authorization-server-discovery\", \"client-registration\", \"authorization-request\",\n   386\t  \"authorization-callback\", \"token-exchange\", \"token-refresh\", \"token-revocation\",\n   387\t  \"transport-connect\", \"mcp-initialize\", \"capability-operation\", \"transport-close\",\n   388\t  \"authenticated-streamable-http\", \"streamable-http\", \"stdio\", \"in-memory\", \"custom\",\n   389\t] as const;\n   390\t\n   391\tinterface SuiteStructureGuard {\n   392\t  assert(value: string): void;\n   393\t}\n   394\t\n   395\tfunction captureSuiteStructureGuard(\n   396\t  target: McpFnTarget,\n   397\t  projection: SuiteProjection,\n   398\t  diagnostics: SuiteDiagnosticCollector,\n   399\t): SuiteStructureGuard {\n   400\t  const candidates = new Set<string>([\n   401\t    ...suiteStructureKeys,\n   402\t    ...suiteStructureValues,\n   403\t    process.version,\n   404\t    MCPFN_REPORT_SCHEMA_VERSION,\n   405\t    MCPFN_TESTING_VERSION,\n   406\t    projection.target.kind,\n   407\t  ]);\n   408\t  for (const result of projection.execution.results) {\n   409\t    candidates.add(result.status);\n   410\t    if (result.sideEffect) candidates.add(result.sideEffect);\n   411\t  }\n   412\t  for (const event of diagnostics.timeline) {\n   413\t    candidates.add(event.phase);\n   414\t    candidates.add(event.outcome);\n   415\t    if (event.target?.kind) candidates.add(event.target.kind);\n   416\t  }\n   417\t  const safe = new Set<string>();\n   418\t  for (const candidate of candidates) {\n   419\t    try {\n   420\t      if (redactSuiteArtifact(target, candidate, { preserveKeys: false }) === candidate) {\n   421\t        safe.add(candidate);\n   422\t      }\n   423\t    } catch {\n   424\t      // If the live custom scrubber cannot classify a string, fail closed only\n   425\t      // when the final report actually needs that unproven structure.\n   426\t    }\n   427\t  }\n   428\t  return {\n   429\t    assert(value: string): void {\n   430\t      if (!safe.has(value)) throw new McpFnStructuralCredentialCollisionError();\n   431\t    },\n   432\t  };\n   433\t}\n   434\t\n   435\tfunction assertStructureKeys(value: object, guard: SuiteStructureGuard): void {\n   436\t  for (const key of Object.keys(value)) guard.assert(key);\n   437\t}\n   438\t\n   439\tfunction assertTargetStructure(\n   440\t  target: McpFnTargetDescriptor,\n   441\t  guard: SuiteStructureGuard,\n   442\t): void {\n   443\t  guard.assert(\"kind\");\n   444\t  guard.assert(target.kind);\n   445\t}\n   446\t\n   447\tfunction assertSuiteReportStructure(\n   448\t  report: McpFnTargetSuiteReport,\n   449\t  guard: SuiteStructureGuard,\n   450\t): void {\n   451\t  assertStructureKeys(report, guard);\n   452\t  guard.assert(report.kind);\n   453\t  guard.assert(report.status);\n   454\t  assertStructureKeys(report.runtime, guard);\n   455\t  guard.assert(report.runtime.node);\n   456\t  guard.assert(report.runtime.reportSchemaVersion);\n   457\t  assertStructureKeys(report.runtime.packages, guard);\n   458\t  guard.assert(report.runtime.packages.testing);\n   459\t  assertTargetStructure(report.target, guard);\n   460\t  if (report.failure) {\n   461\t    assertStructureKeys(report.failure, guard);\n   462\t    guard.assert(report.failure.layer);\n   463\t    if (report.failure.phase) guard.assert(report.failure.phase);\n   464\t  }\n   465\t  for (const event of report.timeline) {\n   466\t    assertStructureKeys(event, guard);\n   467\t    guard.assert(event.phase);\n   468\t    guard.assert(event.outcome);\n   469\t    if (event.target) assertTargetStructure(event.target, guard);\n   470\t  }\n   471\t  for (const result of report.results) {\n   472\t    assertStructureKeys(result, guard);\n   473\t    guard.assert(result.status);\n   474\t    if (result.sideEffect) guard.assert(result.sideEffect);\n   475\t  }\n   535\t    diagnostics.captureBaseline(client);\n   536\t    await client.session.connect();\n   537\t    ({ execution, manifestChecked } = await executeConnectedSuite(client, options));\n   538\t  } catch (error) {\n   539\t    failure = safeTargetFailure(options.target, error);\n   540\t  }\n   541\t  return { client, manifestChecked, failure, execution };\n   542\t}\n   543\t\n   544\tasync function projectAndCloseSuite(\n   545\t  options: RunMcpFnTargetSuiteOptions,\n   546\t  diagnostics: SuiteDiagnosticCollector,\n   547\t  connection: SuiteConnection,\n   548\t): Promise<{\n   549\t  projection: SuiteProjection;\n   550\t  structureGuard: SuiteStructureGuard;\n   551\t  closeResult: Awaited<ReturnType<typeof closeSuiteClient>>;\n   552\t}> {\n   553\t  let projection: SuiteProjection = {\n   554\t    target: { kind: \"custom\" },\n   555\t    execution: connection.execution,\n   556\t    failure: \"serialization\",\n   557\t  };\n   558\t  let structureGuard: SuiteStructureGuard = {\n   559\t    assert: () => { throw new McpFnStructuralCredentialCollisionError(); },\n   560\t  };\n   561\t  let closeResult: Awaited<ReturnType<typeof closeSuiteClient>> = {};\n   562\t  try {\n   563\t    projection = projectSuiteArtifacts(options, connection.client, connection.execution);\n   564\t    structureGuard = captureSuiteStructureGuard(options.target, projection, diagnostics);\n   565\t  } finally {\n   566\t    closeResult = await closeSuiteClient(connection.client);\n   567\t  }\n   568\t  return { projection, structureGuard, closeResult };\n   569\t}\n   570\t\n   571\tfunction suiteIncompleteReasons(\n   572\t  failure: McpFnReportFailure | undefined,\n   573\t  cleanupFailure: McpFnReportFailure | undefined,\n   574\t  diagnostics: SuiteDiagnosticCollector,\n   575\t  redactionOmittedObservedEvents: number,\n   180\t  expect(report.incompleteReason).toContain(\"Target cleanup failed\");\n   181\t  expect(JSON.stringify(report)).not.toContain(\"opaque-cleanup-value\");\n   182\t});\n   183\t\n   184\t\n   185\tit.each([\"x\", \"€\"])(\"bounds long target failures under the minimum report cap: %s\", async character => {\n   186\t  const { customTarget } = await import('@mcpfn/client');\n   187\t  const report = await runMcpFnTargetSuite({ target: customTarget({ kind: 'failure', open: async () => { throw new Error(character.repeat(4000)); } }), maxReportBytes: 1024 });\n   188\t  expect(report.status).toBe('incomplete');\n   189\t  expect(Buffer.byteLength(JSON.stringify(report, null, 2))).toBeLessThanOrEqual(1024);\n   190\t});\n   191\t\n   192\tit(\"retains a complete report when only its compact encoding fits\", async () => {\n   193\t  const run = async (maxReportBytes?: number) => {\n   194\t    const server = createMcpFnServer({ info: { name: \"compact\", version: \"1\" }, registry: new McpFnRegistry().register({ name: \"echo\", description: \"Echo\", inputSchema: { type: \"object\" }, handler: async input => structuredResult(input) }) });\n   195\t    return runMcpFnTargetSuite({ maxReportBytes, target: customTarget({ kind: \"compact\", open: async () => {\n   196\t      const [transport, peer] = InMemoryTransport.createLinkedPair();\n   197\t      await server.connect(peer);\n   198\t      return { transport, close: () => server.close() };\n   199\t    } }), scenarios: Array.from({ length: 5 }, (_, i) => ({ name: `echo-${i}`, tool: \"echo\", arguments: { value: \"ok\" }, expect: { structuredContent: { value: \"ok\" } } })) });\n   200\t  };\n   201\t  const full = await run();\n   202\t  const cap = Math.max(1024, new TextEncoder().encode(JSON.stringify(full)).byteLength + 128);\n   203\t  expect(cap).toBeLessThan(new TextEncoder().encode(JSON.stringify(full, null, 2)).byteLength);\n   204\t  const bounded = await run(cap);\n   205\t  expect(bounded.ok).toBe(true);\n   206\t  expect(bounded.droppedResults).toBe(0);\n   207\t  expect(new TextEncoder().encode(JSON.stringify(bounded)).byteLength).toBeLessThanOrEqual(cap);\n   208\t});\n   209\t\n   210\tit(\"does not repeat successful custom cleanup after an open failure\", async () => {\n   211\t  const cleanup = vi.fn(async () => {\n   212\t    if (cleanup.mock.calls.length > 1) throw new Error(\"cleanup repeated\");\n   213\t  });\n   214\t  const report = await runMcpFnTargetSuite({ target: customTarget({\n   215\t    kind: \"failed-open\", open: async () => { throw new Error(\"cannot open\"); }, cleanup,\n   216\t  }) });\n   217\t  expect(report.ok).toBe(false);\n   218\t  expect(cleanup).toHaveBeenCalledOnce();\n   219\t  expect(report.incompleteReason).not.toContain(\"Target cleanup failed\");\n   220\t});\n   221\t\n   222\t\n   223\tit.each([\"metadata\", \"failure\"])(\"applies custom target redaction to finalized suite %s\", async mode => {\n   224\t  const secret = \"custom-owned-secret\";\n   225\t  const server = createMcpFnServer({\n   226\t    info: { name: secret, version: \"1.0.0\" },\n   227\t    registry: new McpFnRegistry().register({\n   228\t      name: \"visible-tool\", description: \"Fixture tool\", inputSchema: { type: \"object\" },\n   229\t      handler: async () => structuredResult({ ok: true }),\n   230\t    }),\n   231\t  });\n   232\t  const target = customTarget({\n   233\t    kind: \"custom\",\n   234\t    descriptor: { label: secret },\n   235\t    redact: <T>(value: T): T => {\n","stderr":"","aggregated_output":"     1\timport {\n     2\t  McpFnClientError,\n     3\t  customTarget,\n     4\t  streamableHttpTarget,\n     5\t  type McpFnStreamableHttpTargetOptions,\n     6\t  type McpFnTarget,\n     7\t  type McpFnTransportHandle,\n     8\t} from \"@mcpfn/client\";\n     9\t\n    10\timport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n    11\t\n    12\ttype SecretState = { active: Map<string, number>; scopes: Set<Set<string>> };\n    13\tconst targetSecrets = new WeakMap<McpFnTarget, SecretState>();\n    14\tconst utf8Encoder = new TextEncoder();\n    15\t\n    16\t/** Retain released credentials only for the lifetime of a report operation. */\n    17\texport function beginTargetCredentialRedaction(target: McpFnTarget): () => void {\n    18\t  const state = targetSecrets.get(target);\n    19\t  if (!state) return () => undefined;\n    20\t  const scope = new Set(state.active.keys());\n    21\t  state.scopes.add(scope);\n    22\t  return () => { state.scopes.delete(scope); scope.clear(); };\n    23\t}\n    24\t\n    25\tfunction credentialValues(headers: HeadersInit): Set<string> {\n    26\t  const values = boundedCredentialEntries(headers);\n    27\t  const secrets = new Set<string>();\n    28\t  for (const [header, raw] of values) {\n    29\t    if (!raw.trim()) continue;\n    30\t    secrets.add(raw);\n    31\t    secrets.add(raw.trim());\n    32\t    const normalizedHeader = header.toLowerCase();\n    33\t    if ([\"authorization\", \"proxy-authorization\"].includes(normalizedHeader)) {\n    34\t      addAuthorizationSecrets(raw, secrets);\n    35\t    }\n    36\t    if (normalizedHeader === \"cookie\") addCookieSecrets(raw, secrets);\n    37\t  }\n    38\t  return secrets;\n    39\t}\n    40\t\n    41\tfunction addAuthorizationSecrets(raw: string, secrets: Set<string>): void {\n    42\t  const trimmed = raw.trim();\n    43\t  const separator = trimmed.search(/\\s/);\n    44\t  if (separator <= 0) return;\n    45\t  const scheme = trimmed.slice(0, separator).toLowerCase();\n    46\t  const token = trimmed.slice(separator).trim();\n    47\t  if (token) secrets.add(token);\n    48\t  if (scheme !== \"basic\" || !/^[\\dA-Za-z+/]+={0,2}$/.test(token)) return;\n    49\t  const decoded = Buffer.from(token, \"base64\");\n    50\t  // Round-trip validation avoids interpreting malformed tokens as credentials.\n    51\t  if (stripBase64Padding(decoded.toString(\"base64\")) !== stripBase64Padding(token)) return;\n    52\t  for (const encoding of [\"utf8\", \"latin1\"] as const) {\n    53\t    const pair = decoded.toString(encoding);\n    54\t    const colon = pair.indexOf(\":\");\n    55\t    if (colon < 0) continue;\n    56\t    for (const value of [pair, pair.slice(0, colon), pair.slice(colon + 1)]) {\n    57\t      if (value) secrets.add(value);\n    58\t    }\n    59\t  }\n    60\t}\n    61\t\n    62\tfunction stripBase64Padding(value: string): string {\n    63\t  let end = value.length;\n    64\t  while (end > 0 && value[end - 1] === \"=\") end -= 1;\n    65\t  return value.slice(0, end);\n    66\t}\n    67\t\n    68\tfunction addCookieSecrets(raw: string, secrets: Set<string>): void {\n    69\t  // Cookie values are independently reflectable even though the request\n    70\t  // authenticates with the complete header. RFC 6265 cookie values cannot\n    71\t  // contain comma or semicolon, so both delimiters cover combined entries.\n    72\t  for (const part of raw.split(/[;,]/)) {\n    73\t    const pair = part.trim();\n    74\t    if (!pair) continue;\n    75\t    const equals = pair.indexOf(\"=\");\n    76\t    if (equals < 1) {\n    77\t      throw new TypeError(\"Cookie credential headers must contain name=value pairs\");\n    78\t    }\n    79\t    const value = pair.slice(equals + 1).trim();\n    80\t    if (!value) continue;\n    81\t    secrets.add(value);\n    82\t    addUnquotedCookieSecret(value, secrets);\n    83\t  }\n    84\t}\n    85\t\n    86\tfunction addUnquotedCookieSecret(value: string, secrets: Set<string>): void {\n    87\t  if (!value.startsWith('\"') && !value.endsWith('\"')) return;\n    88\t  if (value.length < 2 || !value.startsWith('\"') || !value.endsWith('\"')) {\n    89\t    throw new TypeError(\"Cookie credential values must use balanced quotes\");\n    90\t  }\n    91\t  const unquoted = value.slice(1, -1);\n    92\t  if (unquoted.includes('\"') || unquoted.includes(\"\\\\\")) {\n    93\t    throw new TypeError(\"Cookie credential values must use RFC 6265 syntax\");\n    94\t  }\n    95\t  if (unquoted) secrets.add(unquoted);\n    96\t}\n    97\t\n    98\texport class McpFnRedactionLimitError extends Error {\n    99\t  constructor(message = \"Credential redaction exceeded its traversal budget\") { super(message); }\n   100\t}\n   101\t\n   102\t/** No typed artifact can preserve this authored structure without exposing a credential. */\n   103\texport class McpFnStructuralCredentialCollisionError extends McpFnRedactionLimitError {\n   104\t  constructor() {\n   105\t    super(\"Credential collides with required artifact structure\");\n   106\t  }\n   107\t}\n   108\t\n   109\t// Only these locally authored envelope paths retain structural keys. Unknown\n   110\t// children (including inspector events and server metadata) are always payloads.\n   111\tconst envelopeKeys: Record<string, Set<string>> = Object.fromEntries(Object.entries({\n   112\t  root: \"formatVersion kind status runtime ok target server capabilities manifestChecked manifestHash total passed failed incomplete droppedResults droppedObservedEvents redactionOmittedObservedEvents incompleteReason failure timeline droppedTimelineEvents results count clientState tools resources resourceTemplates prompts droppedEvents timelineComplete droppedInventoryEntries inventoryComplete suiteVersion exitCode stdout stderr phase outcome code requestId at details payload\",\n   113\t  result: \"formatVersion name operation tool status sideEffect durationMs error droppedObservedEvents redactionOmittedObservedEvents\",\n   114\t  diagnostic: \"phase outcome code requestId at target details\",\n   115\t  inspectorEvent: \"formatVersion source kind at event\",\n   335\t  return result;\n   336\t}\n   337\t\n   338\tfunction assertPayloadSerialization(\n   339\t  value: unknown,\n   340\t  role: string,\n   341\t  finalPass: boolean,\n   342\t  credentialPattern: RegExp | undefined,\n   343\t): void {\n   344\t  if (!finalPass || role !== \"payload\" || !credentialPattern) return;\n   345\t  const serialized = JSON.stringify(value);\n   346\t  if (serialized !== undefined && credentialPattern.test(serialized)) {\n   347\t    throw new McpFnRedactionLimitError(\n   348\t      \"Credential redaction could not guarantee safe serialized output\",\n   349\t    );\n   350\t  }\n   351\t}\n   352\t\n   353\t/** Remove known opaque credential values as well as credential-shaped fields. */\n   354\texport function redactTargetCredentials<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean; redactionMarker?: string } = {}): T {\n   355\t  const state = targetSecrets.get(target);\n   356\t  return scrubCredentials(value, new Set([...(state?.active.keys() ?? []), ...[...(state?.scopes ?? [])].flatMap((scope) => [...scope])]), options.preserveKeys, options.redactionMarker);\n   357\t}\n   358\t\n   359\t/** Redact authenticated conformance output using the acquired credential. */\n   360\texport function redactRemoteCredential<T>(credential: McpFnRemoteCredential, value: T, options: { preserveKeys?: boolean } = {}): T {\n   361\t  return scrubCredentials(value, credentialValues(credential.headers), options.preserveKeys);\n   362\t}\n   363\t\n   364\tconst MAX_CREDENTIAL_HEADERS = 32;\n   365\tconst MAX_CREDENTIAL_HEADER_BYTES = 16_384;\n   366\tconst MAX_CREDENTIAL_HEADER_VALUE_BYTES = 8_192;\n   367\tconst FORBIDDEN_CREDENTIAL_HEADERS = new Set([\n   368\t  \"connection\",\n   369\t  \"content-length\",\n   370\t  \"host\",\n   371\t  \"proxy-connection\",\n   372\t  \"te\",\n   373\t  \"trailer\",\n   374\t  \"transfer-encoding\",\n   375\t  \"upgrade\",\n   376\t]);\n   377\t\n   378\texport type McpFnRemoteCredentialKind = \"api-key\" | \"oauth\" | \"custom\";\n   379\t\n   380\texport interface McpFnRemoteCredential {\n   381\t  /** Credential headers are applied only to the fixed target origin. */\n   382\t  headers: HeadersInit;\n   383\t  kind?: McpFnRemoteCredentialKind;\n   384\t  label?: string;\n   385\t}\n   386\t\n   387\texport interface McpFnRemoteCredentialContext {\n   388\t  url: string;\n   389\t  requestId: string;\n   390\t  signal?: AbortSignal;\n   391\t}\n   392\t\n   393\t/**\n   394\t * Application-owned credential lifecycle for external MCP targets. McpFn\n   395\t * acquires once per target open, revokes before disposal, and never serializes\n   396\t * the returned headers into descriptors or reports. If acquisition rejects, the\n   397\t * provider must roll back its own partial resources; no lease has been returned.\n   398\t */\n   399\texport interface McpFnRemoteCredentialProvider {\n   400\t  acquire(\n   401\t    context: McpFnRemoteCredentialContext,\n   402\t  ): McpFnRemoteCredential | Promise<McpFnRemoteCredential>;\n   403\t  revoke?(\n   404\t    credential: McpFnRemoteCredential,\n   405\t    context: McpFnRemoteCredentialContext,\n   406\t  ): void | Promise<void>;\n   407\t  dispose?(\n   408\t    credential: McpFnRemoteCredential,\n   409\t    context: McpFnRemoteCredentialContext,\n   410\t  ): void | Promise<void>;\n   411\t}\n   412\t\n   413\texport interface McpFnRemoteCredentialLease {\n   414\t  credential: McpFnRemoteCredential;\n   415\t  release(): Promise<void>;\n   416\t  /** The lifecycle stage that most recently prevented credential release. */\n   417\t  cleanupPhase(): \"token-revocation\" | \"transport-close\";\n   418\t}\n   419\t\n   420\texport interface McpFnAuthenticatedHttpTargetOptions\n   421\t  extends Omit<McpFnStreamableHttpTargetOptions, \"authProvider\" | \"requestInit\"> {\n   422\t  credential: McpFnRemoteCredential | McpFnRemoteCredentialProvider;\n   423\t  requestInit?: Omit<RequestInit, \"headers\" | \"redirect\"> & { headers?: HeadersInit };\n   424\t}\n   425\t\n   426\t/** Create a provider for an already-bounded API key or OAuth-derived token. */\n   427\texport function staticRemoteCredentialProvider(\n   428\t  credential: McpFnRemoteCredential,\n   429\t): McpFnRemoteCredentialProvider {\n   430\t  return { acquire: () => credential };\n   510\t  const pendingReleases = new Set<() => Promise<void>>();\n   511\t  const authenticated = customTarget({\n   512\t    kind: \"authenticated-streamable-http\",\n   513\t    descriptor: {\n   514\t      url: descriptorUrl.toString(),\n   515\t      authenticated: true,\n   516\t    },\n   517\t    redact: (value, redaction) => redactTargetCredentials(authenticated, value, { preserveKeys: true, ...redaction }),\n   518\t    async cleanup() {\n   519\t      const results = await Promise.allSettled([...pendingReleases].map(release => release()));\n   520\t      const failures = results.filter((result): result is PromiseRejectedResult => result.status === \"rejected\");\n   521\t      const failure = failures.find(({ reason }) => reason && typeof reason === \"object\" &&\n   522\t        (reason as { phase?: unknown }).phase === \"token-revocation\") ?? failures[0];\n   523\t      if (failure) throw failure.reason;\n   524\t    },\n   525\t    async open(targetContext): Promise<McpFnTransportHandle> {\n   526\t      const context: McpFnRemoteCredentialContext = {\n   527\t        url: targetUrl.toString(),\n   528\t        requestId: targetContext.requestId,\n   529\t        signal: targetContext.signal,\n   530\t      };\n   531\t      const lease = await acquireRemoteCredential(options.credential, context);\n   532\t      const secrets = new Set<string>();\n   533\t      const release = async () => {\n   534\t        try { await lease.release(); }\n   535\t        catch (error) { pendingReleases.add(release); throw error; }\n   536\t        pendingReleases.delete(release);\n   537\t        for (const secret of secrets) {\n   538\t          const count = (state.active.get(secret) ?? 1) - 1;\n   539\t          if (count) state.active.set(secret, count); else state.active.delete(secret);\n   540\t        }\n   541\t        secrets.clear();\n   542\t      };\n   543\t      let handle: McpFnTransportHandle | undefined;\n   544\t      try {\n   545\t        for (const secret of credentialValues(lease.credential.headers)) {\n   546\t          secrets.add(secret);\n   547\t          state.active.set(secret, (state.active.get(secret) ?? 0) + 1);\n   548\t          for (const scope of state.scopes) scope.add(secret);\n   549\t        }\n   550\t        const credentialHeaders = validateRemoteCredentialHeaders(lease.credential.headers);\n   551\t        const headers = new Headers(requestInit?.headers);\n   552\t        credentialHeaders.forEach((value, name) => headers.set(name, value));\n   553\t        const target = streamableHttpTarget(targetUrl, {\n   554\t          ...transportOptions,\n   555\t          requestInit: {\n   556\t            ...requestInit,\n   557\t            headers,\n   558\t            // Fetch must not replay credentials to a redirect destination.\n   559\t            redirect: \"error\",\n   560\t          },\n   561\t        });\n   562\t        handle = await target.open(targetContext);\n   563\t      } catch (error) {\n   564\t        // Sanitize while the lease still supplies its immutable header snapshot.\n   565\t        // Cleanup removes active secrets before the client emits failed-open diagnostics.\n   350\t});\n   351\t\n   352\tit(\"retains failed pre-handle releases for a cleanup retry\", async () => {\n   353\t  const revoke = vi.fn().mockRejectedValueOnce(new Error(\"temporary\")).mockResolvedValue(undefined);\n   354\t  const target = authenticatedHttpTarget(\"http://127.0.0.1:1/mcp\", { credential: {\n   355\t    acquire: () => ({ headers: undefined } as any), revoke,\n   356\t  } });\n   357\t  await expect(target.open({ requestId: \"invalid\", diagnostic: async () => {} })).rejects.toThrow(/cleanup failed/);\n   358\t  await target.cleanup!();\n   359\t  expect(revoke).toHaveBeenCalledTimes(2);\n   360\t});\n   361\tit(\"releases malformed credentials even when inspection fails\", async () => {\n   362\t  const revoke = vi.fn();\n   363\t  const target = authenticatedHttpTarget(\"http://127.0.0.1:1/mcp\", { credential: {\n   364\t    acquire: () => ({ headers: undefined } as any), revoke,\n   365\t  } });\n   366\t  await expect(target.open({ requestId: \"invalid\", diagnostic: async () => {} })).rejects.toThrow();\n   367\t  expect(revoke).toHaveBeenCalledOnce();\n   368\t});\n   369\t\n   370\tit(\"scrubs opaque credentials before generic redaction can truncate their suffix\", async () => {\n   371\t  const {redactRemoteCredential} = await import(\"../src/remote-target.js\");\n   372\t  const token = \"opaque-credential-unique-tail\";\n   373\t  const input = \"data=x \" + \"a\".repeat(262144 - 7 - 8) + token;\n   374\t  // Inputs beyond the explicit budget fail closed before any output is emitted.\n   375\t  expect(() => redactRemoteCredential({headers: {\"x-api-key\": token}}, input)).toThrow(/traversal budget/);\n   376\t});\n   377\tit(\"scrubs token components of custom authorization schemes\", async () => {\n   378\t  const {redactRemoteCredential} = await import(\"../src/remote-target.js\");\n   379\t  expect(redactRemoteCredential({headers: {authorization: \"Token opaque-123\"}}, {echo: \"opaque-123\"})).toEqual({echo: \"[REDACTED]\"});\n   380\t});\n   381\t\n   382\t\n   383\tit(\"retains successful-open leases until revocation succeeds\", async () => {\n   384\t  const revoke = vi.fn().mockRejectedValueOnce(new Error('temporary')).mockResolvedValue(undefined);\n   385\t  const target = authenticatedHttpTarget('http://127.0.0.1:1/mcp', { credential: { acquire: () => ({ headers: { 'x-api-key': 'opaque-key' } }), revoke } });\n   386\t  const handle = await target.open({ requestId: 'lease', diagnostic: async () => {} });\n   387\t  await expect(handle.close!()).rejects.toThrow(/cleanup/);\n   388\t  await target.cleanup!();\n   389\t  expect(revoke).toHaveBeenCalledTimes(2);\n   390\t});\n   391\t\n   392\tit(\"rejects credentials that collide with fixed report values\", async () => {\n   393\t  const { redactRemoteCredential, McpFnRedactionLimitError } = await import('../src/remote-target.js');\n   394\t  for (const secret of ['none', 'http', '0.0.5']) {\n   395\t    const report = { kind: 'mcpfn.target-suite-report', target: { kind: 'authenticated-streamable-http' }, runtime: { packages: { testing: '0.0.5' } }, results: [{ sideEffect: 'none', name: secret }] };\n   396\t    expect(() => redactRemoteCredential(\n   397\t      { headers: { 'x-api-key': secret } },\n   398\t      report,\n   399\t      { preserveKeys: true },\n   400\t    )).toThrow(McpFnRedactionLimitError);\n   890\t    await Promise.all([handle.close!(), handle.close!()]);\n   891\t    expect(close).toHaveBeenCalledOnce();\n   892\t    expect(revoke).toHaveBeenCalledTimes(stage === \"revoke\" ? 2 : 1);\n   893\t    expect(dispose).toHaveBeenCalledTimes(stage === \"dispose\" ? 2 : 1);\n   894\t  } finally { await fixture.close(); }\n   895\t});\n   896\t\n   897\t\n   898\tit.each([\"***\", \"[REDACTED]\", \"#\"])(\"never emits another credential as a generated mask (%s)\", async mask => {\n   899\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   900\t  const credentials = { headers: { \"x-api-key\": \"abc\", \"x-secondary-key\": mask } };\n   901\t  const redacted = redactRemoteCredential(credentials, { value: \"abc\", other: mask });\n   902\t  expect(JSON.stringify(redacted)).not.toContain(\"abc\");\n   903\t  expect(JSON.stringify(redacted)).not.toContain(mask);\n   904\t});\n   905\t\n   906\tit.each([\"foo name\", \"Bearer name\", \"Basic name\"])(\"keeps an opaque API key whole during extraction (%s)\", async secret => {\n   907\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   908\t  const redacted = redactRemoteCredential({ headers: { \"x-api-key\": secret } }, { name: \"name\", echoed: secret });\n   909\t  expect(redacted.name).toBe(\"name\");\n   910\t  expect(JSON.stringify(redacted)).not.toContain(secret);\n   911\t});\n   912\t\n   913\tit.each([\"authorization\", \"Authorization\", \"proxy-authorization\"])(\"extracts recognized bearer credentials from %s\", async header => {\n   914\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   915\t  expect(redactRemoteCredential({ headers: { [header]: \"bEaReR tokenvalue\" } }, { reflected: \"tokenvalue\" }).reflected).not.toBe(\"tokenvalue\");\n   916\t});\n   917\t\n   918\tit(\"extracts independently reflectable Cookie credential values\", async () => {\n   919\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   920\t  const redacted = redactRemoteCredential(\n   921\t    { headers: { Cookie: 'session=opaque-cookie; quoted=\"quoted-cookie\"' } },\n   922\t    { session: \"opaque-cookie\", quoted: \"quoted-cookie\" },\n   923\t  );\n   924\t  expect(JSON.stringify(redacted)).not.toContain(\"opaque-cookie\");\n   925\t  expect(JSON.stringify(redacted)).not.toContain(\"quoted-cookie\");\n   926\t});\n   927\t\n   928\tit.each([\"missing-pair\", 'session=\"unterminated'])(\"rejects ambiguous Cookie credential syntax (%s)\", async cookie => {\n   929\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   930\t  expect(() => redactRemoteCredential({ headers: { Cookie: cookie } }, { value: \"safe\" }))\n   931\t    .toThrow(/Cookie credential/);\n   932\t});\n   933\t\n   934\t\n   935\tit.each([\n   936\t  { name: \"adjacent masks\", secrets: [\"a\", \"b\", \"**\"], input: \"ab\" },\n   937\t  { name: \"deletion joins surrounding text\", secrets: [\"abc\", \"***\", \"xy\"], input: \"xabcy\" },\n   938\t  { name: \"mask joins existing text\", secrets: [\"abc\", \"***x\"], input: \"abcx\" },\n   939\t])(\"checks the final output for $name\", async ({ secrets, input }) => {\n   940\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   941\t  const headers = Object.fromEntries(secrets.map((secret, index) => [`x-secret-${index}`, secret]));\n   942\t  const output = redactRemoteCredential({ headers }, { [input]: input });\n   943\t  for (const [key, value] of Object.entries(output)) {\n   944\t    for (const secret of secrets) {\n   945\t      expect(key).not.toContain(secret);\n   380\tconst suiteStructureValues = [\n   381\t  \"mcpfn.target-suite-report\", \"complete\", \"incomplete\", \"passed\", \"failed\",\n   382\t  \"started\", \"succeeded\", \"none\", \"idempotent\", \"non-idempotent\",\n   383\t  \"mcpfn-preflight\", \"authorization-server\", \"resource-server\", \"mcp-initialization\",\n   384\t  \"scenario\", \"upstream-conformance\", \"resource-discovery\",\n   385\t  \"authorization-server-discovery\", \"client-registration\", \"authorization-request\",\n   386\t  \"authorization-callback\", \"token-exchange\", \"token-refresh\", \"token-revocation\",\n   387\t  \"transport-connect\", \"mcp-initialize\", \"capability-operation\", \"transport-close\",\n   388\t  \"authenticated-streamable-http\", \"streamable-http\", \"stdio\", \"in-memory\", \"custom\",\n   389\t] as const;\n   390\t\n   391\tinterface SuiteStructureGuard {\n   392\t  assert(value: string): void;\n   393\t}\n   394\t\n   395\tfunction captureSuiteStructureGuard(\n   396\t  target: McpFnTarget,\n   397\t  projection: SuiteProjection,\n   398\t  diagnostics: SuiteDiagnosticCollector,\n   399\t): SuiteStructureGuard {\n   400\t  const candidates = new Set<string>([\n   401\t    ...suiteStructureKeys,\n   402\t    ...suiteStructureValues,\n   403\t    process.version,\n   404\t    MCPFN_REPORT_SCHEMA_VERSION,\n   405\t    MCPFN_TESTING_VERSION,\n   406\t    projection.target.kind,\n   407\t  ]);\n   408\t  for (const result of projection.execution.results) {\n   409\t    candidates.add(result.status);\n   410\t    if (result.sideEffect) candidates.add(result.sideEffect);\n   411\t  }\n   412\t  for (const event of diagnostics.timeline) {\n   413\t    candidates.add(event.phase);\n   414\t    candidates.add(event.outcome);\n   415\t    if (event.target?.kind) candidates.add(event.target.kind);\n   416\t  }\n   417\t  const safe = new Set<string>();\n   418\t  for (const candidate of candidates) {\n   419\t    try {\n   420\t      if (redactSuiteArtifact(target, candidate, { preserveKeys: false }) === candidate) {\n   421\t        safe.add(candidate);\n   422\t      }\n   423\t    } catch {\n   424\t      // If the live custom scrubber cannot classify a string, fail closed only\n   425\t      // when the final report actually needs that unproven structure.\n   426\t    }\n   427\t  }\n   428\t  return {\n   429\t    assert(value: string): void {\n   430\t      if (!safe.has(value)) throw new McpFnStructuralCredentialCollisionError();\n   431\t    },\n   432\t  };\n   433\t}\n   434\t\n   435\tfunction assertStructureKeys(value: object, guard: SuiteStructureGuard): void {\n   436\t  for (const key of Object.keys(value)) guard.assert(key);\n   437\t}\n   438\t\n   439\tfunction assertTargetStructure(\n   440\t  target: McpFnTargetDescriptor,\n   441\t  guard: SuiteStructureGuard,\n   442\t): void {\n   443\t  guard.assert(\"kind\");\n   444\t  guard.assert(target.kind);\n   445\t}\n   446\t\n   447\tfunction assertSuiteReportStructure(\n   448\t  report: McpFnTargetSuiteReport,\n   449\t  guard: SuiteStructureGuard,\n   450\t): void {\n   451\t  assertStructureKeys(report, guard);\n   452\t  guard.assert(report.kind);\n   453\t  guard.assert(report.status);\n   454\t  assertStructureKeys(report.runtime, guard);\n   455\t  guard.assert(report.runtime.node);\n   456\t  guard.assert(report.runtime.reportSchemaVersion);\n   457\t  assertStructureKeys(report.runtime.packages, guard);\n   458\t  guard.assert(report.runtime.packages.testing);\n   459\t  assertTargetStructure(report.target, guard);\n   460\t  if (report.failure) {\n   461\t    assertStructureKeys(report.failure, guard);\n   462\t    guard.assert(report.failure.layer);\n   463\t    if (report.failure.phase) guard.assert(report.failure.phase);\n   464\t  }\n   465\t  for (const event of report.timeline) {\n   466\t    assertStructureKeys(event, guard);\n   467\t    guard.assert(event.phase);\n   468\t    guard.assert(event.outcome);\n   469\t    if (event.target) assertTargetStructure(event.target, guard);\n   470\t  }\n   471\t  for (const result of report.results) {\n   472\t    assertStructureKeys(result, guard);\n   473\t    guard.assert(result.status);\n   474\t    if (result.sideEffect) guard.assert(result.sideEffect);\n   475\t  }\n   535\t    diagnostics.captureBaseline(client);\n   536\t    await client.session.connect();\n   537\t    ({ execution, manifestChecked } = await executeConnectedSuite(client, options));\n   538\t  } catch (error) {\n   539\t    failure = safeTargetFailure(options.target, error);\n   540\t  }\n   541\t  return { client, manifestChecked, failure, execution };\n   542\t}\n   543\t\n   544\tasync function projectAndCloseSuite(\n   545\t  options: RunMcpFnTargetSuiteOptions,\n   546\t  diagnostics: SuiteDiagnosticCollector,\n   547\t  connection: SuiteConnection,\n   548\t): Promise<{\n   549\t  projection: SuiteProjection;\n   550\t  structureGuard: SuiteStructureGuard;\n   551\t  closeResult: Awaited<ReturnType<typeof closeSuiteClient>>;\n   552\t}> {\n   553\t  let projection: SuiteProjection = {\n   554\t    target: { kind: \"custom\" },\n   555\t    execution: connection.execution,\n   556\t    failure: \"serialization\",\n   557\t  };\n   558\t  let structureGuard: SuiteStructureGuard = {\n   559\t    assert: () => { throw new McpFnStructuralCredentialCollisionError(); },\n   560\t  };\n   561\t  let closeResult: Awaited<ReturnType<typeof closeSuiteClient>> = {};\n   562\t  try {\n   563\t    projection = projectSuiteArtifacts(options, connection.client, connection.execution);\n   564\t    structureGuard = captureSuiteStructureGuard(options.target, projection, diagnostics);\n   565\t  } finally {\n   566\t    closeResult = await closeSuiteClient(connection.client);\n   567\t  }\n   568\t  return { projection, structureGuard, closeResult };\n   569\t}\n   570\t\n   571\tfunction suiteIncompleteReasons(\n   572\t  failure: McpFnReportFailure | undefined,\n   573\t  cleanupFailure: McpFnReportFailure | undefined,\n   574\t  diagnostics: SuiteDiagnosticCollector,\n   575\t  redactionOmittedObservedEvents: number,\n   180\t  expect(report.incompleteReason).toContain(\"Target cleanup failed\");\n   181\t  expect(JSON.stringify(report)).not.toContain(\"opaque-cleanup-value\");\n   182\t});\n   183\t\n   184\t\n   185\tit.each([\"x\", \"€\"])(\"bounds long target failures under the minimum report cap: %s\", async character => {\n   186\t  const { customTarget } = await import('@mcpfn/client');\n   187\t  const report = await runMcpFnTargetSuite({ target: customTarget({ kind: 'failure', open: async () => { throw new Error(character.repeat(4000)); } }), maxReportBytes: 1024 });\n   188\t  expect(report.status).toBe('incomplete');\n   189\t  expect(Buffer.byteLength(JSON.stringify(report, null, 2))).toBeLessThanOrEqual(1024);\n   190\t});\n   191\t\n   192\tit(\"retains a complete report when only its compact encoding fits\", async () => {\n   193\t  const run = async (maxReportBytes?: number) => {\n   194\t    const server = createMcpFnServer({ info: { name: \"compact\", version: \"1\" }, registry: new McpFnRegistry().register({ name: \"echo\", description: \"Echo\", inputSchema: { type: \"object\" }, handler: async input => structuredResult(input) }) });\n   195\t    return runMcpFnTargetSuite({ maxReportBytes, target: customTarget({ kind: \"compact\", open: async () => {\n   196\t      const [transport, peer] = InMemoryTransport.createLinkedPair();\n   197\t      await server.connect(peer);\n   198\t      return { transport, close: () => server.close() };\n   199\t    } }), scenarios: Array.from({ length: 5 }, (_, i) => ({ name: `echo-${i}`, tool: \"echo\", arguments: { value: \"ok\" }, expect: { structuredContent: { value: \"ok\" } } })) });\n   200\t  };\n   201\t  const full = await run();\n   202\t  const cap = Math.max(1024, new TextEncoder().encode(JSON.stringify(full)).byteLength + 128);\n   203\t  expect(cap).toBeLessThan(new TextEncoder().encode(JSON.stringify(full, null, 2)).byteLength);\n   204\t  const bounded = await run(cap);\n   205\t  expect(bounded.ok).toBe(true);\n   206\t  expect(bounded.droppedResults).toBe(0);\n   207\t  expect(new TextEncoder().encode(JSON.stringify(bounded)).byteLength).toBeLessThanOrEqual(cap);\n   208\t});\n   209\t\n   210\tit(\"does not repeat successful custom cleanup after an open failure\", async () => {\n   211\t  const cleanup = vi.fn(async () => {\n   212\t    if (cleanup.mock.calls.length > 1) throw new Error(\"cleanup repeated\");\n   213\t  });\n   214\t  const report = await runMcpFnTargetSuite({ target: customTarget({\n   215\t    kind: \"failed-open\", open: async () => { throw new Error(\"cannot open\"); }, cleanup,\n   216\t  }) });\n   217\t  expect(report.ok).toBe(false);\n   218\t  expect(cleanup).toHaveBeenCalledOnce();\n   219\t  expect(report.incompleteReason).not.toContain(\"Target cleanup failed\");\n   220\t});\n   221\t\n   222\t\n   223\tit.each([\"metadata\", \"failure\"])(\"applies custom target redaction to finalized suite %s\", async mode => {\n   224\t  const secret = \"custom-owned-secret\";\n   225\t  const server = createMcpFnServer({\n   226\t    info: { name: secret, version: \"1.0.0\" },\n   227\t    registry: new McpFnRegistry().register({\n   228\t      name: \"visible-tool\", description: \"Fixture tool\", inputSchema: { type: \"object\" },\n   229\t      handler: async () => structuredResult({ ok: true }),\n   230\t    }),\n   231\t  });\n   232\t  const target = customTarget({\n   233\t    kind: \"custom\",\n   234\t    descriptor: { label: secret },\n   235\t    redact: <T>(value: T): T => {\n","exit_code":0,"duration":{"secs":0,"nanos":5958},"formatted_output":"     1\timport {\n     2\t  McpFnClientError,\n     3\t  customTarget,\n     4\t  streamableHttpTarget,\n     5\t  type McpFnStreamableHttpTargetOptions,\n     6\t  type McpFnTarget,\n     7\t  type McpFnTransportHandle,\n     8\t} from \"@mcpfn/client\";\n     9\t\n    10\timport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n    11\t\n    12\ttype SecretState = { active: Map<string, number>; scopes: Set<Set<string>> };\n    13\tconst targetSecrets = new WeakMap<McpFnTarget, SecretState>();\n    14\tconst utf8Encoder = new TextEncoder();\n    15\t\n    16\t/** Retain released credentials only for the lifetime of a report operation. */\n    17\texport function beginTargetCredentialRedaction(target: McpFnTarget): () => void {\n    18\t  const state = targetSecrets.get(target);\n    19\t  if (!state) return () => undefined;\n    20\t  const scope = new Set(state.active.keys());\n    21\t  state.scopes.add(scope);\n    22\t  return () => { state.scopes.delete(scope); scope.clear(); };\n    23\t}\n    24\t\n    25\tfunction credentialValues(headers: HeadersInit): Set<string> {\n    26\t  const values = boundedCredentialEntries(headers);\n    27\t  const secrets = new Set<string>();\n    28\t  for (const [header, raw] of values) {\n    29\t    if (!raw.trim()) continue;\n    30\t    secrets.add(raw);\n    31\t    secrets.add(raw.trim());\n    32\t    const normalizedHeader = header.toLowerCase();\n    33\t    if ([\"authorization\", \"proxy-authorization\"].includes(normalizedHeader)) {\n    34\t      addAuthorizationSecrets(raw, secrets);\n    35\t    }\n    36\t    if (normalizedHeader === \"cookie\") addCookieSecrets(raw, secrets);\n    37\t  }\n    38\t  return secrets;\n    39\t}\n    40\t\n    41\tfunction addAuthorizationSecrets(raw: string, secrets: Set<string>): void {\n    42\t  const trimmed = raw.trim();\n    43\t  const separator = trimmed.search(/\\s/);\n    44\t  if (separator <= 0) return;\n    45\t  const scheme = trimmed.slice(0, separator).toLowerCase();\n    46\t  const token = trimmed.slice(separator).trim();\n    47\t  if (token) secrets.add(token);\n    48\t  if (scheme !== \"basic\" || !/^[\\dA-Za-z+/]+={0,2}$/.test(token)) return;\n    49\t  const decoded = Buffer.from(token, \"base64\");\n    50\t  // Round-trip validation avoids interpreting malformed tokens as credentials.\n    51\t  if (stripBase64Padding(decoded.toString(\"base64\")) !== stripBase64Padding(token)) return;\n    52\t  for (const encoding of [\"utf8\", \"latin1\"] as const) {\n    53\t    const pair = decoded.toString(encoding);\n    54\t    const colon = pair.indexOf(\":\");\n    55\t    if (colon < 0) continue;\n    56\t    for (const value of [pair, pair.slice(0, colon), pair.slice(colon + 1)]) {\n    57\t      if (value) secrets.add(value);\n    58\t    }\n    59\t  }\n    60\t}\n    61\t\n    62\tfunction stripBase64Padding(value: string): string {\n    63\t  let end = value.length;\n    64\t  while (end > 0 && value[end - 1] === \"=\") end -= 1;\n    65\t  return value.slice(0, end);\n    66\t}\n    67\t\n    68\tfunction addCookieSecrets(raw: string, secrets: Set<string>): void {\n    69\t  // Cookie values are independently reflectable even though the request\n    70\t  // authenticates with the complete header. RFC 6265 cookie values cannot\n    71\t  // contain comma or semicolon, so both delimiters cover combined entries.\n    72\t  for (const part of raw.split(/[;,]/)) {\n    73\t    const pair = part.trim();\n    74\t    if (!pair) continue;\n    75\t    const equals = pair.indexOf(\"=\");\n    76\t    if (equals < 1) {\n    77\t      throw new TypeError(\"Cookie credential headers must contain name=value pairs\");\n    78\t    }\n    79\t    const value = pair.slice(equals + 1).trim();\n    80\t    if (!value) continue;\n    81\t    secrets.add(value);\n    82\t    addUnquotedCookieSecret(value, secrets);\n    83\t  }\n    84\t}\n    85\t\n    86\tfunction addUnquotedCookieSecret(value: string, secrets: Set<string>): void {\n    87\t  if (!value.startsWith('\"') && !value.endsWith('\"')) return;\n    88\t  if (value.length < 2 || !value.startsWith('\"') || !value.endsWith('\"')) {\n    89\t    throw new TypeError(\"Cookie credential values must use balanced quotes\");\n    90\t  }\n    91\t  const unquoted = value.slice(1, -1);\n    92\t  if (unquoted.includes('\"') || unquoted.includes(\"\\\\\")) {\n    93\t    throw new TypeError(\"Cookie credential values must use RFC 6265 syntax\");\n    94\t  }\n    95\t  if (unquoted) secrets.add(unquoted);\n    96\t}\n    97\t\n    98\texport class McpFnRedactionLimitError extends Error {\n    99\t  constructor(message = \"Credential redaction exceeded its traversal budget\") { super(message); }\n   100\t}\n   101\t\n   102\t/** No typed artifact can preserve this authored structure without exposing a credential. */\n   103\texport class McpFnStructuralCredentialCollisionError extends McpFnRedactionLimitError {\n   104\t  constructor() {\n   105\t    super(\"Credential collides with required artifact structure\");\n   106\t  }\n   107\t}\n   108\t\n   109\t// Only these locally authored envelope paths retain structural keys. Unknown\n   110\t// children (including inspector events and server metadata) are always payloads.\n   111\tconst envelopeKeys: Record<string, Set<string>> = Object.fromEntries(Object.entries({\n   112\t  root: \"formatVersion kind status runtime ok target server capabilities manifestChecked manifestHash total passed failed incomplete droppedResults droppedObservedEvents redactionOmittedObservedEvents incompleteReason failure timeline droppedTimelineEvents results count clientState tools resources resourceTemplates prompts droppedEvents timelineComplete droppedInventoryEntries inventoryComplete suiteVersion exitCode stdout stderr phase outcome code requestId at details payload\",\n   113\t  result: \"formatVersion name operation tool status sideEffect durationMs error droppedObservedEvents redactionOmittedObservedEvents\",\n   114\t  diagnostic: \"phase outcome code requestId at target details\",\n   115\t  inspectorEvent: \"formatVersion source kind at event\",\n   335\t  return result;\n   336\t}\n   337\t\n   338\tfunction assertPayloadSerialization(\n   339\t  value: unknown,\n   340\t  role: string,\n   341\t  finalPass: boolean,\n   342\t  credentialPattern: RegExp | undefined,\n   343\t): void {\n   344\t  if (!finalPass || role !== \"payload\" || !credentialPattern) return;\n   345\t  const serialized = JSON.stringify(value);\n   346\t  if (serialized !== undefined && credentialPattern.test(serialized)) {\n   347\t    throw new McpFnRedactionLimitError(\n   348\t      \"Credential redaction could not guarantee safe serialized output\",\n   349\t    );\n   350\t  }\n   351\t}\n   352\t\n   353\t/** Remove known opaque credential values as well as credential-shaped fields. */\n   354\texport function redactTargetCredentials<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean; redactionMarker?: string } = {}): T {\n   355\t  const state = targetSecrets.get(target);\n   356\t  return scrubCredentials(value, new Set([...(state?.active.keys() ?? []), ...[...(state?.scopes ?? [])].flatMap((scope) => [...scope])]), options.preserveKeys, options.redactionMarker);\n   357\t}\n   358\t\n   359\t/** Redact authenticated conformance output using the acquired credential. */\n   360\texport function redactRemoteCredential<T>(credential: McpFnRemoteCredential, value: T, options: { preserveKeys?: boolean } = {}): T {\n   361\t  return scrubCredentials(value, credentialValues(credential.headers), options.preserveKeys);\n   362\t}\n   363\t\n   364\tconst MAX_CREDENTIAL_HEADERS = 32;\n   365\tconst MAX_CREDENTIAL_HEADER_BYTES = 16_384;\n   366\tconst MAX_CREDENTIAL_HEADER_VALUE_BYTES = 8_192;\n   367\tconst FORBIDDEN_CREDENTIAL_HEADERS = new Set([\n   368\t  \"connection\",\n   369\t  \"content-length\",\n   370\t  \"host\",\n   371\t  \"proxy-connection\",\n   372\t  \"te\",\n   373\t  \"trailer\",\n   374\t  \"transfer-encoding\",\n   375\t  \"upgrade\",\n   376\t]);\n   377\t\n   378\texport type McpFnRemoteCredentialKind = \"api-key\" | \"oauth\" | \"custom\";\n   379\t\n   380\texport interface McpFnRemoteCredential {\n   381\t  /** Credential headers are applied only to the fixed target origin. */\n   382\t  headers: HeadersInit;\n   383\t  kind?: McpFnRemoteCredentialKind;\n   384\t  label?: string;\n   385\t}\n   386\t\n   387\texport interface McpFnRemoteCredentialContext {\n   388\t  url: string;\n   389\t  requestId: string;\n   390\t  signal?: AbortSignal;\n   391\t}\n   392\t\n   393\t/**\n   394\t * Application-owned credential lifecycle for external MCP targets. McpFn\n   395\t * acquires once per target open, revokes before disposal, and never serializes\n   396\t * the returned headers into descriptors or reports. If acquisition rejects, the\n   397\t * provider must roll back its own partial resources; no lease has been returned.\n   398\t */\n   399\texport interface McpFnRemoteCredentialProvider {\n   400\t  acquire(\n   401\t    context: McpFnRemoteCredentialContext,\n   402\t  ): McpFnRemoteCredential | Promise<McpFnRemoteCredential>;\n   403\t  revoke?(\n   404\t    credential: McpFnRemoteCredential,\n   405\t    context: McpFnRemoteCredentialContext,\n   406\t  ): void | Promise<void>;\n   407\t  dispose?(\n   408\t    credential: McpFnRemoteCredential,\n   409\t    context: McpFnRemoteCredentialContext,\n   410\t  ): void | Promise<void>;\n   411\t}\n   412\t\n   413\texport interface McpFnRemoteCredentialLease {\n   414\t  credential: McpFnRemoteCredential;\n   415\t  release(): Promise<void>;\n   416\t  /** The lifecycle stage that most recently prevented credential release. */\n   417\t  cleanupPhase(): \"token-revocation\" | \"transport-close\";\n   418\t}\n   419\t\n   420\texport interface McpFnAuthenticatedHttpTargetOptions\n   421\t  extends Omit<McpFnStreamableHttpTargetOptions, \"authProvider\" | \"requestInit\"> {\n   422\t  credential: McpFnRemoteCredential | McpFnRemoteCredentialProvider;\n   423\t  requestInit?: Omit<RequestInit, \"headers\" | \"redirect\"> & { headers?: HeadersInit };\n   424\t}\n   425\t\n   426\t/** Create a provider for an already-bounded API key or OAuth-derived token. */\n   427\texport function staticRemoteCredentialProvider(\n   428\t  credential: McpFnRemoteCredential,\n   429\t): McpFnRemoteCredentialProvider {\n   430\t  return { acquire: () => credential };\n   510\t  const pendingReleases = new Set<() => Promise<void>>();\n   511\t  const authenticated = customTarget({\n   512\t    kind: \"authenticated-streamable-http\",\n   513\t    descriptor: {\n   514\t      url: descriptorUrl.toString(),\n   515\t      authenticated: true,\n   516\t    },\n   517\t    redact: (value, redaction) => redactTargetCredentials(authenticated, value, { preserveKeys: true, ...redaction }),\n   518\t    async cleanup() {\n   519\t      const results = await Promise.allSettled([...pendingReleases].map(release => release()));\n   520\t      const failures = results.filter((result): result is PromiseRejectedResult => result.status === \"rejected\");\n   521\t      const failure = failures.find(({ reason }) => reason && typeof reason === \"object\" &&\n   522\t        (reason as { phase?: unknown }).phase === \"token-revocation\") ?? failures[0];\n   523\t      if (failure) throw failure.reason;\n   524\t    },\n   525\t    async open(targetContext): Promise<McpFnTransportHandle> {\n   526\t      const context: McpFnRemoteCredentialContext = {\n   527\t        url: targetUrl.toString(),\n   528\t        requestId: targetContext.requestId,\n   529\t        signal: targetContext.signal,\n   530\t      };\n   531\t      const lease = await acquireRemoteCredential(options.credential, context);\n   532\t      const secrets = new Set<string>();\n   533\t      const release = async () => {\n   534\t        try { await lease.release(); }\n   535\t        catch (error) { pendingReleases.add(release); throw error; }\n   536\t        pendingReleases.delete(release);\n   537\t        for (const secret of secrets) {\n   538\t          const count = (state.active.get(secret) ?? 1) - 1;\n   539\t          if (count) state.active.set(secret, count); else state.active.delete(secret);\n   540\t        }\n   541\t        secrets.clear();\n   542\t      };\n   543\t      let handle: McpFnTransportHandle | undefined;\n   544\t      try {\n   545\t        for (const secret of credentialValues(lease.credential.headers)) {\n   546\t          secrets.add(secret);\n   547\t          state.active.set(secret, (state.active.get(secret) ?? 0) + 1);\n   548\t          for (const scope of state.scopes) scope.add(secret);\n   549\t        }\n   550\t        const credentialHeaders = validateRemoteCredentialHeaders(lease.credential.headers);\n   551\t        const headers = new Headers(requestInit?.headers);\n   552\t        credentialHeaders.forEach((value, name) => headers.set(name, value));\n   553\t        const target = streamableHttpTarget(targetUrl, {\n   554\t          ...transportOptions,\n   555\t          requestInit: {\n   556\t            ...requestInit,\n   557\t            headers,\n   558\t            // Fetch must not replay credentials to a redirect destination.\n   559\t            redirect: \"error\",\n   560\t          },\n   561\t        });\n   562\t        handle = await target.open(targetContext);\n   563\t      } catch (error) {\n   564\t        // Sanitize while the lease still supplies its immutable header snapshot.\n   565\t        // Cleanup removes active secrets before the client emits failed-open diagnostics.\n   350\t});\n   351\t\n   352\tit(\"retains failed pre-handle releases for a cleanup retry\", async () => {\n   353\t  const revoke = vi.fn().mockRejectedValueOnce(new Error(\"temporary\")).mockResolvedValue(undefined);\n   354\t  const target = authenticatedHttpTarget(\"http://127.0.0.1:1/mcp\", { credential: {\n   355\t    acquire: () => ({ headers: undefined } as any), revoke,\n   356\t  } });\n   357\t  await expect(target.open({ requestId: \"invalid\", diagnostic: async () => {} })).rejects.toThrow(/cleanup failed/);\n   358\t  await target.cleanup!();\n   359\t  expect(revoke).toHaveBeenCalledTimes(2);\n   360\t});\n   361\tit(\"releases malformed credentials even when inspection fails\", async () => {\n   362\t  const revoke = vi.fn();\n   363\t  const target = authenticatedHttpTarget(\"http://127.0.0.1:1/mcp\", { credential: {\n   364\t    acquire: () => ({ headers: undefined } as any), revoke,\n   365\t  } });\n   366\t  await expect(target.open({ requestId: \"invalid\", diagnostic: async () => {} })).rejects.toThrow();\n   367\t  expect(revoke).toHaveBeenCalledOnce();\n   368\t});\n   369\t\n   370\tit(\"scrubs opaque credentials before generic redaction can truncate their suffix\", async () => {\n   371\t  const {redactRemoteCredential} = await import(\"../src/remote-target.js\");\n   372\t  const token = \"opaque-credential-unique-tail\";\n   373\t  const input = \"data=x \" + \"a\".repeat(262144 - 7 - 8) + token;\n   374\t  // Inputs beyond the explicit budget fail closed before any output is emitted.\n   375\t  expect(() => redactRemoteCredential({headers: {\"x-api-key\": token}}, input)).toThrow(/traversal budget/);\n   376\t});\n   377\tit(\"scrubs token components of custom authorization schemes\", async () => {\n   378\t  const {redactRemoteCredential} = await import(\"../src/remote-target.js\");\n   379\t  expect(redactRemoteCredential({headers: {authorization: \"Token opaque-123\"}}, {echo: \"opaque-123\"})).toEqual({echo: \"[REDACTED]\"});\n   380\t});\n   381\t\n   382\t\n   383\tit(\"retains successful-open leases until revocation succeeds\", async () => {\n   384\t  const revoke = vi.fn().mockRejectedValueOnce(new Error('temporary')).mockResolvedValue(undefined);\n   385\t  const target = authenticatedHttpTarget('http://127.0.0.1:1/mcp', { credential: { acquire: () => ({ headers: { 'x-api-key': 'opaque-key' } }), revoke } });\n   386\t  const handle = await target.open({ requestId: 'lease', diagnostic: async () => {} });\n   387\t  await expect(handle.close!()).rejects.toThrow(/cleanup/);\n   388\t  await target.cleanup!();\n   389\t  expect(revoke).toHaveBeenCalledTimes(2);\n   390\t});\n   391\t\n   392\tit(\"rejects credentials that collide with fixed report values\", async () => {\n   393\t  const { redactRemoteCredential, McpFnRedactionLimitError } = await import('../src/remote-target.js');\n   394\t  for (const secret of ['none', 'http', '0.0.5']) {\n   395\t    const report = { kind: 'mcpfn.target-suite-report', target: { kind: 'authenticated-streamable-http' }, runtime: { packages: { testing: '0.0.5' } }, results: [{ sideEffect: 'none', name: secret }] };\n   396\t    expect(() => redactRemoteCredential(\n   397\t      { headers: { 'x-api-key': secret } },\n   398\t      report,\n   399\t      { preserveKeys: true },\n   400\t    )).toThrow(McpFnRedactionLimitError);\n   890\t    await Promise.all([handle.close!(), handle.close!()]);\n   891\t    expect(close).toHaveBeenCalledOnce();\n   892\t    expect(revoke).toHaveBeenCalledTimes(stage === \"revoke\" ? 2 : 1);\n   893\t    expect(dispose).toHaveBeenCalledTimes(stage === \"dispose\" ? 2 : 1);\n   894\t  } finally { await fixture.close(); }\n   895\t});\n   896\t\n   897\t\n   898\tit.each([\"***\", \"[REDACTED]\", \"#\"])(\"never emits another credential as a generated mask (%s)\", async mask => {\n   899\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   900\t  const credentials = { headers: { \"x-api-key\": \"abc\", \"x-secondary-key\": mask } };\n   901\t  const redacted = redactRemoteCredential(credentials, { value: \"abc\", other: mask });\n   902\t  expect(JSON.stringify(redacted)).not.toContain(\"abc\");\n   903\t  expect(JSON.stringify(redacted)).not.toContain(mask);\n   904\t});\n   905\t\n   906\tit.each([\"foo name\", \"Bearer name\", \"Basic name\"])(\"keeps an opaque API key whole during extraction (%s)\", async secret => {\n   907\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   908\t  const redacted = redactRemoteCredential({ headers: { \"x-api-key\": secret } }, { name: \"name\", echoed: secret });\n   909\t  expect(redacted.name).toBe(\"name\");\n   910\t  expect(JSON.stringify(redacted)).not.toContain(secret);\n   911\t});\n   912\t\n   913\tit.each([\"authorization\", \"Authorization\", \"proxy-authorization\"])(\"extracts recognized bearer credentials from %s\", async header => {\n   914\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   915\t  expect(redactRemoteCredential({ headers: { [header]: \"bEaReR tokenvalue\" } }, { reflected: \"tokenvalue\" }).reflected).not.toBe(\"tokenvalue\");\n   916\t});\n   917\t\n   918\tit(\"extracts independently reflectable Cookie credential values\", async () => {\n   919\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   920\t  const redacted = redactRemoteCredential(\n   921\t    { headers: { Cookie: 'session=opaque-cookie; quoted=\"quoted-cookie\"' } },\n   922\t    { session: \"opaque-cookie\", quoted: \"quoted-cookie\" },\n   923\t  );\n   924\t  expect(JSON.stringify(redacted)).not.toContain(\"opaque-cookie\");\n   925\t  expect(JSON.stringify(redacted)).not.toContain(\"quoted-cookie\");\n   926\t});\n   927\t\n   928\tit.each([\"missing-pair\", 'session=\"unterminated'])(\"rejects ambiguous Cookie credential syntax (%s)\", async cookie => {\n   929\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   930\t  expect(() => redactRemoteCredential({ headers: { Cookie: cookie } }, { value: \"safe\" }))\n   931\t    .toThrow(/Cookie credential/);\n   932\t});\n   933\t\n   934\t\n   935\tit.each([\n   936\t  { name: \"adjacent masks\", secrets: [\"a\", \"b\", \"**\"], input: \"ab\" },\n   937\t  { name: \"deletion joins surrounding text\", secrets: [\"abc\", \"***\", \"xy\"], input: \"xabcy\" },\n   938\t  { name: \"mask joins existing text\", secrets: [\"abc\", \"***x\"], input: \"abcx\" },\n   939\t])(\"checks the final output for $name\", async ({ secrets, input }) => {\n   940\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   941\t  const headers = Object.fromEntries(secrets.map((secret, index) => [`x-secret-${index}`, secret]));\n   942\t  const output = redactRemoteCredential({ headers }, { [input]: input });\n   943\t  for (const [key, value] of Object.entries(output)) {\n   944\t    for (const secret of secrets) {\n   945\t      expect(key).not.toContain(secret);\n   380\tconst suiteStructureValues = [\n   381\t  \"mcpfn.target-suite-report\", \"complete\", \"incomplete\", \"passed\", \"failed\",\n   382\t  \"started\", \"succeeded\", \"none\", \"idempotent\", \"non-idempotent\",\n   383\t  \"mcpfn-preflight\", \"authorization-server\", \"resource-server\", \"mcp-initialization\",\n   384\t  \"scenario\", \"upstream-conformance\", \"resource-discovery\",\n   385\t  \"authorization-server-discovery\", \"client-registration\", \"authorization-request\",\n   386\t  \"authorization-callback\", \"token-exchange\", \"token-refresh\", \"token-revocation\",\n   387\t  \"transport-connect\", \"mcp-initialize\", \"capability-operation\", \"transport-close\",\n   388\t  \"authenticated-streamable-http\", \"streamable-http\", \"stdio\", \"in-memory\", \"custom\",\n   389\t] as const;\n   390\t\n   391\tinterface SuiteStructureGuard {\n   392\t  assert(value: string): void;\n   393\t}\n   394\t\n   395\tfunction captureSuiteStructureGuard(\n   396\t  target: McpFnTarget,\n   397\t  projection: SuiteProjection,\n   398\t  diagnostics: SuiteDiagnosticCollector,\n   399\t): SuiteStructureGuard {\n   400\t  const candidates = new Set<string>([\n   401\t    ...suiteStructureKeys,\n   402\t    ...suiteStructureValues,\n   403\t    process.version,\n   404\t    MCPFN_REPORT_SCHEMA_VERSION,\n   405\t    MCPFN_TESTING_VERSION,\n   406\t    projection.target.kind,\n   407\t  ]);\n   408\t  for (const result of projection.execution.results) {\n   409\t    candidates.add(result.status);\n   410\t    if (result.sideEffect) candidates.add(result.sideEffect);\n   411\t  }\n   412\t  for (const event of diagnostics.timeline) {\n   413\t    candidates.add(event.phase);\n   414\t    candidates.add(event.outcome);\n   415\t    if (event.target?.kind) candidates.add(event.target.kind);\n   416\t  }\n   417\t  const safe = new Set<string>();\n   418\t  for (const candidate of candidates) {\n   419\t    try {\n   420\t      if (redactSuiteArtifact(target, candidate, { preserveKeys: false }) === candidate) {\n   421\t        safe.add(candidate);\n   422\t      }\n   423\t    } catch {\n   424\t      // If the live custom scrubber cannot classify a string, fail closed only\n   425\t      // when the final report actually needs that unproven structure.\n   426\t    }\n   427\t  }\n   428\t  return {\n   429\t    assert(value: string): void {\n   430\t      if (!safe.has(value)) throw new McpFnStructuralCredentialCollisionError();\n   431\t    },\n   432\t  };\n   433\t}\n   434\t\n   435\tfunction assertStructureKeys(value: object, guard: SuiteStructureGuard): void {\n   436\t  for (const key of Object.keys(value)) guard.assert(key);\n   437\t}\n   438\t\n   439\tfunction assertTargetStructure(\n   440\t  target: McpFnTargetDescriptor,\n   441\t  guard: SuiteStructureGuard,\n   442\t): void {\n   443\t  guard.assert(\"kind\");\n   444\t  guard.assert(target.kind);\n   445\t}\n   446\t\n   447\tfunction assertSuiteReportStructure(\n   448\t  report: McpFnTargetSuiteReport,\n   449\t  guard: SuiteStructureGuard,\n   450\t): void {\n   451\t  assertStructureKeys(report, guard);\n   452\t  guard.assert(report.kind);\n   453\t  guard.assert(report.status);\n   454\t  assertStructureKeys(report.runtime, guard);\n   455\t  guard.assert(report.runtime.node);\n   456\t  guard.assert(report.runtime.reportSchemaVersion);\n   457\t  assertStructureKeys(report.runtime.packages, guard);\n   458\t  guard.assert(report.runtime.packages.testing);\n   459\t  assertTargetStructure(report.target, guard);\n   460\t  if (report.failure) {\n   461\t    assertStructureKeys(report.failure, guard);\n   462\t    guard.assert(report.failure.layer);\n   463\t    if (report.failure.phase) guard.assert(report.failure.phase);\n   464\t  }\n   465\t  for (const event of report.timeline) {\n   466\t    assertStructureKeys(event, guard);\n   467\t    guard.assert(event.phase);\n   468\t    guard.assert(event.outcome);\n   469\t    if (event.target) assertTargetStructure(event.target, guard);\n   470\t  }\n   471\t  for (const result of report.results) {\n   472\t    assertStructureKeys(result, guard);\n   473\t    guard.assert(result.status);\n   474\t    if (result.sideEffect) guard.assert(result.sideEffect);\n   475\t  }\n   535\t    diagnostics.captureBaseline(client);\n   536\t    await client.session.connect();\n   537\t    ({ execution, manifestChecked } = await executeConnectedSuite(client, options));\n   538\t  } catch (error) {\n   539\t    failure = safeTargetFailure(options.target, error);\n   540\t  }\n   541\t  return { client, manifestChecked, failure, execution };\n   542\t}\n   543\t\n   544\tasync function projectAndCloseSuite(\n   545\t  options: RunMcpFnTargetSuiteOptions,\n   546\t  diagnostics: SuiteDiagnosticCollector,\n   547\t  connection: SuiteConnection,\n   548\t): Promise<{\n   549\t  projection: SuiteProjection;\n   550\t  structureGuard: SuiteStructureGuard;\n   551\t  closeResult: Awaited<ReturnType<typeof closeSuiteClient>>;\n   552\t}> {\n   553\t  let projection: SuiteProjection = {\n   554\t    target: { kind: \"custom\" },\n   555\t    execution: connection.execution,\n   556\t    failure: \"serialization\",\n   557\t  };\n   558\t  let structureGuard: SuiteStructureGuard = {\n   559\t    assert: () => { throw new McpFnStructuralCredentialCollisionError(); },\n   560\t  };\n   561\t  let closeResult: Awaited<ReturnType<typeof closeSuiteClient>> = {};\n   562\t  try {\n   563\t    projection = projectSuiteArtifacts(options, connection.client, connection.execution);\n   564\t    structureGuard = captureSuiteStructureGuard(options.target, projection, diagnostics);\n   565\t  } finally {\n   566\t    closeResult = await closeSuiteClient(connection.client);\n   567\t  }\n   568\t  return { projection, structureGuard, closeResult };\n   569\t}\n   570\t\n   571\tfunction suiteIncompleteReasons(\n   572\t  failure: McpFnReportFailure | undefined,\n   573\t  cleanupFailure: McpFnReportFailure | undefined,\n   574\t  diagnostics: SuiteDiagnosticCollector,\n   575\t  redactionOmittedObservedEvents: number,\n   180\t  expect(report.incompleteReason).toContain(\"Target cleanup failed\");\n   181\t  expect(JSON.stringify(report)).not.toContain(\"opaque-cleanup-value\");\n   182\t});\n   183\t\n   184\t\n   185\tit.each([\"x\", \"€\"])(\"bounds long target failures under the minimum report cap: %s\", async character => {\n   186\t  const { customTarget } = await import('@mcpfn/client');\n   187\t  const report = await runMcpFnTargetSuite({ target: customTarget({ kind: 'failure', open: async () => { throw new Error(character.repeat(4000)); } }), maxReportBytes: 1024 });\n   188\t  expect(report.status).toBe('incomplete');\n   189\t  expect(Buffer.byteLength(JSON.stringify(report, null, 2))).toBeLessThanOrEqual(1024);\n   190\t});\n   191\t\n   192\tit(\"retains a complete report when only its compact encoding fits\", async () => {\n   193\t  const run = async (maxReportBytes?: number) => {\n   194\t    const server = createMcpFnServer({ info: { name: \"compact\", version: \"1\" }, registry: new McpFnRegistry().register({ name: \"echo\", description: \"Echo\", inputSchema: { type: \"object\" }, handler: async input => structuredResult(input) }) });\n   195\t    return runMcpFnTargetSuite({ maxReportBytes, target: customTarget({ kind: \"compact\", open: async () => {\n   196\t      const [transport, peer] = InMemoryTransport.createLinkedPair();\n   197\t      await server.connect(peer);\n   198\t      return { transport, close: () => server.close() };\n   199\t    } }), scenarios: Array.from({ length: 5 }, (_, i) => ({ name: `echo-${i}`, tool: \"echo\", arguments: { value: \"ok\" }, expect: { structuredContent: { value: \"ok\" } } })) });\n   200\t  };\n   201\t  const full = await run();\n   202\t  const cap = Math.max(1024, new TextEncoder().encode(JSON.stringify(full)).byteLength + 128);\n   203\t  expect(cap).toBeLessThan(new TextEncoder().encode(JSON.stringify(full, null, 2)).byteLength);\n   204\t  const bounded = await run(cap);\n   205\t  expect(bounded.ok).toBe(true);\n   206\t  expect(bounded.droppedResults).toBe(0);\n   207\t  expect(new TextEncoder().encode(JSON.stringify(bounded)).byteLength).toBeLessThanOrEqual(cap);\n   208\t});\n   209\t\n   210\tit(\"does not repeat successful custom cleanup after an open failure\", async () => {\n   211\t  const cleanup = vi.fn(async () => {\n   212\t    if (cleanup.mock.calls.length > 1) throw new Error(\"cleanup repeated\");\n   213\t  });\n   214\t  const report = await runMcpFnTargetSuite({ target: customTarget({\n   215\t    kind: \"failed-open\", open: async () => { throw new Error(\"cannot open\"); }, cleanup,\n   216\t  }) });\n   217\t  expect(report.ok).toBe(false);\n   218\t  expect(cleanup).toHaveBeenCalledOnce();\n   219\t  expect(report.incompleteReason).not.toContain(\"Target cleanup failed\");\n   220\t});\n   221\t\n   222\t\n   223\tit.each([\"metadata\", \"failure\"])(\"applies custom target redaction to finalized suite %s\", async mode => {\n   224\t  const secret = \"custom-owned-secret\";\n   225\t  const server = createMcpFnServer({\n   226\t    info: { name: secret, version: \"1.0.0\" },\n   227\t    registry: new McpFnRegistry().register({\n   228\t      name: \"visible-tool\", description: \"Fixture tool\", inputSchema: { type: \"object\" },\n   229\t      handler: async () => structuredResult({ ok: true }),\n   230\t    }),\n   231\t  });\n   232\t  const target = customTarget({\n   233\t    kind: \"custom\",\n   234\t    descriptor: { label: secret },\n   235\t    redact: <T>(value: T): T => {\n"},"started_at_ms":1789980237674,"completed_at_ms":1789980237675}}
{"timestamp":"2026-09-21T08:43:57.817Z","ordinal":5718,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0c322-dff9-79f2-a363-c1ac5a4a0251","call_id":"call_pcm1F5dQjTC1KRCXuJcBl0kz","output":[{"type":"input_text","text":"Script completed\nWall time 0.6 seconds\nOutput:\n"},{"type":"input_text","text":"     1\timport {\n     2\t  McpFnClientError,\n     3\t  customTarget,\n     4\t  streamableHttpTarget,\n     5\t  type McpFnStreamableHttpTargetOptions,\n     6\t  type McpFnTarget,\n     7\t  type McpFnTransportHandle,\n     8\t} from \"@mcpfn/client\";\n     9\t\n    10\timport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n    11\t\n    12\ttype SecretState = { active: Map<string, number>; scopes: Set<Set<string>> };\n    13\tconst targetSecrets = new WeakMap<McpFnTarget, SecretState>();\n    14\tconst utf8Encoder = new TextEncoder();\n    15\t\n    16\t/** Retain released credentials only for the lifetime of a report operation. */\n    17\texport function beginTargetCredentialRedaction(target: McpFnTarget): () => void {\n    18\t  const state = targetSecrets.get(target);\n    19\t  if (!state) return () => undefined;\n    20\t  const scope = new Set(state.active.keys());\n    21\t  state.scopes.add(scope);\n    22\t  return () => { state.scopes.delete(scope); scope.clear(); };\n    23\t}\n    24\t\n    25\tfunction credentialValues(headers: HeadersInit): Set<string> {\n    26\t  const values = boundedCredentialEntries(headers);\n    27\t  const secrets = new Set<string>();\n    28\t  for (const [header, raw] of values) {\n    29\t    if (!raw.trim()) continue;\n    30\t    secrets.add(raw);\n    31\t    secrets.add(raw.trim());\n    32\t    const normalizedHeader = header.toLowerCase();\n    33\t    if ([\"authorization\", \"proxy-authorization\"].includes(normalizedHeader)) {\n    34\t      addAuthorizationSecrets(raw, secrets);\n    35\t    }\n    36\t    if (normalizedHeader === \"cookie\") addCookieSecrets(raw, secrets);\n    37\t  }\n    38\t  return secrets;\n    39\t}\n    40\t\n    41\tfunction addAuthorizationSecrets(raw: string, secrets: Set<string>): void {\n    42\t  const trimmed = raw.trim();\n    43\t  const separator = trimmed.search(/\\s/);\n    44\t  if (separator <= 0) return;\n    45\t  const scheme = trimmed.slice(0, separator).toLowerCase();\n    46\t  const token = trimmed.slice(separator).trim();\n    47\t  if (token) secrets.add(token);\n    48\t  if (scheme !== \"basic\" || !/^[\\dA-Za-z+/]+={0,2}$/.test(token)) return;\n    49\t  const decoded = Buffer.from(token, \"base64\");\n    50\t  // Round-trip validation avoids interpreting malformed tokens as credentials.\n    51\t  if (stripBase64Padding(decoded.toString(\"base64\")) !== stripBase64Padding(token)) return;\n    52\t  for (const encoding of [\"utf8\", \"latin1\"] as const) {\n    53\t    const pair = decoded.toString(encoding);\n    54\t    const colon = pair.indexOf(\":\");\n    55\t    if (colon < 0) continue;\n    56\t    for (const value of [pair, pair.slice(0, colon), pair.slice(colon + 1)]) {\n    57\t      if (value) secrets.add(value);\n    58\t    }\n    59\t  }\n    60\t}\n    61\t\n    62\tfunction stripBase64Padding(value: string): string {\n    63\t  let end = value.length;\n    64\t  while (end > 0 && value[end - 1] === \"=\") end -= 1;\n    65\t  return value.slice(0, end);\n    66\t}\n    67\t\n    68\tfunction addCookieSecrets(raw: string, secrets: Set<string>): void {\n    69\t  // Cookie values are independently reflectable even though the request\n    70\t  // authenticates with the complete header. RFC 6265 cookie values cannot\n    71\t  // contain comma or semicolon, so both delimiters cover combined entries.\n    72\t  for (const part of raw.split(/[;,]/)) {\n    73\t    const pair = part.trim();\n    74\t    if (!pair) continue;\n    75\t    const equals = pair.indexOf(\"=\");\n    76\t    if (equals < 1) {\n    77\t      throw new TypeError(\"Cookie credential headers must contain name=value pairs\");\n    78\t    }\n    79\t    const value = pair.slice(equals + 1).trim();\n    80\t    if (!value) continue;\n    81\t    secrets.add(value);\n    82\t    addUnquotedCookieSecret(value, secrets);\n    83\t  }\n    84\t}\n    85\t\n    86\tfunction addUnquotedCookieSecret(value: string, secrets: Set<string>): void {\n    87\t  if (!value.startsWith('\"') && !value.endsWith('\"')) return;\n    88\t  if (value.length < 2 || !value.startsWith('\"') || !value.endsWith('\"')) {\n    89\t    throw new TypeError(\"Cookie credential values must use balanced quotes\");\n    90\t  }\n    91\t  const unquoted = value.slice(1, -1);\n    92\t  if (unquoted.includes('\"') || unquoted.includes(\"\\\\\")) {\n    93\t    throw new TypeError(\"Cookie credential values must use RFC 6265 syntax\");\n    94\t  }\n    95\t  if (unquoted) secrets.add(unquoted);\n    96\t}\n    97\t\n    98\texport class McpFnRedactionLimitError extends Error {\n    99\t  constructor(message = \"Credential redaction exceeded its traversal budget\") { super(message); }\n   100\t}\n   101\t\n   102\t/** No typed artifact can preserve this authored structure without exposing a credential. */\n   103\texport class McpFnStructuralCredentialCollisionError extends McpFnRedactionLimitError {\n   104\t  constructor() {\n   105\t    super(\"Credential collides with required artifact structure\");\n   106\t  }\n   107\t}\n   108\t\n   109\t// Only these locally authored envelope paths retain structural keys. Unknown\n   110\t// children (including inspector events and server metadata) are always payloads.\n   111\tconst envelopeKeys: Record<string, Set<string>> = Object.fromEntries(Object.entries({\n   112\t  root: \"formatVersion kind status runtime ok target server capabilities manifestChecked manifestHash total passed failed incomplete droppedResults droppedObservedEvents redactionOmittedObservedEvents incompleteReason failure timeline droppedTimelineEvents results count clientState tools resources resourceTemplates prompts droppedEvents timelineComplete droppedInventoryEntries inventoryComplete suiteVersion exitCode stdout stderr phase outcome code requestId at details payload\",\n   113\t  result: \"formatVersion name operation tool status sideEffect durationMs error droppedObservedEvents redactionOmittedObservedEvents\",\n   114\t  diagnostic: \"phase outcome code requestId at target details\",\n   115\t  inspectorEvent: \"formatVersion source kind at event\",\n   335\t  return result;\n   336\t}\n   337\t\n   338\tfunction assertPayloadSerialization(\n   339\t  value: unknown,\n   340\t  role: string,\n   341\t  finalPass: boolean,\n   342\t  credentialPattern: RegExp | undefined,\n   343\t): void {\n   344\t  if (!finalPass || role !== \"payload\" || !credentialPattern) return;\n   345\t  const serialized = JSON.stringify(value);\n   346\t  if (serialized !== undefined && credentialPattern.test(serialized)) {\n   347\t    throw new McpFnRedactionLimitError(\n   348\t      \"Credential redaction could not guarantee safe serialized output\",\n   349\t    );\n   350\t  }\n   351\t}\n   352\t\n   353\t/** Remove known opaque credential values as well as credential-shaped fields. */\n   354\texport function redactTargetCredentials<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean; redactionMarker?: string } = {}): T {\n   355\t  const state = targetSecrets.get(target);\n   356\t  return scrubCredentials(value, new Set([...(state?.active.keys() ?? []), ...[...(state?.scopes ?? [])].flatMap((scope) => [...scope])]), options.preserveKeys, options.redactionMarker);\n   357\t}\n   358\t\n   359\t/** Redact authenticated conformance output using the acquired credential. */\n   360\texport function redactRemoteCredential<T>(credential: McpFnRemoteCredential, value: T, options: { preserveKeys?: boolean } = {}): T {\n   361\t  return scrubCredentials(value, credentialValues(credential.headers), options.preserveKeys);\n   362\t}\n   363\t\n   364\tconst MAX_CREDENTIAL_HEADERS = 32;\n   365\tconst MAX_CREDENTIAL_HEADER_BYTES = 16_384;\n   366\tconst MAX_CREDENTIAL_HEADER_VALUE_BYTES = 8_192;\n   367\tconst FORBIDDEN_CREDENTIAL_HEADERS = new Set([\n   368\t  \"connection\",\n   369\t  \"content-length\",\n   370\t  \"host\",\n   371\t  \"proxy-connection\",\n   372\t  \"te\",\n   373\t  \"trailer\",\n   374\t  \"transfer-encoding\",\n   375\t  \"upgrade\",\n   376\t]);\n   377\t\n   378\texport type McpFnRemoteCredentialKind = \"api-key\" | \"oauth\" | \"custom\";\n   379\t\n   380\texport interface McpFnRemoteCredential {\n   381\t  /** Credential headers are applied only to the fixed target origin. */\n   382\t  headers: HeadersInit;\n   383\t  kind?: McpFnRemoteCredentialKind;\n   384\t  label?: string;\n   385\t}\n   386\t\n   387\texport interface McpFnRemoteCredentialContext {\n   388\t  url: string;\n   389\t  requestId: string;\n   390\t  signal?: AbortSignal;\n   391\t}\n   392\t\n   393\t/**\n   394\t * Application-owned credential lifecycle for external MCP targets. McpFn\n   395\t * acquires once per target open, revokes before disposal, and never serializes\n   396\t * the returned headers into descriptors or reports. If acquisition rejects, the\n   397\t * provider must roll back its own partial resources; no lease has been returned.\n   398\t */\n   399\texport interface McpFnRemoteCredentialProvider {\n   400\t  acquire(\n   401\t    context: McpFnRemoteCredentialContext,\n   402\t  ): McpFnRemoteCredential | Promise<McpFnRemoteCredential>;\n   403\t  revoke?(\n   404\t    credential: McpFnRemoteCredential,\n   405\t    context: McpFnRemoteCredentialContext,\n   406\t  ): void | Promise<void>;\n   407\t  dispose?(\n   408\t    credential: McpFnRemoteCredential,\n   409\t    context: McpFnRemoteCredentialContext,\n   410\t  ): void | Promise<void>;\n   411\t}\n   412\t\n   413\texport interface McpFnRemoteCredentialLease {\n   414\t  credential: McpFnRemoteCredential;\n   415\t  release(): Promise<void>;\n   416\t  /** The lifecycle stage that most recently prevented credential release. */\n   417\t  cleanupPhase(): \"token-revocation\" | \"transport-close\";\n   418\t}\n   419\t\n   420\texport interface McpFnAuthenticatedHttpTargetOptions\n   421\t  extends Omit<McpFnStreamableHttpTargetOptions, \"authProvider\" | \"requestInit\"> {\n   422\t  credential: McpFnRemoteCredential | McpFnRemoteCredentialProvider;\n   423\t  requestInit?: Omit<RequestInit, \"headers\" | \"redirect\"> & { headers?: HeadersInit };\n   424\t}\n   425\t\n   426\t/** Create a provider for an already-bounded API key or OAuth-derived token. */\n   427\texport function staticRemoteCredentialProvider(\n   428\t  credential: McpFnRemoteCredential,\n   429\t): McpFnRemoteCredentialProvider {\n   430\t  return { acquire: () => credential };\n   510\t  const pendingReleases = new Set<() => Promise<void>>();\n   511\t  const authenticated = customTarget({\n   512\t    kind: \"authenticated-streamable-http\",\n   513\t    descriptor: {\n   514\t      url: descriptorUrl.toString(),\n   515\t      authenticated: true,\n   516\t    },\n   517\t    redact: (value, redaction) => redactTargetCredentials(authenticated, value, { preserveKeys: true, ...redaction }),\n   518\t    async cleanup() {\n   519\t      const results = await Promise.allSettled([...pendingReleases].map(release => release()));\n   520\t      const failures = results.filter((result): result is PromiseRejectedResult => result.status === \"rejected\");\n   521\t      const failure = failures.find(({ reason }) => reason && typeof reason === \"object\" &&\n   522\t        (reason as { phase?: unknown }).phase === \"token-revocation\") ?? failures[0];\n   523\t      if (failure) throw failure.reason;\n   524\t    },\n   525\t    async open(targetContext): Promise<McpFnTransportHandle> {\n   526\t      const context: McpFnRemoteCredentialContext = {\n   527\t        url: targetUrl.toString(),\n   528\t        requestId: targetContext.requestId,\n   529\t        signal: targetContext.signal,\n   530\t      };\n   531\t      const lease = await acquireRemoteCredential(options.credential, context);\n   532\t      const secrets = new Set<string>();\n   533\t      const release = async () => {\n   534\t        try { await lease.release(); }\n   535\t        catch (error) { pendingReleases.add(release); throw error; }\n   536\t        pendingReleases.delete(release);\n   537\t        for (const secret of secrets) {\n   538\t          const count = (state.active.get(secret) ?? 1) - 1;\n   539\t          if (count) state.active.set(secret, count); else state.active.delete(secret);\n   540\t        }\n   541\t        secrets.clear();\n   542\t      };\n   543\t      let handle: McpFnTransportHandle | undefined;\n   544\t      try {\n   545\t        for (const secret of credentialValues(lease.credential.headers)) {\n   546\t          secrets.add(secret);\n   547\t          state.active.set(secret, (state.active.get(secret) ?? 0) + 1);\n   548\t          for (const scope of state.scopes) scope.add(secret);\n   549\t        }\n   550\t        const credentialHeaders = validateRemoteCredentialHeaders(lease.credential.headers);\n   551\t        const headers = new Headers(requestInit?.headers);\n   552\t        credentialHeaders.forEach((value, name) => headers.set(name, value));\n   553\t        const target = streamableHttpTarget(targetUrl, {\n   554\t          ...transportOptions,\n   555\t          requestInit: {\n   556\t            ...requestInit,\n   557\t            headers,\n   558\t            // Fetch must not replay credentials to a redirect destination.\n   559\t            redirect: \"error\",\n   560\t          },\n   561\t        });\n   562\t        handle = await target.open(targetContext);\n   563\t      } catch (error) {\n   564\t        // Sanitize while the lease still supplies its immutable header snapshot.\n   565\t        // Cleanup removes active secrets before the client emits failed-open diagnostics.\n   350\t});\n   351\t\n   352\tit(\"retains failed pre-handle releases for a cleanup retry\", async () => {\n   353\t  const revoke = vi.fn().mockRejectedValueOnce(new Error(\"temporary\")).mockResolvedValue(undefined);\n   354\t  const target = authenticatedHttpTarget(\"http://127.0.0.1:1/mcp\", { credential: {\n   355\t    acquire: () => ({ headers: undefined } as any), revoke,\n   356\t  } });\n   357\t  await expect(target.open({ requestId: \"invalid\", diagnostic: async () => {} })).rejects.toThrow(/cleanup failed/);\n   358\t  await target.cleanup!();\n   359\t  expect(revoke).toHaveBeenCalledTimes(2);\n   360\t});\n   361\tit(\"releases malformed credentials even when inspection fails\", async () => {\n   362\t  const revoke = vi.fn();\n   363\t  const target = authenticatedHttpTarget(\"http://127.0.0.1:1/mcp\", { credential: {\n   364\t    acquire: () => ({ headers: undefined } as any), revoke,\n   365\t  } });\n   366\t  await expect(target.open({ requestId: \"invalid\", diagnostic: async () => {} })).rejects.toThrow();\n   367\t  expect(revoke).toHaveBeenCalledOnce();\n   368\t});\n   369\t\n   370\tit(\"scrubs opaque credentials before generic redaction can truncate their suffix\", async () => {\n   371\t  const {redactRemoteCredential} = await import(\"../src/remote-target.js\");\n   372\t  const token = \"opaque-credential-unique-tail\";\n   373\t  const input = \"data=x \" + \"a\".repeat(262144 - 7 - 8) + token;\n   374\t  // Inputs beyond the explicit budget fail closed before any output is emitted.\n   375\t  expect(() => redactRemoteCredential({headers: {\"x-api-key\": token}}, input)).toThrow(/traversal budget/);\n   376\t});\n   377\tit(\"scrubs token components of custom authorization schemes\", async () => {\n   378\t  const {redactRemoteCredential} = await import(\"../src/remote-target.js\");\n   379\t  expect(redactRemoteCredential({headers: {authorization: \"Token opaque-123\"}}, {echo: \"opaque-123\"})).toEqual({echo: \"[REDACTED]\"});\n   380\t});\n   381\t\n   382\t\n   383\tit(\"retains successful-open leases until revocation succeeds\", async () => {\n   384\t  const revoke = vi.fn().mockRejectedValueOnce(new Error('temporary')).mockResolvedValue(undefined);\n   385\t  const target = authenticatedHttpTarget('http://127.0.0.1:1/mcp', { credential: { acquire: () => ({ headers: { 'x-api-key': 'opaque-key' } }), revoke } });\n   386\t  const handle = await target.open({ requestId: 'lease', diagnostic: async () => {} });\n   387\t  await expect(handle.close!()).rejects.toThrow(/cleanup/);\n   388\t  await target.cleanup!();\n   389\t  expect(revoke).toHaveBeenCalledTimes(2);\n   390\t});\n   391\t\n   392\tit(\"rejects credentials that collide with fixed report values\", async () => {\n   393\t  const { redactRemoteCredential, McpFnRedactionLimitError } = await import('../src/remote-target.js');\n   394\t  for (const secret of ['none', 'http', '0.0.5']) {\n   395\t    const report = { kind: 'mcpfn.target-suite-report', target: { kind: 'authenticated-streamable-http' }, runtime: { packages: { testing: '0.0.5' } }, results: [{ sideEffect: 'none', name: secret }] };\n   396\t    expect(() => redactRemoteCredential(\n   397\t      { headers: { 'x-api-key': secret } },\n   398\t      report,\n   399\t      { preserveKeys: true },\n   400\t    )).toThrow(McpFnRedactionLimitError);\n   890\t    await Promise.all([handle.close!(), handle.close!()]);\n   891\t    expect(close).toHaveBeenCalledOnce();\n   892\t    expect(revoke).toHaveBeenCalledTimes(stage === \"revoke\" ? 2 : 1);\n   893\t    expect(dispose).toHaveBeenCalledTimes(stage === \"dispose\" ? 2 : 1);\n   894\t  } finally { await fixture.close(); }\n   895\t});\n   896\t\n   897\t\n   898\tit.each([\"***\", \"[REDACTED]\", \"#\"])(\"never emits another credential as a generated mask (%s)\", async mask => {\n   899\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   900\t  const credentials = { headers: { \"x-api-key\": \"abc\", \"x-secondary-key\": mask } };\n   901\t  const redacted = redactRemoteCredential(credentials, { value: \"abc\", other: mask });\n   902\t  expect(JSON.stringify(redacted)).not.toContain(\"abc\");\n   903\t  expect(JSON.stringify(redacted)).not.toContain(mask);\n   904\t});\n   905\t\n   906\tit.each([\"foo name\", \"Bearer name\", \"Basic name\"])(\"keeps an opaque API key whole during extraction (%s)\", async secret => {\n   907\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   908\t  const redacted = redactRemoteCredential({ headers: { \"x-api-key\": secret } }, { name: \"name\", echoed: secret });\n   909\t  expect(redacted.name).toBe(\"name\");\n   910\t  expect(JSON.stringify(redacted)).not.toContain(secret);\n   911\t});\n   912\t\n   913\tit.each([\"authorization\", \"Authorization\", \"proxy-authorization\"])(\"extracts recognized bearer credentials from %s\", async header => {\n   914\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   915\t  expect(redactRemoteCredential({ headers: { [header]: \"bEaReR tokenvalue\" } }, { reflected: \"tokenvalue\" }).reflected).not.toBe(\"tokenvalue\");\n   916\t});\n   917\t\n   918\tit(\"extracts independently reflectable Cookie credential values\", async () => {\n   919\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   920\t  const redacted = redactRemoteCredential(\n   921\t    { headers: { Cookie: 'session=opaque-cookie; quoted=\"quoted-cookie\"' } },\n   922\t    { session: \"opaque-cookie\", quoted: \"quoted-cookie\" },\n   923\t  );\n   924\t  expect(JSON.stringify(redacted)).not.toContain(\"opaque-cookie\");\n   925\t  expect(JSON.stringify(redacted)).not.toContain(\"quoted-cookie\");\n   926\t});\n   927\t\n   928\tit.each([\"missing-pair\", 'session=\"unterminated'])(\"rejects ambiguous Cookie credential syntax (%s)\", async cookie => {\n   929\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   930\t  expect(() => redactRemoteCredential({ headers: { Cookie: cookie } }, { value: \"safe\" }))\n   931\t    .toThrow(/Cookie credential/);\n   932\t});\n   933\t\n   934\t\n   935\tit.each([\n   936\t  { name: \"adjacent masks\", secrets: [\"a\", \"b\", \"**\"], input: \"ab\" },\n   937\t  { name: \"deletion joins surrounding text\", secrets: [\"abc\", \"***\", \"xy\"], input: \"xabcy\" },\n   938\t  { name: \"mask joins existing text\", secrets: [\"abc\", \"***x\"], input: \"abcx\" },\n   939\t])(\"checks the final output for $name\", async ({ secrets, input }) => {\n   940\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   941\t  const headers = Object.fromEntries(secrets.map((secret, index) => [`x-secret-${index}`, secret]));\n   942\t  const output = redactRemoteCredential({ headers }, { [input]: input });\n   943\t  for (const [key, value] of Object.entries(output)) {\n   944\t    for (const secret of secrets) {\n   945\t      expect(key).not.toContain(secret);\n   380\tconst suiteStructureValues = [\n   381\t  \"mcpfn.target-suite-report\", \"complete\", \"incomplete\", \"passed\", \"failed\",\n   382\t  \"started\", \"succeeded\", \"none\", \"idempotent\", \"non-idempotent\",\n   383\t  \"mcpfn-preflight\", \"authorization-server\", \"resource-server\", \"mcp-initialization\",\n   384\t  \"scenario\", \"upstream-conformance\", \"resource-discovery\",\n   385\t  \"authorization-server-discovery\", \"client-registration\", \"authorization-request\",\n   386\t  \"authorization-callback\", \"token-exchange\", \"token-refresh\", \"token-revocation\",\n   387\t  \"transport-connect\", \"mcp-initialize\", \"capability-operation\", \"transport-close\",\n   388\t  \"authenticated-streamable-http\", \"streamable-http\", \"stdio\", \"in-memory\", \"custom\",\n   389\t] as const;\n   390\t\n   391\tinterface SuiteStructureGuard {\n   392\t  assert(value: string): void;\n   393\t}\n   394\t\n   395\tfunction captureSuiteStructureGuard(\n   396\t  target: McpFnTarget,\n   397\t  projection: SuiteProjection,\n   398\t  diagnostics: SuiteDiagnosticCollector,\n   399\t): SuiteStructureGuard {\n   400\t  const candidates = new Set<string>([\n   401\t    ...suiteStructureKeys,\n   402\t    ...suiteStructureValues,\n   403\t    process.version,\n   404\t    MCPFN_REPORT_SCHEMA_VERSION,\n   405\t    MCPFN_TESTING_VERSION,\n   406\t    projection.target.kind,\n   407\t  ]);\n   408\t  for (const result of projection.execution.results) {\n   409\t    candidates.add(result.status);\n   410\t    if (result.sideEffect) candidates.add(result.sideEffect);\n   411\t  }\n   412\t  for (const event of diagnostics.timeline) {\n   413\t    candidates.add(event.phase);\n   414\t    candidates.add(event.outcome);\n   415\t    if (event.target?.kind) candidates.add(event.target.kind);\n   416\t  }\n   417\t  const safe = new Set<string>();\n   418\t  for (const candidate of candidates) {\n   419\t    try {\n   420\t      if (redactSuiteArtifact(target, candidate, { preserveKeys: false }) === candidate) {\n   421\t        safe.add(candidate);\n   422\t      }\n   423\t    } catch {\n   424\t      // If the live custom scrubber cannot classify a string, fail closed only\n   425\t      // when the final report actually needs that unproven structure.\n   426\t    }\n   427\t  }\n   428\t  return {\n   429\t    assert(value: string): void {\n   430\t      if (!safe.has(value)) throw new McpFnStructuralCredentialCollisionError();\n   431\t    },\n   432\t  };\n   433\t}\n   434\t\n   435\tfunction assertStructureKeys(value: object, guard: SuiteStructureGuard): void {\n   436\t  for (const key of Object.keys(value)) guard.assert(key);\n   437\t}\n   438\t\n   439\tfunction assertTargetStructure(\n   440\t  target: McpFnTargetDescriptor,\n   441\t  guard: SuiteStructureGuard,\n   442\t): void {\n   443\t  guard.assert(\"kind\");\n   444\t  guard.assert(target.kind);\n   445\t}\n   446\t\n   447\tfunction assertSuiteReportStructure(\n   448\t  report: McpFnTargetSuiteReport,\n   449\t  guard: SuiteStructureGuard,\n   450\t): void {\n   451\t  assertStructureKeys(report, guard);\n   452\t  guard.assert(report.kind);\n   453\t  guard.assert(report.status);\n   454\t  assertStructureKeys(report.runtime, guard);\n   455\t  guard.assert(report.runtime.node);\n   456\t  guard.assert(report.runtime.reportSchemaVersion);\n   457\t  assertStructureKeys(report.runtime.packages, guard);\n   458\t  guard.assert(report.runtime.packages.testing);\n   459\t  assertTargetStructure(report.target, guard);\n   460\t  if (report.failure) {\n   461\t    assertStructureKeys(report.failure, guard);\n   462\t    guard.assert(report.failure.layer);\n   463\t    if (report.failure.phase) guard.assert(report.failure.phase);\n   464\t  }\n   465\t  for (const event of report.timeline) {\n   466\t    assertStructureKeys(event, guard);\n   467\t    guard.assert(event.phase);\n   468\t    guard.assert(event.outcome);\n   469\t    if (event.target) assertTargetStructure(event.target, guard);\n   470\t  }\n   471\t  for (const result of report.results) {\n   472\t    assertStructureKeys(result, guard);\n   473\t    guard.assert(result.status);\n   474\t    if (result.sideEffect) guard.assert(result.sideEffect);\n   475\t  }\n   535\t    diagnostics.captureBaseline(client);\n   536\t    await client.session.connect();\n   537\t    ({ execution, manifestChecked } = await executeConnectedSuite(client, options));\n   538\t  } catch (error) {\n   539\t    failure = safeTargetFailure(options.target, error);\n   540\t  }\n   541\t  return { client, manifestChecked, failure, execution };\n   542\t}\n   543\t\n   544\tasync function projectAndCloseSuite(\n   545\t  options: RunMcpFnTargetSuiteOptions,\n   546\t  diagnostics: SuiteDiagnosticCollector,\n   547\t  connection: SuiteConnection,\n   548\t): Promise<{\n   549\t  projection: SuiteProjection;\n   550\t  structureGuard: SuiteStructureGuard;\n   551\t  closeResult: Awaited<ReturnType<typeof closeSuiteClient>>;\n   552\t}> {\n   553\t  let projection: SuiteProjection = {\n   554\t    target: { kind: \"custom\" },\n   555\t    execution: connection.execution,\n   556\t    failure: \"serialization\",\n   557\t  };\n   558\t  let structureGuard: SuiteStructureGuard = {\n   559\t    assert: () => { throw new McpFnStructuralCredentialCollisionError(); },\n   560\t  };\n   561\t  let closeResult: Awaited<ReturnType<typeof closeSuiteClient>> = {};\n   562\t  try {\n   563\t    projection = projectSuiteArtifacts(options, connection.client, connection.execution);\n   564\t    structureGuard = captureSuiteStructureGuard(options.target, projection, diagnostics);\n   565\t  } finally {\n   566\t    closeResult = await closeSuiteClient(connection.client);\n   567\t  }\n   568\t  return { projection, structureGuard, closeResult };\n   569\t}\n   570\t\n   571\tfunction suiteIncompleteReasons(\n   572\t  failure: McpFnReportFailure | undefined,\n   573\t  cleanupFailure: McpFnReportFailure | undefined,\n   574\t  diagnostics: SuiteDiagnosticCollector,\n   575\t  redactionOmittedObservedEvents: number,\n   180\t  expect(report.incompleteReason).toContain(\"Target cleanup failed\");\n   181\t  expect(JSON.stringify(report)).not.toContain(\"opaque-cleanup-value\");\n   182\t});\n   183\t\n   184\t\n   185\tit.each([\"x\", \"€\"])(\"bounds long target failures under the minimum report cap: %s\", async character => {\n   186\t  const { customTarget } = await import('@mcpfn/client');\n   187\t  const report = await runMcpFnTargetSuite({ target: customTarget({ kind: 'failure', open: async () => { throw new Error(character.repeat(4000)); } }), maxReportBytes: 1024 });\n   188\t  expect(report.status).toBe('incomplete');\n   189\t  expect(Buffer.byteLength(JSON.stringify(report, null, 2))).toBeLessThanOrEqual(1024);\n   190\t});\n   191\t\n   192\tit(\"retains a complete report when only its compact encoding fits\", async () => {\n   193\t  const run = async (maxReportBytes?: number) => {\n   194\t    const server = createMcpFnServer({ info: { name: \"compact\", version: \"1\" }, registry: new McpFnRegistry().register({ name: \"echo\", description: \"Echo\", inputSchema: { type: \"object\" }, handler: async input => structuredResult(input) }) });\n   195\t    return runMcpFnTargetSuite({ maxReportBytes, target: customTarget({ kind: \"compact\", open: async () => {\n   196\t      const [transport, peer] = InMemoryTransport.createLinkedPair();\n   197\t      await server.connect(peer);\n   198\t      return { transport, close: () => server.close() };\n   199\t    } }), scenarios: Array.from({ length: 5 }, (_, i) => ({ name: `echo-${i}`, tool: \"echo\", arguments: { value: \"ok\" }, expect: { structuredContent: { value: \"ok\" } } })) });\n   200\t  };\n   201\t  const full = await run();\n   202\t  const cap = Math.max(1024, new TextEncoder().encode(JSON.stringify(full)).byteLength + 128);\n   203\t  expect(cap).toBeLessThan(new TextEncoder().encode(JSON.stringify(full, null, 2)).byteLength);\n   204\t  const bounded = await run(cap);\n   205\t  expect(bounded.ok).toBe(true);\n   206\t  expect(bounded.droppedResults).toBe(0);\n   207\t  expect(new TextEncoder().encode(JSON.stringify(bounded)).byteLength).toBeLessThanOrEqual(cap);\n   208\t});\n   209\t\n   210\tit(\"does not repeat successful custom cleanup after an open failure\", async () => {\n   211\t  const cleanup = vi.fn(async () => {\n   212\t    if (cleanup.mock.calls.length > 1) throw new Error(\"cleanup repeated\");\n   213\t  });\n   214\t  const report = await runMcpFnTargetSuite({ target: customTarget({\n   215\t    kind: \"failed-open\", open: async () => { throw new Error(\"cannot open\"); }, cleanup,\n   216\t  }) });\n   217\t  expect(report.ok).toBe(false);\n   218\t  expect(cleanup).toHaveBeenCalledOnce();\n   219\t  expect(report.incompleteReason).not.toContain(\"Target cleanup failed\");\n   220\t});\n   221\t\n   222\t\n   223\tit.each([\"metadata\", \"failure\"])(\"applies custom target redaction to finalized suite %s\", async mode => {\n   224\t  const secret = \"custom-owned-secret\";\n   225\t  const server = createMcpFnServer({\n   226\t    info: { name: secret, version: \"1.0.0\" },\n   227\t    registry: new McpFnRegistry().register({\n   228\t      name: \"visible-tool\", description: \"Fixture tool\", inputSchema: { type: \"object\" },\n   229\t      handler: async () => structuredResult({ ok: true }),\n   230\t    }),\n   231\t  });\n   232\t  const target = customTarget({\n   233\t    kind: \"custom\",\n   234\t    descriptor: { label: secret },\n   235\t    redact: <T>(value: T): T => {\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0c31e-6a96-7383-bda9-a191f2448a61","create_time":1789980237.817443}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
