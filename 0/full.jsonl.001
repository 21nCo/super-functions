ber } }\n  | { kind: \"resources.read\"; uri: string }\n  | { kind: \"resources.subscribe\"; uri: string }\n  | { kind: \"resources.unsubscribe\"; uri: string }\n  | { kind: \"prompts.get\"; name: string; arguments?: Record<string, string> }\n  | { kind: \"tasks.get\"; taskId: string }\n  | { kind: \"tasks.result\"; taskId: string }\n  | { kind: \"tasks.cancel\"; taskId: string }\n  | { kind: \"tasks.list\"; cursor?: string };\n\nexport type McpFnInspectorOperationResult =\n  | CallToolResult\n  | CreateTaskResult\n  | ReadResourceResult\n  | GetPromptResult\n  | Task\n  | ListTasksResult\n  | void;\n\nexport type McpFnExportedScenario = McpFnScenario;\n\n/** Headless inspector; graphical shells and the CLI consume this same engine. */\nexport class McpFnInspector {\n  private readonly events: McpFnInspectorTimelineEvent[] = [];\n  private readonly unsubscribes: Array<() => void>;\n  private readonly maxEvents: number;\n  private readonly maxTimelineBytes: number;\n  private readonly maxInventoryEntries: number;\n  private readonly initialRedactionOmissions: number;\n  private observedRedactionOmissions = 0;\n  private timelineBytes = 0;\n  private droppedEvents = 0;\n\n  constructor(readonly client: McpFnClient, limits: McpFnInspectorLimits = {}) {\n    this.maxEvents = validateLimit(limits.maxEvents ?? 500, \"maxEvents\");\n    this.maxTimelineBytes = validateLimit(\n      limits.maxTimelineBytes ?? 524_288,\n      \"maxTimelineBytes\",\n    );\n    this.maxInventoryEntries = validateLimit(\n      limits.maxInventoryEntries ?? 500,\n      \"maxInventoryEntries\",\n    );\n    const omissions = client.getRedactionOmissionCounts();\n    this.initialRedactionOmissions = omissions.clientEvents + omissions.diagnostics;\n    this.unsubscribes = [\n      client.onDiagnostic((event) => this.record(\"diagnostic\", event.phase, event.at, event)),\n      client.onEvent((event) => this.record(\"client\", event.kind, event.at, event)),\n    ];\n  }\n\n  static create(\n    options: McpFnClientOptions & { inspector?: McpFnInspectorLimits },\n  ): McpFnInspector {\n    const { inspector, ...clientOptions } = options;\n    return new McpFnInspector(new McpFnClient(clientOptions), inspector);\n  }\n\n  async connect(): Promise<this> {\n    await this.client.connect();\n    return this;\n  }\n\n  async snapshot(): Promise<McpFnInspectorSnapshot> {\n    const capabilities = this.client.getServerCapabilities();\n    const emptyInventory = { items: [], droppedItems: 0, complete: true };\n    const [tools, resources, resourceTemplates, prompts] = await Promise.all([\n      capabilities?.tools\n        ? this.client.tools.listBounded(this.maxInventoryEntries)\n        : Promise.resolve(emptyInventory),\n      capabilities?.resources\n        ? this.client.resources.listBounded(this.maxInventoryEntries)\n        : Promise.resolve(emptyInventory),\n      capabilities?.resources\n        ? this.client.resources.listTemplatesBounded(this.maxInventoryEntries)\n        : Promise.resolve(emptyInventory),\n      capabilities?.prompts\n        ? this.client.prompts.listBounded(this.maxInventoryEntries)\n        : Promise.resolve(emptyInventory),\n    ]);\n    const droppedInventoryEntries = {\n      tools: tools.droppedItems,\n      resources: resources.droppedItems,\n      resourceTemplates: resourceTemplates.droppedItems,\n      prompts: prompts.droppedItems,\n    };\n    const inventoryComplete = Object.values(droppedInventoryEntries)\n      .every((count) => count === 0);\n    const omissions = this.client.getRedactionOmissionCounts();\n    const unobservedRedactionOmissions = Math.max(\n      0,\n      omissions.clientEvents + omissions.diagnostics -\n        this.initialRedactionOmissions - this.observedRedactionOmissions,\n    );\n    const droppedEvents = this.droppedEvents + unobservedRedactionOmissions;\n    const redaction = {\n      maxArrayEntries: Math.max(this.maxEvents, this.maxInventoryEntries, 1),\n      preserveKeys: false,\n    } as const;\n    const { kind, ...descriptor } = this.client.getTargetDescriptor();\n    const server = this.client.getServerVersion();\n    const snapshotKind = this.client.preserveArtifactStructure(\"mcpfn.inspector-snapshot\");\n    const targetKind = this.client.preserveArtifactStructure(kind);\n    const clientState = this.client.preserveArtifactStructure(this.client.state);\n    // Custom hooks receive payloads only; reconstruct authored discriminators.\n    return {\n      formatVersion: 2,\n      kind: snapshotKind,\n      target: { ...this.client.redact(descriptor, redaction), kind: targetKind },\n      clientState,\n      server: server === undefined ? undefined : this.client.redact(server, redaction),\n      capabilities: capabilities === undefined ? undefined : this.client.redact(capabilities, redaction),\n      tools: this.client.redact(tools.items, redaction),\n      resources: this.client.redact(resources.items, redaction),\n      resourceTemplates: this.client.redact(resourceTemplates.items, redaction),\n      prompts: this.client.redact(prompts.items, redaction),\n      // Stored events already passed through the client hook; never reapply it.\n      timeline: structuredClone(this.events),\n      droppedEvents,\n      timelineComplete: droppedEvents === 0,\n      droppedInventoryEntries,\n      inventoryComplete,\n    };\n  }\n\n  async run(operation: McpFnInspectorOperation): Promise<McpFnInspectorOperationResult> {\n    if (operation.kind === \"tools.call\") {\n      return this.client.tools.call(operation.name, operation.arguments);\n    }\n    if (operation.kind === \"tools.call:task\") {\n      return this.client.tools.createTask(operation.name, operation.arguments, operation.task);\n    }\n    if (operation.kind === \"resources.read\") {\n      return this.client.resources.read(operation.uri);\n    }\n    if (operation.kind === \"resources.subscribe\") {\n      return this.client.resources.subscribe(operation.uri);\n    }\n    if (operation.kind === \"resources.unsubscribe\") {\n      return this.client.resources.unsubscribe(operation.uri);\n    }\n    if (operation.kind === \"prompts.get\") {\n      return this.client.prompts.get(operation.name, operation.arguments);\n    }\n    if (operation.kind === \"tasks.get\") return this.client.tasks.get(operation.taskId);\n    if (operation.kind === \"tasks.result\") return this.client.tasks.result(operation.taskId);\n    if (operation.kind === \"tasks.cancel\") return this.client.tasks.cancel(operation.taskId);\n    return this.client.tasks.list(operation.cursor);\n  }\n\n  exportScenario(\n    name: string,\n    operation: McpFnInspectorOperation,\n    result: McpFnInspectorOperationResult,\n  ): McpFnExportedScenario {\n    const scenario = createMcpFnScenario(name, operation, result);\n    diagnostics,\n    redactionOmittedObservedEvents,\n    overflowedObservedEvents,\n  );\n  return {\n    formatVersion: 1,\n    kind: \"mcpfn.target-suite-report\",\n    status: artifactIncomplete ? \"incomplete\" : \"complete\",\n    runtime: {\n      node: process.version,\n      scenarioFormatVersion: 1,\n      reportSchemaVersion: MCPFN_REPORT_SCHEMA_VERSION,\n      packages: { testing: MCPFN_TESTING_VERSION },\n    },\n    ok: failed === 0 && !artifactIncomplete,\n    target: projection.target,\n    server: projection.execution.server,\n    capabilities: projection.execution.capabilities,\n    manifestChecked,\n    ...(projection.manifestHash === undefined ? {} : { manifestHash: projection.manifestHash }),\n    total: results.length,\n    passed: results.length - failed - incomplete,\n    failed,\n    incomplete,\n    droppedResults: 0,\n    droppedObservedEvents,\n    ...(redactionOmittedObservedEvents > 0 ? { redactionOmittedObservedEvents } : {}),\n    ...(incompleteReason ? { incompleteReason } : {}),\n    ...(failure ? { failure } : {}),\n    timeline: diagnostics.timeline,\n    droppedTimelineEvents: diagnostics.dropped,\n    results,\n  };\n}\n\nfunction structuralReportFailure(retainedCleanup: (() => Promise<void>) | undefined): never {\n  const failure = new McpFnClientError(\n    \"MCPFN_OPERATION_FAILED\",\n    \"Target report cannot be serialized because a credential conflicts with required artifact structure\",\n    { phase: \"capability-operation\" },\n  );\n  if (retainedCleanup) {\n    throw new McpFnTargetSuiteArtifactCleanupError(retainedCleanup, failure);\n  }\n  throw failure;\n}\n\nfunction boundedSuiteReport(\n  report: McpFnTargetSuiteReport,\n  guard: SuiteStructureGuard,\n  maxReportBytes: number,\n): McpFnTargetSuiteReport {\n  const bounded = enforceReportCap(report, maxReportBytes);\n  assertSuiteReportStructure(bounded, guard);\n  return bounded;\n}\n\nfunction finalizeSuiteReport(\n  options: RunMcpFnTargetSuiteOptions,\n  projection: SuiteProjection,\n  report: McpFnTargetSuiteReport,\n  guard: SuiteStructureGuard,\n  maxReportBytes: number,\n  retainedCleanup: (() => Promise<void>) | undefined,\n): McpFnTargetSuiteReport {\n  let finalized: McpFnTargetSuiteReport;\n  try {\n    if (projection.failure) throw new Error(\"Report payload projection failed\");\n    assertSuiteReportStructure(report, guard);\n    // Custom redaction already completed before cleanup. Built-in report scopes\n    // remain active here for bounded final serialization.\n    finalized = boundedSuiteReport(\n      redactTargetCredentials(options.target, report, { preserveKeys: true }),\n      guard,\n      maxReportBytes,\n    );\n  } catch (error) {\n    if (error instanceof McpFnStructuralCredentialCollisionError) {\n      return structuralReportFailure(retainedCleanup);\n    }\n    const fallback = {\n      ...report,\n      ok: false,\n      status: \"incomplete\" as const,\n      incompleteReason: reportProjectionFailureReason(error, projection.failure),\n      target: { kind: \"custom\" as const },\n      server: undefined,\n      capabilities: undefined,\n      manifestHash: undefined,\n      failure: undefined,\n      results: [],\n      timeline: [],\n      droppedResults: report.results.length,\n      droppedTimelineEvents: report.droppedTimelineEvents + report.timeline.length,\n    };\n    try {\n      finalized = boundedSuiteReport(fallback, guard, maxReportBytes);\n    } catch (fallbackError) {\n      if (fallbackError instanceof McpFnStructuralCredentialCollisionError) {\n        return structuralReportFailure(retainedCleanup);\n      }\n      throw fallbackError;\n    }\n  }\n  if (retainedCleanup) throw new McpFnTargetSuiteCleanupError(finalized, retainedCleanup);\n  return finalized;\n}\n\nasync function runTargetSuite(options: RunMcpFnTargetSuiteOptions): Promise<McpFnTargetSuiteReport> {\n  const maxTimelineEvents = options.maxTimelineEvents ?? 500;\n  if (!Number.isInteger(maxTimelineEvents) || maxTimelineEvents < 1) {\n    throw new Error(\"maxTimelineEvents must be a positive integer\");\n  }\n  const maxReportBytes = options.maxReportBytes ?? 1_048_576;\n  validateReportCap(maxReportBytes);\n  const consumerDiagnostic = options.client?.diagnostics;\n  const diagnostics = new SuiteDiagnosticCollector(\n    maxTimelineEvents,\n    maxReportBytes,\n    options.target,\n    consumerDiagnostic,\n  );\n  const connection = await connectSuite(options, diagnostics);\n  // Custom hooks may depend on credentials cleared by close. Capture payload\n  // projection and structural safety while the session still owns that state,\n  // but never let either operation bypass the sole cleanup boundary.\n  const { projection, structureGuard, closeResult } = await projectAndCloseSuite(\n    options,\n    diagnostics,\n    connection,\n  );\n  const { cleanupFailure: closeFailure, retainedCleanup } = closeResult;\n  diagnostics.captureUnobserved(connection.client);\n  let cleanupFailure = closeFailure;\n  cleanupFailure ??= diagnostics.cleanupFailure;\n  const failure = connection.failure ?? cleanupFailure;\n  const report = buildSuiteReport(\n    projection,\n    connection.manifestChecked,\n    failure,\n    cleanupFailure,\n#!/usr/bin/env node\n\nimport assert from \"node:assert/strict\";\nimport { request as httpRequest } from \"node:http\";\nimport { spawn, spawnSync } from \"node:child_process\";\nimport { mkdir, mkdtemp, readFile, rm } from \"node:fs/promises\";\nimport { tmpdir } from \"node:os\";\nimport path from \"node:path\";\nimport readline from \"node:readline\";\nimport { fileURLToPath } from \"node:url\";\n\nconst repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst serverSource = path.join(repoRoot, \"mcpfn/examples/external-http-server.mjs\");\nconst scenarioSource = path.join(repoRoot, \"mcpfn/examples/external-scenarios.mjs\");\nconst cli = path.join(repoRoot, \"mcpfn/cli/dist/bin.js\");\nconst configuredOutputRoot = process.env.MCPFN_ARTIFACT_DIR;\nconst outputRoot = configuredOutputRoot\n  ? path.resolve(repoRoot, configuredOutputRoot)\n  : await mkdtemp(path.join(tmpdir(), \"mcpfn-external-\"));\nawait mkdir(outputRoot, { recursive: true });\nconst jsonReport = path.join(outputRoot, \"report.json\");\nconst junitReport = path.join(outputRoot, \"report.xml\");\nconst apiKey = \"mcpfn-external-fixture-secret\";\nconst serverText = await readFile(serverSource, \"utf8\");\nassert.doesNotMatch(serverText, /from\\s+[\"']@mcpfn\\//);\n\nconst server = spawn(process.execPath, [serverSource], {\n  cwd: repoRoot,\n  env: { ...process.env, MCPFN_EXTERNAL_API_KEY: apiKey },\n  stdio: [\"ignore\", \"pipe\", \"pipe\"],\n});\nlet serverStderr = \"\";\nserver.stderr.setEncoding(\"utf8\");\nserver.stderr.on(\"data\", (chunk) => { serverStderr += chunk; });\n\ntry {\n  const url = await waitForUrl(server, () => serverStderr);\n  await expectHttpStatus(url, { headers: { host: \"[invalid\" } }, 400);\n  await expectHttpStatus(new URL(\"/not-found\", url), {}, 404);\n  const authenticated = spawnSync(process.execPath, [\n    cli,\n    \"test-target\",\n    url,\n    scenarioSource,\n    \"--api-key-env\",\n    \"MCPFN_EXTERNAL_API_KEY\",\n    \"--output\",\n    jsonReport,\n    \"--junit\",\n    junitReport,\n    \"--max-report-bytes\",\n    \"1048576\",\n  ], {\n    cwd: repoRoot,\n    env: { ...process.env, MCPFN_EXTERNAL_API_KEY: apiKey },\n    encoding: \"utf8\",\n    stdio: \"pipe\",\n    timeout: 20_000,\n  });\n  assert.equal(\n    authenticated.status,\n    0,\n    `Authenticated external fixture failed\\n${authenticated.stdout}\\n${authenticated.stderr}`,\n  );\n  const report = JSON.parse(await readFile(jsonReport, \"utf8\"));\n  assert.equal(report.ok, true);\n  assert.equal(report.passed, 2);\n  assert.equal(report.target.kind, \"authenticated-streamable-http\");\n  const junit = await readFile(junitReport, \"utf8\");\n  assert.match(junit, /testsuite/);\n  assert.doesNotMatch(junit, new RegExp(apiKey));\n\n  const unauthenticated = spawnSync(process.execPath, [\n    cli,\n    \"test-target\",\n    url,\n    scenarioSource,\n  ], {\n    cwd: repoRoot,\n    encoding: \"utf8\",\n    stdio: \"pipe\",\n    timeout: 20_000,\n  });\n  assert.equal(\n    unauthenticated.status,\n    1,\n    `Unauthenticated fixture must fail with runtime exit 1, got ${unauthenticated.status}\\n${unauthenticated.stdout}\\n${unauthenticated.stderr}`,\n  );\n  assert.equal(unauthenticated.error, undefined);\n  const unauthenticatedReport = JSON.parse(unauthenticated.stdout);\n  assert.equal(unauthenticatedReport.kind, \"mcpfn.target-suite-report\");\n  assert.equal(unauthenticatedReport.ok, false);\n  assert.ok(unauthenticatedReport.failure);\n\n  // Send only headers, deliberately withholding the body. A handler that\n  // waits for body consumption before authenticating will time out here.\n  await new Promise((resolve, reject) => {\n    const request = httpRequest(url, { method: \"POST\", headers: {\n      \"content-type\": \"application/json\", \"content-length\": \"1048577\",\n    } }, (response) => {\n      try { assert.equal(response.statusCode, 401); resolve(); }\n      catch (error) { reject(error); }\n      finally { request.destroy(); }\n    });\n    request.setTimeout(10_000, () => request.destroy(new Error(\"Unauthorized body preflight timed out\")));\n    request.once(\"error\", reject);\n    request.flushHeaders();\n  });\n\n  process.stdout.write(`${JSON.stringify({\n    ok: true,\n    fixture: \"official-sdk-only\",\n    authenticatedScenarios: report.passed,\n    unauthenticatedExitCode: unauthenticated.status,\n    artifacts: [\"json\", \"junit\"],\n  })}\\n`);\n} finally {\n  await stop(server);\n  if (!configuredOutputRoot) {\n    await rm(outputRoot, { recursive: true, force: true });\n  }\n}\n\nfunction waitForUrl(child, readStderr) {\n  return new Promise((resolve, reject) => {\n    const lines = readline.createInterface({ input: child.stdout });\n    const settle = (error, url) => {\n      clearTimeout(timer);\n      lines.close();\n      child.off(\"error\", onError);\n      child.off(\"exit\", onExit);\n      if (error) reject(error); else resolve(url);\n    };\n    const onError = (error) => settle(error);\n    const onExit = (code) => settle(new Error(`External MCP fixture exited with ${code}\\n${readStderr()}`));\n    const timer = setTimeout(() => settle(new Error(`External MCP fixture did not start\\n${readStderr()}`)), 10_000);\n    lines.once(\"line\", (line) => settle(undefined, line.trim()));\n    child.once(\"error\", onError);\n    child.once(\"exit\", onExit);\n  });\n}\n\nfunction expectHttpStatus(url, options, expected) {\n  return new Promise((resolve, reject) => {\n    const request = httpRequest(url, options, (response) => {\n      response.resume();\n      response.once(\"end\", () => {\n        try {\n          assert.equal(response.statusCode, expected);\n          resolve();\n        } catch (error) {\n          reject(error);\n        }\n      });\n    });\n    request.setTimeout(10_000, () => request.destroy(new Error(\"HTTP fixture probe timed out\")));\n    request.once(\"error\", reject);\n    request.end();\n  });\n}\n\nasync function stop(child) {\n  if (child.exitCode !== null || child.signalCode !== null) return;\n  const exited = new Promise((resolve) => child.once(\"exit\", resolve));\n  child.kill(\"SIGTERM\");\n  let timer;\n  const timeout = new Promise((resolve) => {\n    timer = setTimeout(resolve, 3_000, \"timeout\");\n  });\n  try {\n    if (await Promise.race([exited, timeout]) === \"timeout\") {\n      child.kill(\"SIGKILL\");\n      await exited;\n    }\n  } finally {\n    clearTimeout(timer);\n  }\n}\nscripts/test-mcpfn-external-server.mjs:38:  await expectHttpStatus(url, { headers: { host: \"[invalid\" } }, 400);\nscripts/test-mcpfn-external-server.mjs:39:  await expectHttpStatus(new URL(\"/not-found\", url), {}, 404);\nscripts/test-mcpfn-external-server.mjs:143:function expectHttpStatus(url, options, expected) {\nscripts/test-mcpfn-external-server.mjs:156:    request.setTimeout(10_000, () => request.destroy(new Error(\"HTTP fixture probe timed out\")));\n.conduct/pr-170-remediation-ledger.md:15:- Mode: `assessment` (credential-structure, report-failure taxonomy, and CLI runtime-output families recurred; coordinated reassessment completed before mutation)\n.conduct/pr-170-remediation-ledger.md:16:- Local pre-snapshot HEAD: `dfaeef0d1a4b25cc2ae9e10ccde0481b255637ad`\n.conduct/pr-170-remediation-ledger.md:18:- Snapshot consistency: stable across all eleven review-thread pages, five review pages, fifteen raw-inline pages, two issue-comment pages, PR metadata, and the immediate check snapshot; all observed heads matched and every nested thread-comment connection was terminal\n.conduct/pr-170-remediation-ledger.md:28:- Shared invariant: credential-bearing MCP operations must preserve retryable resource ownership until cleanup succeeds, never expose opaque credential material at any consumer-visible boundary, and keep authored report/event structure intact. Conformance evidence must reject insecure OAuth token envelopes, regression tests must assert the behavior they claim, and CI bootstrap must not execute source-distribution setup code.\n.conduct/pr-170-remediation-ledger.md:29:- Producers and consumers: credential providers and authenticated targets produce leases and target-owned redaction; `McpFnClient` owns transports/events/diagnostics; testing suites and official conformance produce bounded reports; inspector produces snapshots/scenarios; `runCli` persists operator artifacts; `bin.ts` is the only process-termination boundary. Hosted OAuth servers produce redirect/token responses consumed by the authorization regression runner. GitHub Actions consumes Python bootstrap packages.\n.conduct/pr-170-remediation-ledger.md:31:- Coordinated repair: (1) persist any bounded cleanup-failure artifact, then propagate the owning cleanup error through `runCli`; retry once at the outer library boundary; only `bin.ts` prints a safe diagnostic and terminates for all three retryable cleanup error types; (2) force payload mode for every inspector snapshot projection; (3) validate JSON plus `Cache-Control: no-store` and `Pragma: no-cache` for both exchange and refresh success responses; (4) correct misleading/incorrect regressions; (5) require binary Python distributions in the failing Sonar-gated bootstrap step. These are complete enforcement points for the current findings rather than commented-line patches.\n.conduct/pr-170-remediation-ledger.md:32:- Verification criteria: focused old-behavior regressions for cleanup retry failure/success, executable diagnostics, snapshot payload collisions, key-only scenario redaction, exchange/refresh cache headers, and misleading retry configuration; then package typechecks/tests, the Node 22 McpFn release gate, `git diff --check`, and one pre-push review of the complete diff. Hosted checks are observed only in the already captured immediate snapshot.\n.conduct/pr-170-remediation-ledger.md:36:- Shared invariant: consumer-visible reports and snapshots must never silently remain passing when credential safety or evidence completeness cannot be guaranteed, and executable termination must not discard already-produced evidence.\n.conduct/pr-170-remediation-ledger.md:37:- Producers / consumers: authenticated target credential leases and the shared scrubber produce protected values and redacted artifacts; target suites, inspector and JUnit consume authored structural envelopes; official conformance produces captured streams; `serializeBoundedReport` persists bounded operator evidence; `runCli` writes reports; `bin.ts` owns forced process termination.\n.conduct/pr-170-remediation-ledger.md:38:- Failure boundaries: credential text colliding with authored discriminator values, final JSON recomposition, report-size truncation, asynchronous stdout backpressure, cleanup-owner propagation into the executable boundary, and non-enumerable `Error.message` / `cause` fields in regressions.\n.conduct/pr-170-remediation-ledger.md:39:- Coordinated repair: reject structural-value credential collisions at the shared scrubber while preserving authored schema keys; mark truncated conformance reports explicitly incomplete and force exit 1; await every CLI output write before cleanup retry/termination; assert cleanup error messages and reports separately.\n.conduct/pr-170-remediation-ledger.md:52:- Shared invariant: while a target owns credentials, every consumer-visible dynamic value—including reconstructed schema discriminators—must be proven safe by that target's redactor before emission; if mandatory structure collides with a credential, the producer must fail closed or emit a safe marked omission. Any abstraction that exposes `close()` must retain and return the retry owner when close fails.\n.conduct/pr-170-remediation-ledger.md:53:- Producers / consumers: `McpFnClient` produces diagnostic and client-event envelopes consumed directly and by `McpFnInspector`; the inspector reconstructs snapshot, timeline, and scenario discriminators for library and CLI consumers. `McpFnTestClient` owns a production `McpFnClient`; direct callers and `mcpfn test` consume its public `close()` contract, while `runCli` already recognizes `McpFnTestClientCleanupError`.\n.conduct/pr-170-remediation-ledger.md:54:- Failure boundaries: structural values reconstructed after payload redaction (`kind`, `phase`, `outcome`, `clientState`, target kind, scenario side effect), safe omission fallback construction, inspector snapshot/export assembly, and post-connect local test-client shutdown after successful operations.\n.conduct/pr-170-remediation-ledger.md:55:- Coordinated repair: add one client structural-safety enforcement point backed by the active target redactor; apply it to event/diagnostic discriminators and all inspector-reconstructed discriminators, dropping only when no schema-safe omission can be produced; then make `McpFnTestClient.close()` wrap retained session cleanup in the existing retryable owner while preserving connection-failure cause semantics during failed connect cleanup.\n.conduct/pr-170-remediation-ledger.md:56:- Verification criteria: credentials equal to client/inspector structural values must never appear in direct events, timelines, snapshots, or scenario exports; safe omissions must be marked and counted, and mandatory snapshot/export collisions must reject with credential-free errors. A post-connect test-client close must retain the same owner through repeated failure and later succeed, and the CLI's existing owner retry boundary must remain green. Then affected package tests/typechecks, the Node 22 release gate, `git diff --check`, and whole-batch caller review.\n.conduct/pr-170-remediation-ledger.md:60:- Shared invariant: every emitted event or diagnostic must preserve both credential confidentiality and schema semantics. A timestamp may be emitted only as the exact generated ISO string after the active target redactor proves that string safe; redaction must never turn it into a malformed timestamp.\n.conduct/pr-170-remediation-ledger.md:61:- Producers / consumers: `McpFnClient.emitEvent()` and diagnostic dispatch produce `at`; direct event/diagnostic listeners, `McpFnInspector` timelines/snapshots, target-suite timelines, CLI serialization, and mixed package consumers retain it.\n.conduct/pr-170-remediation-ledger.md:62:- Failure boundaries: timestamp generation, active-target structural safety validation, construction of a marked omission fallback, and the no-safe-fallback case where every ISO timestamp collides with a credential.\n.conduct/pr-170-remediation-ledger.md:63:- Coordinated repair: enforce one ISO timestamp structural validator in the shared client producer; use it for normal client events, normal diagnostics, and both omission fallbacks. On collision, route through existing omission accounting; emit a marked fallback only with a safe valid ISO timestamp, otherwise drop the artifact while retaining the omission count.\n.conduct/pr-170-remediation-ledger.md:64:- Verification criteria: an exact timestamp credential must never appear and must produce a marked omission whose `at` round-trips through `Date.toISOString()`; a credential present in every ISO representation must emit no malformed artifact and must increment the appropriate omission counter. Then client tests/typecheck, the complete Node 22 McpFn release gate, `git diff --check`, and whole-batch caller review.\n.conduct/pr-170-remediation-ledger.md:69:- Producers / consumers: the authenticated HTTP target owns the credential lease and produces target diagnostics; `McpFnClient` coordinates handle/target cleanup and produces retryable client errors; `McpFnTestClient` retains the close owner; target-suite diagnostics, bounded reports, JUnit, CLI, and direct diagnostic consumers classify the resulting phase and failure layer.\n.conduct/pr-170-remediation-ledger.md:70:- Failure boundaries: raw transport close before credential release, OAuth `revoke()`, provider `dispose()`, client cleanup-drain wrapping, test-client error wrapping, and final suite report normalization.\n.conduct/pr-170-remediation-ledger.md:71:- Coordinated repair: throw a phase-bearing safe cleanup error from the credential lease; emit the lease phase only after transport shutdown succeeds; validate and preserve `token-revocation` through the client cleanup coordinator; and normalize the retained inner cleanup error in the target suite so a later generic close diagnostic cannot replace the terminal phase.\n.conduct/pr-170-remediation-ledger.md:76:- Shared invariant: credential cleanup errors may expose only a trusted phase, safe fixed text, and retry ownership; raw provider failures must not cross the lease, target, client, suite, inspector, or CLI boundary. Every independently reflectable credential component, including structured Cookie values, must be registered before artifacts are emitted. Target-suite post-execution artifact I/O failures are runtime failures and must not replace a retained cleanup owner.\n.conduct/pr-170-remediation-ledger.md:77:- Producers / consumers: credential providers produce header material and revoke/dispose failures; `credentialValues` and target secret scopes produce the redaction set; credential leases and authenticated targets own retryable cleanup; `McpFnClient` coordinates target/handle cleanup; suites, JUnit, inspector, and CLI serialize consumer-visible evidence. The target suite produces reports consumed by `runCli`, whose output writers and executable boundary classify failures.\n.conduct/pr-170-remediation-ledger.md:79:- Coordinated repair: extract and validate Cookie credential components at the shared secret-discovery point; sanitize lease cleanup failures and client cleanup wrappers while preserving the trusted phase separately; rethrow the retained safe rejection from target-level cleanup instead of synthesizing `transport-close`; and convert target-suite artifact/output failures into a safe runtime error without displacing any cleanup owner.\n.conduct/pr-170-remediation-ledger.md:80:- Verification criteria: a reflected Cookie value must be absent from direct redaction and JSON/JUnit artifacts; a provider error containing a credential must not be reachable through cleanup cause chains; repeated OAuth revoke failure during a pre-handle open failure must remain `token-revocation` through client/suite reporting and later retry; target report/JUnit/stdout write failures without a cleanup owner must return exit 1 with safe text, while owner-priority regressions remain green. Then affected package tests/typechecks, the complete Node 22 McpFn release gate, `git diff --check`, and whole-batch caller review.\n.conduct/pr-170-remediation-ledger.md:84:- Shared invariant: every target-controlled value that occupies authored report structure must be proven unchanged by the active live-session redactor before emission; a structural collision must make the report safely incomplete. Every post-execution conformance output or persistence failure is an operational failure with fixed safe text and exit 1, while an existing retryable cleanup owner remains authoritative.\n.conduct/pr-170-remediation-ledger.md:85:- Producers / consumers: custom targets produce arbitrary `describe().kind` values and target-owned redaction; the live `McpFnClient` owns the active redactor and structural-preservation check; the target suite reconstructs bounded JSON/JUnit artifacts consumed by libraries and `mcpfn test-target`. Official conformance produces captured streams and bounded reports consumed by `runCli`, stdout/stderr callbacks, and report persistence.\n.conduct/pr-170-remediation-ledger.md:86:- Failure boundaries: suite projection after scenario execution but before credential cleanup; reinsertion of the raw target discriminator after descriptor payload redaction; final JSON/JUnit serialization; conformance stdout/stderr callbacks and report-file writes; cleanup-owner priority over secondary I/O failures.\n.conduct/pr-170-remediation-ledger.md:88:- Verification criteria: a custom target whose redactor treats its arbitrary kind as a credential must return a bounded incomplete report with the raw kind absent; conformance report, stdout, and stderr failures without a cleanup owner must return exit 1 with fixed safe text and omit raw I/O details, while the existing cleanup-owner priority regressions remain green. Then affected package tests/typechecks/builds, the complete Node 22 release gate, `git diff --check`, and whole-batch caller review.\n.conduct/pr-170-remediation-ledger.md:92:- Shared invariant: credential-bearing artifacts may preserve authored schema only when both structural keys and discriminator values are proven safe; if a credential collides with mandatory structure and no safe typed artifact exists, the producer must reject with credential-free runtime failure rather than emit the credential as a key. Redaction/serialization failures must retain truthful safe taxonomy, and a failing diagnostic sink must never replace an already classified runtime outcome.\n.conduct/pr-170-remediation-ledger.md:93:- Producers / consumers: credential providers and target secret scopes produce protected variants; the shared testing scrubber preserves report/inspector envelope keys; `McpFnClient` produces event and diagnostic target descriptors; suites and inspector/CLI serialize consumer-visible JSON/JUnit; `runCli` classifies operational failures and writes diagnostics through an injectable stderr sink.\n.conduct/pr-170-remediation-ledger.md:94:- Failure boundaries: fixed-key traversal and final serialized-output validation; live target descriptor reconstruction for events/diagnostics and omission fallbacks; suite projection of hostile descriptors versus target redaction collisions; impossible-to-serialize structural-key collisions; and the outer CLI diagnostic write after an output failure is already classified.\n.conduct/pr-170-remediation-ledger.md:95:- Coordinated repair: reject fixed-key credential collisions at the shared scrubber with a distinguishable structural-collision signal; ensure suite callers do not replace that impossible artifact with another colliding fallback; reconstruct client target descriptors only after validating the authored `kind` key and dynamic kind value, routing failures through omission accounting; separate credential projection failure from generic descriptor/serialization failure; and make runtime-error diagnostics best effort while leaving usage-error behavior distinct.\n.conduct/pr-170-remediation-ledger.md:96:- Verification criteria: direct redaction and target-suite consumers must reject a credential equal to `timeline` without serializing it; event/diagnostic target-kind and target-key collisions must emit marked safe omissions or drop them while incrementing counts; hostile descriptors must retain generic safe-serialization wording while credential collisions retain credential-redaction wording; a persistently rejecting conformance stderr sink must still resolve to exit 1 without leaking its rejection. Then affected package tests/typechecks/builds, the complete Node 22 release gate, `git diff --check`, and whole-batch caller review.\n.conduct/pr-170-remediation-ledger.md:102:| `MCP170-CREDENTIAL-BOUNDARY` | Credential-safe redaction across reconstructed targets, diagnostics, and emitted artifacts | Fixed in round 7 batch; recurring family | pre-ledger | round 7 | Prior `1e45b794…` plus round 7 structured-Cookie component extraction/fail-closed parsing | Thread `PRRT_kwDOP-e7KM6jvkZ0`; direct reflected Cookie values are now removed and ambiguous syntax is rejected; testing suite and release gate pass |\n.conduct/pr-170-remediation-ledger.md:105:| `MCP170-SNAPSHOT-PAYLOAD-MODE` | Inspector standalone descriptor/server/capability/inventory projections must use payload redaction, not envelope preservation | Fixed locally; recurring credential-boundary sibling | pre-ledger | round 1 | Round 1 passes `preserveKeys: false` for all snapshot projections | Two current comments deduplicate to this root cause; mode-sensitive snapshot regression passes |\n.conduct/pr-170-remediation-ledger.md:107:| `MCP170-TEST-EVIDENCE` | Regression fixtures must not claim retry behavior they cannot exercise | Fixed locally | round 1 | round 1 | Removed dead `connectRetries` from the initialization-cleanup regression | One current comment. The separate key-redaction assertion comment was disproved by execution: `${MCPFN_SECRET}` is credential-shaped and its associated value is intentionally redacted |\n.conduct/pr-170-remediation-ledger.md:108:| `MCP170-CI-SUPPLYCHAIN` | Python bootstrap in the required CI workflow must install wheel-only packages | Fixed; round 2 Sonar snapshot successful | round 1 | round 1 | Added `--only-binary :all:` to the pip/build upgrade step | Sonar security rating failed in round 1; round 2 SonarCloud Code Analysis and Quality Gate passed |\n.conduct/pr-170-remediation-ledger.md:109:| `MCP170-SONAR-MAINTAINABILITY` | External analyzer inventory contains behavior-preserving maintainability/reliability findings | Assessed and attempted as coordinated subfamilies in round 10; hosted closure pending a later snapshot | round 1 | round 10 | Split 38 reported issues into 34 valid findings across ten contract-aligned repair families and 4 invalid retry-owner findings; the round-10 batch decomposes the valid families without changing external behavior | Round 10 local package suites and release gate passed; no post-push Sonar refetch is permitted this round |\n.conduct/pr-170-remediation-ledger.md:110:| `MCP170-STRUCTURAL-COLLISION` | Registered credential variants must not be silently exempted when they collide with authored artifact discriminator values | Fixed locally; recurring credential-boundary sibling | round 2 | round 2 | Shared scrubber now rejects structural-value collisions while retaining fixed schema keys; suite callers convert the failure to a non-passing incomplete artifact | `pass`, `complete`, target-kind, side-effect and version collisions fail closed; 113 focused testing regressions pass |\n.conduct/pr-170-remediation-ledger.md:117:| `MCP170-INSPECTOR-STRUCTURAL-COLLISION` | Direct client/inspector artifacts reconstruct discriminator values after payload redaction and can expose an equal credential | Fixed and pushed; recurring credential-boundary family | round 4 | round 4 | `afcf360f…`: shared client structural-safety enforcement covers events/diagnostics and inspector snapshots/scenarios; omission counters preserve evidence when no safe envelope can be emitted | One current thread names `clientState`; regressions cover authenticated state, target/root kinds, event/diagnostic kinds, scenario kind/side effect, reports, and mixed ESM/CJS consumers |\n.conduct/pr-170-remediation-ledger.md:119:| `MCP170-TIMESTAMP-STRUCTURE` | Credential redaction can turn generated client/diagnostic ISO timestamps into malformed consumer-visible values | Fixed and pushed; recurring credential-boundary family | round 5 | round 5 | `30e7ff8e…`: safe exact ISO timestamps are enforced at the shared client producer and collisions use omission accounting | Thread `PRRT_kwDOP-e7KM6jutb6`; exact-collision and no-safe-ISO regressions pass, as does the full release gate |\n.conduct/pr-170-remediation-ledger.md:120:| `MCP170-CLEANUP-ERROR-SANITIZATION` | Raw provider revoke/dispose or target cleanup errors can escape through public client cause chains | Fixed in round 7 batch; cleanup/credential-boundary sibling | round 7 | round 7 | Lease and client cleanup wrappers retain safe fixed text, phase, and retryability without attaching raw cleanup causes | Thread `PRRT_kwDOP-e7KM6jvjew`; direct lease and client regressions prove provider secrets are absent and public cleanup causes are undefined |\n.conduct/pr-170-remediation-ledger.md:121:| `MCP170-STRUCTURED-CREDENTIAL-REDACTION` | Cookie credential components may reflect independently of the complete request header | Fixed in round 7 batch; credential-boundary sibling | round 7 | round 7 | Shared credential discovery extracts unquoted and quoted Cookie values and rejects ambiguous structured syntax | Thread `PRRT_kwDOP-e7KM6jvkZ0`; direct redaction regressions distinguish the previously leaking values |\n.conduct/pr-170-remediation-ledger.md:123:| `MCP170-TARGET-KIND-STRUCTURE` | A custom target's arbitrary `describe().kind` can be reinserted raw after descriptor redaction and expose target-owned credential material | Fixed and pushed; recurring credential-boundary family | round 8 | round 8 | `dfaeef0d1…`: validate the dynamic kind through the connected client's shared structural-preservation enforcement and fail the projection closed on collision while preserving the established incomplete-reason contract | Thread `PRRT_kwDOP-e7KM6jwTTA`; focused regression proves the raw kind is absent and the bounded report is incomplete |\n.conduct/pr-170-remediation-ledger.md:125:| `MCP170-PROJECTION-FAILURE-TAXONOMY` | Non-credential descriptor/serialization projection failures are mislabeled as credential-redaction failures | Fixed in round 9 batch; report-evidence sibling | round 9 | round 9 | Track credential projection failure separately from generic descriptor/serialization failure | Thread `PRRT_kwDOP-e7KM6jwtNJ`; hostile-descriptor regressions retain generic safe-serialization wording while target redaction retains credential wording |\n.conduct/pr-170-remediation-ledger.md:127:| `MCP170-STRUCTURAL-KEY-COLLISION` | The shared artifact scrubber exempts credential patterns that collide with mandatory schema keys | Fixed in round 9 batch; recurring credential-boundary family | round 9 | round 9 | Reject fixed-key collisions with a distinct signal and prevent suite fallback serialization when no safe typed envelope exists | Thread `PRRT_kwDOP-e7KM6jwwv0`; direct and target-suite regressions prove a `timeline` credential is never serialized |\n.conduct/pr-170-remediation-ledger.md:128:| `MCP170-DIAGNOSTIC-TARGET-STRUCTURE` | Client event/diagnostic targets redact the required `kind` key/value as payload without omission accounting | Fixed in round 9 batch; recurring credential-boundary family | round 9 | round 9 | Validate and reconstruct target descriptors through the client structural-safety boundary, including safe omission fallbacks | Thread `PRRT_kwDOP-e7KM6jwwv5`; event/diagnostic regressions cover value collision and no-safe-key fallback with omission counts |\n.conduct/pr-170-remediation-ledger.md:130:## Round 1 snapshot dispositions\n.conduct/pr-170-remediation-ledger.md:132:- Actionable at snapshot: 8 unresolved GitHub threads, deduplicated to 4 code/test root causes, plus 1 Sonar required-check root cause. All five root causes are fixed by `45785a27458b9f42e20e1fc3023489a0a7d3998d`; the captured threads were not resolved or refetched.\n.conduct/pr-170-remediation-ledger.md:135:- Invalid / Accepted Risk: 1 GitHub comment is invalid based on the passing observed key-redaction behavior; no accepted risks. Analyzer `throw this` findings target classes extending `Error`; the reported Basic-token regex operates only after the 8 KiB credential-value bound, so these specific diagnostics are not unbounded runtime defects.\n.conduct/pr-170-remediation-ledger.md:138:## Round 1 required-check snapshot\n.conduct/pr-170-remediation-ledger.md:140:- One snapshot only: 17 check contexts were terminal: 13 successful, 1 failed (SonarCloud security rating), 1 neutral, and 2 skipped. `reviewDecision` was empty. No check polling is permitted in this round.\n.conduct/pr-170-remediation-ledger.md:144:- Trend: improving locally: five selected blocking root-cause families were repaired and verified, but the round is not clean because it changed/pushed the head, the only allowed check snapshot predates the push and contained a failure, and one broad non-gating analyzer-maintainability family remains deferred.\n.conduct/pr-170-remediation-ledger.md:145:- Valid blocking root causes before / after: 5 / 1 deferred non-gating analyzer-maintainability family; all selected functional and required-check root causes are fixed locally.\n.conduct/pr-170-remediation-ledger.md:147:- Recurring families: cleanup ownership and credential payload redaction.\n.conduct/pr-170-remediation-ledger.md:149:- Oldest deferred blocker: broad Sonar maintainability inventory from the PR's earlier commits; security-rating failure is selected for this round because it is the only reported failed gate condition.\n.conduct/pr-170-remediation-ledger.md:150:- Clean streak: `0` (reset by actionable findings, a code change/push, the changed PR head, the failed immediate check snapshot, and the deferred analyzer family).\n.conduct/pr-170-remediation-ledger.md:151:- Head stability: snapshot collection was stable at `1e45b794d946722409dc86681a1ee9a34bfe7f2f`; the authorized round then advanced local/remote/PR head together to `45785a27458b9f42e20e1fc3023489a0a7d3998d`.\n.conduct/pr-170-remediation-ledger.md:158:- Gate coverage included full package tests/builds, Playwright, official conformance, examples, mixed-entry redaction, ESM/CJS imports, package dry-runs, packed-consumer installation, and round trips.\n.conduct/pr-170-remediation-ledger.md:160:- Hosted CI/reviewer state was not refetched or polled after edits; only the recorded immediate snapshot may be reported.\n.conduct/pr-170-remediation-ledger.md:162:## Round 2 snapshot dispositions\n.conduct/pr-170-remediation-ledger.md:164:- Actionable at snapshot: 4 new unresolved GitHub threads, deduplicated to 4 root causes. All four are fixed in the reviewed local batch; threads were not resolved and review surfaces will not be refetched after push.\n.conduct/pr-170-remediation-ledger.md:166:- Invalid / Accepted Risk: 1 older GitHub finding remains invalid based on observed key-redaction behavior; no accepted risks.\n.conduct/pr-170-remediation-ledger.md:167:- Not Attempted: the Sonar summary still reports 35 open maintainability/reliability findings although its Quality Gate passed. The family remains deferred and visible; individual analyzer findings were not substituted for the captured review snapshot or declared fixed.\n.conduct/pr-170-remediation-ledger.md:170:## Round 2 required-check snapshot\n.conduct/pr-170-remediation-ledger.md:172:- One snapshot only: 18 contexts comprised 11 successful, 2 in progress (CodeQL Swift and Pullfrog), 2 neutral, and 3 skipped. SonarCloud and Cubic were successful; `reviewDecision` was empty. No check polling is permitted.\n.conduct/pr-170-remediation-ledger.md:176:- Trend: improving locally but non-clean. Four newly discovered root causes are repaired and verified, while the captured hosted snapshot had two pending checks and the 35-item analyzer family remains deferred.\n.conduct/pr-170-remediation-ledger.md:177:- Valid blocking root causes before / after: 4 selected code/test root causes plus 1 deferred analyzer family / 1 deferred analyzer family.\n.conduct/pr-170-remediation-ledger.md:178:- New defects: structural credential collisions, falsely passing truncated conformance artifacts, unawaited CLI evidence writes, and incomplete cleanup leak assertions.\n.conduct/pr-170-remediation-ledger.md:179:- Recurring families: credential boundary and cleanup ownership/output delivery.\n.conduct/pr-170-remediation-ledger.md:181:- Oldest deferred blocker: `MCP170-SONAR-MAINTAINABILITY` from round 1; the current Sonar quality gate is successful but the captured summary still lists 35 open issues.\n.conduct/pr-170-remediation-ledger.md:182:- Clean streak: `0` (reset by four actionable/new findings, recurring-family evidence, this code-changing round, two pending hosted checks, and the deferred analyzer family).\n.conduct/pr-170-remediation-ledger.md:183:- Head stability: the complete snapshot stayed at `45785a27458b9f42e20e1fc3023489a0a7d3998d`; the authorized round then advanced local, remote, and PR head together to `eda8c5b01fa394e35174a88a6bdca078d793ec8c` in the on