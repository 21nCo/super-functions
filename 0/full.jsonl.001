=ad['paths'];env=os.environ.copy();env.update({'npm_config_cache':paths['cache'],'TMPDIR':paths['tmp']+'/','npm_config_devdir':paths['devdir'],'XDG_CACHE_HOME':paths['xdg']})\nfor name in ['CLOUDFLARE_DOCS_DEPLOY','CLOUDFLARE_DOCS_PUBLIC_ORIGIN','CLOUDFLARE_DOCS_ASSETS_ORIGIN']:env.pop(name,None)\nowners=[(context,product,V/product/'docs' if context=='root' else pathlib.Path(sa['slots'][product])) for context in ['root','standalone'] for product in ['extfn','authfn','filefn']];archive=A/'producer213-temporary-static-preimages.tar.gz';assert not archive.exists();pre={};results=[];sha=lambda b:hashlib.sha256(b).hexdigest()\nwith tarfile.open(archive,'w:gz') as tar:\n for context,product,cwd in owners:\n  for name in ['llms.txt','llms-full.txt']:\n   f=cwd/'static'/name;b=f.read_bytes();mode=stat.S_IMODE(f.stat().st_mode);key=context+'/'+product+'/'+name;pre[key]=(b,mode);i=tarfile.TarInfo(key);i.size=len(b);i.mode=mode;tar.addfile(i,io.BytesIO(b))\nwith tarfile.open(archive,'r:gz') as tar:\n assert len(tar.getmembers())==12\n for m in tar.getmembers():assert tar.extractfile(m).read()==pre[m.name][0] and m.mode==pre[m.name][1]\ndef run(label,cwd,args,caseEnv):\n log=A/(label+'.log');assert not log.exists();r=subprocess.run(args,cwd=cwd,env=caseEnv,stdout=subprocess.PIPE,stderr=subprocess.STDOUT);log.write_bytes(r.stdout);assert r.returncode==0,(label,r.returncode);return r.stdout\ntry:\n for context,product,cwd in owners:\n  prefix=f'producer213-{context}-{product}';assets={**env,'CLOUDFLARE_DOCS_DEPLOY':'1','CLOUDFLARE_DOCS_ASSETS_ORIGIN':'https://cdn.invalid'};run(prefix+'-assets-only-check',cwd,['node','scripts/generate-llms.mjs','--check'],assets);explicit={**assets,'CLOUDFLARE_DOCS_PUBLIC_ORIGIN':'https://public.invalid'}\n  config=run(prefix+'-native-public-config',cwd,['node','--input-type=module','--eval','import {loadDocsConfig} from \"@docsfn/core\"; console.log(JSON.stringify((await loadDocsConfig({cwd:process.cwd()})).site.canonicalUrl));'],explicit);assert json.loads(config)=='https://public.invalid'\n  try:\n   run(prefix+'-actual-public-producer',cwd,['node','scripts/generate-llms.mjs'],explicit);text=(cwd/'static/llms.txt').read_text();assert '](https://public.invalid/docs' in text and 'https://cdn.invalid' not in text and '/docs/docs/' not in text;generated={name:sha((cwd/'static'/name).read_bytes()) for name in ['llms.txt','llms-full.txt']}\n  finally:\n   for name in ['llms.txt','llms-full.txt']:\n    b,mode=pre[context+'/'+product+'/'+name];f=cwd/'static'/name;f.write_bytes(b);f.chmod(mode);assert sha(f.read_bytes())==sha(b) and stat.S_IMODE(f.stat().st_mode)==mode\n  nondeploy={**env,'CLOUDFLARE_DOCS_PUBLIC_ORIGIN':'https://public.invalid','CLOUDFLARE_DOCS_ASSETS_ORIGIN':'https://cdn.invalid'};run(prefix+'-nondeployment-public-ignored-check',cwd,['node','scripts/generate-llms.mjs','--check'],nondeploy);results.append({'context':context,'product':product,'physicalOwner':str(cwd),'assetsOnlyEqualsNormal':True,'actualNativeConfigPublicOrigin':'https://public.invalid','actualCliPublicLinksNotAssets':True,'nondeploymentPublicIgnored':True,'temporarilyGeneratedHashes':generated,'staticBytesAndModesRestored':True})\nfinally:\n for context,product,cwd in owners:\n  for name in ['llms.txt','llms-full.txt']:\n   b,mode=pre[context+'/'+product+'/'+name];f=cwd/'static'/name\n   if f.read_bytes()!=b or stat.S_IMODE(f.stat().st_mode)!=mode:f.write_bytes(b);f.chmod(mode)\n (A/'executing213-producer-origin-matrix.json').write_text(json.dumps({'results':results,'staticArchiveVerifiedBeforeWriter':True,'sourceFilesMutated':False,'qualification':'Actual consumer SDK/config/CLI in distinct processes; no live hosting/Worker deployment. Twelve temporary static outputs restored exact bytes/modes.'},indent=2)+'\\n')\nprint('Six native executing config/CLI role branches passed; twelve static outputs restored exact.')\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":4002,"output":17