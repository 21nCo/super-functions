YTES = 16_384;\n   300\tconst MAX_CREDENTIAL_HEADER_VALUE_BYTES = 8_192;\n   301\tconst FORBIDDEN_CREDENTIAL_HEADERS = new Set([\n   302\t  \"connection\",\n   303\t  \"content-length\",\n   304\t  \"host\",\n   305\t  \"proxy-connection\",\n   306\t  \"te\",\n   307\t  \"trailer\",\n   308\t  \"transfer-encoding\",\n   309\t  \"upgrade\",\n   310\t]);\n   311\t\n   312\texport type McpFnRemoteCredentialKind = \"api-key\" | \"oauth\" | \"custom\";\n   313\t\n   314\texport interface McpFnRemoteCredential {\n   315\t  /** Credential headers are applied only to the fixed target origin. */\n   316\t  headers: HeadersInit;\n   317\t  kind?: McpFnRemoteCredentialKind;\n   318\t  label?: string;\n   319\t}\n   320\t\n   321\texport interface McpFnRemoteCredentialContext {\n   322\t  url: string;\n   323\t  requestId: string;\n   324\t  signal?: AbortSignal;\n   325\t}\n   326\t\n   327\t/**\n   328\t * Application-owned credential lifecycle for external MCP targets. McpFn\n   329\t * acquires once per target open, revokes before disposal, and never serializes\n   330\t * the returned headers into descriptors or reports. If acquisition rejects, the\n   331\t * provider must roll back its own partial resources; no lease has been returned.\n   332\t */\n   333\texport interface McpFnRemoteCredentialProvider {\n   334\t  acquire(\n   335\t    context: McpFnRemoteCredentialContext,\n   336\t  ): McpFnRemoteCredential | Promise<McpFnRemoteCredential>;\n   337\t  revoke?(\n   338\t    credential: McpFnRemoteCredential,\n   339\t    context: McpFnRemoteCredentialContext,\n   340\t  ): void | Promise<void>;\n   341\t  dispose?(\n   342\t    credential: McpFnRemoteCredential,\n   343\t    context: McpFnRemoteCredentialContext,\n   344\t  ): void | Promise<void>;\n   345\t}\n   346\t\n   347\texport interface McpFnRemoteCredentialLease {\n   348\t  credential: McpFnRemoteCredential;\n   349\t  release(): Promise<void>;\n   350\t  /** The lifecycle stage that most recently prevented credential release. */\n   351\t  cleanupPhase(): \"token-revocation\" | \"transport-close\";\n   352\t}\n   353\t\n   354\texport interface McpFnAuthenticatedHttpTargetOptions\n   355\t  extends Omit<McpFnStreamableHttpTargetOptions, \"authProvider\" | \"requestInit\"> {\n   356\t  credential: McpFnRemoteCredential | McpFnRemoteCredentialProvider;\n   357\t  requestInit?: Omit<RequestInit, \"headers\" | \"redirect\"> & { headers?: HeadersInit };\n   358\t}\n   359\t\n   360\t/** Create a provider for an already-bounded API key or OAuth-derived token. */\n   361\texport function staticRemoteCredentialProvider(\n   362\t  credential: McpFnRemoteCredential,\n   363\t): McpFnRemoteCredentialProvider {\n   364\t  return { acquire: () => credential };\n   365\t}\n   366\t\n   367\t/** Acquire a credential and return an idempotent revoke-then-dispose lease. */\n   368\texport async function acquireRemoteCredential(\n   369\t  source: McpFnRemoteCredential | McpFnRemoteCredentialProvider,\n   370\t  context: McpFnRemoteCredentialContext,\n     1\timport { describe, expect, it } from \"vitest\";\n     2\timport {\n     3\t  createMcpAuthorizationCompatibilityHandler,\n     4\t  normalizeMcpClientRegistration,\n     5\t  type McpFnNormalizedClientRegistration,\n     6\t} from \"@mcpfn/auth\";\n     7\t\n     8\timport {\n     9\t  createHostedAuthorizationFixtures,\n    10\t  runHostedAuthorizationRegression,\n    11\t} from \"../src/index.js\";\n    12\t\n    13\tconst TOKEN_RESPONSE_HEADERS = {\n    14\t  \"cache-control\": \"no-store\",\n    15\t  pragma: \"no-cache\",\n    16\t};\n    17\t\n    18\tfunction tokenJson(body: unknown, init: ResponseInit = {}): Response {\n    19\t  const headers = new Headers(init.headers);\n    20\t  for (const [name, value] of Object.entries(TOKEN_RESPONSE_HEADERS)) {\n    21\t    headers.set(name, value);\n    22\t  }\n    23\t  return Response.json(body, { ...init, headers });\n    24\t}\n    25\t\n    26\tdescribe(\"hosted role-3 regression harness\", () => {\n    27\t  it(\"keeps registration and request inputs independent across named hosts and grant errors\", async () => {\n    28\t    const issuer = \"https://login.example.com\";\n    29\t    const resource = \"https://mcp.example.com/mcp\";\n    30\t    const registrations = new Map<string, McpFnNormalizedClientRegistration>();\n    31\t    const handler = createMcpAuthorizationCompatibilityHandler({\n    32\t      issuer,\n    33\t      clients: {\n    34\t        resolve: async (clientId) => registrations.get(clientId) ?? null,\n    35\t      },\n    36\t      allowedResources: [resource],\n    37\t      capabilities: { requireRefreshResource: true },\n    38\t      supportedScopes: [\"mcp:read\"],\n    39\t      authorize: async (input) => {\n    40\t        const callback = new URL(input.redirectUri);\n    41\t        callback.searchParams.set(\"code\", `${input.client.clientId}-code`);\n    42\t        if (input.state) callback.searchParams.set(\"state\", input.state);\n    43\t        return Response.redirect(callback, 302);\n    44\t      },\n    45\t      tokenAuthority: {\n    46\t        exchangeAuthorizationCode: async () => ({\n    47\t          access_token: \"role3-access-token\",\n    48\t          token_type: \"Bearer\",\n    49\t          refresh_token: \"role3-refresh-token\",\n    50\t        }),\n    51\t        refreshToken: async () => ({\n    52\t          access_token: \"role3-refreshed-token\",\n    53\t          token_type: \"Bearer\",\n    54\t          refresh_token: \"role3-rotated-token\",\n    55\t        }),\n    56\t      },\n    57\t    });\n    58\t    const fixtures = createHostedAuthorizationFixtures({ issuer, resource });\n    59\t    const drift = fixtures.find((fixture) => fixture.id === \"chatgpt-unregistered-redirect\")!;\n    60\t    expect(drift.registration.metadata.redirect_uris).not.toContain(\n    61\t      drift.authorization.redirectUri,\n    62\t    );\n    63\t\n    64\t    const results = await runHostedAuthorizationRegression({\n    65\t      issuer,\n    66\t      async prepareRegistration(fixture) {\n    67\t        registrations.set(fixture.clientId, normalizeMcpClientRegistration(fixture));\n    68\t      },\n    69\t      request: async (request) => {\n    70\t        if (new URL(request.url).pathname.endsWith(\"token\")) {\n    71\t          const body = new URLSearchParams(await request.clone().text());\n    72\t          if (body.get(\"grant_type\") === \"authorization_code\") {\n    73\t            expect(body.get(\"code\")).toBe(`${body.get(\"client_id\")}-code`);\n    74\t          }\n    75\t        }\n    76\t        return handler(request);\n    77\t      },\n    78\t    }, fixtures);\n    79\t\n    80\t    expect(results).toHaveLength(6);\n    81\t    expect(results.filter((result) => result.status !== \"passed\")).toEqual([]);\n    82\t    expect(results).toEqual(expect.arrayContaining([\n    83\t      expect.objectContaining({\n    84\t        id: \"claude-client-metadata-extensible-grants\",\n    85\t        phase: \"token-refresh\",\n    86\t      }),\n    87\t      expect.objectContaining({\n    88\t        id: \"chatgpt-unregistered-redirect\",\n    89\t        errorCode: \"invalid_request\",\n    90\t        phase: \"authorization-request\",\n    91\t      }),\n    92\t      expect.objectContaining({\n    93\t        id: \"actual-unsupported-token-grant\",\n    94\t        errorCode: \"unsupported_grant_type\",\n    95\t        phase: \"token-exchange\",\n    96\t      }),\n    97\t    ]));\n    98\t  });\n    99\t  it.each([\"throw\", \"no-redirect\", \"missing-code\", \"wrong-state\", \"wrong-callback\", \"empty-token\", \"token-redirect\"])(\"fails broken hosted flow: %s\", async (fault) => {\n   100\t    const issuer = \"https://login.example.com\";\n   101\t    const fixture = createHostedAuthorizationFixtures({ issuer, resource: \"https://mcp.example.com/mcp\" })[0]!;\n   102\t    const results = await runHostedAuthorizationRegression({\n   103\t      issuer, prepareRegistration: async () => {},\n   104\t      request: async (request) => {\n   105\t        if (fault === \"throw\") throw new Error(\"transport aborted\");\n   106\t        if (new URL(request.url).pathname.endsWith(\"authorize\")) {\n   107\t          if (fault === \"no-redirect\") return new Response(\"\", { status: 200 });\n   108\t          const callback = new URL(fault === \"wrong-callback\" ? \"https://evil.example/callback\" : fixture.authorization.redirectUri);\n   109\t          if (fault !== \"missing-code\") callback.searchParams.set(\"code\", \"real-code\");\n   110\t          callback.searchParams.set(\"state\", fault === \"wrong-state\" ? \"wrong\" : fixture.authorization.state);\n   111\t          return Response.redirect(callback, 302);\n   112\t        }\n   113\t        expect(request.redirect).toBe(\"manual\");\n   114\t        if (fault === \"token-redirect\") return Response.redirect(\"https://evil.example/token\", 307);\n   115\t        return tokenJson(fault === \"empty-token\" ? {} : { access_token: \"valid-token\", token_type: \"Bearer\", refresh_token: \"valid-refresh\" });\n   116\t      },\n   117\t    }, [fixture]);\n   118\t    expect(results[0]?.status).toBe(\"failed\");\n   119\t  });\n   120\t\n   121\t});\n   122\t\n   123\tit.each([\"status\", \"state\", \"destination\"])(\"rejects malformed OAuth rejection %s\", async (fault) => {\n   124\t  const issuer = \"https://login.example.com\";\n   125\t  const fixture = createHostedAuthorizationFixtures({ issuer, resource: \"https://mcp.example.com/mcp\" })[0]!;\n   126\t  fixture.expected = { outcome: \"rejected\", errorCode: \"invalid_request\" };\n   127\t  const results = await runHostedAuthorizationRegression({ issuer, prepareRegistration: async () => {},\n   128\t    request: async () => {\n   129\t      if (fault === \"status\") return Response.json({ error: \"invalid_request\" });\n   130\t      const callback = new URL(fault === \"destination\" ? \"https://evil.example/cb\" : fixture.authorization.redirectUri);\n   131\t      callback.searchParams.set(\"error\", \"invalid_request\");\n   132\t      callback.searchParams.set(\"state\", fault === \"state\" ? \"wrong\" : fixture.authorization.state);\n   133\t      return Response.redirect(callback, 302);\n   134\t    },\n   135\t  }, [fixture]);\n   136\t  expect(results[0]?.status).toBe(\"failed\");\n   137\t});\n   138\t\n   139\t\n   140\tit.each([304, 305])(\"rejects status %s as an OAuth error redirect\", async (status) => {\n   141\t  const issuer = \"https://login.example.com\";\n   142\t  const fixture = createHostedAuthorizationFixtures({ issuer, resource: \"https://mcp.example.com/mcp\" })[0]!;\n   143\t  fixture.expected = { outcome: \"rejected\", errorCode: \"invalid_request\" };\n   144\t  const callback = new URL(fixture.authorization.redirectUri);\n   145\t  callback.searchParams.set(\"error\", \"invalid_request\"); callback.searchParams.set(\"state\", fixture.authorization.state);\n   146\t  const results = await runHostedAuthorizationRegression({ issuer, prepareRegistration: async () => {}, request: async () => new Response(null, { status, headers: { location: callback.toString() } }) }, [fixture]);\n   147\t  expect(results[0]?.status).toBe(\"failed\");\n   148\t});\n   149\t\n   150\tit.each([400, 401, 403])(\"rejects a Location-only token error with status %s\", async (status) => {\n   151\t  const issuer = \"https://login.example.com\";\n   152\t  const fixture = createHostedAuthorizationFixtures({ issuer, resource: \"https://mcp.example.com/mcp\" }).find((item) => item.id === \"actual-unsupported-token-grant\")!;\n   153\t  const callback = new URL(fixture.authorization.redirectUri);\n   154\t  callback.searchParams.set(\"code\", \"test-code\"); callback.searchParams.set(\"state\", fixture.authorization.state);\n   155\t  const results = await runHostedAuthorizationRegression({ issuer, prepareRegistration: async () => {}, request: async (request) =>\n   156\t    new URL(request.url).pathname.endsWith(\"authorize\") ? Response.redirect(callback, 302) : new Response(null, { status, headers: { location: \"https://login.example.com/error?error=unsupported_grant_type\" } })\n   157\t  }, [fixture]);\n   158\t  expect(results[0]?.status).toBe(\"failed\");\n   159\t});\n   160\t\n   161\tit.each([[400, 'application/json', 'passed'], [400, 'Application/JSON; charset=utf-8', 'passed'], [401, 'application/json', 'failed'], [403, 'application/json', 'failed'], [400, 'text/notjson', 'failed']])('validates token rejection media type and status %s %s', async (status, contentType, outcome) => {\n   162\t  const issuer = \"https://login.example.com\";\n   163\t  const fixture = createHostedAuthorizationFixtures({ issuer, resource: \"https://mcp.example.com/mcp\" }).find(item => item.id === \"actual-unsupported-token-grant\")!;\n   164\t  const callback = new URL(fixture.authorization.redirectUri);\n   165\t  callback.searchParams.set(\"code\", \"test-code\"); callback.searchParams.set(\"state\", fixture.authorization.state);\n   166\t  const results = await runHostedAuthorizationRegression({ issuer, prepareRegistration: async () => {}, request: async request =>\n   167\t    new URL(request.url).pathname.endsWith(\"authorize\") ? Response.redirect(callback, 302) : new Response(JSON.stringify({ error: 'unsupported_grant_type' }), { status: status as number, headers: { 'content-type': contentType as string } })\n   168\t  }, [fixture]);\n   169\t  expect(results[0]?.status).toBe(outcome);\n   170\t});\n","exit_code":0,"duration":{"secs":0,"nanos":1625},"formatted_output":"   270\t  const revoke = vi.fn().mockRejectedValueOnce(new Error(\"retry\")).mockResolvedValue(undefined);\n   271\t  const dispose = vi.fn();\n   272\t  const lease = await acquireRemoteCredential({ acquire: () => ({ headers: { \"x-api-key\": \"secret\" } }), revoke, dispose }, { url: \"https://test/mcp\", requestId: \"test\" });\n   273\t  await expect(lease.release()).rejects.toThrow(/cleanup failed/);\n   274\t  expect(dispose).not.toHaveBeenCalled();\n   275\t  await expect(lease.release()).resolves.toBeUndefined();\n   276\t  await lease.release();\n   277\t  expect(revoke).toHaveBeenCalledTimes(2);\n   278\t  expect(dispose).toHaveBeenCalledOnce();\n   279\t});\n   280\tit(\"handles long authorization whitespace without backtracking\", async () => {\n   281\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   282\t  expect(() => redactRemoteCredential({ headers: { authorization: `Bearer${\" \".repeat(100000)}opaque` } }, \"opaque\")).toThrow(/value-size limit/);\n   283\t});\n   284\t\n   285\tit(\"retries authenticated handle revocation after a strict close fails\", async () => {\n   286\t  const fixture = await startAuthenticatedServer(\"retry-secret\");\n   287\t  const revoke = vi.fn().mockRejectedValueOnce(new Error(\"retry-secret\")).mockResolvedValue(undefined);\n   288\t  const dispose = vi.fn();\n   289\t  const target = authenticatedHttpTarget(fixture.url, { credential: { acquire: () => ({ headers: { authorization: \"Bearer retry-secret\" } }), revoke, dispose } });\n   290\t  try {\n   291\t    const handle = await target.open({ requestId: \"retry\", diagnostic: async () => {} } as any);\n   292\t    await expect(handle.close!()).rejects.toThrow(/cleanup failed/);\n   288\texport function redactTargetCredentials<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean; redactionMarker?: string } = {}): T {\n   289\t  const state = targetSecrets.get(target);\n   290\t  return scrubCredentials(value, new Set([...(state?.active.keys() ?? []), ...[...(state?.scopes ?? [])].flatMap((scope) => [...scope])]), options.preserveKeys, options.redactionMarker);\n   291\t}\n   292\t\n   293\t/** Redact authenticated conformance output using the acquired credential. */\n   294\texport function redactRemoteCredential<T>(credential: McpFnRemoteCredential, value: T, options: { preserveKeys?: boolean } = {}): T {\n   295\t  return scrubCredentials(value, credentialValues(credential.headers), options.preserveKeys);\n   296\t}\n   297\t\n   298\tconst MAX_CREDENTIAL_HEADERS = 32;\n   299\tconst MAX_CREDENTIAL_HEADER_BYTES = 16_384;\n   300\tconst MAX_CREDENTIAL_HEADER_VALUE_BYTES = 8_192;\n   301\tconst FORBIDDEN_CREDENTIAL_HEADERS = new Set([\n   302\t  \"connection\",\n   303\t  \"content-length\",\n   304\t  \"host\",\n   305\t  \"proxy-connection\",\n   306\t  \"te\",\n   307\t  \"trailer\",\n   308\t  \"transfer-encoding\",\n   309\t  \"upgrade\",\n   310\t]);\n   311\t\n   312\texport type McpFnRemoteCredentialKind = \"api-key\" | \"oauth\" | \"custom\";\n   313\t\n   314\texport interface McpFnRemoteCredential {\n   315\t  /** Credential headers are applied only to the fixed target origin. */\n   316\t  headers: HeadersInit;\n   317\t  kind?: McpFnRemoteCredentialKind;\n   318\t  label?: string;\n   319\t}\n   320\t\n   321\texport interface McpFnRemoteCredentialContext {\n   322\t  url: string;\n   323\t  requestId: string;\n   324\t  signal?: AbortSignal;\n   325\t}\n   326\t\n   327\t/**\n   328\t * Application-owned credential lifecycle for external MCP targets. McpFn\n   329\t * acquires once per target open, revokes before disposal, and never serializes\n   330\t * the returned headers into descriptors or reports. If acquisition rejects, the\n   331\t * provider must roll back its own partial resources; no lease has been returned.\n   332\t */\n   333\texport interface McpFnRemoteCredentialProvider {\n   334\t  acquire(\n   335\t    context: McpFnRemoteCredentialContext,\n   336\t  ): McpFnRemoteCredential | Promise<McpFnRemoteCredential>;\n   337\t  revoke?(\n   338\t    credential: McpFnRemoteCredential,\n   339\t    context: McpFnRemoteCredentialContext,\n   340\t  ): void | Promise<void>;\n   341\t  dispose?(\n   342\t    credential: McpFnRemoteCredential,\n   343\t    context: McpFnRemoteCredentialContext,\n   344\t  ): void | Promise<void>;\n   345\t}\n   346\t\n   347\texport interface McpFnRemoteCredentialLease {\n   348\t  credential: McpFnRemoteCredential;\n   349\t  release(): Promise<void>;\n   350\t  /** The lifecycle stage that most recently prevented credential release. */\n   351\t  cleanupPhase(): \"token-revocation\" | \"transport-close\";\n   352\t}\n   353\t\n   354\texport interface McpFnAuthenticatedHttpTargetOptions\n   355\t  extends Omit<McpFnStreamableHttpTargetOptions, \"authProvider\" | \"requestInit\"> {\n   356\t  credential: McpFnRemoteCredential | McpFnRemoteCredentialProvider;\n   357\t  requestInit?: Omit<RequestInit, \"headers\" | \"redirect\"> & { headers?: HeadersInit };\n   358\t}\n   359\t\n   360\t/** Create a provider for an already-bounded API key or OAuth-derived token. */\n   361\texport function staticRemoteCredentialProvider(\n   362\t  credential: McpFnRemoteCredential,\n   363\t): McpFnRemoteCredentialProvider {\n   364\t  return { acquire: () => credential };\n   365\t}\n   366\t\n   367\t/** Acquire a credential and return an idempotent revoke-then-dispose lease. */\n   368\texport async function acquireRemoteCredential(\n   369\t  source: McpFnRemoteCredential | McpFnRemoteCredentialProvider,\n   370\t  context: McpFnRemoteCredentialContext,\n     1\timport { describe, expect, it } from \"vitest\";\n     2\timport {\n     3\t  createMcpAuthorizationCompatibilityHandler,\n     4\t  normalizeMcpClientRegistration,\n     5\t  type McpFnNormalizedClientRegistration,\n     6\t} from \"@mcpfn/auth\";\n     7\t\n     8\timport {\n     9\t  createHostedAuthorizationFixtures,\n    10\t  runHostedAuthorizationRegression,\n    11\t} from \"../src/index.js\";\n    12\t\n    13\tconst TOKEN_RESPONSE_HEADERS = {\n    14\t  \"cache-control\": \"no-store\",\n    15\t  pragma: \"no-cache\",\n    16\t};\n    17\t\n    18\tfunction tokenJson(body: unknown, init: ResponseInit = {}): Response {\n    19\t  const headers = new Headers(init.headers);\n    20\t  for (const [name, value] of Object.entries(TOKEN_RESPONSE_HEADERS)) {\n    21\t    headers.set(name, value);\n    22\t  }\n    23\t  return Response.json(body, { ...init, headers });\n    24\t}\n    25\t\n    26\tdescribe(\"hosted role-3 regression harness\", () => {\n    27\t  it(\"keeps registration and request inputs independent across named hosts and grant errors\", async () => {\n    28\t    const issuer = \"https://login.example.com\";\n    29\t    const resource = \"https://mcp.example.com/mcp\";\n    30\t    const registrations = new Map<string, McpFnNormalizedClientRegistration>();\n    31\t    const handler = createMcpAuthorizationCompatibilityHandler({\n    32\t      issuer,\n    33\t      clients: {\n    34\t        resolve: async (clientId) => registrations.get(clientId) ?? null,\n    35\t      },\n    36\t      allowedResources: [resource],\n    37\t      capabilities: { requireRefreshResource: true },\n    38\t      supportedScopes: [\"mcp:read\"],\n    39\t      authorize: async (input) => {\n    40\t        const callback = new URL(input.redirectUri);\n    41\t        callback.searchParams.set(\"code\", `${input.client.clientId}-code`);\n    42\t        if (input.state) callback.searchParams.set(\"state\", input.state);\n    43\t        return Response.redirect(callback, 302);\n    44\t      },\n    45\t      tokenAuthority: {\n    46\t        exchangeAuthorizationCode: async () => ({\n    47\t          access_token: \"role3-access-token\",\n    48\t          token_type: \"Bearer\",\n    49\t          refresh_token: \"role3-refresh-token\",\n    50\t        }),\n    51\t        refreshToken: async () => ({\n    52\t          access_token: \"role3-refreshed-token\",\n    53\t          token_type: \"Bearer\",\n    54\t          refresh_token: \"role3-rotated-token\",\n    55\t        }),\n    56\t      },\n    57\t    });\n    58\t    const fixtures = createHostedAuthorizationFixtures({ issuer, resource });\n    59\t    const drift = fixtures.find((fixture) => fixture.id === \"chatgpt-unregistered-redirect\")!;\n    60\t    expect(drift.registration.metadata.redirect_uris).not.toContain(\n    61\t      drift.authorization.redirectUri,\n    62\t    );\n    63\t\n    64\t    const results = await runHostedAuthorizationRegression({\n    65\t      issuer,\n    66\t      async prepareRegistration(fixture) {\n    67\t        registrations.set(fixture.clientId, normalizeMcpClientRegistration(fixture));\n    68\t      },\n    69\t      request: async (request) => {\n    70\t        if (new URL(request.url).pathname.endsWith(\"token\")) {\n    71\t          const body = new URLSearchParams(await request.clone().text());\n    72\t          if (body.get(\"grant_type\") === \"authorization_code\") {\n    73\t            expect(body.get(\"code\")).toBe(`${body.get(\"client_id\")}-code`);\n    74\t          }\n    75\t        }\n    76\t        return handler(request);\n    77\t      },\n    78\t    }, fixtures);\n    79\t\n    80\t    expect(results).toHaveLength(6);\n    81\t    expect(results.filter((result) => result.status !== \"passed\")).toEqual([]);\n    82\t    expect(results).toEqual(expect.arrayContaining([\n    83\t      expect.objectContaining({\n    84\t        id: \"claude-client-metadata-extensible-grants\",\n    85\t        phase: \"token-refresh\",\n    86\t      }),\n    87\t      expect.objectContaining({\n    88\t        id: \"chatgpt-unregistered-redirect\",\n    89\t        errorCode: \"invalid_request\",\n    90\t        phase: \"authorization-request\",\n    91\t      }),\n    92\t      expect.objectContaining({\n    93\t        id: \"actual-unsupported-token-grant\",\n    94\t        errorCode: \"unsupported_grant_type\",\n    95\t        phase: \"token-exchange\",\n    96\t      }),\n    97\t    ]));\n    98\t  });\n    99\t  it.each([\"throw\", \"no-redirect\", \"missing-code\", \"wrong-state\", \"wrong-callback\", \"empty-token\", \"token-redirect\"])(\"fails broken hosted flow: %s\", async (fault) => {\n   100\t    const issuer = \"https://login.example.com\";\n   101\t    const fixture = createHostedAuthorizationFixtures({ issuer, resource: \"https://mcp.example.com/mcp\" })[0]!;\n   102\t    const results = await runHostedAuthorizationRegression({\n   103\t      issuer, prepareRegistration: async () => {},\n   104\t      request: async (request) => {\n   105\t        if (fault === \"throw\") throw new Error(\"transport aborted\");\n   106\t        if (new URL(request.url).pathname.endsWith(\"authorize\")) {\n   107\t          if (fault === \"no-redirect\") return new Response(\"\", { status: 200 });\n   108\t          const callback = new URL(fault === \"wrong-callback\" ? \"https://evil.example/callback\" : fixture.authorization.redirectUri);\n   109\t          if (fault !== \"missing-code\") callback.searchParams.set(\"code\", \"real-code\");\n   110\t          callback.searchParams.set(\"state\", fault === \"wrong-state\" ? \"wrong\" : fixture.authorization.state);\n   111\t          return Response.redirect(callback, 302);\n   112\t        }\n   113\t        expect(request.redirect).toBe(\"manual\");\n   114\t        if (fault === \"token-redirect\") return Response.redirect(\"https://evil.example/token\", 307);\n   115\t        return tokenJson(fault === \"empty-token\" ? {} : { access_token: \"valid-token\", token_type: \"Bearer\", refresh_token: \"valid-refresh\" });\n   116\t      },\n   117\t    }, [fixture]);\n   118\t    expect(results[0]?.status).toBe(\"failed\");\n   119\t  });\n   120\t\n   121\t});\n   122\t\n   123\tit.each([\"status\", \"state\", \"destination\"])(\"rejects malformed OAuth rejection %s\", async (fault) => {\n   124\t  const issuer = \"https://login.example.com\";\n   125\t  const fixture = createHostedAuthorizationFixtures({ issuer, resource: \"https://mcp.example.com/mcp\" })[0]!;\n   126\t  fixture.expected = { outcome: \"rejected\", errorCode: \"invalid_request\" };\n   127\t  const results = await runHostedAuthorizationRegression({ issuer, prepareRegistration: async () => {},\n   128\t    request: async () => {\n   129\t      if (fault === \"status\") return Response.json({ error: \"invalid_request\" });\n   130\t      const callback = new URL(fault === \"destination\" ? \"https://evil.example/cb\" : fixture.authorization.redirectUri);\n   131\t      callback.searchParams.set(\"error\", \"invalid_request\");\n   132\t      callback.searchParams.set(\"state\", fault === \"state\" ? \"wrong\" : fixture.authorization.state);\n   133\t      return Response.redirect(callback, 302);\n   134\t    },\n   135\t  }, [fixture]);\n   136\t  expect(results[0]?.status).toBe(\"failed\");\n   137\t});\n   138\t\n   139\t\n   140\tit.each([304, 305])(\"rejects status %s as an OAuth error redirect\", async (status) => {\n   141\t  const issuer = \"https://login.example.com\";\n   142\t  const fixture = createHostedAuthorizationFixtures({ issuer, resource: \"https://mcp.example.com/mcp\" })[0]!;\n   143\t  fixture.expected = { outcome: \"rejected\", errorCode: \"invalid_request\" };\n   144\t  const callback = new URL(fixture.authorization.redirectUri);\n   145\t  callback.searchParams.set(\"error\", \"invalid_request\"); callback.searchParams.set(\"state\", fixture.authorization.state);\n   146\t  const results = await runHostedAuthorizationRegression({ issuer, prepareRegistration: async () => {}, request: async () => new Response(null, { status, headers: { location: callback.toString() } }) }, [fixture]);\n   147\t  expect(results[0]?.status).toBe(\"failed\");\n   148\t});\n   149\t\n   150\tit.each([400, 401, 403])(\"rejects a Location-only token error with status %s\", async (status) => {\n   151\t  const issuer = \"https://login.example.com\";\n   152\t  const fixture = createHostedAuthorizationFixtures({ issuer, resource: \"https://mcp.example.com/mcp\" }).find((item) => item.id === \"actual-unsupported-token-grant\")!;\n   153\t  const callback = new URL(fixture.authorization.redirectUri);\n   154\t  callback.searchParams.set(\"code\", \"test-code\"); callback.searchParams.set(\"state\", fixture.authorization.state);\n   155\t  const results = await runHostedAuthorizationRegression({ issuer, prepareRegistration: async () => {}, request: async (request) =>\n   156\t    new URL(request.url).pathname.endsWith(\"authorize\") ? Response.redirect(callback, 302) : new Response(null, { status, headers: { location: \"https://login.example.com/error?error=unsupported_grant_type\" } })\n   157\t  }, [fixture]);\n   158\t  expect(results[0]?.status).toBe(\"failed\");\n   159\t});\n   160\t\n   161\tit.each([[400, 'application/json', 'passed'], [400, 'Application/JSON; charset=utf-8', 'passed'], [401, 'application/json', 'failed'], [403, 'application/json', 'failed'], [400, 'text/notjson', 'failed']])('validates token rejection media type and status %s %s', async (status, contentType, outcome) => {\n   162\t  const issuer = \"https://login.example.com\";\n   163\t  const fixture = createHostedAuthorizationFixtures({ issuer, resource: \"https://mcp.example.com/mcp\" }).find(item => item.id === \"actual-unsupported-token-grant\")!;\n   164\t  const callback = new URL(fixture.authorization.redirectUri);\n   165\t  callback.searchParams.set(\"code\", \"test-code\"); callback.searchParams.set(\"state\", fixture.authorization.state);\n   166\t  const results = await runHostedAuthorizationRegression({ issuer, prepareRegistration: async () => {}, request: async request =>\n   167\t    new URL(request.url).pathname.endsWith(\"authorize\") ? Response.redirect(callback, 302) : new Response(JSON.stringify({ error: 'unsupported_grant_type' }), { status: status as number, headers: { 'content-type': contentType as string } })\n   168\t  }, [fixture]);\n   169\t  expect(results[0]?.status).toBe(outcome);\n   170\t});\n"},"started_at_ms":1789811633547,"completed_at_ms":1789811633547}}
{"timestamp":"2026-09-19T09:53:53.664Z","ordinal":4394,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0b916-2e00-7062-8102-c218ef9e9e67","call_id":"call_McAKwdpEcttiisgBxIOd6D9E","output":[{"type":"input_text","text":"Script completed\nWall time 0.3 seconds\nOutput:\n"},{"type":"input_text","text":"   270\t  const revoke = vi.fn().mockRejectedValueOnce(new Error(\"retry\")).mockResolvedValue(undefined);\n   271\t  const dispose = vi.fn();\n   272\t  const lease = await acquireRemoteCredential({ acquire: () => ({ headers: { \"x-api-key\": \"secret\" } }), revoke, dispose }, { url: \"https://test/mcp\", requestId: \"test\" });\n   273\t  await expect(lease.release()).rejects.toThrow(/cleanup failed/);\n   274\t  expect(dispose).not.toHaveBeenCalled();\n   275\t  await expect(lease.release()).resolves.toBeUndefined();\n   276\t  await lease.release();\n   277\t  expect(revoke).toHaveBeenCalledTimes(2);\n   278\t  expect(dispose).toHaveBeenCalledOnce();\n   279\t});\n   280\tit(\"handles long authorization whitespace without backtracking\", async () => {\n   281\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   282\t  expect(() => redactRemoteCredential({ headers: { authorization: `Bearer${\" \".repeat(100000)}opaque` } }, \"opaque\")).toThrow(/value-size limit/);\n   283\t});\n   284\t\n   285\tit(\"retries authenticated handle revocation after a strict close fails\", async () => {\n   286\t  const fixture = await startAuthenticatedServer(\"retry-secret\");\n   287\t  const revoke = vi.fn().mockRejectedValueOnce(new Error(\"retry-secret\")).mockResolvedValue(undefined);\n   288\t  const dispose = vi.fn();\n   289\t  const target = authenticatedHttpTarget(fixture.url, { credential: { acquire: () => ({ headers: { authorization: \"Bearer retry-secret\" } }), revoke, dispose } });\n   290\t  try {\n   291\t    const handle = await target.open({ requestId: \"retry\", diagnostic: async () => {} } as any);\n   292\t    await expect(handle.close!()).rejects.toThrow(/cleanup failed/);\n   288\texport function redactTargetCredentials<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean; redactionMarker?: string } = {}): T {\n   289\t  const state = targetSecrets.get(target);\n   290\t  return scrubCredentials(value, new Set([...(state?.active.keys() ?? []), ...[...(state?.scopes ?? [])].flatMap((scope) => [...scope])]), options.preserveKeys, options.redactionMarker);\n   291\t}\n   292\t\n   293\t/** Redact authenticated conformance output using the acquired credential. */\n   294\texport function redactRemoteCredential<T>(credential: McpFnRemoteCredential, value: T, options: { preserveKeys?: boolean } = {}): T {\n   295\t  return scrubCredentials(value, credentialValues(credential.headers), options.preserveKeys);\n   296\t}\n   297\t\n   298\tconst MAX_CREDENTIAL_HEADERS = 32;\n   299\tconst MAX_CREDENTIAL_HEADER_BYTES = 16_384;\n   300\tconst MAX_CREDENTIAL_HEADER_VALUE_BYTES = 8_192;\n   301\tconst FORBIDDEN_CREDENTIAL_HEADERS = new Set([\n   302\t  \"connection\",\n   303\t  \"content-length\",\n   304\t  \"host\",\n   305\t  \"proxy-connection\",\n   306\t  \"te\",\n   307\t  \"trailer\",\n   308\t  \"transfer-encoding\",\n   309\t  \"upgrade\",\n   310\t]);\n   311\t\n   312\texport type McpFnRemoteCredentialKind = \"api-key\" | \"oauth\" | \"custom\";\n   313\t\n   314\texport interface McpFnRemoteCredential {\n   315\t  /** Credential headers are applied only to the fixed target origin. */\n   316\t  headers: HeadersInit;\n   317\t  kind?: McpFnRemoteCredentialKind;\n   318\t  label?: string;\n   319\t}\n   320\t\n   321\texport interface McpFnRemoteCredentialContext {\n   322\t  url: string;\n   323\t  requestId: string;\n   324\t  signal?: AbortSignal;\n   325\t}\n   326\t\n   327\t/**\n   328\t * Application-owned credential lifecycle for external MCP targets. McpFn\n   329\t * acquires once per target open, revokes before disposal, and never serializes\n   330\t * the returned headers into descriptors or reports. If acquisition rejects, the\n   331\t * provider must roll back its own partial resources; no lease has been returned.\n   332\t */\n   333\texport interface McpFnRemoteCredentialProvider {\n   334\t  acquire(\n   335\t    context: McpFnRemoteCredentialContext,\n   336\t  ): McpFnRemoteCredential | Promise<McpFnRemoteCredential>;\n   337\t  revoke?(\n   338\t    credential: McpFnRemoteCredential,\n   339\t    context: McpFnRemoteCredentialContext,\n   340\t  ): void | Promise<void>;\n   341\t  dispose?(\n   342\t    credential: McpFnRemoteCredential,\n   343\t    context: McpFnRemoteCredentialContext,\n   344\t  ): void | Promise<void>;\n   345\t}\n   346\t\n   347\texport interface McpFnRemoteCredentialLease {\n   348\t  credential: McpFnRemoteCredential;\n   349\t  release(): Promise<void>;\n   350\t  /** The lifecycle stage that most recently prevented credential release. */\n   351\t  cleanupPhase(): \"token-revocation\" | \"transport-close\";\n   352\t}\n   353\t\n   354\texport interface McpFnAuthenticatedHttpTargetOptions\n   355\t  extends Omit<McpFnStreamableHttpTargetOptions, \"authProvider\" | \"requestInit\"> {\n   356\t  credential: McpFnRemoteCredential | McpFnRemoteCredentialProvider;\n   357\t  requestInit?: Omit<RequestInit, \"headers\" | \"redirect\"> & { headers?: HeadersInit };\n   358\t}\n   359\t\n   360\t/** Create a provider for an already-bounded API key or OAuth-derived token. */\n   361\texport function staticRemoteCredentialProvider(\n   362\t  credential: McpFnRemoteCredential,\n   363\t): McpFnRemoteCredentialProvider {\n   364\t  return { acquire: () => credential };\n   365\t}\n   366\t\n   367\t/** Acquire a credential and return an idempotent revoke-then-dispose lease. */\n   368\texport async function acquireRemoteCredential(\n   369\t  source: McpFnRemoteCredential | McpFnRemoteCredentialProvider,\n   370\t  context: McpFnRemoteCredentialContext,\n     1\timport { describe, expect, it } from \"vitest\";\n     2\timport {\n     3\t  createMcpAuthorizationCompatibilityHandler,\n     4\t  normalizeMcpClientRegistration,\n     5\t  type McpFnNormalizedClientRegistration,\n     6\t} from \"@mcpfn/auth\";\n     7\t\n     8\timport {\n     9\t  createHostedAuthorizationFixtures,\n    10\t  runHostedAuthorizationRegression,\n    11\t} from \"../src/index.js\";\n    12\t\n    13\tconst TOKEN_RESPONSE_HEADERS = {\n    14\t  \"cache-control\": \"no-store\",\n    15\t  pragma: \"no-cache\",\n    16\t};\n    17\t\n    18\tfunction tokenJson(body: unknown, init: ResponseInit = {}): Response {\n    19\t  const headers = new Headers(init.headers);\n    20\t  for (const [name, value] of Object.entries(TOKEN_RESPONSE_HEADERS)) {\n    21\t    headers.set(name, value);\n    22\t  }\n    23\t  return Response.json(body, { ...init, headers });\n    24\t}\n    25\t\n    26\tdescribe(\"hosted role-3 regression harness\", () => {\n    27\t  it(\"keeps registration and request inputs independent across named hosts and grant errors\", async () => {\n    28\t    const issuer = \"https://login.example.com\";\n    29\t    const resource = \"https://mcp.example.com/mcp\";\n    30\t    const registrations = new Map<string, McpFnNormalizedClientRegistration>();\n    31\t    const handler = createMcpAuthorizationCompatibilityHandler({\n    32\t      issuer,\n    33\t      clients: {\n    34\t        resolve: async (clientId) => registrations.get(clientId) ?? null,\n    35\t      },\n    36\t      allowedResources: [resource],\n    37\t      capabilities: { requireRefreshResource: true },\n    38\t      supportedScopes: [\"mcp:read\"],\n    39\t      authorize: async (input) => {\n    40\t        const callback = new URL(input.redirectUri);\n    41\t        callback.searchParams.set(\"code\", `${input.client.clientId}-code`);\n    42\t        if (input.state) callback.searchParams.set(\"state\", input.state);\n    43\t        return Response.redirect(callback, 302);\n    44\t      },\n    45\t      tokenAuthority: {\n    46\t        exchangeAuthorizationCode: async () => ({\n    47\t          access_token: \"role3-access-token\",\n    48\t          token_type: \"Bearer\",\n    49\t          refresh_token: \"role3-refresh-token\",\n    50\t        }),\n    51\t        refreshToken: async () => ({\n    52\t          access_token: \"role3-refreshed-token\",\n    53\t          token_type: \"Bearer\",\n    54\t          refresh_token: \"role3-rotated-token\",\n    55\t        }),\n    56\t      },\n    57\t    });\n    58\t    const fixtures = createHostedAuthorizationFixtures({ issuer, resource });\n    59\t    const drift = fixtures.find((fixture) => fixture.id === \"chatgpt-unregistered-redirect\")!;\n    60\t    expect(drift.registration.metadata.redirect_uris).not.toContain(\n    61\t      drift.authorization.redirectUri,\n    62\t    );\n    63\t\n    64\t    const results = await runHostedAuthorizationRegression({\n    65\t      issuer,\n    66\t      async prepareRegistration(fixture) {\n    67\t        registrations.set(fixture.clientId, normalizeMcpClientRegistration(fixture));\n    68\t      },\n    69\t      request: async (request) => {\n    70\t        if (new URL(request.url).pathname.endsWith(\"token\")) {\n    71\t          const body = new URLSearchParams(await request.clone().text());\n    72\t          if (body.get(\"grant_type\") === \"authorization_code\") {\n    73\t            expect(body.get(\"code\")).toBe(`${body.get(\"client_id\")}-code`);\n    74\t          }\n    75\t        }\n    76\t        return handler(request);\n    77\t      },\n    78\t    }, fixtures);\n    79\t\n    80\t    expect(results).toHaveLength(6);\n    81\t    expect(results.filter((result) => result.status !== \"passed\")).toEqual([]);\n    82\t    expect(results).toEqual(expect.arrayContaining([\n    83\t      expect.objectContaining({\n    84\t        id: \"claude-client-metadata-extensible-grants\",\n    85\t        phase: \"token-refresh\",\n    86\t      }),\n    87\t      expect.objectContaining({\n    88\t        id: \"chatgpt-unregistered-redirect\",\n    89\t        errorCode: \"invalid_request\",\n    90\t        phase: \"authorization-request\",\n    91\t      }),\n    92\t      expect.objectContaining({\n    93\t        id: \"actual-unsupported-token-grant\",\n    94\t        errorCode: \"unsupported_grant_type\",\n    95\t        phase: \"token-exchange\",\n    96\t      }),\n    97\t    ]));\n    98\t  });\n    99\t  it.each([\"throw\", \"no-redirect\", \"missing-code\", \"wrong-state\", \"wrong-callback\", \"empty-token\", \"token-redirect\"])(\"fails broken hosted flow: %s\", async (fault) => {\n   100\t    const issuer = \"https://login.example.com\";\n   101\t    const fixture = createHostedAuthorizationFixtures({ issuer, resource: \"https://mcp.example.com/mcp\" })[0]!;\n   102\t    const results = await runHostedAuthorizationRegression({\n   103\t      issuer, prepareRegistration: async () => {},\n   104\t      request: async (request) => {\n   105\t        if (fault === \"throw\") throw new Error(\"transport aborted\");\n   106\t        if (new URL(request.url).pathname.endsWith(\"authorize\")) {\n   107\t          if (fault === \"no-redirect\") return new Response(\"\", { status: 200 });\n   108\t          const callback = new URL(fault === \"wrong-callback\" ? \"https://evil.example/callback\" : fixture.authorization.redirectUri);\n   109\t          if (fault !== \"missing-code\") callback.searchParams.set(\"code\", \"real-code\");\n   110\t          callback.searchParams.set(\"state\", fault === \"wrong-state\" ? \"wrong\" : fixture.authorization.state);\n   111\t          return Response.redirect(callback, 302);\n   112\t        }\n   113\t        expect(request.redirect).toBe(\"manual\");\n   114\t        if (fault === \"token-redirect\") return Response.redirect(\"https://evil.example/token\", 307);\n   115\t        return tokenJson(fault === \"empty-token\" ? {} : { access_token: \"valid-token\", token_type: \"Bearer\", refresh_token: \"valid-refresh\" });\n   116\t      },\n   117\t    }, [fixture]);\n   118\t    expect(results[0]?.status).toBe(\"failed\");\n   119\t  });\n   120\t\n   121\t});\n   122\t\n   123\tit.each([\"status\", \"state\", \"destination\"])(\"rejects malformed OAuth rejection %s\", async (fault) => {\n   124\t  const issuer = \"https://login.example.com\";\n   125\t  const fixture = createHostedAuthorizationFixtures({ issuer, resource: \"https://mcp.example.com/mcp\" })[0]!;\n   126\t  fixture.expected = { outcome: \"rejected\", errorCode: \"invalid_request\" };\n   127\t  const results = await runHostedAuthorizationRegression({ issuer, prepareRegistration: async () => {},\n   128\t    request: async () => {\n   129\t      if (fault === \"status\") return Response.json({ error: \"invalid_request\" });\n   130\t      const callback = new URL(fault === \"destination\" ? \"https://evil.example/cb\" : fixture.authorization.redirectUri);\n   131\t      callback.searchParams.set(\"error\", \"invalid_request\");\n   132\t      callback.searchParams.set(\"state\", fault === \"state\" ? \"wrong\" : fixture.authorization.state);\n   133\t      return Response.redirect(callback, 302);\n   134\t    },\n   135\t  }, [fixture]);\n   136\t  expect(results[0]?.status).toBe(\"failed\");\n   137\t});\n   138\t\n   139\t\n   140\tit.each([304, 305])(\"rejects status %s as an OAuth error redirect\", async (status) => {\n   141\t  const issuer = \"https://login.example.com\";\n   142\t  const fixture = createHostedAuthorizationFixtures({ issuer, resource: \"https://mcp.example.com/mcp\" })[0]!;\n   143\t  fixture.expected = { outcome: \"rejected\", errorCode: \"invalid_request\" };\n   144\t  const callback = new URL(fixture.authorization.redirectUri);\n   145\t  callback.searchParams.set(\"error\", \"invalid_request\"); callback.searchParams.set(\"state\", fixture.authorization.state);\n   146\t  const results = await runHostedAuthorizationRegression({ issuer, prepareRegistration: async () => {}, request: async () => new Response(null, { status, headers: { location: callback.toString() } }) }, [fixture]);\n   147\t  expect(results[0]?.status).toBe(\"failed\");\n   148\t});\n   149\t\n   150\tit.each([400, 401, 403])(\"rejects a Location-only token error with status %s\", async (status) => {\n   151\t  const issuer = \"https://login.example.com\";\n   152\t  const fixture = createHostedAuthorizationFixtures({ issuer, resource: \"https://mcp.example.com/mcp\" }).find((item) => item.id === \"actual-unsupported-token-grant\")!;\n   153\t  const callback = new URL(fixture.authorization.redirectUri);\n   154\t  callback.searchParams.set(\"code\", \"test-code\"); callback.searchParams.set(\"state\", fixture.authorization.state);\n   155\t  const results = await runHostedAuthorizationRegression({ issuer, prepareRegistration: async () => {}, request: async (request) =>\n   156\t    new URL(request.url).pathname.endsWith(\"authorize\") ? Response.redirect(callback, 302) : new Response(null, { status, headers: { location: \"https://login.example.com/error?error=unsupported_grant_type\" } })\n   157\t  }, [fixture]);\n   158\t  expect(results[0]?.status).toBe(\"failed\");\n   159\t});\n   160\t\n   161\tit.each([[400, 'application/json', 'passed'], [400, 'Application/JSON; charset=utf-8', 'passed'], [401, 'application/json', 'failed'], [403, 'application/json', 'failed'], [400, 'text/notjson', 'failed']])('validates token rejection media type and status %s %s', async (status, contentType, outcome) => {\n   162\t  const issuer = \"https://login.example.com\";\n   163\t  const fixture = createHostedAuthorizationFixtures({ issuer, resource: \"https://mcp.example.com/mcp\" }).find(item => item.id === \"actual-unsupported-token-grant\")!;\n   164\t  const callback = new URL(fixture.authorization.redirectUri);\n   165\t  callback.searchParams.set(\"code\", \"test-code\"); callback.searchParams.set(\"state\", fixture.authorization.state);\n   166\t  const results = await runHostedAuthorizationRegression({ issuer, prepareRegistration: async () => {}, request: async request =>\n   167\t    new URL(request.url).pathname.endsWith(\"authorize\") ? Response.redirect(callback, 302) : new Response(JSON.stringify({ error: 'unsupported_grant_type' }), { status: status as number, headers: { 'content-type': contentType as string } })\n   168\t  }, [fixture]);\n   169\t  expect(results[0]?.status).toBe(outcome);\n   170\t});\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0b914-adb8-75d2-a690-fafe68c720b9","create_time":1789811633.664163}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
