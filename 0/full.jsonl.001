te","arguments":{"path":"/Users/serro/Documents/dev/n/audits/sf-docs-review-20260930/sequential-20261003T184612Z/PR-213/run-ssd-standalone-command.py","content":"\"\"\"Run in exactly3 admitted physical slots; ExtFn reuses the former DevFn directory, not a new root.\"\"\"\nimport pathlib,json,subprocess,os,shutil,datetime,sys,plistlib,hashlib\nA=pathlib.Path(__file__).resolve().parent;ad=json.loads((A/'ssd-routed-normal-install-admission.json').read_text());sa=json.loads((A/'standalone213-source-admission.json').read_text());S=pathlib.Path(sa['physicalRoot']);V=pathlib.Path(ad['candidate']);label,product,*command=sys.argv[1:];assert label and '/' not in label and product in sa['slots'] and command;cwd=pathlib.Path(sa['slots'][product]);assert cwd.resolve().is_relative_to(S) and not (S/'package.json').exists() and not (S/'node_modules').exists();assert (cwd/'package.json').read_bytes()==(V/product/'docs/package.json').read_bytes();assert not (S/'extfn/docs/node_modules').exists()\nfor name in ['.log','.receipt.json','.start.json']:assert not (A/(label+name)).exists(),'distinct labels required'\nd=plistlib.loads(subprocess.check_output(['diskutil','info','-plist','/Volumes/OS - Data']));assert d['VolumeUUID']==ad['volumeUUID'] and d['Writable'];paths=ad['paths'];env=os.environ.copy();env.update({'npm_config_cache':paths['cache'],'TMPDIR':paths['tmp']+'/','TMP':paths['tmp'],'TEMP':paths['tmp'],'npm_config_devdir':paths['devdir'],'XDG_CACHE_HOME':paths['xdg'],'WRANGLER_SEND_METRICS':'false','PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD':'1','TURBO_TELEMETRY_DISABLED':'1','NEXT_TELEMETRY_DISABLED':'1'})\nfor path in paths.values():assert pathlib.Path(path).stat().st_dev==cwd.stat().st_dev and pathlib.Path(path).resolve().is_relative_to(pathlib.Path('/Volumes/OS - Data')) and os.access(path,os.W_OK)\nassert shutil.disk_usage(cwd).free/2**30>=15;sha=lambda f:hashlib.sha256(f.read_bytes()).hexdigest() if f.is_file() else None;receipt={'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'command':command,'cwd':str(cwd),'context':'genuine-standalone-'+product,'physicalSlotName':cwd.parent.name,'standaloneLockBefore':sha(cwd/'package-lock.json'),'rootLockBefore':sha(V/'package-lock.json'),'ssdFreeGiB':shutil.disk_usage(cwd).free/2**30,'noRootPackageOrParentNodeModules':True,'exactlyThreePhysicalSlots':True};(A/(label+'.start.json')).write_text(json.dumps(receipt,indent=2)+'\\n')\nwith (A/(label+'.log')).open('w') as out:r=subprocess.run(command,cwd=cwd,env=env,stdout=out,stderr=subprocess.STDOUT)\nreceipt.update({'completedAt':datetime.datetime.now(datetime.timezone.utc).isoformat(),'exitCode':r.returncode,'standaloneLockAfter':sha(cwd/'package-lock.json'),'rootLockAfter':sha(V/'package-lock.json'),'ssdFreeGiBAfter':shutil.disk_usage(cwd).free/2**30});(A/(label+'.receipt.json')).write_text(json.dumps(receipt,indent=2)+'\\n');assert receipt['rootLockBefore']==receipt['rootLockAfter'];print(json.dumps(receipt,indent=2));raise SystemExit(r.returncode)\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":587,"output":1194,"cacheRead":209920,"cacheWrite":0,"reasoning":362,"totalTokens":211701,"cost":{"input":0.001174,"output":0.011940000000000001,"cacheRead":0.020992,"cacheWrite":0,"total":0.034106}},"stopReason":"toolUse","timestamp":1791351551305,"responseId":"resp_055fb762f51dfcfc016ac5db007f9c87d0bb3054c0e91a8b0f","rawStopReason":"completed","thinkingLevel":"high"}}
