rrayEntries: 20,\n    46\t    maxObjectEntries: 20,\n    47\t    maxStringLength: 1_024,\n    48\t  }));\n    49\t}\n    50\t\n    51\tfunction resourceDenied(\n    52\t  layer: McpFnFailureLayer,\n    53\t  record: Record<string, unknown>,\n    54\t  cause: Record<string, unknown> | undefined,\n    55\t): boolean {\n    56\t  if (layer === \"authorization-server\") return false;\n    57\t  return [cause?.code, cause?.status, record.code, record.status]\n    58\t    .some(value => [401, 403].includes(Number(value)));\n    59\t}\n    60\t\n    61\texport function normalizeMcpFnReportFailure(\n    62\t  error: unknown,\n    63\t  fallbackPhase?: McpFnDiagnosticPhase | \"scenario\" | \"upstream-conformance\",\n    64\t): McpFnReportFailure {\n    65\t  const redacted = redactOAuthValue(error, {\n    66\t    maxDepth: 6,\n    67\t    maxArrayEntries: 50,\n    68\t    maxObjectEntries: 50,\n    69\t    maxStringLength: 2_048,\n    70\t  });\n    71\t  const record = objectRecord(redacted) ?? {};\n    72\t  const phase = stringField(record.phase) ?? fallbackPhase;\n    73\t  const details = objectRecord(record.details);\n    74\t  let message = stringField(record.message) ?? String(\n    75\t    redactOAuthValue(error instanceof Error ? error.message : String(error)),\n    76\t  );\n    77\t  const causeRecord = redactedFailureCause(error);\n    78\t  const causeMessage = stringField(causeRecord?.message);\n    79\t  if (causeMessage && !message.includes(causeMessage)) message = `${message}: ${causeMessage}`;\n    80\t  const combinedDetails = causeRecord ? { ...details, cause: causeRecord } : details;\n    81\t  const layer = failureLayer(phase);\n    82\t  const deniedByResource = resourceDenied(layer, record, causeRecord);\n    83\t  return {\n    84\t    name: stringField(record.name) ?? \"Error\",\n    85\t    message,\n    86\t    layer: deniedByResource ? \"resource-server\" : layer,\n    87\t    ...(stringField(record.code) ? { code: stringField(record.code)! } : {}),\n    88\t    ...(phase ? { phase } : {}),\n    89\t    ...(combinedDetails ? { details: combinedDetails } : {}),\n    90\t  };\n    91\t}\n    92\t\n    93\t/** Serialize a redacted target-suite report as bounded JUnit XML. */\n    94\texport function createMcpFnTargetSuiteJUnit(\n    95\t  report: McpFnTargetSuiteReport,\n    96\t  options: McpFnJunitOptions = {},\n    97\t): string {\n    98\t  const maxBytes = options.maxBytes ?? 1_048_576;\n    99\t  validateArtifactCap(maxBytes);\n   100\t  const safe = redactOAuthValue(report, {\n   101\t    maxDepth: 10,\n   102\t    maxArrayEntries: 1_000,\n   103\t    maxObjectEntries: 200,\n   104\t    maxStringLength: 4_096,\n   105\t  }) as unknown as McpFnTargetSuiteReport;\n   106\t  // Redaction appends a string sentinel when an array exceeds its cap.\n   107\t  const results = safe.results.filter((result) => result && typeof result === \"object\" && typeof result.name === \"string\");\n   108\t  const omitted = report.results.length - results.length;\n   109\t  const cases = results.map((result) => {\n   110\t    const duration = Math.max(0, result.durationMs ?? 0) / 1_000;\n   111\t    let failure = \"\";\n   112\t    if (result.status !== \"passed\") {\n   113\t      const failureType = result.status === \"failed\" ? \"scenario\" : \"incomplete\";\n   114\t      failure = junitFailure(result.error ?? `Scenario ${result.status}`, failureType);\n   115\t    }\n   235\t  exportScenario(\n   236\t    name: string,\n   237\t    operation: McpFnInspectorOperation,\n   238\t    result: McpFnInspectorOperationResult,\n   239\t  ): McpFnExportedScenario {\n   240\t    const scenario = createMcpFnScenario(name, operation, result);\n   241\t    // Top-level scenario keys are authored schema, not payload. If a credential\n   242\t    // collides with one of them, no replayable typed artifact can be emitted.\n   243\t    for (const key of Object.keys(scenario)) {\n   244\t      this.client.preserveArtifactStructure(key);\n