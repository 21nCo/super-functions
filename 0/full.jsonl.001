{"timestamp":"2026-09-19T12:22:51.890Z","ordinal":5370,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0b99e-90f2-7490-a34a-5f19dfd53c94","call_id":"call_eVDwtaPUFPaqoic6QgcOa1AC","output":[{"type":"input_text","text":"Script completed\nWall time 1.0 seconds\nOutput:\n"},{"type":"input_text","text":"   470\t    guard.assert(event.outcome);\n   471\t    if (event.target) assertTargetStructure(event.target, guard);\n   472\t  }\n   473\t  for (const result of report.results) {\n   474\t    assertStructureKeys(result, guard);\n   475\t    guard.assert(result.status);\n   476\t    if (result.sideEffect) guard.assert(result.sideEffect);\n   477\t  }\n   478\t}\n   479\t\n   480\tasync function closeSuiteClient(client: McpFnTestClient | undefined): Promise<{\n   481\t  cleanupFailure?: McpFnReportFailure;\n   482\t  retainedCleanup?: () => Promise<void>;\n   483\t}> {\n   484\t  try {\n   485\t    await client?.close();\n   486\t    return {};\n   487\t  } catch (error) {\n   488\t    let retainedCleanup: (() => Promise<void>) | undefined;\n   489\t    if (error instanceof McpFnTestClientCleanupError) {\n   490\t      retainedCleanup = () => error.retryCleanup();\n   491\t    } else if (client) {\n   492\t      retainedCleanup = () => client.close();\n   493\t    }\n   494\t    const terminal = error instanceof McpFnTestClientCleanupError && error.cause !== undefined\n   495\t      ? error.cause\n   496\t      : error;\n   497\t    const phase = terminal && typeof terminal === \"object\" &&\n   498\t        (terminal as { phase?: unknown }).phase === \"token-revocation\"\n   499\t      ? \"token-revocation\"\n   500\t      : \"transport-close\";\n   501\t    return {\n   502\t      retainedCleanup,\n   503\t      cleanupFailure: normalizeMcpFnReportFailure({\n   504\t        name: \"CleanupError\",\n   505\t        message: \"Target cleanup failed\",\n   506\t        code: \"MCPFN_TARGET_CLEANUP_FAILED\",\n   507\t        phase,\n   508\t      }),\n   509\t    };\n   510\t  }\n   511\t}\n   512\t\n   513\tasync function runTargetSuite(options: RunMcpFnTargetSuiteOptions): Promise<McpFnTargetSuiteReport> {\n   514\t  const maxTimelineEvents = options.maxTimelineEvents ?? 500;\n   515\t  if (!Number.isInteger(maxTimelineEvents) || maxTimelineEvents < 1) {\n   516\t    throw new Error(\"maxTimelineEvents must be a positive integer\");\n   517\t  }\n   518\t  const maxReportBytes = options.maxReportBytes ?? 1_048_576;\n   519\t  validateReportCap(maxReportBytes);\n   520\t  const consumerDiagnostic = options.client?.diagnostics;\n   521\t  const diagnostics = new SuiteDiagnosticCollector(\n   522\t    maxTimelineEvents,\n   523\t    maxReportBytes,\n   524\t    options.target,\n   525\t    consumerDiagnostic,\n   526\t  );\n   527\t  let client: McpFnTestClient | undefined;\n   528\t  let manifestChecked = false;\n   529\t  let failure: McpFnReportFailure | undefined;\n   530\t  let execution: SuiteExecution = { results: [] };\n   531\t  try {\n   532\t    client = McpFnTestClient.createTarget(\n   533\t      options.target,\n   534\t      options.clientInfo ?? { name: \"mcpfn-suite\", version: \"0.0.1\" },\n   535\t      {\n   536\t        ...options.client,\n   537\t        diagnostics: event => diagnostics.record(client, event),\n   538\t      },\n   539\t    );\n   540\t    diagnostics.captureBaseline(client);\n   541\t    await client.session.connect();\n   542\t    ({ execution, manifestChecked } = await executeConnectedSuite(client, options));\n   543\t  } catch (error) {\n   544\t    failure = safeTargetFailure(options.target, error);\n   545\t  }\n   546\t  // Custom hooks may depend on credentials cleared by close. Capture payload\n   547\t  // projection and structural safety while the session still owns that state,\n   548\t  // but never let either operation bypass the sole cleanup boundary.\n   549\t  let projection: SuiteProjection = {\n   550\t    target: { kind: \"custom\" }, execution, failure: \"serialization\",\n   551\t  };\n   552\t  let structureGuard: SuiteStructureGuard = {\n   553\t    assert: () => { throw new McpFnStructuralCredentialCollisionError(); },\n   554\t  };\n   555\t  let closeResult: Awaited<ReturnType<typeof closeSuiteClient>> = {};\n   556\t  try {\n   557\t    projection = projectSuiteArtifacts(options, client, execution);\n   558\t    execution = projection.execution;\n   559\t    structureGuard = captureSuiteStructureGuard(options.target, projection, diagnostics);\n   560\t  } finally {\n   561\t    closeResult = await closeSuiteClient(client);\n   562\t  }\n   563\t  const { cleanupFailure: closeFailure, retainedCleanup } = closeResult;\n   564\t  diagnostics.captureUnobserved(client);\n   565\t  let cleanupFailure = closeFailure;\n   566\t  cleanupFailure ??= diagnostics.cleanupFailure;\n   567\t  failure ??= cleanupFailure;\n   568\t  const results = execution.results;\n   569\t  const failed = results.filter((result) => result.status === \"failed\").length;\n   570\t  const incomplete = results.filter((result) => result.status === \"incomplete\").length;\n   571\t  const droppedObservedEvents = results.reduce(\n   572\t    (total, result) => total + (result.droppedObservedEvents ?? 0),\n   573\t    0,\n   574\t  );\n   575\t  const redactionOmittedObservedEvents = results.reduce(\n   576\t    (total, result) => total + (result.redactionOmittedObservedEvents ?? 0),\n   577\t    0,\n   578\t  );\n   579\t  const overflowedObservedEvents = droppedObservedEvents - redactionOmittedObservedEvents;\n   580\t  const artifactIncomplete = Boolean(failure) || incomplete > 0 ||\n   581\t    diagnostics.dropped > 0 ||\n   582\t    droppedObservedEvents > 0;\n   583\t  const report: McpFnTargetSuiteReport = {\n   584\t    formatVersion: 1,\n   585\t    kind: \"mcpfn.target-suite-report\",\n   586\t    status: artifactIncomplete ? \"incomplete\" : \"complete\",\n   587\t    runtime: {\n   588\t      node: process.version,\n   589\t      scenarioFormatVersion: 1,\n   590\t      reportSchemaVersion: MCPFN_REPORT_SCHEMA_VERSION,\n   591\t      packages: { testing: MCPFN_TESTING_VERSION },\n   592\t    },\n   593\t    ok: failed === 0 && !artifactIncomplete,\n   594\t    target: projection.target,\n   595\t    server: execution.server,\n   596\t    capabilities: execution.capabilities,\n   597\t    manifestChecked,\n   598\t    ...(projection.manifestHash === undefined ? {} : { manifestHash: projection.manifestHash }),\n   599\t    total: results.length,\n   600\t    passed: results.length - failed - incomplete,\n   601\t    failed,\n   602\t    incomplete,\n   603\t    droppedResults: 0,\n   604\t    droppedObservedEvents,\n   605\t    ...(redactionOmittedObservedEvents > 0 ? { redactionOmittedObservedEvents } : {}),\n   606\t    ...(failure || diagnostics.dropped > 0 || droppedObservedEvents > 0\n   607\t      ? {\n   608\t        incompleteReason: [\n   609\t          ...(failure ? [`${failure.layer}: ${failure.message}`] : []),\n   610\t          ...(cleanupFailure ? [`Cleanup: ${cleanupFailure.message}`] : []),\n   611\t          ...(diagnostics.serializationFailed ? [\"Diagnostic timeline contained non-JSON data\"] : []),\n   612\t          ...(diagnostics.redactionFailed ? [\"Diagnostic timeline redaction failed; original events omitted\"] : []),\n   613\t          ...(diagnostics.countExceeded ? [\"Diagnostic timeline exceeded maxTimelineEvents\"] : []),\n   614\t          ...(diagnostics.bytesExceeded ? [\"Diagnostic timeline exceeded maxReportBytes\"] : []),\n   615\t          ...(redactionOmittedObservedEvents > 0\n   616\t            ? [\"Observed client events were omitted because credential redaction failed\"]\n   617\t            : []),\n   618\t          ...(overflowedObservedEvents > 0\n   619\t            ? [\"Observed client events exceeded maxObservedEvents\"]\n   620\t            : []),\n   621\t        ].join(\"; \"),\n   622\t      }\n   623\t      : {}),\n   624\t    ...(failure ? { failure } : {}),\n   625\t    timeline: diagnostics.timeline,\n   626\t    droppedTimelineEvents: diagnostics.dropped,\n   627\t    results,\n   628\t  };\n   629\t  let finalized: McpFnTargetSuiteReport;\n   630\t  try {\n   631\t    assertSuiteReportStructure(report, structureGuard);\n   632\t    if (projection.failure) throw new Error(\"Report payload projection failed\");\n   633\t    // Custom redaction already completed before cleanup. Built-in report scopes\n   634\t    // remain active here for bounded final serialization.\n   635\t    finalized = enforceReportCap(redactTargetCredentials(options.target, report, { preserveKeys: true }), maxReportBytes);\n   636\t  } catch (error) {\n   637\t    if (error instanceof McpFnStructuralCredentialCollisionError) {\n   638\t      const failure = new McpFnClientError(\n   639\t        \"MCPFN_OPERATION_FAILED\",\n   640\t        \"Target report cannot be serialized because a credential conflicts with required artifact structure\",\n   641\t        { phase: \"capability-operation\" },\n   642\t      );\n   643\t      if (retainedCleanup) {\n   644\t        throw new McpFnTargetSuiteArtifactCleanupError(retainedCleanup, failure);\n   645\t      }\n   646\t      throw failure;\n   647\t    }\n   648\t    finalized = enforceReportCap({ ...report, ok: false, status: \"incomplete\",\n   649\t      incompleteReason: reportProjectionFailureReason(error, projection.failure),\n   650\t      target: { kind: \"custom\" }, server: undefined, capabilities: undefined, manifestHash: undefined,\n   651\t      failure: undefined, results: [], timeline: [],\n   652\t      droppedResults: report.results.length, droppedTimelineEvents: report.droppedTimelineEvents + report.timeline.length,\n   653\t    }, maxReportBytes);\n   654\t  }\n   655\t  if (retainedCleanup) throw new McpFnTargetSuiteCleanupError(finalized, retainedCleanup);\n   656\t  return finalized;\n   657\t}\n   658\t\n   659\tfunction enforceReportCap(\n   660\t  report: McpFnTargetSuiteReport,\n   661\t  maxBytes: number,\n   662\t): McpFnTargetSuiteReport {\n   663\t  validateReportCap(maxBytes);\n   664\t  const bounded = structuredClone(report);\n   665\t  if (jsonBytes(bounded) > maxBytes) {\n   666\t    bounded.ok = false;\n   667\t    bounded.status = \"incomplete\";\n   668\t    bounded.incompleteReason = \"Report content exceeded maxReportBytes and was truncated\";\n   669\t  }\n   670\t  while (jsonBytes(bounded) > maxBytes && bounded.results.length > 0) {\n   671\t    bounded.results.pop();\n   672\t    bounded.droppedResults += 1;\n   673\t  }\n   674\t  if (jsonBytes(bounded) > maxBytes) {\n   675\t    bounded.target = { kind: report.target.kind };\n   676\t    bounded.server = undefined;\n   677\t    bounded.capabilities = undefined;\n   678\t    bounded.timeline = [];\n   679\t    bounded.droppedTimelineEvents += report.timeline.length;\n   680\t    if (bounded.failure) {\n   681\t      bounded.failure.details = undefined;\n   682\t      bounded.failure.message = \"Target operation failed; details omitted to fit report budget\";\n   683\t    }\n   684\t  }\n   685\t  if (bounded.droppedResults > 0 || jsonBytes(bounded) > maxBytes) {\n   686\t    bounded.ok = false;\n   687\t    bounded.status = \"incomplete\";\n   688\t    bounded.incompleteReason = \"Report content exceeded maxReportBytes and was truncated\";\n   689\t  }\n   690\t  if (jsonBytes(bounded) > maxBytes) {\n   691\t    throw new Error(\"The minimum target suite report exceeds maxReportBytes\");\n   692\t  }\n   693\t  return bounded;\n   694\t}\n   695\t\n   696\tfunction validateReportCap(maxBytes: number): void {\n   697\t  if (!Number.isInteger(maxBytes) || maxBytes < 1_024) {\n   698\t    throw new Error(\"maxReportBytes must be an integer of at least 1024\");\n   699\t  }\n   700\t}\n   701\t\n   702\tfunction jsonBytes(value: unknown): number {\n   703\t  return new TextEncoder().encode(JSON.stringify(value)).byteLength;\n   704\t}\n    35\