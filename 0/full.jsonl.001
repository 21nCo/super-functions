{"type":"message","id":"18c60d54","parentId":"da314f86","timestamp":"2026-10-07T05:53:22.869Z","message":{"role":"toolResult","toolCallId":"call_VHaiOSFaREeqDGTGuj5qeYym|fc_055fb762f51dfcfc016ac5de524d1887d09cef529dba709f25","toolName":"read","content":[{"type":"text","text":"import pathlib,json,subprocess,tarfile,os,datetime\nA=pathlib.Path(__file__).resolve().parent;ad=json.loads((A/'ssd-routed-normal-install-admission.json').read_text());V=pathlib.Path(ad['candidate']);S=pathlib.Path(json.loads((A/'standalone212-source-admission.json').read_text())['physicalRoot']);paths=ad['paths'];env=os.environ.copy();env.update({'npm_config_cache':paths['cache'],'TMPDIR':paths['tmp']+'/','npm_config_devdir':paths['devdir'],'XDG_CACHE_HOME':paths['xdg'],'WRANGLER_SEND_METRICS':'false','PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD':'1','PR209_BROWSER_TOOL_OWNER':str(V)})\narchive=A/'current212-offline-cf-emitted-workers.tar.gz';assert not archive.exists()\nwith tarfile.open(archive,'w:gz') as tar:\n for product in ['devfn','authfn','filefn']:\n  for sub in ['.svelte-kit/cloudflare','.cloudflare-docs-wrangler.jsonc']:\n   p=V/product/'docs'/sub;assert p.exists(),p;tar.add(p,arcname=product+'/docs/'+sub)\nblogInputs=json.loads((A.parent/'PR-209/controlled-current-input-contents.json').read_text());blogInputs={p:body.replace('PRIVATE_209_BLOG_TOKEN','PRIVATE_212_BLOG_TOKEN') for p,body in blogInputs.items()};inputs=dict(blogInputs)\nfor product in ['devfn','authfn','filefn']:\n prefix=product+'/docs/content/docs/'\n inputs[prefix+'__native212_flat.md']='---\\ntitle: Native212 Flat\\n---\\n[Related sibling](./__native212_sibling.md)\\n'\n inputs[prefix+'__native212_flat/child.md']='---\\ntitle: Native212 Child\\n---\\nA descendant does not turn flat.md into index.md.\\n'\n inputs[prefix+'__native212_sibling.md']='---\\ntitle: Native212 Sibling\\n---\\nRelated sibling page.\\n'\n inputs[prefix+'__native212_index/index.md']='---\\ntitle: Native212 Index\\n---\\n[Related sibling](../__native212_sibling.md)\\n'\n inputs[prefix+'__native212_unicode/主.md']='---\\ntitle: Native212 Unicode\\n---\\nActual published SDK source identity.\\n'\n inputs[prefix+'__native212_private.md']='---\\ntitle: Unrelated private payload marker\\n---\\nPRIVATE_212_DOC_TOKEN\\n'\n(A/'controlled212-inputs.json').write_text(json.dumps(inputs,indent=2)+'\\n');results=[]\ndef run(label,command,cwd):\n with (A/(label+'.log')).open('w') as out:r=subprocess.run(command,cwd=cwd,env=env,stdout=out,stderr=subprocess.STDOUT)\n results.append({'label':label,'command':command,'exitCode':r.returncode});assert r.returncode==0,label\ntry:\n for context,tree in [('root',V),('standalone',S)]:\n  assert all(not (tree/name).exists() for name in inputs)\n  try:\n   for name,body in inputs.items():p=tree/name;p.parent.mkdir(parents=True,exist_ok=True);p.write_text(body)\n   for product in ['devfn','authfn','filefn']:run(f'controlled-{context}-{product}-build',['npm','run','build'],tree/product/'docs')\n   run(f'controlled-{context}-native-flat-index-payload-errors',['node',str(A/'verify-controlled-native-docs.mjs'),str(tree)],tree)\n   run(f'controlled-{context}-native-blog-rss-drafts-source-unicode',['node',str(A.parent/'PR-207/verify-native-blog-contract.mjs'),str(tree)],tree)\n   for product in ['authfn','filefn']:run(f'controlled-{context}-{product}-browser-hydration-navigation-titles',['node',str(A.parent/'PR-209/verify-blog-titles.mjs'),str(tree),product,'/docs/blog'],tree/product/'docs')\n  finally:\n   for name,body in inputs.items():\n    p=tree/name\n    if p.exists():assert p.read_text()==body;p.unlink()\n   assert all(not (tree/name).exists() for name in inputs)\n   results.append({'context':context,'controlled28FilesRestoredOriginalAbsence':True})\nfinally:\n (A/'controlled212-current-contexts-results.json').write_text(json.dumps({'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'results':results,'ownedInputsPerContext':len(inputs),'cfArchive':str(archive),'executionWorktreeMutated':False,'pristineRebuildAfterRestorationStillRequired':True},indent=2)+'\\n')\nprint('Both real current owner contexts pass controlled SDK/Kit/link/error/payload/Blog/browser checks; inputs restored absent')\n"}],"isError":false,"timestamp":1791352402869}}
