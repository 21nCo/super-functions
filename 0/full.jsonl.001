ers/serro/Documents/dev/n/audits/sf-docs-review-20260930/sequential-20261003T184612Z/PR-212/run-ssd-standalone-command.py","content":"\"\"\"Run a genuine standalone command in one of exactly3 admitted existing SSD contexts.\"\"\"\nimport pathlib,json,subprocess,os,shutil,datetime,sys,plistlib,hashlib\nA=pathlib.Path(__file__).resolve().parent;ad=json.loads((A/'ssd-routed-normal-install-admission.json').read_text());S=pathlib.Path(json.loads((A/'standalone212-source-admission.json').read_text())['physicalRoot']);V=pathlib.Path(ad['candidate'])\nlabel,product,*command=sys.argv[1:];assert label and '/' not in label and product in ['devfn','authfn','filefn'] and command\ncwd=S/product/'docs';assert cwd.resolve().is_relative_to(S) and not (S/'package.json').exists() and not (S/'node_modules').exists();assert (cwd/'package.json').read_bytes()==(V/product/'docs/package.json').read_bytes()\nreceiptPath=A/(label+'.receipt.json');logPath=A/(label+'.log');assert not receiptPath.exists() and not logPath.exists(),'distinct attempt labels required'\nd=plistlib.loads(subprocess.check_output(['diskutil','info','-plist','/Volumes/OS - Data']));assert d['VolumeUUID']==ad['volumeUUID'] and d['Writable']\npaths=ad['paths'];env=os.environ.copy();env.update({'npm_config_cache':paths['cache'],'TMPDIR':paths['tmp']+'/','TMP':paths['tmp'],'TEMP':paths['tmp'],'npm_config_devdir':paths['devdir'],'XDG_CACHE_HOME':paths['xdg'],'WRANGLER_SEND_METRICS':'false','PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD':'1','TURBO_TELEMETRY_DISABLED':'1','NEXT_TELEMETRY_DISABLED':'1'})\nfor p in paths.values():assert pathlib.Path(p).stat().st_dev==cwd.stat().st_dev and pathlib.Path(p).resolve().is_relative_to(pathlib.Path('/Volumes/OS - Data')) and os.access(p,os.W_OK)\nassert shutil.disk_usage(cwd).free/2**30>=15\nsha=lambda f:hashlib.sha256(f.read_bytes()).hexdigest() if f.is_file() else None\nreceipt={'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'command':command,'cwd':str(cwd),'context':'genuine-standalone-'+product,'standaloneLockBefore':sha(cwd/'package-lock.json'),'rootLockBefore':sha(V/'package-lock.json'),'ssdFreeGiB':shutil.disk_usage(cwd).free/2**30,'noRootPackageOrParentNodeModules':True};(A/(label+'.start.json')).write_text(json.dumps(receipt,indent=2)+'\\n')\nwith logPath.open('w') as out:r=subprocess.run(command,cwd=cwd,env=env,stdout=out,stderr=subprocess.STDOUT)\nreceipt.update({'completedAt':datetime.datetime.now(datetime.timezone.utc).isoformat(),'exitCode':r.returncode,'standaloneLockAfter':sha(cwd/'package-lock.json'),'rootLockAfter':sha(V/'package-lock.json'),'ssdFreeGiBAfter':shutil.disk_usage(cwd).free/2**30});assert receipt['rootLockBefore']==receipt['rootLockAfter'];receiptPath.write_text(json.dumps(receipt,indent=2)+'\\n');print(json.dumps(receipt,indent=2));raise SystemExit(r.returncode)\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":326,"output":1162,"cacheRead":247680,"cacheWrite":0,"reasoning":369,"totalTokens":249168,"cost":{"input":0.000652,"output":0.01162,"cacheRead":0.024768000000000002,"cacheWrite":0,"total":0.037040000000000003}},"stopReason":"toolUse","timestamp":1791223841132,"responseId":"resp_055fb762f51dfcfc016ac3e821dcc087d08317e110ca5690a7","rawStopReason":"completed","thinkingLevel":"high"}}
