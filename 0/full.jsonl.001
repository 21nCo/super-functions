stopped, and stop without mutation.\\\\n5. If a reset-trigger assessment cannot establish a complete coordinated repair, or an external dependency blocks further progress, record the blocker, disable and verify this automation so it cannot repeat unsafe mutations, report the blocker, and stop.\\\\n\\\\nEnd every nonterminal run with the hosted workflow's explicit result buckets and: `One review round is complete. No post-push refetch or additional review loop was performed.`\\\",\\n      \\\"precheck\\\": null,\\n      \\\"agentId\\\": \\\"codex\\\",\\n      \\\"runContext\\\": {\\n        \\\"kind\\\": \\\"workspace-run\\\",\\n        \\\"projectId\\\": \\\"github:21nco/super-functions\\\",\\n        \\\"hostId\\\": \\\"local\\\",\\n        \\\"projectHostSetupId\\\": \\\"940d3c77-482f-4eb2-8be7-88b4976ed269\\\",\\n        \\\"repoId\\\": \\\"940d3c77-482f-4eb2-8be7-88b4976ed269\\\",\\n        \\\"path\\\": \\\"/Users/serro/Documents/dev/n/superfunctions\\\"\\n      },\\n      \\\"sourceContext\\\": {\\n        \\\"kind\\\": \\\"task-source\\\",\\n        \\\"provider\\\": \\\"github\\\",\\n        \\\"projectId\\\": \\\"github:21nco/super-functions\\\",\\n        \\\"hostId\\\": \\\"local\\\",\\n        \\\"projectHostSetupId\\\": \\\"940d3c77-482f-4eb2-8be7-88b4976ed269\\\",\\n        \\\"repoId\\\": \\\"940d3c77-482f-4eb2-8be7-88b4976ed269\\\",\\n        \\\"providerIdentity\\\": {\\n          \\\"provider\\\": \\\"github\\\",\\n          \\\"owner\\\": \\\"21nCo\\\",\\n          \\\"repo\\\": \\\"super-functions\\\"\\n        },\\n        \\\"accountLabel\\\": null\\n      },\\n      \\\"projectId\\\": \\\"940d3c77-482f-4eb2-8be7-88b4976ed269\\\",\\n      \\\"executionTargetType\\\": \\\"local\\\",\\n      \\\"executionTargetId\\\": \\\"local\\\",\\n      \\\"schedulerOwner\\\": \\\"local_host_service\\\",\\n      \\\"workspaceMode\\\": \\\"existing\\\",\\n      \\\"workspaceId\\\": \\\"940d3c77-482f-4eb2-8be7-88b4976ed269::/Users/serro/Documents/dev/n/worktree