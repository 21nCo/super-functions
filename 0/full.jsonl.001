igest() if p.is_file() else None,'mode':stat.S_IMODE(p.stat().st_mode) if p.is_file() else None,'link':p.is_symlink()}\n return out\nl=json.loads((R/'parent-ledger.json').read_text());assert l['execution']['current_sequential_sweep']['active_pr']==213 and l['digest']=='sha256:b6a6e7a8c670bc5ab12540910401d153e8eedd533d89fd1a1925bc9979112726';assert l['prs']['212']['current_sequential_round']['publication_count']==1\nassert identity['state']=='OPEN' and identity['baseRefName']=='dev' and not identity['isCrossRepository'];assert branch=='codex/docs-extfn-20260926' and head=='f15540d26c2329203c626ccb51eb9108c5bebd84';assert 'account thyaravind' in (A/'auth-context.log').read_text() and 'Active account: true' in (A/'auth-context.log').read_text()\nassert g('remote','get-url','origin')=='https://github.com/21nCo/super-functions.git';assert not g('status','--porcelain');assert g('rev-parse','HEAD')==json.loads((A.parent/'PR-212/publication.json').read_text())['localHead']\nbefore=snapshot();(A/'all-protected-before-switch.json').write_text(json.dumps(before,indent=2)+'\\n');(A/'execution-protected-before-switch.json').write_text(json.dumps({n:x['sha256'] for n,x in before.items()},indent=2)+'\\n');(A/'pre-switch-worktrees.txt').write_text(g('worktree','list','--porcelain')+'\\n')\n(A/'exact-branch-fetch.log').write_text(g('fetch','origin','refs/heads/'+branch)+'\\n');assert g('rev-parse','FETCH_HEAD')==head\nassert g('rev-parse','refs/heads/'+branch)==head,'existing local branch diverged; stop without ref surgery'\n(A/'exact-checkout.log').write_text(g('switch',branch)+'\\n');assert g('rev-parse','HEAD')==head and g('branch','--show-current')==branch and not g('status','--porcelain');assert snapshot()==before\n(A/'exact-checkout-admission.json').write_text(json.dumps({'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'head':head,'branch':branch,'execution':str(T),'clean':True,'allProtectedBytesModesAndLinksUnchanged':True,'fetchCount':1,'forceOrWorktreeBypass':