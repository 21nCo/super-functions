  retryCleanup(): Promise\u003cvoid\u003e {\n    78\t    const owner = inspectorCleanupOwners.get(this);\n    79\t    if (!owner) return Promise.resolve();\n    80\t    if (owner.pending) return owner.pending;\n    81\t    const pending = Promise.resolve().then(owner.close).then(\n    82\t      () =\u003e { inspectorCleanupOwners.delete(this); },\n    83\t      () =\u003e { throw this; },\n    84\t    ).finally(() =\u003e { owner.pending = undefined; });\n    85\t    owner.pending = pending;\n    86\t    return pending;\n    87\t  }\n    88\t}\n    89\t\n    90\ttype CliCleanupError =\n    91\t  | McpFnTestClientCleanupError\n    92\t  | McpFnTargetSuiteCleanupError\n    93\t  | McpFnConformanceCleanupError\n    94\t  | McpFnInspectorCleanupError;\n    95\t\n    96\tfunction isCliCleanupError(error: unknown): error is CliCleanupError {\n    97\t  return error instanceof McpFnTestClientCleanupError ||\n    98\t    error instanceof McpFnTargetSuiteCleanupError ||\n    99\t    error instanceof McpFnConformanceCleanupError ||\n   100\t    error instanceof McpFnInspectorCleanupError;\n   101\t}\n   102\t\n   103\tasync function preserveCleanupOwner(\n   104\t  owner: CliCleanupError | undefined,\n   105\t  operation: () =\u003e Promise\u003cvoid\u003e,\n   106\t  failureMessage?: string,\n   107\t): Promise\u003cvoid\u003e {\n   108\t  try {\n   109\t    await operation();\n   110\t  } catch (error) {\n   111\t    if (owner) throw owner;\n   112\t    if (failureMessage) {\n   113\t      throw new McpFnClientError(\n   114\t        \"MCPFN_OPERATION_FAILED\",\n   115\t        failureMessage,\n   116\t        { phase: \"capability-operation\" },\n   117\t      );\n   118\t    }\n   119\t    throw error;\n   120\t  }\n   121\t}\n   122\t\n   123\texport async function runCli(\n   124\t  argv = process.argv.slice(2),\n   125\t  runOptions: CliRunOptions = {},\n   126\t): Promise\u003cnumber\u003e {\n   127\t  const cwd = runOptions.cwd ?? process.cwd();\n   128\t  const stdout = runOptions.stdout ?? ((text: string) =\u003e writeProcessOutput(process.stdout, text));\n   129\t  const stderr = runOptions.stderr ?? ((text: string) =\u003e writeProcessOutput(process.stderr, text));\n   130\t  let exitCode = 0;\n   131\t  const cli = cac(\"mcpfn\");\n   132\t\n   133\t  cli.command(\"manifest \u003csource\u003e\", \"Generate a canonical manifest from a server or registry module\")\n   134\t    .option(\"--output \u003cpath\u003e\", \"Write the manifest to a file\")\n   135\t    .option(\"--name \u003cname\u003e\", \"Server name when source exports a registry\")\n   136\t    .option(\"--version \u003cversion\u003e\", \"Server version when source exports a registry\")\n   137\t    .action(async (source: string, options: { output?: string; name?: string; version?: string }) =\u003e {\n   138\t      const info = options.name \u0026\u0026 options.version\n   139\t        ? { name: options.name, version: options.version }\n   140\t        : undefined;\n--- mcpfn/cli/src/index.ts:440-480 ---\n   440\t      if (options.output) {\n   441\t        await writeFile(path.resolve(cwd, options.output), serialized, \"utf8\");\n   442\t      }\n   443\t      await stdout(serialized);\n   444\t      if (!report.ok) exitCode = 1;\n   445\t    });\n   446\t\n   447\t  cli.help();\n   448\t  cli.version(MCPFN_CLI_VERSION);\n   449\t  try {\n   450\t    const parsed = cli.parse([\"node\", \"mcpfn\", ...argv], { run: false });\n   451\t    if (!cli.matchedCommand) {\n   452\t      if (parsed.options.help || parsed.options.version) return 0;\n   453\t      await stderr(argv.length ? `Unknown command: ${argv[0]}\\n` : \"A command is required\\n\");\n   454\t      return 2;\n   455\t    }\n   456\t    await cli.runMatchedCommand();\n   457\t  } catch (error) {\n   458\t    if (isCliCleanupError(error)) {\n   459\t      // Diagnostics are secondary to the live cleanup owner. A failed write\n   460\t      // must not prevent the bounded retry or replace the owning error.\n   461\t      try { await stderr(`${error.message}\\n`); } catch {}\n   462\t      // Preserve ownership when the bounded retry still fails. The executable\n   463\t      // entry point is the only layer allowed to terminate without a retry owner.\n   464\t      await error.retryCleanup();\n   465\t      return MCPFN_CLI_EXIT_TEST_FAILURE;\n   466\t    }\n   467\t    if (error instanceof McpFnAssertionError || error instanceof McpFnClientError) {\n   468\t      try { await stderr(`${error.message}\\n`); } catch {}\n   469\t      return MCPFN_CLI_EXIT_TEST_FAILURE;\n   470\t    }\n   471\t    await stderr(`${error instanceof Error ? error.message : String(error)}\\n`);\n   472\t    return MCPFN_CLI_EXIT_USAGE;\n   473\t  }\n   474\t  return exitCode;\n   475\t}\n   476\t\n   477\tfunction parsePositiveInteger(value: string | undefined, name: string): number | undefined {\n   478\t  if (value === undefined) return undefined;\n   479\t  const parsed = Number(value);\n   480\t  if (!Number.isSafeInteger(parsed) || parsed \u003c 1) {\n--- mcpfn/cli/src/index.ts:545-565 ---\n   545\t\n   546\tfunction readRemoteCredential(\n   547\t  options: RemoteAuthCliOptions,\n   548\t): { credential: McpFnRemoteCredential; environmentName: string } | undefined {\n   549\t  if (options.bearerTokenEnv \u0026\u0026 options.apiKeyEnv) {\n   550\t    throw new Error(\"Use only one of --bearer-token-env or --api-key-env\");\n   551\t  }\n   552\t  if (options.apiKeyHeader \u0026\u0026 !options.apiKeyEnv) {\n   553\t    throw new Error(\"--api-key-header requires --api-key-env\");\n   554\t  }\n   555\t  const environmentName = options.bearerTokenEnv ?? options.apiKeyEnv;\n   556\t  if (!environmentName) return undefined;\n   557\t  if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(environmentName)) {\n   558\t    throw new Error(\"Credential environment variable names must be portable identifiers\");\n   559\t  }\n   560\t  const value = process.env[environmentName];\n   561\t  if (value === undef