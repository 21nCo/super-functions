ts/docs-site/` already covers the shared-runtime redeploy case. Delete the branch, or point it at the real path if redeploying consumer docs on DocsFn source/config changes was intended.</comment>\n\n<file context>\n@@ -46,18 +46,16 @@ function productsFromChangedFiles() {\n-      selectExisting(\"authfn\");\n-      continue;\n-    }\n+    if (/^docsfn\\//.test(file)) return existingProductIds();\n     if (/^datafn\\/docs\\//.test(file)) selectExisting(\"datafn\");\n+    if (/^extfn\\/docs\\//.test(file)) selectExisting(\"extfn\");\n</file context>\n```\n\n</details>\n\n✅ Addressed in [`d10fbdb`](https://github.com/21nCo/super-functions/commit/d10fbdba0d2b61cc5beaff8741e914a24a72e215)\n\n## PRRT_kwDOP-e7KM6nPyrW scripts/docs-site/llms.mjs\n<!-- cubic:v=6920ac64-110b-41dd-9356-1c3f7ca002bf -->\n<!-- cubic:review-run=23e7caba-debf-56a0-86b1-7698c944f64b -->\n<!-- metadata:{\"confidence\":7} -->\nP2: Resolve the configured content root relative to `cwd`; otherwise running a consumer generator outside its package directory scans the wrong tree and generates stale or empty LLM files.\n\n<details>\n<summary>Prompt for AI agents</summary>\n\n```text\nCheck if this issue is valid — if so, understand the root cause and fix it. At scripts/docs-site/llms.mjs, line 12:\n\n<comment>Resolve the configured content root relative to `cwd`; otherwise running a consumer generator outside its package directory scans the wrong tree and generates stale or empty LLM files.</comment>\n\n<file context>\n@@ -1,5 +1,38 @@\n+  const { buildManifest, loadDocsConfig, FsContentProvider } = dependencies;\n+  const config = await loadDocsConfig({ cwd });\n+  const provider = new FsContentProvider({\n+    root: config.content.root || cwd,\n+    docsDir: config.content.docsDir,\n+    pagesDir: config.content.pagesDir,\n</file context>\n```\n\n</details>\n\n```suggestion\n    root: resolve(cwd, config.content.root || \".\"),\n```\n\n✅ Addressed in [`f15540d`](https://github.com/21nCo/super-functions/commit/f15540d26c2329203c626ccb51eb9108c5bebd84)\n\n## PRRT_kwDOP-e7KM6nPyre extfn/docs/src/app.html\n<!-- cubic:v=44043df6-2761-427d-b33e-acb847ca86a0 -->\n<!-- cubic:review-run=23e7caba-debf-56a0-86b1-7698c944f64b -->\n<!-- metadata:{\"confidence\":8} -->\nP2: This static `<title>` shadows the per-page titles that every route sets via `<svelte:head>` (`routes/docs/[...slug]/+page.svelte:16` sets `{data.surface.title ?? data.siteTitle}`, and `scripts/docs-site/LandingPage.svelte:15` sets `{siteTitle}`). SvelteKit injects that head content literally at `%sveltekit.head%` after this title, so served pages contain two `<title>` elements and the browser follows the first, leaving every page tab/search title as the generic \"ExtFn docs\". Remove this line (the sibling sites authfn/docs and filefn/docs have no static title) or use the `%sveltekit.error.message%` placeholder for the error-page fallback.\n\n<details>\n<summary>Prompt for AI agents</summary>\n\n```text\nCheck if this issue is valid — if so, understand the root cause and fix it. At extfn/docs/src/app.html, line 6:\n\n<comment>This static `<title>` shadows the per-page titles that every route sets via `<svelte:head>` (`routes/docs/[...slug]/+page.svelte:16` sets `{data.surface.title ?? data.siteTitle}`, and `scripts/docs-site/LandingPage.svelte:15` sets `{siteTitle}`). SvelteKit injects that head content literally at `%sveltekit.head%` after this title, so served pages contain two `<title>` elements and the browser follows the first, leaving every page tab/search title as the generic \"ExtFn docs\". Remove this line (the sibling sites authfn/docs and filefn/docs have no static title) or use the `%sveltekit.error.message%` placeholder for the error-page fallback.</comment>\n\n<file context>\n@@ -3,6 +3,7 @@\n   <head>\n     <meta charset=\"utf-8\" />\n     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n+    <title>ExtFn docs</title>\n     %sveltekit.head%\n   </head>\n</file context>\n```\n\n</details>\n\n✅ Addressed in [`f15540d`](https://github.com/21nCo/super-functions/commit/f15540d26c2329203c626ccb51eb9108c5bebd84)\n\n## PRRT_kwDOP-e7KM6nPyrj scripts/docs-site/llms.mjs\n<!-- cubic:v=c3f43ef7-489e-4ce9-89fe-a18d2bfd1264 -->\n<!-- cubic:review-run=23e7caba-debf-56a0-86b1-7698c944f64b -->\n<!-- metadata:{\"confidence\":9} -->\nP2: The shared helper generates AuthFn and FileFn LLM links from their stale `*.superfunctions.dev` config URLs, but Cloudflare publishes them at `authfn.com` and `filefn.com`. Pass the deployment origin from those generators, or update the site canonical URLs before generating the artifacts.\n\n<details>\n<summary>Prompt for AI agents</summary>\n\n```text\nCheck if this issue is valid — if so, understand the root cause and fix it. At scripts/docs-site/llms.mjs, line 29:\n\n<comment>The shared helper generates AuthFn and FileFn LLM links from their stale `*.superfunctions.dev` config URLs, but Cloudflare publishes them at `authfn.com` and `filefn.com`. Pass the deployment origin from those generators, or update the site canonical URLs before generating the artifacts.</comment>\n\n<file context>\n@@ -1,5 +1,38 @@\n+export async function buildLlmsSiteArtifacts(cwd, dependencies, options = {}) {\n+  const { config, manifest } = await loadLlmsSiteSource(cwd, dependencies);\n+  const { buildLlmsTxtArtifacts } = dependencies;\n+  const canonicalUrl = options.canonicalUrl ?? config.site?.canonicalUrl;\n+  const artifacts = buildLlmsTxtArtifacts(manifest, {\n+    canonicalUrl,\n</file context>\n```\n\n</details>\n\n✅ Addressed in [`f15540d`](https://github.com/21nCo/super-functions/commit/f15540d26c2329203c626ccb51eb9108c5bebd84)\n\n## PRRT_kwDOP-e7KM6nPyrs scripts/docs-site/vitest.config.ts\n<!-- cubic:v=2e7d876d-23d5-4157-8880-5568b07d7823 -->\n<!-- cubic:review-run=23e7caba-debf-56a0-86b1-7698c944f64b -->\n<!-- metadata:{\"confidence\":9} -->\nP3: The guard's suggested command references `@botfn/docs`, but this repository has no `botfn/docs` workspace — the only consumer of this shared config is `@extfn/docs` (extfn/docs/package.json). A developer who triggers this error here and follows the suggestion would run a nonexistent workspace and get a failure with no guidance. Use `@extfn/docs` as the example.\n\n<details>\n<summary>Prompt for AI agents</summary>\n\n```text\nCheck if this issue is valid — if so, understand the root cause and fix it. At scripts/docs-site/vitest.config.ts, line 10:\n\n<comment>The guard's suggested command references `@botfn/docs`, but this repository has no `botfn/docs` workspace — the only consumer of this shared config is `@extfn/docs` (extfn/docs/package.json). A developer who triggers this error here and follows the suggestion would run a nonexistent workspace and get a failure with no guidance. Use `@extfn/docs` as the example.</comment>\n\n<file context>\n@@ -1,9 +1,16 @@\n+const sitePackagePath = resolve(process.cwd(), \"package.json\");\n+const sitePackage = JSON.parse(readFileSync(sitePackagePath, \"utf8\"));\n+if (!sitePackage.name?.endsWith(\"/docs\") || !sitePackage.dependencies?.[\"@docsfn/core\"]) {\n+  throw new Error(\"Run DocsFn site tests from a consuming docs workspace, for example npm test --workspace @botfn/docs\");\n+}\n+\n</file context>\n```\n\n</details>\n\n```suggestion\n  throw new Error(\"Run DocsFn site tests from a consuming docs workspace, for example npm test --workspace @extfn/docs\");\n```\n\n✅ Addressed in [`f15540d`](https://github.com/21nCo/super-functions/commit/f15540d26c2329203c626ccb51eb9108c5bebd84)\n"}],"isError":false,"timestamp":1791368050419}}
{"type":"message","id":"ad8d3404","parentId":"d15e7479","timestamp":"2026-10-07T10:14:10.419Z","message":{"role":"toolResult","toolCallId":"call_c002041c1110451dadb0acd95f448d2a|fc_055fb762f51dfcfc016ac61b71cad887d0ab6de075ff7eecc3","toolName":"read","content":[{"type":"text","text":"-  },\n-];\n-\n-async function handleToolCall(name, args) {\n-  if (name === \"filefn_search_docs\") {\n-    return await fetch(`https://filefn.com/docs/search.json?q=${encodeURIComponent(args.query)}&limit=${args.limit}`)\n-      .then((r) => r.json());\n-  }\n-  if (name === \"filefn_fetch_page\") {\n-    return await fetch(`https://filefn.com/docs/docs/${args.slug}/raw`).then((r) => r.text());\n-  }\n-}\n+```md\n+Use https://filefn.com/docs and the generated LLM context files for FileFn guidance.\n+Inspect the actual installed public exports before writing examples.\n+Preserve policy, tenant, quota, and authorization checks.\n+Run local tests before proposing changes; ask before operating live infrastructure.\n ```\n \n-The kernel exposes `/search.json` and `/docs/<slug>/raw` for non-MCP consumers.\n-\n-## ChatGPT custom GPT\n-\n-In the GPT builder:\n-\n-1. Knowledge → Upload `llms-full.txt`.\n-2. Actions → Import the OpenAPI from `https://filefn.com/docs/api/filefn.json` (the docs site OpenAPI, not the filefn server's OpenAPI).\n-3. Instructions → \"When the user asks about filefn, search the knowledge base or call the search_docs / fetch_page actions before answering.\"\n-\n-## Continue.dev\n-\n-`config.json`:\n-\n-```json\n-{\n-  \"mcpServers\": [\n-    {\n-      \"name\": \"filefn\",\n-      \"type\": \"http\",\n-      \"url\": \"https://filefn.com/docs/mcp\"\n-    }\n-  ]\n-}\n-```\n-\n-## See also\n-\n-- [MCP server](./mcp) — the canonical surface.\n-- [llms.txt](./llms-txt) — static alternative.\n+The native `/docs/search.json` route is a search index, not a `?q=` query API or MCP service. This docs site has no `/docs/<slug>/raw`, `/mcp`, `/skills/`, `/api/filefn.json`, or `llms-rich.json` route contract. Do not register tool wrappers against invented endpoints. Any independent tool service must define and verify its own schema, authentication, authorization, and deployment.\n--- immutable-original-plan/filefn/docs/content/docs/ai-resources/mcp.md\n+++ explicit-supplement/filefn/docs/content/docs/ai-resources/mcp.md\n@@ -1,146 +1,12 @@\n ---\n-title: MCP server\n-description: Connect AI assistants to live filefn docs via the Model Context Protocol — search, fetch, and reference.\n+title: MCP integration boundaries\n+description: The current FileFn docs site does not implement an MCP server.\n ---\n \n-# MCP server\n+# MCP integration boundaries\n \n-filefn ships an MCP server that exposes the docs site as live tools. Clients see:\n+This FileFn docs site does not implement a `/mcp` endpoint. It does not publish `search_docs`, `fetch_page`, `get_route`, `get_error`, or executable skill tools. Changing a hostname in an editor configuration would not create those services.\n \n-| Tool | Purpose |\n-| --- | --- |\n-| `search_docs` | Full-text search; returns matching pages with snippets. |\n-| `fetch_page` | Fetch a single page's full content by slug. |\n-| `list_pages` | Enumerate the docs IA. |\n-| `get_route` | Look up an HTTP route by `path` + `method`. |\n-| `get_error` | Look up an error by code. |\n-| `get_event` | Look up an event by name. |\n+Use the generated [LLM context files](./llms-txt) or native documentation pages instead. The native `/docs/search.json` route supplies a search index, not a ready-made MCP tool protocol.\n \n-## Installing\n-\n-```bash\n-droid mcp add filefn https://filefn.com/docs/mcp --type http\n-```\n-\n-That registers the MCP server with Droid and similar MCP-aware clients.\n-\n-For Claude Desktop (`~/Library/Application Support/Claude/claude_desktop_config.json`):\n-\n-```json\n-{\n-  \"mcpServers\": {\n-    \"filefn\": {\n-      \"type\": \"http\",\n-      \"url\": \"https://filefn.com/docs/mcp\"\n-    }\n-  }\n-}\n-```\n-\n-For Cursor (`.cursor/mcp.json`):\n-\n-```json\n-{\n-  \"mcpServers\": {\n-    \"filefn\": {\n-      \"type\": \"http\",\n-      \"url\": \"https://filefn.com/docs/mcp\"\n-    }\n-  }\n-}\n-```\n-\n-## Self-hosting\n-\n-The MCP server is part of the docs site. To run it under your own domain:\n-\n-```bash\n-git clone https://github.com/21nco/super-functions.git\n-cd super-functions/filefn/docs\n-npm install\n-npm run build\n-npm run start\n-```\n-\n-The server is available at `https://your-domain/mcp`. Behind it is the same content as `llms-full.txt` plus the structured `llms-rich.json` index.\n-\n-## Tool details\n-\n-### `search_docs`\n-\n-```jsonc\n-{\n-  \"name\": \"search_docs\",\n-  \"description\": \"Full-text search filefn documentation\",\n-  \"input_schema\": {\n-    \"type\": \"object\",\n-    \"properties\": {\n-      \"query\": { \"type\": \"string\" },\n-      \"limit\": { \"type\": \"integer\", \"default\": 10 }\n-    },\n-    \"required\": [\"query\"]\n-  }\n-}\n-```\n-\n-Returns top matches with title, snippet, slug.\n-\n-### `fetch_page`\n-\n-```jsonc\n-{\n-  \"name\": \"fetch_page\",\n-  \"description\": \"Fetch a single docs page by slug\",\n-  \"input_schema\": {\n-    \"type\": \"object\",\n-    \"properties\": {\n-      \"slug\": { \"type\": \"string\" }\n-    },\n-    \"required\": [\"slug\"]\n-  }\n-}\n-```\n-\n-Returns the full markdown.\n-\n-### `get_route`\n-\n-```jsonc\n-{\n-  \"name\": \"get_route\",\n-  \"description\": \"Look up an HTTP route by method + path\",\n-  \"input_schema\": {\n-    \"type\": \"object\",\n-    \"properties\": {\n-      \"method\": { \"type\": \"string\", \"enum\": [\"GET\", \"POST\", \"PUT\", \"DELETE\", \"PATCH\"] },\n-      \"path\": { \"type\": \"string\" }\n-    },\n-    \"required\": [\"method\", \"path\"]\n-  }\n-}\n-```\n-\n\n[210 more lines in file. Use offset=806 to continue.]"}],"isError":false,"timestamp":1791368050419}}
