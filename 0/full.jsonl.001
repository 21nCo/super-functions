      \"status\": \"COMPLETED\",\n      \"conclusion\": \"SUCCESS\"\n    },\n    {\n      \"name\": \"SonarCloud Code Analysis\",\n      \"status\": \"COMPLETED\",\n      \"conclusion\": \"SUCCESS\"\n    },\n    {\n      \"name\": \"cubic · AI code reviewer\",\n      \"status\": \"COMPLETED\",\n      \"conclusion\": \"SUCCESS\"\n    },\n    {\n      \"name\": \"pullfrog\",\n      \"status\": \"COMPLETED\",\n      \"conclusion\": \"SUCCESS\"\n    }\n  ],\n  \"success\": 13,\n  \"failure\": 0,\n  \"pending\": 1,\n  \"neutral\": 1,\n  \"skipped\": 3\n}\n","type":"input_text"}],"type":"custom_tool_call_output"},{"encrypted_content":"REDACTED","id":"rs_05349b17f5ad9d6a016ab0edf0594c87d0b7032e41cc7ff76c","internal_chat_message_metadata_passthrough":{"turn_id":"01a0c31e-6a96-7383-bda9-a191f2448a61"},"summary":[{"text":"**Assessing new threads and code status**","type":"summary_text"},{"text":"**Tracing root cause and fetching Sonar issues**","type":"summary_text"}],"type":"reasoning"},{"encrypted_content":"REDACTED","id":"rs_05349b17f5ad9d6a016ab0edf8254c87d0b4190fb1d62c1f5c","internal_chat_message_metadata_passthrough":{"turn_id":"01a0c31e-6a96-7383-bda9-a191f2448a61"},"summary":[{"text":"**Inspecting thread comments and code context**","type":"summary_text"}],"type":"reasoning"},{"content":[{"text":"The snapshot is stable and complete: 334 threads, 232 reviews, 64 issue comments, 376 inline comments, and no nested pagination left. It contains two new current root causes—structured non-Bearer authorization leakage and over-rejection of nonstandard failure phases—so this is an assessment/reset round, not a clean-streak round. One required reviewer check was also pending in the allowed snapshot.","type":"output_text"}],"id":"msg_05349b17f5ad9d6a016ab0edfa952c87d0b50f147a2e400c8e","internal_chat_message_metadata_passthrough":{"content_item_kinds":["unknown"],"create_time":1789980142.462688,"turn_id":"01a0c31e-6a96-7383-bda9-a191f2448a61"},"phase":"commentary","role":"assistant","type":"message"},{"call_id":"call_hgVSp4zknlXuilMrAjMF7eDD","id":"ctc_05349b17f5ad9d6a016ab0edfc94ec87d08c88281032b6cbac","input":"const r = await tools.exec_command({\"cmd\":\"snapshot_dir=/tmp/pr170-round12.qTceXS\\nprintf 'target_threads\\\\n'\\njq -rs '[.[].data.repository.pullRequest.reviewThreads.nodes[] | select(.id==\\\"PRRT_kwDOP-e7KM6j_joR\\\" or .id==\\\"PRRT_kwDOP-e7KM6j_jRM\\\")]' \\\"$snapshot_dir\\\"/threads-*.json\\nprintf 'sonar_comments\\\\n'\\njq 'add | [.[] | select((.user.login|ascii_downcase|contains(\\\"sonar\\\")) or (.body|ascii_downcase|contains(\\\"sonar\\\"))) | {id,user:.user.login,created_at,html_url,body}] | sort_by(.created_at) | reverse | .[0:3]' \\\"$snapshot_dir/issue-comments-pages.json\\\"\\nprintf 'authorization_sources\\\\n'\\nrg -n \\\"addAuthorizationSecrets|credentialValues|authorization|proxy-authorization|Bearer|Digest|WWW-Authenticate\\\" mcpfn/testing/src mcpfn/testing/tests | head -n 240\\nprintf 'phase_sources\\\\n'\\nrg -n \\\"fallbackPhase|failure\\\\.phase|normalizeMcpFnReportFailure|SuiteStructureGuard|captureSuiteStructureGuard|assertSuiteReportStructure\\\" mcpfn/testing/src mcpfn/testing/tests | head -n 240\",\"workdir\":\"/Users/serro/Documents/dev/n/worktrees/superfunctions/PR-170\",\"yield_time_ms\":10000,\"max_output_tokens\":30000}); text(r.output);\n","internal_chat_message_metadata_passthrough":{"create_time":1789980142.462688,"turn_id":"01a0c31e-6a96-7383-bda9-a191f2448a61"},"name":"exec","status":"completed","type":"custom_tool_call"},{"call_id":"call_hgVSp4zknlXuilMrAjMF7eDD","id":"ctco_01a0c321-bddf-7ca3-a6de-0c1280651edc","internal_chat_message_metadata_passthrough":{"create_time":1789980163.551557,"turn_id":"01a0c31e-6a96-7383-bda9-a191f2448a61"},"output":[{"text":"Script completed\nWall time 0.7 seconds\nOutput:\n","type":"input_text"},{"text":"Warning: truncated output (original token count: 14980)\nTotal output lines: 355\n\ntarget_threads\n[\n  {\n    \"id\": \"PRRT_kwDOP-e7KM6j_jRM\",\n    \"isResolved\": false,\n    \"path\": \"mcpfn/testing/src/suite.ts\",\n    \"comments\": {\n      \"nodes\": [\n        {\n          \"id\": \"PRRC_kwDOP-e7KM7xlwr2\",\n          \"body\": \"\u003c!-- cubic:v=2e1aec08-1d67-4452-ada9-8437a1783bd0 --\u003e\\n\u003c!-- cubic:review-run=0fc54562-fcc2-542e-91ad-95b6ba996323 --\u003e\\n\u003c!-- metadata:{\\\"confidence\\\":9} --\u003e\\nP2: When a target error supplies a nonstandard `phase`, suite finalization treats the legitimate failure as a credential-structure collision and throws instead of returning the bounded incomplete report. Add the actual failure phase to the guard candidates before capture, or only enforce this check for the fixed structural phase values.\\n\\n\u003cdetails\u003e\\n\u003csummary\u003ePrompt for AI agents\u003c/summary\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At mcpfn/testing/src/suite.ts, line 463:\\n\\n\u003ccomment\u003eWhen a target error supplies a nonstandard `phase`, suite finalization treats the legitimate failure as a credential-structure collision and throws instead of returning the bounded incomplete report. Add the actual failure phase to the guard candidates before capture, or only enforce this check for the fixed structural phase values.\u003c/comment\u003e\\n\\n\u003cfile context\u003e\\n@@ -362,6 +366,115 @@ function projectSuiteArtifacts(\\n+  if (report.failure) {\\n+    assertStructureKeys(report.failure, guard);\\n+    guard.assert(report.failure.layer);\\n+    if (report.failure.phase) guard.assert(report.failure.phase);\\n+  }\\n+  for (const event of report.timeline) {\\n\u003c/file context\u003e\\n```\\n\\n\u003c/details\u003e\",\n          \"author\": {\n            \"login\": \"cubic-dev-ai\"\n          },\n          \"createdAt\": \"2026-09-19T12:40:28Z\",\n          \"updatedAt\": \"2026-09-19T12:40:28Z\",\n          \"outdated\": false,\n          \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4053207798\",\n          \"diffHunk\": \"@@ -46,103 +67,706 @@ export interface McpFnTargetSuiteReport {\\n   incomplete: number;\\n   droppedResults: number;\\n   droppedObservedEvents: number;\\n+  redactionOmittedObservedEvents?: number;\\n   incompleteReason?: string;\\n+  failure?: McpFnReportFailure;\\n   timeline: McpFnDiagnosticEvent[];\\n   droppedTimelineEvents: number;\\n   results: McpFnScenarioResult[];\\n }\\n \\n+const suiteCleanupOwners = new WeakMap\u003cError, { close: () =\u003e Promise\u003cvoid\u003e; pending?: Promise\u003cvoid\u003e }\u003e();\\n+\\n+function retryTargetSuiteCleanup(error: Error): Promise\u003cvoid\u003e {\\n+  const owner = suiteCleanupOwners.get(error);\\n+  if (!owner) return Promise.resolve();\\n+  if (owner.pending) return owner.pending;\\n+  const pending = Promise.resolve().then(owner.close).then(\\n+    () =\u003e { suiteCleanupOwners.delete(error); },\\n+    () =\u003e { throw error; },\\n+  ).finally(() =\u003e { owner.pending = undefined; });\\n+  owner.pending = pending;\\n+  return pending;\\n+}\\n+\\n+/** Final cleanup failed. The bounded report is a snapshot; retain this error to retry. */\\n+export class McpFnTargetSuiteCleanupError extends Error {\\n+  constructor(readonly report: McpFnTargetSuiteReport, close: () =\u003e Promise\u003cvoid\u003e) {\\n+    super(\\\"Target suite cleanup failed; retain this error and retryCleanup()\\\");\\n+    this.name = \\\"McpFnTargetSuiteCleanupError\\\";\\n+    suiteCleanupOwners.set(this, { close });\\n+  }\\n+\\n+  retryCleanup(): Promise\u003cvoid\u003e {\\n+    return retryTargetSuiteCleanup(this);\\n+  }\\n+}\\n+\\n+/** Report serialization failed after cleanup ownership had already transferred. */\\n+export class McpFnTargetSuiteArtifactCleanupError extends Error {\\n+  constructor(close: () =\u003e Promise\u003cvoid\u003e, cause: Error) {\\n+    super(`${cause.message}; retain this error and retryCleanup()`, { cause });\\n+    this.name = \\\"McpFnTargetSuiteArtifactCleanupError\\\";\\n+    suiteCleanupOwners.set(this, { close });\\n+  }\\n+\\n+  retryCleanup(): Promise\u003cvoid\u003e {\\n+    return retryTargetSuiteCleanup(this);\\n+  }\\n+}\\n+\\n /** Runs local, stdio, HTTP, or custom targets through the production session engine. */\\n export async function runMcpFnTargetSuite(\\n   options: RunMcpFnTargetSuiteOptions,\\n ): Promise\u003cMcpFnTargetSuiteReport\u003e {\\n-  const timeline: McpFnDiagnosticEvent[] = [];\\n-  let droppedTimelineEvents = 0;\\n-  const maxTimelineEvents = options.maxTimelineEvents ?? 500;\\n-  if (!Number.isInteger(maxTimelineEvents) || maxTimelineEvents \u003c 1) {\\n-    throw new Error(\\\"maxTimelineEvents must be a positive integer\\\");\\n+  const finishRedaction = beginTargetCredentialRedaction(options.target);\\n+  try { return await runTargetSuite(options); }\\n+  finally { finishRedaction(); }\\n+}\\n+\\n+/** Apply the target-owned scrubber before the bounded generic artifact pass. */\\n+function redactSuiteArtifact\u003cT\u003e(target: McpFnTarget, value: T, options: { preserveKeys?: boolean } = {}): T {\\n+  const scrubbed = target.redact ? target.redact(value, options) : value;\\n+  return redactTargetCredentials(target, scrubbed, options);\\n+}\\n+\\n+function compareInventoryNames(left: string, right: string): number {\\n+  if (left === right) return 0;\\n+  return left \u003c right ? -1 : 1;\\n+}\\n+\\n+function reportProjectionFailureReason(\\n+  error: unknown,\\n+  projectionFailure: \\\"redaction\\\" | \\\"serialization\\\" | undefined,\\n+): string {\\n+  if (error instanceof McpFnRedactionLimitError) {\\n+    return \\\"Credential redaction exceeded its traversal budget\\\";\\n   }\\n-  const maxReportBytes = options.maxReportBytes ?? 1_048_576;\\n-  validateReportCap(maxReportBytes);\\n-  const consumerDiagnostic = options.client?.diagnostics;\\n-  const client = await McpFnTestClient.connectTarget(\\n-    options.target,\\n-    options.clientInfo ?? { name: \\\"mcpfn-suite\\\", version: \\\"0.0.1\\\" },\\n-    {\\n-      ...options.client,\\n-      diagnostics: async (event) =\u003e {\\n-        timeline.push(redactOAuthValue(event) as unknown as McpFnDiagnosticEvent);\\n-        if (timeline.length \u003e maxTimelineEvents) {\\n-          timeline.shift();\\n-          droppedTimelineEvents += 1;\\n+  if (projectionFailure === \\\"redaction\\\") {\\n+    return \\\"Credential redaction failed; report content omitted because safe serialization failed\\\";\\n+  }\\n+  return \\\"Report content omitted because safe serialization failed\\\";\\n+}\\n+\\n+class SuiteDiagnosticCollector {\\n+  readonly timeline: McpFnDiagnosticEvent[] = [];\\n+  private readonly timelineSizes: number[] = [];\\n+  private timelineBytes = 0;\\n+  private observedRedactionOmissions = 0;\\n+  private initialRedactionOmissions = 0;\\n+  dropped = 0;\\n+  countExceeded = false;\\n+  bytesExceeded = false;\\n+  serializationFailed = false;\\n+  redactionFailed = false;\\n+  cleanupFailure: McpFnReportFailure | undefined;\\n+\\n+  constructor(\\n+    private readonly maxEvents: number,\\n+    private readonly maxBytes: number,\\n+    private readonly target: McpFnTarget,\\n+    private readonly consumer?: (event: McpFnDiagnosticEvent) =\u003e void | Promise\u003cvoid\u003e,\\n+  ) {}\\n+\\n+  captureBaseline(client: McpFnTestClient): void {\\n+    this.initialRedactionOmissions = client.session\\n+      .getRedactionOmissionCounts().diagnostics;\\n+  }\\n+\\n+  captureUnobserved(client: McpFnTestClient | undefined): void {\\n+    const total = client?.session.getRedactionOmissionCounts().diagnostics ??\\n+      this.initialRedactionOmissions;\\n+    const unobserved = Math.max(\\n+      0,\\n+      total - this.initialRedactionOmissions - this.observedRedactionOmissions,\\n+    );\\n+    if (unobserved \u003e 0) {\\n+      this.redactionFailed = true;\\n+      this.dropped += unobserved;\\n+    }\\n+  }\\n+\\n+  async record(client: McpFnTestClient 