h('sha256').update(source).digest('hex');\n let code=ts.transpileModule(source,{compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.ES2022}}).outputText;\n for(const [n,url] of Object.entries(owners))code=code.replaceAll(`from \"${n}\"`,`from ${JSON.stringify(url)}`);\n fs.writeFileSync(path.join(out,name+'.mjs'),code);\n}\nconst {createDocsSiteRuntime}=await import(pathToFileURL(path.join(out,'runtime.mjs')));\nconst {loadDocsPage}=await import(pathToFileURL(path.join(out,'page.mjs')));\nconst sdk=await import(owners['@docsfn/core']);\nconst config={schemaVersion:1,site:{title:'ExtFn',basePath:'/docs'},compat:{preset:'none'},content:{root:'.',docsDir:'content/docs',pagesDir:'content/pages',blogDir:'content/blog',apiDir:'content/api',assetsDir:'static',metaFileName:'meta.json'},navigation:{topNav:[],sidebars:{docs:{root:true,include:['docs/**']}}},search:{enabled:true,scopes:['docs'],bodyIndexing:'summary'},auth:{enabled:false,mode:'public'}};\nconst modules=Object.fromEntries(Object.entries({'index.md':'# Home','flat.md':'# Flat\\n[Sibling](./sibling.md)','flat/child.md':'# Child','sibling.md':'# Sibling'}).map(([n,body])=>['../../../content/docs/'+n,body]));\nconst runtime=createDocsSiteRuntime(config,modules,{});const source=await runtime.loadDocsSiteSource();\nconst result=await loadDocsPage({slug:'flat',source,getCompiledDocsPage:runtime.getCompiledDocsPage,resolveMarkdownRelativeLinks:sdk.resolveMarkdownRelativeLinks,options:{fallbackSidebarId:'docs'}});\nconst html=result.compiled.blocks.filter(x=>typeof x.html==='string').map(x=>x.html).join('\\n');\nconst href=html.match(/href=\"([^\"]+)\"/)?.[1];assert.equal(href,'/docs/flat/sibling.md');\nassert.equal(source.manifest.routes['/docs/sibling']??source.manifest.routes.sibling,'docs:sibling.md');\nconst report={head,sourceHashes:hashes,coreVersion:sdkPackage.version,owners,actualHref:href,requiredHref:'/docs/sibling',canonicalProducer:'literal current runtime creates actual SDK collection:filename entries; no invented page fields',oldFailureReproduced:true,qualification:'Exact frozen source, type erasure using audit tooling, actual published Core0.0.5 renderer/link boundary from retained AuthFn SDK owner with same declared core version. Borrowed SDK is audit-only; not frozen213 locked graph, native ExtFn SvelteKit build or standalone acceptance.'};\nfs.writeFileSync(path.join(A,'frozen-actual-flat-link-result.json'),JSON.stringify(report,null,2)+'\\n');console.log(JSON.stringify(report,null,2));\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":1546,"output":1320,"cacheRead":117376,"cacheWrite":0,"reasoning":43,"totalTokens":120242,"cost":{"input":0.0030919999999999997,"output":0.013200000000000002,"cacheRead":0.0117376,"cacheWrite":0,"total":0.028029600000000002}},"stopReason":"toolUse","timestamp":1791330868145,"responseId":"resp_055fb762f51dfcfc016ac58a34ec9c87d0bd8c1b6a49b41878","rawStopReason":"completed","thinkingLevel":"high"}}
