ord.details);\n    74\t  let message = stringField(record.message) ?? String(\n    75\t    redactOAuthValue(error instanceof Error ? error.message : String(error)),\n    76\t  );\n    77\t  const causeRecord = redactedFailureCause(error);\n    78\t  const causeMessage = stringField(causeRecord?.message);\n    79\t  if (causeMessage \u0026\u0026 !message.includes(causeMessage)) message = `${message}: ${causeMessage}`;\n    80\t  const combinedDetails = causeRecord ? { ...details, cause: causeRecord } : details;\n    81\t  const layer = failureLayer(phase);\n    82\t  const deniedByResource = resourceDenied(layer, record, causeRecord);\n    83\t  return {\n    84\t    name: stringField(record.name) ?? \"Error\",\n    85\t    message,\n    86\t    layer: deniedByResource ? \"resource-server\" : layer,\n    87\t    ...(stringField(record.code) ? { code: stringField(record.code)! } : {}),\n    88\t    ...(phase ? { phase } : {}),\n    89\t    ...(combinedDetails ? { details: combinedDetails } : {}),\n    90\t  };\n    91\t}\n    92\t\n    93\t/** Serialize a redacted target-suite report as bounded JUnit XML. */\n    94\texport function createMcpFnTargetSuiteJUnit(\n    95\t  report: McpFnTargetSuiteReport,\n    96\t  options: McpFnJunitOptions = {},\n    97\t): string {\n    98\t  const maxBytes = options.maxBytes ?? 1_048_576;\n    99\t  validateArtifactCap(maxBytes);\n   100\t  const safe = redactOAuthValue(report, {\n   101\t    maxDepth: 10,\n   102\t    maxArrayEntries: 1_000,\n   103\t    maxObjectEntries: 200,\n   104\t    maxStringLength: 4_096,\n   105\t  }) as unknown as McpFnTargetSuiteReport;\n   106\t  // Redaction appends a string sentinel when an array exceeds its cap.\n   107\t  const results = safe.results.filter((result) =\u003e result \u0026\u0026 typeof result === \"object\" \u0026\u0026 typeof result.name === \"string\");\n   108\t  const omitted = report.results.length - results.length;\n   109\t  const cases = results.map((result) =\u003e {\n   110\t    const duration = Math.max(0, result.durationMs ?? 0) / 1_000;\n   111\t    let failure = \"\";\n   112\t    if (result.status !== \"passed\") {\n   113\t      const failureType = result.status === \"failed\" ? \"scenario\" : \"incomplete\";\n   114\t      failure = junitFailure(result.error ?? `Scenario ${result.status}`, failureType);\n   115\t    }\n   235\t  exportScenario(\n   236\t    name: string,\n   237\t    operation: McpFnInspectorOperation,\n   238\t    result: McpFnInspectorOperationResult,\n   239\t  ): McpFnExportedScenario {\n   240\t    const scenario = createMcpFnScenario(name, operation, result);\n   241\t    // Top-level scenario keys are authored schema, not payload. If a credential\n   242\t    // collides with one of them, no replayable typed artifact can be emitted.\n   243\t    for (const key of Object.keys(scenario)) {\n   244\t      this.client.preserveArtifactStructure(key);\n   245\t    }\n   246\t    const { formatVersion, kind, sideEffect, ...payload } = scenario;\n   247\t    if (kind === undefined || sideEffect === undefined) {\n   248\t      throw new Error(\"Inspector scenario export requires normalized structure\");\n   249\t    }\n   250\t    const safeKind = this.client.preserveArtifactStructure(kind);\n   251\t    const safeSideEffect = this.client.preserveArtifactStructure(sideEffect);\n   252\t    const secretMarker = selectScenarioSecretMarker(this.client);\n   253\t    let redacted: Record\u003cstring, unknown\u003e;\n   254\t    try {\n   255\t      redacted = {\n   256\t        ...Object.fromEntries(Object.entries(payload).map(([key, value]) =\u003e [key, this.client.redact(value, {\n   257\t          ...SCENARIO_REDACTION_LIMITS,\n   258\t          // These are user payloads, even when their keys resemble an envelope.\n   259\t          preserveKeys: false,\n   260\t          redactionMarker: secretMarker ?? \"\",\n   261\t        })])),\n   262\t        formatVersion, kind: safeKind, sideEffect: safeSideEffect,\n   263\t      };\n   264\t    } catch {\n   265\t      this.client.preserveArtifactStructure(\"status\");\n   266\t      this.client.preserveArtifactStructure(\"incompleteReason\");\n   267\t      return {\n   268\t        formatVersion,\n   269\t        kind: safeKind,\n   270\t        sideEffect: safeSideEffect,\n   271\t        name: \"\",\n   272\t        status: this.client.preserveArtifactStructure(\"incomplete\"),\n   273\t        incompleteReason: this.client.redact(\n   274\t          \"Inspector export omitted payload because credential redaction failed\",\n   275\t          { preserveKeys: false, redactionMarker: \"\" },\n   276\t        ),\n   277\t      } as McpFnExportedScenario;\n   278\t    }\n   279\t    const replaced = redacted as unknown as McpFnExportedScenario;\n   280\t    let incompleteReason: string | undefined;\n   281\t    if (secretMarker === undefined) {\n   282\t      incompleteReason = \"Inspector export could not select a replayable redaction placeholder\";\n   283\t    } else if (exceedsRedactionBounds(scenario, redacted, SCENARIO_REDACTION_LIMITS)) {\n   284\t      incompleteReason = \"Inspector export exceeded redaction bounds and was truncated\";\n   285\t    }\n   286\t    if (incompleteReason) {\n   287\t      this.client.preserveArtifactStructure(\"status\");\n   288\t      this.client.preserveArtifactStructure(\"incompleteReason\");\n   289\t    }\n   290\t    const exported = incompleteReason\n   291\t      ? {\n   292\t        ...replaced,\n   293\t        status: this.client.preserveArtifactStructure(\"incomplete\"),\n   294\t        incompleteReason: this.client.redact(incompleteReason, {\n   295\t          preserveKeys: false,\n   296\t          redactionMarker: \"\",\n   297\t        }),\n   298\t      }\n   299\t      : replaced;\n   300\t    const variables = collectVariables(exported);\n   301\t    if (!variables.length) return exported;\n   302\t    this.client.preserveArtifactStructure(\"variables\");\n   303\t    return { ...exported, variables };\n   304\t  }\n   305\t\n   306\t  timeline(): McpFnInspectorTimelineEvent[] {\n   307\t    return [...this.events];\n   308\t  }\n   309\t\n   310\t  private record(\n","type":"input_text"}],"type":"custom_tool_call_output"},{"encrypted_content":"REDACTED","id":"rs_05349b17f5ad9d6a016aae8122938487d08c2c5e99e7101b00","internal_chat_message_metadata_passthrough":{"turn_id":"01a0b992-9248-7613-95d3-df05acb573b9"},"summary":[{"text":"**Analyzing suite closure error handling**","type":"summary_text"},{"text":"**Planning ledger verification before commit**","type":"summary_text"},{"text":"**Finalizing commit preparation and staging**","type":"summary_text"}],"type":"reasoning"},{"content":[{"text":"The final release gate passed end to end, including all package tests/typechecks/builds, Playwright, official conformance, mixed-entry redaction, examples, import/pack checks, and consumer round trips. The reviewed batch is limited to six code/test files; I’m creating the one permitted commit now, leaving `.conduct` untracked.","type":"output_text"}],"id":"msg_05349b17f5ad9d6a016aae812ba23c87d0939b2aeba5e93745","internal_chat_message_metadata_passthrough":{"content_item_kinds":["unknown"],"create_time":1789821217.72705,"turn_id":"01a0b992-9248-7613-95d3-df05acb573b9"},"phase":"commentary","role":"assistant","type":"message"},{"call_id":"call_KvJly8bDBooMy3YiMX1TU5Db","id":"ctc_05349b17f5ad9d6a016aae812c8dec87d0a977679f50687ce6","input":"const r = await tools.exec_command({\"cmd\":\"git diff --check \u0026\u0026 git add mcpfn/inspector/src/index.ts mcpfn/inspector/tests/authenticated-artifacts.test.ts mcpfn/testing/src/remote-target.ts mcpfn/testing/src/reports.ts mcpfn/testing/src/suite.ts mcpfn/testing/tests/suite.test.ts \u0026\u0026 git status --short \u0026\u0026 git diff --cached --check \u0026\u0026 git commit -m \\\"fix(mcpfn): close structural report gaps\\\"\",\"workdir\":\"/Users/serro/Documents/dev/n/worktrees/superfunctions/PR-170\",\