n   399\t  const maxTimelineEvents = options.maxTimelineEvents ?? 500;\n   400\t  if (!Number.isInteger(maxTimelineEvents) || maxTimelineEvents < 1) {\n   401\t    throw new Error(\"maxTimelineEvents must be a positive integer\");\n   402\t  }\n   403\t  const maxReportBytes = options.maxReportBytes ?? 1_048_576;\n   404\t  validateReportCap(maxReportBytes);\n   405\t  const consumerDiagnostic = options.client?.diagnostics;\n   406\t  const diagnostics = new SuiteDiagnosticCollector(\n   407\t    maxTimelineEvents,\n   408\t    maxReportBytes,\n   409\t    options.target,\n   410\t    consumerDiagnostic,\n   411\t  );\n   412\t  let client: McpFnTestClient | undefined;\n   413\t  let manifestChecked = false;\n   414\t  let failure: McpFnReportFailure | undefined;\n   415\t  let execution: SuiteExecution = { results: [] };\n   416\t  try {\n   417\t    client = McpFnTestClient.createTarget(\n   418\t      options.target,\n   419\t      options.clientInfo ?? { name: \"mcpfn-suite\", version: \"0.0.1\" },\n   420\t      {\n   421\t        ...options.client,\n   422\t        diagnostics: event => diagnostics.record(client, event),\n   423\t      },\n   424\t    );\n   425\t    diagnostics.captureBaseline(client);\n   426\t    await client.session.connect();\n   427\t    ({ execution, manifestChecked } = await executeConnectedSuite(client, options));\n   428\t  } catch (error) {\n   429\t    failure = safeTargetFailure(options.target, error);\n   430\t  }\n   431\t  // Custom hooks may depend on credentials cleared by close. Capture every\n   432\t  // target-controlled report value while the session still owns that state.\n   433\t  const projection = projectSuiteArtifacts(options, client, execution);\n   434\t  execution = projection.execution;\n   435\t  const { cleanupFailure: closeFailure, retainedCleanup } = await closeSuiteClient(client);\n   436\t  diagnostics.captureUnobserved(client);\n   437\t  let cleanupFailure = closeFailure;\n   438\t  cleanupFailure ??= diagnostics.cleanupFailure;\n   439\t  failure ??= cleanupFailure;\n   440\t  const results = execution.results;\n   441\t  const failed = results.filter((result) => result.status === \"failed\").length;\n   442\t  const incomplete = results.filter((result) => result.status === \"incomplete\").length;\n   443\t  const droppedObservedEvents = results.reduce(\n   444\t    (total, result) => total + (result.droppedObservedEvents ?? 0),\n   445\t    0,\n   446\t  );\n   447\t  const redactionOmittedObservedEvents = results.reduce(\n   448\t    (total, result) => total + (result.redactionOmittedObservedEvents ?? 0),\n   449\t    0,\n   450\t  );\n   451\t  const overflowedObservedEvents = droppedObservedEvents - redactionOmittedObservedEvents;\n   452\t  const artifactIncomplete = Boolean(failure) || incomplete > 0 ||\n   453\t    diagnostics.dropped > 0 ||\n   454\t    droppedObservedEvents > 0;\n   455\t  const report: McpFnTargetSuiteReport = {\n   456\t    formatVersion: 1,\n   457\t    kind: \"mcpfn.target-suite-report\",\n   458\t    status: artifactIncomplete ? \"incomplete\" : \"complete\",\n   459\t    runtime: {\n   460\t      node: process.version,\n   461\t      scenarioFormatVersion: 1,\n   462\t      reportSchemaVersion: MCPFN_REPORT_SCHEMA_VERSION,\n   463\t      packages: { testing: MCPFN_TESTING_VERSION },\n   464\t    },\n   465\t    ok: failed === 0 && !artifactIncomplete,\n   466\t    target: projection.target,\n   467\t    server: execution.server,\n   468\t    capabilities: execution.capabilities,\n   469\t    manifestChecked,\n   470\t    ...(projection.manifestHash === undefined ? {} : { manifestHash: projection.manifestHash }),\n   471\t    total: results.length,\n   472\t    passed: results.length - failed - incomplete,\n   473\t    failed,\n   474\t    incomplete,\n   475\t    droppedResults: 0,\n   476\t    droppedObservedEvents,\n   477\t    ...(redactionOmittedObservedEvents > 0 ? { redactionOmittedObservedEvents } : {}),\n   478\t    ...(fai