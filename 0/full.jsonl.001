Yqtsx1k1VtADEjNf_hMHsTo-BeiNEqzzJGlZyM97rOasidnAf7I1vQoNj0V4S6i-YpRw2vuzF0E_taeE7zDkErJqFIM1dm-90cp_k22-3gXbPlVagOLUj0-Nq8H61Huuk25xoyTtjDhPRpeJqq-m6KG-2CKs7YYhQ071yzkn1xLZJqmUy3FxjSxJDdSBN5rkRvScDal1UfDT-OaDA3v350IkduAxsbHVrDaq6l4h4b0TDsKhK-qjp4eHYrMU9T7vcaLauB5yRQd_fj0yW3XOgeSL1SJGzsOhzBOoR5yNwQZWImnmoGQ8eJ2mqFc1RsjhJfq16G_ahdiHk7wcKv5WhxbUBHBAQ5CA4HaICZzRXpG48H3-JVdrNArN1Q6y_dB1-kuUkYAi8Uh9v6s-JkK9PIkxDAXgkdhSEEdXLEWRnScCUFGvXPh9996LkuvAiqA4CN2x98ej7BYj2fHomxQoVGYk6WfjG88WkVe1N-cVFZTdX7g=\",\"summary\":[]}"},{"type":"toolCall","id":"call_lb23sMc3IfXgmjiHK59335rI|fc_055fb762f51dfcfc016ac58a7c43d887d09a8fb0999a6ce017","name":"write","arguments":{"path":"/Users/serro/Documents/dev/n/audits/sf-docs-review-20260930/sequential-20261003T184612Z/PR-213/verify-frozen-native-ssr-owner.mjs","content":"import assert from 'node:assert/strict';\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport http from 'node:http';\nimport crypto from 'node:crypto';\nimport { createRequire } from 'node:module';\nimport { pathToFileURL, fileURLToPath } from 'node:url';\nimport { execFileSync } from 'node:child_process';\nconst A=path.dirname(fileURLToPath(import.meta.url));const T='/Users/serro/orca/workspaces/superfunctions/docs-pr-206-review-20260930';\nconst V='/Volumes/OS - Data/superfunctions-agent-storage/sf-docs-review-20260930/sequential-20261003T184612Z/PR-209/verification-latest-base-root';\nconst consumer=path.join(V,'devfn/docs');const require=createRequire(path.join(V,'package.json'));const ts=require('typescript');\nconst resolveOwner=(name)=>execFileSync(process.execPath,['--input-type=module','-e',`console.log(import.meta.resolve(${JSON.stringify(name)}))`],{cwd:consumer,encoding:'utf8'}).trim();\nconst viteOwner=resolveOwner('vite');let dir=path.dirname(fileURLToPath(viteOwner));while(!fs.existsSync(path.join(dir,'package.json')))dir=path.dirname(dir);const version=JSON.parse(fs.readFileSync(path.join(dir,'package.json'),'utf8')).version;\nassert.equal(version,'6.4.3');const frozen=JSON.parse(fs.readFileSync(path.join(T,'extfn/docs/package.json'),'utf8'));assert.equal(frozen.devDependencies.vite,'^6.4.3');\nconst retained=JSON.parse(fs.readFileSync(path.join(consumer,'package.json'),'utf8'));assert.equal(retained.dependencies['@docsfn/core'],frozen.dependencies['@docsfn/core']);assert.equal(retained.dependencies['gray-matter'],frozen.dependencies['gray-matter']);\nconst tmp=JSON.parse(fs.readFileSync(path.join(A,'native-artifact-reader-admission.json'),'utf8')).tmp;const probe=path.join(tmp,'pr213-frozen-owner-probe/scripts/docs-site');assert(!fs.existsSync(probe));fs.mkdirSync(probe,{recursive:true,mode:0o700});\nconst runtime=fs.readFileSync(path.join(T,'scripts/docs-site/runtime.ts'),'utf8');const plugin=fs.readFileSync(path.join(T,'scripts/docs-site/vite.ts'),'utf8');fs.writeFileSync(path.join(probe,'runtime.ts'),runtime);fs.writeFileSync(path.join(probe,'vite.mjs'),ts.transpileModule(plugin,{compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.ES2022}}).outputText);\nconst {docsSiteCorePlugin}=await import(pathToFileURL(path.join(probe,'vite.mjs')));const {createServer}=await import(viteOwner);\nconst vite=await createServer({root:consumer,configFile:false,plugins:[docsSiteCorePlugin(pathToFileURL(path.join(consumer,'vite.config.ts')).href)],server:{middlewareMode:true,hmr:false},logLevel:'silent'});\nconst server=http.createServer(async(req,res)=>{try{await vite.ssrLoadModule(path.join(probe,'runtime.ts'));res.writeHead(200);res.end('imports succeeded');}catch(e){res.writeHead(500,{'content-type':'application/json'});res.end(JSON.stringify({message:String(e.message),code:e.code}));}});\ntry{\n await new Promise(r=>server.listen(0,'127.0.0.1',r));const response=await fetch(`http://127.0.0.1:${server.address().port}/frozen-runtime-import`);const body=await response.text();assert.equal(response.status,500);assert.match(body,/gray-matter|require is not defined|__dirname is not defined|Cannot find|Failed to load/);\n const report={head:'f15540d26c2329203c626ccb51eb9108c5bebd84',sourceHashes:{runtime:crypto.createHash('sha256').update(runtime).digest('hex'),plugin:crypto.createHash('sha256').update(plugin).digest('hex')},status:response.status,body,viteOwner,viteVersion:version,consumer,oldFailureReproduced:true,qualification:'Exact frozen runtime/plugin bytes via real Vite6.4.3 SSR loader and native loopback HTTP with same-version/range retained DevFn owner as frozen ExtFn. Isolated shared-source audit directory has no parent application installation. Borrowed owner used for audit negative only, not213 genuine ExtFn installation/SvelteKit/native build/browser acceptance.'};fs.writeFileSync(path.join(A,'frozen-native-ssr-owner-result.json'),JSON.stringify(report,null,2)+'\\n');console.log(JSON.stringify(report,null,2));\n}finally{await new Promise(r=>server.close(r));await vite.close();}\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":249,"output":2392,"cacheRead":120192,"cacheWrite":0,"reasoning":1251,"totalTokens":122833,"cost":{"input":0.000498,"output":0.02392,"cacheRead":0.0120192,"cacheWrite":0,"total":0.0364372}},"stopReason":"toolUse","timestamp":1791330896368,"responseId":"resp_055fb762f51dfcfc016ac58a50bd7c87d08b8a26af2c190f0f","rawStopReason":"completed","thinkingLevel":"high"}}
