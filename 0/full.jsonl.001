{"timestamp":"2026-09-19T10:14:59.088Z","ordinal":4860,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b3f5-d570-7a72-b668-401efd539e3b","turn_id":"01a0b91a-027b-7173-bd75-a52040008bc7","item":{"type":"CommandExecution","id":"exec-28a4affc-2a0a-4fe1-96e2-f196a24bdec5","process_id":"27127","command":["/bin/zsh","-lc","nl -ba mcpfn/testing/src/remote-target.ts | sed -n '1,330p;390,650p'\nnl -ba mcpfn/testing/src/reports.ts | sed -n '25,125p'\nnl -ba mcpfn/testing/src/suite.ts | sed -n '70,250p;300,520p'"],"cwd":"file:///Users/serro/Documents/dev/n/worktrees/superfunctions/PR-170","parsed_cmd":[{"type":"read","cmd":"nl -ba mcpfn/testing/src/remote-target.ts","name":"remote-target.ts","path":"mcpfn/testing/src/remote-target.ts"},{"type":"read","cmd":"nl -ba mcpfn/testing/src/reports.ts","name":"reports.ts","path":"mcpfn/testing/src/reports.ts"},{"type":"read","cmd":"nl -ba mcpfn/testing/src/suite.ts","name":"suite.ts","path":"mcpfn/testing/src/suite.ts"}],"source":"unified_exec_startup","status":"completed","stdout":"     1\timport {\n     2\t  McpFnClientError,\n     3\t  customTarget,\n     4\t  streamableHttpTarget,\n     5\t  type McpFnStreamableHttpTargetOptions,\n     6\t  type McpFnTarget,\n     7\t  type McpFnTransportHandle,\n     8\t} from \"@mcpfn/client\";\n     9\t\n    10\timport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n    11\t\n    12\ttype SecretState = { active: Map<string, number>; scopes: Set<Set<string>> };\n    13\tconst targetSecrets = new WeakMap<McpFnTarget, SecretState>();\n    14\t\n    15\t/** Retain released credentials only for the lifetime of a report operation. */\n    16\texport function beginTargetCredentialRedaction(target: McpFnTarget): () => void {\n    17\t  const state = targetSecrets.get(target);\n    18\t  if (!state) return () => undefined;\n    19\t  const scope = new Set(state.active.keys());\n    20\t  state.scopes.add(scope);\n    21\t  return () => { state.scopes.delete(scope); scope.clear(); };\n    22\t}\n    23\t\n    24\tfunction credentialValues(headers: HeadersInit): Set<string> {\n    25\t  const values = boundedCredentialEntries(headers);\n    26\t  const secrets = new Set<string>();\n    27\t  for (const [header, raw] of values) {\n    28\t    if (typeof raw !== \"string\" || !raw.trim()) continue;\n    29\t    secrets.add(raw);\n    30\t    secrets.add(raw.trim());\n    31\t    const normalizedHeader = header.toLowerCase();\n    32\t    if ([\"authorization\", \"proxy-authorization\"].includes(normalizedHeader)) {\n    33\t      addAuthorizationSecrets(raw, secrets);\n    34\t    }\n    35\t    if (normalizedHeader === \"cookie\") addCookieSecrets(raw, secrets);\n    36\t  }\n    37\t  return secrets;\n    38\t}\n    39\t\n    40\tfunction addAuthorizationSecrets(raw: string, secrets: Set<string>): void {\n    41\t  const trimmed = raw.trim();\n    42\t  const separator = trimmed.search(/\\s/);\n    43\t  if (separator <= 0) return;\n    44\t  const scheme = trimmed.slice(0, separator).toLowerCase();\n    45\t  const token = trimmed.slice(separator).trim();\n    46\t  if (token) secrets.add(token);\n    47\t  if (scheme !== \"basic\" || !/^[\\dA-Za-z+/]+={0,2}$/.test(token)) return;\n    48\t  const decoded = Buffer.from(token, \"base64\");\n    49\t  // Round-trip validation avoids interpreting malformed tokens as credentials.\n    50\t  if (decoded.toString(\"base64\").replace(/=+$/, \"\") !== token.replace(/=+$/, \"\")) return;\n    51\t  for (const encoding of [\"utf8\", \"latin1\"] as const) {\n    52\t    const pair = decoded.toString(encoding);\n    53\t    const colon = pair.indexOf(\":\");\n    54\t    if (colon < 0) continue;\n    55\t    for (const value of [pair, pair.slice(0, colon), pair.slice(colon + 1)]) {\n    56\t      if (value) secrets.add(value);\n    57\t    }\n    58\t  }\n    59\t}\n    60\t\n    61\tfunction addCookieSecrets(raw: string, secrets: Set<string>): void {\n    62\t  // Cookie values are independently reflectable even though the request\n    63\t  // authenticates with the complete header. RFC 6265 cookie values cannot\n    64\t  // contain comma or semicolon, so both delimiters cover combined entries.\n    65\t  for (const part of raw.split(/[;,]/)) {\n    66\t    const pair = part.trim();\n    67\t    if (!pair) continue;\n    68\t    const equals = pair.indexOf(\"=\");\n    69\t    if (equals < 1) {\n    70\t      throw new TypeError(\"Cookie credential headers must contain name=value pairs\");\n    71\t    }\n    72\t    const value = pair.slice(equals + 1).trim();\n    73\t    if (!value) continue;\n    74\t    secrets.add(value);\n    75\t    addUnquotedCookieSecret(value, secrets);\n    76\t  }\n    77\t}\n    78\t\n    79\tfunction addUnquotedCookieSecret(value: string, secrets: Set<string>): void {\n    80\t  if (!value.startsWith('\"') && !value.endsWith('\"')) return;\n    81\t  if (value.length < 2 || !value.startsWith('\"') || !value.endsWith('\"')) {\n    82\t    throw new TypeError(\"Cookie credential values must use balanced quotes\");\n    83\t  }\n    84\t  const unquoted = value.slice(1, -1);\n    85\t  if (unquoted.includes('\"') || unquoted.includes(\"\\\\\")) {\n    86\t    throw new TypeError(\"Cookie credential values must use RFC 6265 syntax\");\n    87\t  }\n    88\t  if (unquoted) secrets.add(unquoted);\n    89\t}\n    90\t\n    91\texport class McpFnRedactionLimitError extends Error {\n    92\t  constructor(message = \"Credential redaction exceeded its traversal budget\") { super(message); }\n    93\t}\n    94\t\n    95\t/** No typed artifact can preserve this authored key without exposing a credential. */\n    96\texport class McpFnStructuralCredentialCollisionError extends McpFnRedactionLimitError {\n    97\t  constructor() {\n    98\t    super(\"Credential collides with a required structural artifact key\");\n    99\t  }\n   100\t}\n   101\t\n   102\t// Only these locally authored envelope paths retain structural keys. Unknown\n   103\t// children (including inspector events and server metadata) are always payloads.\n   104\tconst envelopeKeys: Record<string, Set<string>> = Object.fromEntries(Object.entries({\n   105\t  root: \"formatVersion kind status runtime ok target server capabilities manifestChecked manifestHash total passed failed incomplete droppedResults droppedObservedEvents redactionOmittedObservedEvents incompleteReason failure timeline droppedTimelineEvents results count clientState tools resources resourceTemplates prompts droppedEvents timelineComplete droppedInventoryEntries inventoryComplete suiteVersion exitCode stdout stderr phase outcome code requestId at details payload\",\n   106\t  result: \"formatVersion name operation tool status sideEffect durationMs error droppedObservedEvents redactionOmittedObservedEvents\",\n   107\t  diagnostic: \"phase outcome code requestId at target details\",\n   108\t  inspectorEvent: \"formatVersion source kind at event\",\n   109\t  failure: \"name message layer code phase details\",\n   110\t  runtime: \"node scenarioFormatVersion reportSchemaVersion packages\",\n   111\t  packages: \"testing\",\n   112\t  droppedInventoryEntries: \"tools resources resourceTemplates prompts\",\n   113\t  target: \"kind\",\n   114\t}).map(([role, keys]) => [role, new Set(keys.split(\" \"))]));\n   115\t\n   116\tconst structuralArtifactValues = new Map<string, Set<string>>([\n   117\t  [\"root:kind\", new Set([\"logging.message\", \"progress\", \"tasks.status\", \"resources.updated\", \"tools.list_changed\", \"resources.list_changed\", \"prompts.list_changed\", \"resources.subscribed\", \"resources.unsubscribed\", \"client.roots\", \"client.sampling\", \"client.elicitation\", \"mcpfn.target-suite-report\", \"mcpfn.inspector-snapshot\", \"mcpfn.official-conformance-report\"])],\n   118\t  [\"inspectorEvent:kind\", new Set([\"logging.message\", \"progress\", \"tasks.status\", \"resources.updated\", \"tools.list_changed\", \"resources.list_changed\", \"prompts.list_changed\", \"resources.subscribed\", \"resources.unsubscribed\", \"client.roots\", \"client.sampling\", \"client.elicitation\"])],\n   119\t  [\"root:clientState\", new Set([\"idle\", \"connecting\", \"authorization-required\", \"connected\", \"closing\", \"closed\"])],\n   120\t  [\"target:kind\", new Set([\"authenticated-streamable-http\", \"streamable-http\", \"stdio\", \"in-memory\", \"custom\"])],\n   121\t  [\"root:status\", new Set([\"passed\", \"failed\", \"incomplete\", \"complete\"])],\n   122\t  [\"result:status\", new Set([\"passed\", \"failed\", \"incomplete\", \"complete\"])],\n   123\t  [\"root:outcome\", new Set([\"started\", \"succeeded\", \"failed\"])],\n   124\t  [\"diagnostic:outcome\", new Set([\"started\", \"succeeded\", \"failed\"])],\n   125\t  ...[\"root\", \"diagnostic\", \"failure\"].map(role => [\n   126\t    `${role}:phase`,\n   127\t    new Set([\"resource-discovery\", \"authorization-server-discovery\", \"client-registration\", \"authorization-request\", \"authorization-callback\", \"token-exchange\", \"token-refresh\", \"token-revocation\", \"transport-connect\", \"mcp-initialize\", \"capability-operation\", \"transport-close\"]),\n   128\t  ] as [string, Set<string>]),\n   129\t  [\"failure:layer\", new Set([\"mcpfn-preflight\", \"authorization-server\", \"resource-server\", \"mcp-initialization\", \"scenario\", \"upstream-conformance\"])],\n   130\t  [\"inspectorEvent:source\", new Set([\"diagnostic\", \"client\"])],\n   131\t  [\"result:sideEffect\", new Set([\"none\", \"idempotent\", \"non-idempotent\"])],\n   132\t]);\n   133\t\n   134\tconst unrestrictedStructuralValueFields = new Set([\n   135\t  \"packages:testing\",\n   136\t  \"runtime:node\",\n   137\t  \"runtime:reportSchemaVersion\",\n   138\t  \"root:suiteVersion\",\n   139\t]);\n   140\t\n   141\tfunction specialValue(input: unknown): unknown {\n   142\t  if (input instanceof Error) return normalizeErrorValue(input);\n   143\t  if (input instanceof Date) return Number.isNaN(input.getTime()) ? \"Invalid Date\" : input.toISOString();\n   144\t  if (input instanceof URL) return input.href;\n   145\t  if (input instanceof Map) {\n   146\t    if (Object.getOwnPropertyDescriptor(Map.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   147\t    return { type: \"Map\", entries: [...Map.prototype.entries.call(input)] };\n   148\t  }\n   149\t  if (input instanceof Set) {\n   150\t    if (Object.getOwnPropertyDescriptor(Set.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   151\t    return { type: \"Set\", values: [...Set.prototype.values.call(input)] };\n   152\t  }\n   153\t  return input;\n   154\t}\n   155\t\n   156\tfunction normalizeErrorValue(input: Error): Record<string, unknown> {\n   157\t  // Error instances may expose attacker-controlled enumerable keys. A\n   158\t  // null-prototype accumulator keeps `__proto__` as ordinary payload data.\n   159\t  const normalized = Object.create(null) as Record<string, unknown>;\n   160\t  let enumerableFields = 0;\n   161\t  for (const key in input) {\n   162\t    if (!Object.hasOwn(input, key)) continue;\n   163\t    if (++enumerableFields > 100_000) throw new McpFnRedactionLimitError();\n   164\t    normalized[key] = (input as unknown as Record<string, unknown>)[key];\n   165\t  }\n   166\t  normalized.name = input.name;\n   167\t  normalized.message = input.message;\n   168\t  normalized.stack = input.stack;\n   169\t  if (input.cause !== undefined) normalized.cause = input.cause;\n   170\t  return normalized;\n   171\t}\n   172\t\n   173\tfunction scrubCredentials<T>(value: T, values: Iterable<string>, preserveKeys = false, redactionMarker?: string): T {\n   174\t  // Preserve whether a pattern came from opaque text or a serializer. Literal\n   175\t  // percent sequences in credentials must not acquire URL hex-case semantics.\n   176\t  const variants = [...values].filter(Boolean).flatMap(secret => [\n   177\t    { value: secret, encoded: false },\n   178\t    { value: JSON.stringify(secret).slice(1, -1), encoded: false },\n   179\t    { value: encodeURIComponent(secret), encoded: true },\n   180\t    { value: new URLSearchParams({ value: secret }).toString().slice(\"value=\".length), encoded: true },\n   181\t  ]).sort((a, b) => b.value.length - a.value.length);\n   182\t  let entries = 0, stringBytes = 0;\n   183\t  const budget = (input: unknown, depth = 0): void => {\n   184\t    input = specialValue(input);\n   185\t    if ((Array.isArray(input) && input.length > 100_000) || ++entries > 100_000 || depth > 32) throw new McpFnRedactionLimitError();\n   186\t    if (typeof input === \"string\") {\n   187\t      stringBytes += Buffer.byteLength(input);\n   188\t      if (input.length > 262_144 || stringBytes > 2_097_152) throw new McpFnRedactionLimitError();\n   189\t    } else if (input && typeof input === \"object\") {\n   190\t      for (const key in input) if (Object.hasOwn(input, key)) {\n   191\t        budget(key, depth + 1);\n   192\t        budget((input as Record<string, unknown>)[key], depth + 1);\n   193\t      }\n   194\t    }\n   195\t  };\n   196\t  // Check before either redactor allocates copies. Exceeding a budget is an\n   197\t  // explicit failure, never silent truncation of a typed report collection.\n   198\t  budget(value);\n   199\t  const patterns = variants.map(({ value, encoded }) => {\n   200\t    const literal = value.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n   201\t    // Only generated percent escapes accept mixed-case hex digits.\n   202\t    return encoded\n   203\t      ? literal.replace(/%[\\dA-Fa-f]{2}/g, escape => escape.replace(/[A-Fa-f]/g, hex => `[${hex.toLowerCase()}${hex.toUpperCase()}]`))\n   204\t      : literal;\n   205\t  });\n   206\t  const secretPattern = patterns.length ? new RegExp(patterns.join(\"|\"), \"g\") : undefined;\n   207\t  const replacementPattern = patterns.length ? new RegExp(patterns.join(\"|\")) : undefined;\n   208\t  const preserveStructural = (input: string): string => {\n   209\t    if (replacementPattern?.test(input)) {\n   210\t      throw new McpFnRedactionLimitError(\n   211\t        \"Credential collides with a required structural artifact field\",\n   212\t      );\n   213\t    }\n   214\t    return input;\n   215\t  };\n   216\t  const preserveStructuralKey = (input: string): string => {\n   217\t    if (replacementPattern?.test(input)) {\n   218\t      throw new McpFnStructuralCredentialCollisionError();\n   219\t    }\n   220\t    return input;\n   221\t  };\n   222\t  // A requested marker is itself output and must not reproduce a credential.\n   223\t  if (secretPattern) {\n   224\t    const markerContainsSecret = secretPattern.test(redactionMarker ?? \"[REDACTED]\");\n   225\t    secretPattern.lastIndex = 0;\n   226\t    if (markerContainsSecret) redactionMarker = \"\";\n   227\t  }\n   228\t  const scrubString = (input: string, role: string, field: string, finalPass: boolean): string => {\n   229\t    const structuralField = `${role}:${field}`;\n   230\t    if (unrestrictedStructuralValueFields.has(structuralField) ||\n   231\t        structuralArtifactValues.get(structuralField)?.has(input)) {\n   232\t      return preserveStructural(input);\n   233\t    }\n   234\t    // Whole-string rejection cannot compose another credential by joining pieces.\n   235\t    // Run after both redactors; never feed this result through another redactor.\n   236\t    if (finalPass) return replacementPattern?.test(input) ? \"\" : input;\n   237\t    if (!secretPattern) return input;\n   238\t    return input.replace(secretPattern, secret => {\n   239\t      const maskCharacter = secret.includes(\"*\") ? \"#\" : \"*\";\n   240\t      const defaultReplacement = secret.length < 10\n   241\t        ? maskCharacter.repeat(secret.length)\n   242\t        : \"[REDACTED]\";\n   243\t      const replacement = redactionMarker ?? defaultReplacement;\n   244\t      // Every generated mask must be safe against the entire credential set.\n   245\t      return replacementPattern!.test(replacement) ? \"\" : replacement;\n   246\t    });\n   247\t  };\n   248\t  const scrub = (input: unknown, role = \"payload\", field = \"\", finalPass = false): unknown => {\n   249\t    input = specialValue(input);\n   250\t    if (typeof input === \"string\") return scrubString(input, role, field, finalPass);\n   251\t    if (Array.isArray(input)) {\n   252\t      const result = input.map(entry => scrub(entry, role, \"\", finalPass));\n   253\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   254\t      return result;\n   255\t    }\n   256\t    if (input && typeof input === \"object\") {\n   257\t      const entries: Array<[string, unknown]> = [];\n   258\t      const keys = new Set<string>();\n   259\t      for (const [key, entry] of Object.entries(input)) {\n   260\t        const fixed = envelopeKeys[role]?.has(key) ?? false;\n   261\t        if (fixed) preserveStructuralKey(key);\n   262\t        let childRole = \"payload\";\n   263\t        if (fixed) {\n   264\t          if (key === \"results\") childRole = \"result\";\n   265\t          else if (key === \"timeline\") childRole = (value as any)?.kind === \"mcpfn.inspector-snapshot\" ? \"inspectorEvent\" : \"diagnostic\";\n   266\t          else if ([\"failure\", \"runtime\", \"packages\", \"droppedInventoryEntries\", \"target\"].includes(key)) childRole = key;\n   267\t          else if (role === \"inspectorEvent\" && key === \"event\") childRole = (input as { source?: string }).source === \"client\" ? \"root\" : \"diagnostic\";\n   268\t        }\n   269\t        const scrubbedKey = fixed ? key : scrub(key, \"payload\", \"\", finalPass) as string;\n   270\t        if (keys.has(scrubbedKey)) {\n   271\t          throw new McpFnRedactionLimitError(\n   272\t            \"Credential redaction created duplicate object keys\",\n   273\t          );\n   274\t        }\n   275\t        keys.add(scrubbedKey);\n   276\t        const scrubbedEntry = typeof entry === \"string\"\n   277\t          ? scrub(entry, fixed ? role : \"payload\", key, finalPass)\n   278\t          : scrub(entry, childRole, \"\", finalPass);\n   279\t        entries.push([scrubbedKey, scrubbedEntry]);\n   280\t      }\n   281\t      const result = Object.fromEntries(entries);\n   282\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   283\t      return result;\n   284\t    }\n   285\t    return input;\n   286\t  };\n   287\t  const timelineEvent = value && typeof value === \"object\" && [\"client\", \"diagnostic\"].includes((value as { source?: string }).source ?? \"\");\n   288\t  let role = \"payload\";\n   289\t  if (preserveKeys) role = timelineEvent ? \"inspectorEvent\" : \"root\";\n   290\t  const scrubbed = scrub(value, role);\n   291\t  const generic = redactOAuthValue(scrubbed, { maxStringLength: 262_144, maxDepth: 64, maxArrayEntries: 100_000, maxObjectEntries: 100_000, ...(redactionMarker !== undefined ? { redactionMarker } : {}) });\n   292\t  const result = scrub(generic, role, \"\", true) as T;\n   293\t  assertPayloadSerialization(\n   294\t    result,\n   295\t    \"payload\",\n   296\t    true,\n   297\t    replacementPattern,\n   298\t  );\n   299\t  return result;\n   300\t}\n   301\t\n   302\tfunction assertPayloadSerialization(\n   303\t  value: unknown,\n   304\t  role: string,\n   305\t  finalPass: boolean,\n   306\t  credentialPattern: RegExp | undefined,\n   307\t): void {\n   308\t  if (!finalPass || role !== \"payload\" || !credentialPattern) return;\n   309\t  const serialized = JSON.stringify(value);\n   310\t  if (serialized !== undefined && credentialPattern.test(serialized)) {\n   311\t    throw new McpFnRedactionLimitError(\n   312\t      \"Credential redaction could not guarantee safe serialized output\",\n   313\t    );\n   314\t  }\n   315\t}\n   316\t\n   317\t/** Remove known opaque credential values as well as credential-shaped fields. */\n   318\texport function redactTargetCredentials<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean; redactionMarker?: string } = {}): T {\n   319\t  const state = targetSecrets.get(target);\n   320\t  return scrubCredentials(value, new Set([...(state?.active.keys() ?? []), ...[...(state?.scopes ?? [])].flatMap((scope) => [...scope])]), options.preserveKeys, options.redactionMarker);\n   321\t}\n   322\t\n   323\t/** Redact authenticated conformance output using the acquired credential. */\n   324\texport function redactRemoteCredential<T>(credential: McpFnRemoteCredential, value: T, options: { preserveKeys?: boolean } = {}): T {\n   325\t  return scrubCredentials(value, credentialValues(credential.headers), options.preserveKeys);\n   326\t}\n   327\t\n   328\tconst MAX_CREDENTIAL_HEADERS = 32;\n   329\tconst MAX_CREDENTIAL_HEADER_BYTES = 16_384;\n   330\tconst MAX_CREDENTIAL_HEADER_VALUE_BYTES = 8_192;\n   390\t/** Create a provider for an already-bounded API key or OAuth-derived token. */\n   391\texport function staticRemoteCredentialProvider(\n   392\t  credential: McpFnRemoteCredential,\n   393\t): McpFnRemoteCredentialProvider {\n   394\t  return { acquire: () => credential };\n   395\t}\n   396\t\n   397\t/** Acquire a credential and return an idempotent revoke-then-dispose lease. */\n   398\texport async function acquireRemoteCredential(\n   399\t  source: McpFnRemoteCredential | McpFnRemoteCredentialProvider,\n   400\t  context: McpFnRemoteCredentialContext,\n   401\t): Promise<McpFnRemoteCredentialLease> {\n   402\t  let provider: McpFnRemoteCredentialProvider;\n   403\t  let acquired: McpFnRemoteCredential;\n   404\t  try {\n   405\t    provider = isCredentialProvider(source) ? source : staticRemoteCredentialProvider(source);\n   406\t    acquired = await provider.acquire(context);\n   407\t  } catch {\n   408\t    // Until acquisition returns, its opaque secrets are unknown to the redactor.\n   409\t    // The provider owns rollback of resources allocated before it rejects.\n   410\t    throw new Error(\"Target credential acquisition failed\");\n   411\t  }\n   412\t  let credential = acquired;\n   413\t  try {\n   414\t    // Detach all valid header forms from provider-owned mutable storage.\n   415\t    credential = { ...acquired, headers: boundedCredentialEntries(acquired.headers) };\n   416\t  } catch {\n   417\t    // Invalid headers are rejected by the caller's validation inside its cleanup\n   418\t    // boundary. Keep the acquired object so that rejection can still revoke it.\n   419\t  }\n   420\t  let releasePromise: Promise<void> | undefined;\n   421\t  let revoked = false;\n   422\t  let disposed = false;\n   423\t  let cleanupPhase: \"token-revocation\" | \"transport-close\" = credential.kind === \"oauth\"\n   424\t    ? \"token-revocation\"\n   425\t    : \"transport-close\";\n   426\t  return {\n   427\t    credential,\n   428\t    cleanupPhase: () => cleanupPhase,\n   429\t    release() {\n   430\t      releasePromise ??= (async () => {\n   431\t        // Cancellation of acquisition must not cancel revocation or its retries.\n   432\t        const cleanupContext = { ...context, signal: new AbortController().signal };\n   433\t        try {\n   434\t          // Provider-local state may be required to retry revocation.\n   435\t          if (!revoked) {\n   436\t            cleanupPhase = credential.kind === \"oauth\" ? \"token-revocation\" : \"transport-close\";\n   437\t            await provider.revoke?.(acquired, cleanupContext);\n   438\t            revoked = true;\n   439\t          }\n   440\t          if (!disposed) {\n   441\t            // Revocation already completed: a later disposal failure is not an\n   442\t            // authorization-server failure.\n   443\t            cleanupPhase = \"transport-close\";\n   444\t            await provider.dispose?.(acquired, cleanupContext);\n   445\t            disposed = true;\n   446\t          }\n   447\t        } catch {\n   448\t          throw new McpFnClientError(\n   449\t            \"MCPFN_OPERATION_FAILED\",\n   450\t            \"Target credential cleanup failed\",\n   451\t            { phase: cleanupPhase, retryable: true },\n   452\t          );\n   453\t        }\n   454\t      })().catch(error => { releasePromise = undefined; throw error; });\n   455\t      return releasePromise;\n   456\t    },\n   457\t  };\n   458\t}\n   459\t\n   460\t/**\n   461\t * A URL-plus-credential target for non-McpFn servers. It delegates MCP and\n   462\t * transport behavior to the production @mcpfn/client session engine.\n   463\t */\n   464\texport function authenticatedHttpTarget(\n   465\t  url: string | URL,\n   466\t  options: McpFnAuthenticatedHttpTargetOptions,\n   467\t): McpFnTarget {\n   468\t  const targetUrl = normalizeRemoteTargetUrl(url);\n   469\t  const descriptorUrl = new URL(targetUrl);\n   470\t  descriptorUrl.search = \"\";\n   471\t  const { credential: _credential, requestInit, ...transportOptions } = options;\n   472\t\n   473\t  const state: SecretState = { active: new Map(), scopes: new Set() };\n   474\t  const pendingReleases = new Set<() => Promise<void>>();\n   475\t  const authenticated = customTarget({\n   476\t    kind: \"authenticated-streamable-http\",\n   477\t    descriptor: {\n   478\t      url: descriptorUrl.toString(),\n   479\t      authenticated: true,\n   480\t    },\n   481\t    redact: (value, redaction) => redactTargetCredentials(authenticated, value, { preserveKeys: true, ...redaction }),\n   482\t    async cleanup() {\n   483\t      const results = await Promise.allSettled([...pendingReleases].map(release => release()));\n   484\t      const failures = results.filter((result): result is PromiseRejectedResult => result.status === \"rejected\");\n   485\t      const failure = failures.find(({ reason }) => reason && typeof reason === \"object\" &&\n   486\t        (reason as { phase?: unknown }).phase === \"token-revocation\") ?? failures[0];\n   487\t      if (failure) throw failure.reason;\n   488\t    },\n   489\t    async open(targetContext): Promise<McpFnTransportHandle> {\n   490\t      const context: McpFnRemoteCredentialContext = {\n   491\t        url: targetUrl.toString(),\n   492\t        requestId: targetContext.requestId,\n   493\t        signal: targetContext.signal,\n   494\t      };\n   495\t      const lease = await acquireRemoteCredential(options.credential, context);\n   496\t      const secrets = new Set<string>();\n   497\t      const release = async () => {\n   498\t        try { await lease.release(); }\n   499\t        catch (error) { pendingReleases.add(release); throw error; }\n   500\t        pendingReleases.delete(release);\n   501\t        for (const secret of secrets) {\n   502\t          const count = (state.active.get(secret) ?? 1) - 1;\n   503\t          if (count) state.active.set(secret, count); else state.active.delete(secret);\n   504\t        }\n   505\t        secrets.clear();\n   506\t      };\n   507\t      let handle: McpFnTransportHandle | undefined;\n   508\t      try {\n   509\t        for (const secret of credentialValues(lease.credential.headers)) {\n   510\t          secrets.add(secret);\n   511\t          state.active.set(secret, (state.active.get(secret) ?? 0) + 1);\n   512\t          for (const scope of state.scopes) scope.add(secret);\n   513\t        }\n   514\t        const credentialHeaders = validateRemoteCredentialHeaders(lease.credential.headers);\n   515\t        const headers = new Headers(requestInit?.headers);\n   516\t        credentialHeaders.forEach((value, name) => headers.set(name, value));\n   517\t        const target = streamableHttpTarget(targetUrl, {\n   518\t          ...transportOptions,\n   519\t          requestInit: {\n   520\t            ...requestInit,\n   521\t            headers,\n   522\t            // Fetch must not replay credentials to a redirect destination.\n   523\t            redirect: \"error\",\n   524\t          },\n   525\t        });\n   526\t        handle = await target.open(targetContext);\n   527\t      } catch (error) {\n   528\t        // Sanitize while the lease still supplies its immutable header snapshot.\n   529\t        // Cleanup removes active secrets before the client emits failed-open diagnostics.\n   530\t        let message = \"Authenticated target could not be opened\";\n   531\t        try { message = redactRemoteCredential(lease.credential, error instanceof Error ? error.message : String(error)); }\n   532\t        catch { /* Invalid or oversized credentials must not escape through diagnostics. */ }\n   533\t        pendingReleases.add(release);\n   534\t        await release();\n   535\t        throw new Error(message);\n   536\t      }\n   537\t\n   538\t      let closePromise: Promise<void> | undefined;\n   539\t      let transportClosed = false;\n   540\t      return {\n   541\t        transport: handle.transport,\n   542\t        finishAuthorization: handle.finishAuthorization,\n   543\t        terminateSession: handle.terminateSession,\n   544\t        close() {\n   545\t          closePromise ??= Promise.resolve().then(async () => {\n   546\t            // The client coordinator retains this handle until both stages finish.\n   547\t            // Never release authentication while transport shutdown still needs retry.\n   548\t            if (!transportClosed) {\n   549\t              if (handle!.close) await handle!.close();\n   550\t              else await handle!.transport.close();\n   551\t              transportClosed = true;\n   552\t            }\n   553\t            await release();\n   554\t          }).catch(async (error) => {\n   555\t            closePromise = undefined;\n   556\t            const phase = transportClosed ? lease.cleanupPhase() : \"transport-close\";\n   557\t            await targetContext.diagnostic({\n   558\t              phase, outcome: \"failed\", code: \"MCPFN_CREDENTIAL_CLEANUP_FAILED\",\n   559\t              requestId: targetContext.requestId, at: new Date().toISOString(),\n   560\t              target: { kind: \"authenticated-streamable-http\", url: descriptorUrl.toString() },\n   561\t              details: { message: \"Target credential cleanup failed\" },\n   562\t            });\n   563\t            throw error;\n   564\t          });\n   565\t          return closePromise;\n   566\t        },\n   567\t      };\n   568\t    },\n   569\t  });\n   570\t  targetSecrets.set(authenticated, state);\n   571\t  return authenticated;\n   572\t}\n   573\t\n   574\tfunction normalizeRemoteTargetUrl(value: string | URL): URL {\n   575\t  const url = new URL(value.toString());\n   576\t  if (url.protocol !== \"http:\" && url.protocol !== \"https:\") {\n   577\t    throw new TypeError(\"Authenticated MCP targets must use HTTP or HTTPS\");\n   578\t  }\n   579\t  if (url.protocol === \"http:\" && url.hostname !== \"[::1]\" &&\n   580\t      !/^127(?:\\.\\d{1,3}){3}$/.test(url.hostname)) {\n   581\t    throw new TypeError(\"Credential-bearing HTTP targets require a literal loopback address; use HTTPS remotely\");\n   582\t  }\n   583\t  if (url.username || url.password || url.hash) {\n   584\t    throw new TypeError(\n   585\t      \"Authenticated MCP target URLs must not contain userinfo or a fragment\",\n   586\t    );\n   587\t  }\n   588\t  return url;\n   589\t}\n   590\t\n   591\tfunction isCredentialProvider(\n   592\t  value: McpFnRemoteCredential | McpFnRemoteCredentialProvider,\n   593\t): value is McpFnRemoteCredentialProvider {\n   594\t  return \"acquire\" in value && typeof value.acquire === \"function\";\n   595\t}\n   596\t\n   597\tfunction boundedCredentialEntries(value: HeadersInit): Array<[string, string]> {\n   598\t  const entries: Array<[string, string]> = [];\n   599\t  let bytes = 0;\n   600\t  const append = (name: string, headerValue: string) => {\n   601\t    if (entries.length >= MAX_CREDENTIAL_HEADERS) throw new TypeError(\"Credential headers exceed the header limit\");\n   602\t    if (typeof name !== \"string\" || typeof headerValue !== \"string\") throw new TypeError(\"Credential header values must be strings\");\n   603\t    if (name.length > MAX_CREDENTIAL_HEADER_BYTES || headerValue.length > MAX_CREDENTIAL_HEADER_VALUE_BYTES) throw new TypeError(\"Credential header exceeds the value-size limit\");\n   604\t    if (new TextEncoder().encode(headerValue).byteLength > MAX_CREDENTIAL_HEADER_VALUE_BYTES) throw new TypeError(\"Credential header exceeds the value-size limit\");\n   605\t    bytes += new TextEncoder().encode(`${name}: ${headerValue}\\r\\n`).byteLength;\n   606\t    if (bytes > MAX_CREDENTIAL_HEADER_BYTES) throw new TypeError(\"Credential headers exceed the aggregate size limit\");\n   607\t    entries.push([name, headerValue]);\n   608\t  };\n   609\t  if (value instanceof Headers) value.forEach((v, k) => append(k, v));\n   610\t  else if (Array.isArray(value)) {\n   611\t    if (value.length > MAX_CREDENTIAL_HEADERS) throw new TypeError(\"Credential headers exceed the header limit\");\n   612\t    for (const entry of value) append(entry[0], entry[1]);\n   613\t  } else {\n   614\t    for (const name in value) if (Object.hasOwn(value, name)) append(name, value[name]);\n   615\t  }\n   616\t  return entries;\n   617\t}\n   618\t\n   619\texport function validateRemoteCredentialHeaders(value: HeadersInit): Headers {\n   620\t  const headers = new Headers(boundedCredentialEntries(value));\n   621\t  const entries: Array<[string, string]> = [];\n   622\t  headers.forEach((headerValue, name) => entries.push([name, headerValue]));\n   623\t  if (entries.length === 0) {\n   624\t    throw new TypeError(\"Authenticated MCP targets require at least one credential header\");\n   625\t  }\n   626\t  if (entries.length > MAX_CREDENTIAL_HEADERS) {\n   627\t    throw new TypeError(`Credential headers exceed the ${MAX_CREDENTIAL_HEADERS}-header limit`);\n   628\t  }\n   629\t  let bytes = 0;\n   630\t  for (const [name, headerValue] of entries) {\n   631\t    if (!headerValue.trim()) throw new TypeError(\"Credential header values must not be blank\");\n   632\t    if (FORBIDDEN_CREDENTIAL_HEADERS.has(name)) {\n   633\t      throw new TypeError(`Credential header ${name} is not allowed`);\n   634\t    }\n   635\t    const valueBytes = new TextEncoder().encode(headerValue).byteLength;\n   636\t    if (valueBytes > MAX_CREDENTIAL_HEADER_VALUE_BYTES) {\n   637\t      throw new TypeError(`Credential header ${name} exceeds the value-size limit`);\n   638\t    }\n   639\t    if (new TextEncoder().encode(headerValue).byteLength > MAX_CREDENTIAL_HEADER_VALUE_BYTES) throw new TypeError(\"Credential header exceeds the value-size limit\");\n   640\t    bytes += new TextEncoder().encode(`${name}: ${headerValue}\\r\\n`).byteLength;\n   641\t  }\n   642\t  if (bytes > MAX_CREDENTIAL_HEADER_BYTES) {\n   643\t    throw new TypeError(\"Credential headers exceed the aggregate size limit\");\n   644\t  }\n   645\t  return headers;\n   646\t}\n    25\t  details?: Record<string, unknown>;\n    26\t}\n    27\t\n    28\texport interface McpFnJunitOptions {\n    29\t  /** Aggregate XML size cap after serialization. Defaults to 1 MiB. */\n    30\t  maxBytes?: number;\n    31\t}\n    32\t\n    33\texport function normalizeMcpFnReportFailure(\n    34\t  error: unknown,\n    35\t  fallbackPhase?: McpFnDiagnosticPhase | \"scenario\" | \"upstream-conformance\",\n    36\t): McpFnReportFailure {\n    37\t  const redacted = redactOAuthValue(error, {\n    38\t    maxDepth: 6,\n    39\t    maxArrayEntries: 50,\n    40\t    maxObjectEntries: 50,\n    41\t    maxStringLength: 2_048,\n    42\t  });\n    43\t  const record = redacted && typeof redacted === \"object\" && !Array.isArray(redacted)\n    44\t    ? redacted as Record<string, unknown>\n    45\t    : {};\n    46\t  const phase = stringField(record.phase) ?? fallbackPhase;\n    47\t  const details = record.details && typeof record.details === \"object\" &&\n    48\t      !Array.isArray(record.details)\n    49\t    ? record.details as Record<string, unknown>\n    50\t    : undefined;\n    51\t  let message = stringField(record.message) ?? String(\n    52\t    redactOAuthValue(error instanceof Error ? error.message : String(error)),\n    53\t  );\n    54\t  const cause = error && typeof error === \"object\"\n    55\t    ? (error as { cause?: unknown }).cause\n    56\t    : undefined;\n    57\t  const redactedCause = cause === undefined\n    58\t    ? undefined\n    59\t    : redactOAuthValue(cause, {\n    60\t      maxDepth: 4,\n    61\t      maxArrayEntries: 20,\n    62\t      maxObjectEntries: 20,\n    63\t      maxStringLength: 1_024,\n    64\t    });\n    65\t  const causeRecord = redactedCause && typeof redactedCause === \"object\" &&\n    66\t      !Array.isArray(redactedCause)\n    67\t    ? redactedCause as Record<string, unknown>\n    68\t    : undefined;\n    69\t  const causeMessage = stringField(causeRecord?.message);\n    70\t  if (causeMessage && !message.includes(causeMessage)) message = `${message}: ${causeMessage}`;\n    71\t  const combinedDetails = causeRecord ? { ...details, cause: causeRecord } : details;\n    72\t  const layer = failureLayer(phase);\n    73\t  const deniedByResource = layer !== \"authorization-server\" &&\n    74\t    [causeRecord?.code, causeRecord?.status, record.code, record.status]\n    75\t      .some(value => [401, 403].includes(Number(value)));\n    76\t  return {\n    77\t    name: stringField(record.name) ?? \"Error\",\n    78\t    message,\n    79\t    layer: deniedByResource ? \"resource-server\" : layer,\n    80\t    ...(stringField(record.code) ? { code: stringField(record.code)! } : {}),\n    81\t    ...(phase ? { phase } : {}),\n    82\t    ...(combinedDetails ? { details: combinedDetails } : {}),\n    83\t  };\n    84\t}\n    85\t\n    86\t/** Serialize a redacted target-suite report as bounded JUnit XML. */\n    87\texport function createMcpFnTargetSuiteJUnit(\n    88\t  report: McpFnTargetSuiteReport,\n    89\t  options: McpFnJunitOptions = {},\n    90\t): string {\n    91\t  const maxBytes = options.maxBytes ?? 1_048_576;\n    92\t  validateArtifactCap(maxBytes);\n    93\t  const safe = redactOAuthValue(report, {\n    94\t    maxDepth: 10,\n    95\t    maxArrayEntries: 1_000,\n    96\t    maxObjectEntries: 200,\n    97\t    maxStringLength: 4_096,\n    98\t  }) as unknown as McpFnTargetSuiteReport;\n    99\t  // Redaction appends a string sentinel when an array exceeds its cap.\n   100\t  const results = safe.results.filter((result) => result && typeof result === \"object\" && typeof result.name === \"string\");\n   101\t  const omitted = report.results.length - results.length;\n   102\t  const cases = results.map((result) => {\n   103\t    const duration = Math.max(0, result.durationMs ?? 0) / 1_000;\n   104\t    let failure = \"\";\n   105\t    if (result.status !== \"passed\") {\n   106\t      const failureType = result.status === \"failed\" ? \"scenario\" : \"incomplete\";\n   107\t      failure = junitFailure(result.error ?? `Scenario ${result.status}`, failureType);\n   108\t    }\n   109\t    return `    <testcase name=\"${xml(result.name)}\" classname=\"mcpfn.scenario\" time=\"${duration.toFixed(3)}\">${failure}</testcase>`;\n   110\t  });\n   111\t  if (safe.failure) {\n   112\t    cases.unshift(\n   113\t      `    <testcase name=\"${xml(safe.failure.phase ?? \"target\")}\" classname=\"mcpfn.${xml(safe.failure.layer)}\" time=\"0.000\">${junitFailure(safe.failure.message, safe.failure.code ?? safe.failure.layer)}</testcase>`,\n   114\t    );\n   115\t  }\n   116\t  if (safe.status === \"incomplete\" || omitted > 0 || (!safe.ok && !safe.failure && results.every((result) => result.status === \"passed\"))) {\n   117\t    cases.push(`    <testcase name=\"suite-incomplete\" classname=\"mcpfn.report\" time=\"0.000\">${junitFailure(safe.incompleteReason ?? \"Suite evidence is incomplete or omitted\", \"incomplete\")}</testcase>`);\n   118\t  }\n   119\t  if (cases.length === 0) {\n   120\t    cases.push(\n   121\t      '    <testcase name=\"target-suite\" classname=\"mcpfn.target\" time=\"0.000\"></testcase>',\n   122\t    );\n   123\t  }\n   124\t  const failures = cases.filter((entry) => entry.includes(\"<failure \")).length;\n   125\t  let serialized = junitDocument(safe, cases, failures);\n    70\t  redactionOmittedObservedEvents?: number;\n    71\t  incompleteReason?: string;\n    72\t  failure?: McpFnReportFailure;\n    73\t  timeline: McpFnDiagnosticEvent[];\n    74\t  droppedTimelineEvents: number;\n    75\t  results: McpFnScenarioResult[];\n    76\t}\n    77\t\n    78\tconst suiteCleanupOwners = new WeakMap<Error, { close: () => Promise<void>; pending?: Promise<void> }>();\n    79\t\n    80\tfunction retryTargetSuiteCleanup(error: Error): Promise<void> {\n    81\t  const owner = suiteCleanupOwners.get(error);\n    82\t  if (!owner) return Promise.resolve();\n    83\t  if (owner.pending) return owner.pending;\n    84\t  const pending = Promise.resolve().then(owner.close).then(\n    85\t    () => { suiteCleanupOwners.delete(error); },\n    86\t    () => Promise.reject(error),\n    87\t  ).finally(() => { owner.pending = undefined; });\n    88\t  owner.pending = pending;\n    89\t  return pending;\n    90\t}\n    91\t\n    92\t/** Final cleanup failed. The bounded report is a snapshot; retain this error to retry. */\n    93\texport class McpFnTargetSuiteCleanupError extends Error {\n    94\t  constructor(readonly report: McpFnTargetSuiteReport, close: () => Promise<void>) {\n    95\t    super(\"Target suite cleanup failed; retain this error and retryCleanup()\");\n    96\t    this.name = \"McpFnTargetSuiteCleanupError\";\n    97\t    suiteCleanupOwners.set(this, { close });\n    98\t  }\n    99\t\n   100\t  retryCleanup(): Promise<void> {\n   101\t    return retryTargetSuiteCleanup(this);\n   102\t  }\n   103\t}\n   104\t\n   105\t/** Report serialization failed after cleanup ownership had already transferred. */\n   106\texport class McpFnTargetSuiteArtifactCleanupError extends Error {\n   107\t  constructor(close: () => Promise<void>, cause: Error) {\n   108\t    super(`${cause.message}; retain this error and retryCleanup()`, { cause });\n   109\t    this.name = \"McpFnTargetSuiteArtifactCleanupError\";\n   110\t    suiteCleanupOwners.set(this, { close });\n   111\t  }\n   112\t\n   113\t  retryCleanup(): Promise<void> {\n   114\t    return retryTargetSuiteCleanup(this);\n   115\t  }\n   116\t}\n   117\t\n   118\t/** Runs local, stdio, HTTP, or custom targets through the production session engine. */\n   119\texport async function runMcpFnTargetSuite(\n   120\t  options: RunMcpFnTargetSuiteOptions,\n   121\t): Promise<McpFnTargetSuiteReport> {\n   122\t  const finishRedaction = beginTargetCredentialRedaction(options.target);\n   123\t  try { return await runTargetSuite(options); }\n   124\t  finally { finishRedaction(); }\n   125\t}\n   126\t\n   127\t/** Apply the target-owned scrubber before the bounded generic artifact pass. */\n   128\tfunction redactSuiteArtifact<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean } = {}): T {\n   129\t  const scrubbed = target.redact ? target.redact(value, options) : value;\n   130\t  return redactTargetCredentials(target, scrubbed, options);\n   131\t}\n   132\t\n   133\tfunction compareInventoryNames(left: string, right: string): number {\n   134\t  if (left === right) return 0;\n   135\t  return left < right ? -1 : 1;\n   136\t}\n   137\t\n   138\tfunction reportProjectionFailureReason(\n   139\t  error: unknown,\n   140\t  projectionFailure: \"redaction\" | \"serialization\" | undefined,\n   141\t): string {\n   142\t  if (error instanceof McpFnRedactionLimitError) {\n   143\t    return \"Credential redaction exceeded its traversal budget\";\n   144\t  }\n   145\t  if (projectionFailure === \"redaction\") {\n   146\t    return \"Credential redaction failed; report content omitted because safe serialization failed\";\n   147\t  }\n   148\t  return \"Report content omitted because safe serialization failed\";\n   149\t}\n   150\t\n   151\tclass SuiteDiagnosticCollector {\n   152\t  readonly timeline: McpFnDiagnosticEvent[] = [];\n   153\t  private readonly timelineSizes: number[] = [];\n   154\t  private timelineBytes = 0;\n   155\t  private observedRedactionOmissions = 0;\n   156\t  private initialRedactionOmissions = 0;\n   157\t  dropped = 0;\n   158\t  countExceeded = false;\n   159\t  bytesExceeded = false;\n   160\t  serializationFailed = false;\n   161\t  redactionFailed = false;\n   162\t  cleanupFailure: McpFnReportFailure | undefined;\n   163\t\n   164\t  constructor(\n   165\t    private readonly maxEvents: number,\n   166\t    private readonly maxBytes: number,\n   167\t    private readonly target: McpFnTarget,\n   168\t    private readonly consumer?: (event: McpFnDiagnosticEvent) => void | Promise<void>,\n   169\t  ) {}\n   170\t\n   171\t  captureBaseline(client: McpFnTestClient): void {\n   172\t    this.initialRedactionOmissions = client.session\n   173\t      .getRedactionOmissionCounts().diagnostics;\n   174\t  }\n   175\t\n   176\t  captureUnobserved(client: McpFnTestClient | undefined): void {\n   177\t    const total = client?.session.getRedactionOmissionCounts().diagnostics ??\n   178\t      this.initialRedactionOmissions;\n   179\t    const unobserved = Math.max(\n   180\t      0,\n   181\t      total - this.initialRedactionOmissions - this.observedRedactionOmissions,\n   182\t    );\n   183\t    if (unobserved > 0) {\n   184\t      this.redactionFailed = true;\n   185\t      this.dropped += unobserved;\n   186\t    }\n   187\t  }\n   188\t\n   189\t  async record(client: McpFnTestClient | undefined, event: McpFnDiagnosticEvent): Promise<void> {\n   190\t    if (client?.session.isRedactionOmission(event)) {\n   191\t      this.observedRedactionOmissions += 1;\n   192\t      this.redactionFailed = true;\n   193\t      this.dropped += 1;\n   194\t    }\n   195\t    if ([\"token-revocation\", \"transport-close\"].includes(event.phase) &&\n   196\t        event.outcome === \"failed\") {\n   197\t      this.cleanupFailure ??= normalizeMcpFnReportFailure({\n   198\t        name: \"CleanupError\", message: \"Target cleanup failed\",\n   199\t        code: event.code, phase: event.phase,\n   200\t      });\n   201\t    }\n   202\t    const safeEvent = redactTargetCredentials(this.target, event, { preserveKeys: true });\n   203\t    const bytes = this.serializedBytes(safeEvent);\n   204\t    if (bytes === undefined) {\n   205\t      await this.consumer?.(safeEvent);\n   206\t      return;\n   207\t    }\n   208\t    if (bytes > this.maxBytes) {\n   209\t      this.bytesExceeded = true;\n   210\t      this.dropped += 1;\n   211\t    } else {\n   212\t      this.timeline.push(safeEvent);\n   213\t      this.timelineSizes.push(bytes);\n   214\t      this.timelineBytes += bytes;\n   215\t      this.enforceBounds();\n   216\t    }\n   217\t    await this.consumer?.(safeEvent);\n   218\t  }\n   219\t\n   220\t  private serializedBytes(event: McpFnDiagnosticEvent): number | undefined {\n   221\t    try {\n   222\t      const json = JSON.stringify(event, (_key, value: unknown) => {\n   223\t        if (value === undefined || (typeof value === \"number\" && !Number.isFinite(value))) {\n   224\t          throw new Error(\"Diagnostic contains a non-JSON value\");\n   225\t        }\n   226\t        return value;\n   227\t      });\n   228\t      structuredClone(event);\n   229\t      return Buffer.byteLength(json);\n   230\t    } catch {\n   231\t      this.serializationFailed = true;\n   232\t      this.dropped += 1;\n   233\t      return undefined;\n   234\t    }\n   235\t  }\n   236\t\n   237\t  private enforceBounds(): void {\n   238\t    while (this.timeline.length > this.maxEvents || this.timelineBytes > this.maxBytes) {\n   239\t      this.countExceeded ||= this.timeline.length > this.maxEvents;\n   240\t      this.bytesExceeded ||= this.timelineBytes > this.maxBytes;\n   241\t      this.timeline.shift();\n   242\t      this.timelineBytes -= this.timelineSizes.shift()!;\n   243\t      this.dropped += 1;\n   244\t    }\n   245\t  }\n   246\t}\n   247\t\n   248\tasync function runTargetSuite(options: RunMcpFnTargetSuiteOptions): Promise<McpFnTargetSuiteReport> {\n   249\t  const maxTimelineEvents = options.maxTimelineEvents ?? 500;\n   250\t  if (!Number.isInteger(maxTimelineEvents) || maxTimelineEvents < 1) {\n   300\t      const expected = [...options.expectedToolNames].sort(compareInventoryNames);\n   301\t      if (stableJson(actual) !== stableJson(expected)) {\n   302\t        throw new McpFnAssertionError(`Tool inventory mismatch: expected ${stableJson(expected)}, actual ${stableJson(actual)}`);\n   303\t      }\n   304\t    }\n   305\t    execution = {\n   306\t      results: await runScenarios(\n   307\t        client,\n   308\t        options.scenarios ?? [],\n   309\t        options.scenarioRun,\n   310\t      ),\n   311\t      server: client.session.getServerVersion(),\n   312\t      capabilities: client.session.getServerCapabilities(),\n   313\t    };\n   314\t  } catch (error) {\n   315\t    try {\n   316\t      failure = normalizeMcpFnReportFailure(redactSuiteArtifact(options.target, error, { preserveKeys: true }));\n   317\t    } catch {\n   318\t      // Arbitrary error properties/proxies can throw, including secret-bearing errors.\n   319\t      failure = normalizeMcpFnReportFailure({ name: \"RedactionError\", code: \"MCPFN_REDACTION_FAILED\", message: \"Target failure omitted because credential redaction failed\" });\n   320\t    }\n   321\t  } finally {\n   322\t    try {\n   323\t      // Custom hooks may depend on credentials cleared by close. Capture every\n   324\t      // target-controlled report value while the session still owns that state.\n   325\t      if (client?.session.state === \"connected\") {\n   326\t        let kind: string | undefined;\n   327\t        let descriptor: Omit<McpFnTargetDescriptor, \"kind\"> | undefined;\n   328\t        try {\n   329\t          ({ kind, ...descriptor } = options.target.describe());\n   330\t        } catch { projectionFailure = \"serialization\"; }\n   331\t        if (!projectionFailure) {\n   332\t          try {\n   333\t            capturedTarget = {\n   334\t              ...redactSuiteArtifact(options.target, descriptor!, { preserveKeys: false }),\n   335\t              kind: client.session.preserveArtifactStructure(kind!),\n   336\t            };\n   337\t            capturedManifestHash = options.manifest\n   338\t              ? redactSuiteArtifact(options.target, options.manifest.hash, { preserveKeys: false })\n   339\t              : undefined;\n   340\t            execution = {\n   341\t              server: execution.server === undefined\n   342\t                ? undefined\n   343\t                : redactSuiteArtifact(options.target, execution.server, { preserveKeys: false }),\n   344\t              capabilities: execution.capabilities === undefined\n   345\t                ? undefined\n   346\t                : redactSuiteArtifact(options.target, execution.capabilities, { preserveKeys: false }),\n   347\t              results: execution.results.map(result => ({\n   348\t                ...result,\n   349\t                name: redactSuiteArtifact(options.target, result.name, { preserveKeys: false }),\n   350\t                operation: redactSuiteArtifact(options.target, result.operation, { preserveKeys: false }),\n   351\t                ...(result.tool === undefined ? {} : {\n   352\t                  tool: redactSuiteArtifact(options.target, result.tool, { preserveKeys: false }),\n   353\t                }),\n   354\t              })),\n   355\t            };\n   356\t          } catch { projectionFailure = \"redaction\"; }\n   357\t        }\n   358\t      } else if (execution.results.length || execution.server || execution.capabilities) {\n   359\t        projectionFailure = \"serialization\";\n   360\t      }\n   361\t    } catch { projectionFailure = \"serialization\"; }\n   362\t    try {\n   363\t      await client?.close();\n   364\t    } catch (error) {\n   365\t      const owner = client;\n   366\t      if (error instanceof McpFnTestClientCleanupError) {\n   367\t        retainedCleanup = () => error.retryCleanup();\n   368\t      } else if (owner) {\n   369\t        retainedCleanup = () => owner.close();\n   370\t      }\n   371\t      const terminalCleanupError = error instanceof McpFnTestClientCleanupError && error.cause !== undefined\n   372\t        ? error.cause\n   373\t        : error;\n   374\t      const terminalCleanupPhase = terminalCleanupError && typeof terminalCleanupError === \"object\" &&\n   375\t          (terminalCleanupError as { phase?: unknown }).phase === \"token-revocation\"\n   376\t        ? \"token-revocation\"\n   377\t        : \"transport-close\";\n   378\t      cleanupFailure = normalizeMcpFnReportFailure({\n   379\t        name: \"CleanupError\",\n   380\t        message: \"Target cleanup failed\",\n   381\t        code: \"MCPFN_TARGET_CLEANUP_FAILED\",\n   382\t        phase: terminalCleanupPhase,\n   383\t      });\n   384\t    }\n   385\t    diagnostics.captureUnobserved(client);\n   386\t  }\n   387\t  cleanupFailure ??= diagnostics.cleanupFailure;\n   388\t  failure ??= cleanupFailure;\n   389\t  const results = execution.results;\n   390\t  const failed = results.filter((result) => result.status === \"failed\").length;\n   391\t  const incomplete = results.filter((result) => result.status === \"incomplete\").length;\n   392\t  const droppedObservedEvents = results.reduce(\n   393\t    (total, result) => total + (result.droppedObservedEvents ?? 0),\n   394\t    0,\n   395\t  );\n   396\t  const redactionOmittedObservedEvents = results.reduce(\n   397\t    (total, result) => total + (result.redactionOmittedObservedEvents ?? 0),\n   398\t    0,\n   399\t  );\n   400\t  const overflowedObservedEvents = droppedObservedEvents - redactionOmittedObservedEvents;\n   401\t  const artifactIncomplete = Boolean(failure) || incomplete > 0 ||\n   402\t    diagnostics.dropped > 0 ||\n   403\t    droppedObservedEvents > 0;\n   404\t  const report: McpFnTargetSuiteReport = {\n   405\t    formatVersion: 1,\n   406\t    kind: \"mcpfn.target-suite-report\",\n   407\t    status: artifactIncomplete ? \"incomplete\" : \"complete\",\n   408\t    runtime: {\n   409\t      node: process.version,\n   410\t      scenarioFormatVersion: 1,\n   411\t      reportSchemaVersion: MCPFN_REPORT_SCHEMA_VERSION,\n   412\t      packages: { testing: MCPFN_TESTING_VERSION },\n   413\t    },\n   414\t    ok: failed === 0 && !artifactIncomplete,\n   415\t    target: capturedTarget,\n   416\t    server: execution.server,\n   417\t    capabilities: execution.capabilities,\n   418\t    manifestChecked,\n   419\t    ...(capturedManifestHash === undefined ? {} : { manifestHash: capturedManifestHash }),\n   420\t    total: results.length,\n   421\t    passed: results.length - failed - incomplete,\n   422\t    failed,\n   423\t    incomplete,\n   424\t    droppedResults: 0,\n   425\t    droppedObservedEvents,\n   426\t    ...(redactionOmittedObservedEvents > 0 ? { redactionOmittedObservedEvents } : {}),\n   427\t    ...(failure || diagnostics.dropped > 0 || droppedObservedEvents > 0\n   428\t      ? {\n   429\t        incompleteReason: [\n   430\t          ...(failure ? [`${failure.layer}: ${failure.message}`] : []),\n   431\t          ...(cleanupFailure ? [`Cleanup: ${cleanupFailure.message}`] : []),\n   432\t          ...(diagnostics.serializationFailed ? [\"Diagnostic timeline contained non-JSON data\"] : []),\n   433\t          ...(diagnostics.redactionFailed ? [\"Diagnostic timeline redaction failed; original events omitted\"] : []),\n   434\t          ...(diagnostics.countExceeded ? [\"Diagnostic timeline exceeded maxTimelineEvents\"] : []),\n   435\t          ...(diagnostics.bytesExceeded ? [\"Diagnostic timeline exceeded maxReportBytes\"] : []),\n   436\t          ...(redactionOmittedObservedEvents > 0\n   437\t            ? [\"Observed client events were omitted because credential redaction failed\"]\n   438\t            : []),\n   439\t          ...(overflowedObservedEvents > 0\n   440\t            ? [\"Observed client events exceeded maxObservedEvents\"]\n   441\t            : []),\n   442\t        ].join(\"; \"),\n   443\t      }\n   444\t      : {}),\n   445\t    ...(failure ? { failure } : {}),\n   446\t    timeline: diagnostics.timeline,\n   447\t    droppedTimelineEvents: diagnostics.dropped,\n   448\t    results,\n   449\t  };\n   450\t  let finalized: McpFnTargetSuiteReport;\n   451\t  try {\n   452\t    if (projectionFailure) throw new Error(\"Report payload projection failed\");\n   453\t    // Custom redaction already completed before cleanup. Built-in report scopes\n   454\t    // remain active here for bounded final serialization.\n   455\t    finalized = enforceReportCap(redactTargetCredentials(options.target, report, { preserveKeys: true }), maxReportBytes);\n   456\t  } catch (error) {\n   457\t    if (error instanceof McpFnStructuralCredentialCollisionError) {\n   458\t      const failure = new McpFnClientError(\n   459\t        \"MCPFN_OPERATION_FAILED\",\n   460\t        \"Target report cannot be serialized because a credential conflicts with required artifact structure\",\n   461\t        { phase: \"capability-operation\" },\n   462\t      );\n   463\t      if (retainedCleanup) {\n   464\t        throw new McpFnTargetSuiteArtifactCleanupError(retainedCleanup, failure);\n   465\t      }\n   466\t      throw failure;\n   467\t    }\n   468\t    finalized = enforceReportCap({ ...report, ok: false, status: \"incomplete\",\n   469\t      incompleteReason: reportProjectionFailureReason(error, projectionFailure),\n   470\t      target: { kind: \"custom\" }, server: undefined, capabilities: undefined, manifestHash: undefined,\n   471\t      failure: undefined, results: [], timeline: [],\n   472\t      droppedResults: report.results.length, droppedTimelineEvents: report.droppedTimelineEvents + report.timeline.length,\n   473\t    }, maxReportBytes);\n   474\t  }\n   475\t  if (retainedCleanup) throw new McpFnTargetSuiteCleanupError(finalized, retainedCleanup);\n   476\t  return finalized;\n   477\t}\n   478\t\n   479\tfunction enforceReportCap(\n   480\t  report: McpFnTargetSuiteReport,\n   481\t  maxBytes: number,\n   482\t): McpFnTargetSuiteReport {\n   483\t  validateReportCap(maxBytes);\n   484\t  const bounded = structuredClone(report);\n   485\t  if (jsonBytes(bounded) > maxBytes) {\n   486\t    bounded.ok = false;\n   487\t    bounded.status = \"incomplete\";\n   488\t    bounded.incompleteReason = \"Report content exceeded maxReportBytes and was truncated\";\n   489\t  }\n   490\t  while (jsonBytes(bounded) > maxBytes && bounded.results.length > 0) {\n   491\t    bounded.results.pop();\n   492\t    bounded.droppedResults += 1;\n   493\t  }\n   494\t  if (jsonBytes(bounded) > maxBytes) {\n   495\t    bounded.target = { kind: report.target.kind };\n   496\t    bounded.server = undefined;\n   497\t    bounded.capabilities = undefined;\n   498\t    bounded.timeline = [];\n   499\t    bounded.droppedTimelineEvents += report.timeline.length;\n   500\t    if (bounded.failure) {\n   501\t      bounded.failure.details = undefined;\n   502\t      bounded.failure.message = \"Target operation failed; details omitted to fit report budget\";\n   503\t    }\n   504\t  }\n   505\t  if (bounded.droppedResults > 0 || jsonBytes(bounded) > maxBytes) {\n   506\t    bounded.ok = false;\n   507\t    bounded.status = \"incomplete\";\n   508\t    bounded.incompleteReason = \"Report content exceeded maxReportBytes and was truncated\";\n   509\t  }\n   510\t  if (jsonBytes(bounded) > maxBytes) {\n   511\t    throw new Error(\"The minimum target suite report exceeds maxReportBytes\");\n   512\t  }\n   513\t  return bounded;\n   514\t}\n   515\t\n   516\tfunction validateReportCap(maxBytes: number): void {\n   517\t  if (!Number.isInteger(maxBytes) || maxBytes < 1_024) {\n   518\t    throw new Error(\"maxReportBytes must be an integer of at least 1024\");\n   519\t  }\n   520\t}\n","stderr":"","aggregated_output":"     1\timport {\n     2\t  McpFnClientError,\n     3\t  customTarget,\n     4\t  streamableHttpTarget,\n     5\t  type McpFnStreamableHttpTargetOptions,\n     6\t  type McpFnTarget,\n     7\t  type McpFnTransportHandle,\n     8\t} from \"@mcpfn/client\";\n     9\t\n    10\timport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n    11\t\n    12\ttype SecretState = { active: Map<string, number>; scopes: Set<Set<string>> };\n    13\tconst targetSecrets = new WeakMap<McpFnTarget, SecretState>();\n    14\t\n    15\t/** Retain released credentials only for the lifetime of a report operation. */\n    16\texport function beginTargetCredentialRedaction(target: McpFnTarget): () => void {\n    17\t  const state = targetSecrets.get(target);\n    18\t  if (!state) return () => undefined;\n    19\t  const scope = new Set(state.active.keys());\n    20\t  state.scopes.add(scope);\n    21\t  return () => { state.scopes.delete(scope); scope.clear(); };\n    22\t}\n    23\t\n    24\tfunction credentialValues(headers: HeadersInit): Set<string> {\n    25\t  const values = boundedCredentialEntries(headers);\n    26\t  const secrets = new Set<string>();\n    27\t  for (const [header, raw] of values) {\n    28\t    if (typeof raw !== \"string\" || !raw.trim()) continue;\n    29\t    secrets.add(raw);\n    30\t    secrets.add(raw.trim());\n    31\t    const normalizedHeader = header.toLowerCase();\n    32\t    if ([\"authorization\", \"proxy-authorization\"].includes(normalizedHeader)) {\n    33\t      addAuthorizationSecrets(raw, secrets);\n    34\t    }\n    35\t    if (normalizedHeader === \"cookie\") addCookieSecrets(raw, secrets);\n    36\t  }\n    37\t  return secrets;\n    38\t}\n    39\t\n    40\tfunction addAuthorizationSecrets(raw: string, secrets: Set<string>): void {\n    41\t  const trimmed = raw.trim();\n    42\t  const separator = trimmed.search(/\\s/);\n    43\t  if (separator <= 0) return;\n    44\t  const scheme = trimmed.slice(0, separator).toLowerCase();\n    45\t  const token = trimmed.slice(separator).trim();\n    46\t  if (token) secrets.add(token);\n    47\t  if (scheme !== \"basic\" || !/^[\\dA-Za-z+/]+={0,2}$/.test(token)) return;\n    48\t  const decoded = Buffer.from(token, \"base64\");\n    49\t  // Round-trip validation avoids interpreting malformed tokens as credentials.\n    50\t  if (decoded.toString(\"base64\").replace(/=+$/, \"\") !== token.replace(/=+$/, \"\")) return;\n    51\t  for (const encoding of [\"utf8\", \"latin1\"] as const) {\n    52\t    const pair = decoded.toString(encoding);\n    53\t    const colon = pair.indexOf(\":\");\n    54\t    if (colon < 0) continue;\n    55\t    for (const value of [pair, pair.slice(0, colon), pair.slice(colon + 1)]) {\n    56\t      if (value) secrets.add(value);\n    57\t    }\n    58\t  }\n    59\t}\n    60\t\n    61\tfunction addCookieSecrets(raw: string, secrets: Set<string>): void {\n    62\t  // Cookie values are independently reflectable even though the request\n    63\t  // authenticates with the complete header. RFC 6265 cookie values cannot\n    64\t  // contain comma or semicolon, so both delimiters cover combined entries.\n    65\t  for (const part of raw.split(/[;,]/)) {\n    66\t    const pair = part.trim();\n    67\t    if (!pair) continue;\n    68\t    const equals = pair.indexOf(\"=\");\n    69\t    if (equals < 1) {\n    70\t      throw new TypeError(\"Cookie credential headers must contain name=value pairs\");\n    71\t    }\n    72\t    const value = pair.slice(equals + 1).trim();\n    73\t    if (!value) continue;\n    74\t    secrets.add(value);\n    75\t    addUnquotedCookieSecret(value, secrets);\n    76\t  }\n    77\t}\n    78\t\n    79\tfunction addUnquotedCookieSecret(value: string, secrets: Set<string>): void {\n    80\t  if (!value.startsWith('\"') && !value.endsWith('\"')) return;\n    81\t  if (value.length < 2 || !value.startsWith('\"') || !value.endsWith('\"')) {\n    82\t    throw new TypeError(\"Cookie credential values must use balanced quotes\");\n    83\t  }\n    84\t  const unquoted = value.slice(1, -1);\n    85\t  if (unquoted.includes('\"') || unquoted.includes(\"\\\\\")) {\n    86\t    throw new TypeError(\"Cookie credential values must use RFC 6265 syntax\");\n    87\t  }\n    88\t  if (unquoted) secrets.add(unquoted);\n    89\t}\n    90\t\n    91\texport class McpFnRedactionLimitError extends Error {\n    92\t  constructor(message = \"Credential redaction exceeded its traversal budget\") { super(message); }\n    93\t}\n    94\t\n    95\t/** No typed artifact can preserve this authored key without exposing a credential. */\n    96\texport class McpFnStructuralCredentialCollisionError extends McpFnRedactionLimitError {\n    97\t  constructor() {\n    98\t    super(\"Credential collides with a required structural artifact key\");\n    99\t  }\n   100\t}\n   101\t\n   102\t// Only these locally authored envelope paths retain structural keys. Unknown\n   103\t// children (including inspector events and server metadata) are always payloads.\n   104\tconst envelopeKeys: Record<string, Set<string>> = Object.fromEntries(Object.entries({\n   105\t  root: \"formatVersion kind status runtime ok target server capabilities manifestChecked manifestHash total passed failed incomplete droppedResults droppedObservedEvents redactionOmittedObservedEvents incompleteReason failure timeline droppedTimelineEvents results count clientState tools resources resourceTemplates prompts droppedEvents timelineComplete droppedInventoryEntries inventoryComplete suiteVersion exitCode stdout stderr phase outcome code requestId at details payload\",\n   106\t  result: \"formatVersion name operation tool status sideEffect durationMs error droppedObservedEvents redactionOmittedObservedEvents\",\n   107\t  diagnostic: \"phase outcome code requestId at target details\",\n   108\t  inspectorEvent: \"formatVersion source kind at event\",\n   109\t  failure: \"name message layer code phase details\",\n   110\t  runtime: \"node scenarioFormatVersion reportSchemaVersion packages\",\n   111\t  packages: \"testing\",\n   112\t  droppedInventoryEntries: \"tools resources resourceTemplates prompts\",\n   113\t  target: \"kind\",\n   114\t}).map(([role, keys]) => [role, new Set(keys.split(\" \"))]));\n   115\t\n   116\tconst structuralArtifactValues = new Map<string, Set<string>>([\n   117\t  [\"root:kind\", new Set([\"logging.message\", \"progress\", \"tasks.status\", \"resources.updated\", \"tools.list_changed\", \"resources.list_changed\", \"prompts.list_changed\", \"resources.subscribed\", \"resources.unsubscribed\", \"client.roots\", \"client.sampling\", \"client.elicitation\", \"mcpfn.target-suite-report\", \"mcpfn.inspector-snapshot\", \"mcpfn.official-conformance-report\"])],\n   118\t  [\"inspectorEvent:kind\", new Set([\"logging.message\", \"progress\", \"tasks.status\", \"resources.updated\", \"tools.list_changed\", \"resources.list_changed\", \"prompts.list_changed\", \"resources.subscribed\", \"resources.unsubscribed\", \"client.roots\", \"client.sampling\", \"client.elicitation\"])],\n   119\t  [\"root:clientState\", new Set([\"idle\", \"connecting\", \"authorization-required\", \"connected\", \"closing\", \"closed\"])],\n   120\t  [\"target:kind\", new Set([\"authenticated-streamable-http\", \"streamable-http\", \"stdio\", \"in-memory\", \"custom\"])],\n   121\t  [\"root:status\", new Set([\"passed\", \"failed\", \"incomplete\", \"complete\"])],\n   122\t  [\"result:status\", new Set([\"passed\", \"failed\", \"incomplete\", \"complete\"])],\n   123\t  [\"root:outcome\", new Set([\"started\", \"succeeded\", \"failed\"])],\n   124\t  [\"diagnostic:outcome\", new Set([\"started\", \"succeeded\", \"failed\"])],\n   125\t  ...[\"root\", \"diagnostic\", \"failure\"].map(role => [\n   126\t    `${role}:phase`,\n   127\t    new Set([\"resource-discovery\", \"authorization-server-discovery\", \"client-registration\", \"authorization-request\", \"authorization-callback\", \"token-exchange\", \"token-refresh\", \"token-revocation\", \"transport-connect\", \"mcp-initialize\", \"capability-operation\", \"transport-close\"]),\n   128\t  ] as [string, Set<string>]),\n   129\t  [\"failure:layer\", new Set([\"mcpfn-preflight\", \"authorization-server\", \"resource-server\", \"mcp-initialization\", \"scenario\", \"upstream-conformance\"])],\n   130\t  [\"inspectorEvent:source\", new Set([\"diagnostic\", \"client\"])],\n   131\t  [\"result:sideEffect\", new Set([\"none\", \"idempotent\", \"non-idempotent\"])],\n   132\t]);\n   133\t\n   134\tconst unrestrictedStructuralValueFields = new Set([\n   135\t  \"packages:testing\",\n   136\t  \"runtime:node\",\n   137\t  \"runtime:reportSchemaVersion\",\n   138\t  \"root:suiteVersion\",\n   139\t]);\n   140\t\n   141\tfunction specialValue(input: unknown): unknown {\n   142\t  if (input instanceof Error) return normalizeErrorValue(input);\n   143\t  if (input instanceof Date) return Number.isNaN(input.getTime()) ? \"Invalid Date\" : input.toISOString();\n   144\t  if (input instanceof URL) return input.href;\n   145\t  if (input instanceof Map) {\n   146\t    if (Object.getOwnPropertyDescriptor(Map.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   147\t    return { type: \"Map\", entries: [...Map.prototype.entries.call(input)] };\n   148\t  }\n   149\t  if (input instanceof Set) {\n   150\t    if (Object.getOwnPropertyDescriptor(Set.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   151\t    return { type: \"Set\", values: [...Set.prototype.values.call(input)] };\n   152\t  }\n   153\t  return input;\n   154\t}\n   155\t\n   156\tfunction normalizeErrorValue(input: Error): Record<string, unknown> {\n   157\t  // Error instances may expose attacker-controlled enumerable keys. A\n   158\t  // null-prototype accumulator keeps `__proto__` as ordinary payload data.\n   159\t  const normalized = Object.create(null) as Record<string, unknown>;\n   160\t  let enumerableFields = 0;\n   161\t  for (const key in input) {\n   162\t    if (!Object.hasOwn(input, key)) continue;\n   163\t    if (++enumerableFields > 100_000) throw new McpFnRedactionLimitError();\n   164\t    normalized[key] = (input as unknown as Record<string, unknown>)[key];\n   165\t  }\n   166\t  normalized.name = input.name;\n   167\t  normalized.message = input.message;\n   168\t  normalized.stack = input.stack;\n   169\t  if (input.cause !== undefined) normalized.cause = input.cause;\n   170\t  return normalized;\n   171\t}\n   172\t\n   173\tfunction scrubCredentials<T>(value: T, values: Iterable<string>, preserveKeys = false, redactionMarker?: string): T {\n   174\t  // Preserve whether a pattern came from opaque text or a serializer. Literal\n   175\t  // percent sequences in credentials must not acquire URL hex-case semantics.\n   176\t  const variants = [...values].filter(Boolean).flatMap(secret => [\n   177\t    { value: secret, encoded: false },\n   178\t    { value: JSON.stringify(secret).slice(1, -1), encoded: false },\n   179\t    { value: encodeURIComponent(secret), encoded: true },\n   180\t    { value: new URLSearchParams({ value: secret }).toString().slice(\"value=\".length), encoded: true },\n   181\t  ]).sort((a, b) => b.value.length - a.value.length);\n   182\t  let entries = 0, stringBytes = 0;\n   183\t  const budget = (input: unknown, depth = 0): void => {\n   184\t    input = specialValue(input);\n   185\t    if ((Array.isArray(input) && input.length > 100_000) || ++entries > 100_000 || depth > 32) throw new McpFnRedactionLimitError();\n   186\t    if (typeof input === \"string\") {\n   187\t      stringBytes += Buffer.byteLength(input);\n   188\t      if (input.length > 262_144 || stringBytes > 2_097_152) throw new McpFnRedactionLimitError();\n   189\t    } else if (input && typeof input === \"object\") {\n   190\t      for (const key in input) if (Object.hasOwn(input, key)) {\n   191\t        budget(key, depth + 1);\n   192\t        budget((input as Record<string, unknown>)[key], depth + 1);\n   193\t      }\n   194\t    }\n   195\t  };\n   196\t  // Check before either redactor allocates copies. Exceeding a budget is an\n   197\t  // explicit failure, never silent truncation of a typed report collection.\n   198\t  budget(value);\n   199\t  const patterns = variants.map(({ value, encoded }) => {\n   200\t    const literal = value.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n   201\t    // Only generated percent escapes accept mixed-case hex digits.\n   202\t    return encoded\n   203\t      ? literal.replace(/%[\\dA-Fa-f]{2}/g, escape => escape.replace(/[A-Fa-f]/g, hex => `[${hex.toLowerCase()}${hex.toUpperCase()}]`))\n   204\t      : literal;\n   205\t  });\n   206\t  const secretPattern = patterns.length ? new RegExp(patterns.join(\"|\"), \"g\") : undefined;\n   207\t  const replacementPattern = patterns.length ? new RegExp(patterns.join(\"|\")) : undefined;\n   208\t  const preserveStructural = (input: string): string => {\n   209\t    if (replacementPattern?.test(input)) {\n   210\t      throw new McpFnRedactionLimitError(\n   211\t        \"Credential collides with a required structural artifact field\",\n   212\t      );\n   213\t    }\n   214\t    return input;\n   215\t  };\n   216\t  const preserveStructuralKey = (input: string): string => {\n   217\t    if (replacementPattern?.test(input)) {\n   218\t      throw new McpFnStructuralCredentialCollisionError();\n   219\t    }\n   220\t    return input;\n   221\t  };\n   222\t  // A requested marker is itself output and must not reproduce a credential.\n   223\t  if (secretPattern) {\n   224\t    const markerContainsSecret = secretPattern.test(redactionMarker ?? \"[REDACTED]\");\n   225\t    secretPattern.lastIndex = 0;\n   226\t    if (markerContainsSecret) redactionMarker = \"\";\n   227\t  }\n   228\t  const scrubString = (input: string, role: string, field: string, finalPass: boolean): string => {\n   229\t    const structuralField = `${role}:${field}`;\n   230\t    if (unrestrictedStructuralValueFields.has(structuralField) ||\n   231\t        structuralArtifactValues.get(structuralField)?.has(input)) {\n   232\t      return preserveStructural(input);\n   233\t    }\n   234\t    // Whole-string rejection cannot compose another credential by joining pieces.\n   235\t    // Run after both redactors; never feed this result through another redactor.\n   236\t    if (finalPass) return replacementPattern?.test(input) ? \"\" : input;\n   237\t    if (!secretPattern) return input;\n   238\t    return input.replace(secretPattern, secret => {\n   239\t      const maskCharacter = secret.includes(\"*\") ? \"#\" : \"*\";\n   240\t      const defaultReplacement = secret.length < 10\n   241\t        ? maskCharacter.repeat(secret.length)\n   242\t        : \"[REDACTED]\";\n   243\t      const replacement = redactionMarker ?? defaultReplacement;\n   244\t      // Every generated mask must be safe against the entire credential set.\n   245\t      return replacementPattern!.test(replacement) ? \"\" : replacement;\n   246\t    });\n   247\t  };\n   248\t  const scrub = (input: unknown, role = \"payload\", field = \"\", finalPass = false): unknown => {\n   249\t    input = specialValue(input);\n   250\t    if (typeof input === \"string\") return scrubString(input, role, field, finalPass);\n   251\t    if (Array.isArray(input)) {\n   252\t      const result = input.map(entry => scrub(entry, role, \"\", finalPass));\n   253\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   254\t      return result;\n   255\t    }\n   256\t    if (input && typeof input === \"object\") {\n   257\t      const entries: Array<[string, unknown]> = [];\n   258\t      const keys = new Set<string>();\n   259\t      for (const [key, entry] of Object.entries(input)) {\n   260\t        const fixed = envelopeKeys[role]?.has(key) ?? false;\n   261\t        if (fixed) preserveStructuralKey(key);\n   262\t        let childRole = \"payload\";\n   263\t        if (fixed) {\n   264\t          if (key === \"results\") childRole = \"result\";\n   265\t          else if (key === \"timeline\") childRole = (value as any)?.kind === \"mcpfn.inspector-snapshot\" ? \"inspectorEvent\" : \"diagnostic\";\n   266\t          else if ([\"failure\", \"runtime\", \"packages\", \"droppedInventoryEntries\", \"target\"].includes(key)) childRole = key;\n   267\t          else if (role === \"inspectorEvent\" && key === \"event\") childRole = (input as { source?: string }).source === \"client\" ? \"root\" : \"diagnostic\";\n   268\t        }\n   269\t        const scrubbedKey = fixed ? key : scrub(key, \"payload\", \"\", finalPass) as string;\n   270\t        if (keys.has(scrubbedKey)) {\n   271\t          throw new McpFnRedactionLimitError(\n   272\t            \"Credential redaction created duplicate object keys\",\n   273\t          );\n   274\t        }\n   275\t        keys.add(scrubbedKey);\n   276\t        const scrubbedEntry = typeof entry === \"string\"\n   277\t          ? scrub(entry, fixed ? role : \"payload\", key, finalPass)\n   278\t          : scrub(entry, childRole, \"\", finalPass);\n   279\t        entries.push([scrubbedKey, scrubbedEntry]);\n   280\t      }\n   281\t      const result = Object.fromEntries(entries);\n   282\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   283\t      return result;\n   284\t    }\n   285\t    return input;\n   286\t  };\n   287\t  const timelineEvent = value && typeof value === \"object\" && [\"client\", \"diagnostic\"].includes((value as { source?: string }).source ?? \"\");\n   288\t  let role = \"payload\";\n   289\t  if (preserveKeys) role = timelineEvent ? \"inspectorEvent\" : \"root\";\n   290\t  const scrubbed = scrub(value, role);\n   291\t  const generic = redactOAuthValue(scrubbed, { maxStringLength: 262_144, maxDepth: 64, maxArrayEntries: 100_000, maxObjectEntries: 100_000, ...(redactionMarker !== undefined ? { redactionMarker } : {}) });\n   292\t  const result = scrub(generic, role, \"\", true) as T;\n   293\t  assertPayloadSerialization(\n   294\t    result,\n   295\t    \"payload\",\n   296\t    true,\n   297\t    replacementPattern,\n   298\t  );\n   299\t  return result;\n   300\t}\n   301\t\n   302\tfunction assertPayloadSerialization(\n   303\t  value: unknown,\n   304\t  role: string,\n   305\t  finalPass: boolean,\n   306\t  credentialPattern: RegExp | undefined,\n   307\t): void {\n   308\t  if (!finalPass || role !== \"payload\" || !credentialPattern) return;\n   309\t  const serialized = JSON.stringify(value);\n   310\t  if (serialized !== undefined && credentialPattern.test(serialized)) {\n   311\t    throw new McpFnRedactionLimitError(\n   312\t      \"Credential redaction could not guarantee safe serialized output\",\n   313\t    );\n   314\t  }\n   315\t}\n   316\t\n   317\t/** Remove known opaque credential values as well as credential-shaped fields. */\n   318\texport function redactTargetCredentials<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean; redactionMarker?: string } = {}): T {\n   319\t  const state = targetSecrets.get(target);\n   320\t  return scrubCredentials(value, new Set([...(state?.active.keys() ?? []), ...[...(state?.scopes ?? [])].flatMap((scope) => [...scope])]), options.preserveKeys, options.redactionMarker);\n   321\t}\n   322\t\n   323\t/** Redact authenticated conformance output using the acquired credential. */\n   324\texport function redactRemoteCredential<T>(credential: McpFnRemoteCredential, value: T, options: { preserveKeys?: boolean } = {}): T {\n   325\t  return scrubCredentials(value, credentialValues(credential.headers), options.preserveKeys);\n   326\t}\n   327\t\n   328\tconst MAX_CREDENTIAL_HEADERS = 32;\n   329\tconst MAX_CREDENTIAL_HEADER_BYTES = 16_384;\n   330\tconst MAX_CREDENTIAL_HEADER_VALUE_BYTES = 8_192;\n   390\t/** Create a provider for an already-bounded API key or OAuth-derived token. */\n   391\texport function staticRemoteCredentialProvider(\n   392\t  credential: McpFnRemoteCredential,\n   393\t): McpFnRemoteCredentialProvider {\n   394\t  return { acquire: () => credential };\n   395\t}\n   396\t\n   397\t/** Acquire a credential and return an idempotent revoke-then-dispose lease. */\n   398\texport async function acquireRemoteCredential(\n   399\t  source: McpFnRemoteCredential | McpFnRemoteCredentialProvider,\n   400\t  context: McpFnRemoteCredentialContext,\n   401\t): Promise<McpFnRemoteCredentialLease> {\n   402\t  let provider: McpFnRemoteCredentialProvider;\n   403\t  let acquired: McpFnRemoteCredential;\n   404\t  try {\n   405\t    provider = isCredentialProvider(source) ? source : staticRemoteCredentialProvider(source);\n   406\t    acquired = await provider.acquire(context);\n   407\t  } catch {\n   408\t    // Until acquisition returns, its opaque secrets are unknown to the redactor.\n   409\t    // The provider owns rollback of resources allocated before it rejects.\n   410\t    throw new Error(\"Target credential acquisition failed\");\n   411\t  }\n   412\t  let credential = acquired;\n   413\t  try {\n   414\t    // Detach all valid header forms from provider-owned mutable storage.\n   415\t    credential = { ...acquired, headers: boundedCredentialEntries(acquired.headers) };\n   416\t  } catch {\n   417\t    // Invalid headers are rejected by the caller's validation inside its cleanup\n   418\t    // boundary. Keep the acquired object so that rejection can still revoke it.\n   419\t  }\n   420\t  let releasePromise: Promise<void> | undefined;\n   421\t  let revoked = false;\n   422\t  let disposed = false;\n   423\t  let cleanupPhase: \"token-revocation\" | \"transport-close\" = credential.kind === \"oauth\"\n   424\t    ? \"token-revocation\"\n   425\t    : \"transport-close\";\n   426\t  return {\n   427\t    credential,\n   428\t    cleanupPhase: () => cleanupPhase,\n   429\t    release() {\n   430\t      releasePromise ??= (async () => {\n   431\t        // Cancellation of acquisition must not cancel revocation or its retries.\n   432\t        const cleanupContext = { ...context, signal: new AbortController().signal };\n   433\t        try {\n   434\t          // Provider-local state may be required to retry revocation.\n   435\t          if (!revoked) {\n   436\t            cleanupPhase = credential.kind === \"oauth\" ? \"token-revocation\" : \"transport-close\";\n   437\t            await provider.revoke?.(acquired, cleanupContext);\n   438\t            revoked = true;\n   439\t          }\n   440\t          if (!disposed) {\n   441\t            // Revocation already completed: a later disposal failure is not an\n   442\t            // authorization-server failure.\n   443\t            cleanupPhase = \"transport-close\";\n   444\t            await provider.dispose?.(acquired, cleanupContext);\n   445\t            disposed = true;\n   446\t          }\n   447\t        } catch {\n   448\t          throw new McpFnClientError(\n   449\t            \"MCPFN_OPERATION_FAILED\",\n   450\t            \"Target credential cleanup failed\",\n   451\t            { phase: cleanupPhase, retryable: true },\n   452\t          );\n   453\t        }\n   454\t      })().catch(error => { releasePromise = undefined; throw error; });\n   455\t      return releasePromise;\n   456\t    },\n   457\t  };\n   458\t}\n   459\t\n   460\t/**\n   461\t * A URL-plus-credential target for non-McpFn servers. It delegates MCP and\n   462\t * transport behavior to the production @mcpfn/client session engine.\n   463\t */\n   464\texport function authenticatedHttpTarget(\n   465\t  url: string | URL,\n   466\t  options: McpFnAuthenticatedHttpTargetOptions,\n   467\t): McpFnTarget {\n   468\t  const targetUrl = normalizeRemoteTargetUrl(url);\n   469\t  const descriptorUrl = new URL(targetUrl);\n   470\t  descriptorUrl.search = \"\";\n   471\t  const { credential: _credential, requestInit, ...transportOptions } = options;\n   472\t\n   473\t  const state: SecretState = { active: new Map(), scopes: new Set() };\n   474\t  const pendingReleases = new Set<() => Promise<void>>();\n   475\t  const authenticated = customTarget({\n   476\t    kind: \"authenticated-streamable-http\",\n   477\t    descriptor: {\n   478\t      url: descriptorUrl.toString(),\n   479\t      authenticated: true,\n   480\t    },\n   481\t    redact: (value, redaction) => redactTargetCredentials(authenticated, value, { preserveKeys: true, ...redaction }),\n   482\t    async cleanup() {\n   483\t      const results = await Promise.allSettled([...pendingReleases].map(release => release()));\n   484\t      const failures = results.filter((result): result is PromiseRejectedResult => result.status === \"rejected\");\n   485\t      const failure = failures.find(({ reason }) => reason && typeof reason === \"object\" &&\n   486\t        (reason as { phase?: unknown }).phase === \"token-revocation\") ?? failures[0];\n   487\t      if (failure) throw failure.reason;\n   488\t    },\n   489\t    async open(targetContext): Promise<McpFnTransportHandle> {\n   490\t      const context: McpFnRemoteCredentialContext = {\n   491\t        url: targetUrl.toString(),\n   492\t        requestId: targetContext.requestId,\n   493\t        signal: targetContext.signal,\n   494\t      };\n   495\t      const lease = await acquireRemoteCredential(options.credential, context);\n   496\t      const secrets = new Set<string>();\n   497\t      const release = async () => {\n   498\t        try { await lease.release(); }\n   499\t        catch (error) { pendingReleases.add(release); throw error; }\n   500\t        pendingReleases.delete(release);\n   501\t        for (const secret of secrets) {\n   502\t          const count = (state.active.get(secret) ?? 1) - 1;\n   503\t          if (count) state.active.set(secret, count); else state.active.delete(secret);\n   504\t        }\n   505\t        secrets.clear();\n   506\t      };\n   507\t      let handle: McpFnTransportHandle | undefined;\n   508\t      try {\n   509\t        for (const secret of credentialValues(lease.credential.headers)) {\n   510\t          secrets.add(secret);\n   511\t          state.active.set(secret, (state.active.get(secret) ?? 0) + 1);\n   512\t          for (const scope of state.scopes) scope.add(secret);\n   513\t        }\n   514\t        const credentialHeaders = validateRemoteCredentialHeaders(lease.credential.headers);\n   515\t        const headers = new Headers(requestInit?.headers);\n   516\t        credentialHeaders.forEach((value, name) => headers.set(name, value));\n   517\t        const target = streamableHttpTarget(targetUrl, {\n   518\t          ...transportOptions,\n   519\t          requestInit: {\n   520\t            ...requestInit,\n   521\t            headers,\n   522\t            // Fetch must not replay credentials to a redirect destination.\n   523\t            redirect: \"error\",\n   524\t          },\n   525\t        });\n   526\t        handle = await target.open(targetContext);\n   527\t      } catch (error) {\n   528\t        // Sanitize while the lease still supplies its immutable header snapshot.\n   529\t        // Cleanup removes active secrets before the client emits failed-open diagnostics.\n   530\t        let message = \"Authenticated target could not be opened\";\n   531\t        try { message = redactRemoteCredential(lease.credential, error instanceof Error ? error.message : String(error)); }\n   532\t        catch { /* Invalid or oversized credentials must not escape through diagnostics. */ }\n   533\t        pendingReleases.add(release);\n   534\t        await release();\n   535\t        throw new Error(message);\n   536\t      }\n   537\t\n   538\t      let closePromise: Promise<void> | undefined;\n   539\t      let transportClosed = false;\n   540\t      return {\n   541\t        transport: handle.transport,\n   542\t        finishAuthorization: handle.finishAuthorization,\n   543\t        terminateSession: handle.terminateSession,\n   544\t        close() {\n   545\t          closePromise ??= Promise.resolve().then(async () => {\n   546\t            // The client coordinator retains this handle until both stages finish.\n   547\t            // Never release authentication while transport shutdown still needs retry.\n   548\t            if (!transportClosed) {\n   549\t              if (handle!.close) await handle!.close();\n   550\t              else await handle!.transport.close();\n   551\t              transportClosed = true;\n   552\t            }\n   553\t            await release();\n   554\t          }).catch(async (error) => {\n   555\t            closePromise = undefined;\n   556\t            const phase = transportClosed ? lease.cleanupPhase() : \"transport-close\";\n   557\t            await targetContext.diagnostic({\n   558\t              phase, outcome: \"failed\", code: \"MCPFN_CREDENTIAL_CLEANUP_FAILED\",\n   559\t              requestId: targetContext.requestId, at: new Date().toISOString(),\n   560\t              target: { kind: \"authenticated-streamable-http\", url: descriptorUrl.toString() },\n   561\t              details: { message: \"Target credential cleanup failed\" },\n   562\t            });\n   563\t            throw error;\n   564\t          });\n   565\t          return closePromise;\n   566\t        },\n   567\t      };\n   568\t    },\n   569\t  });\n   570\t  targetSecrets.set(authenticated, state);\n   571\t  return authenticated;\n   572\t}\n   573\t\n   574\tfunction normalizeRemoteTargetUrl(value: string | URL): URL {\n   575\t  const url = new URL(value.toString());\n   576\t  if (url.protocol !== \"http:\" && url.protocol !== \"https:\") {\n   577\t    throw new TypeError(\"Authenticated MCP targets must use HTTP or HTTPS\");\n   578\t  }\n   579\t  if (url.protocol === \"http:\" && url.hostname !== \"[::1]\" &&\n   580\t      !/^127(?:\\.\\d{1,3}){3}$/.test(url.hostname)) {\n   581\t    throw new TypeError(\"Credential-bearing HTTP targets require a literal loopback address; use HTTPS remotely\");\n   582\t  }\n   583\t  if (url.username || url.password || url.hash) {\n   584\t    throw new TypeError(\n   585\t      \"Authenticated MCP target URLs must not contain userinfo or a fragment\",\n   586\t    );\n   587\t  }\n   588\t  return url;\n   589\t}\n   590\t\n   591\tfunction isCredentialProvider(\n   592\t  value: McpFnRemoteCredential | McpFnRemoteCredentialProvider,\n   593\t): value is McpFnRemoteCredentialProvider {\n   594\t  return \"acquire\" in value && typeof value.acquire === \"function\";\n   595\t}\n   596\t\n   597\tfunction boundedCredentialEntries(value: HeadersInit): Array<[string, string]> {\n   598\t  const entries: Array<[string, string]> = [];\n   599\t  let bytes = 0;\n   600\t  const append = (name: string, headerValue: string) => {\n   601\t    if (entries.length >= MAX_CREDENTIAL_HEADERS) throw new TypeError(\"Credential headers exceed the header limit\");\n   602\t    if (typeof name !== \"string\" || typeof headerValue !== \"string\") throw new TypeError(\"Credential header values must be strings\");\n   603\t    if (name.length > MAX_CREDENTIAL_HEADER_BYTES || headerValue.length > MAX_CREDENTIAL_HEADER_VALUE_BYTES) throw new TypeError(\"Credential header exceeds the value-size limit\");\n   604\t    if (new TextEncoder().encode(headerValue).byteLength > MAX_CREDENTIAL_HEADER_VALUE_BYTES) throw new TypeError(\"Credential header exceeds the value-size limit\");\n   605\t    bytes += new TextEncoder().encode(`${name}: ${headerValue}\\r\\n`).byteLength;\n   606\t    if (bytes > MAX_CREDENTIAL_HEADER_BYTES) throw new TypeError(\"Credential headers exceed the aggregate size limit\");\n   607\t    entries.push([name, headerValue]);\n   608\t  };\n   609\t  if (value instanceof Headers) value.forEach((v, k) => append(k, v));\n   610\t  else if (Array.isArray(value)) {\n   611\t    if (value.length > MAX_CREDENTIAL_HEADERS) throw new TypeError(\"Credential headers exceed the header limit\");\n   612\t    for (const entry of value) append(entry[0], entry[1]);\n   613\t  } else {\n   614\t    for (const name in value) if (Object.hasOwn(value, name)) append(name, value[name]);\n   615\t  }\n   616\t  return entries;\n   617\t}\n   618\t\n   619\texport function validateRemoteCredentialHeaders(value: HeadersInit): Headers {\n   620\t  const headers = new Headers(boundedCredentialEntries(value));\n   621\t  const entries: Array<[string, string]> = [];\n   622\t  headers.forEach((headerValue, name) => entries.push([name, headerValue]));\n   623\t  if (entries.length === 0) {\n   624\t    throw new TypeError(\"Authenticated MCP targets require at least one credential header\");\n   625\t  }\n   626\t  if (entries.length > MAX_CREDENTIAL_HEADERS) {\n   627\t    throw new TypeError(`Credential headers exceed the ${MAX_CREDENTIAL_HEADERS}-header limit`);\n   628\t  }\n   629\t  let bytes = 0;\n   630\t  for (const [name, headerValue] of entries) {\n   631\t    if (!headerValue.trim()) throw new TypeError(\"Credential header values must not be blank\");\n   632\t    if (FORBIDDEN_CREDENTIAL_HEADERS.has(name)) {\n   633\t      throw new TypeError(`Credential header ${name} is not allowed`);\n   634\t    }\n   635\t    const valueBytes = new TextEncoder().encode(headerValue).byteLength;\n   636\t    if (valueBytes > MAX_CREDENTIAL_HEADER_VALUE_BYTES) {\n   637\t      throw new TypeError(`Credential header ${name} exceeds the value-size limit`);\n   638\t    }\n   639\t    if (new TextEncoder().encode(headerValue).byteLength > MAX_CREDENTIAL_HEADER_VALUE_BYTES) throw new TypeError(\"Credential header exceeds the value-size limit\");\n   640\t    bytes += new TextEncoder().encode(`${name}: ${headerValue}\\r\\n`).byteLength;\n   641\t  }\n   642\t  if (bytes > MAX_CREDENTIAL_HEADER_BYTES) {\n   643\t    throw new TypeError(\"Credential headers exceed the aggregate size limit\");\n   644\t  }\n   645\t  return headers;\n   646\t}\n    25\t  details?: Record<string, unknown>;\n    26\t}\n    27\t\n    28\texport interface McpFnJunitOptions {\n    29\t  /** Aggregate XML size cap after serialization. Defaults to 1 MiB. */\n    30\t  maxBytes?: number;\n    31\t}\n    32\t\n    33\texport function normalizeMcpFnReportFailure(\n    34\t  error: unknown,\n    35\t  fallbackPhase?: McpFnDiagnosticPhase | \"scenario\" | \"upstream-conformance\",\n    36\t): McpFnReportFailure {\n    37\t  const redacted = redactOAuthValue(error, {\n    38\t    maxDepth: 6,\n    39\t    maxArrayEntries: 50,\n    40\t    maxObjectEntries: 50,\n    41\t    maxStringLength: 2_048,\n    42\t  });\n    43\t  const record = redacted && typeof redacted === \"object\" && !Array.isArray(redacted)\n    44\t    ? redacted as Record<string, unknown>\n    45\t    : {};\n    46\t  const phase = stringField(record.phase) ?? fallbackPhase;\n    47\t  const details = record.details && typeof record.details === \"object\" &&\n    48\t      !Array.isArray(record.details)\n    49\t    ? record.details as Record<string, unknown>\n    50\t    : undefined;\n    51\t  let message = stringField(record.message) ?? String(\n    52\t    redactOAuthValue(error instanceof Error ? error.message : String(error)),\n    53\t  );\n    54\t  const cause = error && typeof error === \"object\"\n    55\t    ? (error as { cause?: unknown }).cause\n    56\t    : undefined;\n    57\t  const redactedCause = cause === undefined\n    58\t    ? undefined\n    59\t    : redactOAuthValue(cause, {\n    60\t      maxDepth: 4,\n    61\t      maxArrayEntries: 20,\n    62\t      maxObjectEntries: 20,\n    63\t      maxStringLength: 1_024,\n    64\t    });\n    65\t  const causeRecord = redactedCause && typeof redactedCause === \"object\" &&\n    66\t      !Array.isArray(redactedCause)\n    67\t    ? redactedCause as Record<string, unknown>\n    68\t    : undefined;\n    69\t  const causeMessage = stringField(causeRecord?.message);\n    70\t  if (causeMessage && !message.includes(causeMessage)) message = `${message}: ${causeMessage}`;\n    71\t  const combinedDetails = causeRecord ? { ...details, cause: causeRecord } : details;\n    72\t  const layer = failureLayer(phase);\n    73\t  const deniedByResource = layer !== \"authorization-server\" &&\n    74\t    [causeRecord?.code, causeRecord?.status, record.code, record.status]\n    75\t      .some(value => [401, 403].includes(Number(value)));\n    76\t  return {\n    77\t    name: stringField(record.name) ?? \"Error\",\n    78\t    message,\n    79\t    layer: deniedByResource ? \"resource-server\" : layer,\n    80\t    ...(stringField(record.code) ? { code: stringField(record.code)! } : {}),\n    81\t    ...(phase ? { phase } : {}),\n    82\t    ...(combinedDetails ? { details: combinedDetails } : {}),\n    83\t  };\n    84\t}\n    85\t\n    86\t/** Serialize a redacted target-suite report as bounded JUnit XML. */\n    87\texport function createMcpFnTargetSuiteJUnit(\n    88\t  report: McpFnTargetSuiteReport,\n    89\t  options: McpFnJunitOptions = {},\n    90\t): string {\n    91\t  const maxBytes = options.maxBytes ?? 1_048_576;\n    92\t  validateArtifactCap(maxBytes);\n    93\t  const safe = redactOAuthValue(report, {\n    94\t    maxDepth: 10,\n    95\t    maxArrayEntries: 1_000,\n    96\t    maxObjectEntries: 200,\n    97\t    maxStringLength: 4_096,\n    98\t  }) as unknown as McpFnTargetSuiteReport;\n    99\t  // Redaction appends a string sentinel when an array exceeds its cap.\n   100\t  const results = safe.results.filter((result) => result && typeof result === \"object\" && typeof result.name === \"string\");\n   101\t  const omitted = report.results.length - results.length;\n   102\t  const cases = results.map((result) => {\n   103\t    const duration = Math.max(0, result.durationMs ?? 0) / 1_000;\n   104\t    let failure = \"\";\n   105\t    if (result.status !== \"passed\") {\n   106\t      const failureType = result.status === \"failed\" ? \"scenario\" : \"incomplete\";\n   107\t      failure = junitFailure(result.error ?? `Scenario ${result.status}`, failureType);\n   108\t    }\n   109\t    return `    <testcase name=\"${xml(result.name)}\" classname=\"mcpfn.scenario\" time=\"${duration.toFixed(3)}\">${failure}</testcase>`;\n   110\t  });\n   111\t  if (safe.failure) {\n   112\t    cases.unshift(\n   113\t      `    <testcase name=\"${xml(safe.failure.phase ?? \"target\")}\" classname=\"mcpfn.${xml(safe.failure.layer)}\" time=\"0.000\">${junitFailure(safe.failure.message, safe.failure.code ?? safe.failure.layer)}</testcase>`,\n   114\t    );\n   115\t  }\n   116\t  if (safe.status === \"incomplete\" || omitted > 0 || (!safe.ok && !safe.failure && results.every((result) => result.status === \"passed\"))) {\n   117\t    cases.push(`    <testcase name=\"suite-incomplete\" classname=\"mcpfn.report\" time=\"0.000\">${junitFailure(safe.incompleteReason ?? \"Suite evidence is incomplete or omitted\", \"incomplete\")}</testcase>`);\n   118\t  }\n   119\t  if (cases.length === 0) {\n   120\t    cases.push(\n   121\t      '    <testcase name=\"target-suite\" classname=\"mcpfn.target\" time=\"0.000\"></testcase>',\n   122\t    );\n   123\t  }\n   124\t  const failures = cases.filter((entry) => entry.includes(\"<failure \")).length;\n   125\t  let serialized = junitDocument(safe, cases, failures);\n    70\t  redactionOmittedObservedEvents?: number;\n    71\t  incompleteReason?: string;\n    72\t  failure?: McpFnReportFailure;\n    73\t  timeline: McpFnDiagnosticEvent[];\n    74\t  droppedTimelineEvents: number;\n    75\t  results: McpFnScenarioResult[];\n    76\t}\n    77\t\n    78\tconst suiteCleanupOwners = new WeakMap<Error, { close: () => Promise<void>; pending?: Promise<void> }>();\n    79\t\n    80\tfunction retryTargetSuiteCleanup(error: Error): Promise<void> {\n    81\t  const owner = suiteCleanupOwners.get(error);\n    82\t  if (!owner) return Promise.resolve();\n    83\t  if (owner.pending) return owner.pending;\n    84\t  const pending = Promise.resolve().then(owner.close).then(\n    85\t    () => { suiteCleanupOwners.delete(error); },\n    86\t    () => Promise.reject(error),\n    87\t  ).finally(() => { owner.pending = undefined; });\n    88\t  owner.pending = pending;\n    89\t  return pending;\n    90\t}\n    91\t\n    92\t/** Final cleanup failed. The bounded report is a snapshot; retain this error to retry. */\n    93\texport class McpFnTargetSuiteCleanupError extends Error {\n    94\t  constructor(readonly report: McpFnTargetSuiteReport, close: () => Promise<void>) {\n    95\t    super(\"Target suite cleanup failed; retain this error and retryCleanup()\");\n    96\t    this.name = \"McpFnTargetSuiteCleanupError\";\n    97\t    suiteCleanupOwners.set(this, { close });\n    98\t  }\n    99\t\n   100\t  retryCleanup(): Promise<void> {\n   101\t    return retryTargetSuiteCleanup(this);\n   102\t  }\n   103\t}\n   104\t\n   105\t/** Report serialization failed after cleanup ownership had already transferred. */\n   106\texport class McpFnTargetSuiteArtifactCleanupError extends Error {\n   107\t  constructor(close: () => Promise<void>, cause: Error) {\n   108\t    super(`${cause.message}; retain this error and retryCleanup()`, { cause });\n   109\t    this.name = \"McpFnTargetSuiteArtifactCleanupError\";\n   110\t    suiteCleanupOwners.set(this, { close });\n   111\t  }\n   112\t\n   113\t  retryCleanup(): Promise<void> {\n   114\t    return retryTargetSuiteCleanup(this);\n   115\t  }\n   116\t}\n   117\t\n   118\t/** Runs local, stdio, HTTP, or custom targets through the production session engine. */\n   119\texport async function runMcpFnTargetSuite(\n   120\t  options: RunMcpFnTargetSuiteOptions,\n   121\t): Promise<McpFnTargetSuiteReport> {\n   122\t  const finishRedaction = beginTargetCredentialRedaction(options.target);\n   123\t  try { return await runTargetSuite(options); }\n   124\t  finally { finishRedaction(); }\n   125\t}\n   126\t\n   127\t/** Apply the target-owned scrubber before the bounded generic artifact pass. */\n   128\tfunction redactSuiteArtifact<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean } = {}): T {\n   129\t  const scrubbed = target.redact ? target.redact(value, options) : value;\n   130\t  return redactTargetCredentials(target, scrubbed, options);\n   131\t}\n   132\t\n   133\tfunction compareInventoryNames(left: string, right: string): number {\n   134\t  if (left === right) return 0;\n   135\t  return left < right ? -1 : 1;\n   136\t}\n   137\t\n   138\tfunction reportProjectionFailureReason(\n   139\t  error: unknown,\n   140\t  projectionFailure: \"redaction\" | \"serialization\" | undefined,\n   141\t): string {\n   142\t  if (error instanceof McpFnRedactionLimitError) {\n   143\t    return \"Credential redaction exceeded its traversal budget\";\n   144\t  }\n   145\t  if (projectionFailure === \"redaction\") {\n   146\t    return \"Credential redaction failed; report content omitted because safe serialization failed\";\n   147\t  }\n   148\t  return \"Report content omitted because safe serialization failed\";\n   149\t}\n   150\t\n   151\tclass SuiteDiagnosticCollector {\n   152\t  readonly timeline: McpFnDiagnosticEvent[] = [];\n   153\t  private readonly timelineSizes: number[] = [];\n   154\t  private timelineBytes = 0;\n   155\t  private observedRedactionOmissions = 0;\n   156\t  private initialRedactionOmissions = 0;\n   157\t  dropped = 0;\n   158\t  countExceeded = false;\n   159\t  bytesExceeded = false;\n   160\t  serializationFailed = false;\n   161\t  redactionFailed = false;\n   162\t  cleanupFailure: McpFnReportFailure | undefined;\n   163\t\n   164\t  constructor(\n   165\t    private readonly maxEvents: number,\n   166\t    private readonly maxBytes: number,\n   167\t    private readonly target: McpFnTarget,\n   168\t    private readonly consumer?: (event: McpFnDiagnosticEvent) => void | Promise<void>,\n   169\t  ) {}\n   170\t\n   171\t  captureBaseline(client: McpFnTestClient): void {\n   172\t    this.initialRedactionOmissions = client.session\n   173\t      .getRedactionOmissionCounts().diagnostics;\n   174\t  }\n   175\t\n   176\t  captureUnobserved(client: McpFnTestClient | undefined): void {\n   177\t    const total = client?.session.getRedactionOmissionCounts().diagnostics ??\n   178\t      this.initialRedactionOmissions;\n   179\t    const unobserved = Math.max(\n   180\t      0,\n   181\t      total - this.initialRedactionOmissions - this.observedRedactionOmissions,\n   182\t    );\n   183\t    if (unobserved > 0) {\n   184\t      this.redactionFailed = true;\n   185\t      this.dropped += unobserved;\n   186\t    }\n   187\t  }\n   188\t\n   189\t  async record(client: McpFnTestClient | undefined, event: McpFnDiagnosticEvent): Promise<void> {\n   190\t    if (client?.session.isRedactionOmission(event)) {\n   191\t      this.observedRedactionOmissions += 1;\n   192\t      this.redactionFailed = true;\n   193\t      this.dropped += 1;\n   194\t    }\n   195\t    if ([\"token-revocation\", \"transport-close\"].includes(event.phase) &&\n   196\t        event.outcome === \"failed\") {\n   197\t      this.cleanupFailure ??= normalizeMcpFnReportFailure({\n   198\t        name: \"CleanupError\", message: \"Target cleanup failed\",\n   199\t        code: event.code, phase: event.phase,\n   200\t      });\n   201\t    }\n   202\t    const safeEvent = redactTargetCredentials(this.target, event, { preserveKeys: true });\n   203\t    const bytes = this.serializedBytes(safeEvent);\n   204\t    if (bytes === undefined) {\n   205\t      await this.consumer?.(safeEvent);\n   206\t      return;\n   207\t    }\n   208\t    if (bytes > this.maxBytes) {\n   209\t      this.bytesExceeded = true;\n   210\t      this.dropped += 1;\n   211\t    } else {\n   212\t      this.timeline.push(safeEvent);\n   213\t      this.timelineSizes.push(bytes);\n   214\t      this.timelineBytes += bytes;\n   215\t      this.enforceBounds();\n   216\t    }\n   217\t    await this.consumer?.(safeEvent);\n   218\t  }\n   219\t\n   220\t  private serializedBytes(event: McpFnDiagnosticEvent): number | undefined {\n   221\t    try {\n   222\t      const json = JSON.stringify(event, (_key, value: unknown) => {\n   223\t        if (value === undefined || (typeof value === \"number\" && !Number.isFinite(value))) {\n   224\t          throw new Error(\"Diagnostic contains a non-JSON value\");\n   225\t        }\n   226\t        return value;\n   227\t      });\n   228\t      structuredClone(event);\n   229\t      return Buffer.byteLength(json);\n   230\t    } catch {\n   231\t      this.serializationFailed = true;\n   232\t      this.dropped += 1;\n   233\t      return undefined;\n   234\t    }\n   235\t  }\n   236\t\n   237\t  private enforceBounds(): void {\n   238\t    while (this.timeline.length > this.maxEvents || this.timelineBytes > this.maxBytes) {\n   239\t      this.countExceeded ||= this.timeline.length > this.maxEvents;\n   240\t      this.bytesExceeded ||= this.timelineBytes > this.maxBytes;\n   241\t      this.timeline.shift();\n   242\t      this.timelineBytes -= this.timelineSizes.shift()!;\n   243\t      this.dropped += 1;\n   244\t    }\n   245\t  }\n   246\t}\n   247\t\n   248\tasync function runTargetSuite(options: RunMcpFnTargetSuiteOptions): Promise<McpFnTargetSuiteReport> {\n   249\t  const maxTimelineEvents = options.maxTimelineEvents ?? 500;\n   250\t  if (!Number.isInteger(maxTimelineEvents) || maxTimelineEvents < 1) {\n   300\t      const expected = [...options.expectedToolNames].sort(compareInventoryNames);\n   301\t      if (stableJson(actual) !== stableJson(expected)) {\n   302\t        throw new McpFnAssertionError(`Tool inventory mismatch: expected ${stableJson(expected)}, actual ${stableJson(actual)}`);\n   303\t      }\n   304\t    }\n   305\t    execution = {\n   306\t      results: await runScenarios(\n   307\t        client,\n   308\t        options.scenarios ?? [],\n   309\t        options.scenarioRun,\n   310\t      ),\n   311\t      server: client.session.getServerVersion(),\n   312\t      capabilities: client.session.getServerCapabilities(),\n   313\t    };\n   314\t  } catch (error) {\n   315\t    try {\n   316\t      failure = normalizeMcpFnReportFailure(redactSuiteArtifact(options.target, error, { preserveKeys: true }));\n   317\t    } catch {\n   318\t      // Arbitrary error properties/proxies can throw, including secret-bearing errors.\n   319\t      failure = normalizeMcpFnReportFailure({ name: \"RedactionError\", code: \"MCPFN_REDACTION_FAILED\", message: \"Target failure omitted because credential redaction failed\" });\n   320\t    }\n   321\t  } finally {\n   322\t    try {\n   323\t      // Custom hooks may depend on credentials cleared by close. Capture every\n   324\t      // target-controlled report value while the session still owns that state.\n   325\t      if (client?.session.state === \"connected\") {\n   326\t        let kind: string | undefined;\n   327\t        let descriptor: Omit<McpFnTargetDescriptor, \"kind\"> | undefined;\n   328\t        try {\n   329\t          ({ kind, ...descriptor } = options.target.describe());\n   330\t        } catch { projectionFailure = \"serialization\"; }\n   331\t        if (!projectionFailure) {\n   332\t          try {\n   333\t            capturedTarget = {\n   334\t              ...redactSuiteArtifact(options.target, descriptor!, { preserveKeys: false }),\n   335\t              kind: client.session.preserveArtifactStructure(kind!),\n   336\t            };\n   337\t            capturedManifestHash = options.manifest\n   338\t              ? redactSuiteArtifact(options.target, options.manifest.hash, { preserveKeys: false })\n   339\t              : undefined;\n   340\t            execution = {\n   341\t              server: execution.server === undefined\n   342\t                ? undefined\n   343\t                : redactSuiteArtifact(options.target, execution.server, { preserveKeys: false }),\n   344\t              capabilities: execution.capabilities === undefined\n   345\t                ? undefined\n   346\t                : redactSuiteArtifact(options.target, execution.capabilities, { preserveKeys: false }),\n   347\t              results: execution.results.map(result => ({\n   348\t                ...result,\n   349\t                name: redactSuiteArtifact(options.target, result.name, { preserveKeys: false }),\n   350\t                operation: redactSuiteArtifact(options.target, result.operation, { preserveKeys: false }),\n   351\t                ...(result.tool === undefined ? {} : {\n   352\t                  tool: redactSuiteArtifact(options.target, result.tool, { preserveKeys: false }),\n   353\t                }),\n   354\t              })),\n   355\t            };\n   356\t          } catch { projectionFailure = \"redaction\"; }\n   357\t        }\n   358\t      } else if (execution.results.length || execution.server || execution.capabilities) {\n   359\t        projectionFailure = \"serialization\";\n   360\t      }\n   361\t    } catch { projectionFailure = \"serialization\"; }\n   362\t    try {\n   363\t      await client?.close();\n   364\t    } catch (error) {\n   365\t      const owner = client;\n   366\t      if (error instanceof McpFnTestClientCleanupError) {\n   367\t        retainedCleanup = () => error.retryCleanup();\n   368\t      } else if (owner) {\n   369\t        retainedCleanup = () => owner.close();\n   370\t      }\n   371\t      const terminalCleanupError = error instanceof McpFnTestClientCleanupError && error.cause !== undefined\n   372\t        ? error.cause\n   373\t        : error;\n   374\t      const terminalCleanupPhase = terminalCleanupError && typeof terminalCleanupError === \"object\" &&\n   375\t          (terminalCleanupError as { phase?: unknown }).phase === \"token-revocation\"\n   376\t        ? \"token-revocation\"\n   377\t        : \"transport-close\";\n   378\t      cleanupFailure = normalizeMcpFnReportFailure({\n   379\t        name: \"CleanupError\",\n   380\t        message: \"Target cleanup failed\",\n   381\t        code: \"MCPFN_TARGET_CLEANUP_FAILED\",\n   382\t        phase: terminalCleanupPhase,\n   383\t      });\n   384\t    }\n   385\t    diagnostics.captureUnobserved(client);\n   386\t  }\n   387\t  cleanupFailure ??= diagnostics.cleanupFailure;\n   388\t  failure ??= cleanupFailure;\n   389\t  const results = execution.results;\n   390\t  const failed = results.filter((result) => result.status === \"failed\").length;\n   391\t  const incomplete = results.filter((result) => result.status === \"incomplete\").length;\n   392\t  const droppedObservedEvents = results.reduce(\n   393\t    (total, result) => total + (result.droppedObservedEvents ?? 0),\n   394\t    0,\n   395\t  );\n   396\t  const redactionOmittedObservedEvents = results.reduce(\n   397\t    (total, result) => total + (result.redactionOmittedObservedEvents ?? 0),\n   398\t    0,\n   399\t  );\n   400\t  const overflowedObservedEvents = droppedObservedEvents - redactionOmittedObservedEvents;\n   401\t  const artifactIncomplete = Boolean(failure) || incomplete > 0 ||\n   402\t    diagnostics.dropped > 0 ||\n   403\t    droppedObservedEvents > 0;\n   404\t  const report: McpFnTargetSuiteReport = {\n   405\t    formatVersion: 1,\n   406\t    kind: \"mcpfn.target-suite-report\",\n   407\t    status: artifactIncomplete ? \"incomplete\" : \"complete\",\n   408\t    runtime: {\n   409\t      node: process.version,\n   410\t      scenarioFormatVersion: 1,\n   411\t      reportSchemaVersion: MCPFN_REPORT_SCHEMA_VERSION,\n   412\t      packages: { testing: MCPFN_TESTING_VERSION },\n   413\t    },\n   414\t    ok: failed === 0 && !artifactIncomplete,\n   415\t    target: capturedTarget,\n   416\t    server: execution.server,\n   417\t    capabilities: execution.capabilities,\n   418\t    manifestChecked,\n   419\t    ...(capturedManifestHash === undefined ? {} : { manifestHash: capturedManifestHash }),\n   420\t    total: results.length,\n   421\t    passed: results.length - failed - incomplete,\n   422\t    failed,\n   423\t    incomplete,\n   424\t    droppedResults: 0,\n   425\t    droppedObservedEvents,\n   426\t    ...(redactionOmittedObservedEvents > 0 ? { redactionOmittedObservedEvents } : {}),\n   427\t    ...(failure || diagnostics.dropped > 0 || droppedObservedEvents > 0\n   428\t      ? {\n   429\t        incompleteReason: [\n   430\t          ...(failure ? [`${failure.layer}: ${failure.message}`] : []),\n   431\t          ...(cleanupFailure ? [`Cleanup: ${cleanupFailure.message}`] : []),\n   432\t          ...(diagnostics.serializationFailed ? [\"Diagnostic timeline contained non-JSON data\"] : []),\n   433\t          ...(diagnostics.redactionFailed ? [\"Diagnostic timeline redaction failed; original events omitted\"] : []),\n   434\t          ...(diagnostics.countExceeded ? [\"Diagnostic timeline exceeded maxTimelineEvents\"] : []),\n   435\t          ...(diagnostics.bytesExceeded ? [\"Diagnostic timeline exceeded maxReportBytes\"] : []),\n   436\t          ...(redactionOmittedObservedEvents > 0\n   437\t            ? [\"Observed client events were omitted because credential redaction failed\"]\n   438\t            : []),\n   439\t          ...(overflowedObservedEvents > 0\n   440\t            ? [\"Observed client events exceeded maxObservedEvents\"]\n   441\t            : []),\n   442\t        ].join(\"; \"),\n   443\t      }\n   444\t      : {}),\n   445\t    ...(failure ? { failure } : {}),\n   446\t    timeline: diagnostics.timeline,\n   447\t    droppedTimelineEvents: diagnostics.dropped,\n   448\t    results,\n   449\t  };\n   450\t  let finalized: McpFnTargetSuiteReport;\n   451\t  try {\n   452\t    if (projectionFailure) throw new Error(\"Report payload projection failed\");\n   453\t    // Custom redaction already completed before cleanup. Built-in report scopes\n   454\t    // remain active here for bounded final serialization.\n   455\t    finalized = enforceReportCap(redactTargetCredentials(options.target, report, { preserveKeys: true }), maxReportBytes);\n   456\t  } catch (error) {\n   457\t    if (error instanceof McpFnStructuralCredentialCollisionError) {\n   458\t      const failure = new McpFnClientError(\n   459\t        \"MCPFN_OPERATION_FAILED\",\n   460\t        \"Target report cannot be serialized because a credential conflicts with required artifact structure\",\n   461\t        { phase: \"capability-operation\" },\n   462\t      );\n   463\t      if (retainedCleanup) {\n   464\t        throw new McpFnTargetSuiteArtifactCleanupError(retainedCleanup, failure);\n   465\t      }\n   466\t      throw failure;\n   467\t    }\n   468\t    finalized = enforceReportCap({ ...report, ok: false, status: \"incomplete\",\n   469\t      incompleteReason: reportProjectionFailureReason(error, projectionFailure),\n   470\t      target: { kind: \"custom\" }, server: undefined, capabilities: undefined, manifestHash: undefined,\n   471\t      failure: undefined, results: [], timeline: [],\n   472\t      droppedResults: report.results.length, droppedTimelineEvents: report.droppedTimelineEvents + report.timeline.length,\n   473\t    }, maxReportBytes);\n   474\t  }\n   475\t  if (retainedCleanup) throw new McpFnTargetSuiteCleanupError(finalized, retainedCleanup);\n   476\t  return finalized;\n   477\t}\n   478\t\n   479\tfunction enforceReportCap(\n   480\t  report: McpFnTargetSuiteReport,\n   481\t  maxBytes: number,\n   482\t): McpFnTargetSuiteReport {\n   483\t  validateReportCap(maxBytes);\n   484\t  const bounded = structuredClone(report);\n   485\t  if (jsonBytes(bounded) > maxBytes) {\n   486\t    bounded.ok = false;\n   487\t    bounded.status = \"incomplete\";\n   488\t    bounded.incompleteReason = \"Report content exceeded maxReportBytes and was truncated\";\n   489\t  }\n   490\t  while (jsonBytes(bounded) > maxBytes && bounded.results.length > 0) {\n   491\t    bounded.results.pop();\n   492\t    bounded.droppedResults += 1;\n   493\t  }\n   494\t  if (jsonBytes(bounded) > maxBytes) {\n   495\t    bounded.target = { kind: report.target.kind };\n   496\t    bounded.server = undefined;\n   497\t    bounded.capabilities = undefined;\n   498\t    bounded.timeline = [];\n   499\t    bounded.droppedTimelineEvents += report.timeline.length;\n   500\t    if (bounded.failure) {\n   501\t      bounded.failure.details = undefined;\n   502\t      bounded.failure.message = \"Target operation failed; details omitted to fit report budget\";\n   503\t    }\n   504\t  }\n   505\t  if (bounded.droppedResults > 0 || jsonBytes(bounded) > maxBytes) {\n   506\t    bounded.ok = false;\n   507\t    bounded.status = \"incomplete\";\n   508\t    bounded.incompleteReason = \"Report content exceeded maxReportBytes and was truncated\";\n   509\t  }\n   510\t  if (jsonBytes(bounded) > maxBytes) {\n   511\t    throw new Error(\"The minimum target suite report exceeds maxReportBytes\");\n   512\t  }\n   513\t  return bounded;\n   514\t}\n   515\t\n   516\tfunction validateReportCap(maxBytes: number): void {\n   517\t  if (!Number.isInteger(maxBytes) || maxBytes < 1_024) {\n   518\t    throw new Error(\"maxReportBytes must be an integer of at least 1024\");\n   519\t  }\n   520\t}\n","exit_code":0,"duration":{"secs":0,"nanos":5125},"formatted_output":"Warning: truncated output (original token count: 14121)\nTotal output lines: 1090\n\n     1\timport {\n     2\t  McpFnClientError,\n     3\t  customTarget,\n     4\t  streamableHttpTarget,\n     5\t  type McpFnStreamableHttpTargetOptions,\n     6\t  type McpFnTarget,\n     7\t  type McpFnTransportHandle,\n     8\t} from \"@mcpfn/client\";\n     9\t\n    10\timport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n    11\t\n    12\ttype SecretState = { active: Map<string, number>; scopes: Set<Set<string>> };\n    13\tconst targetSecrets = new WeakMap<McpFnTarget, SecretState>();\n    14\t\n    15\t/** Retain released credentials only for the lifetime of a report operation. */\n    16\texport function beginTargetCredentialRedaction(target: McpFnTarget): () => void {\n    17\t  const state = targetSecrets.get(target);\n    18\t  if (!state) return () => undefined;\n    19\t  const scope = new Set(state.active.keys());\n    20\t  state.scopes.add(scope);\n    21\t  return () => { state.scopes.delete(scope); scope.clear(); };\n    22\t}\n    23\t\n    24\tfunction credentialValues(headers: HeadersInit): Set<string> {\n    25\t  const values = boundedCredentialEntries(headers);\n    26\t  const secrets = new Set<string>();\n    27\t  for (const [header, raw] of values) {\n    28\t    if (typeof raw !== \"string\" || !raw.trim()) continue;\n    29\t    secrets.add(raw);\n    30\t    secrets.add(raw.trim());\n    31\t    const normalizedHeader = header.toLowerCase();\n    32\t    if ([\"authorization\", \"proxy-authorization\"].includes(normalizedHeader)) {\n    33\t      addAuthorizationSecrets(raw, secrets);\n    34\t    }\n    35\t    if (normalizedHeader === \"cookie\") addCookieSecrets(raw, secrets);\n    36\t  }\n    37\t  return secrets;\n    38\t}\n    39\t\n    40\tfunction addAuthorizationSecrets(raw: string, secrets: Set<string>): void {\n    41\t  const trimmed = raw.trim();\n    42\t  const separator = trimmed.search(/\\s/);\n    43\t  if (separator <= 0) return;\n    44\t  const scheme = trimmed.slice(0, separator).toLowerCase();\n    45\t  const token = trimmed.slice(separator).trim();\n    46\t  if (token) secrets.add(token);\n    47\t  if (scheme !== \"basic\" || !/^[\\dA-Za-z+/]+={0,2}$/.test(token)) return;\n    48\t  const decoded = Buffer.from(token, \"base64\");\n    49\t  // Round-trip validation avoids interpreting malformed tokens as credentials.\n    50\t  if (decoded.toString(\"base64\").replace(/=+$/, \"\") !== token.replace(/=+$/, \"\")) return;\n    51\t  for (const encoding of [\"utf8\", \"latin1\"] as const) {\n    52\t    const pair = decoded.toString(encoding);\n    53\t    const colon = pair.indexOf(\":\");\n    54\t    if (colon < 0) continue;\n    55\t    for (const value of [pair, pair.slice(0, colon), pair.slice(colon + 1)]) {\n    56\t      if (value) secrets.add(value);\n    57\t    }\n    58\t  }\n    59\t}\n    60\t\n    61\tfunction addCookieSecrets(raw: string, secrets: Set<string>): void {\n    62\t  // Cookie values are independently reflectable even though the request\n    63\t  // authenticates with the complete header. RFC 6265 cookie values cannot\n    64\t  // contain comma or semicolon, so both delimiters cover combined entries.\n    65\t  for (const part of raw.split(/[;,]/)) {\n    66\t    const pair = part.trim();\n    67\t    if (!pair) continue;\n    68\t    const equals = pair.indexOf(\"=\");\n    69\t    if (equals < 1) {\n    70\t      throw new TypeError(\"Cookie credential headers must contain name=value pairs\");\n    71\t    }\n    72\t    const value = pair.slice(equals + 1).trim();\n    73\t    if (!value) continue;\n    74\t    secrets.add(value);\n    75\t    addUnquotedCookieSecret(value, secrets);\n    76\t  }\n    77\t}\n    78\t\n    79\tfunction addUnquotedCookieSecret(value: string, secrets: Set<string>): void {\n    80\t  if (!value.startsWith('\"') && !value.endsWith('\"')) return;\n    81\t  if (value.length < 2 || !value.startsWith('\"') || !value.endsWith('\"')) {\n    82\t    throw new TypeError(\"Cookie credential values must use balanced quotes\");\n    83\t  }\n    84\t  const unquoted = value.slice(1, -1);\n    85\t  if (unquoted.includes('\"') || unquoted.includes(\"\\\\\")) {\n    86\t    throw new TypeError(\"Cookie credential values must use RFC 6265 syntax\");\n    87\t  }\n    88\t  if (unquoted) secrets.add(unquoted);\n    89\t}\n    90\t\n    91\texport class McpFnRedactionLimitError extends Error {\n    92\t  constructor(message = \"Credential redaction exceeded its traversal budget\") { super(message); }\n    93\t}\n    94\t\n    95\t/** No typed artifact can preserve this authored key without exposing a credential. */\n    96\texport class McpFnStructuralCredentialCollisionError extends McpFnRedactionLimitError {\n    97\t  constructor() {\n    98\t    super(\"Credential collides with a required structural artifact key\");\n    99\t  }\n   100\t}\n   101\t\n   102\t// Only these locally authored envelope paths retain structural keys. Unknown\n   103\t// children (including inspector events and server metadata) are always payloads.\n   104\tconst envelopeKeys: Record<string, Set<string>> = Object.fromEntries(Object.entries({\n   105\t  root: \"formatVersion kind status runtime ok target server capabilities manifestChecked manifestHash total passed failed incomplete droppedResults droppedObservedEvents redactionOmittedObservedEvents incompleteReason failure timeline droppedTimelineEvents results count clientState tools resources resourceTemplates prompts droppedEvents timelineComplete droppedInventoryEntries inventoryComplete suiteVersion exitCode stdout stderr phase outcome code requestId at details payload\",\n   106\t  result: \"formatVersion name operation tool status sideEffect durationMs error droppedObservedEvents redactionOmittedObservedEvents\",\n   107\t  diagnostic: \"phase outcome code requestId at target details\",\n   108\t  inspectorEvent: \"formatVersion source kind at event\",\n   109\t  failure: \"name message layer code phase details\",\n   110\t  runtime: \"node scenarioFormatVersion reportSchemaVersion packages\",\n   111\t  packages: \"testing\",\n   112\t  droppedInventoryEntries: \"tools resources resourceTemplates prompts\",\n   113\t  target: \"kind\",\n   114\t}).map(([role, keys]) => [role, new Set(keys.split(\" \"))]));\n   115\t\n   116\tconst structuralArtifactValues = new Map<string, Set<string>>([\n   117\t  [\"root:kind\", new Set([\"logging.message\", \"progress\", \"tasks.status\", \"resources.updated\", \"tools.list_changed\", \"resources.list_changed\", \"prompts.list_changed\", \"resources.subscribed\", \"resources.unsubscribed\", \"client.roots\", \"client.sampling\", \"client.elicitation\", \"mcpfn.target-suite-report\", \"mcpfn.inspector-snapshot\", \"mcpfn.official-conformance-report\"])],\n   118\t  [\"inspectorEvent:kind\", new Set([\"logging.message\", \"progress\", \"tasks.status\", \"resources.updated\", \"tools.list_changed\", \"resources.list_changed\", \"prompts.list_changed\", \"resources.subscribed\", \"resources.unsubscribed\", \"client.roots\", \"client.sampling\", \"client.elicitation\"])],\n   119\t  [\"root:clientState\", new Set([\"idle\", \"connecting\", \"authorization-required\", \"connected\", \"closing\", \"closed\"])],\n   120\t  [\"target:kind\", new Set([\"authenticated-streamable-http\", \"streamable-http\", \"stdio\", \"in-memory\", \"custom\"])],\n   121\t  [\"root:status\", new Set([\"passed\", \"failed\", \"incomplete\", \"complete\"])],\n   122\t  [\"result:status\", new Set([\"passed\", \"failed\", \"incomplete\", \"complete\"])],\n   123\t  [\"root:outcome\", new Set([\"started\", \"succeeded\", \"failed\"])],\n   124\t  [\"diagnostic:outcome\", new Set([\"started\", \"succeeded\", \"failed\"])],\n   125\t  ...[\"root\", \"diagnostic\", \"failure\"].map(role => [\n   126\t    `${role}:phase`,\n   127\t    new Set([\"resource-discovery\", \"authorization-server-discovery\", \"client-registration\", \"authorization-request\", \"authorization-callback\", \"token-exchange\", \"token-refresh\", \"token-revocation\", \"transport-connect\", \"mcp-initialize\", \"capability-operation\", \"transport-close\"]),\n   128\t  ] as [string, Set<string>]),\n   129\t  [\"failure:layer\", new Set([\"mcpfn-preflight\", \"authorization-server\", \"resource-server\", \"mcp-initialization\", \"scenario\", \"upstream-conformance\"])],\n   130\t  [\"inspectorEvent:source\", new Set([\"diagnostic\", \"client\"])],\n   131\t  [\"result:sideEffect\", new Set([\"none\", \"idempotent\", \"non-idempotent\"])],\n   132\t]);\n   133\t\n   134\tconst unrestrictedStructuralValueFields = new Set([\n   135\t  \"packages:testing\",\n   136\t  \"runtime:node\",\n   137\t  \"runtime:reportSchemaVersion\",\n   138\t  \"root:suiteVersion\",\n   139\t]);\n   140\t\n   141\tfunction specialValue(input: unknown): unknown {\n   142\t  if (input instanceof Error) return normalizeErrorValue(input);\n   143\t  if (input instanceof Date) return Number.isNaN(input.getTime()) ? \"Invalid Date\" : input.toISOString();\n   144\t  if (input instanceof URL) return input.href;\n   145\t  if (input instanceof Map) {\n   146\t    if (Object.getOwnPropertyDescriptor(Map.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   147\t    return { type: \"Map\", entries: [...Map.prototype.entries.call(input)] };\n   148\t  }\n   149\t  if (input instanceof Set) {\n   150\t    if (Object.getOwnPropertyDescriptor(Set.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   151\t    return { type: \"Set\", values: [...Set.prototype.values.call(input)] };\n   152\t  }\n   153\t  return input;\n   154\t}\n   155\t\n   156\tfunction normalizeErrorValue(input: Error): Record<string, unknown> {\n   157\t  // Error instances may expose attacker-controlled enumerable keys. A\n   158\t  // null-prototype accumulator keeps `__proto__` as ordinary payload data.\n   159\t  const normalized = Object.create(null) as Record<string, unknown>;\n   160\t  let enumerableFields = 0;\n   161\t  for (const key in input) {\n   162\t    if (!Object.hasOwn(input, key)) continue;\n   163\t    if (++enumerableFields > 100_000) throw new McpFnRedactionLimitError();\n   164\t    normalized[key] = (input as unknown as Record<string, unknown>)[key];\n   165\t  }\n   166\t  normalized.name = input.name;\n   167\t  normalized.message = input.message;\n   168\t  normalized.stack = input.stack;\n   169\t  if (input.cause !== undefined) normalized.cause = input.cause;\n   170\t  return normalized;\n   171\t}\n   172\t\n   173\tfunction scrubCredentials<T>(value: T, values: Iterable<string>, preserveKeys = false, redactionMarker?: string): T {\n   174\t  // Preserve whether a pattern came from opaque text or a serializer. Literal\n   175\t  // percent sequences in credentials must not acquire URL hex-case semantics.\n   176\t  const variants = [...values].filter(Boolean).flatMap(secret => [\n   177\t    { value: secret, encoded: false },\n   178\t    { value: JSON.stringify(secret).slice(1, -1), encoded: false },\n   179\t    { value: encodeURIComponent(secret), encoded: true },\n   180\t    { value: new URLSearchParams({ value: secret }).toString().slice(\"value=\".length), encoded: true },\n   181\t  ]).sort((a, b) => b.value.length - a.value.length);\n   182\t  let entries = 0, stringBytes = 0;\n   183\t  const budget = (input: unknown, depth = 0): void => {\n   184\t    input = specialValue(input);\n   185\t    if ((Array.isArray(input) && input.length > 100_000) || ++entries > 100_000 || depth > 32) throw new McpFnRedactionLimitError();\n   186\t    if (typeof input === \"string\") {\n   187\t      stringBytes += Buffer.byteLength(input);\n   188\t      if (input.length > 262_144 || stringBytes > 2_097_152) throw new McpFnRedactionLimitError();\n   189\t    } else if (input && typeof input === \"object\") {\n   190\t      for (const key in input) if (Object.hasOwn(input, key)) {\n   191\t        budget(key, depth + 1);\n   192\t        budget((input as Record<string, unknown>)[key], depth + 1);\n   193\t      }\n   194\t    }\n   195\t  };\n   196\t  // Check before either redactor allocates copies. Exceeding a budget is an\n   197\t  // explicit failure, never silent truncation of a typed report collection.\n   198\t  budget(value);\n   199\t  const patterns = variants.map(({ value, encoded }) => {\n   200\t    const literal = value.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n   201\t    // Only generated percent escapes accept mixed-case hex digits.\n   202\t    return encoded\n   203\t      ? literal.replace(/%[\\dA-Fa-f]{2}/g, escape => escape.replace(/[A-Fa-f]/g, hex => `[${hex.toLowerCase()}${hex.toUpperCase()}]`))\n   204\t      : literal;\n   205\t  });\n   206\t  const secretPattern = patterns.length ? new RegExp(patterns.join(\"|\"), \"g\") : undefined;\n   207\t  const replacementPattern = patterns.length ? new RegExp(patterns.join(\"|\")) : undefined;\n   208\t  const preserveStructural = (input: string): string => {\n   209\t    if (replacementPattern?.test(input)) {\n   210\t      throw new McpFnRedactionLimitError(\n   211\t        \"Credential collides with a required structural artifact field\",\n   212\t      );\n   213\t    }\n   214\t    return input;\n   215\t  };\n   216\t  const preserveStructuralKey = (input: string): string => {\n   217\t    if (replacementPattern?.test(input)) {\n   218\t      throw new McpFnStructuralCredentialCollisionError();\n   219\t    }\n   220\t    return input;\n   221\t  };\n   222\t  // A requested marker is itself output and must not reproduce a credential.\n   223\t  if (secretPattern) {\n   224\t    const markerContainsSecret = secretPattern.test(redactionMarker ?? \"[REDACTED]\");\n   225\t    secretPattern.lastIndex = 0;\n   226\t    if (markerContainsSecret) redactionMarker = \"\";\n   227\t  }\n   228\t  const scrubString = (input: string, role: string, field: string, finalPass: boolean): string => {\n   229\t    const structuralField = `${role}:${field}`;\n   230\t    if (unrestrictedStructuralValueFields.has(structuralField) ||\n   231\t        structuralArtifactValues.get(structuralField)?.has(input)) {\n   232\t      return preserveStructural(input);\n   233\t    }\n   234\t    // Whole-string rejection cannot compose another credential by joining pieces.\n   235\t    // Run after both redactors; never feed this result through another redactor.\n   236\t    if (finalPass) return replacementPattern?.test(input) ? \"\" : input;\n   237\t    if (!secretPattern) return input;\n   238\t    return input.replace(secretPattern, secret => {\n   239\t      const maskCharacter = secret.includes(\"*\") ? \"#\" : \"*\";\n   240\t      const defaultReplacement = secret.length < 10\n   241\t        ? maskCharacter.repeat(secret.length)\n   242\t        : \"[REDACTED]\";\n   243\t      const replacement = redactionMarker ?? defaultReplacement;\n   244\t      // Every generated mask must be safe against the entire credential set.\n   245\t      return replacementPattern!.test(replacement) ? \"\" : replacement;\n   246\t    });\n   247\t  };\n   248\t  const scrub = (input: unknown, role = \"payload\", field = \"\", finalPass = false): unknown => {\n   249\t    input = specialValue(input);\n   250\t    if (typeof input === \"string\") return scrubString(input, role, field, finalPass);\n   251\t    if (Array.isArray(input)) {\n   252\t      const result = input.map(entry => scrub(entry, role, \"\", finalPass));\n   253\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   254\t      return result;\n   255\t    }\n   256\t    if (input && typeof input === \"object\") {\n   257\t      const entries: Array<[string, unknown]> = [];\n   258\t      const keys = new Set<string>();\n   259\t      for (const [key, entry] of Object.entries(input)) {\n   260\t        const fixed = envelopeKeys[role]?.has(key) ?? false;\n   261\t        if (fixed) preserveStructuralKey(key);\n   262\t        let childRole = \"payload\";\n   263\t        if (fixed) {\n   264\t          if (key === \"results\") childRole = \"result\";\n   265\t          else if (key === \"timeline\") childRole = (value as any)?.kind === \"mcpfn.inspector-snapshot\" ? \"inspectorEvent\" : \"diagnostic\";\n   266\t          else if ([\"failure\", \"runtime\", \"packages\", \"droppedInventoryEntries\", \"target\"].includes(key)) childRole = key;\n   267\t          else if (role === \"inspectorEvent\" && key === \"event\") childRole = (input as { source?: string }).source === \"client\" ? \"root\" : \"diagnostic\";\n   268\t        }\n   269\t        const scrubbedKey = fixed ? key : scrub(key, \"payload\", \"\", finalPass) as string;\n   270\t        if (keys.has(scrubbedKey)) {\n   271\t          throw new McpFnRedactionLimitError(\n   272\t            \"Credential redaction created duplicate object keys\",\n   273\t          );\n   274\t        }\n   275\t        keys.add(scrubbedKey);\n   276\t        const scrubbedEntry = typeof entry === \"string\"\n   277\t          ? scrub(entry, fixed ? role : \"payload\", key, finalPass)\n   278\t          : scrub(entry, childRole, \"\", finalPass);\n   279\t        entries.push([scrubbedKey, scrubbedEntry]);\n   280\t      }\n   281\t      const result = Object.fromEntries(entries);\n   282\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   283\t      return result;\n   284\t    }\n   285\t    return input;\n   286\t  };\n   287\t  const timelineEvent = value && typeof value === \"object\" && [\"client\", \"diagnostic\"].includes((value as { source?: string }).source ?? \"\");\n   288\t  let role = \"payload\";\n   289\t  if (preserveKeys) role = timelineEvent ? \"inspectorEvent\" : \"root\";\n   290\t  const scrubbed = scrub(value, role);\n   291\t  const generic = redactOAuthValue(scrubbed, { maxStringLength: 262_144, maxDepth: 64, maxArrayEntries: 100_000, maxObjectEntries: 100_000, ...(redactionMarker !== undefined ? { redactionMarker } : {}) });\n   292\t  const result = scrub(generic, role, \"\", true) as T;\n   293\t  assertPayloadSerialization(\n   294\t    result,\n   295\t    \"payload\",\n   296\t    true,\n   297\t    replacementPattern,\n   298\t  );\n   299\t  return result;\n   300\t}\n   301\t\n   302\tfunction assertPayloadSerialization(\n   303\t  value: unknown,\n   304\t  role: string,\n   305\t  finalPass: boolean,\n   306\t  credentialPattern: RegExp | undefined,\n   307\t): void {\n   308\t  if (!finalPass || role !== \"payload\" || !credentialPattern) return;\n   309\t  const serialized = JSON.stringify(value);\n   310\t  if (serialized !== undefined && credentialPattern.test(serialized)) {\n   311\t    throw new McpFnRedactionLimitError(\n   312\t      \"Credential redaction could not guarantee safe serialized output\",\n   313\t    );\n   314\t  }\n   315\t}\n   316\t\n   317\t/** Remove known opaque credential values as well as credential-shaped fields. */\n   318\texport function redactTargetCredentials<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean; redactionMarker?: string } = {}): T {\n   319\t  const state = targetSecrets.get(target);\n   320\t  return scrubCredentials(value, new Set([...(state?.active.keys() ?? []), ...[...(state?.scopes ?? [])].flatMap((scope) => [...scope])]), options.preserveKeys, options.redactionMarker);\n   321\t}\n   322\t\n   323\t/** Redact authenticated conformance output using the acquired credential. */\n   324\texport function redactRemoteCredential<T>(credential: McpFnRemoteCredential, value: T, options: { preserveKeys?: boolean } = {}): T {\n   325\t  return scrubCredentials(value, credentialValues(credential.headers), options.preserveKeys);\n   326\t}\n   327\t\n   328\tconst MAX_CREDENTIAL_HEADERS = 32;\n   329\tconst MAX_CREDENTIAL_HEADER_BYTES = 16_384;\n   330\tconst MAX_CREDENTIAL_HEADER_VALUE_BYTES = 8_192;\n   390\t/** Create a provider for an already-bounded API key or OAuth-derived token. */\n   391\texport function staticRemoteCredentialProvider(\n   392\t  credential: McpFnRemoteCredential,\n   393\t): McpFnRemoteCredentialProvider {\n   394\t  return { acquire: () => credential };\n   395\t}\n   396\t\n   397\t/** Acquire a credential and return an idempotent revoke-then-dispose lease. */\n   398\texport async function acquireRemoteCredential(\n   399\t  source: McpFnRemoteCredential | McpFnRemoteCredentialProvider,\n   400\t  context: McpFnRemoteCredentialContext,\n   401\t): Promise<McpFnRemoteCredentialLease> {\n   402\t  let provider: McpFnRemoteCredentialProvider;\n   403\t  let acquired: McpFnRemoteCredential;\n   404\t  try {\n   405\t    provider = isCredentialProvider(source) ? source : staticRemoteCredentialProvider(source);\n   406\t    acquired = await provider.acquire(context);\n   407\t  } catch {\n   408\t    // Until acquisition returns, its opaque secrets are unknown to the redactor.\n   409\t    // The provider owns rollback of resources allocated before it rejects.\n   410\t    throw new Error(\"Targ…4121 tokens truncated…re) {\n   112\t    cases.unshift(\n   113\t      `    <testcase name=\"${xml(safe.failure.phase ?? \"target\")}\" classname=\"mcpfn.${xml(safe.failure.layer)}\" time=\"0.000\">${junitFailure(safe.failure.message, safe.failure.code ?? safe.failure.layer)}</testcase>`,\n   114\t    );\n   115\t  }\n   116\t  if (safe.status === \"incomplete\" || omitted > 0 || (!safe.ok && !safe.failure && results.every((result) => result.status === \"passed\"))) {\n   117\t    cases.push(`    <testcase name=\"suite-incomplete\" classname=\"mcpfn.report\" time=\"0.000\">${junitFailure(safe.incompleteReason ?? \"Suite evidence is incomplete or omitted\", \"incomplete\")}</testcase>`);\n   118\t  }\n   119\t  if (cases.length === 0) {\n   120\t    cases.push(\n   121\t      '    <testcase name=\"target-suite\" classname=\"mcpfn.target\" time=\"0.000\"></testcase>',\n   122\t    );\n   123\t  }\n   124\t  const failures = cases.filter((entry) => entry.includes(\"<failure \")).length;\n   125\t  let serialized = junitDocument(safe, cases, failures);\n    70\t  redactionOmittedObservedEvents?: number;\n    71\t  incompleteReason?: string;\n    72\t  failure?: McpFnReportFailure;\n    73\t  timeline: McpFnDiagnosticEvent[];\n    74\t  droppedTimelineEvents: number;\n    75\t  results: McpFnScenarioResult[];\n    76\t}\n    77\t\n    78\tconst suiteCleanupOwners = new WeakMap<Error, { close: () => Promise<void>; pending?: Promise<void> }>();\n    79\t\n    80\tfunction retryTargetSuiteCleanup(error: Error): Promise<void> {\n    81\t  const owner = suiteCleanupOwners.get(error);\n    82\t  if (!owner) return Promise.resolve();\n    83\t  if (owner.pending) return owner.pending;\n    84\t  const pending = Promise.resolve().then(owner.close).then(\n    85\t    () => { suiteCleanupOwners.delete(error); },\n    86\t    () => Promise.reject(error),\n    87\t  ).finally(() => { owner.pending = undefined; });\n    88\t  owner.pending = pending;\n    89\t  return pending;\n    90\t}\n    91\t\n    92\t/** Final cleanup failed. The bounded report is a snapshot; retain this error to retry. */\n    93\texport class McpFnTargetSuiteCleanupError extends Error {\n    94\t  constructor(readonly report: McpFnTargetSuiteReport, close: () => Promise<void>) {\n    95\t    super(\"Target suite cleanup failed; retain this error and retryCleanup()\");\n    96\t    this.name = \"McpFnTargetSuiteCleanupError\";\n    97\t    suiteCleanupOwners.set(this, { close });\n    98\t  }\n    99\t\n   100\t  retryCleanup(): Promise<void> {\n   101\t    return retryTargetSuiteCleanup(this);\n   102\t  }\n   103\t}\n   104\t\n   105\t/** Report serialization failed after cleanup ownership had already transferred. */\n   106\texport class McpFnTargetSuiteArtifactCleanupError extends Error {\n   107\t  constructor(close: () => Promise<void>, cause: Error) {\n   108\t    super(`${cause.message}; retain this error and retryCleanup()`, { cause });\n   109\t    this.name = \"McpFnTargetSuiteArtifactCleanupError\";\n   110\t    suiteCleanupOwners.set(this, { close });\n   111\t  }\n   112\t\n   113\t  retryCleanup(): Promise<void> {\n   114\t    return retryTargetSuiteCleanup(this);\n   115\t  }\n   116\t}\n   117\t\n   118\t/** Runs local, stdio, HTTP, or custom targets through the production session engine. */\n   119\texport async function runMcpFnTargetSuite(\n   120\t  options: RunMcpFnTargetSuiteOptions,\n   121\t): Promise<McpFnTargetSuiteReport> {\n   122\t  const finishRedaction = beginTargetCredentialRedaction(options.target);\n   123\t  try { return await runTargetSuite(options); }\n   124\t  finally { finishRedaction(); }\n   125\t}\n   126\t\n   127\t/** Apply the target-owned scrubber before the bounded generic artifact pass. */\n   128\tfunction redactSuiteArtifact<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean } = {}): T {\n   129\t  const scrubbed = target.redact ? target.redact(value, options) : value;\n   130\t  return redactTargetCredentials(target, scrubbed, options);\n   131\t}\n   132\t\n   133\tfunction compareInventoryNames(left: string, right: string): number {\n   134\t  if (left === right) return 0;\n   135\t  return left < right ? -1 : 1;\n   136\t}\n   137\t\n   138\tfunction reportProjectionFailureReason(\n   139\t  error: unknown,\n   140\t  projectionFailure: \"redaction\" | \"serialization\" | undefined,\n   141\t): string {\n   142\t  if (error instanceof McpFnRedactionLimitError) {\n   143\t    return \"Credential redaction exceeded its traversal budget\";\n   144\t  }\n   145\t  if (projectionFailure === \"redaction\") {\n   146\t    return \"Credential redaction failed; report content omitted because safe serialization failed\";\n   147\t  }\n   148\t  return \"Report content omitted because safe serialization failed\";\n   149\t}\n   150\t\n   151\tclass SuiteDiagnosticCollector {\n   152\t  readonly timeline: McpFnDiagnosticEvent[] = [];\n   153\t  private readonly timelineSizes: number[] = [];\n   154\t  private timelineBytes = 0;\n   155\t  private observedRedactionOmissions = 0;\n   156\t  private initialRedactionOmissions = 0;\n   157\t  dropped = 0;\n   158\t  countExceeded = false;\n   159\t  bytesExceeded = false;\n   160\t  serializationFailed = false;\n   161\t  redactionFailed = false;\n   162\t  cleanupFailure: McpFnReportFailure | undefined;\n   163\t\n   164\t  constructor(\n   165\t    private readonly maxEvents: number,\n   166\t    private readonly maxBytes: number,\n   167\t    private readonly target: McpFnTarget,\n   168\t    private readonly consumer?: (event: McpFnDiagnosticEvent) => void | Promise<void>,\n   169\t  ) {}\n   170\t\n   171\t  captureBaseline(client: McpFnTestClient): void {\n   172\t    this.initialRedactionOmissions = client.session\n   173\t      .getRedactionOmissionCounts().diagnostics;\n   174\t  }\n   175\t\n   176\t  captureUnobserved(client: McpFnTestClient | undefined): void {\n   177\t    const total = client?.session.getRedactionOmissionCounts().diagnostics ??\n   178\t      this.initialRedactionOmissions;\n   179\t    const unobserved = Math.max(\n   180\t      0,\n   181\t      total - this.initialRedactionOmissions - this.observedRedactionOmissions,\n   182\t    );\n   183\t    if (unobserved > 0) {\n   184\t      this.redactionFailed = true;\n   185\t      this.dropped += unobserved;\n   186\t    }\n   187\t  }\n   188\t\n   189\t  async record(client: McpFnTestClient | undefined, event: McpFnDiagnosticEvent): Promise<void> {\n   190\t    if (client?.session.isRedactionOmission(event)) {\n   191\t      this.observedRedactionOmissions += 1;\n   192\t      this.redactionFailed = true;\n   193\t      this.dropped += 1;\n   194\t    }\n   195\t    if ([\"token-revocation\", \"transport-close\"].includes(event.phase) &&\n   196\t        event.outcome === \"failed\") {\n   197\t      this.cleanupFailure ??= normalizeMcpFnReportFailure({\n   198\t        name: \"CleanupError\", message: \"Target cleanup failed\",\n   199\t        code: event.code, phase: event.phase,\n   200\t      });\n   201\t    }\n   202\t    const safeEvent = redactTargetCredentials(this.target, event, { preserveKeys: true });\n   203\t    const bytes = this.serializedBytes(safeEvent);\n   204\t    if (bytes === undefined) {\n   205\t      await this.consumer?.(safeEvent);\n   206\t      return;\n   207\t    }\n   208\t    if (bytes > this.maxBytes) {\n   209\t      this.bytesExceeded = true;\n   210\t      this.dropped += 1;\n   211\t    } else {\n   212\t      this.timeline.push(safeEvent);\n   213\t      this.timelineSizes.push(bytes);\n   214\t      this.timelineBytes += bytes;\n   215\t      this.enforceBounds();\n   216\t    }\n   217\t    await this.consumer?.(safeEvent);\n   218\t  }\n   219\t\n   220\t  private serializedBytes(event: McpFnDiagnosticEvent): number | undefined {\n   221\t    try {\n   222\t      const json = JSON.stringify(event, (_key, value: unknown) => {\n   223\t        if (value === undefined || (typeof value === \"number\" && !Number.isFinite(value))) {\n   224\t          throw new Error(\"Diagnostic contains a non-JSON value\");\n   225\t        }\n   226\t        return value;\n   227\t      });\n   228\t      structuredClone(event);\n   229\t      return Buffer.byteLength(json);\n   230\t    } catch {\n   231\t      this.serializationFailed = true;\n   232\t      this.dropped += 1;\n   233\t      return undefined;\n   234\t    }\n   235\t  }\n   236\t\n   237\t  private enforceBounds(): void {\n   238\t    while (this.timeline.length > this.maxEvents || this.timelineBytes > this.maxBytes) {\n   239\t      this.countExceeded ||= this.timeline.length > this.maxEvents;\n   240\t      this.bytesExceeded ||= this.timelineBytes > this.maxBytes;\n   241\t      this.timeline.shift();\n   242\t      this.timelineBytes -= this.timelineSizes.shift()!;\n   243\t      this.dropped += 1;\n   244\t    }\n   245\t  }\n   246\t}\n   247\t\n   248\tasync function runTargetSuite(options: RunMcpFnTargetSuiteOptions): Promise<McpFnTargetSuiteReport> {\n   249\t  const maxTimelineEvents = options.maxTimelineEvents ?? 500;\n   250\t  if (!Number.isInteger(maxTimelineEvents) || maxTimelineEvents < 1) {\n   300\t      const expected = [...options.expectedToolNames].sort(compareInventoryNames);\n   301\t      if (stableJson(actual) !== stableJson(expected)) {\n   302\t        throw new McpFnAssertionError(`Tool inventory mismatch: expected ${stableJson(expected)}, actual ${stableJson(actual)}`);\n   303\t      }\n   304\t    }\n   305\t    execution = {\n   306\t      results: await runScenarios(\n   307\t        client,\n   308\t        options.scenarios ?? [],\n   309\t        options.scenarioRun,\n   310\t      ),\n   311\t      server: client.session.getServerVersion(),\n   312\t      capabilities: client.session.getServerCapabilities(),\n   313\t    };\n   314\t  } catch (error) {\n   315\t    try {\n   316\t      failure = normalizeMcpFnReportFailure(redactSuiteArtifact(options.target, error, { preserveKeys: true }));\n   317\t    } catch {\n   318\t      // Arbitrary error properties/proxies can throw, including secret-bearing errors.\n   319\t      failure = normalizeMcpFnReportFailure({ name: \"RedactionError\", code: \"MCPFN_REDACTION_FAILED\", message: \"Target failure omitted because credential redaction failed\" });\n   320\t    }\n   321\t  } finally {\n   322\t    try {\n   323\t      // Custom hooks may depend on credentials cleared by close. Capture every\n   324\t      // target-controlled report value while the session still owns that state.\n   325\t      if (client?.session.state === \"connected\") {\n   326\t        let kind: string | undefined;\n   327\t        let descriptor: Omit<McpFnTargetDescriptor, \"kind\"> | undefined;\n   328\t        try {\n   329\t          ({ kind, ...descriptor } = options.target.describe());\n   330\t        } catch { projectionFailure = \"serialization\"; }\n   331\t        if (!projectionFailure) {\n   332\t          try {\n   333\t            capturedTarget = {\n   334\t              ...redactSuiteArtifact(options.target, descriptor!, { preserveKeys: false }),\n   335\t              kind: client.session.preserveArtifactStructure(kind!),\n   336\t            };\n   337\t            capturedManifestHash = options.manifest\n   338\t              ? redactSuiteArtifact(options.target, options.manifest.hash, { preserveKeys: false })\n   339\t              : undefined;\n   340\t            execution = {\n   341\t              server: execution.server === undefined\n   342\t                ? undefined\n   343\t                : redactSuiteArtifact(options.target, execution.server, { preserveKeys: false }),\n   344\t              capabilities: execution.capabilities === undefined\n   345\t                ? undefined\n   346\t                : redactSuiteArtifact(options.target, execution.capabilities, { preserveKeys: false }),\n   347\t              results: execution.results.map(result => ({\n   348\t                ...result,\n   349\t                name: redactSuiteArtifact(options.target, result.name, { preserveKeys: false }),\n   350\t                operation: redactSuiteArtifact(options.target, result.operation, { preserveKeys: false }),\n   351\t                ...(result.tool === undefined ? {} : {\n   352\t                  tool: redactSuiteArtifact(options.target, result.tool, { preserveKeys: false }),\n   353\t                }),\n   354\t              })),\n   355\t            };\n   356\t          } catch { projectionFailure = \"redaction\"; }\n   357\t        }\n   358\t      } else if (execution.results.length || execution.server || execution.capabilities) {\n   359\t        projectionFailure = \"serialization\";\n   360\t      }\n   361\t    } catch { projectionFailure = \"serialization\"; }\n   362\t    try {\n   363\t      await client?.close();\n   364\t    } catch (error) {\n   365\t      const owner = client;\n   366\t      if (error instanceof McpFnTestClientCleanupError) {\n   367\t        retainedCleanup = () => error.retryCleanup();\n   368\t      } else if (owner) {\n   369\t        retainedCleanup = () => owner.close();\n   370\t      }\n   371\t      const terminalCleanupError = error instanceof McpFnTestClientCleanupError && error.cause !== undefined\n   372\t        ? error.cause\n   373\t        : error;\n   374\t      const terminalCleanupPhase = terminalCleanupError && typeof terminalCleanupError === \"object\" &&\n   375\t          (terminalCleanupError as { phase?: unknown }).phase === \"token-revocation\"\n   376\t        ? \"token-revocation\"\n   377\t        : \"transport-close\";\n   378\t      cleanupFailure = normalizeMcpFnReportFailure({\n   379\t        name: \"CleanupError\",\n   380\t        message: \"Target cleanup failed\",\n   381\t        code: \"MCPFN_TARGET_CLEANUP_FAILED\",\n   382\t        phase: terminalCleanupPhase,\n   383\t      });\n   384\t    }\n   385\t    diagnostics.captureUnobserved(client);\n   386\t  }\n   387\t  cleanupFailure ??= diagnostics.cleanupFailure;\n   388\t  failure ??= cleanupFailure;\n   389\t  const results = execution.results;\n   390\t  const failed = results.filter((result) => result.status === \"failed\").length;\n   391\t  const incomplete = results.filter((result) => result.status === \"incomplete\").length;\n   392\t  const droppedObservedEvents = results.reduce(\n   393\t    (total, result) => total + (result.droppedObservedEvents ?? 0),\n   394\t    0,\n   395\t  );\n   396\t  const redactionOmittedObservedEvents = results.reduce(\n   397\t    (total, result) => total + (result.redactionOmittedObservedEvents ?? 0),\n   398\t    0,\n   399\t  );\n   400\t  const overflowedObservedEvents = droppedObservedEvents - redactionOmittedObservedEvents;\n   401\t  const artifactIncomplete = Boolean(failure) || incomplete > 0 ||\n   402\t    diagnostics.dropped > 0 ||\n   403\t    droppedObservedEvents > 0;\n   404\t  const report: McpFnTargetSuiteReport = {\n   405\t    formatVersion: 1,\n   406\t    kind: \"mcpfn.target-suite-report\",\n   407\t    status: artifactIncomplete ? \"incomplete\" : \"complete\",\n   408\t    runtime: {\n   409\t      node: process.version,\n   410\t      scenarioFormatVersion: 1,\n   411\t      reportSchemaVersion: MCPFN_REPORT_SCHEMA_VERSION,\n   412\t      packages: { testing: MCPFN_TESTING_VERSION },\n   413\t    },\n   414\t    ok: failed === 0 && !artifactIncomplete,\n   415\t    target: capturedTarget,\n   416\t    server: execution.server,\n   417\t    capabilities: execution.capabilities,\n   418\t    manifestChecked,\n   419\t    ...(capturedManifestHash === undefined ? {} : { manifestHash: capturedManifestHash }),\n   420\t    total: results.length,\n   421\t    passed: results.length - failed - incomplete,\n   422\t    failed,\n   423\t    incomplete,\n   424\t    droppedResults: 0,\n   425\t    droppedObservedEvents,\n   426\t    ...(redactionOmittedObservedEvents > 0 ? { redactionOmittedObservedEvents } : {}),\n   427\t    ...(failure || diagnostics.dropped > 0 || droppedObservedEvents > 0\n   428\t      ? {\n   429\t        incompleteReason: [\n   430\t          ...(failure ? [`${failure.layer}: ${failure.message}`] : []),\n   431\t          ...(cleanupFailure ? [`Cleanup: ${cleanupFailure.message}`] : []),\n   432\t          ...(diagnostics.serializationFailed ? [\"Diagnostic timeline contained non-JSON data\"] : []),\n   433\t          ...(diagnostics.redactionFailed ? [\"Diagnostic timeline redaction failed; original events omitted\"] : []),\n   434\t          ...(diagnostics.countExceeded ? [\"Diagnostic timeline exceeded maxTimelineEvents\"] : []),\n   435\t          ...(diagnostics.bytesExceeded ? [\"Diagnostic timeline exceeded maxReportBytes\"] : []),\n   436\t          ...(redactionOmittedObservedEvents > 0\n   437\t            ? [\"Observed client events were omitted because credential redaction failed\"]\n   438\t            : []),\n   439\t          ...(overflowedObservedEvents > 0\n   440\t            ? [\"Observed client events exceeded maxObservedEvents\"]\n   441\t            : []),\n   442\t        ].join(\"; \"),\n   443\t      }\n   444\t      : {}),\n   445\t    ...(failure ? { failure } : {}),\n   446\t    timeline: diagnostics.timeline,\n   447\t    droppedTimelineEvents: diagnostics.dropped,\n   448\t    results,\n   449\t  };\n   450\t  let finalized: McpFnTargetSuiteReport;\n   451\t  try {\n   452\t    if (projectionFailure) throw new Error(\"Report payload projection failed\");\n   453\t    // Custom redaction already completed before cleanup. Built-in report scopes\n   454\t    // remain active here for bounded final serialization.\n   455\t    finalized = enforceReportCap(redactTargetCredentials(options.target, report, { preserveKeys: true }), maxReportBytes);\n   456\t  } catch (error) {\n   457\t    if (error instanceof McpFnStructuralCredentialCollisionError) {\n   458\t      const failure = new McpFnClientError(\n   459\t        \"MCPFN_OPERATION_FAILED\",\n   460\t        \"Target report cannot be serialized because a credential conflicts with required artifact structure\",\n   461\t        { phase: \"capability-operation\" },\n   462\t      );\n   463\t      if (retainedCleanup) {\n   464\t        throw new McpFnTargetSuiteArtifactCleanupError(retainedCleanup, failure);\n   465\t      }\n   466\t      throw failure;\n   467\t    }\n   468\t    finalized = enforceReportCap({ ...report, ok: false, status: \"incomplete\",\n   469\t      incompleteReason: reportProjectionFailureReason(error, projectionFailure),\n   470\t      target: { kind: \"custom\" }, server: undefined, capabilities: undefined, manifestHash: undefined,\n   471\t      failure: undefined, results: [], timeline: [],\n   472\t      droppedResults: report.results.length, droppedTimelineEvents: report.droppedTimelineEvents + report.timeline.length,\n   473\t    }, maxReportBytes);\n   474\t  }\n   475\t  if (retainedCleanup) throw new McpFnTargetSuiteCleanupError(finalized, retainedCleanup);\n   476\t  return finalized;\n   477\t}\n   478\t\n   479\tfunction enforceReportCap(\n   480\t  report: McpFnTargetSuiteReport,\n   481\t  maxBytes: number,\n   482\t): McpFnTargetSuiteReport {\n   483\t  validateReportCap(maxBytes);\n   484\t  const bounded = structuredClone(report);\n   485\t  if (jsonBytes(bounded) > maxBytes) {\n   486\t    bounded.ok = false;\n   487\t    bounded.status = \"incomplete\";\n   488\t    bounded.incompleteReason = \"Report content exceeded maxReportBytes and was truncated\";\n   489\t  }\n   490\t  while (jsonBytes(bounded) > maxBytes && bounded.results.length > 0) {\n   491\t    bounded.results.pop();\n   492\t    bounded.droppedResults += 1;\n   493\t  }\n   494\t  if (jsonBytes(bounded) > maxBytes) {\n   495\t    bounded.target = { kind: report.target.kind };\n   496\t    bounded.server = undefined;\n   497\t    bounded.capabilities = undefined;\n   498\t    bounded.timeline = [];\n   499\t    bounded.droppedTimelineEvents += report.timeline.length;\n   500\t    if (bounded.failure) {\n   501\t      bounded.failure.details = undefined;\n   502\t      bounded.failure.message = \"Target operation failed; details omitted to fit report budget\";\n   503\t    }\n   504\t  }\n   505\t  if (bounded.droppedResults > 0 || jsonBytes(bounded) > maxBytes) {\n   506\t    bounded.ok = false;\n   507\t    bounded.status = \"incomplete\";\n   508\t    bounded.incompleteReason = \"Report content exceeded maxReportBytes and was truncated\";\n   509\t  }\n   510\t  if (jsonBytes(bounded) > maxBytes) {\n   511\t    throw new Error(\"The minimum target suite report exceeds maxReportBytes\");\n   512\t  }\n   513\t  return bounded;\n   514\t}\n   515\t\n   516\tfunction validateReportCap(maxBytes: number): void {\n   517\t  if (!Number.isInteger(maxBytes) || maxBytes < 1_024) {\n   518\t    throw new Error(\"maxReportBytes must be an integer of at least 1024\");\n   519\t  }\n   520\t}\n"},"started_at_ms":1789812899087,"completed_at_ms":1789812899088}}
{"timestamp":"2026-09-19T10:14:59.196Z","ordinal":4861,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0b929-7d7c-7e71-8cc9-c95b7b00e78b","call_id":"call_0u5ggP3yYqOR0sLuA7QYtLYa","output":[{"type":"input_text","text":"Script completed\nWall time 0.5 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 14121)\nTotal output lines: 1090\n\n     1\timport {\n     2\t  McpFnClientError,\n     3\t  customTarget,\n     4\t  streamableHttpTarget,\n     5\t  type McpFnStreamableHttpTargetOptions,\n     6\t  type McpFnTarget,\n     7\t  type McpFnTransportHandle,\n     8\t} from \"@mcpfn/client\";\n     9\t\n    10\timport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n    11\t\n    12\ttype SecretState = { active: Map<string, number>; scopes: Set<Set<string>> };\n    13\tconst targetSecrets = new WeakMap<McpFnTarget, SecretState>();\n    14\t\n    15\t/** Retain released credentials only for the lifetime of a report operation. */\n    16\texport function beginTargetCredentialRedaction(target: McpFnTarget): () => void {\n    17\t  const state = targetSecrets.get(target);\n    18\t  if (!state) return () => undefined;\n    19\t  const scope = new Set(state.active.keys());\n    20\t  state.scopes.add(scope);\n    21\t  return () => { state.scopes.delete(scope); scope.clear(); };\n    22\t}\n    23\t\n    24\tfunction credentialValues(headers: HeadersInit): Set<string> {\n    25\t  const values = boundedCredentialEntries(headers);\n    26\t  const secrets = new Set<string>();\n    27\t  for (const [header, raw] of values) {\n    28\t    if (typeof raw !== \"string\" || !raw.trim()) continue;\n    29\t    secrets.add(raw);\n    30\t    secrets.add(raw.trim());\n    31\t    const normalizedHeader = header.toLowerCase();\n    32\t    if ([\"authorization\", \"proxy-authorization\"].includes(normalizedHeader)) {\n    33\t      addAuthorizationSecrets(raw, secrets);\n    34\t    }\n    35\t    if (normalizedHeader === \"cookie\") addCookieSecrets(raw, secrets);\n    36\t  }\n    37\t  return secrets;\n    38\t}\n    39\t\n    40\tfunction addAuthorizationSecrets(raw: string, secrets: Set<string>): void {\n    41\t  const trimmed = raw.trim();\n    42\t  const separator = trimmed.search(/\\s/);\n    43\t  if (separator <= 0) return;\n    44\t  const scheme = trimmed.slice(0, separator).toLowerCase();\n    45\t  const token = trimmed.slice(separator).trim();\n    46\t  if (token) secrets.add(token);\n    47\t  if (scheme !== \"basic\" || !/^[\\dA-Za-z+/]+={0,2}$/.test(token)) return;\n    48\t  const decoded = Buffer.from(token, \"base64\");\n    49\t  // Round-trip validation avoids interpreting malformed tokens as credentials.\n    50\t  if (decoded.toString(\"base64\").replace(/=+$/, \"\") !== token.replace(/=+$/, \"\")) return;\n    51\t  for (const encoding of [\"utf8\", \"latin1\"] as const) {\n    52\t    const pair = decoded.toString(encoding);\n    53\t    const colon = pair.indexOf(\":\");\n    54\t    if (colon < 0) continue;\n    55\t    for (const value of [pair, pair.slice(0, colon), pair.slice(colon + 1)]) {\n    56\t      if (value) secrets.add(value);\n    57\t    }\n    58\t  }\n    59\t}\n    60\t\n    61\tfunction addCookieSecrets(raw: string, secrets: Set<string>): void {\n    62\t  // Cookie values are independently reflectable even though the request\n    63\t  // authenticates with the complete header. RFC 6265 cookie values cannot\n    64\t  // contain comma or semicolon, so both delimiters cover combined entries.\n    65\t  for (const part of raw.split(/[;,]/)) {\n    66\t    const pair = part.trim();\n    67\t    if (!pair) continue;\n    68\t    const equals = pair.indexOf(\"=\");\n    69\t    if (equals < 1) {\n    70\t      throw new TypeError(\"Cookie credential headers must contain name=value pairs\");\n    71\t    }\n    72\t    const value = pair.slice(equals + 1).trim();\n    73\t    if (!value) continue;\n    74\t    secrets.add(value);\n    75\t    addUnquotedCookieSecret(value, secrets);\n    76\t  }\n    77\t}\n    78\t\n    79\tfunction addUnquotedCookieSecret(value: string, secrets: Set<string>): void {\n    80\t  if (!value.startsWith('\"') && !value.endsWith('\"')) return;\n    81\t  if (value.length < 2 || !value.startsWith('\"') || !value.endsWith('\"')) {\n    82\t    throw new TypeError(\"Cookie credential values must use balanced quotes\");\n    83\t  }\n    84\t  const unquoted = value.slice(1, -1);\n    85\t  if (unquoted.includes('\"') || unquoted.includes(\"\\\\\")) {\n    86\t    throw new TypeError(\"Cookie credential values must use RFC 6265 syntax\");\n    87\t  }\n    88\t  if (unquoted) secrets.add(unquoted);\n    89\t}\n    90\t\n    91\texport class McpFnRedactionLimitError extends Error {\n    92\t  constructor(message = \"Credential redaction exceeded its traversal budget\") { super(message); }\n    93\t}\n    94\t\n    95\t/** No typed artifact can preserve this authored key without exposing a credential. */\n    96\texport class McpFnStructuralCredentialCollisionError extends McpFnRedactionLimitError {\n    97\t  constructor() {\n    98\t    super(\"Credential collides with a required structural artifact key\");\n    99\t  }\n   100\t}\n   101\t\n   102\t// Only these locally authored envelope paths retain structural keys. Unknown\n   103\t// children (including inspector events and server metadata) are always payloads.\n   104\tconst envelopeKeys: Record<string, Set<string>> = Object.fromEntries(Object.entries({\n   105\t  root: \"formatVersion kind status runtime ok target server capabilities manifestChecked manifestHash total passed failed incomplete droppedResults droppedObservedEvents redactionOmittedObservedEvents incompleteReason failure timeline droppedTimelineEvents results count clientState tools resources resourceTemplates prompts droppedEvents timelineComplete droppedInventoryEntries inventoryComplete suiteVersion exitCode stdout stderr phase outcome code requestId at details payload\",\n   106\t  result: \"formatVersion name operation tool status sideEffect durationMs error droppedObservedEvents redactionOmittedObservedEvents\",\n   107\t  diagnostic: \"phase outcome code requestId at target details\",\n   108\t  inspectorEvent: \"formatVersion source kind at event\",\n   109\t  failure: \"name message layer code phase details\",\n   110\t  runtime: \"node scenarioFormatVersion reportSchemaVersion packages\",\n   111\t  packages: \"testing\",\n   112\t  droppedInventoryEntries: \"tools resources resourceTemplates prompts\",\n   113\t  target: \"kind\",\n   114\t}).map(([role, keys]) => [role, new Set(keys.split(\" \"))]));\n   115\t\n   116\tconst structuralArtifactValues = new Map<string, Set<string>>([\n   117\t  [\"root:kind\", new Set([\"logging.message\", \"progress\", \"tasks.status\", \"resources.updated\", \"tools.list_changed\", \"resources.list_changed\", \"prompts.list_changed\", \"resources.subscribed\", \"resources.unsubscribed\", \"client.roots\", \"client.sampling\", \"client.elicitation\", \"mcpfn.target-suite-report\", \"mcpfn.inspector-snapshot\", \"mcpfn.official-conformance-report\"])],\n   118\t  [\"inspectorEvent:kind\", new Set([\"logging.message\", \"progress\", \"tasks.status\", \"resources.updated\", \"tools.list_changed\", \"resources.list_changed\", \"prompts.list_changed\", \"resources.subscribed\", \"resources.unsubscribed\", \"client.roots\", \"client.sampling\", \"client.elicitation\"])],\n   119\t  [\"root:clientState\", new Set([\"idle\", \"connecting\", \"authorization-required\", \"connected\", \"closing\", \"closed\"])],\n   120\t  [\"target:kind\", new Set([\"authenticated-streamable-http\", \"streamable-http\", \"stdio\", \"in-memory\", \"custom\"])],\n   121\t  [\"root:status\", new Set([\"passed\", \"failed\", \"incomplete\", \"complete\"])],\n   122\t  [\"result:status\", new Set([\"passed\", \"failed\", \"incomplete\", \"complete\"])],\n   123\t  [\"root:outcome\", new Set([\"started\", \"succeeded\", \"failed\"])],\n   124\t  [\"diagnostic:outcome\", new Set([\"started\", \"succeeded\", \"failed\"])],\n   125\t  ...[\"root\", \"diagnostic\", \"failure\"].map(role => [\n   126\t    `${role}:phase`,\n   127\t    new Set([\"resource-discovery\", \"authorization-server-discovery\", \"client-registration\", \"authorization-request\", \"authorization-callback\", \"token-exchange\", \"token-refresh\", \"token-revocation\", \"transport-connect\", \"mcp-initialize\", \"capability-operation\", \"transport-close\"]),\n   128\t  ] as [string, Set<string>]),\n   129\t  [\"failure:layer\", new Set([\"mcpfn-preflight\", \"authorization-server\", \"resource-server\", \"mcp-initialization\", \"scenario\", \"upstream-conformance\"])],\n   130\t  [\"inspectorEvent:source\", new Set([\"diagnostic\", \"client\"])],\n   131\t  [\"result:sideEffect\", new Set([\"none\", \"idempotent\", \"non-idempotent\"])],\n   132\t]);\n   133\t\n   134\tconst unrestrictedStructuralValueFields = new Set([\n   135\t  \"packages:testing\",\n   136\t  \"runtime:node\",\n   137\t  \"runtime:reportSchemaVersion\",\n   138\t  \"root:suiteVersion\",\n   139\t]);\n   140\t\n   141\tfunction specialValue(input: unknown): unknown {\n   142\t  if (input instanceof Error) return normalizeErrorValue(input);\n   143\t  if (input instanceof Date) return Number.isNaN(input.getTime()) ? \"Invalid Date\" : input.toISOString();\n   144\t  if (input instanceof URL) return input.href;\n   145\t  if (input instanceof Map) {\n   146\t    if (Object.getOwnPropertyDescriptor(Map.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   147\t    return { type: \"Map\", entries: [...Map.prototype.entries.call(input)] };\n   148\t  }\n   149\t  if (input instanceof Set) {\n   150\t    if (Object.getOwnPropertyDescriptor(Set.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   151\t    return { type: \"Set\", values: [...Set.prototype.values.call(input)] };\n   152\t  }\n   153\t  return input;\n   154\t}\n   155\t\n   156\tfunction normalizeErrorValue(input: Error): Record<string, unknown> {\n   157\t  // Error instances may expose attacker-controlled enumerable keys. A\n   158\t  // null-prototype accumulator keeps `__proto__` as ordinary payload data.\n   159\t  const normalized = Object.create(null) as Record<string, unknown>;\n   160\t  let enumerableFields = 0;\n   161\t  for (const key in input) {\n   162\t    if (!Object.hasOwn(input, key)) continue;\n   163\t    if (++enumerableFields > 100_000) throw new McpFnRedactionLimitError();\n   164\t    normalized[key] = (input as unknown as Record<string, unknown>)[key];\n   165\t  }\n   166\t  normalized.name = input.name;\n   167\t  normalized.message = input.message;\n   168\t  normalized.stack = input.stack;\n   169\t  if (input.cause !== undefined) normalized.cause = input.cause;\n   170\t  return normalized;\n   171\t}\n   172\t\n   173\tfunction scrubCredentials<T>(value: T, values: Iterable<string>, preserveKeys = false, redactionMarker?: string): T {\n   174\t  // Preserve whether a pattern came from opaque text or a serializer. Literal\n   175\t  // percent sequences in credentials must not acquire URL hex-case semantics.\n   176\t  const variants = [...values].filter(Boolean).flatMap(secret => [\n   177\t    { value: secret, encoded: false },\n   178\t    { value: JSON.stringify(secret).slice(1, -1), encoded: false },\n   179\t    { value: encodeURIComponent(secret), encoded: true },\n   180\t    { value: new URLSearchParams({ value: secret }).toString().slice(\"value=\".length), encoded: true },\n   181\t  ]).sort((a, b) => b.value.length - a.value.length);\n   182\t  let entries = 0, stringBytes = 0;\n   183\t  const budget = (input: unknown, depth = 0): void => {\n   184\t    input = specialValue(input);\n   185\t    if ((Array.isArray(input) && input.length > 100_000) || ++entries > 100_000 || depth > 32) throw new McpFnRedactionLimitError();\n   186\t    if (typeof input === \"string\") {\n   187\t      stringBytes += Buffer.byteLength(input);\n   188\t      if (input.length > 262_144 || stringBytes > 2_097_152) throw new McpFnRedactionLimitError();\n   189\t    } else if (input && typeof input === \"object\") {\n   190\t      for (const key in input) if (Object.hasOwn(input, key)) {\n   191\t        budget(key, depth + 1);\n   192\t        budget((input as Record<string, unknown>)[key], depth + 1);\n   193\t      }\n   194\t    }\n   195\t  };\n   196\t  // Check before either redactor allocates copies. Exceeding a budget is an\n   197\t  // explicit failure, never silent truncation of a typed report collection.\n   198\t  budget(value);\n   199\t  const patterns = variants.map(({ value, encoded }) => {\n   200\t    const literal = value.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n   201\t    // Only generated percent escapes accept mixed-case hex digits.\n   202\t    return encoded\n   203\t      ? literal.replace(/%[\\dA-Fa-f]{2}/g, escape => escape.replace(/[A-Fa-f]/g, hex => `[${hex.toLowerCase()}${hex.toUpperCase()}]`))\n   204\t      : literal;\n   205\t  });\n   206\t  const secretPattern = patterns.length ? new RegExp(patterns.join(\"|\"), \"g\") : undefined;\n   207\t  const replacementPattern = patterns.length ? new RegExp(patterns.join(\"|\")) : undefined;\n   208\t  const preserveStructural = (input: string): string => {\n   209\t    if (replacementPattern?.test(input)) {\n   210\t      throw new McpFnRedactionLimitError(\n   211\t        \"Credential collides with a required structural artifact field\",\n   212\t      );\n   213\t    }\n   214\t    return input;\n   215\t  };\n   216\t  const preserveStructuralKey = (input: string): string => {\n   217\t    if (replacementPattern?.test(input)) {\n   218\t      throw new McpFnStructuralCredentialCollisionError();\n   219\t    }\n   220\t    return input;\n   221\t  };\n   222\t  // A requested marker is itself output and must not reproduce a credential.\n   223\t  if (secretPattern) {\n   224\t    const markerContainsSecret = secretPattern.test(redactionMarker ?? \"[REDACTED]\");\n   225\t    secretPattern.lastIndex = 0;\n   226\t    if (markerContainsSecret) redactionMarker = \"\";\n   227\t  }\n   228\t  const scrubString = (input: string, role: string, field: string, finalPass: boolean): string => {\n   229\t    const structuralField = `${role}:${field}`;\n   230\t    if (unrestrictedStructuralValueFields.has(structuralField) ||\n   231\t        structuralArtifactValues.get(structuralField)?.has(input)) {\n   232\t      return preserveStructural(input);\n   233\t    }\n   234\t    // Whole-string rejection cannot compose another credential by joining pieces.\n   235\t    // Run after both redactors; never feed this result through another redactor.\n   236\t    if (finalPass) return replacementPattern?.test(input) ? \"\" : input;\n   237\t    if (!secretPattern) return input;\n   238\t    return input.replace(secretPattern, secret => {\n   239\t      const maskCharacter = secret.includes(\"*\") ? \"#\" : \"*\";\n   240\t      const defaultReplacement = secret.length < 10\n   241\t        ? maskCharacter.repeat(secret.length)\n   242\t        : \"[REDACTED]\";\n   243\t      const replacement = redactionMarker ?? defaultReplacement;\n   244\t      // Every generated mask must be safe against the entire credential set.\n   245\t      return replacementPattern!.test(replacement) ? \"\" : replacement;\n   246\t    });\n   247\t  };\n   248\t  const scrub = (input: unknown, role = \"payload\", field = \"\", finalPass = false): unknown => {\n   249\t    input = specialValue(input);\n   250\t    if (typeof input === \"string\") return scrubString(input, role, field, finalPass);\n   251\t    if (Array.isArray(input)) {\n   252\t      const result = input.map(entry => scrub(entry, role, \"\", finalPass));\n   253\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   254\t      return result;\n   255\t    }\n   256\t    if (input && typeof input === \"object\") {\n   257\t      const entries: Array<[string, unknown]> = [];\n   258\t      const keys = new Set<string>();\n   259\t      for (const [key, entry] of Object.entries(input)) {\n   260\t        const fixed = envelopeKeys[role]?.has(key) ?? false;\n   261\t        if (fixed) preserveStructuralKey(key);\n   262\t        let childRole = \"payload\";\n   263\t        if (fixed) {\n   264\t          if (key === \"results\") childRole = \"result\";\n   265\t          else if (key === \"timeline\") childRole = (value as any)?.kind === \"mcpfn.inspector-snapshot\" ? \"inspectorEvent\" : \"diagnostic\";\n   266\t          else if ([\"failure\", \"runtime\", \"packages\", \"droppedInventoryEntries\", \"target\"].includes(key)) childRole = key;\n   267\t          else if (role === \"inspectorEvent\" && key === \"event\") childRole = (input as { source?: string }).source === \"client\" ? \"root\" : \"diagnostic\";\n   268\t        }\n   269\t        const scrubbedKey = fixed ? key : scrub(key, \"payload\", \"\", finalPass) as string;\n   270\t        if (keys.has(scrubbedKey)) {\n   271\t          throw new McpFnRedactionLimitError(\n   272\t            \"Credential redaction created duplicate object keys\",\n   273\t          );\n   274\t        }\n   275\t        keys.add(scrubbedKey);\n   276\t        const scrubbedEntry = typeof entry === \"string\"\n   277\t          ? scrub(entry, fixed ? role : \"payload\", key, finalPass)\n   278\t          : scrub(entry, childRole, \"\", finalPass);\n   279\t        entries.push([scrubbedKey, scrubbedEntry]);\n   280\t      }\n   281\t      const result = Object.fromEntries(entries);\n   282\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   283\t      return result;\n   284\t    }\n   285\t    return input;\n   286\t  };\n   287\t  const timelineEvent = value && typeof value === \"object\" && [\"client\", \"diagnostic\"].includes((value as { source?: string }).source ?? \"\");\n   288\t  let role = \"payload\";\n   289\t  if (preserveKeys) role = timelineEvent ? \"inspectorEvent\" : \"root\";\n   290\t  const scrubbed = scrub(value, role);\n   291\t  const generic = redactOAuthValue(scrubbed, { maxStringLength: 262_144, maxDepth: 64, maxArrayEntries: 100_000, maxObjectEntries: 100_000, ...(redactionMarker !== undefined ? { redactionMarker } : {}) });\n   292\t  const result = scrub(generic, role, \"\", true) as T;\n   293\t  assertPayloadSerialization(\n   294\t    result,\n   295\t    \"payload\",\n   296\t    true,\n   297\t    replacementPattern,\n   298\t  );\n   299\t  return result;\n   300\t}\n   301\t\n   302\tfunction assertPayloadSerialization(\n   303\t  value: unknown,\n   304\t  role: string,\n   305\t  finalPass: boolean,\n   306\t  credentialPattern: RegExp | undefined,\n   307\t): void {\n   308\t  if (!finalPass || role !== \"payload\" || !credentialPattern) return;\n   309\t  const serialized = JSON.stringify(value);\n   310\t  if (serialized !== undefined && credentialPattern.test(serialized)) {\n   311\t    throw new McpFnRedactionLimitError(\n   312\t      \"Credential redaction could not guarantee safe serialized output\",\n   313\t    );\n   314\t  }\n   315\t}\n   316\t\n   317\t/** Remove known opaque credential values as well as credential-shaped fields. */\n   318\texport function redactTargetCredentials<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean; redactionMarker?: string } = {}): T {\n   319\t  const state = targetSecrets.get(target);\n   320\t  return scrubCredentials(value, new Set([...(state?.active.keys() ?? []), ...[...(state?.scopes ?? [])].flatMap((scope) => [...scope])]), options.preserveKeys, options.redactionMarker);\n   321\t}\n   322\t\n   323\t/** Redact authenticated conformance output using the acquired credential. */\n   324\texport function redactRemoteCredential<T>(credential: McpFnRemoteCredential, value: T, options: { preserveKeys?: boolean } = {}): T {\n   325\t  return scrubCredentials(value, credentialValues(credential.headers), options.preserveKeys);\n   326\t}\n   327\t\n   328\tconst MAX_CREDENTIAL_HEADERS = 32;\n   329\tconst MAX_CREDENTIAL_HEADER_BYTES = 16_384;\n   330\tconst MAX_CREDENTIAL_HEADER_VALUE_BYTES = 8_192;\n   390\t/** Create a provider for an already-bounded API key or OAuth-derived token. */\n   391\texport function staticRemoteCredentialProvider(\n   392\t  credential: McpFnRemoteCredential,\n   393\t): McpFnRemoteCredentialProvider {\n   394\t  return { acquire: () => credential };\n   395\t}\n   396\t\n   397\t/** Acquire a credential and return an idempotent revoke-then-dispose lease. */\n   398\texport async function acquireRemoteCredential(\n   399\t  source: McpFnRemoteCredential | McpFnRemoteCredentialProvider,\n   400\t  context: McpFnRemoteCredentialContext,\n   401\t): Promise<McpFnRemoteCredentialLease> {\n   402\t  let provider: McpFnRemoteCredentialProvider;\n   403\t  let acquired: McpFnRemoteCredential;\n   404\t  try {\n   405\t    provider = isCredentialProvider(source) ? source : staticRemoteCredentialProvider(source);\n   406\t    acquired = await provider.acquire(context);\n   407\t  } catch {\n   408\t    // Until acquisition returns, its opaque secrets are unknown to the redactor.\n   409\t    // The provider owns rollback of resources allocated before it rejects.\n   410\t    throw new Error(\"Targ…4121 tokens truncated…re) {\n   112\t    cases.unshift(\n   113\t      `    <testcase name=\"${xml(safe.failure.phase ?? \"target\")}\" classname=\"mcpfn.${xml(safe.failure.layer)}\" time=\"0.000\">${junitFailure(safe.failure.message, safe.failure.code ?? safe.failure.layer)}</testcase>`,\n   114\t    );\n   115\t  }\n   116\t  if (safe.status === \"incomplete\" || omitted > 0 || (!safe.ok && !safe.failure && results.every((result) => result.status === \"passed\"))) {\n   117\t    cases.push(`    <testcase name=\"suite-incomplete\" classname=\"mcpfn.report\" time=\"0.000\">${junitFailure(safe.incompleteReason ?? \"Suite evidence is incomplete or omitted\", \"incomplete\")}</testcase>`);\n   118\t  }\n   119\t  if (cases.length === 0) {\n   120\t    cases.push(\n   121\t      '    <testcase name=\"target-suite\" classname=\"mcpfn.target\" time=\"0.000\"></testcase>',\n   122\t    );\n   123\t  }\n   124\t  const failures = cases.filter((entry) => entry.includes(\"<failure \")).length;\n   125\t  let serialized = junitDocument(safe, cases, failures);\n    70\t  redactionOmittedObservedEvents?: number;\n    71\t  incompleteReason?: string;\n    72\t  failure?: McpFnReportFailure;\n    73\t  timeline: McpFnDiagnosticEvent[];\n    74\t  droppedTimelineEvents: number;\n    75\t  results: McpFnScenarioResult[];\n    76\t}\n    77\t\n    78\tconst suiteCleanupOwners = new WeakMap<Error, { close: () => Promise<void>; pending?: Promise<void> }>();\n    79\t\n    80\tfunction retryTargetSuiteCleanup(error: Error): Promise<void> {\n    81\t  const owner = suiteCleanupOwners.get(error);\n    82\t  if (!owner) return Promise.resolve();\n    83\t  if (owner.pending) return owner.pending;\n    84\t  const pending = Promise.resolve().then(owner.close).then(\n    85\t    () => { suiteCleanupOwners.delete(error); },\n    86\t    () => Promise.reject(error),\n    87\t  ).finally(() => { owner.pending = undefined; });\n    88\t  owner.pending = pending;\n    89\t  return pending;\n    90\t}\n    91\t\n    92\t/** Final cleanup failed. The bounded report is a snapshot; retain this error to retry. */\n    93\texport class McpFnTargetSuiteCleanupError extends Error {\n    94\t  constructor(readonly report: McpFnTargetSuiteReport, close: () => Promise<void>) {\n    95\t    super(\"Target suite cleanup failed; retain this error and retryCleanup()\");\n    96\t    this.name = \"McpFnTargetSuiteCleanupError\";\n    97\t    suiteCleanupOwners.set(this, { close });\n    98\t  }\n    99\t\n   100\t  retryCleanup(): Promise<void> {\n   101\t    return retryTargetSuiteCleanup(this);\n   102\t  }\n   103\t}\n   104\t\n   105\t/** Report serialization failed after cleanup ownership had already transferred. */\n   106\texport class McpFnTargetSuiteArtifactCleanupError extends Error {\n   107\t  constructor(close: () => Promise<void>, cause: Error) {\n   108\t    super(`${cause.message}; retain this error and retryCleanup()`, { cause });\n   109\t    this.name = \"McpFnTargetSuiteArtifactCleanupError\";\n   110\t    suiteCleanupOwners.set(this, { close });\n   111\t  }\n   112\t\n   113\t  retryCleanup(): Promise<void> {\n   114\t    return retryTargetSuiteCleanup(this);\n   115\t  }\n   116\t}\n   117\t\n   118\t/** Runs local, stdio, HTTP, or custom targets through the production session engine. */\n   119\texport async function runMcpFnTargetSuite(\n   120\t  options: RunMcpFnTargetSuiteOptions,\n   121\t): Promise<McpFnTargetSuiteReport> {\n   122\t  const finishRedaction = beginTargetCredentialRedaction(options.target);\n   123\t  try { return await runTargetSuite(options); }\n   124\t  finally { finishRedaction(); }\n   125\t}\n   126\t\n   127\t/** Apply the target-owned scrubber before the bounded generic artifact pass. */\n   128\tfunction redactSuiteArtifact<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean } = {}): T {\n   129\t  const scrubbed = target.redact ? target.redact(value, options) : value;\n   130\t  return redactTargetCredentials(target, scrubbed, options);\n   131\t}\n   132\t\n   133\tfunction compareInventoryNames(left: string, right: string): number {\n   134\t  if (left === right) return 0;\n   135\t  return left < right ? -1 : 1;\n   136\t}\n   137\t\n   138\tfunction reportProjectionFailureReason(\n   139\t  error: unknown,\n   140\t  projectionFailure: \"redaction\" | \"serialization\" | undefined,\n   141\t): string {\n   142\t  if (error instanceof McpFnRedactionLimitError) {\n   143\t    return \"Credential redaction exceeded its traversal budget\";\n   144\t  }\n   145\t  if (projectionFailure === \"redaction\") {\n   146\t    return \"Credential redaction failed; report content omitted because safe serialization failed\";\n   147\t  }\n   148\t  return \"Report content omitted because safe serialization failed\";\n   149\t}\n   150\t\n   151\tclass SuiteDiagnosticCollector {\n   152\t  readonly timeline: McpFnDiagnosticEvent[] = [];\n   153\t  private readonly timelineSizes: number[] = [];\n   154\t  private timelineBytes = 0;\n   155\t  private observedRedactionOmissions = 0;\n   156\t  private initialRedactionOmissions = 0;\n   157\t  dropped = 0;\n   158\t  countExceeded = false;\n   159\t  bytesExceeded = false;\n   160\t  serializationFailed = false;\n   161\t  redactionFailed = false;\n   162\t  cleanupFailure: McpFnReportFailure | undefined;\n   163\t\n   164\t  constructor(\n   165\t    private readonly maxEvents: number,\n   166\t    private readonly maxBytes: number,\n   167\t    private readonly target: McpFnTarget,\n   168\t    private readonly consumer?: (event: McpFnDiagnosticEvent) => void | Promise<void>,\n   169\t  ) {}\n   170\t\n   171\t  captureBaseline(client: McpFnTestClient): void {\n   172\t    this.initialRedactionOmissions = client.session\n   173\t      .getRedactionOmissionCounts().diagnostics;\n   174\t  }\n   175\t\n   176\t  captureUnobserved(client: McpFnTestClient | undefined): void {\n   177\t    const total = client?.session.getRedactionOmissionCounts().diagnostics ??\n   178\t      this.initialRedactionOmissions;\n   179\t    const unobserved = Math.max(\n   180\t      0,\n   181\t      total - this.initialRedactionOmissions - this.observedRedactionOmissions,\n   182\t    );\n   183\t    if (unobserved > 0) {\n   184\t      this.redactionFailed = true;\n   185\t      this.dropped += unobserved;\n   186\t    }\n   187\t  }\n   188\t\n   189\t  async record(client: McpFnTestClient | undefined, event: McpFnDiagnosticEvent): Promise<void> {\n   190\t    if (client?.session.isRedactionOmission(event)) {\n   191\t      this.observedRedactionOmissions += 1;\n   192\t      this.redactionFailed = true;\n   193\t      this.dropped += 1;\n   194\t    }\n   195\t    if ([\"token-revocation\", \"transport-close\"].includes(event.phase) &&\n   196\t        event.outcome === \"failed\") {\n   197\t      this.cleanupFailure ??= normalizeMcpFnReportFailure({\n   198\t        name: \"CleanupError\", message: \"Target cleanup failed\",\n   199\t        code: event.code, phase: event.phase,\n   200\t      });\n   201\t    }\n   202\t    const safeEvent = redactTargetCredentials(this.target, event, { preserveKeys: true });\n   203\t    const bytes = this.serializedBytes(safeEvent);\n   204\t    if (bytes === undefined) {\n   205\t      await this.consumer?.(safeEvent);\n   206\t      return;\n   207\t    }\n   208\t    if (bytes > this.maxBytes) {\n   209\t      this.bytesExceeded = true;\n   210\t      this.dropped += 1;\n   211\t    } else {\n   212\t      this.timeline.push(safeEvent);\n   213\t      this.timelineSizes.push(bytes);\n   214\t      this.timelineBytes += bytes;\n   215\t      this.enforceBounds();\n   216\t    }\n   217\t    await this.consumer?.(safeEvent);\n   218\t  }\n   219\t\n   220\t  private serializedBytes(event: McpFnDiagnosticEvent): number | undefined {\n   221\t    try {\n   222\t      const json = JSON.stringify(event, (_key, value: unknown) => {\n   223\t        if (value === undefined || (typeof value === \"number\" && !Number.isFinite(value))) {\n   224\t          throw new Error(\"Diagnostic contains a non-JSON value\");\n   225\t        }\n   226\t        return value;\n   227\t      });\n   228\t      structuredClone(event);\n   229\t      return Buffer.byteLength(json);\n   230\t    } catch {\n   231\t      this.serializationFailed = true;\n   232\t      this.dropped += 1;\n   233\t      return undefined;\n   234\t    }\n   235\t  }\n   236\t\n   237\t  private enforceBounds(): void {\n   238\t    while (this.timeline.length > this.maxEvents || this.timelineBytes > this.maxBytes) {\n   239\t      this.countExceeded ||= this.timeline.length > this.maxEvents;\n   240\t      this.bytesExceeded ||= this.timelineBytes > this.maxBytes;\n   241\t      this.timeline.shift();\n   242\t      this.timelineBytes -= this.timelineSizes.shift()!;\n   243\t      this.dropped += 1;\n   244\t    }\n   245\t  }\n   246\t}\n   247\t\n   248\tasync function runTargetSuite(options: RunMcpFnTargetSuiteOptions): Promise<McpFnTargetSuiteReport> {\n   249\t  const maxTimelineEvents = options.maxTimelineEvents ?? 500;\n   250\t  if (!Number.isInteger(maxTimelineEvents) || maxTimelineEvents < 1) {\n   300\t      const expected = [...options.expectedToolNames].sort(compareInventoryNames);\n   301\t      if (stableJson(actual) !== stableJson(expected)) {\n   302\t        throw new McpFnAssertionError(`Tool inventory mismatch: expected ${stableJson(expected)}, actual ${stableJson(actual)}`);\n   303\t      }\n   304\t    }\n   305\t    execution = {\n   306\t      results: await runScenarios(\n   307\t        client,\n   308\t        options.scenarios ?? [],\n   309\t        options.scenarioRun,\n   310\t      ),\n   311\t      server: client.session.getServerVersion(),\n   312\t      capabilities: client.session.getServerCapabilities(),\n   313\t    };\n   314\t  } catch (error) {\n   315\t    try {\n   316\t      failure = normalizeMcpFnReportFailure(redactSuiteArtifact(options.target, error, { preserveKeys: true }));\n   317\t    } catch {\n   318\t      // Arbitrary error properties/proxies can throw, including secret-bearing errors.\n   319\t      failure = normalizeMcpFnReportFailure({ name: \"RedactionError\", code: \"MCPFN_REDACTION_FAILED\", message: \"Target failure omitted because credential redaction failed\" });\n   320\t    }\n   321\t  } finally {\n   322\t    try {\n   323\t      // Custom hooks may depend on credentials cleared by close. Capture every\n   324\t      // target-controlled report value while the session still owns that state.\n   325\t      if (client?.session.state === \"connected\") {\n   326\t        let kind: string | undefined;\n   327\t        let descriptor: Omit<McpFnTargetDescriptor, \"kind\"> | undefined;\n   328\t        try {\n   329\t          ({ kind, ...descriptor } = options.target.describe());\n   330\t        } catch { projectionFailure = \"serialization\"; }\n   331\t        if (!projectionFailure) {\n   332\t          try {\n   333\t            capturedTarget = {\n   334\t              ...redactSuiteArtifact(options.target, descriptor!, { preserveKeys: false }),\n   335\t              kind: client.session.preserveArtifactStructure(kind!),\n   336\t            };\n   337\t            capturedManifestHash = options.manifest\n   338\t              ? redactSuiteArtifact(options.target, options.manifest.hash, { preserveKeys: false })\n   339\t              : undefined;\n   340\t            execution = {\n   341\t              server: execution.server === undefined\n   342\t                ? undefined\n   343\t                : redactSuiteArtifact(options.target, execution.server, { preserveKeys: false }),\n   344\t              capabilities: execution.capabilities === undefined\n   345\t                ? undefined\n   346\t                : redactSuiteArtifact(options.target, execution.capabilities, { preserveKeys: false }),\n   347\t              results: execution.results.map(result => ({\n   348\t                ...result,\n   349\t                name: redactSuiteArtifact(options.target, result.name, { preserveKeys: false }),\n   350\t                operation: redactSuiteArtifact(options.target, result.operation, { preserveKeys: false }),\n   351\t                ...(result.tool === undefined ? {} : {\n   352\t                  tool: redactSuiteArtifact(options.target, result.tool, { preserveKeys: false }),\n   353\t                }),\n   354\t              })),\n   355\t            };\n   356\t          } catch { projectionFailure = \"redaction\"; }\n   357\t        }\n   358\t      } else if (execution.results.length || execution.server || execution.capabilities) {\n   359\t        projectionFailure = \"serialization\";\n   360\t      }\n   361\t    } catch { projectionFailure = \"serialization\"; }\n   362\t    try {\n   363\t      await client?.close();\n   364\t    } catch (error) {\n   365\t      const owner = client;\n   366\t      if (error instanceof McpFnTestClientCleanupError) {\n   367\t        retainedCleanup = () => error.retryCleanup();\n   368\t      } else if (owner) {\n   369\t        retainedCleanup = () => owner.close();\n   370\t      }\n   371\t      const terminalCleanupError = error instanceof McpFnTestClientCleanupError && error.cause !== undefined\n   372\t        ? error.cause\n   373\t        : error;\n   374\t      const terminalCleanupPhase = terminalCleanupError && typeof terminalCleanupError === \"object\" &&\n   375\t          (terminalCleanupError as { phase?: unknown }).phase === \"token-revocation\"\n   376\t        ? \"token-revocation\"\n   377\t        : \"transport-close\";\n   378\t      cleanupFailure = normalizeMcpFnReportFailure({\n   379\t        name: \"CleanupError\",\n   380\t        message: \"Target cleanup failed\",\n   381\t        code: \"MCPFN_TARGET_CLEANUP_FAILED\",\n   382\t        phase: terminalCleanupPhase,\n   383\t      });\n   384\t    }\n   385\t    diagnostics.captureUnobserved(client);\n   386\t  }\n   387\t  cleanupFailure ??= diagnostics.cleanupFailure;\n   388\t  failure ??= cleanupFailure;\n   389\t  const results = execution.results;\n   390\t  const failed = results.filter((result) => result.status === \"failed\").length;\n   391\t  const incomplete = results.filter((result) => result.status === \"incomplete\").length;\n   392\t  const droppedObservedEvents = results.reduce(\n   393\t    (total, result) => total + (result.droppedObservedEvents ?? 0),\n   394\t    0,\n   395\t  );\n   396\t  const redactionOmittedObservedEvents = results.reduce(\n   397\t    (total, result) => total + (result.redactionOmittedObservedEvents ?? 0),\n   398\t    0,\n   399\t  );\n   400\t  const overflowedObservedEvents = droppedObservedEvents - redactionOmittedObservedEvents;\n   401\t  const artifactIncomplete = Boolean(failure) || incomplete > 0 ||\n   402\t    diagnostics.dropped > 0 ||\n   403\t    droppedObservedEvents > 0;\n   404\t  const report: McpFnTargetSuiteReport = {\n   405\t    formatVersion: 1,\n   406\t    kind: \"mcpfn.target-suite-report\",\n   407\t    status: artifactIncomplete ? \"incomplete\" : \"complete\",\n   408\t    runtime: {\n   409\t      node: process.version,\n   410\t      scenarioFormatVersion: 1,\n   411\t      reportSchemaVersion: MCPFN_REPORT_SCHEMA_VERSION,\n   412\t      packages: { testing: MCPFN_TESTING_VERSION },\n   413\t    },\n   414\t    ok: failed === 0 && !artifactIncomplete,\n   415\t    target: capturedTarget,\n   416\t    server: execution.server,\n   417\t    capabilities: execution.capabilities,\n   418\t    manifestChecked,\n   419\t    ...(capturedManifestHash === undefined ? {} : { manifestHash: capturedManifestHash }),\n   420\t    total: results.length,\n   421\t    passed: results.length - failed - incomplete,\n   422\t    failed,\n   423\t    incomplete,\n   424\t    droppedResults: 0,\n   425\t    droppedObservedEvents,\n   426\t    ...(redactionOmittedObservedEvents > 0 ? { redactionOmittedObservedEvents } : {}),\n   427\t    ...(failure || diagnostics.dropped > 0 || droppedObservedEvents > 0\n   428\t      ? {\n   429\t        incompleteReason: [\n   430\t          ...(failure ? [`${failure.layer}: ${failure.message}`] : []),\n   431\t          ...(cleanupFailure ? [`Cleanup: ${cleanupFailure.message}`] : []),\n   432\t          ...(diagnostics.serializationFailed ? [\"Diagnostic timeline contained non-JSON data\"] : []),\n   433\t          ...(diagnostics.redactionFailed ? [\"Diagnostic timeline redaction failed; original events omitted\"] : []),\n   434\t          ...(diagnostics.countExceeded ? [\"Diagnostic timeline exceeded maxTimelineEvents\"] : []),\n   435\t          ...(diagnostics.bytesExceeded ? [\"Diagnostic timeline exceeded maxReportBytes\"] : []),\n   436\t          ...(redactionOmittedObservedEvents > 0\n   437\t            ? [\"Observed client events were omitted because credential redaction failed\"]\n   438\t            : []),\n   439\t          ...(overflowedObservedEvents > 0\n   440\t            ? [\"Observed client events exceeded maxObservedEvents\"]\n   441\t            : []),\n   442\t        ].join(\"; \"),\n   443\t      }\n   444\t      : {}),\n   445\t    ...(failure ? { failure } : {}),\n   446\t    timeline: diagnostics.timeline,\n   447\t    droppedTimelineEvents: diagnostics.dropped,\n   448\t    results,\n   449\t  };\n   450\t  let finalized: McpFnTargetSuiteReport;\n   451\t  try {\n   452\t    if (projectionFailure) throw new Error(\"Report payload projection failed\");\n   453\t    // Custom redaction already completed before cleanup. Built-in report scopes\n   454\t    // remain active here for bounded final serialization.\n   455\t    finalized = enforceReportCap(redactTargetCredentials(options.target, report, { preserveKeys: true }), maxReportBytes);\n   456\t  } catch (error) {\n   457\t    if (error instanceof McpFnStructuralCredentialCollisionError) {\n   458\t      const failure = new McpFnClientError(\n   459\t        \"MCPFN_OPERATION_FAILED\",\n   460\t        \"Target report cannot be serialized because a credential conflicts with required artifact structure\",\n   461\t        { phase: \"capability-operation\" },\n   462\t      );\n   463\t      if (retainedCleanup) {\n   464\t        throw new McpFnTargetSuiteArtifactCleanupError(retainedCleanup, failure);\n   465\t      }\n   466\t      throw failure;\n   467\t    }\n   468\t    finalized = enforceReportCap({ ...report, ok: false, status: \"incomplete\",\n   469\t      incompleteReason: reportProjectionFailureReason(error, projectionFailure),\n   470\t      target: { kind: \"custom\" }, server: undefined, capabilities: undefined, manifestHash: undefined,\n   471\t      failure: undefined, results: [], timeline: [],\n   472\t      droppedResults: report.results.length, droppedTimelineEvents: report.droppedTimelineEvents + report.timeline.length,\n   473\t    }, maxReportBytes);\n   474\t  }\n   475\t  if (retainedCleanup) throw new McpFnTargetSuiteCleanupError(finalized, retainedCleanup);\n   476\t  return finalized;\n   477\t}\n   478\t\n   479\tfunction enforceReportCap(\n   480\t  report: McpFnTargetSuiteReport,\n   481\t  maxBytes: number,\n   482\t): McpFnTargetSuiteReport {\n   483\t  validateReportCap(maxBytes);\n   484\t  const bounded = structuredClone(report);\n   485\t  if (jsonBytes(bounded) > maxBytes) {\n   486\t    bounded.ok = false;\n   487\t    bounded.status = \"incomplete\";\n   488\t    bounded.incompleteReason = \"Report content exceeded maxReportBytes and was truncated\";\n   489\t  }\n   490\t  while (jsonBytes(bounded) > maxBytes && bounded.results.length > 0) {\n   491\t    bounded.results.pop();\n   492\t    bounded.droppedResults += 1;\n   493\t  }\n   494\t  if (jsonBytes(bounded) > maxBytes) {\n   495\t    bounded.target = { kind: report.target.kind };\n   496\t    bounded.server = undefined;\n   497\t    bounded.capabilities = undefined;\n   498\t    bounded.timeline = [];\n   499\t    bounded.droppedTimelineEvents += report.timeline.length;\n   500\t    if (bounded.failure) {\n   501\t      bounded.failure.details = undefined;\n   502\t      bounded.failure.message = \"Target operation failed; details omitted to fit report budget\";\n   503\t    }\n   504\t  }\n   505\t  if (bounded.droppedResults > 0 || jsonBytes(bounded) > maxBytes) {\n   506\t    bounded.ok = false;\n   507\t    bounded.status = \"incomplete\";\n   508\t    bounded.incompleteReason = \"Report content exceeded maxReportBytes and was truncated\";\n   509\t  }\n   510\t  if (jsonBytes(bounded) > maxBytes) {\n   511\t    throw new Error(\"The minimum target suite report exceeds maxReportBytes\");\n   512\t  }\n   513\t  return bounded;\n   514\t}\n   515\t\n   516\tfunction validateReportCap(maxBytes: number): void {\n   517\t  if (!Number.isInteger(maxBytes) || maxBytes < 1_024) {\n   518\t    throw new Error(\"maxReportBytes must be an integer of at least 1024\");\n   519\t  }\n   520\t}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0b91a-027b-7173-bd75-a52040008bc7","create_time":1789812899.196398}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
