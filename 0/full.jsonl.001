element === document.activeElement));\n await page.getByRole('button', { name: 'Close search', exact: true }).click();\n await page.goto(origin + '/docs/__pr213_missing__'); await page.waitForLoadState('networkidle'); assert((await page.title()).includes('404')); assert.deepEqual(errors, []);\n console.log(JSON.stringify({ tree, context, actualCompiledExtFn: true, realHydratedLandingToDocs: true, normalTitle: title, singleSsrTitle: true, actualSearch200WithResults: true, mobileDrawerOpensAndCloses: true, unforcedExposedBackdropHit: true, keyboardSearchFocus: true, missingHydratedTitle: await page.title(), reducedMotionContext: true, errors, qualification: 'Private loopback actual consumer compiled HTTP/hydration. Browser driver only from tooling owner; no application dependency borrowed. No live host, OS IME, platform-wide or observer lifecycle claim.' }));\n} finally { if (browser) await browser.close(); await new Promise(resolve => local.close(resolve)); }\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":390,"output":1796,"cacheRead":236416,"cacheWrite":0,"reasoning":135,"totalTokens":238602,"cost":{"input":0.00078,"output":0.01796,"cacheRead":0.023641600000000002,"cacheWrite":0,"total":0.042381600000000005}},"stopReason":"toolUse","timestamp":1791352216151,"responseId":"resp_055fb762f51dfcfc016ac5dd99698087d0872ce0b2d62bbbf1","rawStopReason":"completed","thinkingLevel":"high"}}
