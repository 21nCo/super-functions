athlib.Path(ad['candidate']);S=pathlib.Path(json.loads((A/'standalone212-source-admission.json').read_text())['physicalRoot']);paths=ad['paths'];env=os.environ.copy();env.update({'npm_config_cache':paths['cache'],'TMPDIR':paths['tmp']+'/','npm_config_devdir':paths['devdir'],'XDG_CACHE_HOME':paths['xdg']})\nfor name in ['CLOUDFLARE_DOCS_DEPLOY','CLOUDFLARE_DOCS_PUBLIC_ORIGIN','CLOUDFLARE_DOCS_ASSETS_ORIGIN']:env.pop(name,None)\narchive=A/'producer-env-temporary-static-preimages.tar.gz';assert not archive.exists();pre={};results=[]\nsha=lambda b:hashlib.sha256(b).hexdigest()\nwith tarfile.open(archive,'w:gz') as tar:\n for context,tree in [('root',V),('standalone',S)]:\n  for product in ['devfn','authfn','filefn']:\n   for name in ['llms.txt','llms-full.txt']:\n    f=tree/product/'docs/static'/name;b=f.read_bytes();mode=stat.S_IMODE(f.stat().st_mode);key=context+'/'+product+'/'+name;pre[key]=(b,mode);i=tarfile.TarInfo(key);i.size=len(b);i.mode=mode;tar.addfile(i,io.BytesIO(b))\nwith tarfile.open(archive,'r:gz') as tar:\n assert len(tar.getmembers())==12\n for m in tar.getmembers():assert tar.extractfile(m).read()==pre[m.name][0] and m.mode==pre[m.name][1]\ndef run(label,cwd,args,caseEnv):\n log=A/(label+'.log');assert not log.exists();r=subprocess.run(args,cwd=cwd,env=caseEnv,stdout=subprocess.PIPE,stderr=subprocess.STDOUT);log.write_bytes(r.stdout);assert r.returncode==0,(label,r.returncode);return r.stdout\ntry:\n for context,tree in [('root',V),('standalone',S)]:\n  for product in ['devfn','authfn','filefn']:\n   cwd=tree/product/'docs';prefix=f'producer212-{context}-{product}'\n   assets={**env,'CLOUDFLARE_DOCS_DEPLOY':'1','CLOUDFLARE_DOCS_ASSETS_ORIGIN':'https://cdn.invalid'}\n   run(prefix+'-assets-only-check',cwd,['node','scripts/generate-llms.mjs','--check'],assets)\n   explicit={**assets,'CLOUDFLARE_DOCS_PUBLIC_ORIGIN':'https://public.invalid'}\n   config=run(prefix+'-native-public-config',cwd,['node','--input-type=module','--eval','import {loadDocsConfig} from \"@docsfn/core\"; console.log(JSON.stringify((await loadDocsConfig({cwd:process.cwd()})).site.canonicalUrl));'],explicit);assert json.loads(config)=='https://public.invalid'\n   try:\n    run(prefix+'-actual-public-producer',cwd,['node','scripts/generate-llms.mjs'],explicit)\n    text=(cwd/'static/llms.txt').read_text();assert ']('+'https://public.invalid/docs' in text and 'https://cdn.invalid' not in text\n    assert '/docs/docs/' not in text\n    generated={name:sha((cwd/'static'/name).read_bytes()) for name in ['llms.txt','llms-full.txt']}\n   finally:\n    for name in ['llms.txt','llms-full.txt']:\n     b,mode=pre[context+'/'+product+'/'+name];f=cwd/'static'/name;f.write_bytes(b);f.chmod(mode);assert sha(f.read_bytes())==sha(b)\n   nondeploy={**env,'CLOUDFLARE_DOCS_PUBLIC_ORIGIN':'https://public.invalid','CLOUDFLARE_DOCS_ASSETS_ORIGIN':'https://cdn.invalid'}\n   run(prefix+'-nondeployment-public-ignored-check',cwd,['node','scripts/generate-llms.mjs','--check'],nondeploy)\n   results.append({'context':context,'product':product,'assetsOnlyEqualsNormal':True,'actualNativeConfigPublicOrigin':'https://public.invalid','actualCliPublicLinksNotAssets':True,'nondeploymentPublicIgnored':True,'temporarilyGeneratedHashes':generated,'staticBytesAndModesRestored':True})\nfinally:\n (A/'executing-producer-origin-matrix.json').write_text(json.dumps({'results':results,'staticArchiveVerifiedBeforeWriter':True,'sourceFilesMutated':False,'qualification':'Actual consumer-owned SDK config/normal CLI producer in separate processes; no live hosting; temporarily emitted static outputs restored exact preimages. Native offline/public Worker and final capture still separate gates.'},indent=2)+'\\n')\nprint('All6 executing owner config/CLI public-versus-assets/normal branches pass; exact static preimages restored.')\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":2113,"output":7047,"cacheRead":181760,"cacheWrite":0,"reasoning":5826,"totalTokens":190920,"cost":{"input":0.004226,"output":0.07047,"cacheRead":0.018176,"cacheWrite":0,"total":0.092872}},"stopReason":"toolUse","timestamp":1791227328905,"responseId":"resp_055fb762f51dfcfc016ac3f5c18a3487d092783aec4456b5bf","rawStopReason":"completed","thinkingLevel":"high"}}
