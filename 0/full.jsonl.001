{"timestamp":"2026-09-19T12:19:02.545Z","ordinal":5276,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b3f5-d570-7a72-b668-401efd539e3b","turn_id":"01a0b992-9248-7613-95d3-df05acb573b9","item":{"type":"CommandExecution","id":"exec-854cb6b5-1fbd-485b-83dc-bc28e1fd3a8b","process_id":"24072","command":["/bin/zsh","-lc","nl -ba mcpfn/inspector/tests/authenticated-artifacts.test.ts | sed -n '210,370p'"],"cwd":"file:///Users/serro/Documents/dev/n/worktrees/superfunctions/PR-170","parsed_cmd":[{"type":"read","cmd":"nl -ba mcpfn/inspector/tests/authenticated-artifacts.test.ts | sed -n '210,370p'","name":"authenticated-artifacts.test.ts","path":"mcpfn/inspector/tests/authenticated-artifacts.test.ts"}],"source":"unified_exec_startup","status":"completed","stdout":"   210\t  try {\n   211\t    await client.connect();\n   212\t    await client.tools.call(\"identity\", {});\n   213\t    expect(events.some(event => event.kind === \"logging.message\")).toBe(false);\n   214\t    expect(events.some(event => client.isRedactionOmission(event))).toBe(true);\n   215\t    expect(JSON.stringify(events)).not.toContain(\"logging.message\");\n   216\t  } finally { try { await client.close(); } finally { await fixture.close(); } }\n   217\t});\n   218\t\n   219\tit.each([\"tools.call\", \"non-idempotent\", \"none\"])(\"fails closed when an exported scenario discriminator matches %s\", secret => {\n   220\t  const client = new McpFnClient({ target: customTarget({ kind: \"custom\", open: async () => { throw new Error(\"unused\"); },\n   221\t    redact: <T>(value: T): T => JSON.parse(JSON.stringify(value).replaceAll(secret, \"[REDACTED]\")),\n   222\t  }) });\n   223\t  const inspector = new McpFnInspector(client);\n   224\t  expect(() => secret === \"none\"\n   225\t    ? inspector.exportScenario(secret, { kind: \"resources.read\", uri: \"test://resource\" }, { contents: [] })\n   226\t    : inspector.exportScenario(secret, { kind: \"tools.call\", name: \"echo\" }, { content: [] }))\n   227\t    .toThrow(\"MCP artifact structure conflicts with credential redaction\");\n   228\t});\n   229\t\n   230\tit(\"fails closed when a credential matches an exported scenario key\", () => {\n   231\t  const secret = \"name\";\n   232\t  const client = new McpFnClient({\n   233\t    target: customTarget({\n   234\t      kind: \"custom\",\n   235\t      open: async () => { throw new Error(\"unused\"); },\n   236\t      redact: <T>(value: T): T => JSON.parse(\n   237\t        JSON.stringify(value).replaceAll(secret, \"[REDACTED]\"),\n   238\t      ) as T,\n   239\t    }),\n   240\t  });\n   241\t  const inspector = new McpFnInspector(client);\n   242\t  expect(() => inspector.exportScenario(\n   243\t    \"reflection\",\n   244\t    { kind: \"tools.call\", name: \"echo\" },\n   245\t    { content: [] },\n   246\t  )).toThrow(\"MCP artifact structure conflicts with credential redaction\");\n   247\t});\n   248\t\n   249\tit(\"declares placeholders introduced in redacted property keys\", () => {\n   250\t  const secret = \"opaque-property-key\";\n   251\t  const target = customTarget({\n   252\t    kind: \"custom\",\n   253\t    open: async () => { throw new Error(\"unused\"); },\n   254\t    redact: <T>(value: T, options): T => JSON.parse(\n   255\t      JSON.stringify(value).replaceAll(secret, options?.redactionMarker ?? \"[REDACTED]\"),\n   256\t    ) as T,\n   257\t  });\n   258\t  const inspector = new McpFnInspector(new McpFnClient({ target }));\n   259\t  const scenario = inspector.exportScenario(\n   260\t    \"redacted key\",\n   261\t    { kind: \"tools.call\", name: \"echo\", arguments: { [secret]: \"value\" } },\n   262\t    { content: [], structuredContent: { [secret]: \"value\" } },\n   263\t  );\n   264\t  expect(scenario.variables).toEqual([\"MCPFN_SECRET\"]);\n   265\t  expect(scenario.arguments).toEqual({ \"${MCPFN_SECRET}\": \"${MCPFN_SECRET}\" });\n   266\t  expect(scenario.expect?.structuredContent).toEqual({\n   267\t    \"${MCPFN_SECRET}\": \"${MCPFN_SECRET}\",\n   268\t  });\n   269\t});\n   270\t\n   271\tit(\"selects a replayable placeholder when the preferred marker contains the credential\", () => {\n   272\t  const secret = \"MCPFN\";\n   273\t  const target = customTarget({\n   274\t    kind: \"custom\",\n   275\t    open: async () => { throw new Error(\"unused\"); },\n   276\t    redact: <T>(value: T, options): T => JSON.parse(\n   277\t      JSON.stringify(value).replaceAll(secret, options?.redactionMarker ?? \"[REDACTED]\"),\n   278\t    ) as T,\n   279\t  });\n   280\t  const inspector = new McpFnInspector(new McpFnClient({ target }));\n   281\t  const scenario = inspector.exportScenario(\n   282\t    \"redacted key\",\n   283\t    { kind: \"tools.call\", name: \"echo\", arguments: { [secret]: \"value\" } },\n   284\t    { content: [] },\n   285\t  );\n   286\t  expect(scenario.variables).toEqual([\"SECRET\"]);\n   287\t  expect(scenario.arguments).toEqual({ \"${SECRET}\": \"${SECRET}\" });\n   288\t});\n   289\t\n   290\tit(\"marks an export incomplete when credential redaction collapses payload keys\", async () => {\n   291\t  const secret = \"opaque-secret\";\n   292\t  const fixture = await startAuthenticatedServer(secret);\n   293\t  const client = new McpFnClient({\n   294\t    target: authenticatedHttpTarget(fixture.url, {\n   295\t      credential: { headers: { authorization: `Bearer ${secret}` } },\n   296\t    }),\n   297\t  });\n   298\t  const inspector = new McpFnInspector(client);\n   299\t  try {\n   300\t    await inspector.connect();\n   301\t    const scenario = inspector.exportScenario(\n   302\t      \"colliding keys\",\n   303\t      {\n   304\t        kind: \"tools.call\",\n   305\t        name: \"echo\",\n   306\t        arguments: { [secret]: 1, \"${MCPFN_SECRET}\": 2 },\n   307\t      },\n   308\t      { content: [] },\n   309\t    );\n   310\t    expect(scenario).toMatchObject({\n   311\t      kind: \"tools.call\",\n   312\t      status: \"incomplete\