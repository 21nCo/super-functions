": \"REDACTED\",\n      \"rule\": \"typescript:S3696\",\n      \"severity\": \"MAJOR\",\n      \"type\": \"CODE_SMELL\",\n      \"component\": \"21nCo_super-functions:mcpfn/cli/src/index.ts\",\n      \"line\": 84,\n      \"message\": \"Expected an error object to be thrown.\",\n      \"status\": \"OPEN\",\n      \"creationDate\": \"2026-09-18T11:12:20+0000\",\n      \"updateDate\": \"2026-09-18T11:12:49+0000\",\n      \"cleanCodeAttribute\": \"CONVENTIONAL\"\n    },\n    {\n      \"key\": \"REDACTED\",\n      \"rule\": \"typescript:S3358\",\n      \"severity\": \"MAJOR\",\n      \"type\": \"CODE_SMELL\",\n      \"component\": \"21nCo_super-functions:mcpfn/testing/src/remote-target.ts\",\n      \"line\": 278,\n      \"message\": \"Extract this nested ternary operation into an independent statement.\",\n      \"status\": \"OPEN\",\n      \"creationDate\": \"2026-09-15T14:00:13+0000\",\n      \"updateDate\": \"2026-09-15T14:00:43+0000\",\n      \"cleanCodeAttribute\": \"CLEAR\"\n    },\n    {\n      \"key\": \"REDACTED\",\n      \"rule\": \"typescript:S3696\",\n      \"severity\": \"MAJOR\",\n      \"type\": \"CODE_SMELL\",\n      \"component\": \"21nCo_super-functions:mcpfn/testing/src/client.ts\",\n      \"line\": 62,\n      \"message\": \"Expected an error object to be thrown.\",\n      \"status\": \"OPEN\",\n      \"creationDate\": \"2026-09-15T11:24:47+0000\",\n      \"updateDate\": \"2026-09-15T11:26:07+0000\",\n      \"cleanCodeAttribute\": \"CONVENTIONAL\"\n    },\n    {\n      \"key\": \"REDACTED\",\n      \"rule\": \"typescript:S3776\",\n      \"severity\": \"CRITICAL\",\n      \"type\": \"CODE_SMELL\",\n      \"component\": \"21nCo_super-functions:mcpfn/testing/src/remote-target.ts\",\n      \"line\": 249,\n      \"message\": \"Refactor this function to reduce its Cognitive Complexity from 43 to the 15 allowed.\",\n      \"status\": \"OPEN\",\n      \"creationDate\": \"2026-09-15T06:58:17+0000\",\n      \"updateDate\": \"2026-09-19T10:20:44+0000\",\n      \"