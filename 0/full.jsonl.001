 += 1;\\n+    if (!authorizationParameterName.test(name) || token[cursor] !== \\\"=\\\") {\\n+      throw new TypeError(\\\"Authorization credential parameters must use name=value syntax\\\");\\n+    }\\n+    cursor += 1;\\n+    while (token[cursor] === \\\" \\\" || token[cursor] === \\\"\\\\t\\\") cursor += 1;\\n+    if (cursor >= token.length) {\\n+      throw new TypeError(\\\"Authorization credential parameters must contain values\\\");\\n+    }\\n+    if (token[cursor] === '\\\"') {\\n+      const rawStart = cursor;\\n+      let decoded = \\\"\\\";\\n+      let closed = false;\\n+      cursor += 1;\\n+      while (cursor < token.length) {\\n+        const character = token[cursor];\\n+        if (character === \\\"\\\\\\\\\\\") {\\n+          cursor += 1;\\n+          if (cursor >= token.length) {\\n+            throw new TypeError(\\\"Authorization credential parameters must use balanced quotes\\\");\\n+          }\\n+          decoded += token[cursor];\\n+          cursor += 1;\\n+        } else if (character === '\\\"') {\\n+          cursor += 1;\\n+          closed = true;\\n+          break;\\n+        } else {\\n+          decoded += character;\\n+          cursor += 1;\\n+        }\\n+      }\\n+      if (!closed) {\\n+        throw new TypeError(\\\"Authorization credential parameters must use balanced quotes\\\");\\n+      }\\n+      components.add(token.slice(rawStart, cursor));\\n+      if (decoded) components.add(decoded);\\n+      while (token[cursor] === \\\" \\\" || token[cursor] === \\\"\\\\t\\\") cursor += 1;\\n+    } else {\\n+      const valueStart = cursor;\\n+      while (cursor < token.length && token[cursor] !== \\\",\\\") cursor += 1;\\n+      const value = token.slice(valueStart, cursor).trim();\\n+      if (!value || /\\\\s/.test(value) || value.includes('\\\"')) {\\n+        throw new TypeError(\\\"Authorization credential parameters must contain valid values\\\");\\n+      }\\n+      components.add(value);\\n+    }\\n+    if (cursor === token.length) break;\\n+    if (token[cursor] !== \\\",\\\") {\\n+      throw new TypeError(\\\"Authorization credential parameters must be comma separated\\\");\\n+    }\\n+    cursor += 1;\\n+    if (!token.slice(cursor).trim()) {\\n+      throw new TypeError(\\\"Authorization credential parameters must not end with a comma\\\");\\n+    }\\n+  }\\n+  for (const component of components) secrets.add(component);\\n+}\\n@@\\n-      const scrubbedEntry = typeof entry === \\\"string\\\"\\n-        ? scrub(entry, fixed ? role : \\\"payload\\\", key, finalPass)\\n+      const entryRole = fixed ? role : \\\"payload\\\";\\n+      const scrubbedEntry = typeof entry === \\\"string\\\"\\n+        ? scrub(entry, entryRole, key, finalPass)\\n         : scrub(entry, childRole, \\\"\\\", finalPass);\\n*** Update File: /Users/serro/Documents/dev/n/worktrees/superfunctions/PR-170/mcpfn/testing/src/suite.ts\\n@@\\n function captureSuiteStructureGuard(\\n   target: McpFnTarget,\\n   projection: SuiteProjection,\\n   diagnostics: SuiteDiagnosticCollector,\\n+  failure: McpFnReportFailure | undefined,\\n ): SuiteStructureGuard {\\n@@\\n     projection.target.kind,\\n   ]);\\n+  if (failure?.phase) candidates.add(failure.phase);\\n@@\\n-  let projection: SuiteProjection = {\\n-    target: { kind: \\\"custom\\\" },\\n-    execution: connection.execution,\\n-    failure: \\\"serialization\\\",\\n-  };\\n-  let structureGuard: SuiteStructureGuard = {\\n-    assert: () => { throw new McpFnStructuralCredentialCollisionError(); },\\n-  };\\n+  let projection: SuiteProjection;\\n+  let structureGuard: SuiteStructureGuard;\\n   let closeResult: Awaited<ReturnType<typeof closeSuiteClient>> = {};\\n   try {\\n     projection = projectSuiteArtifacts(options, connection.client, connection.execution);\\n-    structureGuard = captureSuiteStructureGuard(options.target, projection, diagnostics);\\n+    structureGuard = captureSuiteStructureGuard(\\n+      options.target,\\n+      projection,\\n+   