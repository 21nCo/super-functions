lias substitution; only HMR disabled for independent local ownership. Native compiled/preview/browser receipts separate.'}));\n }finally{if(server)await server.close();process.chdir(original);}\n}\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":1252,"output":1713,"cacheRead":121216,"cacheWrite":0,"reasoning":1176,"totalTokens":124181,"cost":{"input":0.0025039999999999997,"output":0.017130000000000003,"cacheRead":0.012121600000000001,"cacheWrite":0,"total":0.0317556}},"stopReason":"toolUse","timestamp":1791225091211,"responseId":"resp_055fb762f51dfcfc016ac3ed03c76887d09409cd8fdd8ceaf7","rawStopReason":"completed","thinkingLevel":"high"}}
