super-functions&issues=AaDs_JGvxLbHKQqZ6KpX&open=AaDs_JGvxLbHKQqZ6KpX&pullRequest=213\",\n    \"raw_details\": null\n  },\n  {\n    \"path\": \"authfn/docs/src/routes/docs/[...slug]/+page.server.ts\",\n    \"blob_href\": \"https://github.com/21nCo/super-functions/blob/f15540d26c2329203c626ccb51eb9108c5bebd84/authfn/docs/src/routes/docs/[...slug]/+page.server.ts\",\n    \"start_line\": 2,\n    \"start_column\": null,\n    \"end_line\": 2,\n    \"end_column\": null,\n    \"annotation_level\": \"warning\",\n    \"title\": \"Remove this unused import of 'loadDocsSiteSource'.\",\n    \"message\": \"\\nSee more on https://sonarcloud.io/project/issues?id=21nCo_super-functions&issues=AaDufIUr910iNu5YU-eW&open=AaDufIUr910iNu5YU-eW&pullRequest=213\",\n    \"raw_details\": null\n  },\n  {\n    \"path\": \"scripts/docs-site/runtime.ts\",\n    \"blob_href\": \"https://github.com/21nCo/super-functions/blob/f15540d26c2329203c626ccb51eb9108c5bebd84/scripts/docs-site/runtime.ts\",\n    \"start_line\": 293,\n    \"start_column\": null,\n    \"end_line\": 293,\n    \"end_column\": null,\n    \"annotation_level\": \"warning\",\n    \"title\": \"Async method 'loadEntry' has no 'await' expression.\",\n    \"message\": \"\\nSee more on https://sonarcloud.io/project/issues?id=21nCo_super-functions&issues=AaDufIdl910iNu5YU-eY&open=AaDufIdl910iNu5YU-eY&pullRequest=213\",\n    \"raw_details\": null\n  }\n]\n"}],"isError":false,"timestamp":1791348218851}}
