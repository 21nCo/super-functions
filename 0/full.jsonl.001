t({ target, events: event => { events.push(event); } });\n  const inspector = new McpFnInspector(client);\n  const emitEvent = (client as unknown as {\n    emitEvent(kind: \"logging.message\", payload: unknown): Promise<void>;\n  }).emitEvent.bind(client);\n  await emitEvent(\"logging.message\", { status: \"passed\" });\n  expect(events[0].kind).toBe(\"logging.message\");\n  expect(events[0].payload.status).toBe(\"[REDACTED]\");\n  throwOnPayload = true;\n  await emitEvent(\"logging.message\", { status: \"passed\" });\n  expect(events[1].payload).toMatchObject({ omitted: true });\n  expect(client.isRedactionOmission(events[1])).toBe(true);\n  const snapshot = await inspector.snapshot();\n  expect(snapshot.timelineComplete).toBe(false);\n  expect(snapshot.droppedEvents).toBe(1);\n});\n\nit(\"reconstructs diagnostic discriminators around payload redaction\", async () => {\n  const observed: any[] = [];\nmcpfn/testing/tests/host-authorization.test.ts:14:  \"cache-control\": \"no-store\",\nmcpfn/testing/tests/host-authorization.test.ts:15:  pragma: \"no-cache\",\nmcpfn/testing/tests/host-authorization.test.ts:245:  [\"token-exchange\", \"cache-control\"],\nmcpfn/testing/tests/host-authorization.test.ts:246:  [\"token-exchange\", \"pragma\"],\nmcpfn/testing/tests/host-authorization.test.ts:247:  [\"token-refresh\", \"cache-control\"],\nmcpfn/testing/tests/host-authorization.test.ts:248:  [\"token-refresh\", \"pragma\"],\nmcpfn/testing/tests/suite.test.ts:310:  const first = error.retryCleanup();\nmcpfn/testing/tests/suite.test.ts:311:  expect(error.retryCleanup()).toBe(first);\nmcpfn/testing/tests/suite.test.ts:314:  await Promise.all([error.retryCleanup(), error.retryCleanup()]);\nmcpfn/testing/tests/suite.test.ts:316:  await error.retryCleanup();\nmcpfn/cli/tests/cli.test.ts:317:      await expect(failure.retryCleanup()).resolves.toBeUndefined();\nmcpfn/cli/tests/inspect-redaction.test.ts:79:    await expect(failure.retryCleanup()).resolves.toBeUndefined();\nmcpfn/test