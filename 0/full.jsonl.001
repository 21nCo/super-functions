{"type":"message","id":"6c360f00","parentId":"b62979c2","timestamp":"2026-10-06T11:26:49.672Z","message":{"role":"toolResult","toolCallId":"call_IFQpZ2pIq1ftlLh0pBVRW8Ca|fc_055fb762f51dfcfc016ac4daf87a6087d0b7459669ae6956ab","toolName":"read","content":[{"type":"text","text":" \n How filefn returns signed download URLs, proxies download bytes, and handles version-targeted downloads.\n@@ -4120,7 +4123,7 @@\n \n # Grants\n \n-Source: https://filefn.superfunctions.dev/docs/features/grants\n+Source: https://filefn.com/docs/features/grants\n \n \n Per-user / per-tenant permission grants — read, write, delete, share — with TTLs.\n@@ -4216,7 +4219,7 @@\n \n # HEIC preprocessing\n \n-Source: https://filefn.superfunctions.dev/docs/features/heic\n+Source: https://filefn.com/docs/features/heic\n \n \n Automatic HEIC → JPEG conversion in @filefn/client and FileFnSwift.\n@@ -4308,7 +4311,7 @@\n \n # Offline\n \n-Source: https://filefn.superfunctions.dev/docs/features/offline\n+Source: https://filefn.com/docs/features/offline\n \n \n OPFS-staged offline uploads, automatic resume on reconnect, and pending-local previews.\n@@ -4439,7 +4442,7 @@\n \n # Policies\n \n-Source: https://filefn.superfunctions.dev/docs/features/policies\n+Source: https://filefn.com/docs/features/policies\n \n \n Named upload contracts that gate content type, size, visibility, storage target, and storage path layout.\n@@ -4532,7 +4535,7 @@\n \n # Processing\n \n-Source: https://filefn.superfunctions.dev/docs/features/processing\n+Source: https://filefn.com/docs/features/processing\n \n \n The filefn processing pipeline — thumbnails, PDF previews, OCR, image transforms, audio waveforms, video posters — with composable processors and stable artifacts.\n@@ -4690,7 +4693,7 @@\n \n # Quota\n \n-Source: https://filefn.superfunctions.dev/docs/features/quota\n+Source: https://filefn.com/docs/features/quota\n \n \n Pluggable storage quotas — per-user, per-tenant, or any custom dimension.\n@@ -4782,7 +4785,7 @@\n \n # Rate limiting\n \n-Source: https://filefn.superfunctions.dev/docs/features/rate-limiting\n+Source: https://filefn.com/docs/features/rate-limiting\n \n \n Per-route rate limiting on upload-init, sign, complete, download, share-download, and artifact-download.\n@@ -4798,9 +4801,10 @@\n import { createFileFn } from \"@filefn/server\";\n \n const fileFn = createFileFn({\n-  db, storage,\n+  database: db, storage,\n+  stores: { atomicKv: redisAtomicStore },\n   rateLimit: {\n-    persistence: redisPersistence, // optional; in-memory by default\n+    mode: \"strict\",\n     algorithm: \"sliding-window\",\n     limits: {\n       uploadInit:        { windowSeconds: 60, maxRequests: 10 },\n@@ -4818,7 +4822,11 @@\n \n `rateLimit.algorithm` is one of `\"fixed-window\" | \"sliding-window\" | \"token-bucket\"`.\n \n-`rateLimit.persistence` plugs in a shared store (Redis / Postgres / KV) so multi-instance deployments share counters.\n+`rateLimit.mode: \"strict\"` uses CAS-capable `stores.atomicKv` for shared counters.\n+Use `\"best-effort\"` with `stores.kv` when approximate cross-replica limits are\n+acceptable, or `\"local\"` for in-process counters. Without an explicit mode,\n+FileFn selects strict for `atomicKv`, best-effort for `kv`, otherwise local.\n+The former `rateLimit.persistence` option was removed in 0.2.0.\n \n ## Pre-built rate limiter\n \n@@ -4852,7 +4860,7 @@\n \n # Share links\n \n-Source: https://filefn.superfunctions.dev/docs/features/share-links\n+Source: https://filefn.com/docs/features/share-links\n \n \n Opt-in tokenised, optionally auth-required, optionally download-capped public links to files.\n@@ -4917,7 +4925,7 @@\n \n # Uploads\n \n-Source: https://filefn.superfunctions.dev/docs/features/uploads\n+Source: https://filefn.com/docs/features/uploads\n \n \n Multipart upload sessions with signed-URL or proxy modes, idempotency, anonymous tokens, and automatic recovery.\n@@ -5030,7 +5038,7 @@\n \n # Versions\n \n-Source: https://filefn.superfunctions.dev/docs/features/versions\n+Source: https://filefn.com/docs/features/versions\n \n \n Every successful filefn upload becomes a new fileVersions row — list, target, download, and roll back.\n@@ -5118,7 +5126,7 @@\n \n # Frameworks\n \n-Source: https://filefn.superfunctions.dev/docs/frameworks\n+Source: https://filefn.com/docs/frameworks\n \n \n Production wiring for filefn behind every major web framework — Hono, Express, Bun, SvelteKit, Next.js, FastAPI, Flask.\n@@ -5145,7 +5153,7 @@\n \n # Bun\n \n-Source: https://filefn.superfunctions.dev/docs/frameworks/bun\n+Source: https://filefn.com/docs/frameworks/bun\n \n \n Native Bun.serve integration — fastest start-up, native multipart streaming, and zero-cold-start production deployments.\n@@ -5224,7 +5232,7 @@\n \n # Express\n \n-Source: https://filefn.superfunctions.dev/docs/frameworks/express\n+Source: https://filefn.com/docs/frameworks/express\n \n \n Production-grade Express integration for filefn — Web Request bridging, body streaming for proxy uploads, CSRF, and rate limiting.\n@@ -5290,7 +5298,7 @@\n \n # FastAPI\n \n-Source: https://filefn.superfunctions.dev/docs/frameworks/fastapi\n+Source: https://filefn.com/docs/frameworks/fastapi\n \n \n Production-grade FastAPI integration — Starlette request bridging, async session resolvers, and reverse-proxy guidance.\n@@ -5404,7 +5412,7 @@\n \n # Flask\n \n-Source: https://filefn.superfunctions.dev/docs/frameworks/flask\n+Source: https://filefn.com/docs/frameworks/flask\n \n \n Production-grade Flask integration — WSGI request bridging, async filefn calls via run_async, and reverse-proxy guidance.\n@@ -5482,7 +5490,7 @@\n \n # Hono\n \n-Source: https://filefn.superfunctions.dev/docs/frameworks/hono\n+Source: https://filefn.com/docs/frameworks/hono\n \n \n Production-grade Hono integration for filefn — CORS, CSRF for proxy uploads, rate limiting, observability, and graceful 404 fallthrough.\n@@ -5600,7 +5608,7 @@\n \n # Next.js\n \n-Source: https://filefn.superfunctions.dev/docs/frameworks/nextjs\n+Source: https://filefn.com/docs/frameworks/nextjs\n \n \n Production-grade Next.js integration — App Router catch-all route, edge-vs-Node runtime tradeoffs, server actions for upload init.\n@@ -5740,7 +5748,7 @@\n \n # SvelteKit\n \n-Source: https://filefn.superfunctions.dev/docs/frameworks/sveltekit\n+Source: https://filefn.com/docs/frameworks/sveltekit\n \n \n Production-grade SvelteKit integration — server-side filefn, client-side @filefn/client, hooks-based session forwarding, and RPC-style file APIs.\n@@ -5879,7 +5887,7 @@\n \n # Getting Started\n \n-Source: https://filefn.superfunctions.dev/docs/getting-started\n+Source: https://filefn.com/docs/getting-started\n \n \n Install filefn, mount it on Hono, configure a storage policy, and upload your first file end to end in 15 minutes.\n@@ -6087,7 +6095,7 @@\n \n # Quickstart\n \n-Source: https://filefn.superfunctions.dev/docs/quickstart\n+Source: https://filefn.com/docs/quickstart\n \n \n Per-framework setup walkthroughs for filefn — Node + Hono, Express, Bun, SvelteKit, Next.js App Router, Python + FastAPI, Python + Flask, and Swift on iOS.\n@@ -6127,7 +6135,7 @@\n \n # Bun Quickstart\n \n-Source: https://filefn.superfunctions.dev/docs/quickstart/bun\n+Source: https://filefn.com/docs/quickstart/bun\n \n \n Run @filefn/server on Bun.serve with native Fetch Request / Response.\n@@ -6192,7 +6200,7 @@\n \n # Express Quickstart\n \n-Source: https://filefn.superfunctions.dev/docs/quickstart/express\n+Source: https://filefn.com/docs/quickstart/express\n \n \n Mount @filefn/server on Express by adapting Node's IncomingMessage to a Fetch Request.\n@@ -6290,7 +6298,7 @@\n \n # FastAPI Quickstart\n \n-Source: https://filefn.superfunctions.dev/docs/quickstart/fastapi\n+Source: https://filefn.com/docs/quickstart/fastapi\n \n \n Mount filefn (Python kernel) on a FastAPI app with a single sub-app route.\n@@ -6414,7 +6422,7 @@\n \n # Flask Quickstart\n \n-Source: https://filefn.superfunctions.dev/docs/quickstart/flask\n+Source: https://filefn.com/docs/quickstart/flask\n \n \n Mount filefn (Python kernel) as a Flask Blueprint.\n@@ -6487,7 +6495,7 @@\n \n # Hono Quickstart\n \n-Source: https://filefn.superfunctions.dev/docs/quickstart/hono\n+Source: https://filefn.com/docs/quickstart/hono\n \n \n Mount @filefn/server on a Hono app on Node, Bun, or Cloudflare Workers in a few lines.\n@@ -6611,7 +6619,7 @@\n \n # Next.js Quickstart\n \n-Source: https://filefn.superfunctions.dev/docs/quickstart/nextjs\n+Source: https://filefn.com/docs/quickstart/nextjs\n \n \n Mount filefn on Next.js App Router with a route.ts catch-all under app/filefn/[...path].\n@@ -6702,7 +6710,7 @@\n \n # SvelteKit Quickstart\n \n-Source: https://filefn.superfunctions.dev/docs/quickstart/sveltekit\n+Source: https://filefn.com/docs/quickstart/sveltekit\n \n \n Mount filefn on SvelteKit with a +server.ts catch-all under /filefn.\n@@ -6812,7 +6820,7 @@\n \n # Swift Quickstart\n \n-Source: https://filefn.superfunctions.dev/docs/quickstart/swift\n+Source: https://filefn.com/docs/quickstart/swift\n \n \n Use FileFnClient on iOS and macOS via Swift Package Manager — foreground and background uploads, HEIC preprocessing, and SwiftUI helpers.\n@@ -6945,7 +6953,7 @@\n \n # Recipes\n \n-Source: https://filefn.superfunctions.dev/docs/recipes\n+Source: https://filefn.com/docs/recipes\n \n \n Production-tested filefn patterns — opinionated, end-to-end, copy-and-adjust.\n@@ -6973,7 +6981,7 @@\n \n # CDN integration\n \n-Source: https://filefn.superfunctions.dev/docs/recipes/cdn-integration\n+Source: https://filefn.com/docs/recipes/cdn-integration\n \n \n Serve filefn-managed bytes through CloudFront, Cloud CDN, or Cloudflare without breaking signed URLs or auth.\n@@ -7096,7 +7104,7 @@\n \n # Custom processor\n \n-Source: https://filefn.superfunctions.dev/docs/recipes/custom-processor\n+Source: https://filefn.com/docs/recipes/custom-processor\n \n \n Author a processor end-to-end — image watermarking, sentiment scoring, transcoding to a custom format — and ship it as an artifact.\n@@ -7225,7 +7233,7 @@\n \n # Document uploads\n \n-Source: https://filefn.superfunctions.dev/docs/recipes/document-uploads\n+Source: https://filefn.com/docs/recipes/document-uploads\n \n \n PDF / DOCX / plain text uploads with first-page previews, OCR text extraction, and download URLs.\n@@ -7324,7 +7332,7 @@\n \n # HEIC conversion\n \n-Source: https://filefn.superfunctions.dev/docs/recipes/heic-conversion\n+Source: https://filefn.com/docs/recipes/heic-conversion\n \n \n Handle iPhone HEIC photos correctly in browsers, native iOS, and on the server — without any of them seeing HEIC.\n@@ -7422,7 +7430,7 @@\n \n # Image uploads\n \n-Source: https://filefn.superfunctions.dev/docs/recipes/image-uploads\n+Source: https://filefn.com/docs/recipes/image-uploads\n \n \n Production-grade image upload pipeline with HEIC handling, EXIF stripping, thumbnails, and previews.\n@@ -7545,7 +7553,7 @@\n \n # OPFS offline\n \n-Source: https://filefn.superfunctions.dev/docs/recipes/opfs-offline\n+Source: https://filefn.com/docs/recipes/opfs-offline\n \n \n Reliable uploads when the network is bad — OPFS-staged content with automatic resume on reconnect.\n@@ -7646,7 +7654,7 @@\n \n # Signed share links\n \n-Source: https://filefn.superfunctions.dev/docs/recipes/signed-share-links\n+Source: https://filefn.com/docs/recipes/signed-share-links\n \n\n[299 more lines in file. Use offset=1447 to continue.]"}],"isError":false,"timestamp":1791286009672}}
