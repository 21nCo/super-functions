{"timestamp":"2026-09-19T12:10:37.571Z","ordinal":5117,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0b993-5c83-7d61-8981-95c99813d8b4","call_id":"call_T5WZoEzi3Shwihkh26PZ0vUD","output":[{"type":"input_text","text":"Script completed\nWall time 9.7 seconds\nOutput:\n"},{"type":"input_text","text":"{\n  \"slug\": \"CUSTOM_SKILLPLANE_SKILL_RETRIEVE\",\n  \"version\": null,\n  \"schemaPath\": \"/Users/serro/.composio/tool_definitions/CUSTOM_SKILLPLANE_SKILL_RETRIEVE.json\",\n  \"inputSchema\": {\n    \"type\": \"object\",\n    \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n    \"required\": [\n      \"skill\",\n      \"caller\"\n    ],\n    \"properties\": {\n      \"skill\": {\n        \"anyOf\": [\n          {\n            \"type\": \"object\",\n            \"required\": [\n              \"id\"\n            ],\n            \"properties\": {\n              \"id\": {\n                \"type\": \"string\",\n                \"maxLength\": 200,\n                \"minLength\": 1\n              }\n            },\n            \"additionalProperties\": false\n          },\n          {\n            \"type\": \"object\",\n            \"required\": [\n              \"workspaceSlug\",\n              \"skillSlug\"\n            ],\n            \"properties\": {\n              \"skillSlug\": {\n                \"type\": \"string\",\n                \"pattern\": \"^[a-z0-9]+(?:-[a-z0-9]+)*$\",\n                \"maxLength\": 120,\n                \"minLength\": 1\n              },\n              \"workspaceSlug\": {\n                \"type\": \"string\",\n                \"pattern\": \"^[a-z0-9]+(?:-[a-z0-9]+)*$\",\n                \"maxLength\": 120,\n                \"minLength\": 1\n              }\n            },\n            \"additionalProperties\": false\n          }\n        ]\n      },\n      \"caller\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"agentId\",\n          \"agentName\",\n          \"modelProvider\",\n          \"modelName\",\n          \"modelVersion\",\n          \"clientName\",\n          \"clientVersion\",\n          \"runId\",\n          \"sessionId\",\n          \"conversationId\"\n        ],\n        \"properties\": {\n          \"runId\": {\n            \"type\": \"string\",\n            \"maxLength\": 200,\n            \"minLength\": 1\n          },\n          \"agentId\": {\n            \"type\": \"string\",\n            \"maxLength\": 160,\n            \"minLength\": 1\n          },\n          \"agentName\": {\n            \"type\": \"string\",\n            \"maxLength\": 120,\n            \"minLength\": 1\n          },\n          \"modelName\": {\n            \"type\": \"string\",\n            \"maxLength\": 160,\n            \"minLength\": 1\n          },\n          \"sessionId\": {\n            \"type\": \"string\",\n            \"maxLength\": 200,\n            \"minLength\": 1\n          },\n          \"clientName\": {\n            \"type\": \"string\",\n            \"maxLength\": 160,\n            \"minLength\": 1\n          },\n          \"modelVersion\": {\n            \"type\": \"string\",\n            \"maxLength\": 120,\n            \"minLength\": 1\n          },\n          \"clientVersion\": {\n            \"type\": \"string\",\n            \"maxLength\": 120,\n            \"minLength\": 1\n          },\n          \"modelProvider\": {\n            \"type\": \"string\",\n            \"maxLength\": 120,\n            \"minLength\": 1\n          },\n          \"conversationId\": {\n            \"type\": \"string\",\n            \"maxLength\": 200,\n            \"minLength\": 1\n          }\n        },\n        \"additionalProperties\": false\n      },\n      \"context\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"selector\"\n        ],\n        \"properties\": {\n          \"selector\": {\n            \"anyOf\": [\n              {\n                \"type\": \"object\",\n                \"required\": [\n                  \"id\"\n                ],\n                \"properties\": {\n                  \"id\": {\n                    \"type\": \"string\",\n                    \"maxLength\": 200,\n                    \"minLength\": 1\n                  }\n                },\n                \"additionalProperties\": false\n              },\n              {\n                \"type\": \"object\",\n                \"required\": [\n                  \"slug\"\n                ],\n                \"properties\": {\n                  \"slug\": {\n                    \"type\": \"string\",\n                    \"pattern\": \"^[a-z0-9]+(?:-[a-z0-9]+)*$\",\n                    \"maxLength\": 120,\n                    \"minLength\": 1\n                  }\n                },\n                \"additionalProperties\": false\n              }\n            ]\n          },\n          \"knowledge\": {\n            \"oneOf\": [\n              {\n                \"type\": \"object\",\n                \"required\": [\n                  \"selector\"\n                ],\n                \"properties\": {\n                  \"selector\": {\n                    \"type\": \"string\",\n                    \"const\": \"current\"\n                  }\n                },\n                \"additionalProperties\": false\n              },\n              {\n                \"type\": \"object\",\n                \"required\": [\n                  \"selector\",\n                  \"revisionId\"\n                ],\n                \"properties\": {\n                  \"selector\": {\n                    \"type\": \"string\",\n                    \"const\": \"revisionId\"\n                  },\n                  \"revisionId\": {\n                    \"type\": \"string\",\n                    \"maxLength\": 200,\n                    \"minLength\": 1\n                  }\n                },\n                \"additionalProperties\": false\n              },\n              {\n                \"type\": \"object\",\n                \"required\": [\n                  \"selector\",\n                  \"revision\"\n                ],\n                \"properties\": {\n                  \"revision\": {\n                    \"type\": \"integer\",\n                    \"maximum\": 9007199254740991,\n                    \"exclusiveMinimum\": 0\n                  },\n                  \"selector\": {\n                    \"type\": \"string\",\n                    \"const\": \"revision\"\n                  }\n                },\n                \"additionalProperties\": false\n              }\n            ],\n            \"default\": {\n              \"selector\": \"current\"\n            }\n          },\n          \"includeNotes\": {\n            \"type\": \"boolean\",\n            \"default\": false\n          }\n        },\n        \"additionalProperties\": false\n      },\n      \"version\": {\n        \"oneOf\": [\n          {\n            \"type\": \"object\",\n            \"required\": [\n              \"selector\"\n            ],\n            \"properties\": {\n              \"selector\": {\n                \"type\": \"string\",\n                \"const\": \"current\"\n              }\n            },\n            \"additionalProperties\": false\n          },\n          {\n            \"type\": \"object\",\n            \"required\": [\n              \"selector\",\n              \"versionId\"\n            ],\n            \"properties\": {\n              \"selector\": {\n                \"type\": \"string\",\n                \"const\": \"versionId\"\n              },\n              \"versionId\": {\n                \"type\": \"string\",\n                \"maxLength\": 200,\n                \"minLength\": 1\n              }\n            },\n            \"additionalProperties\": false\n          },\n          {\n            \"type\": \"object\",\n            \"required\": [\n              \"selector\",\n              \"semanticVersion\"\n            ],\n            \"properties\": {\n              \"selector\": {\n                \"type\": \"string\",\n                \"const\": \"semanticVersion\"\n              },\n              \"semanticVersion\": {\n                \"type\": \"string\",\n                \"pattern\": \"^(0|[1-9][0-9]*)\\\\.(0|[1-9][0-9]*)\\\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\\\+[0-9A-Za-z.-]+)?$\",\n                \"maxLength\": 160,\n                \"minLength\": 1\n              }\n            },\n            \"additionalProperties\": false\n          },\n          {\n            \"type\": \"object\",\n            \"required\": [\n              \"selector\",\n              \"revision\"\n            ],\n            \"properties\": {\n              \"revision\": {\n                \"type\": \"integer\",\n                \"maximum\": 9007199254740991,\n                \"exclusiveMinimum\": 0\n              },\n              \"selector\": {\n                \"type\": \"string\",\n                \"const\": \"revision\"\n              }\n            },\n            \"additionalProperties\": false\n          }\n        ],\n        \"default\": {\n          \"selector\": \"current\"\n        }\n      }\n    },\n    \"additionalProperties\": false\n  }\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0b992-9248-7613-95d3-df05acb573b9","create_time":1789819837.571326}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
