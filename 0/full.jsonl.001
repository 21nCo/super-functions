ult };\n   570\t}\n   571\t\n   572\tfunction suiteIncompleteReasons(\n   573\t  failure: McpFnReportFailure | undefined,\n   574\t  cleanupFailure: McpFnReportFailure | undefined,\n   575\t  diagnostics: SuiteDiagnosticCollector,\n   374\t  // Inputs beyond the explicit budget fail closed before any output is emitted.\n   375\t  expect(() => redactRemoteCredential({headers: {\"x-api-key\": token}}, input)).toThrow(/traversal budget/);\n   376\t});\n   377\tit(\"scrubs token components of custom authorization schemes\", async () => {\n   378\t  const {redactRemoteCredential} = await import(\"../src/remote-target.js\");\n   379\t  expect(redactRemoteCredential({headers: {authorization: \"Token opaque-123\"}}, {echo: \"opaque-123\"})).toEqual({echo: \"[REDACTED]\"});\n   380\t});\n   381\t\n   382\tit(\"scrubs independently reflected structured authorization parameters\", async () => {\n   383\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   384\t  const credential = {\n   385\t    headers: {\n   386\t      authorization: 'Digest username=\"fixture-user\", response=\"opaque\\\\\"digest\", nonce=opaque-nonce',\n   387\t    },\n   388\t  };\n   389\t  expect(redactRemoteCredential(credential, {\n   390\t    username: \"fixture-user\",\n   391\t    response: 'opaque\"digest',\n   392\t    rawResponse: 'opaque\\\\\"digest',\n   393\t    quotedResponse: '\"opaque\\\\\"digest\"',\n   394\t    nonce: \"opaque-nonce\",\n   395\t  })).toEqual({\n   396\t    username: \"[REDACTED]\",\n   397\t    response: \"[REDACTED]\",\n   398\t    rawResponse: \"[REDACTED]\",\n   399\t    quotedResponse: \"[REDACTED]\",\n   400\t    nonce: \"[REDACTED]\",\n   401\t  });\n   402\t});\n   403\t\n   404\tit.each([\n   405\t  'Digest username=\"unterminated',\n   406\t  \"Signature keyId=client,missing\",\n   407\t  \"Signature keyId=client,\",\n   408\t])(\"rejects malformed structured authorization credentials and releases their lease\", async authorization => {\n   409\t  const { redactRemoteCredential } = await import(\"../src/remote-target.js\");\n   410\t  expect(() => redactRemoteCredential({ headers: { authorization } }, \"report\"))\n   411\t    .toThrow(/Authorization credential/);\n   412\t  const revoke = vi.fn();\n   413\t  const target = authenticatedHttpTarget(\"http://127.0.0.1:1/mcp\", { credential: {\n   414\t    acquire: () => ({ headers: { authorization } }), revoke,\n   415\t  } });\n   416\t  await expect(target.open({ requestId: \"invalid\", diagnostic: async () => {} }))\n   417\t    .rejects.toThrow(/Authenticated target could not be opened/);\n   418\t  expect(revoke).toHaveBeenCalledOnce();\n   419\t});\n   420\t\n   421\t\n   422\tit(\"retains successful-open leases until revocation succeeds\", async () => {\n   423\t  const revoke = vi.fn().mockRejectedValueOnce(new Error('temporary')).mockResolvedValue(undefined);\n   424\t  const target = authenticatedHttpTarget('http://127.0.0.1:1/mcp', { credential: { acquire: () => ({ headers: { 'x-api-key': 'opaque-key' } }), revoke } });\n   425\t  const handle = await target.open({ requestId: 'lease', diagnostic: async () => {} });\n   426\t  await expect(handle.close!()).rejects.toThrow(/cleanup/);\n   427\t  await target.cleanup!();\n   428\t  expect(revoke).toHaveBeenCalledTimes(2);\n   429\t});\n   430\t\n   214\t  const report = await runMcpFnTargetSuite({ target: customTarget({\n   215\t    kind: \"failed-open\", open: async () => { throw new Error(\"cannot open\"); }, cleanup,\n   216\t  }) });\n   217\t  expect(report.ok).toBe(false);\n   218\t  expect(cleanup).toHaveBeenCalledOnce();\n   219\t  expect(report.incompleteReason).not.toContain(\"Target cleanup failed\");\n   220\t});\n   221\t\n   222\tit(\"proves a target-supplied failure phase safe before emitting it\", async () => {\n   223\t  const report = await runMcpFnTargetSuite({ target: customTarget({\n   224\t    kind: \"failed-open\",\n   225\t    redact: <T>(value: T): T => value instanceof Error\n   226\t      ? { name: value.name, message: value.message, phase: \"vendor-phase\" } as T\n   227\t      : value,\n   228\t    open: async () => { throw new Error(\"cannot open\"); },\n   229\t  }) });\n   230\t  expect(report).toMatchObject({\n   231\t    ok: false,\n   232\t    status: \"incomplete\",\n   233\t    failure: { phase: \"vendor-phase\" },\n   234\t  });\n   235\t});\n   236\t\n   237\t\n   238\tit.each([\"metadata\", \"failure\"])(\"applies custom target redaction to finalized suite %s\", async mode => {\n   239\t  const secret = \"custom-owned-secret\";\n   240\t  const server = createMcpFnServer({\n   241\t    info: { name: secret, version: \"1.0.0\" },\n   242\t    registry: new McpFnRegistry().register({\n   243\t      name: \"visible-tool\", description: \"Fixture tool\", inputSchema: { type: \"object\" },\n   244\t      handler: async () => structuredResult({ ok: true }),\n   245\t    }),\n   555\t- Convergence state: not clean. Three new/actionable roots, recurring structural-safety and cleanup families, and eight valid analyzer findings reset the clean streak to `0` despite the stable snapshot head and terminal successful required checks.\n   556\t\n   557\t## Round 11 snapshot dispositions\n   558\t\n   559\t- Fixed: 3 new review root causes and 8 valid Sonar findings. `MCP170-SCENARIO-OPTIONAL-KEY-AVAILABILITY` now validates `status`, `incompleteReason`, and `variables` only in the branches that emit them. `MCP170-CUSTOM-FALLBACK-STRUCTURE` snapshots exact fixed-string safety through the live target scrubber and validates only the final emitted report structure, including bounded/fallback changes. `MCP170-PROJECTION-CLEANUP-BYPASS` places projection and structure capture behind unconditional close and safely handles a hostile post-connect `kind` getter. The valid analyzer set received deterministic Base64 padding removal, `String.raw` replacement syntax, role/traversal helpers, an identity-preserving throw callback, suite orchestration decomposition, and report-normalization helpers.\n   560\t- Skipped (Already Fixed / Stale): 90 older unresolved threads retain their prior current-code dispositions (30 current and 60 outdated-only at this snapshot). Outdated status and one new Pullfrog acknowledgement comment were not counted as proof or new root causes.\n   561\t- Invalid / Accepted Risk: the 3 remaining Sonar `throw this` findings are invalid because the exact error object is the cleanup ownership token; the older payload-key-redaction finding retains its prior invalid disposition. No accepted risks.\n   562\t- Not Attempted: 0 valid code root causes. All 3 new review roots and all 8 valid current Sonar findings were attempted in the single coordinated batch; hosted reviewer/analyzer confirmation is deferred to a future separately scheduled snapshot because post-push refetch is forbidden.\n   563\t- Unassessed: 0 captured threads, nested comments, review bodies, issue comments, raw inline comments, or current Sonar issues.\n   564\t\n   565\t## Round 11 verification evidence\n   566\t\n   567\t- Focused regressions: 36 target-suite tests, 88 remote-target tests, 10 report tests, and 31 authenticated-inspector artifact tests passed (165 total). New cases prove absent optional scenario keys do not overreject, pre-connect custom fallback structure fails closed, a post-connect hostile kind getter cannot bypass close, and fixed report-key/discriminator collisions reject safely.\n   568\t- Complete affected-package suites: all 236 `@mcpfn/testing` tests and all 41 `@mcpfn/inspector` tests passed. Both packages typechecked and built successfully under Node 22.\n   569\t- Release gate: the final `PATH=/opt/homebrew/opt/node@22/bin:$PATH npm run gate:mcpfn-release` passed every reported package test/typecheck/build, Playwright, official conformance, mixed-entry redaction, examples, ESM/CJS imports, dry-run packs, packed-consumer installation, and round trips.\n   570\t- `git diff --check` and the staged diff check passed. Whole-batch review covered all six code/test files. The ledger remained untracked and was never staged or committed.\n   571\t- Required-check snapshot: the single pre-mutation snapshot contained 18 terminal contexts: 14 successful, 1 neutral, and 3 skipped; Sonar Quality Gate passed while its current issue inventory contained 8 valid and 3 invalid findings. No hosted checks or reviews were fetched after push.\n   572\t- Fix-induced regressions: the first focused run exposed four stale expectations that permitted unproven fixed structure; those regressions now assert safe rejection. The broader remote-target run exposed that a safely projected dynamic-kind fallback was being rejected before fallback selection; finalization now validates the actually emitted fallback, preserving the established incomplete-report contract. All subsequent focused, complete-package, and release-gate runs passed.\n   573\t- Commit / push: one commit `9ee45f4385f3b354f0e27396fe0e86dafa5ee41f` (`fix(mcpfn): close structural report gaps`) and one successful push through existing `origin` to `codex/mcp-1-transport-neutral-conformance-0910`.\n   574\t- Head verification (one comparison only): local head, remote branch head, and PR 170 head all equal `9ee45f4385f3b354f0e27396fe0e86dafa5ee41f`; PR 170 remained open.\n   575\t\n   576\t## Round 11 convergence\n   577\t\n   578\t- Trend: improving but nonterminal. All selected review and valid analyzer roots have coordinated repairs, no local regression remains, and the immediate check snapshot was terminal/successful; hosted reviewers and analyzers have not yet assessed the new head.\n   579\t- Valid blocking root causes before / after: 3 new review roots plus 8 valid analyzer findings / 0 deliberately deferred valid code roots, with hosted verification pending a future separately scheduled assessment.\n   580\t- New defects: optional-key overvalidation, custom-redactor fallback structure bypass, and projection-before-cleanup escape.\n   581\t- Recurring families: credential-boundary structural safety and cleanup ownership recurred; both were repaired at shared producer/finalization boundaries rather than at individual symptom sites.\n   582\t- Clean streak: `0` (reset by new/actionable roots, recurring families, this code-changing round, and the changed PR head after assessment).\n   583\t- Head stability: the complete snapshot stayed at `80ba026172a774ea95277393becffa35c9892fc1` during assessment; the single commit and push advanced local, remote, and PR head together to `9ee45f4385f3b354f0e27396fe0e86dafa5ee41f` in the one allowed comparison.\n   584\t\n   585\t## Round 11 termination\n   586\t\n   587\t- Result: nonterminal recurring run. A future separately scheduled clean assessment must verify the new head, review dispositions, and analyzer/check state; this code-changing round cannot count toward the clean streak.\n   588\t- Automation `4442e7f3-60f4-4125-a8e4-c818ac40fc82` remains disabled from the earlier retrieval-discovery stop and was not silently re-enabled during this manual round.\n   589\t- No post-push review refetch, CI poll, reviewer wait, thread resolution, review dismissal, merge, or second fix loop was performed.\n   590\t\n   591\t## Round 12 assessment\n   592\t\n   593\t- Hosted workflow: `21n/pr-refetch-fix@1.2.0`, revision `4`, digest `sha256:8781c1c12fe9d5902337d6cf21bfbac49dd3a94c7eadd46bf2622db350444022` (published identity verified through Skillplane via Composio before repository mutation).\n   594\t- Mode: assessment reset. Round 12 is a separately invoked single review round; the prior clean streak remains `0`.\n   595\t- Snapshot / head: local, upstream, every review page, and PR head were stable at `9ee45f4385f3b354f0e27396fe0e86dafa5ee41f`. The complete one-time snapshot contains 334 threads (93 unresolved: 32 current and 61 outdated-only), 232 reviews, 64 issue comments, 376 raw inline comments, 5 current Sonar issues, and 18 check contexts. All thread and nested-comment pagination was terminal.\n   596\t- Shared invariant: every credential-derived value that a peer can reflect independently must be registered with the live target redactor, or ambiguous structured credentials must fail closed before transport; every structural string actually emitted in a typed report, including a dynamic normalized failure phase, must be proven safe by that same live redactor; cleanup ownership mu…65 tokens truncated…n failures produce normalized failure phases consumed by suite report structure validation; the remote-target lease and suite finalizer own cleanup across both paths.\n   598\t- Failure boundaries: quoted auth-param values with escapes or commas, unquoted component values, malformed or ambiguous parameter lists, simple custom opaque schemes, Basic decoding, a target-supplied nonstandard failure phase, and close-time cleanup after discovery or structural rejection.\n   599\t- Coordinated repair: retain whole-token and Basic component registration; parse non-Basic structured auth-param lists deterministically, register raw and decoded component values, and reject malformed lists within the existing lease cleanup boundary; pass the normalized connection failure into structural-guard capture so the exact emitted phase is proven before close; remove the two valid analyzer smells without changing behavior.\n   600\t- Verification criteria: focused structured-authorization redaction and malformed-release regressions; a custom failed-open dynamic-phase report regression; complete affected testing-package tests/typecheck/build; Node 22 release gate; `git diff --check`; whole-batch diff review; and one final local/remote/PR-head comparison. Hosted review/check surfaces will not be fetched again this round.\n   601\t\n   602\t### Round 12 defect families\n   603\t\n   604\t| Stable family | Root cause / affected contract | Disposition | First seen | Last attempted | Repair / evidence state |\n   605\t| --- | --- | --- | --- | --- | --- |\n   606\t| `MCP170-AUTHORIZATION-STRUCTURED-COMPONENTS` | Non-Basic structured authorization values register only the whole parameter block, allowing an independently reflected component to escape redaction | Actionable; recurring credential-discovery family | round 12 | round 12 | Bounded auth-param component discovery and malformed-input rejection selected |\n   607\t| `MCP170-DYNAMIC-FAILURE-PHASE-GUARD` | Suite structure capture omits a target-supplied normalized failure phase that final validation emits | Actionable; recurring structural-safety family | round 12 | round 12 | Exact connection-failure phase capture selected |\n   608\t| `MCP170-SONAR-GUARD-INITIALIZATION` | Suite orchestration initializes the structural guard with a value that is always overwritten before normal return | Valid analyzer finding | round 12 | round 12 | Definite control-flow assignment selected |\n   609\t| `MCP170-SONAR-REDACTION-NESTED-TERNARY` | Redaction object traversal nests role selection inside a conditional expression | Valid analyzer finding; recurring redaction-maintainability family | round 12 | round 12 | Explicit entry-role selection selected |\n   610\t| `MCP170-SONAR-THROW-THIS` | Three findings flag intentional retry-owner self-rejection | Invalid analyzer interpretation | round 10 | round 12 | Exact error identity remains the cleanup ownership token; preserve behavior |\n   611\t\n   612\t- Snapshot dispositions before mutation: 2 new unresolved current review threads deduplicate to 2 actionable root causes. Five current Sonar issues deduplicate to 2 valid maintainability roots and 3 invalid retry-owner findings. Older valid blockers and dispositions remain preserved; outdated status was not used as proof.\n   613\t- Required-check snapshot: 18 contexts comprised 13 successful, 1 neutral, 3 skipped, and 1 pending CodeRabbit context; there were no failing contexts. Sonar Quality Gate passed and `reviewDecision` was empty. No check polling is permitted.\n   614\t- Convergence state: not clean. Two new/actionable roots, recurring credential-discovery and structural-safety families, two valid analyzer findings, and the pending required check reset the clean streak to `0` despite the stable snapshot head.\n   615\t\n   616\t## Round 12 snapshot dispositions\n   617\t\n   618\t- Fixed: 2 new review root causes and 2 valid Sonar findings. `MCP170-AUTHORIZATION-STRUCTURED-COMPONENTS` now discovers quoted, escaped, decoded, raw-inner, and unquoted values from bounded non-Basic/Bearer auth-param lists while preserving simple opaque custom schemes and Basic decoding; malformed structured syntax fails inside the existing credential-lease cleanup boundary. `MCP170-DYNAMIC-FAILURE-PHASE-GUARD` now proves the normalized connection failure's exact emitted phase safe while the live target redactor remains available. The two analyzer findings received definite structural-guard assignment and explicit redaction entry-role selection.\n   619\t- Skipped (Already Fixed / Stale): 91 older unresolved threads retain their prior current-code dispositions (30 current and 61 outdated-only at this snapshot). Outdated status, resolved-thread counts, and acknowledgement-only comments were not used as proof.\n   620\t- Invalid / Accepted Risk: the 3 remaining Sonar `throw this` findings are invalid because exact error identity is the cleanup ownership token; the older payload-key-redaction finding retains its prior invalid disposition. No accepted risks.\n   621\t- Not Attempted: 0 valid code root causes. Both new review roots and both valid current Sonar findings were attempted in the single coordinated batch; hosted reviewer/analyzer confirmation is deferred to a future separately scheduled snapshot because post-push refetch is forbidden.\n   622\t- Unassessed: 0 captured threads, nested comments, review bodies, issue comments, raw inline comments, or current Sonar issues.\n   623\t\n   624\t## Round 12 verification evidence\n   625\t\n   626\t- Focused regressions: 37 target-suite tests and 92 remote-target tests passed (129 total). New cases prove dynamic normalized failure phases are admitted only after live-redactor classification; quoted, escaped, decoded, raw-inner, and unquoted structured authorization components redact; malformed auth-param lists reject; and their credential lease is revoked exactly once. Existing simple custom-scheme and Basic behavior remained green.\n   627\t- Complete affected-package suite: all 241 `@mcpfn/testing` tests passed. The package typechecked and built successfully under Node 22.\n   628\t- Release gate: the final `PATH=/opt/homebrew/opt/node@22/bin:$PATH npm run gate:mcpfn-release` passed every reported dependency/package test, typecheck, and build; Playwright; mixed-entry redaction; official conformance; examples; ESM/CJS imports; dry-run packs; packed-consumer installation; and round trips. The first gate attempt identified only an absent pinned Playwright browser; installing that exact test runtime resolved the environment gap, and the final gate passed against the final code state.\n   629\t- `git diff --check` passed. Whole-batch review covered all four code/test files and decomposed the structured-credential parser to avoid a new complexity hotspot. The ledger remained untracked and will not be staged or committed.\n   630\t- Required-check snapshot: the single pre-mutation snapshot contained 18 contexts: 13 successful, 1 neutral, 3 skipped, and 1 pending CodeRabbit context. Sonar Quality Gate passed with 2 valid and 3 invalid current findings. No hosted checks or reviews were fetched after the snapshot.\n   631\t- Fix-induced regressions: the first focused dynamic-phase test incorrectly exercised the client's intentional raw-open normalization to `transport-connect`; the final test exercises the actual target-redactor normalization boundary. No regression remained after focused tests, the complete package suite, typecheck/build, whole-diff review, or the final release gate.\n   632\t\n   633\t## Round 12 convergence\n   634\t\n   635\t- Trend: improving but nonterminal. All selected review and valid analyzer roots have coordinated repairs and no local regression remains, but this code-changing round cannot be clean and the sole immediate check snapshot contained a pending reviewer context.\n   636\t- Valid blocking root causes before / after: 2 new review roots plus 2 valid analyzer findings / 0 deliberately deferred valid code roots, with hosted verification pending a future separately scheduled assessment.\n   637\t- New defects: structured authorization component leakage and omission of a dynamic normalized failure phase from the live structural-safety candidate set.\n   638\t- Recurring families: credential discovery and structural safety recurred; both were repaired at shared producer/finalization boundaries.\n   639\t- Clean streak: `0` (reset by new/actionable roots, recurring families, this code-changing round, and the pending required check in the sole snapshot).\n   640\t- Head stability before mutation: the complete snapshot stayed at `9ee45f4385f3b354f0e27396fe0e86dafa5ee41f` throughout assessment. Final local/remote/PR head evidence will be recorded after the one allowed push and one allowed comparison.\n   641\t\n   642\t## Round 12 completion\n   643\t\n   644\t- Commit / push: one commit `d12812dfae99cc0905aa93365f9b9ed5c42065f2` (`fix(mcpfn): harden credential report safety`) and one successful push through existing `origin` to `codex/mcp-1-transport-neutral-conformance-0910`.\n   645\t- Head verification (one comparison only): local head, `origin/codex/mcp-1-transport-neutral-conformance-0910`, and PR 170 head all equal `d12812dfae99cc0905aa93365f9b9ed5c42065f2`; PR 170 remained open. The branch was `+0/-0`, and the only remaining worktree item was the untracked `.conduct/` ledger directory.\n   646\t- Head stability: the assessed head remained `9ee45f4385f3b354f0e27396fe0e86dafa5ee41f` through selection and verification; the single commit and push advanced local, remote, and PR head together to `d12812dfae99cc0905aa93365f9b9ed5c42065f2` in the one allowed post-push comparison.\n   647\t- Result: nonterminal recurring run. A future separately scheduled assessment must inspect the new head's complete review/check surfaces once; this code-changing round cannot count toward the clean streak.\n   648\t- Automation `4442e7f3-60f4-4125-a8e4-c818ac40fc82` remains disabled from the earlier retrieval-discovery stop and was not silently re-enabled during this manual round.\n   649\t- No post-push review refetch, CI poll, reviewer wait, thread resolution, review dismissal, merge, or second fix loop was performed.\n   389\t# Task Group: September 15 Superfunctions PR #170 bounded remediation and dirty-dev reconciliation\n   390\tscope: Use for live hosted `pr-refetch-fix` work on McpFn PR #170, or scoped publication/reconciliation from a dirty, stale Superfunctions dev checkout.\n   391\tapplies_to: cwd=/Users/serro/Documents/dev/n/superfunctions-dev and /private/tmp/pr170-refetch-fix.h2yq4m; reuse_rule=PR threads, heads, hosted checks, and checkout state must be revalidated live; preserve unrelated dirty state.\n   392\t\n   393\t## Task 1: Harden PR #170 redaction/export invariants in a bounded hosted round, success\n   394\t\n   395\t### rollout_summary_files\n   396\t\n   397\t- rollout_summaries/REDACTED.md (cwd=/Users/serro/Documents/dev/n/superfunctions-dev, rollout_path=/Users/serro/.codex/sessions/2026/09/15/rollout-2026-09-15T18-25-27-01a0a522-f7e4-7422-a0fb-002c30b622cc.jsonl, updated_at=2026-09-16T12:17:41+00:00, thread_id=01a0a522-f7e4-7422-a0fb-002c30b622cc, Node 22 release gate passed; PR remained DIRTY)\n   398\t- rollout_summaries/REDACTED.md (cwd=/private/tmp/pr170-refetch-fix.h2yq4m, rollout_path=/Users/serro/.codex/sessions/2026/09/16/rollout-2026-09-16T18-12-40-01a0aa3d-a004-7df3-b812-85a576729d2d.jsonl, updated_at=2026-09-16T15:30:05+00