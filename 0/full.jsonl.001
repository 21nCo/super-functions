): McpFnTarget {\n    40\t  const descriptor = Object.freeze({ kind: options.kind, ...options.descriptor });\n    41\t  return {\n    42\t    kind: options.kind,\n    43\t    describe: () => ({ ...descriptor }),\n    44\t    open: (context) => Promise.resolve(options.open(context)),\n    45\t    ...(options.cleanup ? { cleanup: () => options.cleanup!() } : {}),\n    46\t    ...(options.redact ? { redact: options.redact } : {}),\n    47\t  };\n    48\t}\n    49\t\n    50\texport function transportTarget(\n    51\t  transport: Transport,\n    52\t  descriptor?: McpFnTargetDescriptor,\n    53\t): McpFnTarget {\n    54\t  const targetDescriptor = descriptor ?? { kind: \"custom\" };\n    55\t  let opened = false;\n    56\t  return customTarget({\n    57\t    kind: targetDescriptor.kind,\n    58\t    descriptor: targetDescriptor,\n    59\t    open: () => {\n    60\t      if (opened) throw new Error(\"A one-shot McpFn transport target cannot be reopened\");\n    61\t      opened = true;\n    62\t      return { transport, close: () => transport.close() };\n    63\t    },\n    64\t  });\n    65\t}\n    66\t\n    67\texport function stdioTarget(options: McpFnStdioTargetOptions): McpFnTarget {\n    68\t  if (!options.command.trim()) throw new Error(\"McpFn stdio target command is required\");\n    69\t  return customTarget({\n    70\t    kind: \"stdio\",\n    71\t    descriptor: {\n    72\t      command: options.command,\n    73\t      ...(options.cwd ? { cwd: options.cwd } : {}),\n    74\t    },\n    75\t    open: () => {\n    76\t      const transport = new StdioClientTransport(options);\n    77\t      return {\n    78\t        transport,\n    79\t        close: () => transport.close(),\n    80\t      };\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0b992-9248-7613-95d3-df05acb573b9","create_time":1789820519.275284}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
