{"timestamp":"2026-09-22T05:57:11.079Z","ordinal":6638,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b3f5-d570-7a72-b668-401efd539e3b","turn_id":"01a0c7ab-235a-7900-93f6-a63dbefa6872","item":{"type":"CommandExecution","id":"exec-ac73bdc6-85cc-476b-8a05-061781a51274","process_id":"48893","command":["/bin/zsh","-lc","sed -n '1,140p' mcpfn/testing/tests/suite.test.ts && sed -n '120,230p' mcpfn/inspector/tests/authenticated-artifacts.test.ts && sed -n '1,120p' mcpfn/testing/src/remote-target.ts && tail -n 90 .conduct/pr-170-remediation-ledger.md"],"cwd":"file:///Users/serro/Documents/dev/n/worktrees/superfunctions/PR-170","parsed_cmd":[{"type":"read","cmd":"sed -n '1,140p' mcpfn/testing/tests/suite.test.ts","name":"suite.test.ts","path":"mcpfn/testing/tests/suite.test.ts"},{"type":"read","cmd":"sed -n '120,230p' mcpfn/inspector/tests/authenticated-artifacts.test.ts","name":"authenticated-artifacts.test.ts","path":"mcpfn/inspector/tests/authenticated-artifacts.test.ts"},{"type":"read","cmd":"sed -n '1,120p' mcpfn/testing/src/remote-target.ts","name":"remote-target.ts","path":"mcpfn/testing/src/remote-target.ts"},{"type":"read","cmd":"tail -n 90 .conduct/pr-170-remediation-ledger.md","name":"pr-170-remediation-ledger.md","path":".conduct/pr-170-remediation-ledger.md"}],"source":"unified_exec_startup","status":"completed","stdout":"import { McpFnTargetSuiteCleanupError } from \"../src/suite.js\";\nimport { InMemoryTransport } from \"@modelcontextprotocol/sdk/inMemory.js\";\nimport { describe, expect, it, vi } from \"vitest\";\nimport { customTarget } from \"@mcpfn/client\";\nimport { McpFnRegistry, createMcpFnServer, structuredResult } from \"@mcpfn/core\";\n\nimport { runMcpFnTargetSuite } from \"../src/index.js\";\n\ndescribe(\"McpFn target suite\", () => {\n  it(\"uses one target/session engine for external-shaped and in-memory targets\", async () => {\n    const server = createMcpFnServer({\n      info: { name: \"suite-target\", version: \"1.0.0\" },\n      registry: new McpFnRegistry().register({\n        name: \"echo\",\n        description: \"Echo an input in the shared suite.\",\n        inputSchema: { type: \"object\" },\n        handler: async (input) => structuredResult(input),\n      }),\n    });\n    const report = await runMcpFnTargetSuite({\n      target: customTarget({\n        kind: \"fixture\",\n        descriptor: {\n          mode: \"external-shaped\",\n          url: \"https://target.example/mcp?api_key=secret#access_token=token\",\n        },\n        open: async () => {\n          const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();\n          await server.connect(serverTransport);\n          return { transport: clientTransport, close: () => server.close() };\n        },\n      }),\n      manifest: server.manifest(),\n      scenarios: [{\n        name: \"echo\",\n        tool: \"echo\",\n        arguments: { value: \"ok\" },\n        expect: { structuredContent: { value: \"ok\" } },\n      }],\n    });\n    expect(report).toMatchObject({\n      ok: true,\n      target: { kind: \"fixture\", mode: \"external-shaped\" },\n      manifestChecked: true,\n      total: 1,\n      passed: 1,\n    });\n    expect(JSON.stringify(report.target)).not.toContain(\"secret\");\n    expect(JSON.stringify(report.target)).not.toContain(\"access_token=token\");\n    expect(JSON.stringify(report.target)).toContain(\"REDACTED\");\n    expect(report.timeline).toEqual(expect.arrayContaining([\n      expect.objectContaining({ phase: \"transport-close\", outcome: \"succeeded\" }),\n    ]));\n  });\n\n  it(\"rejects an invalid report cap before opening the target\", async () => {\n    const open = vi.fn();\n    await expect(runMcpFnTargetSuite({\n      target: customTarget({ kind: \"never-opened\", open }),\n      maxReportBytes: 1,\n    })).rejects.toThrow(/at least 1024/);\n    expect(open).not.toHaveBeenCalled();\n  });\n\n  it(\"marks target reports incomplete when observed events exceed the scenario cap\", async () => {\n    let server: ReturnType<typeof createMcpFnServer>;\n    server = createMcpFnServer({\n      info: { name: \"event-heavy-target\", version: \"1.0.0\" },\n      additionalCapabilities: { logging: {} },\n      registry: new McpFnRegistry().register({\n        name: \"notify\",\n        description: \"Emit enough notifications to exercise the event cap.\",\n        inputSchema: { type: \"object\" },\n        handler: async () => {\n          for (let index = 0; index < 5; index += 1) {\n            await server.sendLoggingMessage({ level: \"info\", data: { index } });\n          }\n          return structuredResult({ ok: true });\n        },\n      }),\n    });\n\n    const report = await runMcpFnTargetSuite({\n      target: customTarget({\n        kind: \"fixture\",\n        open: async () => {\n          const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();\n          await server.connect(serverTransport);\n          return { transport: clientTransport, close: () => server.close() };\n        },\n      }),\n      scenarios: [\n        { name: \"notify\", tool: \"notify\" },\n        {\n          name: \"drain notifications\",\n          kind: \"auth.assert\",\n          phase: \"drain\",\n          expect: { outcome: \"allowed\" },\n        },\n      ],\n      scenarioRun: {\n        maxObservedEvents: 2,\n        auth: async () => {\n          await new Promise((resolve) => setTimeout(resolve, 10));\n          return { outcome: \"allowed\" };\n        },\n      },\n    });\n\n    expect(report).toMatchObject({\n      ok: false,\n      status: \"incomplete\",\n      droppedObservedEvents: 3,\n      incompleteReason: \"Observed client events exceeded maxObservedEvents\",\n      results: [\n        { status: \"passed\", droppedObservedEvents: 3 },\n        { status: \"passed\" },\n      ],\n    });\n  });\n\n  it(\"distinguishes redaction omissions from observed-event overflow\", async () => {\n    let server: ReturnType<typeof createMcpFnServer>;\n    server = createMcpFnServer({\n      info: { name: \"redaction-omission-target\", version: \"1.0.0\" },\n      additionalCapabilities: { logging: {} },\n      registry: new McpFnRegistry().register({\n        name: \"notify\",\n        description: \"Emit an event whose payload cannot be redacted.\",\n        inputSchema: { type: \"object\" },\n        handler: async () => {\n          await server.sendLoggingMessage({ level: \"info\", data: { privateRedactionState: true } });\n          return structuredResult({ ok: true });\n        },\n      }),\n    });\n    const report = await runMcpFnTargetSuite({\n      target: customTarget({\n        kind: \"fixture\",\n        redact: <T>(value: T): T => {\n  throwOnPayload = true;\n  await emitEvent(\"logging.message\", { status: \"passed\" });\n  expect(events[1].payload).toMatchObject({ omitted: true });\n  expect(client.isRedactionOmission(events[1])).toBe(true);\n  const snapshot = await inspector.snapshot();\n  expect(snapshot.timelineComplete).toBe(false);\n  expect(snapshot.droppedEvents).toBe(1);\n});\n\nit(\"reconstructs diagnostic discriminators around payload redaction\", async () => {\n  const observed: any[] = [];\n  const target = customTarget({\n    kind: \"custom\",\n    open: async () => { throw new Error(\"unused\"); },\n    redact: <T>(value: T): T => JSON.parse(\n      JSON.stringify(value)\n        .replaceAll(\"transport-close\", \"[REDACTED]\")\n        .replaceAll(\"failed\", \"[REDACTED]\"),\n    ) as T,\n  });\n  const client = new McpFnClient({ target, diagnostics: event => { observed.push(event); } });\n  const dispatch = (client as unknown as {\n    dispatch(event: Record<string, unknown>): Promise<void>;\n  }).dispatch.bind(client);\n  await dispatch({\n    phase: \"transport-close\",\n    outcome: \"failed\",\n    requestId: \"request\",\n    at: new Date(0).toISOString(),\n    target: { kind: \"custom\" },\n    details: { phase: \"transport-close\", outcome: \"failed\" },\n  });\n  expect(observed[0]).toMatchObject({\n    details: { omitted: true },\n  });\n  expect(client.isRedactionOmission(observed[0])).toBe(true);\n  expect(JSON.stringify(observed[0])).not.toContain(\"transport-close\");\n  expect(JSON.stringify(observed[0])).not.toContain(\"failed\");\n});\n\nit(\"redacts failed-open diagnostics after releasing malformed credentials\", async () => {\n  const secret = \"private-header-first\\nprivate-header-second\";\n  const events: unknown[] = [];\n  const client = new McpFnClient({\n    target: authenticatedHttpTarget(\"http://127.0.0.1:1/mcp\", { credential: { headers: { \"x-api-key\": secret } } }),\n    diagnostics: event => { events.push(event); },\n  });\n  const fetch = vi.spyOn(globalThis, \"fetch\").mockRejectedValue(new Error(\"Unexpected outbound request\"));\n  try {\n    await expect(client.connect()).rejects.toThrow();\n    expect(fetch).not.toHaveBeenCalled();\n  } finally { fetch.mockRestore(); }\n  expect(events.length).toBeGreaterThan(0);\n  expect(JSON.stringify(events)).not.toContain(\"private-header-first\");\n  expect(JSON.stringify(events)).not.toContain(\"private-header-second\");\n  await client.close();\n});\n\nit.each([\"custom\", \"connected\", \"mcpfn.inspector-snapshot\"])(\"fails closed when snapshot structure matches custom credential %s\", async secret => {\n  const fixture = await startAuthenticatedServer(\"server-key\", true);\n  const target = authenticatedHttpTarget(fixture.url, { credential: { headers: { authorization: \"Bearer server-key\" } } });\n  const original = target.redact!.bind(target);\n  target.redact = <T>(value: T, options): T => {\n    const redacted = original(value, options);\n    if (options?.preserveKeys !== false) return redacted;\n    return JSON.parse(JSON.stringify(redacted).replaceAll(secret, \"[REDACTED]\"));\n  };\n  target.describe = () => ({ kind: \"custom\", label: secret });\n  const inspector = new McpFnInspector(new McpFnClient({ target }));\n  try {\n    await inspector.connect();\n    const error = await inspector.snapshot().then(\n      () => { throw new Error(\"Expected structural collision\"); },\n      failure => failure as Error,\n    );\n    expect(error.message).toBe(\"MCP artifact structure conflicts with credential redaction\");\n    expect(error.message).not.toContain(secret);\n  } finally {\n    try { await inspector.close(); } finally { await fixture.close(); }\n  }\n});\n\n\nit(\"replaces unsafe live event kinds with marked omissions\", async () => {\n  const fixture = await startAuthenticatedServer(\"server-key\", true);\n  const target = authenticatedHttpTarget(fixture.url, { credential: { headers: { authorization: \"Bearer server-key\" } } });\n  const original = target.redact!.bind(target);\n  target.redact = <T>(value: T): T => JSON.parse(JSON.stringify(original(value)).replaceAll(\"logging.message\", \"[REDACTED]\"));\n  const events: any[] = [];\n  const client = new McpFnClient({ target, events: event => { events.push(event); } });\n  try {\n    await client.connect();\n    await client.tools.call(\"identity\", {});\n    expect(events.some(event => event.kind === \"logging.message\")).toBe(false);\n    expect(events.some(event => client.isRedactionOmission(event))).toBe(true);\n    expect(JSON.stringify(events)).not.toContain(\"logging.message\");\n  } finally { try { await client.close(); } finally { await fixture.close(); } }\n});\n\nit.each([\"tools.call\", \"non-idempotent\", \"none\"])(\"fails closed when an exported scenario discriminator matches %s\", secret => {\n  const client = new McpFnClient({ target: customTarget({ kind: \"custom\", open: async () => { throw new Error(\"unused\"); },\n    redact: <T>(value: T): T => JSON.parse(JSON.stringify(value).replaceAll(secret, \"[REDACTED]\")),\n  }) });\n  const inspector = new McpFnInspector(client);\n  expect(() => secret === \"none\"\n    ? inspector.exportScenario(secret, { kind: \"resources.read\", uri: \"test://resource\" }, { contents: [] })\n    : inspector.exportScenario(secret, { kind: \"tools.call\", name: \"echo\" }, { content: [] }))\n    .toThrow(\"MCP artifact structure conflicts with credential redaction\");\n});\n\nit(\"fails closed when a credential matches an exported scenario key\", () => {\nimport {\n  McpFnClientError,\n  customTarget,\n  streamableHttpTarget,\n  type McpFnStreamableHttpTargetOptions,\n  type McpFnTarget,\n  type McpFnTransportHandle,\n} from \"@mcpfn/client\";\n\nimport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n\ntype SecretState = { active: Map<string, number>; scopes: Set<Set<string>> };\nconst targetSecrets = new WeakMap<McpFnTarget, SecretState>();\nconst utf8Encoder = new TextEncoder();\n\n/** Retain released credentials only for the lifetime of a report operation. */\nexport function beginTargetCredentialRedaction(target: McpFnTarget): () => void {\n  const state = targetSecrets.get(target);\n  if (!state) return () => undefined;\n  const scope = new Set(state.active.keys());\n  state.scopes.add(scope);\n  return () => { state.scopes.delete(scope); scope.clear(); };\n}\n\nfunction credentialValues(headers: HeadersInit): Set<string> {\n  const values = boundedCredentialEntries(headers);\n  const secrets = new Set<string>();\n  for (const [header, raw] of values) {\n    if (!raw.trim()) continue;\n    secrets.add(raw);\n    secrets.add(raw.trim());\n    const normalizedHeader = header.toLowerCase();\n    if ([\"authorization\", \"proxy-authorization\"].includes(normalizedHeader)) {\n      addAuthorizationSecrets(raw, secrets);\n    }\n    if (normalizedHeader === \"cookie\") addCookieSecrets(raw, secrets);\n  }\n  return secrets;\n}\n\nfunction addAuthorizationSecrets(raw: string, secrets: Set<string>): void {\n  const trimmed = raw.trim();\n  const separator = trimmed.search(/\\s/);\n  if (separator <= 0) return;\n  const scheme = trimmed.slice(0, separator).toLowerCase();\n  const token = trimmed.slice(separator).trim();\n  if (token) secrets.add(token);\n  if (scheme !== \"basic\") {\n    if (scheme !== \"bearer\" && !authorizationToken68.test(token)) {\n      addAuthorizationParameterSecrets(token, secrets);\n    }\n    return;\n  }\n  if (!/^[\\dA-Za-z+/]+={0,2}$/.test(token)) return;\n  const decoded = Buffer.from(token, \"base64\");\n  // Round-trip validation avoids interpreting malformed tokens as credentials.\n  if (stripBase64Padding(decoded.toString(\"base64\")) !== stripBase64Padding(token)) return;\n  for (const encoding of [\"utf8\", \"latin1\"] as const) {\n    const pair = decoded.toString(encoding);\n    const colon = pair.indexOf(\":\");\n    if (colon < 0) continue;\n    for (const value of [pair, pair.slice(0, colon), pair.slice(colon + 1)]) {\n      if (value) secrets.add(value);\n    }\n  }\n}\n\nconst authorizationToken68 = /^[\\dA-Za-z._~+\\/-]+=*$/;\nconst authorizationParameterName = /^[!#$%&'*+.^_`|~\\dA-Za-z-]+$/;\n\ninterface ParsedAuthorizationValue {\n  cursor: number;\n  components: string[];\n}\n\nfunction skipAuthorizationWhitespace(token: string, cursor: number): number {\n  while (token[cursor] === \" \" || token[cursor] === \"\\t\") cursor += 1;\n  return cursor;\n}\n\nfunction parseQuotedAuthorizationValue(token: string, start: number): ParsedAuthorizationValue {\n  let cursor = start + 1;\n  let decoded = \"\";\n  while (cursor < token.length && token[cursor] !== '\"') {\n    if (token[cursor] === \"\\\\\") {\n      cursor += 1;\n      if (cursor >= token.length) {\n        throw new TypeError(\"Authorization credential parameters must use balanced quotes\");\n      }\n    }\n    decoded += token[cursor];\n    cursor += 1;\n  }\n  if (token[cursor] !== '\"') {\n    throw new TypeError(\"Authorization credential parameters must use balanced quotes\");\n  }\n  cursor += 1;\n  const rawValue = token.slice(start, cursor);\n  return {\n    cursor,\n    components: [rawValue, rawValue.slice(1, -1), decoded].filter(Boolean),\n  };\n}\n\nfunction parseUnquotedAuthorizationValue(token: string, start: number): ParsedAuthorizationValue {\n  let cursor = start;\n  while (cursor < token.length && token[cursor] !== \",\") cursor += 1;\n  const value = token.slice(start, cursor).trim();\n  if (!value || /\\s/.test(value) || value.includes('\"')) {\n    throw new TypeError(\"Authorization credential parameters must contain valid values\");\n  }\n  return { cursor, components: [value] };\n}\n\nfunction parseAuthorizationParameter(token: string, start: number): ParsedAuthorizationValue {\n  let cursor = skipAuthorizationWhitespace(token, start);\n  const nameStart = cursor;\n  while (cursor < token.length && token[cursor] !== \"=\" &&\n    token[cursor] !== \" \" && token[cursor] !== \"\\t\" && token[cursor] !== \",\") cursor += 1;\n  const name = token.slice(nameStart, cursor);\n- Invalid / Accepted Risk: the 3 remaining Sonar `throw this` findings are invalid because exact error identity is the cleanup ownership token; the older payload-key-redaction finding retains its prior invalid disposition. No accepted risks.\n- Not Attempted: 0 valid code root causes. Both new review roots and both valid current Sonar findings were attempted in the single coordinated batch; hosted reviewer/analyzer confirmation is deferred to a future separately scheduled snapshot because post-push refetch is forbidden.\n- Unassessed: 0 captured threads, nested comments, review bodies, issue comments, raw inline comments, or current Sonar issues.\n\n## Round 12 verification evidence\n\n- Focused regressions: 37 target-suite tests and 92 remote-target tests passed (129 total). New cases prove dynamic normalized failure phases are admitted only after live-redactor classification; quoted, escaped, decoded, raw-inner, and unquoted structured authorization components redact; malformed auth-param lists reject; and their credential lease is revoked exactly once. Existing simple custom-scheme and Basic behavior remained green.\n- Complete affected-package suite: all 241 `@mcpfn/testing` tests passed. The package typechecked and built successfully under Node 22.\n- Release gate: the final `PATH=/opt/homebrew/opt/node@22/bin:$PATH npm run gate:mcpfn-release` passed every reported dependency/package test, typecheck, and build; Playwright; mixed-entry redaction; official conformance; examples; ESM/CJS imports; dry-run packs; packed-consumer installation; and round trips. The first gate attempt identified only an absent pinned Playwright browser; installing that exact test runtime resolved the environment gap, and the final gate passed against the final code state.\n- `git diff --check` passed. Whole-batch review covered all four code/test files and decomposed the structured-credential parser to avoid a new complexity hotspot. The ledger remained untracked and will not be staged or committed.\n- Required-check snapshot: the single pre-mutation snapshot contained 18 contexts: 13 successful, 1 neutral, 3 skipped, and 1 pending CodeRabbit context. Sonar Quality Gate passed with 2 valid and 3 invalid current findings. No hosted checks or reviews were fetched after the snapshot.\n- Fix-induced regressions: the first focused dynamic-phase test incorrectly exercised the client's intentional raw-open normalization to `transport-connect`; the final test exercises the actual target-redactor normalization boundary. No regression remained after focused tests, the complete package suite, typecheck/build, whole-diff review, or the final release gate.\n\n## Round 12 convergence\n\n- Trend: improving but nonterminal. All selected review and valid analyzer roots have coordinated repairs and no local regression remains, but this code-changing round cannot be clean and the sole immediate check snapshot contained a pending reviewer context.\n- Valid blocking root causes before / after: 2 new review roots plus 2 valid analyzer findings / 0 deliberately deferred valid code roots, with hosted verification pending a future separately scheduled assessment.\n- New defects: structured authorization component leakage and omission of a dynamic normalized failure phase from the live structural-safety candidate set.\n- Recurring families: credential discovery and structural safety recurred; both were repaired at shared producer/finalization boundaries.\n- Clean streak: `0` (reset by new/actionable roots, recurring families, this code-changing round, and the pending required check in the sole snapshot).\n- Head stability before mutation: the complete snapshot stayed at `9ee45f4385f3b354f0e27396fe0e86dafa5ee41f` throughout assessment. Final local/remote/PR head evidence will be recorded after the one allowed push and one allowed comparison.\n\n## Round 12 completion\n\n- Commit / push: one commit `d12812dfae99cc0905aa93365f9b9ed5c42065f2` (`fix(mcpfn): harden credential report safety`) and one successful push through existing `origin` to `codex/mcp-1-transport-neutral-conformance-0910`.\n- Head verification (one comparison only): local head, `origin/codex/mcp-1-transport-neutral-conformance-0910`, and PR 170 head all equal `d12812dfae99cc0905aa93365f9b9ed5c42065f2`; PR 170 remained open. The branch was `+0/-0`, and the only remaining worktree item was the untracked `.conduct/` ledger directory.\n- Head stability: the assessed head remained `9ee45f4385f3b354f0e27396fe0e86dafa5ee41f` through selection and verification; the single commit and push advanced local, remote, and PR head together to `d12812dfae99cc0905aa93365f9b9ed5c42065f2` in the one allowed post-push comparison.\n- Result: nonterminal recurring run. A future separately scheduled assessment must inspect the new head's complete review/check surfaces once; this code-changing round cannot count toward the clean streak.\n- Automation `4442e7f3-60f4-4125-a8e4-c818ac40fc82` remains disabled from the earlier retrieval-discovery stop and was not silently re-enabled during this manual round.\n- No post-push review refetch, CI poll, reviewer wait, thread resolution, review dismissal, merge, or second fix loop was performed.\n\n## Round 13 assessment\n\n- Hosted workflow: `21n/pr-refetch-fix@1.2.0`, revision `4`, digest `sha256:8781c1c12fe9d5902337d6cf21bfbac49dd3a94c7eadd46bf2622db350444022` (published identity verified through Skillplane via Composio before repository mutation).\n- Mode: assessment reset. The prior clean streak remains `0`; a newly exposed sibling in the credential-grammar family requires another broader contract assessment before mutation.\n- Snapshot / head: local, upstream, all review pages, and PR head were stable at `d12812dfae99cc0905aa93365f9b9ed5c42065f2`. The complete one-time snapshot contains 337 threads (95 unresolved: 34 current and 61 outdated-only), 235 reviews, 64 issue comments, 379 raw inline comments, 3 current Sonar issues, and 18 check contexts. All thread and nested-comment pagination was terminal.\n- Shared invariant: an authorization credential must be classified by its complete grammar before component discovery—opaque token68 values remain supported and are registered whole, while structured auth-param lists register every independently reflectable value or fail closed; report safety evidence must exercise both accepted and colliding dynamic structural values; an external conformance fixture must contain every request-derived parse/await failure inside one response-owning boundary so its Node listener never leaks a rejected promise.\n- Producers / consumers: credential headers produce either token68 or auth-param values consumed by target opening, redaction, reports, and JUnit; target-owned redactors produce normalized failure phases consumed by suite structure validation; Node request metadata and bodies feed the external Web `Request`, official SDK transport, CLI scenarios, release gate, and packed-consumer smoke tests.\n- Failure boundaries: padded token68 under custom schemes, Basic and Bearer compatibility, quoted/unquoted auth-param lists, dynamic failure phases that pass through or collide with target redaction, malformed Host values before body/auth work, oversized bodies, post-header errors, and fixture session cleanup.\n- Coordinated repair: recognize the RFC token68 alphabet and terminal padding before invoking auth-param parsing while retaining whole-token registration; keep the existing safe-phase regression and add the complementary collision rejection proof; replace the async Node listener with a synchronous delegator to one fully guarded async request handler, returning a controlled 400 for invalid request URLs and preserving existing 401/404/413/500 behavior; extend the real external-server probe so malformed Host input proves a 400 response and server survival.\n- Verification criteria: focused token68/auth-param and suite structural tests; direct external-fixture malformed-Host/server-survival execution; complete affected package suites/typechecks/builds; Node 22 release gate; `git diff --check`; whole-batch diff review; and one final local/remote/PR-head comparison. Hosted review/check surfaces will not be fetched again this round.\n\n### Round 13 defect families\n\n| Stable family | Root cause / affected contract | Disposition | First seen | Last attempted | Repair / evidence state |\n| --- | --- | --- | --- | --- | --- |\n| `MCP170-AUTHORIZATION-CREDENTIAL-GRAMMAR` | Non-Bearer token68 with `=` padding is mistaken for an auth-param list and rejected before transport | Actionable; recurring credential-discovery family | round 13 | round 13 | Full-grammar token68 discrimination selected at the authorization producer |\n| `MCP170-DYNAMIC-FAILURE-PHASE-EVIDENCE` | The safe dynamic-phase regression does not prove collision rejection, so removal of final phase validation could escape detection | Actionable test-evidence gap; recurring structural-safety family | round 13 | round 13 | Complementary target-redactor collision regression selected |\n| `MCP170-EXTERNAL-FIXTURE-REQUEST-BOUNDARY` | Request URL construction