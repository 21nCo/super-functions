r':paths['devdir'],'XDG_CACHE_HOME':paths['xdg'],'WRANGLER_SEND_METRICS':'false','PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD':'1','TURBO_TELEMETRY_DISABLED':'1'};owners=[(context,product,V/product/'docs' if context=='root' else pathlib.Path(sa['slots'][product])) for context in ['root','standalone'] for product in ['extfn','authfn','filefn']];result=A/'controlled213-six-native-contexts-results.json';assert not result.exists();results=[];pre={};archive=A/'controlled213-static-preimages.tar.gz';assert not archive.exists()\ninputs={'__native213_flat.md':'---\\ntitle: Native213 Flat\\n---\\n[Related sibling](./__native213_sibling.md)\\n','__native213_flat/child.md':'---\\ntitle: Native213 Child\\n---\\nDescendants do not turn flat.md into index.md.\\n','__native213_sibling.md':'---\\ntitle: Native213 Sibling\\n---\\nRelated sibling page.\\n','__native213_index/index.md':'---\\ntitle: Native213 Index\\n---\\n[Related sibling](../__native213_sibling.md)\\n','__native213_unicode/主.md':'---\\ntitle: Native213 Unicode\\n---\\nActual source identity.\\n','__native213_private.md':'---\\ntitle: Unrelated private marker\\n---\\nPRIVATE_213_DOC_TOKEN\\n'}\nwith tarfile.open(archive,'w:gz') as tar:\n for context,product,owner in owners:\n  for name in ['llms.txt','llms-full.txt']:\n   f=owner/'static'/name;key=context+'/'+product+'/'+name;b=f.read_bytes();mode=stat.S_IMODE(f.stat().st_mode);pre[key]=(b,mode);info=tarfile.TarInfo(key);info.size=len(b);info.mode=mode;tar.addfile(info,io.BytesIO(b))\nwith tarfile.open(archive,'r:gz') as tar:\n for m in tar.getmembers():assert tar.extractfile(m).read()==pre[m.name][0] and m.mode==pre[m.name][1]\ndef run(label,owner,args):\n log=A/(label+'.log');assert not log.exists();r=subprocess.run(args,cwd=owner,env=env,capture_output=True);log.write_bytes(r.stdout+r.stderr);results.append({'label':label,'exitCode':r.returncode,'physicalOwner':str(owner),'command':args});assert r.returncode==0,label\ntry:\n for context,product,owner in owners:\n  created=[];prefix=f'controlled213-{context}-{product}'\n  try:\n   assert all(not (owner/'content/docs'/name).exists() for name in inputs)\n   for name,body in inputs.items():f=owner/'content/docs'/name;f.parent.mkdir(parents=True,exist_ok=True);f.write_text(body);created.append(f)\n   run(prefix+'-actual-build',owner,['npm','run','build']);run(prefix+'-compiled-provider-link-payload-oracle',owner,['node',str(A/'verify-controlled-native-docs.mjs'),str(owner),product])\n  finally:\n   for f in created:\n    assert f.read_text()==inputs[str(f.relative_to(owner/'content/docs'))];f.unlink()\n   for name in ['llms.txt','llms-full.txt']:\n    b,mode=pre[context+'/'+product+'/'+name];f=owner/'static'/name;f.write_bytes(b);f.chmod(mode);assert f.read_bytes()==b and stat.S_IMODE(f.stat().st_mode)==mode\n   results.append({'context':context,'product':product,'sixControlledFilesRestoredOriginalAbsence':True,'generatedStaticBytesModesRestored':True})\n  run(prefix+'-pristine-build-after-restoration',owner,['npm','run','build'])\nfinally:\n result.write_text(json.dumps({'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'results':results,'inputsPerOwner':6,'generatedPreimageArchive':str(archive),'qualification':'Six actual current installed owners, one native process per root receiver. Controlled input absence and generated preimages restored, pristine build after restoration required and separately recorded. No additional application root or installation.'},indent=2)+'\\n')\nprint('Six native compiled provider/link/Unicode/error/decoded DTO contexts passed; inputs restored and pristine rebuilt.')\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":1517,"output":1386,"cacheRead":247680,"cacheWrite":0,"reasoning":215,"totalTokens":250583,"cost":{"input":0.003034,"output":0.01386,"cacheRead":0.024768000000000002,"cacheWrite":0,"total":0.041662000000000005}},"stopReason":"toolUse","timestamp":1791352511279,"responseId":"resp_055fb7