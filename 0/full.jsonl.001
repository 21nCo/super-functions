ments/dev/n/worktrees/superfunctions/PR-170/mcpfn/testing/tests/suite.test.ts\\n@@\\n it(\\\"does not repeat successful custom cleanup after an open failure\\\", async () => {\\n@@\\n   expect(report.incompleteReason).not.toContain(\\\"Target cleanup failed\\\");\\n });\\n+\\n+it(\\\"proves a target-supplied failure phase safe before emitting it\\\", async () => {\\n+  const failure = Object.assign(new Error(\\\"cannot open\\\"), { phase: \\\"vendor-phase\\\" });\\n+  const report = await runMcpFnTargetSuite({ target: customTarget({\\n+    kind: \\\"failed-open\\\", open: async () => { throw failure; },\\n+  }) });\\n+  expect(report).toMatchObject({\\n+    ok: false,\\n+    status: \\\"incomplete\\\",\\n+    failure: { phase: \\\"vendor-phase\\\" },\\n+  });\\n+});\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a0c31e-6a96-7383-bda9-a191f2448a61","create_time":1789980431.459246}}}
