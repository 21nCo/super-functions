ation\", \"transport-close\"]),\n   129\t  ] as [string, Set<string>]),\n   130\t  [\"failure:layer\", new Set([\"mcpfn-preflight\", \"authorization-server\", \"resource-server\", \"mcp-initialization\", \"scenario\", \"upstream-conformance\"])],\n   131\t  [\"inspectorEvent:source\", new Set([\"diagnostic\", \"client\"])],\n   132\t  [\"result:sideEffect\", new Set([\"none\", \"idempotent\", \"non-idempotent\"])],\n   133\t]);\n   134\t\n   135\tconst unrestrictedStructuralValueFields = new Set([\n   136\t  \"packages:testing\",\n   137\t  \"runtime:node\",\n   138\t  \"runtime:reportSchemaVersion\",\n   139\t  \"root:suiteVersion\",\n   140\t]);\n   141\t\n   142\tfunction specialValue(input: unknown): unknown {\n   143\t  if (input instanceof Error) return normalizeErrorValue(input);\n   144\t  if (input instanceof Date) return Number.isNaN(input.getTime()) ? \"Invalid Date\" : input.toISOString();\n   145\t  if (input instanceof URL) return input.href;\n   146\t  if (input instanceof Map) {\n   147\t    if (Object.getOwnPropertyDescriptor(Map.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   148\t    return { type: \"Map\", entries: [...Map.prototype.entries.call(input)] };\n   149\t  }\n   150\t  if (input instanceof Set) {\n   151\t    if (Object.getOwnPropertyDescriptor(Set.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   152\t    return { type: \"Set\", values: [...Set.prototype.values.call(input)] };\n   153\t  }\n   154\t  return input;\n   155\t}\n   156\t\n   157\tfunction normalizeErrorValue(input: Error): Record<string, unknown> {\n   158\t  // Error instances may expose attacker-controlled enumerable keys. A\n   159\t  // null-prototype accumulator keeps `__proto__` as ordinary payload data.\n   160\t  const normalized = Object.create(null) as Record<string, unknown>;\n   161\t  let enumerableFields = 0;\n   162\t  for (const key in input) {\n   163\t    if (!Object.hasOwn(input, key)) continue;\n   164\t    if (++enumerableFields > 100_000) throw new McpFnRedactionLimitError();\n   165\t    normalized[key] = (input as unknown as Record<string, unknown>)[key];\n   166\t  }\n   167\t  normalized.name = input.name;\n   168\t  normalized.message = inp…2752 tokens truncated…e(error instanceof Error ? error.message : String(error)),\n    53\t  );\n    54\t  const cause = error && typeof error === \"object\"\n    55\t    ? (error as { cause?: unknown }).cause\n    56\t    : undefined;\n    57\t  const redactedCause = cause === undefined\n    58\t    ? undefined\n    59\t    : redactOAuthValue(cause, {\n    60\t      maxDepth: 4,\n    61\t      maxArrayEntries: 20,\n    62\t      maxObjectEntries: 20,\n    63\t      maxStringLength: 1_024,\n    64\t    });\n    65\t  const causeRecord = redactedCause && typeof redactedCause === \"object\" &&\n    66\t      !Array.isArray(redactedCause)\n    67\t    ? redactedCause as Record<string, unknown>\n    68\t    : undefined;\n    69\t  const causeMessage = stringField(causeRecord?.message);\n    70\t  if (causeMessage && !message.includes(causeMessage)) message = `${message}: ${causeMessage}`;\n    71\t  const combinedDetails = causeRecord ? { ...details, cause: causeRecord } : details;\n    72\t  const layer = failureLayer(phase);\n    73\t  const deniedByResource = layer !== \"authorization-server\" &&\n    74\t    [causeRecord?.code, causeRecord?.status, record.code, record.status]\n    75\t      .some(value => [401, 403].includes(Number(value)));\n    76\t  return {\n    77\t    name: stringField(record.name) ?? \"Error\",\n    78\t    message,\n    79\t    layer: deniedByResource ? \"resource-server\" : layer,\n    80\t    ...(stringField(record.code) ? { code: stringField(record.code)! } : {}),\n    81\t    ...(phase ? { phase } : {}),\n    82\t    ...(combinedDetails ? { details: combinedDetails } : {}),\n    83\t  };\n    84\t}\n    85\t\n    86\t/** Serialize a redacted target-suite report as bounded JUnit XML. */\n    87\texport function createMcpFnTargetSuiteJUnit(\n    88\t  report: McpFnTargetSuiteReport,\n    89\t  options: McpFnJunitOptions = {},\n    90\t): string {\n    91\t  const maxBytes = options.maxBytes ?? 1_048_576;\n    92\t  validateArtifactCap(maxBytes);\n    93\t  const safe = redactOAuthValue(report, {\n    94\t    maxDepth: 10,\n    95\t    maxArrayEntries: 1_000,\n    96\t    maxObjectEntries: 200,\n    97\t    maxStringLength: 4_096,\n    98\t  }) as unknown as McpFnTargetSuiteReport;\n    99\t  // Redaction appends a string sentinel when an array exceeds its cap.\n   100\t  const results = safe.results.filter((result) => result && typeof result === \"object\" && typeof result.name === \"string\");\n   101\t  const omitted = report.results.length - results.length;\n   102\t  const cases = results.map((result) => {\n   103\t    const duration = Math.max(0, result.durationMs ?? 0) / 1_000;\n   104\t    let failure = \"\";\n   105\t    if (result.status !== \"passed\") {\n   106\t      const failureType = result.status === \"failed\" ? \"scenario\" : \"incomplete\";\n   107\t      failure = junitFailure(result.error ?? `Scenario ${result.status}`, failureType);\n   108\t    }\n   109\t    return `    <testcase name=\"${xml(result.name)}\" classname=\"mcpfn.scenario\" time=\"${duration.toFixed(3)}\">${failure}</testcase>`;\n   110\t  });\n   111\t  if (safe.failure) {\n   112\t    cases.unshift(\n   113\t      `    <testcase name=\"${xml(safe.failure.phase ?? \"target\")}\" classname=\"mcpfn.${xml(safe.failure.layer)}\" time=\"0.000\">${junitFailure(safe.failure.message, safe.failure.code ?? safe.failure.layer)}</testcase>`,\n   114\t    );\n   115\t  }\n   116\t  if (safe.status === \"incomplete\" || omitted > 0 || (!safe.ok && !safe.failure && results.every((result) => result.status === \"passed\"))) {\n   117\t    cases.push(`    <testcase name=\"suite-incomplete\" classname=\"mcpfn.report\" time=\"0.000\">${junitFailure(safe.incompleteReason ?? \"Suite evidence is incomplete or omitted\", \"incomplete\")}</testcase>`);\n   118\t  }\n   119\t  if (cases.length === 0) {\n   120\t    cases.push(\n   121\t      '    <testcase name=\"target-suite\" classname=\"mcpfn.target\" time=\"0.000\"></testcase>',\n   122\t    );\n   123\t  }\n   124\t  const failures = cases.filter((entry) => entry.includes(\"<failure \")).length;\n   125\t  let serialized = junitDocument(safe, cases, failures);\n   126\t  if (bytes(serialized) <= maxBytes) return serialized;\n   127\t\n   128\t  const boundedCases = [\n   129\t    `    <testcase name=\"artifact-cap\" classname=\"mcpfn.report\" time=\"0.000\">${junitFailure(\"JUnit content exceeded maxBytes and was truncated\", \"incomplete\")}</testcase>`,\n   130\t  ];\n   210\t  async run(operation: McpFnInspectorOperation): Promise<McpFnInspectorOperationResult> {\n   211\t    if (operation.kind === \"tools.call\") {\n   212\t      return this.client.tools.call(operation.name, operation.arguments);\n   213\t    }\n   214\t    if (operation.kind === \"tools.call:task\") {\n   215\t      return this.client.tools.createTask(operation.name, operation.arguments, operation.task);\n   216\t    }\n   217\t    if (operation.kind === \"resources.read\") {\n   218\t      return this.client.resources.read(operation.uri);\n   219\t    }\n   220\t    if (operation.kind === \"resources.subscribe\") {\n   221\t      return this.client.resources.subscribe(operation.uri);\n   222\t    }\n   223\t    if (operation.kind === \"resources.unsubscribe\") {\n   224\t      return this.client.resources.unsubscribe(operation.uri);\n   225\t    }\n   226\t    if (operation.kind === \"prompts.get\") {\n   227\t      return this.client.prompts.get(operation.name, operation.arguments);\n   228\t    }\n   229\t    if (operation.kind === \"tasks.get\") return this.client.tasks.get(operation.taskId);\n   230\t    if (operation.kind === \"tasks.result\") return this.client.tasks.result(operation.taskId);\n   231\t    if (operation.kind === \"tasks.cancel\") return this.client.tasks.cancel(operation.taskId);\n   232\t    return this.client.tasks.list(operation.cursor);\n   233\t  }\n   234\t\n   235\t  exportScenario(\n   236\t    name: string,\n   237\t    operation: McpFnInspectorOperation,\n   238\t    result: McpFnInspectorOperationResult,\n   239\t  ): McpFnExportedScenario {\n   240\t    const scenario = createMcpFnScenario(name, operation, result);\n   241\t    // Top-level scenario keys are authored schema, not payload. If a credential\n   242\t    // collides with one of them, no replayable typed artifact can be emitted.\n   243\t    for (const key of [\n   244\t      ...Object.keys(scenario),\n   245\t      \"status\",\n   246\t      \"incompleteReason\",\n   247\t      \"variables\",\n   248\t    ]) {\n   249\t      this.client.preserveArtifactStructure(key);\n   250\t    }\n   251\t    const { formatVersion, kind, sideEffect, ...payload } = scenario;\n   252\t    if (kind === undefined || sideEffect === undefined) {\n   253\t      throw new Error(\"Inspector scenario export requires normalized structure\");\n   254\t    }\n   255\t    const safeKind = this.client.preserveArtifactStructure(kind);\n   256\t    const safeSideEffect = this.client.preserveArtifactStructure(sideEffect);\n   257\t    const secretMarker = selectScenarioSecretMarker(this.client);\n   258\t    let redacted: Record<string, unknown>;\n   259\t    try {\n   260\t      redacted = {\n   261\t        ...Object.fromEntries(Object.entries(payload).map(([key, value]) => [key, this.client.redact(value, {\n   262\t          ...SCENARIO_REDACTION_LIMITS,\n   263\t          // These are user payloads, even when their keys resemble an envelope.\n   264\t          preserveKeys: false,\n   265\t          redactionMarker: secretMarker ?? \"\",\n   266\t        })])),\n   267\t        formatVersion, kind: safeKind, sideEffect: safeSideEffect,\n   268\t      };\n   269\t    } catch {\n   270\t      return {\n   271\t        formatVersion,\n   272\t        kind: safeKind,\n   273\t        sideEffect: safeSideEffect,\n   274\t        name: \"\",\n   275\t        status: this.client.preserveArtifactStructure(\"incomplete\"),\n   215\t    kind: \"failed-open\", open: async () => { throw new Error(\"cannot open\"); }, cleanup,\n   216\t  }) });\n   217\t  expect(report.ok).toBe(false);\n   218\t  expect(cleanup).toHaveBeenCalledOnce();\n   219\t  expect(report.incompleteReason).not.toContain(\"Target cleanup failed\");\n   220\t});\n   221\t\n   222\t\n   223\tit.each([\"metadata\", \"failure\", \"throwing-redactor\"])(\"applies custom target redaction to finalized suite %s\", async mode => {\n   224\t  const secret = \"custom-owned-secret\";\n   225\t  const server = createMcpFnServer({\n   226\t    info: { name: secret, version: \"1.0.0\" },\n   227\t    registry: new McpFnRegistry().register({\n   228\t      name: \"visible-tool\", description: \"Fixture tool\", inputSchema: { type: \"object\" },\n   229\t      handler: async () => structuredResult({ ok: true }),\n   230\t    }),\n   231\t  });\n   232\t  const target = customTarget({\n   233\t    kind: \"custom\",\n   234\t    descriptor: { label: secret },\n   235\t    redact: <T>(value: T): T => {\n   236\t      if (mode === \"throwing-redactor\") throw new Error(secret);\n   237\t      const plain = value instanceof Error ? { name: value.name, message: value.message } : value;\n   238\t      return JSON.parse(JSON.stringify(plain).replaceAll(secret, \"[REDACTED]\")) as T;\n   239\t    },\n   240\t    open: async () => {\n   241\t      const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();\n   242\t      await server.connect(serverTransport);\n   243\t      return { transport: clientTransport, close: () => server.close() };\n   244\t    },\n   245\t  });\n   246\t  const report = await runMcpFnTargetSuite({\n   247\t    target,\n   248\t    ...(mode === \"failure\" ? { expectedToolNames: [secret] } : {}),\n   249\t  });\n   250\t  expect(JSON.stringify(report)).not.toContain(secret);\n   251\t  if (mode === \"metadata\") {\n   252\t    expect(report.ok).toBe(true);\n   253\t    expect(report.server?.name).toBe(\"[REDACTED]\");\n   254\t    expect(report.target.label).toBe(\"[REDACTED]\");\n   255\t  } else if (mode === \"failure\") {\n   256\t    expect(report.ok).toBe(false);\n   257\t    expect(report.failure?.message).toContain(\"[REDACTED]\");\n   258\t  } else {\n   259\t    expect(report.status).toBe(\"incomplete\");\n   260\t    expect(report.server).toBeUndefined();\n   261\t    expect(report.timeline).toEqual([]);\n   262\t  }\n   263\t});\n   264\t\n   265\tit(\"fails a custom target report closed when its dynamic kind conflicts with redaction\", async () => {\n   266\t  const secretKind = \"custom-kind-owned-secret\";\n   267\t  const server = createMcpFnServer({\n   268\t    info: { name: \"kind-collision\", version: \"1.0.0\" },\n   269\t    registry: new McpFnRegistry(),\n   270\t  });\n   271\t  const target = customTarget({\n   272\t    kind: secretKind,\n   273\t    redact: <T>(value: T): T => JSON.parse(\n   274\t      JSON.stringify(value).replaceAll(secretKind, \"[REDACTED]\"),\n   275\t    ) as T,\n   276\t    open: async () => {\n   277\t      const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();\n   278\t      await server.connect(serverTransport);\n   279\t      return { transport: clientTransport, close: () => server.close() };\n   280\t    },\n   281\t  });\n   282\t\n   283\t  const report = await runMcpFnTargetSuite({ target });\n   284\t\n   285\t  expect(report).toMatchObject({\n   286\t    ok: false,\n   287\t    status: \"incomplete\",\n   288\t    target: { kind: \"custom\" },\n   289\t  });\n   290\t  expect(report.incompleteReason).toContain(\"Credential redaction\");\n   291\t  expect(JSON.stringify(report)).not.toContain(secretKind);\n   292\t});\n   293\t\n   294\t\n   295\tit(\"transfers failed shutdown ownership and serializes safe cleanup retries\", async () => {\n   296\t  const secret = \"private-cleanup-secret\";\n   297\t  const server = createMcpFnServer({ info: { name: \"cleanup\", version: \"1\" }, registry: new McpFnRegistry() });\n   298\t  let fail = true;\n   299\t  const close = vi.fn(async () => { if (fail) throw new Error(secret); await server.close(); });\n   300\t  const target = customTarget({ kind: \"custom\", open: async () => {\n   301\t    const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();\n   302\t    await server.connect(serverTransport);\n   303\t    return { transport: clientTransport, close };\n   304\t  } });\n   305\t  const error = await runMcpFnTargetSuite({ target }).catch(error => error);\n   306\t  expect(error).toBeInstanceOf(McpFnTargetSuiteCleanupError);\n   307\t  expect(error.report.ok).toBe(false);\n   308\t  expect(error.message).not.toContain(secret);\n   309\t  expect(JSON.stringify(error.report)).not.toContain(secret);\n   310\t  const first = error.retryCleanup();\n   311\t  expect(error.retryCleanup()).toBe(first);\n   312\t  await expect(first).rejects.toBe(error);\n   313\t  fail = false;\n   314\t  await Promise.all([error.retryCleanup(), error.retryCleanup()]);\n   315\t  const calls = close.mock.calls.length;\n   316\t  await error.retryCleanup();\n   317\t  expect(close).toHaveBeenCalledTimes(calls);\n   318\t  expect(error.report.ok).toBe(false); // Immutable historical failure evidence.\n   319\t});\n   320\t\n   321\tit.each([\"complete\", \"passed\"])(\"keeps suite structure when a custom secret is %s\", async secret => {\n   322\t  const server = createMcpFnServer({ info: { name: secret, version: \"1\" }, registry: new McpFnRegistry() });\n   323\t  const report = await runMcpFnTargetSuite({ target: customTarget({ kind: \"custom\", descriptor: { label: secret },\n   324\t    redact: <T>(value: T): T => JSON.parse(JSON.stringify(value).replaceAll(secret, \"[REDACTED]\")),\n   325\t    open: async () => {\n   326\t      const [client, remote] = InMemoryTransport.createLinkedPair();\n   327\t      await server.connect(remote);\n   328\t      return { transport: client, close: () => server.close() };\n   329\t    },\n   330\t  }) });\n   331\t  expect(report.status).toBe(\"complete\");\n   332\t  expect(report.kind).toBe(\"mcpfn.target-suite-report\");\n   333\t  expect(report.passed).toBe(0);\n   334\t  expect(report.server?.name).toBe(\"[REDACTED]\");\n   335\t  expect(report.target.label).toBe(\"[REDACTED]\");\n   336\t});\n   337\t\n   338\tit(\"uses payload redaction for standalone suite projections\", async () => {\n   339\t  const secret = \"passed\";\n   340\t  const server = createMcpFnServer({\n   341\t    info: { name: secret, version: \"1\" },\n   342\t    registry: new McpFnRegistry().register({\n   343\t      name: secret,\n   344\t      description: \"Fixture tool\",\n   345\t      inputSchema: { type: \"object\" },\n   346\t      handler: async () => structuredResult({ ok: true }),\n   347\t    }),\n   348\t  });\n   349\t  const modes: Array<boolean | undefined> = [];\n   350\t  const report = await runMcpFnTargetSuite({\n   351\t    target: customTarget({\n   352\t      kind: \"custom\",\n   353\t      descriptor: { label: secret },\n   354\t      redact: <T>(value: T, options?: { preserveKeys?: boolean }): T => {\n   355\t        modes.push(options?.preserveKeys);\n   356\t        if (options?.preserveKeys !== false) return value;\n   357\t        return JSON.parse(JSON.stringify(value).replaceAll(secret, \"[REDACTED]\")) as T;\n   358\t      },\n   359\t      open: async () => {\n   360\t        const [client, remote] = InMemoryTransport.createLinkedPair();\n   361\t        await server.connect(remote);\n   362\t        return { transport: client, close: () => server.close() };\n   363\t      },\n   364\t    }),\n   365\t    scenarios: [{ name: secret, tool: secret }],\n   366\t  });\n   367\t\n   368\t  expect(modes).toContain(false);\n   369\t  expect(report.status).toBe(\"complete\");\n   370\t  expect(report.results[0]).toMatchObject({\n   371\t    status: \"passed\",\n   372\t    name: \"[REDACTED]\",\n   373\t    tool: \"[REDACTED]\",\n   374\t  });\n   375\t  expect(report.server?.name).toBe(\"[REDACTED]\");\n   376\t  expect(report.target.label).toBe(\"[REDACTED]\");\n   377\t});\n   378\t\n   379\tit(\"delivers diagnostics after exactly one custom redaction and bounds their retained bytes\", async () => {\n   380\t  const server = createMcpFnServer({ info: { name: \"diagnostics\", version: \"1\" }, registry: new McpFnRegistry() });\n   381\t  const observed: unknown[] = [];\n   382\t  let redactionCalls = 0;\n   383\t  const report = await runMcpFnTargetSuite({ maxReportBytes: 1024,\n   384\t    client: { diagnostics: event => { observed.push(event); } },\n   385\t    target: customTarget({ kind: \"custom\", redact: <T>(value: T): T => {\n   480\t  const persisted = JSON.parse(JSON.stringify(report));\n   481\t  const expected = amount instanceof Map\n   482\t    ? { type: \"Map\", entries: [[\"key\", \"evidence\"]] }\n   483\t    : { type: \"Set\", values: [\"evidence\"] };\n   484\t  expect(persisted.timeline.find((event: { details?: { amount?: unknown } }) =>\n   485\t    event.details?.amount !== undefined,\n   486\t  )?.details.amount).toEqual(expected);\n   487\t  expect(() => JSON.stringify(report)).not.toThrow();\n   488\t});\n   489\t\n   490\t\n   491\tit.each([\"stdio\", \"streamable-http\", \"authenticated-streamable-http\"])(\"preserves %s connection failure with an unchecked manifest\", async kind => {\n   492\t  const server = createMcpFnServer({ info: { name: \"manifest\", version: \"1\" }, registry: new McpFnRegistry() });\n   493\t  const report = await runMcpFnTargetSuite({ manifest: server.manifest(), target: customTarget({ kind,\n   494\t    open: async () => { throw new Error(\"Connection refused\"); },\n   495\t  }) });\n   496\t  expect(report.target.kind).toBe(kind);\n   497\t  expect(report.manifestChecked).toBe(false);\n   498\t  expect(report.manifestHash).toBeUndefined();\n   499\t  expect(report.failure?.phase).toBe(\"transport-connect\");\n   500\t  expect(report.incompleteReason).not.toContain(\"serialization\");\n   501\t  expect(report.ok).toBe(false);\n   502\t});\n   503\t\n   504\tit.each([\"throw\", \"proxy\"])(\"fails closed for a hostile live descriptor (%s)\", async mode => {\n   505\t  const secret = \"hostile-live-descriptor-secret\";\n   506\t  const server = createMcpFnServer({ info: { name: \"fixture\", version: \"1\" }, registry: new McpFnRegistry() });\n   507\t  const close = vi.fn(() => server.close());\n   508\t  const target = customTarget({ kind: \"custom\", open: async () => {\n   509\t    const [client, remote] = InMemoryTransport.createLinkedPair();\n   510\t    await server.connect(remote);\n   511\t    return { transport: client, close };\n   512\t  } });\n   513\t  target.describe = () => {\n   514\t    if (mode === \"throw\") throw new Error(secret);\n   515\t    return new Proxy({ kind: \"custom\" }, { ownKeys() { throw new Error(secret); } });\n   516\t  };\n   517\t  const report = await runMcpFnTargetSuite({ target });\n   518\t  expect(close).toHaveBeenCalledOnce();\n   519\t  expect(report).toMatchObject({ ok: false, status: \"incomplete\", target: { kind: \"custom\" }, results: [], timeline: [] });\n   520\t  expect(report.incompleteReason).toContain(\"safe serialization failed\");\n   521\t  expect(JSON.stringify(report)).not.toContain(secret);\n   522\t});\n   523\t\n   524\t\n   525\tit(\"marks reports incomplete when post-close credential redaction is unavailable\", async () => {\n   526\t  let released = false;\n   527\t  const server = createMcpFnServer({ info: { name: \"fixture\", version: \"1\" }, registry: new McpFnRegistry() });\n   528\t  const report = await runMcpFnTargetSuite({ target: customTarget({ kind: \"custom\",\n   529\t    redact: <T>(value: T): T => { if (released) throw new Error(\"private-redaction-state\"); return value; },\n   530\t    open: async () => {\n   531\t      const [client, remote] = InMemoryTransport.createLinkedPair();\n   532\t      await server.connect(remote);\n   533\t      return { transport: client, close: async () => { await server.close(); released = true; } };\n   534\t    },\n   535\t  }) });\n   536\t  expect(released).toBe(true);\n   537\t  expect(report.status).toBe(\"incomplete\");\n   538\t  expect(report.ok).toBe(false);\n   539\t  expect(report.failure).toBeUndefined();\n   540\t  expect(report.droppedTimelineEvents).toBeGreaterThan(0);\n   541\t  expect(report.incompleteReason).toContain(\"redaction failed\");\n   542\t  expect(report.timeline.some(event => event.code === \"MCPFN_DIAGNOSTIC_REDACTION_FAILED\")).toBe(false);\n   543\t  expect(JSON.stringify(report)).not.toContain(\"private-redaction-state\");\n   544\t});\n   545\t\n   546\t\n   547\tit(\"does not count a target-authored diagnostic code collision as an omission\", async () => {\n   548\t  const server = createMcpFnServer({ info: { name: \"fixture\", version: \"1\" }, registry: new McpFnRegistry() });\n   549\t  const target = customTarget({ kind: \"custom\", open: async context => {\n   550\t    await context.diagnostic({ phase: \"capability-operation\", outcome: \"succeeded\",\n"},"started_at_ms":1789820235561,"completed_at_ms":1789820235562}}
