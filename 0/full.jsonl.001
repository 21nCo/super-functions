oid=m.decode().split();rows[p.decode()]={'mode':mode,'oid':oid,'kind':kind}\n  records[ref]=rows\n return records[ref]\ndef blob(ref,p):\n if (ref,p) not in blobs:blobs[ref,p]=git('cat-file','blob',ref+':'+p) if p in tree(ref) else None\n return blobs[ref,p]\ndef physical(p):\n f=V/p;return os.readlink(f).encode() if f.is_symlink() else f.read_bytes() if f.is_file() else None\nassert git('rev-parse','HEAD').decode().strip()==HEAD and not git('status','--porcelain').strip()\nL=json.loads((R/'parent-ledger.json').read_text());assert L['execution']['current_sequential_sweep']['active_pr']==212 and L['prs']['212']['current_sequential_round']['collection_count']==1\nassert digest((A/'SKILL.md').read_bytes())=='78e6b66300287085d26e1cf15657a5010c6c93d0c2c23a9d4240064a6cdcd91c'\nassert (A/'architecture-reset.md').exists() and (A/'all31-pre-edit-dispositions.json').exists()\nprior=json.loads((A.parent/'PR-211/final-current-source-hashes-and-modes.json').read_text())\nfor p,x in prior.items():\n f=V/p;assert digest(physical(p))==x['sha256'],('retained211 drift',p)\n if x['sha256'] is not None:\n  mode='120000' if f.is_symlink() else '100755' if f.stat().st_mode&0o111 else '100644';assert mode==x['gitMode'],p\noriginal=[r['filename'] for r in json.loads((A/'files.json').read_text())];assert len(original)==75\nrestore=json.loads((A.parent/'PR-211/final-current-review-input.json').read_text())['baseChangedPaths']\nwanted={p:blob(BASE,p) for p in restore};owners={p:'restore exact reviewed42a nonapplicable211 source' for p in restore}\ndef put(p,b,owner):wanted[p]=b;owners[p]=owner\nfor p in original:\n if p!='package-lock.json':put(p,blob(HEAD,p),'preserve frozen212 complete original75 feature scope')\n# Coordinate only the same three affected published DocsFn consumers. No CliFn/BotFn feature transfer.\nselected=[]\nfor p in tree(RELATED):\n if p.startswith('scripts/docs-site/') and p!='scripts/docs-site/public-origin.test.mjs':selected.append(p)\n elif p.startswith(('authfn/doc