6hNNmV4JOfJy4Xd5bOFcKPWtfba7EReZdN-szmz-gqN--vMxtc5caOsD0_b2IMjDp-b6kE462qjkhtjm8nGhlevA0nqkfv_PfRK84mi_nBV_DK0IofI-7LTW7POtUl3a90oyuukxT4T1F7cHzEu8iYMmyCuy5ai57hDEc8LrzFm0Mu1GUyBDl2fPfmy9IbzWZSf8hoQMCVKxhUI6lCKYHb5sVl1qbnA760UqVdUw13bGW8ttrntbwKDFRnctgIZoQXaVL8pLKWOAg7kVkRLMbujm6pfJyT2piBXnZoFljpCJQOLslFU3rYKWrMZca-kyvfz-uFl1hJAyfLOyL4kNGpSbCif7Ur9HsYwSwdLvQQBjV8uUqLiHdxm5R3lZeq0A==\",\"summary\":[]}"},{"type":"toolCall","id":"call_CQrsgBBheYWXaNIqd0oPa06B|fc_055fb762f51dfcfc016ac5dc39bbb887d09a65f70259d00bfd","name":"write","arguments":{"path":"/Users/serro/Documents/dev/n/audits/sf-docs-review-20260930/sequential-20261003T184612Z/PR-213/verify-native-vite-http.mjs","content":"import assert from 'node:assert/strict';\nimport path from 'node:path';\nimport fs from 'node:fs';\nimport { createRequire } from 'node:module';\nimport { pathToFileURL } from 'node:url';\nimport { execFileSync } from 'node:child_process';\nimport { createHash } from 'node:crypto';\nconst [treeArg, context, mode = 'positive'] = process.argv.slice(2);\nassert(['root', 'standalone'].includes(context) && ['positive', 'frozen-auth-route-absence'].includes(mode));\nconst tree = path.resolve(treeArg), original = process.cwd();\nconst products = mode === 'positive' ? ['extfn', 'authfn', 'filefn'] : ['authfn'];\nconst slots = context === 'root' ? {} : { extfn: 'devfn' };\nconst hash = (bytes) => createHash('sha256').update(bytes).digest('hex');\nfor (const product of products) {\n const directory = path.join(tree, slots[product] ?? product, 'docs');\n const require = createRequire(path.join(directory, 'package.json'));\n assert.equal(JSON.parse(fs.readFileSync(path.join(directory, 'package.json'))).name, `@${product}/docs`);\n const viteURL = pathToFileURL(require.resolve('vite'));\n const { createServer } = await import(viteURL);\n const saved = [];\n let server;\n try {\n  if (mode === 'frozen-auth-route-absence') {\n   assert.equal(context, 'root');\n   const checkout = '/Users/serro/orca/workspaces/superfunctions/docs-pr-206-review-20260930';\n   const inventory = execFileSync('git', ['-C', checkout, 'ls-tree', '-r', '--name-only', 'f15540d26c2329203c626ccb51eb9108c5bebd84'], { encoding: 'utf8' }).split('\\n');\n   for (const name of ['llms.txt', 'llms-full.txt']) {\n    const relative = `authfn/docs/src/routes/docs/${name}/+server.ts`;\n    assert(!inventory.includes(relative), 'frozen exact route-owner absence required');\n    const target = path.join(tree, relative);\n    const bytes = fs.readFileSync(target), mode = fs.statSync(target).mode & 0o777;\n    saved.push({ target, bytes, mode });\n    fs.unlinkSync(target);\n   }\n  }\n  process.chdir(directory);\n  server = await createServer({ root: directory, server: { host: '127.0.0.1', port: 0, strictPort: true, hmr: false } });\n  await server.listen();\n  const address = server.httpServer.address(); assert(address && typeof address !== 'string');\n  const origin = `http://127.0.0.1:${address.port}`;\n  const results = [];\n  for (const name of ['llms.txt', 'llms-full.txt']) {\n   const response = await fetch(`${origin}/docs/${name}`);\n   if (mode === 'frozen-auth-route-absence') assert.equal(response.status, 404, `native missing advertised endpoint ${name}`);\n   else {\n    assert.equal(response.status, 200);\n    assert.match(response.headers.get('content-type'), /text\\/plain/);\n    assert.equal(hash(Buffer.from(await response.arrayBuffer())), hash(fs.readFileSync(path.join(directory, 'static', name))));\n   }\n   results.push({ endpoint: `/docs/${name}`, status: response.status, nativeBytesVerified: mode === 'positive' });\n  }\n  const search = await fetch(origin + '/docs/search.json'); assert.equal(search.status, 200); assert.match(search.headers.get('content-type'), /json/); await search.json();\n  const page = await fetch(origin + '/docs'); assert.equal(page.status, 200); const html = await page.text(); assert.equal([...html.matchAll(/<title[^>]*>/g)].length, 1);\n  const missing = await fetch(origin + '/docs/__pr213_missing__'); assert.equal(missing.status, 404); const error = await missing.text(); assert.equal([...error.matchAll(/<title[^>]*>/g)].length, 1); assert(/<title[^>]*>[^<]*404/.test(error));\n  console.log(JSON.stringify({ product, context, mode, physicalOwner: directory, viteURL: String(viteURL), endpointResults: results, nativeSearch200: true, normalDocs200SingleTitle: true, error404SingleTitle: true, ownedListenPort: address.port, qualification: mode === 'positive' ? 'Actual installed consumer Vite/Kit development HTTP; no borrowed dependency/parent install or search-source aliases. Compiled preview/hydration/controlled payload gates separate.' : 'Controlled faithful frozen213 route-owner topology through native current installed AuthFn receiver. NOT a complete frozen213 installation/build proof; route files restored byte/mode exactly.' }));\n } finally {\n  if (server) await server.close();\n  process.chdir(original);\n  for (const { target, bytes, mode } of saved) {\n   fs.writeFileSync(target, bytes); fs.chmodSync(target, mode);\n   assert.equal(hash(fs.readFileSync(target)), hash(bytes)); assert.equal(fs.statSync(target).mode & 0o777, mode);\n  }\n }\n}\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":2032,"output":1688,"cacheRead":214912,"cacheWrite":0,"reasoning":408,"totalTokens":218632,"cost":{"input":0.004064,"output":0.016880000000000003,"cacheRead":0.021491200000000002,"cacheWrite":0,"total":0.042435200000000006}},"stopReason":"toolUse","timestamp":1791351840322,"responseId":"resp_055fb762f51dfcfc016ac5dc213b1887d092cbe39368bcc3fe","rawStopReason":"completed","thinkingLevel":"high"}}
