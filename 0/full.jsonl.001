 313\t  try { return initialTargetDescriptor(target); }\n   314\t  catch { return { kind: \"custom\" }; }\n   315\t}\n   316\t\n   317\tfunction projectSuiteArtifacts(\n   318\t  options: RunMcpFnTargetSuiteOptions,\n   319\t  client: McpFnTestClient | undefined,\n   320\t  execution: SuiteExecution,\n   321\t): SuiteProjection {\n   322\t  const fallback: SuiteProjection = {\n   323\t    target: safeInitialTargetDescriptor(options.target), execution,\n   324\t  };\n   325\t  try {\n   326\t    if (client?.session.state !== \"connected\") {\n   327\t      return execution.results.length || execution.server || execution.capabilities\n   328\t        ? { ...fallback, failure: \"serialization\" }\n   329\t        : fallback;\n   330\t    }\n   331\t    let described: McpFnTargetDescriptor;\n   332\t    try { described = options.target.describe(); }\n   333\t    catch { return { ...fallback, failure: \"serialization\" }; }\n   334\t    try {\n   335\t      const { kind, ...descriptor } = described;\n   336\t      return {\n   337\t        target: {\n   338\t          ...redactSuiteArtifact(options.target, descriptor, { preserveKeys: false }),\n   339\t          kind: client.session.preserveArtifactStructure(kind),\n   340\t        },\n   341\t        manifestHash: options.manifest\n   342\t          ? redactSuiteArtifact(options.target, options.manifest.hash, { preserveKeys: false })\n   343\t          : undefined,\n   344\t        execution: {\n   345\t          server: execution.server === undefined\n   346\t            ? undefined\n   347\t            : redactSuiteArtifact(options.target, execution.server, { preserveKeys: false }),\n   348\t          capabilities: execution.capabilities === undefined\n   349\t            ? undefined\n   350\t            : redactSuiteArtifact(options.target, execution.capabilities, { preserveKeys: false }),\n   351\t          results: execution.results.map(result => ({\n   352\t            ...result,\n   353\t            name: redactSuiteArtifact(options.target, result.name, { preserveKeys: false }),\n   354\t            operation: redactSuiteArtifact(options.target, result.operation, { preserveKeys: false }),\n   355\t            ...(result.tool === undefined ? {} : {\n   356\t              tool: redactSuiteArtifact(options.target, result.tool, { preserveKeys: false }),\n   357\t            }),\n   358\t          })),\n   359\t        },\n   360\t      };\n   361\t    } catch {\n   362\t      return { ...fallback, failure: \"redaction\" };\n   363\t    }\n   364\t  } catch {\n   365\t    return { ...fallback, failure: \"serialization\" };\n   366\t  }\n   367\t}\n   368\t\n   369\tconst suiteStructureKeys = [\n   370\t  \"formatVersion\", \"kind\", \"status\", \"runtime\", \"ok\", \"target\", \"server\",\n   371\t  \"capabilities\", \"manifestChecked\", \"manifestHash\", \"total\", \"passed\", \"failed\",\n   372\t  \"incomplete\", \"droppedResults\", \"droppedObservedEvents\",\n   373\t  \"redactionOmittedObservedEvents\", \"incompleteReason\", \"failure\", \"timeline\",\n   374\t  \"droppedTimelineEvents\", \"results\", \"node\", \"scenarioFormatVersion\",\n   375\t  \"reportSchemaVersion\", \"packages\", \"testing\", \"name\", \"message\", \"layer\", \"code\",\n   376\t  \"phase\", \"details\", \"outcome\", \"requestId\", \"at\", \"sideEffect\", \"durationMs\",\n   377\t  \"error\", \"operation\", \"tool\",\n   378\t] as const;\n   379\t\n   380\tconst suiteStructureValues = [\n   381\t  \"mcpfn.target-suite-report\", \"complete\", \"incomplete\", \"passed\", \"failed\",\n   382\t  \"started\", \"succeeded\", \"none\", \"idempotent\", \"non-idempotent\",\n   383\t  \"mcpfn-preflight\", \"authorization-server\", \"resource-server\", \"mcp-initialization\",\n   384\t  \"scenario\", \"upstream-conformance\", \"resource-discovery\",\n   385\t  \"authorization-server-discovery\", \"client-registration\", \"authorization-request\",\n   386\t  \"authorization-callback\", \"token-exchange\", \"token-refresh\", \"token-revocation\",\n   387\t  \"transport-connect\", \"mcp-initialize\", \"capability-operation\", \"transport-close\",\n   388\t  \"authenticated-streamable-http\", \"streamable-http\", \"stdio\", \"in-memory\", \"custom\",\n   389\t] as const;\n   390\t\n   391\tinterface SuiteStructureGuard {\n   392\t  assert(value: string): void;\n   393\t}\n   394\t\n   395\tfunction captureSuiteStructureGuard(\n   396\t  target: McpFnTarget,\n   397\t  projection: SuiteProjection,\n   398\t  diagnostics: SuiteDiagnosticCollector,\n   399\t): SuiteStructureGuard {\n   400\t  const candidates = new Set<string>([\n   401\t    ...suiteStructureKeys,\n   402\t    ...suiteStructureValues,\n   403\t    process.version,\n   404\t    MCPFN_REPORT_SCHEMA_VERSION,\n   405\t    MCPFN_TESTING_VERSION,\n   406\t    projection.target.kind,\n   407\t  ]);\n   408\t  for (const result of projection.execution.results) {\n   409\t    candidates.add(result.status);\n   410\t    if (result.sideEffect) candidates.add(result.sideEffect);\n   411\t  }\n   412\t  for (const event of diagnostics.timeline) {\n   413\t    candidates.add(event.phase);\n   414\t    candidates.add(event.outcome);\n   415\t    if (event.target?.kind) candidates.add(event.target.kind);\n   416\t  }\n   417\t  const safe = new Set<string>();\n   418\t  for (const candidate of candidates) {\n   419\t    try {\n   420\t      if (redactSuiteArtifact(target, candidate, { preserveKeys: false }) === candidate) {\n   421\t        safe.add(candidate);\n   422\t      }\n   423\t    } catch {\n   424\t      // If the live custom scrubber cannot classify a string, fail closed only\n   425\t      // when the final report actually needs that unproven structure.\n   426\t    }\n   427\t  }\n   428\t  return {\n   429\t    assert(value: string): void {\n   430\t      if (!safe.has(value)) throw new McpFnStructuralCredentialCollisionError();\n   431\t    },\n   432\t  };\n   433\t}\n   434\t\n   435\tfunction assertStructureKeys(value: object, guard: SuiteStructureGuard): void {\n   436\t  for (const key of Object.keys(value)) guard.assert(key);\n   437\t}\n   438\t\n   439\tfunction assertTargetStructure(\n   440\t  target: McpFnTargetDescriptor,\n   441\t  guard: SuiteStructureGuard,\n   442\t): void {\n   443\t  guard.assert(\"kind\");\n   444\t  guard.assert(target.kind);\n   445\t}\n   446\t\n   447\tfunction assertSuiteReportStructure(\n   448\t  report: McpFnTargetSuiteReport,\n   449\t  guard: SuiteStructureGuard,\n   450\t): void {\n   451\t  assertStructureKeys(report, guard);\n   452\t  guard.assert(report.kind);\n   453\t  guard.assert(report.status);\n   454\t  assertStructureKeys(report.runtime, guard);\n   455\t  guard.assert(report.runtime.node);\n   456\t  guard.assert(report.runtime.reportSchemaVersion);\n   457\t  assertStructureKeys(report.runtime.packages, guard);\n   458\t  guard.assert(report.runtime.packages.testing);\n   459\t  assertTargetStructure(report.target, guard);\n   460\t  if (report.failure) {\n   461\t    assertStructureKeys(report.failure, guard);\n   462\t    guard.assert(report.failure.layer);\n   463\t    if (report.failure.phase) guard.assert(report.failure.phase);\n   464\t  }\n   465\t  for (const event of report.timeline) {\n   466\t    assertStructureKeys(event, guard);\n   467\t    guard.assert(event.phase);\n   468\t    guard.assert(event.outcome);\n   469\t    if (event.target) assertTargetStructure(event.target, guard);\n   470\t  }\n   471\t  for (const result of report.results) {\n   472\t    assertStructureKeys(result, guard);\n   473\t    guard.assert(result.status);\n   474\t    if (result.sideEffect) guard.assert(result.sideEffect);\n   475\t  }\n   476\t}\n   477\t\n   478\tasync function closeSuiteClient(client: McpFnTestClient | undefined): Promise<{\n   479\t  cleanupFailure?: McpFnReportFailure;\n   480\t  retainedCleanup?: () => Promise<void>;\n   481\t}> {\n   482\t  try {\n   483\t    await client?.close();\n   484\t    return {};\n   485\t  } catch (error) {\n   486\t    let retainedCleanup: (() => Promise<void>) | undefined;\n   487\t    if (error instanceof McpFnTestClientCleanupError) {\n   488\t      retainedCleanup = () => error.retryCleanup();\n   489\t    } else if (client) {\n   490\t      retainedCleanup = () => client.close();\n   491\t    }\n   492\t    const terminal = error instanceof McpFnTestClientCleanupError && error.cause !== undefined\n   493\t      ? error.cause\n   494\t      : error;\n   495\t    const phase = terminal && typeof terminal === \"object\" &&\n   496\t        (terminal as { phase?: unknown }).phase === \"token-revocation\"\n   497\t      ? \"token-revocation\"\n   498\t      : \"transport-close\";\n   499\t    return {\n   500\t      retainedCleanup,\n   501\t      cleanupFailure: normalizeMcpFnReportFailure({\n   502\t        name: \"CleanupError\",\n   503\t        message: \"Target cleanup failed\",\n   504\t        code: \"MCPFN_TARGET_CLEANUP_FAILED\",\n   505\t        phase,\n   506\t      }),\n   507\t    };\n   508\t  }\n   509\t}\n   510\t\n   511\tinterface SuiteConnection {\n   512\t  client?: McpFnTestClient;\n   513\t  manifestChecked: boolean;\n   514\t  failure?: McpFnReportFailure;\n   515\t  execution: SuiteExecution;\n   516\t}\n   517\t\n   518\tasync function connectSuite(\n   519\t  options: RunMcpFnTargetSuiteOptions,\n   520\t  diagnostics: SuiteDiagnosticCollector,\n   521\t): Promise<SuiteConnection> {\n   522\t  let client: McpFnTestClient | undefined;\n   523\t  let manifestChecked = false;\n   524\t  let failure: McpFnReportFailure | undefined;\n   525\t  let execution: SuiteExecution = { results: [] };\n   526\t  try {\n   527\t    client = McpFnTestClient.createTarget(\n   528\t      options.target,\n   529\t      options.clientInfo ?? { name: \"mcpfn-suite\", version: \"0.0.1\" },\n   530\t      {\n   531\t        ...options.client,\n   532\t        diagnostics: event => diagnostics.record(client, event),\n   533\t      },\n   534\t    );\n   535\t    diagnostics.captureBaseline(client);\n   536\t    await client.session.connect();\n   537\t    ({ execution, manifestChecked } = await executeConnectedSuite(client, options));\n   538\t  } catch (error) {\n   539\t    failure = safeTargetFailure(options.target, error);\n   540\t  }\n   541\t  return { client, manifestChecked, failure, execution };\n   542\t}\n   543\t\n   544\tasync function projectAndCloseSuite(\n   545\t  options: RunMcpFnTargetSuiteOptions,\n   546\t  diagnostics: SuiteDiagnosticCollector,\n   547\t  connection: SuiteConnection,\n   548\t): Promise<{\n   549\t  projection: SuiteProjection;\n   550\t  structureGuard: SuiteStructureGuard;\n   551\t  closeResult: Awaited<ReturnType<typeof closeSuiteClient>>;\n   552\t}> {\n   553\t  let projection: SuiteProjection = {\n   554\t    target: { kind: \"custom\" },\n   555\t    execution: connection.execution,\n   556\t    failure: \"serialization\",\n   557\t  };\n   558\t  let structureGuard: SuiteStructureGuard = {\n   559\t    assert: () => { throw new McpFnStructuralCredentialCollisionError(); },\n   560\t  };\n   561\t  let closeResult: Awaited<ReturnType<typeof closeSuiteClient>> = {};\n   562\t  try {\n   563\t    projection = projectSuiteArtifacts(options, connection.client, connection.execution);\n   564\t    structureGuard = captureSuiteStructureGuard(options.target, projection, diagnostics);\n   565\t  } finally {\n   566\t    closeResult = await closeSuiteClient(connection.client);\n   567\t  }\n   568\t  return { projection, structureGuard, closeResult };\n   569\t}\n   570\t\n   571\tfunction suiteIncompleteReasons(\n   572\t  failure: McpFnReportFailure | undefined,\n   573\t  cleanupFailure: McpFnReportFailure | undefined,\n   574\t  diagnostics: SuiteDiagnosticCollector,\n   575\t  redactionOmittedObservedEvents: number,\n   576\t  overflowedObservedEvents: number,\n   577\t): string | undefined {\n   578\t  const reasons = [\n   579\t    ...(failure ? [`${failure.layer}: ${failure.message}`] : []),\n   580\t    ...(cleanupFailure ? [`Cleanup: ${cleanupFailure.message}`] : []),\n   581\t    ...(diagnostics.serializationFailed ? [\"Diagnostic timeline contained non-JSON data\"] : []),\n   582\t    ...(diagnostics.redactionFailed ? [\"Diagnostic timeline redaction failed; original events omitted\"] : []),\n   583\t    ...(diagnostics.countExceeded ? [\"Diagnostic timeline exceeded maxTimelineEvents\"] : []),\n   584\t    ...(diagnostics.bytesExceeded ? [\"Diagnostic timeline exceeded maxReportBytes\"] : []),\n   585\t    ...(redactionOmittedObservedEvents > 0\n   586\t      ? [\"Observed client events were omitted because credential redaction failed\"]\n   587\t      : []),\n   588\t    ...(overflowedObservedEvents > 0\n   589\t      ? [\"Observed client events exceeded maxObservedEvents\"]\n   590\t      : []),\n   591\t  ];\n   592\t  return reasons.length ? reasons.join(\"; \") : undefined;\n   593\t}\n   594\t\n   595\tfunction buildSuiteReport(\n   596\t  projection: SuiteProjection,\n   597\t  manifestChecked: boolean,\n   598\t  failure: McpFnReportFailure | undefined,\n   599\t  cleanupFailure: McpFnReportFailure | undefined,\n   600\t  diagnostics: SuiteDiagnosticCollector,\n   601\t): McpFnTargetSuiteReport {\n   602\t  const results = projection.execution.results;\n   603\t  const failed = results.filter((result) => result.status === \"failed\").length;\n   604\t  const incomplete = results.filter((result) => result.status === \"incomplete\").length;\n   605\t  const droppedObservedEvents = results.reduce(\n   606\t    (total, result) => total + (result.droppedObservedEvents ?? 0),\n   607\t    0,\n   608\t  );\n   609\t  const redactionOmittedObservedEvents = results.reduce(\n   610\t    (total, result) => total + (result.redactionOmittedObservedEvents ?? 0),\n   611\t    0,\n   612\t  );\n   613\t  const overflowedObservedEvents = droppedObservedEvents - redactionOmittedObservedEvents;\n   614\t  const artifactIncomplete = Boolean(failure) || incomplete > 0 ||\n   615\t    diagnostics.dropped > 0 || droppedObservedEvents > 0;\n   616\t  const incompleteReason = suiteIncompleteReasons(\n   617\t    failure,\n   618\t    cleanupFailure,\n   619\t    diagnostics,\n   620\t    redactionOmittedObservedEvents,\n   621\t    overflowedObservedEvents,\n   622\t  );\n   623\t  return {\n   624\t    formatVersion: 1,\n   625\t    kind: \"mcpfn.target-suite-report\",\n   626\t    status: artifactIncomplete ? \"incomplete\" : \"complete\",\n   627\t    runtime: {\n   628\t      node: process.version,\n   629\t      scenarioFormatVersion: 1,\n   630\t      reportSchemaVersion: MCPFN_REPORT_SCHEMA_VERSION,\n   631\t      packages: { testing: MCPFN_TESTING_VERSION },\n   632\t    },\n   633\t    ok: failed === 0 && !artifactIncomplete,\n   634\t    target: projection.target,\n   635\t    server: projection.execution.server,\n   636\t    capabilities: projection.execution.capabilities,\n   637\t    manifestChecked,\n   638\t    ...(projection.manifestHash === undefined ? {} : { manifestHash: projection.manifestHash }),\n   639\t    total: results.length,\n   640\t    passed: results.length - failed - incomplete,\n   641\t    failed,\n   642\t    incomplete,\n   643\t    droppedResults: 0,\n   644\t    droppedObservedEvents,\n   645\t    ...(redactionOmittedObservedEvents > 0 ? { redactionOmittedObservedEvents } : {}),\n   646\t    ...(incompleteReason ? { incompleteReason } : {}),\n   647\t    ...(failure ? { failure } : {}),\n   648\t    timeline: diagnostics.timeline,\n   649\t    droppedTimelineEvents: diagnostics.dropped,\n   650\t    results,\n   651\t  };\n   652\t}\n   653\t\n   654\tfunction structuralReportFailure(retainedCleanup: (() => Promise<void>) | undefined): never {\n   655\t  const failure = new McpFnClientError(\n   656\t    \"MCPFN_OPERATION_FAILED\",\n   657\t    \"Target report cannot be serialized because a credential conflicts with required artifact structure\",\n   658\t    { phase: \"capability-operation\" },\n   659\t  );\n   660\t  if (retainedCleanup) {\n   661\t    throw new McpFnTargetSuiteArtifactCleanupError(retainedCleanup, failure);\n   662\t  }\n   663\t  throw failure;\n   664\t}\n   665\t\n   666\tfunction boundedSuiteReport(\n   667\t  report: McpFnTargetSuiteReport,\n   668\t  guard: SuiteStructureGuard,\n   669\t  maxReportBytes: number,\n   670\t): McpFnTargetSuiteReport {\n   671\t  const bounded = enforceReportCap(report, maxReportBytes);\n   672\t  assertSuiteReportStructure(bounded, guard);\n   673\t  return bounded;\n   674\t}\n   675\t\n   676\tfunction finalizeSuiteReport(\n   677\t  options: RunMcpFnTargetSuiteOptions,\n   678\t  projection: SuiteProjection,\n   679\t  report: McpFnTargetSuiteReport,\n   680\t  guard: SuiteStructureGuard,\n   681\t  maxReportBytes: number,\n   682\t  retainedCleanup: (() => Promise<void>) | undefined,\n   683\t): McpFnTargetSuiteReport {\n   684\t  let finalized: McpFnTargetSuiteReport;\n   685\t  try {\n   686\t    if (projection.failure) throw new Error(\"Report payload projection failed\");\n   687\t    assertSuiteReportStructure(report, guard);\n   688\t    // Custom redaction already completed before cleanup. Built-in report scopes\n   689\t    // remain active here for bounded final serialization.\n   690\t    finalized = boundedSuiteReport(\n   691\t      redactTargetCredentials(options.target, report, { preserveKeys: true }),\n   692\t      guard,\n   693\t      maxReportBytes,\n   694\t    );\n   695\t  } catch (error) {\n   696\t    if (error instanceof McpFnStructuralCredentialCollisionError) {\n   697\t      return structuralReportFailure(retainedCleanup);\n   698\t    }\n   699\t    const fallback = {\n   700\t      ...report,\n   701\t      ok: false,\n   702\t      status: \"incomplete\" as const,\n   703\t      incompleteReason: reportProjectionFailureReason(error, projection.failure),\n   704\t      target: { kind: \"custom\" as const },\n   705\t      server: undefined,\n   706\t      capabilities: undefined,\n   707\t      manifestHash: undefined,\n   708\t      failure: undefined,\n   709\t      results: [],\n   710\t      timeline: [],\n   711\t      droppedResults: report.results.length,\n   712\t      droppedTimelineEvents: report.droppedTimelineEvents + report.timeline.length,\n   713\t    };\n   714\t    try {\n   715\t      finalized = boundedSuiteReport(fallback, guard, maxReportBytes);\n   716\t    } catch (fallbackError) {\n   717\t      if (fallbackError instanceof McpFnStructuralCredentialCollisionError) {\n   718\t        return structuralReportFailure(retainedCleanup);\n   719\t      }\n   720\t      throw fallbackError;\n   721\t    }\n   722\t  }\n   723\t  if (retainedCleanup) throw new McpFnTargetSuiteCleanupError(finalized, retainedCleanup);\n   724\t  return finalized;\n   725\t}\n   726\t\n   727\tasync function runTargetSuite(options: RunMcpFnTargetSuiteOptions): Promise<McpFnTargetSuiteReport> {\n   728\t  const maxTimelineEvents = options.maxTimelineEvents ?? 500;\n   729\t  if (!Number.isInteger(maxTimelineEvents) || maxTimelineEvents < 1) {\n   730\t    throw new Error(\"maxTimelineEvents must be a positive integer\");\n   731\t  }\n   732\t  const maxReportBytes = options.maxReportBytes ?? 1_048_576;\n   733\t  validateReportCap(maxReportBytes);\n   734\t  const consumerDiagnostic = options.client?.diagnostics;\n   735\t  const diagnostics = new SuiteDiagnosticCollector(\n   736\t    maxTimelineEvents,\n   737\t    maxReportBytes,\n   738\t    options.target,\n   739\t    consumerDiagnostic,\n   740\t  );\n   741\t  const connection = await connectSuite(options, diagnostics);\n   742\t  // Custom hooks may depend on credentials cleared by close. Capture payload\n   743\t  // projection and structural safety while the session still owns that state,\n   744\t  // but never let either operation bypass the sole cleanup boundary.\n   745\t  const { projection, structureGuard, closeResult } = await projectAndCloseSuite(\n   746\t    options,\n   747\t    diagnostics,\n   748\t    connection,\n   749\t  );\n   750\t  const { cleanupFailure: closeFailure, retainedCleanup } = closeResult;\n   751\t  diagnostics.captureUnobserved(connection.client);\n   752\t  let cleanupFailure = closeFailure;\n   753\t  cleanupFailure ??= diagnostics.cleanupFailure;\n   754\t  const failure = connection.failure ?? cleanupFailure;\n   755\t  const report = buildSuiteReport(\n   756\t    projection,\n   757\t    connection.manifestChecked,\n   758\t    failure,\n   759\t    cleanupFailure,\n   760\t    diagnostics,\n   761\t  );\n   762\t  return finalizeSuiteReport(\n   763\t    options,\n   764\t    projection,\n   765\t    report,\n   766\t    structureGuard,\n   767\t    maxReportBytes,\n   768\t    retainedCleanup,\n   769\t  );\n   770\t}\n   771\t\n   772\tfunction enforceReportCap(\n   773\t  report: McpFnTargetSuiteReport,\n   774\t  maxBytes: number,\n   775\t): McpFnTargetSuiteReport {\n   776\t  validateReportCap(maxBytes);\n   777\t  const bounded = structuredClone(report);\n   778\t  if (jsonBytes(bounded) > maxBytes) {\n   779\t    bounded.ok = false;\n   780\t    bounded.status = \"incomplete\";\n   781\t    bounded.incompleteReason = \"Report content exceeded maxReportBytes and was truncated\";\n   782\t  }\n   783\t  while (jsonBytes(bounded) > maxBytes && bounded.results.length > 0) {\n   784\t    bounded.results.pop();\n   785\t    bounded.droppedResults += 1;\n   786\t  }\n   787\t  if (jsonBytes(bounded) > maxBytes) {\n   788\t    bounded.target = { kind: report.target.kind };\n   789\t    bounded.server = undefined;\n   790\t    bounded.capabilities = undefined;\n   791\t    bounded.timeline = [];\n   792\t    bounded.droppedTimelineEvents += report.timeline.length;\n   793\t    if (bounded.failure) {\n   794\t      bounded.failure.details = undefined;\n   795\t      bounded.failure.message = \"Target operation failed; details omitted to fit report budget\";\n   796\t    }\n   797\t  }\n   798\t  if (bounded.droppedResults > 0 || jsonBytes(bounded) > maxBytes) {\n   799\t    bounded.ok = false;\n   800\t    bounded.status = \"incomplete\";\n   801\t    bounded.incompleteReason = \"Report content exceeded maxReportBytes and was truncated\";\n   802\t  }\n   803\t  if (jsonBytes(bounded) > maxBytes) {\n   804\t    throw new Error(\"The minimum target suite report exceeds maxReportBytes\");\n   805\t  }\n    35\t    }\n    36\t    if (normalizedHeader === \"cookie\") addCookieSecrets(raw, secrets);\n    37\t  }\n    38\t  return secrets;\n    39\t}\n    40\t\n    41\tfunction addAuthorizationSecrets(raw: string, secrets: Set<string>): void {\n    42\t  const trimmed = raw.trim();\n    43\t  const separator = trimmed.search(/\\s/);\n    44\t  if (separator <= 0) return;\n    45\t  const scheme = trimmed.slice(0, separator).toLowerCase();\n    46\t  const token = trimmed.slice(separator).trim();\n    47\t  if (token) secrets.add(token);\n    48\t  if (scheme !== \"basic\" || !/^[\\dA-Za-z+/]+={0,2}$/.test(token)) return;\n    49\t  const decoded = Buffer.from(token, \"base64\");\n    50\t  // Round-trip validation avoids interpreting malformed tokens as credentials.\n    51\t  if (stripBase64Padding(decoded.toString(\"base64\")) !== stripBase64Padding(token)) return;\n    52\t  for (const encoding of [\"utf8\", \"latin1\"] as const) {\n    53\t    const pair = decoded.toString(encoding);\n    54\t    const colon = pair.indexOf(\":\");\n    55\t    if (colon < 0) continue;\n    56\t    for (const value of [pair, pair.slice(0, colon), pair.slice(colon + 1)]) {\n    57\t      if (value) secrets.add(value);\n    58\t    }\n    59\t  }\n    60\t}\n    61\t\n    62\tfunction stripBase64Padding(value: string): string {\n    63\t  let end = value.length;\n    64\t  while (end > 0 && value[end - 1] === \"=\") end -= 1;\n    65\t  return value.slice(0, end);\n    66\t}\n    67\t\n    68\tfunction addCookieSecrets(raw: string, secrets: Set<string>): void {\n    69\t  // Cookie values are independently reflectable even though the request\n    70\t  // authenticates with the complete header. RFC 6265 cookie values cannot\n    71\t  // contain comma or semicolon, so both delimiters cover combined entries.\n    72\t  for (const part of raw.split(/[;,]/)) {\n    73\t    const pair = part.trim();\n    74\t    if (!pair) continue;\n    75\t    const equals = pair.indexOf(\"=\");\n    76\t    if (equals < 1) {\n    77\t      throw new TypeError(\"Cookie credential headers must contain name=value pairs\");\n    78\t    }\n    79\t    const value = pair.slice(equals + 1).trim();\n    80\t    if (!value) continue;\n    81\t    secrets.add(value);\n    82\t    addUnquotedCookieSecret(value, secrets);\n    83\t  }\n    84\t}\n    85\t\n    86\tfunction addUnquotedCookieSecret(value: string, secrets: Set<string>): void {\n    87\t  if (!value.startsWith('\"') && !value.endsWith('\"')) return;\n    88\t  if (value.length < 2 || !value.startsWith('\"') || !value.endsWith('\"')) {\n    89\t    throw new TypeError(\"Cookie credential values must use balanced quotes\");\n    90\t  }\n    91\t  const unquoted = value.slice(1, -1);\n    92\t  if (unquoted.includes('\"') || unquoted.includes(\"\\\\\")) {\n    93\t    throw new TypeError(\"Cookie credential values must use RFC 6265 syntax\");\n    94\t  }\n    95\t  if (unquoted) secrets.add(unquoted);\n    96\t}\n    97\t\n    98\texport class McpFnRedactionLimitError extends Error {\n    99\t  constructor(message = \"Credential redaction exceeded its traversal budget\") { super(message); }\n   100\t}\n   101\t\n   102\t/** No typed artifact can preserve this authored structure without exposing a credential. */\n   103\texport class McpFnStructuralCredentialCollisionError extends McpFnRedactionLimitError {\n   104\t  constructor() {\n   105\t    super(\"Credential collides with required artifact structure\");\n   106\t  }\n   107\t}\n   108\t\n   109\t// Only these locally authored envelope paths retain structural keys. Unknown\n   110\t// children (including inspector events and server metadata) are always payloads.\n   111\tconst envelopeKeys: Record<string, Set<string>> = Object.fromEntries(Object.entries({\n   112\t  root: \"formatVersion kind status runtime ok target server capabilities manifestChecked manifestHash total passed failed incomplete droppedResults droppedObservedEvents redactionOmittedObservedEvents incompleteReason failure timeline droppedTimelineEvents results count clientState tools resources resourceTemplates prompts droppedEvents timelineComplete droppedInventoryEntries inventoryComplete suiteVersion exitCode stdout stderr phase outcome code requestId at details payload\",\n   113\t  result: \"formatVersion name operation tool status sideEffect durationMs error droppedObservedEvents redactionOmittedObservedEvents\",\n   114\t  diagnostic: \"phase outcome code requestId at target details\",\n   115\t  inspectorEvent: \"formatVersion source kind at event\",\n   116\t  failure: \"name message layer code phase details\",\n   117\t  runtime: \"node scenarioFormatVersion reportSchemaVersion packages\",\n   118\t  packages: \"testing\",\n   119\t  droppedInventoryEntries: \"tools resources resourceTemplates prompts\",\n   120\t  target: \"kind\",\n   121\t}).map(([role, keys]) => [role, new Set(keys.split(\" \"))]));\n   122\t\n   123\tconst structuralArtifactValues = new Map<string, Set<string>>([\n   124\t  [\"root:kind\", new Set([\"logging.message\", \"progress\", \"tasks.status\", \"resources.updated\", \"tools.list_changed\", \"resources.list_changed\", \"prompts.list_changed\", \"resources.subscribed\", \"resources.unsubscribed\", \"client.roots\", \"client.sampling\", \"client.elicitation\", \"mcpfn.target-suite-report\", \"mcpfn.inspector-snapshot\", \"mcpfn.official-conformance-report\"])],\n   125\t  [\"inspectorEvent:kind\", new Set([\"logging.message\", \"progress\", \"tasks.status\", \"resources.updated\", \"tools.list_changed\", \"resources.list_changed\", \"prompts.list_changed\", \"resources.subscribed\", \"resources.unsubscribed\", \"client.roots\", \"client.sampling\", \"client.elicitation\"])],\n   126\t  [\"root:clientState\", new Set([\"idle\", \"connecting\", \"authorization-required\", \"connected\", \"closing\", \"closed\"])],\n   127\t  [\"target:kind\", new Set([\"authenticated-streamable-http\", \"streamable-http\", \"stdio\", \"in-memory\", \"custom\"])],\n   128\t  [\"root:status\", new Set([\"passed\", \"failed\", \"incomplete\", \"complete\"])],\n   129\t  [\"result:status\", new Set([\"passed\", \"failed\", \"incomplete\", \"complete\"])],\n   130\t  [\"root:outcome\", new Set([\"started\", \"succeeded\", \"failed\"])],\n   131\t  [\"diagnostic:outcome\", new Set([\"started\", \"succeeded\", \"failed\"])],\n   132\t  ...[\"root\", \"diagnostic\", \"failure\"].map(role => [\n   133\t    `${role}:phase`,\n   134\t    new Set([\"resource-discovery\", \"authorization-server-discovery\", \"client-registration\", \"authorization-request\", \"authorization-callback\", \"token-exchange\", \"token-refresh\", \"token-revocation\", \"transport-connect\", \"mcp-initialize\", \"capability-operation\", \"transport-close\"]),\n   135\t  ] as [string, Set<string>]),\n   136\t  [\"failure:layer\", new Set([\"mcpfn-preflight\", \"authorization-server\", \"resource-server\", \"mcp-initialization\", \"scenario\", \"upstream-conformance\"])],\n   137\t  [\"inspectorEvent:source\", new Set([\"diagnostic\", \"client\"])],\n   138\t  [\"result:sideEffect\", new Set([\"none\", \"idempotent\", \"non-idempotent\"])],\n   139\t]);\n   140\t\n   141\tconst unrestrictedStructuralValueFields = new Set([\n   142\t  \"packages:testing\",\n   143\t  \"runtime:node\",\n   144\t  \"runtime:reportSchemaVersion\",\n   145\t  \"root:suiteVersion\",\n   146\t]);\n   147\t\n   148\tfunction childEnvelopeRole(\n   149\t  fixed: boolean,\n   150\t  key: string,\n   151\t  role: string,\n   152\t  input: Record<string, unknown>,\n   153\t  rootKind: unknown,\n   154\t): string {\n   155\t  if (!fixed) return \"payload\";\n   156\t  if (key === \"results\") return \"result\";\n   157\t  if (key === \"timeline\") {\n   158\t    return rootKind === \"mcpfn.inspector-snapshot\" ? \"inspectorEvent\" : \"diagnostic\";\n   159\t  }\n   160\t  if ([\"failure\", \"runtime\", \"packages\", \"droppedInventoryEntries\", \"target\"].includes(key)) {\n   161\t    return key;\n   162\t  }\n   163\t  if (role === \"inspectorEvent\" && key === \"event\") {\n   164\t    return input.source === \"client\" ? \"root\" : \"diagnostic\";\n   165\t  }\n   166\t  return \"payload\";\n   167\t}\n   168\t\n   169\tfunction specialValue(input: unknown): unknown {\n   170\t  if (input instanceof Error) return normalizeErrorValue(input);\n   171\t  if (input instanceof Date) return Number.isNaN(input.getTime()) ? \"Invalid Date\" : input.toISOString();\n   172\t  if (input instanceof URL) return input.href;\n   173\t  if (input instanceof Map) {\n   174\t    if (Object.getOwnPropertyDescriptor(Map.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   175\t    return { type: \"Map\", entries: [...Map.prototype.entries.call(input)] };\n   176\t  }\n   177\t  if (input instanceof Set) {\n   178\t    if (Object.getOwnPropertyDescriptor(Set.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   179\t    return { type: \"Set\", values: [...Set.prototype.values.call(input)] };\n   180\t  }\n   181\t  return input;\n   182\t}\n   183\t\n   184\tfunction normalizeErrorValue(input: Error): Record<string, unknown> {\n   185\t  // Error instances may expose attacker-controlled enumerable keys. A\n   186\t  // null-prototype accumulator keeps `__proto__` as ordinary payload data.\n   187\t  const normalized = Object.create(null) as Record<string, unknown>;\n   188\t  let enumerableFields = 0;\n   189\t  for (const key in input) {\n   190\t    if (!Object.hasOwn(input, key)) continue;\n   191\t    if (++enumerableFields > 100_000) throw new McpFnRedactionLimitError();\n   192\t    normalized[key] = (input as unknown as Record<string, unknown>)[key];\n   193\t  }\n   194\t  normalized.name = input.name;\n   195\t  normalized.message = input.message;\n   196\t  normalized.stack = input.stack;\n   197\t  if (input.cause !== undefined) normalized.cause = input.cause;\n   198\t  return normalized;\n   199\t}\n   200\t\n   201\tfunction scrubCredentials<T>(value: T, values: Iterable<string>, preserveKeys = false, redactionMarker?: string): T {\n   202\t  // Preserve whether a pattern came from opaque text or a serializer. Literal\n   203\t  // percent sequences in credentials must not acquire URL hex-case semantics.\n   204\t  const variants = [...values].filter(Boolean).flatMap(secret => [\n   205\t    { value: secret, encoded: false },\n   206\t    { value: JSON.stringify(secret).slice(1, -1), encoded: false },\n   207\t    { value: encodeURIComponent(secret), encoded: true },\n   208\t    { value: new URLSearchParams({ value: secret }).toString().slice(\"value=\".length), encoded: true },\n   209\t  ]).sort((a, b) => b.value.length - a.value.length);\n   210\t  let entries = 0, stringBytes = 0;\n   211\t  const budget = (input: unknown, depth = 0): void => {\n   212\t    input = specialValue(input);\n   213\t    if ((Array.isArray(input) && input.length > 100_000) || ++entries > 100_000 || depth > 32) throw new McpFnRedactionLimitError();\n   214\t    if (typeof input === \"string\") {\n   215\t      stringBytes += Buffer.byteLength(input);\n   216\t      if (input.length > 262_144 || stringBytes > 2_097_152) throw new McpFnRedactionLimitError();\n   217\t    } else if (input && typeof input === \"object\") {\n   218\t      for (const key in input) if (Object.hasOwn(input, key)) {\n   219\t        budget(key, depth + 1);\n   220\t        budget((input as Record<string, unknown>)[key], depth + 1);\n   221\t      }\n   222\t    }\n   223\t  };\n   224\t  // Check before either redactor allocates copies. Exceeding a budget is an\n   225\t  // explicit failure, never silent truncation of a typed report collection.\n   226\t  budget(value);\n   227\t  const patterns = variants.map(({ value, encoded }) => {\n   228\t    const literal = value.replace(/[.*+?^${}()|[\\]\\\\]/g, String.raw`\\$&`);\n   229\t    // Only generated percent escapes accept mixed-case hex digits.\n   230\t    return encoded\n   231\t      ? literal.replace(/%[\\dA-Fa-f]{2}/g, escape => escape.replace(/[A-Fa-f]/g, hex => `[${hex.toLowerCase()}${hex.toUpperCase()}]`))\n   232\t      : literal;\n   233\t  });\n   234\t  const secretPattern = patterns.length ? new RegExp(patterns.join(\"|\"), \"g\") : undefined;\n   235\t  const replacementPattern = patterns.length ? new RegExp(patterns.join(\"|\")) : undefined;\n   236\t  const preserveStructural = (input: string): string => {\n   237\t    if (replacementPattern?.test(input)) {\n   238\t      throw new McpFnRedactionLimitError(\n   239\t        \"Credential collides with a required structural artifact field\",\n   240\t      );\n   241\t    }\n   242\t    return input;\n   243\t  };\n   244\t  const preserveStructuralKey = (input: string): string => {\n   245\t    if (replacementPattern?.test(input)) {\n   246\t      throw new McpFnStructuralCredentialCollisionError();\n   247\t    }\n   248\t    return input;\n   249\t  };\n   250\t  // A requested marker is itself output and must not reproduce a credential.\n   251\t  if (secretPattern) {\n   252\t    const markerContainsSecret = secretPattern.test(redactionMarker ?? \"[REDACTED]\");\n   253\t    secretPattern.lastIndex = 0;\n   254\t    if (markerContainsSecret) redactionMarker = \"\";\n   255\t  }\n   256\t  const scrubString = (input: string, role: string, field: string, finalPass: boolean): string => {\n   257\t    const structuralField = `${role}:${field}`;\n   258\t    if (unrestrictedStructuralValueFields.has(structuralField) ||\n   259\t        structuralArtifactValues.get(structuralField)?.has(input)) {\n   260\t      return preserveStructural(input);\n   261\t    }\n   262\t    // Whole-string rejection cannot compose another credential by joining pieces.\n   263\t    // Run after both redactors; never feed this result through another redactor.\n   264\t    if (finalPass) return replacementPattern?.test(input) ? \"\" : input;\n   265\t    if (!secretPattern) return input;\n   266\t    return input.replace(secretPattern, secret => {\n   267\t      const maskCharacter = secret.includes(\"*\") ? \"#\" : \"*\";\n   268\t      const defaultReplacement = secret.length < 10\n   269\t        ? maskCharacter.repeat(secret.length)\n   270\t        : \"[REDACTED]\";\n   271\t      const replacement = redactionMarker ?? defaultReplacement;\n   272\t      // Every generated mask must be safe against the entire credential set.\n   273\t      return replacementPattern!.test(replacement) ? \"\" : replacement;\n   274\t    });\n   275\t  };\n   276\t  function scrubArray(input: unknown[], role: string, finalPass: boolean): unknown[] {\n   277\t    const result = input.map(entry => scrub(entry, role, \"\", finalPass));\n   278\t    assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   279\t    return result;\n   280\t  }\n   281\t  function scrubObject(\n   282\t    input: Record<string, unknown>,\n   283\t    role: string,\n   284\t    finalPass: boolean,\n   285\t  ): Record<string, unknown> {\n   286\t    const entries: Array<[string, unknown]> = [];\n   287\t    const keys = new Set<string>();\n   288\t    for (const [key, entry] of Object.entries(input)) {\n   289\t      const fixed = envelopeKeys[role]?.has(key) ?? false;\n   290\t      if (fixed) preserveStructuralKey(key);\n   291\t      const childRole = childEnvelopeRole(\n   292\t        fixed,\n   293\t        key,\n   294\t        role,\n   295\t        input,\n   296\t        (value as { kind?: unknown } | null)?.kind,\n   297\t      );\n   298\t      const scrubbedKey = fixed ? key : scrub(key, \"payload\", \"\", finalPass) as string;\n   299\t      if (keys.has(scrubbedKey)) {\n   300\t        throw new McpFnRedactionLimitError(\n   301\t          \"Credential redaction created duplicate object keys\",\n   302\t        );\n   303\t      }\n   304\t      keys.add(scrubbedKey);\n   305\t      const scrubbedEntry = typeof entry === \"string\"\n   306\t        ? scrub(entry, fixed ? role : \"payload\", key, finalPass)\n   307\t        : scrub(entry, childRole, \"\", finalPass);\n   308\t      entries.push([scrubbedKey, scrubbedEntry]);\n   309\t    }\n   310\t    const result = Object.fromEntries(entries);\n   311\t    assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   312\t    return result;\n   313\t  }\n   314\t  function scrub(input: unknown, role = \"payload\", field = \"\", finalPass = false): unknown {\n   315\t    input = specialValue(input);\n   316\t    if (typeof input === \"string\") return scrubString(input, role, field, finalPass);\n   317\t    if (Array.isArray(input)) return scrubArray(input, role, finalPass);\n   318\t    if (input && typeof input === \"object\") {\n   319\t      return scrubObject(input as Record<string, unknown>, role, finalPass);\n   320\t    }\n   321\t    return input;\n   322\t  }\n   323\t  const timelineEvent = value && typeof value === \"object\" && [\"client\", \"diagnostic\"].includes((value as { source?: string }).source ?? \"\");\n   324\t  let role = \"payload\";\n   325\t  if (preserveKeys) role = timelineEvent ? \"inspectorEvent\" : \"root\";\n   326\t  const scrubbed = scrub(value, role);\n   327\t  const generic = redactOAuthValue(scrubbed, { maxStringLength: 262_144, maxDepth: 64, maxArrayEntries: 100_000, maxObjectEntries: 100_000, ...(redactionMarker !== undefined ? { redactionMarker } : {}) });\n   328\t  const result =