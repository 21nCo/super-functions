,'--cached','--name-only','--no-renames',head).splitlines())==allow\nassert git('rev-parse','HEAD')==head and git('rev-parse','MERGE_HEAD')==base\n(A/'final-exact-stage-allowlist.json').write_text(json.dumps(allow,indent=2)+'\\n');(A/'final-staged-stat.txt').write_text(git('diff','--cached','--stat')+'\\n');(A/'final-staged-source.patch').write_text(git('diff','--cached',head)+'\\n')\nreceipt.write_text(json.dumps({'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'head':head,'base':base,'mergeHead':base,'expectedTree':expected,'actualIndexTree':actual,'canonicalSourcePaths':len(source),'promotedAndStagedPaths':len(allow),'focusedLockMaps':2,'REDACTED':True,'archiveVerified':True,'normalAncestryFixturePassed':True,'normalMergeOutput':mergeOutput,'headUnchanged':True,'controlledInputsAbsent':True,'commitCount':0,'pushCount':0,'feedbackCollections':1,'publicationGate':'pending exact staged final assessment/precommit identity then1 normal commit/push','mergeGate':'closed hosted gates unassessed'},indent=2)+'\\n');print('Promoted/staged',len(allow),'paths; canonical tree',actual,'parents prepared',head,base)\n"}],"isError":false,"timestamp":1791286088726}}
