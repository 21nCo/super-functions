{"type":"message","id":"5df6fdd8","parentId":"eba053f8","timestamp":"2026-10-06T11:33:52.988Z","message":{"role":"toolResult","toolCallId":"call_NsaAGUcqWnIru5dLt7PfkqcZ|fc_055fb762f51dfcfc016ac4dca02a9887d0a13dc5f491c17b70","toolName":"read","content":[{"type":"text","text":"import pathlib,json,subprocess,hashlib,os,stat,tarfile,io,datetime,shutil\nA=pathlib.Path(__file__).resolve().parent;T=pathlib.Path('/Users/serro/orca/workspaces/superfunctions/docs-pr-206-review-20260930');V=pathlib.Path(json.loads((A/'ssd-routed-normal-install-admission.json').read_text())['candidate']);review=json.loads((A/'producer-final-current-review-input.json').read_text());source=json.loads((A/'producer-final-current-source-hashes-and-modes.json').read_text());head=review['frozenHead'];base=review['base'];receipt=A/'final-staged-tree-guard.json';assert not receipt.exists()\ndef git(*args,env=None,data=None):return subprocess.check_output(['git','-C',str(T),*args],env=env,input=data,stderr=subprocess.STDOUT).decode().strip()\ndef raw(p):\n if p.is_symlink():return os.readlink(p).encode(),'120000'\n if p.is_file():return p.read_bytes(),'100755' if p.stat().st_mode&stat.S_IXUSR else '100644'\n assert not p.exists(),p\n return None,None\ndef entry(p):\n data,mode=raw(p);return {'sha256':hashlib.sha256(data).hexdigest() if data is not None else None,'gitMode':mode}\nassert git('rev-parse','HEAD')==head and git('branch','--show-current')=='codex/docs-devfn-20260926' and not git('status','--porcelain')\nassert git('remote','get-url','origin')=='https://github.com/21nCo/super-functions.git'\nassert hashlib.sha256((A/'SKILL.md').read_bytes()).hexdigest()=='78e6b66300287085d26e1cf15657a5010c6c93d0c2c23a9d4240064a6cdcd91c'\nledger=json.loads((A.parents[1]/'parent-ledger.json').read_text());assert ledger['digest']=='sha256:b6a6e7a8c670bc5ab12540910401d153e8eedd533d89fd1a1925bc9979112726' and ledger['execution']['current_sequential_sweep']['active_pr']==212\nassert (A/'final-source-review-assessment.md').exists()\nadmission=json.loads((A/'final-promotion-admission.json').read_text());assert admission['passed']\nfor name in admission['receipts']:assert json.loads((A/(name+'.receipt.json')).read_text())['exitCode']==0,name\nfor p,e in source.items():assert entry(V/p)==e,p\nassert hashlib.sha256((V/'package-lock.json').read_bytes()).hexdigest()==review['lockSha256']\nprotected=json.loads((A/'execution-protected-before-switch.json').read_text())\nfor p,h in protected.items():assert entry(T/p)['sha256']==h,p\ninputs=list(json.loads((A/'controlled212-inputs.json').read_text()));assert all(not (T/p).exists() and not (V/p).exists() for p in inputs)\nrows=[]\ntrackedOriginalAndBase=set(git('ls-tree','-r','--name-only',head).splitlines())|set(git('ls-tree','-r','--name-only',base).splitlines())\nfor p,after in source.items():\n before=entry(T/p)\n if before==after:continue\n assert not p.startswith(('.conduct/','.entire/')) and p!='filefn/server/eng.traineddata' and 'node_modules' not in pathlib.PurePosixPath(p).parts\n if p not in trackedOriginalAndBase:assert not any(part.startswith('__') for part in pathlib.PurePosixPath(p).parts),p\n rows.append({'path':p,'before':before,'after':after})\n# Reuse unchanged official ancestry-state fixture proof from211; no additional consumer/root.\nfixture=json.loads((A.parent/'PR-211/ordinary-ours-ancestry-fixture.json').read_text());assert fixture['passed']\n(A/'ordinary-ours-ancestry-fixture-reuse.json').write_text(json.dumps({'passed':True,'reused':str(A.parent/'PR-211/ordinary-ours-ancestry-fixture.json'),'qualification':'unchanged official git merge state transition; not fresh212 consumer proof'},indent=2)+'\\n')\n# Archive all exact original changed source preimages and default index, verify before mutation.\narchive=A/'execution-source-pre-promotion.tar.gz';assert not archive.exists()\nwith tarfile.open(archive,'w:gz') as tar:\n for row in rows:\n  p=row['path'];data,mode=raw(T/p)\n  if data is None:continue\n  item=tarfile.TarInfo(p);item.mode=stat.S_IMODE((T/p).lstat().st_mode)\n  if mode=='120000':item.type=tarfile.SYMTYPE;item.linkname=data.decode();tar.addfile(item)\n  else:item.size=len(data);tar.addfile(item,io.BytesIO(data))\nwith tarfile.open(archive,'r:gz') as tar:\n for item in tar.getmembers():\n  row=next(r for r in rows if r['path']==item.name);data=item.linkname.encode() if item.issym() else tar.extractfile(item).read();assert hashlib.sha256(data).hexdigest()==row['before']['sha256'] and item.mode==stat.S_IMODE((T/item.name).lstat().st_mode)\nindex=pathlib.Path(git('rev-parse','--git-path','index'));index=index if index.is_absolute() else T/index;shutil.copy2(index,A/'execution-index-before212-promotion.backup')\n(A/'final-source-promotion-plan.json').write_text(json.dumps({'head':head,'base':base,'canonicalPaths':len(source),'rows':rows,'sourceArchiveVerifiedBeforeMutation':True,'ancestryFixturePassed':True,'candidate':str(V),'execution':str(T)},indent=2)+'\\n')\nassert not git('status','--porcelain');assert git('rev-parse','HEAD')==head\n# Normal official merge state, no commit, no metadata rewrite, no bypassed hooks.\nmergeOutput=git('merge','--no-commit','--no-ff','-s','ours',base);assert git('rev-parse','HEAD')==head and git('rev-parse','MERGE_HEAD')==base\nfor row in rows:\n p=row['path'];dst=T/p;src=V/p;assert entry(dst)==row['before'] and entry(src)==row['after'],p\n data,mode=raw(src)\n if data is None:dst.unlink()\n elif mode=='120000':\n  if dst.exists() or dst.is_symlink():dst.unlink()\n  dst.parent.mkdir(parents=True,exist_ok=True);dst.symlink_to(data.decode())\n else:dst.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(src,dst)\n assert entry(dst)==row['after'],p\nfor p,e in source.items():assert entry(T/p)==e,p\n# Independently construct canonical expected tree: exact42a plus128 reviewed differences.\ntmp=A/'expected-reviewed212-tree.index';assert not tmp.exists();eenv={**os.environ,'GIT_INDEX_FILE':str(tmp)};git('read-tree',base,env=eenv)\nfor p in review['baseChangedPaths']:\n data,mode=raw(V/p)\n if data is None:git('update-index','--force-remove','--',p,env=eenv)\n else:oid=git('hash-object','-w','--stdin',data=data);git('update-index','--add','--cacheinfo',mode,oid,p,env=eenv)\nexpected=git('write-tree',env=eenv);allow=sorted(row['path'] for row in rows);git('add','--all','--',*allow);git('diff','--cached','--check');actual=git('write-tree');assert actual==expected,(actual,expected)\nassert not git('diff','--name-only') and not git('ls-files','-u');assert sorted(git('diff','--cached','--name-only','--no-renames',head).splitlines())==allow\nassert git('rev-parse','HEAD')==head and git('rev-parse','MERGE_HEAD')==base\n(A/'final-exact-stage-allowlist.json').write_text(json.dumps(allow,indent=2)+'\\n');(A/'final-staged-stat.txt').write_text(git('diff','--cached','--stat')+'\\n');(A/'final-staged-source.patch').write_text(git('diff','--cached',head)+'\\n')\nreceipt.write_text(json.dumps({'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'head':head,'base':base,'mergeHead':base,'expectedTree':expected,'actualIndexTree':actual,'canonicalSourcePaths':len(source),'promotedAndStagedPaths':len(allow),'focusedLockMaps':35,'REDACTED':True,'archiveVerified':True,'normalAncestryFixturePassed':True,'normalMergeOutput':mergeOutput,'headUnchanged':True,'controlledInputsAbsent':True,'commitCount':0,'pushCount':0,'feedbackCollections':1,'publicationGate':'pending exact staged final assessment/precommit identity then1 normal commit/push','mergeGate':'closed hosted gates unassessed'},indent=2)+'\\n');print('Promoted/staged',len(allow),'paths; canonical tree',actual,'parents prepared',head,base)\n"}],"isError":false,"timestamp":1791286432988}}
