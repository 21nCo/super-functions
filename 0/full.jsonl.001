ed. Next I’ll admit conversion of the existing DevFn standalone slot to ExtFn, keeping exactly three installations and preserving its own-lock history.","textSignature":"{\"v\":1,\"id\":\"msg_055fb762f51dfcfc016ac5dab9cb4087d08c0abdcc36c99a80\",\"phase\":\"commentary\"}"},{"type":"toolCall","id":"call_090587db56114f94ae17b4ce38525ea2|fc_055fb762f51dfcfc016ac5dabaf7f487d0a7bd513d1cd8956d","name":"write","arguments":{"path":"/Users/serro/Documents/dev/n/audits/sf-docs-review-20260930/sequential-20261003T184612Z/PR-213/admit-existing-standalone-slots.py","content":"\"\"\"Archive-guarded source/own-lock admission: reuse exactly3 slots; never relocate/install.\"\"\"\nimport pathlib,json,subprocess,os,hashlib,stat,datetime,copy,tarfile,io\nA=pathlib.Path(__file__).resolve().parent;T='/Users/serro/orca/workspaces/superfunctions/docs-pr-206-review-20260930';git=lambda *a:subprocess.check_output(['git','-C',T,*a]);sha=lambda b:hashlib.sha256(b).hexdigest() if b is not None else None;p=json.loads((A/'reviewed-candidate-plan.json').read_text());V=pathlib.Path(p['candidate']);S=V.parent/'standalone-current-npm11';e={**p['entries'],**json.loads((A/'composition-assessment-supplement.json').read_text())['entries'],**json.loads((A/'final-guide-platform-supplement.json').read_text())['entries']};history=json.loads((A/'retained212-history-index.json').read_text());assert sha((A/'retained212-source-own-locks-installed-history.tar.gz').read_bytes())==history['archiveSha256']\nfor name in ['standalone213-source-plan.json','standalone213-source-admission.json','standalone213-source-application-start.json','standalone213-source-application-receipt.json']:assert not (A/name).exists(),'one-shot outputs; inspect rather than rerun'\nassert (A/'current213-root-normal-npm-ci.receipt.json').exists() and not (S/'package.json').exists() and not (S/'node_modules').exists();assert git('rev-parse','HEAD').decode().strip()==p['head'] and not git('status','--porcelain').strip()\n# Physical DevFn path is retained: no rename/move, second copy, fourth install or parent dependency borrowing.\nslots={'extfn':S/'devfn/docs','authfn':S/'authfn/docs','filefn':S/'filefn/docs'};assert len({str(x) for x in slots.values()})==3;assert not (S/'extfn/docs/node_modules').exists()\nfor old,c in history['contexts'].items():assert pathlib.Path(c['physicalPath'])==S/old/'docs' and sha((S/old/'docs/package-lock.json').read_bytes())==c['ownLockSha256'] and (S/old/'docs/node_modules').is_dir()\ndef tree(ref):\n rows={}\n for line in git('ls-tree','-rz','--full-tree',ref).split(b'\\0'):\n  if line:\n   meta,path=line.split(b'\\t',1);mode,kind,oid=meta.decode().split();assert kind=='blob';rows[path.decode()]=mode\n return rows\nbase=tree(p['base']);old=tree(p['relatedPublication']);canonical={**base}\nfor path,r in e.items():\n if r['afterSha256'] is None:canonical.pop(path,None)\n else:canonical[path]=r['gitMode']\nprojection={};ownedOld={};changes={}\nfor product,slot in slots.items():\n prefix=product+'/docs/';destPrefix=str(slot.relative_to(S))+'/'\n for source,mode in canonical.items():\n  if source.startswith(prefix):projection[destPrefix+source[len(prefix):]]={'source':source,'gitMode':mode,'product':product}\n priorPrefix=('devfn' if product=='extfn' else product)+'/docs/'\n for source,mode in old.items():\n  if source.startswith(priorPrefix):ownedOld[destPrefix+source[len(priorPrefix):]]={'gitMode':mode,'product':product}\nfor source,mode in canonical.items():\n if source.startswith('scripts/docs-site/'):projection[source]={'source':source,'gitMode':mode,'product':'shared'}\nfor source,mode in old.items():\n if source.startswith('scripts/docs-site/'):ownedOld[source]={'gitMode':mode,'product':'shared'}\nfor dest in sorted(set(projection)|set(ownedOld)):\n assert 'node_modules' not in pathlib.PurePosixPath(dest).parts and not dest.endswith('/package-lock.json');f=S/dest;assert not f.is_symlink();before=f.read_bytes() if f.is_file() else None;mode=stat.S_IMODE(f.stat().st_mode) if before is not None else None\n if before is not None:\n  row=history['regularFiles'].get('standalone/'+dest);assert row and row['sha256']==sha(before) and row['mode']==mode,('standalone source changed since archive',dest)\n source=projection.get(dest);after=(V/source['source']).read_bytes() if source else None;assert not source or not (V/source['source']).is_symlink();changes[dest]={'beforeSha256':sha(before),'beforePosixMode':mode,'afterSha256':sha(after),'gitMode':source['gitMode'] if source else ownedOld[dest]['gitMode'],'source':source['source'] if source else None,'contents':after.decode() if after is not None else None}\nfor product,slot in slots.items():\n m=json.loads(changes[str(slot.relative_to(S))+'/package.json']['contents']);assert m['name']=='@'+product+'/docs' and m['devDependencies']['vitest']=='^3.2.4';assert (slot/'package-lock.json').is_file()\n# Own locks remain unchanged during source conversion. ExtFn's existing-slot own lock is reconciled by ordinary npm11 install, never seeded from root or siblings.\nout={'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'physicalRoot':str(S),'slots':{product:str(slot) for product,slot in slots.items()},'contexts':history['contexts'],'entries':changes,'historyArchiveSha256':history['archiveSha256'],'conversion':'Existing DevFn physical source slot becomes ExtFn; no directory relocation or new consumer root. Historical DevFn source/own lock/installed metadata/public SDKs archived; own installation retained until normal npm11 install.','ownLocksCopied':False,'ownLocksDeleted':False,'ownLocksMutatedBySourceApplication':False,'sourceGateOpen':True,'ordinaryExtFnOwnSlotNpm11InstallAdmitted':True,'authfnFilefnRetainedOwnLockInstallationsRequireCurrentVerification':True,'newPhysicalRoot':False,'fourthConsumer':False,'publicationGateOpen':False,'qualification':'Noncanonical slot directory name is explicit, not public feature source or a fourth install. Native receiver is current @extfn/docs and resolves only its own declared public peers.'};(A/'standalone213-source-plan.json').write_text(json.dumps(out,indent=2)+'\\n');ad={k:v for k,v in out.items() if k!='entries'};ad['sourcePlanSha256']=sha((A/'standalone213-source-plan.json').read_bytes());(A/'standalone213-source-admission.json').write_text(json.dumps(ad,indent=2)+'\\n');(A/'standalone213-source-application-start.json').write_text(json.dumps({'at':out['at'],'changedPaths':[d for d,r in changes.items() if r['beforeSha256']!=r['afterSha256']]},indent=2)+'\\n')\nfor dest,r in changes.items():\n if r['beforeSha256']==r['afterSha256']:continue\n f=S/dest;assert sha(f.read_bytes() if f.is_file() else None)==r['beforeSha256'],dest\n if r['contents'] is None:assert f.is_file();f.unlink()\n else:\n  f.parent.mkdir(parents=True,exist_ok=True);f.write_bytes(r['contents'].encode());mode=r['beforePosixMode'] if r['beforePosixMode'] is not None else 0o644;f.chmod(mode|0o111 if r['gitMode']=='100755' else mode&~0o111)\nfor dest,r in changes.items():assert sha((S/dest).read_bytes() if (S/dest).is_file() else None)==r['afterSha256'],dest\nfor old,c in history['contexts'].items():assert sha((S/old/'docs/package-lock.json').read_bytes())==c['ownLockSha256']\nassert git('rev-parse','HEAD').decode().strip()==p['head'] and not git('status','--porcelain').strip();ad.update({'sourceEntries':len(changes),'changedCount':len(json.loads((A/'standalone213-source-application-start.json').read_text())['changedPaths']),'completedAt':datetime.datetime.now(datetime.timezone.utc).isoformat(),'normalInstalls':0,'ownLocksUnchanged':True,'TcleanUnchanged':True});(A/'standalone213-source-application-receipt.json').write_text(json.dumps(ad,indent=2)+'\\n');print(json.dumps(ad,indent=2))\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":756,"output":3089,"cacheRead":206208,"cacheWrite":0,"reasoning":1034,"totalTokens":210053,"cost":{"input":0.0015119999999999999,"output":0.030890000000000004,"cacheRead":0.0206208,"cacheWrite":0,"total":0.05302280000000001}},"stopReason":"toolUse","timestamp":1791351431952,"responseId":"resp_055fb762f51dfcfc016ac5da88f13887d08e24da40230e7830","rawStopReason":"completed","thinkingLevel":"high"}}
