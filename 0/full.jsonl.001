{"type":"message","id":"4abd9040","parentId":"fd84870b","timestamp":"2026-10-05T18:23:08.871Z","message":{"role":"toolResult","toolCallId":"call_5xzeAiOykcsLYAg19IkAvSJu|fc_055fb762f51dfcfc016ac3eb0c96e887d0b4a83e82eac38da1","toolName":"read","content":[{"type":"text","text":"<script lang=\"ts\">\n  import \"../app.css\";\n  import DocsSiteSearch from \"$lib/components/DocsSiteSearch.svelte\";\n  import TopBar from \"@docsfn/svelte/TopBar.svelte\";\n  import { page } from \"$app/stores\";\n  import { onMount, type Snippet } from \"svelte\";\n  import { observeTopBar } from \"../../../../scripts/docs-site/layout\";\n  import type { LayoutData } from \"./$types\";\n\n  interface Props {\n    data: LayoutData;\n    children: Snippet;\n  }\n\n  let { data, children }: Props = $props();\n  let siteRoot: HTMLDivElement;\n  onMount(() => observeTopBar(siteRoot));\n\n</script>\n\n<div\n  bind:this={siteRoot}\n  class=\"docsfn-site-root\"\n  class:docsfn-docs-chrome={$page.url.pathname.startsWith(\"/docs\")}\n>\n  <TopBar\n    items={data.source.config.navigation?.topNav}\n    searchTrigger={DocsSiteSearch}\n  />\n  <div class=\"docsfn-site-main\">\n    {@render children()}\n  </div>\n  {#if data.source.config.site.showFooter !== false}\n    <footer class=\"docsfn-site-footer\">\n      <p>Built at <a href=\"https://21n.co\" rel=\"noreferrer noopener\">21n.co</a></p>\n    </footer>\n  {/if}\n</div>\n\n<style>\n  .docsfn-site-root {\n    min-height: 100vh;\n    width: 100%;\n    max-width: none;\n    display: flex;\n    flex-direction: column;\n  }\n\n  .docsfn-site-main {\n    flex: 1;\n    min-height: 0;\n    display: flex;\n    flex-direction: column;\n  }\n\n  .docsfn-site-footer {\n    flex-shrink: 0;\n    align-self: stretch;\n    width: 100%;\n    max-width: none;\n    box-sizing: border-box;\n    position: relative;\n    z-index: 2;\n    border-top: 1px solid var(--docsfn-color-border);\n    padding: 1rem 1.5rem;\n    text-align: center;\n    font-size: 0.875rem;\n    color: var(--docsfn-color-muted);\n    background: var(--docsfn-color-surface);\n    transition: var(--docsfn-transition-theme);\n  }\n\n  .docsfn-site-footer p {\n    margin: 0;\n  }\n\n  .docsfn-site-footer a {\n    color: var(--docsfn-color-primary);\n    text-decoration: none;\n    font-weight: 500;\n  }\n\n  .docsfn-site-footer a:hover {\n    text-decoration: underline;\n  }\n</style>\n"}],"isError":false,"timestamp":1791224588871}}
