sert tar.extractfile(m).read()==b and m.mode==mode\ncommand=['node','scripts/cloudflare-docs/deploy.mjs','dev','--products=extfn,authfn,filefn','--dry-run'];log=A/'current213-actual-offline-deploy-dry-run.log';assert not log.exists()\ntry:\n with log.open('wb') as out:r=subprocess.run(command,cwd=V,env=env,stdout=out,stderr=subprocess.STDOUT,timeout=600)\n results.append({'command':command,'exitCode':r.returncode,'mutationFlag':'--dry-run'});assert r.returncode==0,log\n for product in products:\n  owner=V/product/'docs';config=json.loads((owner/'.cloudflare-docs-wrangler.jsonc').read_text());assert 'nodejs_compat' in config['compatibility_flags'];assert config['main']=='.svelte-kit/cloudflare/_worker.js';assert (owner/config['main']).is_file();assert config['name']==f'superfunctions-{product}-docs-dev';text=(owner/'static/llms.txt').read_text();assert f'https://dev.{product}.com/docs' in text;results.append({'product':product,'actualOptInWorkerEntry':True,'actualNodeCompatibilityFlag':True,'actualPublicProducerHost':f'https://dev.{product}.com','dryRunArtifactRetained':True})\nfinally:\n for f,(b,mode) in pre.items():f.write_bytes(b);f.chmod(mode);assert f.read_bytes()==b and stat.S_IMODE(f.stat().st_mode)==mode\n result.write_text(json.dumps({'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'results':results,'sixStaticBytesModesRestored':True,'previousEmittedOutputsArchived':str(archive),'qualification':'Actual offline opt-in build and Wrangler deploy --dry-run only. No live Worker/API/routes/domains/certificates/DNS readiness or secret wiring claim. New owned generated offline outputs retained; pristine normal build remains separate.'},indent=2)+'\\n')\nprint('Three actual opt-in builds/offline Wrangler dry-runs/nodejs_compat/public-origin wiring passed; six static preimages restored.')\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":2210,"output":1988,"cacheRead":191104,"cacheWrite":0,"reasoning":1026,"totalTokens":195302,"cost":{"input":0.0044199999999999995,"output":0.019880000000000002,"cacheRead":0.019110400000000003,"cacheWrite":0,"total":0.0434104}},"stopReason":"toolUse","timestamp":1791367233267,"responseId":"resp_055fb762f51dfcfc016ac61842320887d0b43402cc11244033","rawStopReason":"completed","thinkingLevel":"high"}}
