or export could not select a replayable redaction placeholder\";\n   283\t    } else if (exceedsRedactionBounds(scenario, redacted, SCENARIO_REDACTION_LIMITS)) {\n   284\t      incompleteReason = \"Inspector export exceeded redaction bounds and was truncated\";\n   285\t    }\n   286\t    if (incompleteReason) {\n   287\t      this.client.preserveArtifactStructure(\"status\");\n   288\t      this.client.preserveArtifactStructure(\"incompleteReason\");\n   289\t    }\n   290\t    const exported = incompleteReason\n   291\t      ? {\n   292\t        ...replaced,\n   293\t        status: this.client.preserveArtifactStructure(\"incomplete\"),\n   294\t        incompleteReason: this.client.redact(incompleteReason, {\n   295\t          preserveKeys: false,\n   296\t          redactionMarker: \"\",\n   297\t        }),\n   298\t      }\n   299\t      : replaced;\n   300\t    const variables = collectVariables(exported);\n   301\t    if (!variables.length) return exported;\n   302\t    this.client.preserveArtifactStructure(\"variables\");\n   303\t    return { ...exported, variables };\n   304\t  }\n   305\t\n   306\t  timeline(): McpFnInspectorTimelineEvent[] {\n   307\t    return [...this.events];\n   308\t  }\n   309\t\n   310\t  private record(\n","stderr":"","aggregated_output":" mcpfn/inspector/src/index.ts                       |  17 +-\n .../tests/authenticated-artifacts.test.ts          |  26 ++\n mcpfn/testing/src/remote-target.ts                 | 111 +++---\n mcpfn/testing/src/reports.ts                       |  57 ++--\n mcpfn/testing/src/suite.ts                         | 372 +++++++++++++++++----\n mcpfn/testing/tests/suite.test.ts                  |  81 ++++-\n 6 files changed, 514 insertions(+), 150 deletions(-)\n   300\t    });\n   301\t  }\n   302\t}\n   303\t\n   304\tfunction initialTargetDescriptor(target: McpFnTarget): McpFnTargetDescriptor {\n   305\t  const kind = target.kind;\n   306\t  return [\"stdio\", \"streamable-http\", \"authenticated-streamable-http\", \"in-memory\", \"custom\"]\n   307\t    .includes(kind)\n   308\t    ? { kind }\n   309\t    : { kind: \"custom\" };\n   310\t}\n   311\t\n   312\tfunction safeInitialTargetDescriptor(target: McpFnTarget): McpFnTargetDescriptor {\n   313\t  try { return initialTargetDescriptor(target); }\n   314\t  catch { return { kind: \"custom\" }; }\n   315\t}\n   316\t\n   317\tfunction projectSuiteArtifacts(\n   318\t  options: RunMcpFnTargetSuiteOptions,\n   319\t  client: McpFnTestClient | undefined,\n   320\t  execution: SuiteExecution,\n   321\t): SuiteProjection {\n   322\t  const fallback: SuiteProjection = {\n   323\t    target: safeInitialTargetDescriptor(options.target), execution,\n   324\t  };\n   325\t  try {\n   326\t    if (client?.session.state !== \"connected\") {\n   327\t      return execution.results.length || execution.server || execution.capabilities\n   328\t        ? { ...fallback, failure: \"serialization\" }\n   329\t        : fallback;\n   330\t    }\n   331\t    let described: McpFnTargetDescriptor;\n   332\t    try { described = options.target.describe(); }\n   333\t    catch { return { ...fallback, failure: \"serialization\" }; }\n   334\t    try {\n   335\t      const { kind, ...descriptor } = described;\n   336\t      return {\n   337\t        target: {\n   338\t          ...redactSuiteArtifact(options.target, descriptor, { preserveKeys: false }),\n   339\t          kind: client.session.preserveArtifactStructure(kind),\n   340\t        },\n   341\t        manifestHash: options.manifest\n   342\t          ? redactSuiteArtifact(options.target, options.manifest.hash, { preserveKeys: false })\n   343\t          : undefined,\n   344\t        execution: {\n   345\t          server: execution.server === undefined\n   346\t            ? undefined\n   347\t            : redactSuiteArtifact(options.target, execution.server, { preserveKeys: false }),\n   348\t          capabilities: execution.capabilities === undefined\n   349\t            ? un