\"scenario\" : \"incomplete\";\n   114\t      failure = junitFailure(result.error ?? `Scenario ${result.status}`, failureType);\n   115\t    }\n   235\t  exportScenario(\n   236\t    name: string,\n   237\t    operation: McpFnInspectorOperation,\n   238\t    result: McpFnInspectorOperationResult,\n   239\t  ): McpFnExportedScenario {\n   240\t    const scenario = createMcpFnScenario(name, operation, result);\n   241\t    // Top-level scenario keys are authored schema, not payload. If a credential\n   242\t    // collides with one of them, no replayable typed artifact can be emitted.\n   243\t    for (const key of Object.keys(scenario)) {\n   244\t      this.client.preserveArtifactStructure(key);\n   245\t    }\n   246\t    const { formatVersion, kind, sideEffect, ...payload } = scenario;\n   247\t    if (kind === undefined || sideEffect === undefined) {\n   248\t      throw new Error(\"Inspector scenario export requires normalized structure\");\n   249\t    }\n   250\t    const safeKind = this.client.preserveArtifactStructure(kind);\n   251\t    const safeSideEffect = this.client.preserveArtifactStructure(sideEffect);\n   252\t    const secretMarker = selectScenarioSecretMarker(this.client);\n   253\t    let redacted: Record<string, unknown>;\n   254\t    try {\n   255\t      redacted = {\n   256\t        ...Object.fromEntries(Object.entries(payload).map(([key, value]) => [key, this.client.redact(value, {\n   257\t          ...SCENARIO_REDACTION_LIMITS,\n   258\t          // These are user payloads, even when their keys resemble an envelope.\n   259\t          preserveKeys: false,\n   260\t          redactionMarker: secretMarker ?? \"\",\n   261\t        })])),\n   262\t        formatVersion, kind: safeKind, sideEffect: safeSideEffect,\n   263\t      };\n   264\t    } catch {\n   265\t      this.client.preserveArtifactStructure(\"status\");\n   266\t      this.client.preserveArtifactStructure(\"incompleteReason\");\n   267\t      return {\n   268\t        formatVers