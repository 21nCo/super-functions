'] = process.argv.slice(2);\nassert(modulePath && directory && ['negative', 'positive'].includes(mode));\nassert(!existsSync(directory), 'distinct owned audit directory required');\nmkdirSync(directory, { recursive: true, mode: 0o700 });\nconst oldBody = 'previous complete published artifact\\n';\nconst newBody = 'new complete published artifact\\n' + 'x'.repeat(32 * 1024 * 1024);\nconst hash = (b) => createHash('sha256').update(b).digest('hex');\nconst allowed = new Set([hash(oldBody), hash(newBody)]);\nfor (const name of ['llms.txt', 'llms-full.txt']) writeFileSync(resolve(directory, name), oldBody, { mode: 0o600 });\nconst childCode = `import { writeLlmsArtifacts } from ${JSON.stringify(pathToFileURL(resolve(modulePath)).href)};const body='new complete published artifact\\\\n'+'x'.repeat(32*1024*1024);console.log('WRITER_READY');for(let i=0;i<4;i++)writeLlmsArtifacts(${JSON.stringify(resolve(directory))},{llmsTxt:body,llmsFullTxt:body},false);`;\nconst child = spawn(process.execPath, ['--input-type=module', '-e', childCode], { stdio: ['ignore', 'pipe', 'pipe'] });\nlet stderr = ''; child.stderr.on('data', (b) => { stderr += b; });\nawait new Promise((accept, reject) => {\n let seen = ''; child.stdout.on('data', (b) => { seen += b; if (seen.includes('WRITER_READY')) accept(); });\n child.once('error', reject); child.once('exit', (code) => { if (!seen.includes('WRITER_READY')) reject(new Error(`writer exited early ${code}: ${stderr}`)); });\n});\nlet exited = false; const completion = new Promise((accept, reject) => { child.once('error', reject); child.once('exit', (code) => { exited = true; code === 0 ? accept() : reject(new Error(`writer ${code}: ${stderr}`)); }); });\nconst violations = []; let reads = 0;\nwhile (!exited) {\n for (const name of ['llms.txt', 'llms-full.txt']) {\n  const target = resolve(directory, name); const size = statSync(target).size;\n  if (size !== Buffer.byteLength(oldBody) && size !== Buffer.byteLength(newBody)) violations.push({ name, size, boundary: 'OS-visible public pathname size during native write' });\n  const bytes = readFileSync(target); reads++;\n  if (!allowed.has(hash(bytes))) violations.push({ name, size: bytes.length, sha256: hash(bytes), boundary: 'independent public-path byte reader observes neither complete old nor complete new artifact' });\n }\n await new Promise((accept) => setImmediate(accept));\n}\nawait completion;\nfor (const name of ['llms.txt', 'llms-full.txt']) assert.equal(hash(readFileSync(resolve(directory, name))), hash(newBody));\nif (mode === 'negative') assert(violations.length > 0, 'old direct writer must actually violate the independent reader oracle');\nelse { assert.equal(violations.length, 0, 'published reader must only see complete old/new bytes'); for (const name of ['llms.txt', 'llms-full.txt']) assert.equal(statSync(resolve(directory, name)).mode & 0o777, 0o600, 'preserve existing owner-only mode'); }\nconsole.log(JSON.stringify({ modulePath, directory, mode, reads, violationCount: violations.length, violations: violations.slice(0, 8), childExitedNormally: true, mockedFilesystem: false, killedProcesses: 0, qualification: 'actual native per-file reader/writer boundary; not pair-level transaction or power-loss durability proof; retained owned audit output, no source mutation' }, null, 2));\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":998,"output":2079,"cacheRead":243584,"cacheWrite":0,"reasoning":1034,"totalTokens":246661,"cost":{"input":0.001996,"output":0.020790000000000003,"cacheRead":0.024358400000000002,"cacheWrite":0,"total":0.0471444}},"stopReason":"toolUse","timestamp":1791330404468,"responseId":"resp_055fb762f51dfcfc016ac5886504ac87d0949b379793d3f0ae","rawStopReason":"completed","thinkingLevel":"high"}}
