nt=2)+'\\n')\nwith (A/'push.log').open('w') as out:r=subprocess.run(['git','push','origin','HEAD:refs/heads/codex/docs-devfn-20260926'],cwd=T,env=env,stdout=out,stderr=subprocess.STDOUT)\nassert r.returncode==0,('normal push failed; no automatic retry',r.returncode)\n# One immediate receipt only; no check/review refetch, wait, retry or merge.\nlocal=git('rev-parse','HEAD');remote=git('ls-remote','origin','refs/heads/codex/docs-devfn-20260926');(A/'immediate-remote-head.txt').write_text(remote+'\\n');prRaw=subprocess.check_output(['gh','pr','view','212','--repo','21nCo/super-functions','--json','headRefOid,headRefName,state,url'],env=env,text=True);(A/'immediate-pr-head.json').write_text(prRaw);pr=json.loads(prRaw)\nrefsAfter=git('for-each-ref','--format=%(refname) %(objectname)','refs/entire');(A/'entire-refs-after-publication.txt').write_text(refsAfter+'\\n');before=set((A/'entire-refs-before-commit.txt').read_text().splitlines());after=set(refsAfter.splitlines());changed=sorted(after-before)\nreceipt={'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'pr':212,'url':pr['url'],'localHead':local,'remoteHead':remote.split()[0],'prHead':pr['headRefOid'],'immediateHeadsMatch':local==remote.split()[0]==pr['headRefOid'],'tree':gate['expectedTree'],'parents':[gate['head'],gate['base']],'commitCount':1,'normalPushCount':1,'publicationConsumed':True,'prState':pr['state'],'worktreeClean':not bool(git('status','--porcelain')),'entireRefsAddedOrChanged':changed,'feedbackCollections':1,'postPushFeedbackRefetches':0,'ciPolls':0,'merges':0,'hostedGates':'new exact head unassessed; not green or merge readiness','roundStopped':True}\n(A/'publication.json').write_text(json.dumps(receipt,indent=2)+'\\n');print(json.dumps(receipt,indent=2))\n"}],"isError":false,"timestamp":1791286609219}}
