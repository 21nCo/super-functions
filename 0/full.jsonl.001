HeC0KDej4SFYmuIO8OnX5nRmHpa9x7Wjzj1jg3sfjHvfNqsxBFsaWo7jQMtZm98BzkLWZbND5g6l8HJjLNDFjbsI2oN2iNnaWylZ8qlEozrEmGc7rSY4VOYEVcs8pi06WhI2rXsGUfZqGmomdrhFKv_0Rw2ilmiTgNDk=\"}"},{"type":"toolCall","id":"call_15eac36c4b774662a5ee24e7e3dd27c5|fc_055fb762f51dfcfc016ac5ccfd164c87d0b54f0b16ce6471ce","name":"write","arguments":{"path":"/Users/serro/Documents/dev/n/audits/sf-docs-review-20260930/sequential-20261003T184612Z/PR-213/archive-retained212-source-and-install-history.py","content":"\"\"\"Archive exact retained212 source/own locks/installed metadata/SDKs; no application mutation.\"\"\"\nimport pathlib,json,subprocess,plistlib,os,stat,hashlib,tarfile,io,shutil\nA=pathlib.Path(__file__).resolve().parent;V=pathlib.Path(json.loads((A/'reviewed-candidate-plan.json').read_text())['candidate']);S=V.parent/'standalone-current-npm11';sha=lambda b:hashlib.sha256(b).hexdigest()\narchive=A/'retained212-source-own-locks-installed-history.tar.gz';index=A/'retained212-history-index.json';assert not archive.exists() and not index.exists()\nd=plistlib.loads(subprocess.check_output(['diskutil','info','-plist','/Volumes/OS - Data']));assert d['VolumeUUID']=='B86D5097-6E24-3D1D-A590-8CF9D44B6245' and d['Writable'];assert shutil.disk_usage(V).free>=15*1024**3\nT='/Users/serro/orca/workspaces/superfunctions/docs-pr-206-review-20260930';assert subprocess.check_output(['git','-C',T,'rev-parse','HEAD']).decode().strip()=='f15540d26c2329203c626ccb51eb9108c5bebd84';assert not subprocess.check_output(['git','-C',T,'status','--porcelain']).strip()\nprior=json.loads((A.parent/'PR-212/producer-final-current-source-hashes-and-modes.json').read_text());files={};links={};outputInventory={};sdks=[]\nfor p,row in prior.items():\n f=V/p;b=os.readlink(f).encode() if f.is_symlink() else f.read_bytes() if f.is_file() else None;assert (sha(b) if b is not None else None)==row['sha256'],p\n if b is not None:\n  assert ('120000' if f.is_symlink() else '100755' if f.stat().st_mode&0o111 else '100644')==row['gitMode'],p\n  if f.is_symlink():links['root/'+p]=os.readlink(f)\n  else:files['root/'+p]=f\n# Preserve historical noncanonical type fixtures by exact declared membership, never delete them.\nfixtures=json.loads((A.parent/'PR-212/preserved-noncanonical-type-fixtures.json').read_text())\nprotectedFixtureInventory=fixtures\n# Scan both existing roots, preserving source/own locks, all installed manifests/hidden locks and public docs SDK history.\noutputDirs={'.svelte-kit','.turbo','.wrangler','dist','build','.git','.cloudflare-docs-assets','.next','out'}\nfor label,root in [('root',V),('standalone',S)]:\n for directory,dirs,names in os.walk(root,followlinks=False):\n  relative=pathlib.Path(directory).relative_to(root);inside='node_modules' in relative.parts\n  if not inside:\n   for child in list(dirs):\n    if child in outputDirs:\n     outputInventory[label+'/'+str(relative/child)]={'preservedDirectory':True};dirs.remove(child)\n  for child in list(dirs):\n   f=pathlib.Path(directory)/child\n   if f.is_symlink():links[label+'/'+str(f.relative_to(root))]=os.readlink(f);dirs.remove(child)\n  for name in names:\n   f=pathlib.Path(directory)/name;p=label+'/'+str(f.relative_to(root))\n   if f.is_symlink():links[p]=os.readlink(f);continue\n   if not f.is_file():continue\n   if inside:\n    if name in ['package.json','.package-lock.json']:files[p]=f\n   else:files[p]=f\n  if inside and any(str(relative).endswith('node_modules/'+package) for package in ['@docsfn/core','@docsfn/provider-fs','@docsfn/svelte','@docsfn/sveltekit']):sdks.append((label,root,pathlib.Path(directory)))\nfor label,root,sdk in sdks:\n for directory,dirs,names in os.walk(sdk,followlinks=False):\n  dirs[:]=[x for x in dirs if x!='node_modules' and not (pathlib.Path(directory)/x).is_symlink()]\n  for name in names:\n   f=pathlib.Path(directory)/name\n   if f.is_file() and not f.is_symlink():files[label+'/'+str(f.relative_to(root))]=f\ncontexts={}\nfor product in ['devfn','authfn','filefn']:\n docs=S/product/'docs';assert (docs/'node_modules').is_dir() and (docs/'package-lock.json').is_file();m=json.loads((docs/'package.json').read_text());contexts[product]={'physicalPath':str(docs),'packageName':m['name'],'ownLockSha256':sha((docs/'package-lock.json').read_bytes()),'conversionAdmitted':False}\nassert not (S/'package.json').exists() and not (S/'node_modules').exists()\nentries={}\nwith tarfile.open(archive,'w:gz') as tar:\n for p,f in sorted(files.items()):\n  b=f.read_bytes();mode=stat.S_IMODE(f.stat().st_mode);info=tarfile.TarInfo(p);info.size=len(b);info.mode=mode;tar.addfile(info,io.BytesIO(b));entries[p]={'sha256':sha(b),'mode':mode}\n for p,target in sorted(links.items()):\n  info=tarfile.TarInfo(p);info.type=tarfile.SYMTYPE;info.linkname=target;tar.addfile(info)\nwith tarfile.open(archive,'r:gz') as tar:\n assert len(tar.getmembers())==len(entries)+len(links)\n for m in tar.getmembers():\n  if m.issym():assert m.linkname==links[m.name]\n  else:assert sha(tar.extractfile(m).read())==entries[m.name]['sha256'] and m.mode==entries[m.name]['mode']\n# Prove each archived original still matches after archival, not just that tar can be read.\nfor p,f in files.items():assert sha(f.read_bytes())==entries[p]['sha256'] and stat.S_IMODE(f.stat().st_mode)==entries[p]['mode'],p\nindex.write_text(json.dumps({'archiveSha256':sha(archive.read_bytes()),'archiveBytes':archive.stat().st_size,'regularFiles':entries,'links':links,'preservedOutputDirectories':outputInventory,'protectedFixtureInventory':protectedFixtureInventory,'contexts':contexts,'prior212CanonicalCount':len(prior),'publicSdkDirectories':[str(sdk) for _,_,sdk in sdks],'verifiedArchiveAndUnchangedOriginals':True,'applicationMutation':False,'installation':False,'extraPhysicalRoot':False,'conversionAdmitted':False,'qualification':'Source/own-lock/installed metadata/public DocsFn SDK bytes/modes/linktext history. Existing outputs/installations retained, not restored or dependency-cleaned; no ACL/xattr/hardlink topology recovery promise.'},indent=2)+'\\n');print(json.dumps({'archiveBytes':archive.stat().st_size,'regularFiles':len(entries),'links':len(links),'publicSdkDirectories':len(sdks),'priorCanonical':len(prior),'genuineExistingContexts':list(contexts),'archiveVerified':True,'originalsUnchanged':True},indent=2))\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":1359,"output":2086,"cacheRead":134016,"cacheWrite":0,"reasoning":393,"totalTokens":137461,"cost":{"input":0.002718,"output":0.02086,"cacheRead":0.013401600000000001,"cacheWrite":0,"total":0.0369796}},"stopReason":"toolUse","timestamp":1791347945061,"responseId":"resp_055fb762f51dfcfc016ac5cce9ae7887d0bc3a21aec25c035c","rawStopReason":"completed","thinkingLevel":"high"}}
