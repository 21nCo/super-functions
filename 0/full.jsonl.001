73600000000002,"cacheWrite":0,"total":0.037377600000000004}},"stopReason":"toolUse","timestamp":1791225532396,"responseId":"resp_055fb762f51dfcfc016ac3eebcea7087d09a7f7a1e2bc2f2bd","rawStopReason":"completed","thinkingLevel":"high"}}
