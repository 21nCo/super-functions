g paths and repair the shared invariant before the one authorized publication step. [Task 1][Task 2]\n  1711\t- DATA-6 favors parse/validate once into a versioned discriminated protocol representation, then an exhaustive structural selector visitor. A parallel raw-payload switch can drift from route parsing; require execution/extraction shared-representation evidence. Structural selectors are not an inventory of relation-derived execution effects. [Task 1]\n  1712\t- For UIF-2 project mutation, distinguish generator-owned from merge-owned files, do not overwrite unmanaged generated-output paths, do not hash all of consumer-owned `package.json` for dependency merging, and make dry-run plan the same artifacts/dependencies/metadata as commit mode. [Task 1]\n  1713\t- PR #144’s foundation is good (const-safe builders, literal types, persisted-null replace clears), but its final head has cross-path null-normalization, aggregate, timezone/date-validation, and excess-option-key gaps; focused tests passing did not establish merge readiness. [Task 2]\n  1714\t- For PR #170, paginate `pullRequest.reviewThreads(first:100,after:$endCursor)` and separate `isOutdated` from current unresolved threads; snapshot base/head OIDs, commits, local exact-head source, and hosted checks independently. The captured head `aa08ef72e` was open/mergeable but `UNSTABLE`, with 34 current unresolved threads and 10 pending checks; do not call it merge-ready from focused tests or resolved threads. [Task 3]\n","exit_code":0,"duration":{"secs":0,"nanos":6125},"formatted_output":"Warning: truncated output (original token count: 10065)\nTotal output lines: 455\n\n    38\t  return secrets;\n    39\t}\n    40\t\n    41\tfunction addAuthorizationSecrets(raw: string, secrets: Set<string>): void {\n    42\t  const trimmed = raw.trim();\n    43\t  const separator = trimmed.search(/\\s/);\n    44\t  if (separator <= 0) return;\n    45\t  const scheme = trimmed.slice(0, separator).toLowerCase();\n    46\t  const token = trimmed.slice(separator).trim();\n    47\t  if (token) secrets.add(token);\n    48\t  if (scheme !== \"basic\") {\n    49\t    if (scheme !== \"bearer\") addAuthorizationParameterSecrets(token, secrets);\n    50\t    return;\n    51\t  }\n    52\t  if (!/^[\\dA-Za-z+/]+={0,2}$/.test(token)) return;\n    53\t  const decoded = Buffer.from(token, \"base64\");\n    54\t  // Round-trip validation avoids interpreting malformed tokens as credentials.\n    55\t  if (stripBase64Padding(decoded.toString(\"base64\")) !== stripBase64Padding(token)) return;\n    56\t  for (const encoding of [\"utf8\", \"latin1\"] as const) {\n    57\t    const pair = decoded.toString(encoding);\n    58\t    const colon = pair.indexOf(\":\");\n    59\t    if (colon < 0) continue;\n    60\t    for (const value of [pair, pair.slice(0, colon), pair.slice(colon + 1)]) {\n    61\t      if (value) secrets.add(value);\n    62\t    }\n    63\t  }\n    64\t}\n    65\t\n    66\tconst authorizationParameterName = /^[!#$%&'*+.^_`|~\\dA-Za-z-]+$/;\n    67\t\n    68\tinterface ParsedAuthorizationValue {\n    69\t  cursor: number;\n    70\t  components: string[];\n    71\t}\n    72\t\n    73\tfunction skipAuthorizationWhitespace(token: string, cursor: number): number {\n    74\t  while (token[cursor] === \" \" || token[cursor] === \"\\t\") cursor += 1;\n    75\t  return cursor;\n    76\t}\n    77\t\n    78\tfunction parseQuotedAuthorizationValue(token: string, start: number): ParsedAuthorizationValue {\n    79\t  let cursor = start + 1;\n    80\t  let decoded = \"\";\n    81\t  while (cursor < token.length && token[cursor] !== '\"') {\n    82\t    if (token[cursor] === \"\\\\\") {\n    83\t      cursor += 1;\n    84\t      if (cursor >= token.length) {\n    85\t        throw new TypeError(\"Authorization credential parameters must use balanced quotes\");\n    86\t      }\n    87\t    }\n    88\t    decoded += token[cursor];\n    89\t    cursor += 1;\n    90\t  }\n    91\t  if (token[cursor] !== '\"') {\n    92\t    throw new TypeError(\"Authorization credential parameters must use balanced quotes\");\n    93\t  }\n    94\t  cursor += 1;\n    95\t  const rawValue = token.slice(start, cursor);\n    96\t  return {\n    97\t    cursor,\n    98\t    components: [rawValue, rawValue.slice(1, -1), decoded].filter(Boolean),\n    99\t  };\n   100\t}\n   101\t\n   102\tfunction parseUnquotedAuthorizationValue(token: string, start: number): ParsedAuthorizationValue {\n   103\t  let cursor = start;\n   104\t  while (cursor < token.length && token[cursor] !== \",\") cursor += 1;\n   105\t  const value = token.slice(start, cursor).trim();\n   106\t  if (!value || /\\s/.test(value) || value.includes('\"')) {\n   107\t    throw new TypeError(\"Authorization credential parameters must contain valid values\");\n   108\t  }\n   109\t  return { cursor, components: [value] };\n   110\t}\n   111\t\n   112\tfunction parseAuthorizationParameter(token: string, start: number): ParsedAuthorizationValue {\n   113\t  let cursor = skipAuthorizationWhitespace(token, start);\n   114\t  const nameStart = cursor;\n   115\t  while (cursor < token.length && token[cursor] !== \"=\" &&\n   116\t    token[cursor] !== \" \" && token[cursor] !== \"\\t\" && token[cursor] !== \",\") cursor += 1;\n   117\t  const name = token.slice(nameStart, cursor);\n   118\t  cursor = skipAuthorizationWhitespace(token, cursor);\n   119\t  if (!authorizationParameterName.test(name) || token[cursor] !== \"=\") {\n   120\t    throw new TypeError(\"Authorization credential parameters must use name=value syntax\");\n   121\t  }\n   122\t  cursor = skipAuthorizationWhitespace(token, cursor + 1);\n   123\t  if (cursor >= token.length) {\n   124\t    throw new TypeError(\"Authorization credential parameters must contain values\");\n   125\t  }\n   126\t  const parsed = token[cursor] === '\"'\n   127\t    ? parseQuotedAuthorizationValue(token, cursor)\n   128\t    : parseUnquotedAuthorizationValue(token, cursor);\n   129\t  return { ...parsed, cursor: skipAuthorizationWhitespace(token, parsed.cursor) };\n   130\t}\n   131\t\n   132\tfunction addAuthorizationParameterSecrets(token: string, secrets: Set<string>): void {\n   133\t  const firstEquals = token.indexOf(\"=\");\n   134\t  if (firstEquals < 1 || !authorizationParameterName.test(token.slice(0, firstEquals).trim())) return;\n   135\t  let cursor = 0;\n   136\t  while (cursor < token.length) {\n   137\t    const parsed = parseAuthorizationParameter(token, cursor);\n   138\t    for (const component of parsed.components) secrets.add(component);\n   139\t    cursor = parsed.cursor;\n   140\t    if (cursor === token.length) return;\n   141\t    if (token[cursor] !== \",\") {\n   142\t      throw new TypeError(\"Authorization credential parameters must be comma separated\");\n   143\t    }\n   144\t    cursor = skipAuthorizationWhitespace(token, cursor + 1);\n   145\t    if (cursor === token.length) {\n   146\t      throw new TypeError(\"Authorization credential parameters must not end with a comma\");\n   147\t    }\n   148\t  }\n   149\t}\n   150\t\n   151\tfunction stripBase64Padding(value: string): string {\n   152\t  let end = value.length;\n   153\t  while (end > 0 && value[end - 1] === \"=\") end -= 1;\n   154\t  return value.slice(0, end);\n   155\t}\n   156\t\n   157\tfunction addCookieSecrets(raw: string, secrets: Set<string>): void {\n   158\t  // Cookie values are independently reflectable even though the request\n   159\t  // authenticates with the complete header. RFC 6265 cookie values cannot\n   160\t  // contain comma or semicolon, so both delimiters cover combined entries.\n   161\t  for (const part of raw.split(/[;,]/)) {\n   162\t    const pair = part.trim();\n   163\t    if (!pair) continue;\n   164\t    const equals = pair.indexOf(\"=\");\n   165\t    if (equals < 1) {\n   390\t\n   391\tinterface SuiteStructureGuard {\n   392\t  assert(value: string): void;\n   393\t}\n   394\t\n   395\tfunction captureSuiteStructureG