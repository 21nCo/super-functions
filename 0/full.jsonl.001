e:url\";\n-import { resolve } from \"node:path\";\n+import { resolve, dirname } from \"node:path\";\n import { readFileSync } from \"node:fs\";\n import { docsSiteCorePlugin } from \"./vite\";\n \n@@ -22,7 +22,9 @@\n   throw new Error(hint);\n }\n \n-export default defineConfig({\n+export default {\n   plugins: [docsSiteCorePlugin(pathToFileURL(sitePackagePath).href)],\n-  test: { root: fileURLToPath(new URL(\".\", import.meta.url)), include: [\"runtime.test.ts\", \"page.test.ts\", \"llms.test.mjs\", \"origin.test.mjs\"] },\n-});\n+  resolve: { alias: { $lib: resolve(dirname(sitePackagePath), \"src/lib\") } },\n+  esbuild: { tsconfigRaw: JSON.stringify({ compilerOptions: { target: \"ES2022\", verbatimModuleSyntax: true } }) },\n+  test: { root: fileURLToPath(new URL(\".\", import.meta.url)), include: [\"runtime.test.ts\", \"page.test.ts\", \"blog.test.ts\", \"llms.test.mjs\", \"vite.test.mjs\", \"dependency-owner.test.ts\"] },\n+} satisfies ViteUserConfig;\n--- exact-provenance/turbo.json\n+++ proposed213/turbo.json\n@@ -1,46 +1,83 @@\n {\n   \"$schema\": \"https://turbo.build/schema.json\",\n-  \"globalDependencies\": [\"**/.env.*local\"],\n+  \"globalDependencies\": [\n+    \"**/.env.*local\"\n+  ],\n   \"tasks\": {\n     \"build\": {\n-      \"dependsOn\": [\"^build\"],\n-      \"outputs\": [\"dist/**\", \".next/**\", \"!.next/cache/**\"]\n+      \"dependsOn\": [\n+        \"^build\"\n+      ],\n+      \"outputs\": [\n+        \"dist/**\",\n+        \".next/**\",\n+        \"!.next/cache/**\"\n+      ]\n     },\n     \"lint\": {\n-      \"dependsOn\": [\"^build\"]\n+      \"dependsOn\": [\n+        \"^build\"\n+      ]\n     },\n     \"typecheck\": {\n-      \"dependsOn\": [\"^build\"]\n+      \"dependsOn\": [\n+        \"^build\"\n+      ]\n     },\n     \"test\": {\n-      \"dependsOn\": [\"^build\"],\n-      \"outputs\": [\"coverage/**\"]\n+      \"dependsOn\": [\n+        \"^build\"\n+      ],\n+      \"outputs\": [\n+        \"coverage/**\"\n+      ]\n     },\n     \"test:watch\": {\n       \"cache\": false,\n       \"persistent\": true\n     },\n     \"test:coverage\": {\n-      \"dependsOn\": [\"^build\"],\n-      \"outputs\": [\"coverage/**\"]\n+      \"dependsOn\": [\n+        \"^build\"\n+      ],\n+      \"outputs\": [\n+        \"coverage/**\"\n+      ]\n     },\n     \"dev\": {\n       \"cache\": false,\n       \"persistent\": true\n     },\n     \"deploy\": {\n-      \"dependsOn\": [\"build\"]\n+      \"dependsOn\": [\n+        \"build\"\n+      ]\n     },\n     \"scan\": {\n-      \"dependsOn\": [\"build\"],\n-      \"outputs\": [\"scan-results/**\", \"reports/**\"]\n+      \"dependsOn\": [\n+        \"build\"\n+      ],\n+      \"outputs\": [\n+        \"scan-results/**\",\n+        \"reports/**\"\n+      ]\n     },\n     \"package\": {\n-      \"dependsOn\": [\"build\"],\n-      \"outputs\": [\"artifacts/**\", \"packages/**\"]\n+      \"dependsOn\": [\n+        \"build\"\n+      ],\n+      \"outputs\": [\n+        \"artifacts/**\",\n+        \"packages/**\"\n+      ]\n     },\n     \"clean\": {\n       \"cache\": false\n     }\n-  }\n+  },\n+  \"globalEnv\": [\n+    \"CLOUDFLARE_DOCS_DEPLOY\",\n+    \"CLOUDFLARE_DOCS_PUBLIC_ORIGIN\",\n+    \"CLOUDFLARE_DOCS_ASSETS_ORIGIN\"\n+  ]\n }\n"}],"isError":false,"timestamp":1791367599439}}
{"type":"message","id":"65774932","parentId":"704d29e6","timestamp":"2026-10-07T10:06:39.439Z","message":{"role":"toolResult","toolCallId":"call_caa1bd9d09a042b7838cc49331f9749c|fc_055fb762f51dfcfc016ac619af315c87d09cbc44186d2a0fa7","toolName":"read","content":[{"type":"text","text":"+Examples:\n+\n+```bash\n+npm exec extfn scan -- --config extfn/examples/vanilla-messaging-demo/extfn.config.ts\n+npm exec extfn scan -- --config extfn/examples/svelte-datafn-demo/extfn.config.ts --format sarif\n+npm exec extfn scan -- --config extfn/examples/svelte-multi-content-demo/extfn.config.ts --no-strict\n+```\n+\n+## package\n+\n+```text\n+Usage: extfn package [options]\n+\n+Options:\n+  --config <path>\n+  --target <target>\n+  --out-dir <path>\n+  --no-scan\n+  --no-strict\n+```\n+\n+Behavior:\n+\n+- Always rebuilds the selected targets before scanning or creating archives, even when build output already exists.\n+- Runs `scan` by default before emitting archives.\n+- Chromium archives use `.zip`.\n+- Firefox archives use `.xpi`.\n+- `--no-scan` skips the scan step entirely.\n+- `--no-strict` keeps scan report generation but does not block archive emission on error findings.\n+\n+Examples:\n+\n+```bash\n+npm exec extfn package -- --config extfn/examples/svelte-multi-content-demo/extfn.config.ts\n+npm exec extfn package -- --config extfn/examples/svelte-multi-content-demo/extfn.config.ts --target firefox-mv3\n+npm exec extfn package -- --config extfn/examples/svelte-datafn-demo/extfn.config.ts --no-strict\n+```\n+\n+## Recommended repo-root validation matrix\n+\n+```bash\n+npm exec extfn -- --help\n+npm exec extfn build -- --target chromium-mv3 --config extfn/examples/vanilla-messaging-demo/extfn.config.ts\n+npm exec extfn scan -- --target chromium-mv3 --config extfn/examples/vanilla-messaging-demo/extfn.config.ts\n+npm exec extfn build -- --config extfn/examples/svelte-multi-content-demo/extfn.config.ts\n+npm exec extfn scan -- --config extfn/examples/svelte-multi-content-demo/extfn.config.ts\n+npm exec extfn package -- --target firefox-mv3 --config extfn/examples/svelte-multi-content-demo/extfn.config.ts\n+npm exec extfn build -- --config extfn/examples/svelte-datafn-demo/extfn.config.ts\n+npm exec extfn scan -- --config extfn/examples/svelte-datafn-demo/extfn.config.ts\n+```\n--- reviewed42a/extfn/docs/content/docs/reference/consumer-host-abstraction.md\n+++ preserved213/extfn/docs/content/docs/reference/consumer-host-abstraction.md\n@@ -0,0 +1,152 @@\n+---\n+title: Consumer host abstraction\n+description: Move SvelteKit runtime dependencies behind consumer-owned adapters.\n+---\n+\n+This guide exists for consumers such as `nucleus` that already have shared UI packages tied to SvelteKit runtime imports like `$app/navigation`, `$app/stores`, or `$app/environment`.\n+\n+## The problem\n+\n+A shared package that imports `$app/*` directly is no longer truly shared. It can only run inside a SvelteKit app shell.\n+\n+That becomes a blocker when the same UI needs to run in:\n+\n+- a SvelteKit web app\n+- an `extfn` popup\n+- an `extfn` options page\n+- an `extfn` sidepanel\n+- an `extfn` content mount\n+\n+## Recommended shape\n+\n+Keep host-specific APIs in the consumer repository, not in `extfn`.\n+\n+Shared UI package:\n+\n+```ts\n+export interface NavigationHost {\n+  goto(url: string): Promise<void>;\n+  currentPath(): string;\n+}\n+\n+export interface SessionHost {\n+  getSession(): Promise<{ userId: string | null }>;\n+}\n+\n+export interface ConsumerHost {\n+  navigation: NavigationHost;\n+  session: SessionHost;\n+}\n+```\n+\n+Shared component:\n+\n+```ts\n+export interface SharedPanelProps {\n+  host: ConsumerHost;\n+}\n+```\n+\n+SvelteKit adapter in the consumer repo:\n+\n+```ts\n+import { goto } from \"$app/navigation\";\n+import { get } from \"svelte/store\";\n+import { page } from \"$app/stores\";\n+\n+export const svelteKitHost = {\n+  navigation: {\n+    async goto(url: string) {\n+      await goto(url);\n+    },\n+    currentPath() {\n+      return get(page).url.pathname;\n+    },\n+  },\n+  session: {\n+    async getSession() {\n+      return { userId: \"from-web-app\" };\n+    },\n+  },\n+};\n+```\n+\n+Extension adapter in the consumer repo:\n+\n+```ts\n+import { createRuntime } from \"@extfn/core\";\n+\n+const runtime = createRuntime({\n+  target: \"chromium-mv3\",\n+});\n+\n+export const extfnHost = {\n+  navigation: {\n+    async goto(url: string) {\n+      if (runtime.address.context === \"content\") {\n+        globalThis.location.assign(url); // Navigates the host page.\n+      } else {\n+        await runtime.browser.call(\"tabs.create\", { url });\n+      }\n+    },\n+    currentPath() {\n+      return globalThis.location?.pathname ?? \"\";\n+    },\n+  },\n+  session: {\n+    async getSession() {\n+      return { userId: null };\n+    },\n+  },\n+};\n+```\n+\n+Content scripts cannot call `tabs.create` directly. This adapter navigates the host page in a content context and opens a new tab from extension pages. If a content-mounted panel needs to open a tab without navigating its host, delegate that operation to a validated background RPC handler. `currentPath()` reads the current document pathname; it is not the runtime context label.\n+\n+## Migration plan away from `$app/*`\n+\n+1. Inventory every `$app/*` import in shared packages.\n+2. Move each runtime-specific dependency behind a consumer-owned host interface.\n+3. Keep those interfaces small and capability-oriented.\n+4. Inject the host into shared components from the app entrypoint or page mount.\n+5. Make extension entrypoints build their own host adapters using `extfn` runtime and raw browser APIs.\n+\n+## What belongs where\n+\n+Put these in the consumer repo:\n+\n\n[779 more lines in file. Use offset=471 to continue.]"}],"isError":false,"timestamp":1791367599439}}
{"type":"message","id":"fcaa42c2","parentId":"65774932","timestamp":"2026-10-07T10:06:39.439Z","message":{"role":"toolResult","toolCallId":"call_59fed1623b0042919ef1a3546ff8862a|fc_055fb762f51dfcfc016ac619af315c87d0a24e553835d1b77f","toolName":"read","content":[{"type":"text","text":"\n<details>\n<summary>Prompt for AI agents</summary>\n\n```text\nCheck if this issue is valid — if so, understand the root cause and fix it. At extfn/docs/content/docs/configuration.md, line 13:\n\n<comment>The example code block uses `defineExtension` without importing it, so a reader copying the snippet gets an unresolved-identifier error. `content/docs/getting-started.md` introduces the same example with `import { defineExtension } from \"@extfn/core\";`; add the matching import here or reference the getting-started guide.</comment>\n\n<file context>\n@@ -0,0 +1,31 @@\n+An example with modular background handlers:\n+\n+```ts\n+export default defineExtension({\n+  name: \"Example Extension\",\n+  version: \"0.1.0\",\n</file context>\n```\n\n</details>\n\n```suggestion\nimport { defineExtension } from \"@extfn/core\";\n\nexport default defineExtension({\n```\n\n✅ Addressed in [`fec011e`](https://github.com/21nCo/super-functions/commit/fec011e7c940d9ddc09b282f33007d9c3ec1aca9)\n\n## PRRT_kwDOP-e7KM6mNogo extfn/docs/content/docs/runtime.md\n<!-- cubic:v=92a5513f-0079-4b6a-befd-8db36bc53a43 -->\n<!-- cubic:review-run=89d77ea6-21bc-5bb6-986a-2332a2024346 -->\n<!-- metadata:{\"confidence\":8} -->\nP3: The example's `globals: globalThis as never` is redundant and teaches a bad pattern: `createRuntime` already defaults `globals` to `globalThis` and derives `rawBrowser` from `globals.browser ?? globals.chrome ?? {}` (extfn/core/src/runtime/getRuntime.ts:58-64), so both options add nothing here while `as never` is a confusing cast for readers to copy. Omit `globals` and `rawBrowser` entirely and keep only the explicit target.\n\n<details>\n<summary>Prompt for AI agents</summary>\n\n```text\nCheck if this issue is valid — if so, understand the root cause and fix it. At extfn/docs/content/docs/runtime.md, line 14:\n\n<comment>The example's `globals: globalThis as never` is redundant and teaches a bad pattern: `createRuntime` already defaults `globals` to `globalThis` and derives `rawBrowser` from `globals.browser ?? globals.chrome ?? {}` (extfn/core/src/runtime/getRuntime.ts:58-64), so both options add nothing here while `as never` is a confusing cast for readers to copy. Omit `globals` and `rawBrowser` entirely and keep only the explicit target.</comment>\n\n<file context>\n@@ -0,0 +1,26 @@\n+import { createRuntime } from \"@extfn/core\";\n+\n+const runtime = createRuntime({\n+  globals: globalThis as never,\n+  rawBrowser: (globalThis as { browser?: unknown; chrome?: unknown }).browser\n+    ?? (globalThis as { browser?: unknown; chrome?: unknown }).chrome\n</file context>\n```\n\n</details>\n\n```suggestion\n  target: \"chromium-mv3\",\n```\n\n✅ Addressed in [`fec011e`](https://github.com/21nCo/super-functions/commit/fec011e7c940d9ddc09b282f33007d9c3ec1aca9)\n\n## PRRT_kwDOP-e7KM6mNogq extfn/docs/content/docs/reference/scan.md\n<!-- cubic:v=a9d6e688-119d-4687-a6a6-0d831dce355a -->\n<!-- cubic:review-run=89d77ea6-21bc-5bb6-986a-2332a2024346 -->\n<!-- metadata:{\"confidence\":8} -->\nP3: The example for a custom report directory does not produce the report at the path shown. `resolveReportDir` in extfn/cli/src/commands/scan.ts resolves a relative `--report-dir` against `path.resolve(outDir, '..')` — the extension config directory — so running this command from the repo root writes the report to `extfn/examples/svelte-datafn-demo/extfn/examples/svelte-datafn-demo/dist/custom-scan/chromium-mv3.json` (the path is duplicated, since the example path already starts with `extfn/...`), not to `extfn/examples/svelte-datafn-demo/dist/custom-scan`. Use a path relative to the config directory instead, or note the base for relative `--report-dir` values.\n\n<details>\n<summary>Prompt for AI agents</summary>\n\n```text\nCheck if this issue is valid — if so, understand the root cause and fix it. At extfn/docs/content/docs/reference/scan.md, line 94:\n\n<comment>The example for a custom report directory does not produce the report at the path shown. `resolveReportDir` in extfn/cli/src/commands/scan.ts resolves a relative `--report-dir` against `path.resolve(outDir, '..')` — the extension config directory — so running this command from the repo root writes the report to `extfn/examples/svelte-datafn-demo/extfn/examples/svelte-datafn-demo/dist/custom-scan/chromium-mv3.json` (the path is duplicated, since the example path already starts with `extfn/...`), not to `extfn/examples/svelte-datafn-demo/dist/custom-scan`. Use a path relative to the config directory instead, or note the base for relative `--report-dir` values.</comment>\n\n<file context>\n@@ -0,0 +1,116 @@\n+Custom report directory:\n+\n+```bash\n+npm exec extfn scan -- --config extfn/examples/svelte-datafn-demo/extfn.config.ts --report-dir extfn/examples/svelte-datafn-demo/dist/custom-scan\n+```\n+\n</file context>\n```\n\n</details>\n\n```suggestion\nnpm exec extfn scan -- --config extfn/examples/svelte-datafn-demo/extfn.config.ts --report-dir dist/custom-scan\n```\n\n✅ Addressed in [`fec011e`](https://github.com/21nCo/super-functions/commit/fec011e7c940d9ddc09b282f33007d9c3ec1aca9)\n\n## PRRT_kwDOP-e7KM6mNogr extfn/docs/tsconfig.json\n<!-- cubic:v=7a2a8015-60df-4d71-81b5-0be4f103424f -->\n<!-- cubic:review-run=89d77ea6-21bc-5bb6-986a-2332a2024346 -->\n<!-- metadata:{\"confidence\":5} -->\nP3: `types` restricts global type inclusion to `svelte` and `vite/client`, so `@types/node` (hoisted at the workspace root) is not loaded. With `checkJs: true` and `svelte.config.js` in `include`, `svelte-check`/`tsc`/editors will flag `process` in `svelte.config.js` (\"Cannot find name 'process'\"); `vite.config.ts`'s `node:path`/`node:url` imports also depend on `@types/node` being present. Either drop the `types` array so `@types/*` packages auto-load, or add `node` to the list.\n\n<details>\n<summary>Prompt for AI agents</summary>\n\n```text\nCheck if this issue is valid — if so, understand the root cause and fix it. At extfn/docs/tsconfig.json, line 21:\n\n<comment>`types` restricts global type inclusion to `svelte` and `vite/client`, so `@types/node` (hoisted at the workspace root) is not loaded. With `checkJs: true` and `svelte.config.js` in `include`, `svelte-check`/`tsc`/editors will flag `process` in `svelte.config.js` (\"Cannot find name 'process'\"); `vite.config.ts`'s `node:path`/`node:url` imports also depend on `@types/node` being present. Either drop the `types` array so `@types/*` packages auto-load, or add `node` to the list.</comment>\n\n<file context>\n@@ -0,0 +1,33 @@\n+      \"ES2022\",\n+      \"DOM\"\n+    ],\n+    \"types\": [\n+      \"svelte\",\n+      \"vite/client\"\n</file context>\n```\n\n</details>\n\n```suggestion\n    \"types\": [\n      \"svelte\",\n      \"vite/client\",\n      \"node\"\n    ]\n```\n\n✅ Addressed in [`fec011e`](https://github.com/21nCo/super-functions/commit/fec011e7c940d9ddc09b282f33007d9c3ec1aca9)\n\n## PRRT_kwDOP-e7KM6mNpbG extfn/docs/package.json\n**Security issue**  \n🛑 Blocker — must fix before merge\n\n**Known vulnerabilities in svelte@5.0.0**\n\nOSV.dev reports 6 known vulnerabilities affecting `svelte@5.0.0`, introduced by this PR:\n\n[628 more lines in file. Use offset=421 to continue.]"}],"isError":false,"timestamp":1791367599439}}
{"type":"message","id":"6d2950c9","parentId":"fcaa42c2","timestamp":"2026-10-07T10:06:39.440Z","message":{"role":"toolResult","toolCallId":"call_0295ca0589b64f39858fb89cbc1ea759|fc_055fb762f51dfcfc016ac619af316087d08d3ef8b23941c7b9","toolName":"read","content":[{"type":"text","text":"-Use whichever fits your assistant's context budget.\n+These are the configured publication URLs; a local build does not prove live hosting or credentials.\n \n-## How they're generated\n+## Generation\n \n-Both files are emitted by docsfn at build time:\n+The normal repository build prepares AuthFn's physical dependencies before regenerating OpenAPI and LLM content:\n \n-```bash\n-npm run docs:llms     # writes static/llms.txt and static/llms-full.txt\n+```sh\n+npm exec -- turbo run build --filter=@authfn/docs\n ```\n \n-The pipeline:\n+After those prerequisites are built, run from `authfn/docs`:\n \n-1. Walks every page in `content/docs/**`.\n-2. For each page, extracts the H1 + frontmatter description for `llms.txt`.\n-3. For each page, includes the full markdown body for `llms-full.txt`.\n-4. Appends the OpenAPI spec from `content/api/authfn.json` (operations + schemas).\n-5. Writes both files into `static/` so they ship with the deployed site.\n+```sh\n+npm run generate:openapi\n+npm run generate:llms\n+npm run check:llms\n+```\n+\n+`generate:llms` loads `docsfn.config.ts` through the consumer's published DocsFn package and filesystem provider, builds the manifest, and writes `static/llms.txt` and `static/llms-full.txt`. Native prerendered routes publish those files at `/docs/llms.txt` and `/docs/llms-full.txt`; the app-root static copies are not the advertised docs-owner URLs. `check:llms` compares generated content without writing it.\n \n ## Use it\n \n-In Cursor, Claude Desktop, ChatGPT custom GPTs, or anything that accepts a URL as context:\n+Supply the full-context URL to an assistant that accepts URLs:\n \n-```\n+```text\n https://authfn.com/docs/llms-full.txt\n ```\n \n-For local development against your own fork, you can also point at:\n+The default local docs port is 6005:\n \n-```\n+```text\n http://localhost:6005/docs/llms.txt\n http://localhost:6005/docs/llms-full.txt\n ```\n \n-## What's in `llms-full.txt`\n+## Configuration and size\n \n-Roughly:\n+The manifest follows the configured content directories and `site.canonicalUrl` in `docsfn.config.ts`. The shared `scripts/docs-site/llms.mjs` builder passes the canonical URL and excludes Blog posts with the published `includeBlog:false` option. There is no consumer `docs:llms` script or invented `llmsTxt` configuration object.\n \n-```text\n-# authfn — Self-hosted authentication for any stack\n-\n-> Sessions, OTP, passwords, social OAuth, 2FA, API keys, multi-region...\n-\n-## Welcome\n-[full body of index.md]\n-\n-## Getting Started\n-[full body of getting-started.md]\n-\n-## Core Concepts › Architecture\n-[full body of architecture.md]\n-\n-...\n-\n-## OpenAPI\n-- POST /sign-up/password — Create a new account with email and password.\n-- POST /sign-in/password — Sign in with email and password.\n-[...all 31 operations...]\n-```\n-\n-## Customizing\n-\n-The `docs:llms` task is configurable via `docsfn.config.ts`:\n-\n-```ts\n-{\n-  // ...\n-  llmsTxt: {\n-    enabled: true,\n-    includeOpenApi: true,\n-    includePages: ['docs/**'],\n-    excludePages: ['docs/blog/**'],\n-  },\n-}\n-```\n-\n-## Token budget\n-\n-| File | Approximate size |\n-| --- | --- |\n-| `llms.txt` | ~8 KB (~2,000 tokens) |\n-| `llms-full.txt` | ~250 KB (~65,000 tokens) |\n-\n-For models with smaller context windows, prefer `llms.txt` and use the [MCP server](./mcp) for on-demand retrieval.\n+Generated sizes vary with the corpus and API schema. Prefer the short index for smaller context budgets; retrieve individual linked pages or use the separately configured [MCP server](./mcp) when appropriate. Static context files do not authenticate an assistant or establish a live MCP connection.\n--- immutable-original-plan/filefn/docs/content/docs/ai-resources/index.md\n+++ explicit-supplement/filefn/docs/content/docs/ai-resources/index.md\n@@ -1,33 +1,21 @@\n ---\n title: AI Resources\n-description: Use filefn from your AI coding assistant — llms.txt, MCP server, Skills, and editor configurations.\n+description: Use FileFn documentation as assistant context without assuming unimplemented integrations.\n ---\n \n # AI Resources\n \n-filefn ships first-class support for AI coding assistants. The same documentation you read here is mirrored as machine-readable surfaces.\n+FileFn provides generated documentation context at its configured publication URLs:\n \n-| Surface | Use it from | Best for |\n-| --- | --- | --- |\n-| [llms.txt](./llms-txt) | Anywhere | Auto-included context in tools that read llms.txt. |\n-| [llms-full.txt](./llms-txt) | Anywhere | The whole site as a single text file. |\n-| [MCP server](./mcp) | MCP-aware clients (Claude Desktop, Cursor, etc.) | Live search + page fetch. |\n-| [Skills](./skills) | Skill-aware assistants | Pre-baked workflows (set up filefn, add a processor, debug a stuck upload). |\n-| [Cursor](./cursor) | Cursor IDE | Project-level rules + skills. |\n-| [Claude](./claude) | Claude Code / Claude Desktop | CLAUDE.md hints + MCP wiring. |\n-| [Codex](./codex) | OpenAI Codex / GPT-based agents | system-prompt friendly bundle. |\n+- [Short index](https://filefn.com/docs/llms.txt)\n+- [Full context](https://filefn.com/docs/llms-full.txt)\n \n-## Why?\n+See [LLM artifacts](./llms-txt) for generation and local verification. A successful local build does not establish live hosting.\n \n-filefn's surface is wide: 24 routes, 27 operations, a dozen configuration knobs, eight bundled processors, six storage adapters, and language SDKs in JS, Python, and Swift. AI assistants help users navigate it without reading every page.\n-\n-When you wire filefn into your AI tool of choice, the tool can:\n-\n-- answer \"how do I make this S3 bucket use a CDN?\" without you opening a docs tab.\n-- generate a custom processor matching your style with up-to-date type signatures.\n-- detect when your error code (e.g. `FILEFN_POLICY_MAX_SIZE_EXCEEDED`) is hit and suggest the relevant fix.\n-- run pre-baked workflows (\"install filefn into my Hono app\", \"add HEIC support\") without you knowing the route map.\n-\n-## See also\n-\n-- [Reference](../reference) — the same content the AI surfaces consume.\n+| Guide | Scope |\n+| --- | --- |\n+| [Claude](./claude) | Repository instructions and documentation context. |\n+| [Cursor](./cursor) | Project rules and documentation context. |\n+| [Codex](./codex) | Repository-aware context and review. |\n+| [MCP](./mcp) | Boundaries for an independently implemented integration. |\n\n[725 more lines in file. Use offset=291 to continue.]"}],"isError":false,"timestamp":1791367599440}}
