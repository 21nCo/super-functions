iteral;\n   233\t  });\n   234\t  const secretPattern = patterns.length ? new RegExp(patterns.join(\"|\"), \"g\") : undefined;\n   235\t  const replacementPattern = patterns.length ? new RegExp(patterns.join(\"|\")) : undefined;\n   236\t  const preserveStructural = (input: string): string => {\n   237\t    if (replacementPattern?.test(input)) {\n   238\t      throw new McpFnRedactionLimitError(\n   239\t        \"Credential collides with a required structural artifact field\",\n   240\t      );\n   241\t    }\n   242\t    return input;\n   243\t  };\n   244\t  const preserveStructuralKey = (input: string): string => {\n   245\t    if (replacementPattern?.test(input)) {\n   246\t      throw new McpFnStructuralCredentialCollisionError();\n   247\t    }\n   248\t    return input;\n   249\t  };\n   250\t  // A requested marker is itself output and must not reproduce a credential.\n   251\t  if (secretPattern) {\n   252\t    const markerContainsSecret = secretPattern.test(redactionMarker ?? \"[REDACTED]\");\n   253\t    secretPattern.lastIndex = 0;\n   254\t    if (markerContainsSecret) redactionMarker = \"\";\n   255\t  }\n   256\t  const scrubString = (input: string, role: string, field: string, finalPass: boolean): string => {\n   257\t    const structuralField = `${role}:${field}`;\n   258\t    if (unrestrictedStructuralValueFields.has(structuralField) ||\n   259\t        structuralArtifactValues.get(structuralField)?.has(input)) {\n   260\t      return preserveStructural(input);\n   261\t    }\n   262\t    // Whole-string rejection cannot compose another credential by joining pieces.\n   263\t    // Run after both redactors; never feed this result through another redactor.\n   264\t    if (finalPass) return replacementPattern?.test(input) ? \"\" : input;\n   265\t    if (!secretPattern) return input;\n   266\t    return input.replace(secretPattern, secret => {\n   267\t      const maskCharacter = secret.includes(\"*\") ? \"#\" : \"*\";\n   268\t      const defaultReplacement = secret.length < 10\n   269\t        ? maskCharacter.repeat(secret.length)\n   270\t        : \"[REDACTED]\";\n   271\t      const replacement = redactionMarker ?? defaultReplacement;\n   272\t      // Every generated mask must be safe against the entire credential set.\n   273\t      return replacementPattern!.test(replacement) ? \"\" : replacement;\n   274\t    });\n   275\t  };\n   276\t  function scrubArray(input: unknown[], role: string, finalPass: boolean): unknown[] {\n   277\t    const result = input.map(entry => scrub(entry, role, \"\", finalPass));\n   278\t    assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   279\t    return result;\n   280\t  }\n   281\t  function scrubObject(\n   282\t    input: Record<string, unknown>,\n   283\t    role: string,\n   284\t    finalPass: boolean,\n   285\t  ): Record<string, unknown> {\n   286\t    const entries: Array<[string, unknown]> = [];\n   287\t    const keys = new Set<string>();\n   288\t    for (const [key, entry] of Object.entries(input)) {\n   289\t      const fixed = envelopeKeys[role]?.has(key) ?? false;\n   290\t      if (fixed) preserveStructuralKey(key);\n   291\t      const childRole = childEnvelopeRole(\n   292\t        fixed,\n   293\t        key,\n   294\t        role,\n   295\t        input,\n   296\t        (value as { kind?: unknown } | null)?.kind,\n   297\t      );\n   298\t      const scrubbedKey = fixed ? key : scrub(key, \"payload\", \"\", finalPass) as string;\n   299\t      if (keys.has(scrubbedKey)) {\n   300\t        throw new McpFnRedactionLimitError(\n   301\t          \"Credential redaction created duplicate object keys\",\n   302\t        );\n   303\t      }\n   304\t      keys.add(scrubbedKey);\n   305\t      const scrubbedEntry = typeof entry === \"string\"\n   306\t        ? scrub(entry, fixed ? role : \"payload\", key, finalPass)\n   307\t        : scrub(entry, childRole, \"\", finalPass);\n   308\t      entries.push([scrubbedKey, scrubbedEnt