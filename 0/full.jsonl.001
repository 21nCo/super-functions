t)] };\n   176\t  }\n   177\t  if (input instanceof Set) {\n   178\t    if (Object.getOwnPropertyDescriptor(Set.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   179\t    return { type: \"Set\", values: [...Set.prototype.values.call(input)] };\n   180\t  }\n   181\t  return input;\n   182\t}\n   183\t\n   184\tfunction normalizeErrorValue(input: Error): Record<string, unknown> {\n   185\t  // Error instances may expose attacker-controlled enumerable keys. A\n   186\t  // null-prototype accumulator keeps `__proto__` as ordinary payload data.\n   187\t  const normalized = Object.create(null) as Record<string, unknown>;\n   188\t  let enumerableFields = 0;\n   189\t  for (const key in input) {\n   190\t    if (!Object.hasOwn(input, key)) continue;\n   191\t    if (++enumerableFields > 100_000) throw new McpFnRedactionLimitError();\n   192\t    normalized[key] = (input as unknown as Record<string, unknown>)[key];\n   193\t  }\n   194\t  normalized.name = input.name;\n   195\t  normalized.message = input.message;\n   196\t  normalized.stack = input.stack;\n   197\t  if (input.cause !== undefined) normalized.cause = input.cause;\n   198\t  return normalized;\n   199\t}\n   200\t\n   201\tfunction scrubCredentials<T>(value: T, values: Iterable<string>, preserveKeys = false, redactionMarker?: string): T {\n   202\t  // Preserve whether a pattern came from opaque text or a serializer. Literal\n   203\t  // percent sequences in credentials must not acquire URL hex-case semantics.\n   204\t  const variants = [...values].filter(Boolean).flatMap(secret => [\n   205\t    { value: secret, encoded: false },\n   206\t    { value: JSON.stringify(secret).slice(1, -1), encoded: false },\n   207\t    { value: encodeURIComponent(secret), encoded: true },\n   208\t    { value: new URLSearchParams({ value: secret }).toString().slice(\"value=\".length), encoded: true },\n   209\t  ]).sort((a, b) => b.value.length - a.value.length);\n   210\t  let entries = 0, stringBytes = 0;\n   211\t  const budget = (input: unknown, depth = 0): void => {\n   212\t    input = specialValue(input);\n   213\t    if ((Array.isArray(input) && input.length > 100_000) || ++entries > 100_000 || depth > 32) throw new McpFnRedactionLimitError();\n   214\t    if (typeof input === \"string\") {\n   215\t      stringBytes += Buffer.byteLength(input);\n   216\t      if (input.length > 262_144 || stringBytes > 2_097_152) throw new McpFnRedactionLimitError();\n   217\t    } else if (input && typeof input === \"object\") {\n   218\t      for (const key in input) if (Object.hasOwn(input, key)) {\n   219\t        budget(key, depth + 1);\n   220\t        budget((input as Record<string, unknown>)[key], depth + 1);\n   221\t      }\n   222\t    }\n   223\t  };\n   224\t  // Check before either redactor allocates copies. Exceeding a budget is an\n   225\t  // explicit failure, never silent truncation of a typed report collection.\n   226\t  budget(value);\n   227\t  const patterns = variants.map(({ value, encoded }) => {\n   228\t    const literal = value.replace(/[.*+?^${}()|[\\]\\\\]/g, String.raw`\\$&`);\n   229\t    // Only generated percent escapes accept mixed-case hex digits.\n   230\t    return encoded\n   231\t      ? literal.replace(/%[\\dA-Fa-f]{2}/g, escape => escape.replace(/[A-Fa-f]/g, hex => `[${hex.toLowerCase()}${hex.toUpperCase()}]`))\n   232\t      : literal;\n   233\t  });\n   234\t  const secretPattern = patterns.length ? new RegExp(patterns.join(\"|\"), \"g\") : undefined;\n   235\t  const replacementPattern = patterns.length ? new RegExp(patterns.join(\"|\")) : undefined;\n   236\t  const preserveStructural = (input: string): string => {\n   237\t    if (replacementPattern?.test(input)) {\n   238\t      throw new McpFnRedactionLimitError(\n   239\t        \"Credential collides with a required structural artifact field\",\n   240\t      );\n   241\t    }\n   242\t    return input;\n   243\t  };\n   244\t  const preserveStructuralKey = (input: string): string => {\n   245\t    if (replacementPattern?.test(input)) {\n   246\t      throw new McpFnStructuralCredentialCollisionError();\n   247\t    }\n   248\t    return input;\n   249\t  };\n   250\t  // A requested marker is itself output and must not reproduce a credential.\n   251\t  if (secretPattern) {\n   252\t    const markerContainsSecret = secretPattern.test(redactionMarker ?? \"[REDACTED]\");\n   253\t    secretPattern.lastIndex = 0;\n   254\t    if (markerContainsSecret) redactionMarker = \"\";\n   255\t  }\n   256\t  const scrubString = (input: string, role: string, field: string, finalPass: boolean): string => {\n   257\t    const structuralField = `${role}:${field}`;\n   258\t    if (unrestrictedStructuralValueFields.has(structuralField) ||\n   259\t        structuralArtifactValues.get(structuralField)?.has(input)) {\n   260\t      return preserveStructural(input);\n   261\t    }\n   262\t    // Whole-string rejection cannot compose another credential by joining pieces.\n   263\t    // Run after both redactors; never feed this result through another redactor.\n   264\t    if (finalPass) return replacementPattern?.test(input) ? \"\" : input;\n   265\t    if (!secretPattern) return input;\n   266\t    return input.replace(secretPattern, secret => {\n   267\t      const maskCharacter = secret.includes(\"*\") ? \"#\" : \"*\";\n   268\t      const defaultReplacement = secret.length < 10\n   269\t        ? maskCharacter.repeat(secret.length)\n   270\t        : \"[REDACTED]\";\n   271\t      const replacement = redactionMarker ?? defaultReplacement;\n   272\t      // Every generated mask must be safe against the entire credential set.\n   273\t      return replacementPattern!.test(replacement) ? \"\" : replacement;\n   274\t    });\n   275\t  };\n   276\t  function scrubArray(input: unknown[], role: string, finalPass: boolean): unknown[] {\n   277\t    const result = input.map(entry => scrub(entry, role, \"\", finalPass));\n   278\t   