{"timestamp":"2026-09-19T10:01:20.802Z","ordinal":4509,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b3f5-d570-7a72-b668-401efd539e3b","turn_id":"01a0b91a-027b-7173-bd75-a52040008bc7","item":{"type":"CommandExecution","id":"exec-42c25e76-b77a-4de2-9b6c-d8c79c26fc47","process_id":"39586","command":["/bin/zsh","-lc","commit_time=$(git show -s --format=%cI cf76637ada4ba0263e36f30c23a278826c48dd0a)\necho \"commit_time=$commit_time\"\nSNAPSHOT_PATH=/tmp/pr170-round10.Cz60UU/snapshot.json COMMIT_TIME=\"$commit_time\" node --input-type=module <<'NODE'\nimport { readFileSync } from \"node:fs\";\nconst s = JSON.parse(readFileSync(process.env.SNAPSHOT_PATH, \"utf8\"));\nconst since = new Date(process.env.COMMIT_TIME);\nconst simplify = t => {\n  const current = t.comments.filter(c => !c.outdated);\n  const latest = [...t.comments].sort((a,b)=>a.createdAt.localeCompare(b.createdAt)).at(-1);\n  return { id:t.id, path:t.path, isResolved:t.isResolved, currentCount:current.length, latest:{author:latest?.author?.login,createdAt:latest?.createdAt,outdated:latest?.outdated,line:latest?.line,url:latest?.url,body:latest?.body} };\n};\nconst unresolved = s.threads.filter(t=>!t.isResolved);\nconst newThreads = unresolved.filter(t=>t.comments.some(c=>new Date(c.createdAt)>since)).map(simplify);\nconst current = unresolved.filter(t=>t.comments.some(c=>!c.outdated)).map(simplify);\nconst newReviews = s.reviews.filter(x=>x.submitted_at && new Date(x.submitted_at)>since && x.body?.trim()).map(x=>({id:x.id,user:x.user?.login,state:x.state,submittedAt:x.submitted_at,url:x.html_url,body:x.body}));\nconst newIssue = s.issueComments.filter(x=>new Date(x.created_at)>since).map(x=>({id:x.id,user:x.user?.login,createdAt:x.created_at,url:x.html_url,body:x.body}));\nconsole.log(JSON.stringify({newThreads,newReviews,newIssue,currentThreadIndex:current.map(({latest,...rest})=>({...rest,latest:{...latest,body:latest.body?.slice(0,800)}}))},null,2));\nNODE"],"cwd":"file:///Users/serro/Documents/dev/n/worktrees/superfunctions/PR-170","parsed_cmd":[{"type":"unknown","cmd":"commit_time=$(git show -s --format=%cI cf76637ada4ba0263e36f30c23a278826c48dd0a)\necho \"commit_time=$commit_time\"\nSNAPSHOT_PATH=/tmp/pr170-round10.Cz60UU/snapshot.json COMMIT_TIME=\"$commit_time\" node --input-type=module <<'NODE'\nimport { readFileSync } from \"node:fs\";\nconst s = JSON.parse(readFileSync(process.env.SNAPSHOT_PATH, \"utf8\"));\nconst since = new Date(process.env.COMMIT_TIME);\nconst simplify = t => {\n  const current = t.comments.filter(c => !c.outdated);\n  const latest = [...t.comments].sort((a,b)=>a.createdAt.localeCompare(b.createdAt)).at(-1);\n  return { id:t.id, path:t.path, isResolved:t.isResolved, currentCount:current.length, latest:{author:latest?.author?.login,createdAt:latest?.createdAt,outdated:latest?.outdated,line:latest?.line,url:latest?.url,body:latest?.body} };\n};\nconst unresolved = s.threads.filter(t=>!t.isResolved);\nconst newThreads = unresolved.filter(t=>t.comments.some(c=>new Date(c.createdAt)>since)).map(simplify);\nconst current = unresolved.filter(t=>t.comments.some(c=>!c.outdated)).map(simplify);\nconst newReviews = s.reviews.filter(x=>x.submitted_at && new Date(x.submitted_at)>since && x.body?.trim()).map(x=>({id:x.id,user:x.user?.login,state:x.state,submittedAt:x.submitted_at,url:x.html_url,body:x.body}));\nconst newIssue = s.issueComments.filter(x=>new Date(x.created_at)>since).map(x=>({id:x.id,user:x.user?.login,createdAt:x.created_at,url:x.html_url,body:x.body}));\nconsole.log(JSON.stringify({newThreads,newReviews,newIssue,currentThreadIndex:current.map(({latest,...rest})=>({...rest,latest:{...latest,body:latest.body?.slice(0,800)}}))},null,2));\nNODE"}],"source":"unified_exec_startup","status":"completed","stdout":"{\n  \"newThreads\": [\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6jyW3y\",\n      \"path\": \"mcpfn/inspector/src/index.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-18T15:03:35Z\",\n        \"outdated\": false,\n        \"line\": 251,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4047930609\",\n        \"body\": \"**<sub><sub>![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)</sub></sub>  Validate top-level scenario keys before export**\\n\\nWhen an active target credential equals a top-level scenario key such as `name`, this mapping redacts only the corresponding value and copies the key verbatim. Consequently, `exportScenario()` returns an artifact containing the exact credential even though nested argument keys are scrubbed; validate the fixed scenario keys with the target redactor or fail the export on a structural collision.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6jyW37\",\n      \"path\": \"mcpfn/testing/src/host-authorization.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-18T15:03:35Z\",\n        \"outdated\": false,\n        \"line\": 460,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4047930620\",\n        \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Reject parameterized cache-prevention directives**\\n\\nFresh evidence after adding the token-response header checks is that `hasHeaderDirective()` accepts malformed values such as `Cache-Control: no-store=false` and `Pragma: no-cache=false` by discarding everything after `=`. Those directives do not satisfy the required `no-store`/`no-cache` response values, yet the hosted regression reports the token exchange as passed; require these argument-free directives to have no parameter.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6jyasF\",\n      \"path\": \"mcpfn/testing/src/suite.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"pullfrog\",\n        \"createdAt\": \"2026-09-18T15:06:27Z\",\n        \"outdated\": false,\n        \"line\": 390,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4047954117\",\n        \"body\": \"**[P1] Preserve the retained cleanup owner on this failure path**\\n\\nThis immediate throw bypasses the `retainedCleanup` handoff below, so when structural collision and credential/transport cleanup fail together, callers receive no `retryCleanup()` capability and cannot complete release. Preserve access to the pending cleanup owner while still failing without serializing the credential-colliding report.\\n\\n<details><summary>Technical details</summary>\\n\\n````markdown\\n# Keep cleanup retryable when report structure is unsafe\\n\\n## Affected sites\\n- `mcpfn/testing/src/suite.ts:285-307` — captures failed close/revocation ownership in `retainedCleanup`.\\n- `mcpfn/testing/src/suite.ts:389-394` — throws the structural-collision error before ownership is transferred.\\n- `mcpfn/testing/src/suite.ts:407` — the normal `McpFnTargetSuiteCleanupError` handoff is unreachable on this branch.\\n\\n## Required outcome\\n- A required-key credential collision must remain a safe hard failure.\\n- If cleanup also failed, the thrown failure must retain a callable, serialized retry owner without exposing the unsafe report.\\n- Add a combined structural-collision plus failed-cleanup regression that retries cleanup successfully.\\n````\\n\\n</details>\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6jybjm\",\n      \"path\": \"mcpfn/testing/src/suite.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"cubic-dev-ai\",\n        \"createdAt\": \"2026-09-18T15:07:07Z\",\n        \"outdated\": false,\n        \"line\": 390,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4047959467\",\n        \"body\": \"<!-- cubic:v=cb20f140-b9f3-4dd8-a1f8-e7e83edc5da8 -->\\n<!-- cubic:review-run=47c61d9f-3ebe-5e12-b906-aab16497065f -->\\n<!-- metadata:{\\\"confidence\\\":9} -->\\nP1: When final report redaction collides with a credential after `client.close()` failed, this branch discards the retryable cleanup owner. Preserve the cleanup error and retry handle before surfacing the structural-serialization failure.\\n\\n<details>\\n<summary>Prompt for AI agents</summary>\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At mcpfn/testing/src/suite.ts, line 390:\\n\\n<comment>When final report redaction collides with a credential after `client.close()` failed, this branch discards the retryable cleanup owner. Preserve the cleanup error and retry handle before surfacing the structural-serialization failure.</comment>\\n\\n<file context>\\n@@ -367,15 +381,22 @@ async function runTargetSuite(options: RunMcpFnTargetSuiteOptions): Promise<McpF\\n     finalized = enforceReportCap(redactTargetCredentials(options.target, report, { preserveKeys: true }), maxReportBytes);\\n   } catch (error) {\\n+    if (error instanceof McpFnStructuralCredentialCollisionError) {\\n+      throw new McpFnClientError(\\n+        \\\"MCPFN_OPERATION_FAILED\\\",\\n+        \\\"Target report cannot be serialized because a credential conflicts with required artifact structure\\\",\\n</file context>\\n```\\n\\n</details>\"\n      }\n    }\n  ],\n  \"newReviews\": [\n    {\n      \"id\": 5249284037,\n      \"user\": \"chatgpt-codex-connector[bot]\",\n      \"state\": \"COMMENTED\",\n      \"submittedAt\": \"2026-09-18T15:03:34Z\",\n      \"url\": \"https://github.com/21nCo/super-functions/pull/170#pullrequestreview-5249284037\",\n      \"body\": \"\\n### 💡 Codex Review\\n\\nHere are some automated review suggestions for this pull request.\\n\\n**Reviewed commit:** `cf76637ada`\\n    \\n\\n<details> <summary>ℹ️ About Codex in GitHub</summary>\\n<br/>\\n\\n[Your team has set up Codex to review pull requests in this repo](https://chatgpt.com/codex/cloud/settings/general). Reviews are triggered when you\\n- Open a pull request for review\\n- Mark a draft as ready\\n- Comment \\\"@codex review\\\".\\n\\nIf Codex has suggestions, it will comment; otherwise it will react with 👍.\\n\\n\\n\\n\\nCodex can also answer questions or update the PR. Try commenting \\\"@codex address that feedback\\\".\\n            \\n</details>\"\n    },\n    {\n      \"id\": 5249315211,\n      \"user\": \"pullfrog[bot]\",\n      \"state\": \"COMMENTED\",\n      \"submittedAt\": \"2026-09-18T15:06:28Z\",\n      \"url\": \"https://github.com/21nCo/super-functions/pull/170#pullrequestreview-5249315211\",\n      \"body\": \"> [!IMPORTANT]\\n> Structural report-key collisions can discard retryable cleanup ownership.\\n\\n**Reviewed changes** since the prior Pullfrog review at `dfaeef0d`, covering the seven-file artifact-boundary hardening delta in `cf76637a`.\\n\\n- **Stabilized CLI failure classification** — Made classified diagnostic writes best-effort and covered a persistently rejecting `stderr` sink.\\n- **Protected target descriptors** — Added a shared structural-redaction boundary for client event and diagnostic target descriptors.\\n- **Rejected structural credential collisions** — Added explicit required-key collision errors and distinguished redaction from serialization projection failures.\\n- **Expanded regressions** — Added target discriminator and required report-key collision coverage.\\n\\n<!--\\nPullfrog review metadata. These findings were written against cf76637a;\\nif commits have landed on codex/mcp-1-transport-neutral-conformance-0910 since, treat every specific bug, file, or\\nline callout as POTENTIALLY STALE and re-diff before acting on it.\\n\\n- Mode: IncrementalReview (delta against prior pullfrog review)\\n- Files reviewed: 61 (7 changed in the incremental commit)\\n- Commits reviewed: 69 (1 since the prior review)\\n- Base: dev (2867c68f)\\n- Head: codex/mcp-1-transport-neutral-conformance-0910 (cf76637a)\\n- Reviewed commits:\\n  - cf76637a — fix(mcpfn): harden artifact failure boundaries\\n- Prior pullfrog review: dfaeef0d (https://github.com/21nCo/super-functions/pull/170#pullrequestreview-5248475385)\\n-->\\n\\n<!-- PULLFROG_DIVIDER_DO_NOT_REMOVE_PLZ -->\\n<sup><a href=\\\"https://pullfrog.com\\\"><picture><source media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://pullfrog.com/logos/frog-white-full-18px.png\\\"><img src=\\\"https://pullfrog.com/logos/frog-green-full-18px.png\\\" width=\\\"9px\\\" height=\\\"9px\\\" style=\\\"vertical-align: middle; \\\" alt=\\\"Pullfrog\\\"></picture></a>&nbsp;&nbsp;｜ [Fix all ➔](https://pullfrog.com/trigger/21nCo/super-functions/170?action=fix&review_id=5249315211) ｜ [Fix 👍s ➔](https://pullfrog.com/trigger/21nCo/super-functions/170?action=fix-approved&review_id=5249315211) ｜ [View workflow run](https://github.com/21nCo/super-functions/actions/runs/35359486263/job/105646926366) ｜ Using `GPT Sol` ｜ [𝕏](https://x.com/pullfrogai)</sup>\"\n    },\n    {\n      \"id\": 5249322102,\n      \"user\": \"cubic-dev-ai[bot]\",\n      \"state\": \"COMMENTED\",\n      \"submittedAt\": \"2026-09-18T15:07:07Z\",\n      \"url\": \"https://github.com/21nCo/super-functions/pull/170#pullrequestreview-5249322102\",\n      \"body\": \"<!-- cubic:review-summary:start -->\\n**1 issue found across 7 files (changes from recent commits).**\\n<!-- cubic:review-summary:end -->\\n\\n<details>\\n<summary>Prompt for AI agents (unresolved issues)</summary>\\n\\n```text\\n\\nCheck if these issues are valid — if so, understand the root cause of each and fix them. If appropriate, use sub-agents to investigate and fix each issue separately.\\n\\n\\n<file name=\\\"mcpfn/testing/src/suite.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"mcpfn/testing/src/suite.ts:390\\\">\\nP1: When final report redaction collides with a credential after `client.close()` failed, this branch discards the retryable cleanup owner. Preserve the cleanup error and retry handle before surfacing the structural-serialization failure.</violation>\\n</file>\\n```\\n\\n</details>\\n\\n<sub>**Tip**: Review your code locally with the [cubic CLI](https://docs.cubic.dev/ide/cli-review?utm_source=github&utm_content=general_review_body) to iterate faster.<br /><br />[Re-trigger cubic](https://www.cubic.dev/action/re-review/pr/21nCo/super-functions/170/ai_pr_review_github_delivery_87f6a2928cff69047c408f1334ce1558011e41a6b409fde086a67fafe67468f7?returnTo=https%3A%2F%2Fgithub.com%2F21nCo%2Fsuper-functions%2Fpull%2F170)</sub>\\n\\n<!-- cubic:review-post:ai_pr_review_github_delivery_87f6a2928cff69047c408f1334ce1558011e41a6b409fde086a67fafe67468f7:cf76637ada4ba0263e36f30c23a278826c48dd0a:47c61d9f-3ebe-5e12-b906-aab16497065f -->\"\n    }\n  ],\n  \"newIssue\": [\n    {\n      \"id\": 5731885458,\n      \"user\": \"sonarqubecloud[bot]\",\n      \"createdAt\": \"2026-09-18T15:00:53Z\",\n      \"url\": \"https://github.com/21nCo/super-functions/pull/170#issuecomment-5731885458\",\n      \"body\": \"## [![Quality Gate Passed](https://sonarsource.github.io/sonarcloud-github-static-resources/v2/checks/QualityGateBadge/qg-passed-20px.png 'Quality Gate Passed')](https://sonarcloud.io/dashboard?id=21nCo_super-functions&pullRequest=170) **Quality Gate passed**  \\nIssues  \\n![](https://sonarsource.github.io/sonarcloud-github-static-resources/v2/common/passed-16px.png '') [38 New issues](https://sonarcloud.io/project/issues?id=21nCo_super-functions&pullRequest=170&issueStatuses=OPEN,CONFIRMED&sinceLeakPeriod=true)  \\n![](https://sonarsource.github.io/sonarcloud-github-static-resources/v2/common/accepted-16px.png '') [0 Accepted issues](https://sonarcloud.io/project/issues?id=21nCo_super-functions&pullRequest=170&issueStatuses=ACCEPTED)\\n\\nMeasures  \\n![](https://sonarsource.github.io/sonarcloud-github-static-resources/v2/common/passed-16px.png '') [0 Security Hotspots](https://sonarcloud.io/project/security_hotspots?id=21nCo_super-functions&pullRequest=170&issueStatuses=OPEN,CONFIRMED&sinceLeakPeriod=true)  \\n![](https://sonarsource.github.io/sonarcloud-github-static-resources/v2/common/passed-16px.png '') [0.0% Coverage on New Code](https://sonarcloud.io/component_measures?id=21nCo_super-functions&pullRequest=170&metric=new_coverage&view=list)  \\n![](https://sonarsource.github.io/sonarcloud-github-static-resources/v2/common/passed-16px.png '') [2.4% Duplication on New Code](https://sonarcloud.io/component_measures?id=21nCo_super-functions&pullRequest=170&metric=new_duplicated_lines_density&view=list)  \\n  \\n<!-- sqra-placement-anchor -->\\n[See analysis details on SonarQube Cloud](https://sonarcloud.io/dashboard?id=21nCo_super-functions&pullRequest=170)\\n\\n\"\n    }\n  ],\n  \"currentThreadIndex\": [\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6hIm1W\",\n      \"path\": \"mcpfn/testing/src/reports.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-10T15:21:07Z\",\n        \"outdated\": false,\n        \"line\": 119,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r3980654436\",\n        \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Represent incomplete suites as JUnit failures**\\n\\nFor a suite containing only incomplete scenarios, failure elements are emitted for those scenarios but the `testsuite` attribute still declares `failures=\\\"0\\\"` because `safe.incomplete` is omitted here. A suite made incomplete solely by dropped diagnostic events or report truncation has the same zero-failure declaration and may not contain any failure element at all, so JUnit consumers can display a green run while the JSON report has `ok: false`.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6hIm1d\",\n      \"path\": \"mcpfn/testing/src/suite.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-10T15:21:08Z\",\n        \"outdated\": false,\n        \"line\": 218,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r3980654448\",\n        \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Enforce visible tools without requiring a manifest**\\n\\nWhen `mcpfn test-target` is invoked with `--visible-tools` but without the separately optional `--manifest`, the CLI forwards the expected names, but this condition skips the only call that uses them. The command can therefore exit successfully against a target exposing the wrong tool inventory while silently ignoring an explicitly requested check; either compare the live names independently or reject this option combination.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6hJBPf\",\n      \"path\": \"mcpfn/testing/src/conformance.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"cubic-dev-ai\",\n        \"createdAt\": \"2026-09-10T15:38:34Z\",\n        \"outdated\": false,\n        \"line\": 384,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r3980817019\",\n        \"body\": \"<!-- cubic:v=af62c06d-a138-4c4d-9e49-6f4e5a3f5aa8 -->\\n<!-- cubic:review-run=2794c884-4528-5630-ad81-9c892ab7aad2 -->\\n<!-- metadata:{\\\"confidence\\\":5} -->\\nP2: When a library caller acquires credentials from an env var and calls runAuthenticatedOfficialConformance without setting sensitiveEnvironmentVariables (defaults to []), the spawned @modelcontextprotocol/conformance npx process inherits that env var, since buildOfficialConformanceEnvironment only strips explicitly listed names. The CLI wires this correctly, but the library API offers no automatic guard. Note in the credential/headers doc that the credential env must also be listed in sensitiveEnvironmentVariables, or strip credential-source env names automatically.\\n\\n<details>\\n<summary>Prompt for AI agents</summary>\\n\\n```text\\nCheck if this\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6hds9u\",\n      \"path\": \"mcpfn/testing/src/remote-target.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-11T12:22:45Z\",\n        \"outdated\": false,\n        \"line\": 489,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r3989065994\",\n        \"body\": \"**<sub><sub>![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)</sub></sub>  Redact acquired credential values from artifacts**\\n\\nWhen an authenticated target reflects an opaque credential under a non-sensitive field and a scenario assertion fails, the actual response is embedded in the scenario error, but the acquired header values are never supplied to the redactor. For example, an API key returned as `{ \\\"echo\\\": \\\"opaque-123\\\" }` survives `redactOAuthValue` and is subsequently written to the JSON/JUnit output and CI artifacts. Track the acquired credential values and replace them explicitly before producing diagnostics or reports.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6hds9y\",\n      \"path\": \"mcpfn/testing/src/host-authorization.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-11T12:22:45Z\",\n        \"outdated\": false,\n        \"line\": 245,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r3989066000\",\n        \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Validate OAuth error responses before accepting rejections**\\n\\nFor expected-rejection fixtures, any response containing an OAuth `error` is accepted before its transport envelope is validated. Consequently, `chatgpt-unregistered-redirect` can pass when the server redirects to the unregistered drifted URI or returns a mismatched state with `error=invalid_request`, and the unsupported-grant case can pass with an HTTP 200 JSON error. Validate the phase-appropriate status and, for authorization redirects, the callback destination and state before assessing the error code.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6hi7n2\",\n      \"path\": \"mcpfn/cli/src/index.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-11T16:10:35Z\",\n        \"outdated\": false,\n        \"line\": 314,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r3991101834\",\n        \"body\": \"**<sub><sub>![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)</sub></sub>  Scrub acquired credentials from inspect snapshots**\\n\\nWhen the new authenticated `inspect` option is used against a server that reflects the opaque API key or bearer token in initialization metadata or inventory (for example, a tool description), `McpFnInspector.snapshot()` only performs credential-pattern redaction and the raw acquired value remains in stdout and `--output`. The target-suite path explicitly applies `redactTargetCredentials`, but this inspect path does not, so the option advertised as producing a redacted snapshot can leak its credential.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6hvRyg\",\n      \"path\": \"mcpfn/client/src/client.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-12T10:15:58Z\",\n        \"outdated\": false,\n        \"line\": 1188,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r3995915243\",\n        \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Retain handles whose credential cleanup fails**\\n\\nWhen an authenticated target's protocol closes remotely, or an in-progress open is aborted, the client calls this helper with `strict=false` and then discards the only handle reference. If the credential provider's `revoke` or `dispose` rejects, this catch silently consumes the failure; despite the authenticated handle resetting its close promise for a retry, no later `client.close()` can reach it, and the remote-close path even reports cleanup as succeeded. Preserve the handle for retry or retry credential cleanup before swallowing the transport-close error.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6hwDvL\",\n      \"path\": \"mcpfn/client/src/client.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-12T12:36:08Z\",\n        \"outdated\": false,\n        \"line\": 108,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r3996211859\",\n        \"body\": \"**<sub><sub>![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)</sub></sub>  Version the modified client before publishing consumers**\\n\\nWhen this change is released, the new cleanup-retention behavior here will not reach registry users because `mcpfn/client/package.json` remains at `0.0.3`, while `@mcpfn/testing@0.0.5` and `@mcpfn/cli@0.0.6` still pin `@mcpfn/client` to that already-published version. The publish workflow installs dependencies from the registry, so released authenticated suites will run against the previous client implementation rather than these changes; bump the client version and update the consumer dependency pins.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6hyYN4\",\n      \"path\": \"mcpfn/client/package.json\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"cubic-dev-ai\",\n        \"createdAt\": \"2026-09-12T18:14:31Z\",\n        \"outdated\": false,\n        \"line\": 3,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r3997111964\",\n        \"body\": \"<!-- cubic:v=19571ced-3947-4690-a694-33cf0f24bb87 -->\\n<!-- cubic:review-run=4e2c1d2d-c516-5a44-9510-21b8f7b1be54 -->\\n<!-- metadata:{\\\"confidence\\\":7} -->\\nP2: Bumping @mcpfn/client to 0.0.4 leaves @mcpfn/inspector's dependency on \\\"@mcpfn/client\\\": \\\"0.0.3\\\" unsatisfied by the workspace (which is now 0.0.4). With npm workspaces an exact pin is not matched by the higher workspace version, so npm installs a separate copy of the old published client from the registry instead of linking the local 0.0.4 code — exactly the split the lockfile already shows for @mcpfn/testing: mcpfn/inspector/node_modules/@mcpfn/testing and mcpfn/datafn/node_modules/@mcpfn/testing are nested registry installs of testing 0.0.4 (resolved to registry.npmjs.org) while the workspace testing is 0.0.5. Inspector then builds/tes\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6hyYxS\",\n      \"path\": \"mcpfn/testing/src/host-authorization.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-12T18:16:03Z\",\n        \"outdated\": false,\n        \"line\": 453,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r3997115544\",\n        \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Require JSON media types for successful token responses**\\n\\nFor either authorization-code exchange or refresh, a server can return HTTP 200 with `Content-Type: text/plain` and a JSON-looking body; `Response.json()` still parses it, so the hosted case is reported as passed despite the invalid OAuth token-response envelope. Apply the existing JSON media-type validation to successful token responses before accepting their fields.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6hytBi\",\n      \"path\": \"mcpfn/testing/src/remote-target.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-12T19:05:14Z\",\n        \"outdated\": false,\n        \"line\": 506,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r3997239946\",\n        \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Retain every lease until cleanup succeeds**\\n\\nWhen an authenticated open succeeds but MCP initialization subsequently fails, this catch is never entered, so the lease is absent from `pendingReleases`. `McpFnTestClient.connectTarget()` can then retry `session.close()` once, swallow a second revocation failure, and discard the session containing the retained handle; even `target.cleanup()` has no reference to that lease, leaving a credential that would succeed on a later retry active indefinitely. Register each acquired lease as pending immediately and remove it only after successful release.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6h2blp\",\n      \"path\": \"mcpfn/testing/src/suite.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-13T04:30:51Z\",\n        \"outdated\": false,\n        \"line\": 362,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r3998727552\",\n        \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Bound failure text before enforcing the report cap**\\n\\nWhen a target or manifest operation throws a long message and the caller selects a supported small `maxReportBytes` value, the message is copied both here and into `failure.message`. `enforceReportCap()` drops results, timeline, metadata, and failure details, but never truncates either message, so a target throwing roughly 2 KiB of text with a 1024-byte cap makes `runMcpFnTargetSuite()` throw instead of returning a bounded incomplete report. Truncate or omit failure text during cap enforcement.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6h4C83\",\n      \"path\": \"mcpfn/cli/src/index.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-13T10:15:34Z\",\n        \"outdated\": false,\n        \"line\": 572,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r3999354703\",\n        \"body\": \"**<sub><sub>![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)</sub></sub>  Validate bearer headers without echoing their values**\\n\\nWhen `--bearer-token-env` contains an invalid HTTP header value, such as a multiline token, this branch accepts it without the safe validation used for API keys. Authenticated conformance later constructs `Headers`, whose thrown error includes the offending `Bearer <secret>` value; the conformance cleanup rethrows it and the CLI prints it verbatim to stderr. Validate bearer headers here and replace validation failures with a generic message, or redact setup errors before they escape.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6h7BuQ\",\n      \"path\": \"mcpfn/testing/src/conformance.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-13T18:39:15Z\",\n        \"outdated\": false,\n        \"line\": 401,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4000501850\",\n        \"body\": \"**<sub><sub>![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)</sub></sub>  Redact conformance credentials before truncating output**\\n\\nFor authenticated conformance, `runOfficialConformance()` first truncates stdout and stderr to 262,144 characters, and only afterward does this call scrub the acquired credential. If an opaque credential crosses that truncation boundary, only its prefix remains, so exact-value replacement cannot recognize it and the prefix is returned in the report and printed by the CLI. Apply known-credential redaction to raw captured output before any truncation.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6h7UaX\",\n      \"path\": \"mcpfn/testing/src/host-authorization.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-13T19:25:10Z\",\n        \"outdated\": false,\n        \"line\": 382,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4000615519\",\n        \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Reject invalid-client authorization redirects**\\n\\nWhen an authorization server redirects to a registered callback with `error=invalid_client` and the correct state, this branch accepts the envelope and the `incompatible-registration-grants` fixture passes. Invalid-client failures must not redirect, as the non-redirect branch itself notes. The fresh evidence beyond the earlier envelope issue is that `validateOAuthRejection` still does not receive or inspect the extracted error code before accepting redirects.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6h7n7g\",\n      \"path\": \"mcpfn/client/src/client.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-13T20:06:03Z\",\n        \"outdated\": false,\n        \"line\": 526,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4000737352\",\n        \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Preserve permanent close requests during remote shutdown**\\n\\nWhen the protocol closes remotely and an application calls the default `close()` while this automatic `close(false)` is still running, `close()` returns the existing non-permanent promise, whose completion sets the client state to `idle` rather than `closed`. Thus an explicit permanent shutdown can report success without producing the requested final state; record or escalate the permanent request when sharing the in-flight close.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6h_qwT\",\n      \"path\": \"mcpfn/client/src/client.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-14T05:04:29Z\",\n        \"outdated\": false,\n        \"line\": 631,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4002337953\",\n        \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Reset permanent-close intent before reconnecting**\\n\\nWhen `reconnect()` is used after a permanent close, or to recover from a failed permanent close, this sticky flag remains true: `reconnect()` sets the state directly to `idle`, so `connect()` never executes its `closed`-state reset. A later remote shutdown calls `close(false)` but still transitions the client to `closed` rather than `idle`. The fresh evidence following the in-flight close-escalation fix is that permanent intent is now retained across the explicit reconnect path; clear it when reopening for a reconnect.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6iAHDs\",\n      \"path\": \"mcpfn/testing/src/remote-target.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-14T05:50:31Z\",\n        \"outdated\": false,\n        \"line\": 464,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4002514711\",\n        \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Use a fresh signal context for credential cleanup**\\n\\nWhen `close()` aborts a connection while this target is opening or initializing, `targetContext.signal` becomes permanently aborted, yet the same context is retained by `acquireRemoteCredential()` and later passed to the provider's `revoke` and `dispose` methods. A provider that uses the supplied signal for its revocation request will therefore fail every immediate and retained cleanup retry, potentially leaving the credential active indefinitely. Supply cleanup with a separate non-aborted signal or context.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6iBYug\",\n      \"path\": \"mcpfn/testing/src/remote-target.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-14T07:29:04Z\",\n        \"outdated\": false,\n        \"line\": 544,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4003013050\",\n        \"body\": \"**<sub><sub>![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)</sub></sub>  Wire authenticated targets into programmatic redaction**\\n\\nWhen `authenticatedHttpTarget` is used through the public `McpFnInspector` or `McpFnClient` APIs rather than the CLI or target-suite wrapper, this module-private credential state is never consulted. A server that reflects an opaque header value in an ordinary field such as a tool description, result, or logging event will therefore have that value preserved by the inspector's generic `redactOAuthValue()` calls and exposed by `snapshot()`, `exportScenario()`, or diagnostic listeners, despite those programmatic surfaces being documented as redacted. Expose a target-aware redaction hook to the client/inspector or have those surfaces apply the exact \"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6iCKPn\",\n      \"path\": \"mcpfn/testing/src/conformance.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-14T08:13:40Z\",\n        \"outdated\": false,\n        \"line\": 405,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4003320112\",\n        \"body\": \"**<sub><sub>![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)</sub></sub>  Snapshot credentials before asynchronous conformance**\\n\\nWhen a custom provider returns a shared mutable `Headers`, another acquisition or token rotation can change it while the runner is active. The proxy has already copied and injected the original value, but this post-run redaction rereads `lease.credential.headers`, so reflected output containing the original token no longer matches and can leak in the returned report; revocation may also receive the replacement token. Snapshot the acquired headers and opaque values once, and use that snapshot for proxy injection and redaction throughout the lease.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6iDJPk\",\n      \"path\": \"mcpfn/testing/src/remote-target.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-14T09:10:49Z\",\n        \"outdated\": false,\n        \"line\": 477,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4003708814\",\n        \"body\": \"**<sub><sub>![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)</sub></sub>  Keep credentials registered through failed-open reporting**\\n\\nWhen a provider supplies an invalid header whose `Headers` validation error contains the raw value (Node does this for multiline values), the target releases the lease before rethrowing, and this block removes the credential from the target redactor. `McpFnClient.openTargetAttempt()` subsequently emits the failed-open diagnostic with that error message, so a direct programmatic client without a `beginTargetCredentialRedaction()` report scope exposes the credential to diagnostic listeners. Fresh evidence beyond the existing live-artifact issue is this post-release failed-open path; retain the secret until the error is sanitized or its diagnosti\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6iDJPq\",\n      \"path\": \"mcpfn/testing/src/remote-target.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-14T09:10:49Z\",\n        \"outdated\": false,\n        \"line\": 385,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4003708821\",\n        \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Revoke the provider-owned credential object**\\n\\nWhen a provider associates lifecycle state with the object returned by `acquire()`—for example through a `WeakMap`, a class instance, or non-enumerable properties—this spread creates a different plain object and later passes that clone to `revoke()` and `dispose()`. Such a valid provider can no longer locate or release the acquired credential, leaving cleanup permanently failed. Fresh evidence beyond the prior mutable-header concern is that the new snapshot is also used as the lifecycle callback argument; keep `acquired` for provider callbacks and use a separate header snapshot for transport and redaction.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6iD65I\",\n      \"path\": \"mcpfn/testing/src/remote-target.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-14T09:52:31Z\",\n        \"outdated\": false,\n        \"line\": 39,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4004012216\",\n        \"body\": \"**<sub><sub>![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)</sub></sub>  Redact decoded Basic credentials**\\n\\nWhen a custom credential uses HTTP Basic authentication, this registers only the full header and its Base64 token. A server that decodes the header and reflects the username or password in an error, tool result, or diagnostic therefore exposes those credential components in reports and inspector artifacts. The new generic scheme extraction covers custom schemes but omits Basic's decoded components; decode valid Basic tokens and register both components as secrets.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6iD65P\",\n      \"path\": \"mcpfn/testing/src/conformance.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-14T09:52:32Z\",\n        \"outdated\": false,\n        \"line\": 424,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4004012227\",\n        \"body\": \"**<sub><sub>![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)</sub></sub>  Sanitize conformance setup failures before rethrowing**\\n\\nWhen a programmatic credential provider returns an invalid header value, such as one containing a newline, proxy setup throws a `Headers` validation error that includes the raw value; after cleanup, this line rethrows that error unchanged to the caller. This leaks the credential through ordinary error logging despite authenticated conformance's redaction contract. Redact setup/close failures while the immutable credential snapshot is still available before storing or rethrowing them.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6iD65W\",\n      \"path\": \"mcpfn/testing/src/suite.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-14T09:52:32Z\",\n        \"outdated\": false,\n        \"line\": 232,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4004012235\",\n        \"body\": \"**<sub><sub>![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)</sub></sub>  Scrub scenario errors before their size truncation**\\n\\nFor an authenticated target whose server reflects the credential near the `scenarioRun.maxErrorBytes` boundary, `runScenarios()` applies `truncateError()` before returning these results. That leaves only a credential prefix, so the final exact-value target scrub cannot recognize it and the JSON/JUnit report leaks the prefix. Fresh evidence after the target scrubber ordering fix is that scenario results arrive here already truncated; apply target-aware scrubbing before scenario error truncation.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6iG9eR\",\n      \"path\": \"mcpfn/cli/src/index.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-14T12:39:03Z\",\n        \"outdated\": false,\n        \"line\": 582,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4005212061\",\n        \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Reject forbidden API-key headers during CLI parsing**\\n\\nWhen `inspect` or `test-target` receives a syntactically valid but prohibited header such as `--api-key-header host` or `content-length`, this check accepts the configuration and defers rejection to target opening. `test-target` then emits a failed runtime report and exit 1 (and `inspect` likewise classifies the client failure as runtime), although the CLI documents malformed configuration as exit 2; validate the header against the credential-header policy here before constructing the target.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6iXUYB\",\n      \"path\": \"mcpfn/testing/src/host-authorization.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-15T03:47:11Z\",\n        \"outdated\": false,\n        \"line\": 261,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4011736872\",\n        \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Honor the configured authorization-code fixture**\\n\\nWhen a caller sets `fixture.token.code` to exercise an invalid, expired, or independently authored authorization code, the runner ignores it and always submits the code returned by the authorization redirect. Such a negative token-exchange fixture can therefore pass while never testing its configured input; use the token-request fixture's `code` when supplied, or remove the public field so it cannot silently misconfigure an experiment.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6ify-K\",\n      \"path\": \"mcpfn/inspector/tests/authenticated-artifacts.test.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"cubic-dev-ai\",\n        \"createdAt\": \"2026-09-15T11:33:34Z\",\n        \"outdated\": false,\n        \"line\": 246,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4015100997\",\n        \"body\": \"<!-- cubic:v=0645f387-8083-48da-aee7-d3979d8e8672 -->\\n<!-- cubic:review-run=ef4f688d-c951-5e37-a081-804532482b41 -->\\n<!-- metadata:{\\\"confidence\\\":6} -->\\nP2: The custom redactor in this test substitutes only substrings equal to \\\"opaque-property-key\\\" in the serialized JSON, so a stored value of \\\"value\\\" (which contains no secret) is left untouched. After exportScenario redacts the operation arguments and structuredContent, the result is { \\\"${MCPFN_SECRET}\\\": \\\"value\\\" }, not { \\\"${MCPFN_SECRET}\\\": \\\"${MCPFN_SECRET}\\\" }. The two toEqual assertions on the value therefore fail, so this test breaks the @mcpfn/inspector suite (or, if the suite is green, is not exercising the behavior it claims). The point of the test is key redaction, so assert the unchanged value.\\n\\n<details>\\n<summary>Prompt for AI agents\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6i7PnT\",\n      \"path\": \"mcpfn/testing/src/host-authorization.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-16T12:25:35Z\",\n        \"outdated\": false,\n        \"line\": 449,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4025972715\",\n        \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Require no-store headers on successful token responses**\\n\\nWhen a hosted authorization server returns a valid-looking 200 JSON token set but omits `Cache-Control: no-store` or `Pragma: no-cache`, this validator accepts both the exchange and refresh response. RFC 6749 §5.1 requires those headers for responses containing tokens, so the hosted regression can report an insecure, nonconforming provider as passed; validate both cache directives before accepting the token set.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6jtJst\",\n      \"path\": \"mcpfn/cli/src/index.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-18T10:25:30Z\",\n        \"outdated\": false,\n        \"line\": 521,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4045892488\",\n        \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Mark truncated conformance reports incomplete**\\n\\nWhen `--max-report-bytes` is smaller than an otherwise successful conformance result, this replaces the captured streams with `[TRUNCATED]` but leaves `ok: true` and `exitCode: 0`, and the CLI consequently exits successfully. The resulting machine artifact silently omits evidence without any truncation or incompleteness field; record the truncation in the report and make the artifact non-passing, as the other bounded report paths do.\\n\\nUseful? React with 👍 / 👎.\"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6jtKNB\",\n      \"path\": \"mcpfn/cli/src/bin.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"cubic-dev-ai\",\n        \"createdAt\": \"2026-09-18T10:25:59Z\",\n        \"outdated\": false,\n        \"line\": 31,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4045895485\",\n        \"body\": \"<!-- cubic:v=1751549d-12ec-4215-87aa-bdb7a88c835b -->\\n<!-- cubic:review-run=a8ca27b3-ecd1-5754-a86a-a9042c91c442 -->\\n<!-- metadata:{\\\"confidence\\\":9} -->\\nP2: When a target or conformance command emits a report and cleanup retry fails, `runCli` has already queued non-awaited stdout output. This forced exit can terminate before buffered report bytes reach CI or a pipe; flush stdout before exiting, or make CLI output writes awaitable.\\n\\n<details>\\n<summary>Prompt for AI agents</summary>\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At mcpfn/cli/src/bin.ts, line 26:\\n\\n<comment>When a target or conformance command emits a report and cleanup retry fails, `runCli` has already queued non-awaited stdout output. This forced exit can terminate before buffered report \"\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6jvE9Q\",\n      \"path\": \"mcpfn/testing/src/remote-target.ts\",\n      \"isResolved\": false,\n      \"currentCount\": 1,\n      \"latest\": {\n        \"author\": \"chatgpt-codex-connector\",\n        \"createdAt\": \"2026-09-18T12:19:10Z\",\n        \"outdated\": false,\n        \"line\": 532,\n        \"url\": \"https://github.com/21nCo/super-functions/pull/170#discussion_r4046644273\",\n        \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Report OAuth revocation failures in the correct phase**\\n\\nWhen transport shutdown succeeds but an OAuth credential provider's `revoke()` rejects, this hard-coded event reports `transport-close` even though the lease identifies the failure as `token-revocation`. Diagnostic consumers and suite timelines consequently attribute an authorization-server cleanup failure to transport/preflight