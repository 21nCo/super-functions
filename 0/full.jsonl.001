rn owner.pending;\n    92\t    const pending = Promise.resolve().then(owner.close).then(\n    93\t      () => { suiteCleanupOwners.delete(this); },\n    94\t      () => { throw this; },\n    95\t    ).finally(() => { owner.pending = undefined; });\n    96\t    owner.pending = pending;\n    97\t    return pending;\n    98\t  }\n    99\t}\n   100\t\n   101\t/** Runs local, stdio, HTTP, or custom targets through the production session engine. */\n   102\texport async function runMcpFnTargetSuite(\n   103\t  options: RunMcpFnTargetSuiteOptions,\n   104\t): Promise<McpFnTargetSuiteReport> {\n   105\t  const finishRedaction = beginTargetCredentialRedaction(options.target);\n   106\t  try { return await runTargetSuite(options); }\n   107\t  finally { finishRedaction(); }\n   108\t}\n   109\t\n   110\t/** Apply the target-owned scrubber before the bounded generic artifact pass. */\n   111\tfunction redactSuiteArtifact<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean } = {}): T {\n   112\t  const scrubbed = target.redact ? target.redact(value, options) : value;\n   113\t  return redactTargetCredentials(target, scrubbed, options);\n   114\t}\n   115\t\n   116\tasync function runTargetSuite(options: RunMcpFnTargetSuiteOptions): Promise<McpFnTargetSuiteReport> {\n   117\t  const timeline: McpFnDiagnosticEvent[] = [];\n   118\t  let droppedTimelineEvents = 0;\n   119\t  let timelineBytes = 0;\n   120\t  let timelineCountExceeded = false;\n   121\t  let timelineBytesExceeded = false;\n   122\t  let timelineSerializationFailed = false;\n   123\t  let timelineRedactionFailed = false;\n   124\t  let observedDiagnosticRedactionOmissions = 0;\n   125\t  let initialDiagnosticRedactionOmissions = 0;\n   126\t  const timelineSizes: number[] = [];\n   127\t  const maxTimelineEvents = options.maxTimelineEvents ?? 500;\n   128\t  if (!Number.isInteger(maxTimelineEvents) || maxTimelineEvents < 1) {\n   129\t    throw new Error(\"maxTimelineEvents must be a positive integer