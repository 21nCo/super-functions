ha256(b).hexdigest()\nassert git('rev-parse','HEAD').decode().strip()==c['head']\nassert not git('status','--porcelain').strip()\ndef tree(ref):\n out={}\n for line in git('ls-tree','-rz','--full-tree',ref).split(b'\\0'):\n  if line:\n   meta,name=line.split(b'\\t',1);mode,kind,oid=meta.decode().split();assert kind=='blob';out[name.decode()]={'mode':mode,'oid':oid}\n return out\ndef value(f):return os.readlink(f).encode() if f.is_symlink() else f.read_bytes() if f.is_file() else None\ndef mode(f):return '120000' if f.is_symlink() else '100755' if f.stat().st_mode&0o111 else '100644'\nbase=tree(c['base']);expected={**c['entries'],**am['entries']}\ncanonical=set(base)|set(tree(c['head']))|set(tree(p['relatedPublication']))|set(expected)|set(json.loads((A.parent/'PR-212/producer-final-current-source-hashes-and-modes.json').read_text()))\noids=sorted({r['oid'] for r in base.values()});raw=subprocess.check_output(['git','-C',T,'cat-file','--batch'],input=('\\n'.join(oids)+'\\n').encode());blobs={};offset=0\nfor oid in oids:\n end=raw.index(b'\\n',offset);header=raw[offset:end].decode().split();assert header[0]==oid and header[1]=='blob';length=int(header[2]);offset=end+1;blobs[oid]=raw[offset:offset+length];offset+=length;assert raw[offset:offset+1]==b'\\n';offset+=1\nassert offset==len(raw);outside=0\nfor name in sorted(canonical):\n f=V/name;b=value(f)\n if name in expected:\n  r=expected[name];assert (sha(b) if b is not None else None)==r['sha256'],name\n  if b is not None:assert mode(f)==r['gitMode'],name\n else:\n  r=base.get(name);assert b==(blobs[r['oid']] if r else None),name\n  if r:assert mode(f)==r['mode'],name\n  outside+=1\nassert len(canonical)==8359 and outside==8154 and len(expected)==205\nlock=json.loads((V/'package-lock.json').read_text());baseLock=json.loads(blobs[base['package-lock.json']['oid']]);maps=json.loads((A/'planned-focused-lock-maps.json').read_text())\ndiff={name for name in set(lock['packages'])|set(baseLock['packages']) if lock['packages'].get(name)!=baseLock['packages'].get(name)}\nassert diff==set(maps),(len(diff),len(maps))\nfor name,row in maps.items():assert lock['packages'].get(name)==row['proposed'] and baseLock['packages'].get(name)==row['base'],name\nassert {k:v for k,v in lock.items() if k!='packages'}=={k:v for k,v in baseLock.items() if k!='packages'}\nassert sha((V/'package-lock.json').read_bytes())==c['locks']['root']\nfor product,slot in sa['slots'].items():\n owner=pathlib.Path(slot);assert sha((owner/'package-lock.json').read_bytes())==c['locks']['standalone'][product]\n for n in ['llms.txt','llms-full.txt']:\n  f=V/product/'docs/static'/n;other=owner/'static'/n;assert value(f)==value(other) and mode(f)==mode(other)\n for name in ['__native213_flat.md','__native213_flat/child.md','__native213_sibling.md','__native213_index/index.md','__native213_index/主.md','__native213_private.md']:\n  assert not (owner/'content/docs'/name).exists() and not (V/product/'docs/content/docs'/name).exists(),name\ninputs=json.loads((A/'controlled213-blog-inputs.json').read_text())\nfor root in [V,pathlib.Path(sa['physicalRoot'])]:\n for name in inputs:assert not (root/name).exists(),name\nhistory=json.loads((A/'retained212-history-index.json').read_text());assert sha((A/'retained212-source-own-locks-installed-history.tar.gz').read_bytes())==history['archiveSha256']\nout={'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'canonicalMembership':len(canonical),'explicitPaths':len(expected),'outsidePlanBytesModesExactReviewed42a':outside,'rootFocusedLockMapsExact':len(diff),'nonPackageLockMetadataUnchanged':True,'rootAndThreeOwnLockHashesUnchanged':True,'sixLlmRootStandaloneBytesModesEqual':True,'controlledBlogExactInputMembershipAbsent':True,'providerNamesChecked':True,'preservationArchiveHashVerified':True,'frozenWorktreeClean':True,'publicationGateOpen':False,'qualification':'Read-only canonical/lock/known-input preservation, not complete semantic review or publication. Exact canonical membership retains historical fixtures and legitimate __tests__/__init__.py, no broad exclusion.'}\noutput=A/'final-current-preservation-after-guide-readonly.json';assert not output.exists();output.write_text(json.dumps(out,indent=2)+'\\n');print(json.dumps(out,indent=2))\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":6025,"output":1957,"cacheRead":128384,"cacheWrite":0,"reasoning":516,"totalTokens":136366,"cost":{"input":0.01205,"output":0.01957,"cacheRead":0.012838400000000002,"cacheWrite":0,"total":0.0444584}},"stopReason":"toolUse","timestamp":1791368621569,"responseId":"resp_055fb762f51dfcfc016ac61dae428887d0890c137ec69571a7","rawStopReason":"completed","thinkingLevel":"high"}}
