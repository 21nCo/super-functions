260930';git=lambda *a:subprocess.check_output(['git','-C',T,*a]);sha=lambda b:hashlib.sha256(b).hexdigest();p=json.loads((A/'reviewed-candidate-plan.json').read_text());V=pathlib.Path(p['candidate']);e={**p['entries'],**json.loads((A/'composition-assessment-supplement.json').read_text())['entries'],**json.loads((A/'final-guide-platform-supplement.json').read_text())['entries']}\nassert not (A/'ssd-routed-normal-install-admission.json').exists();assert (A/'candidate-source-application-receipt.json').exists();round=json.loads((R/'parent-ledger.json').read_text())['prs']['213']['current_sequential_round'];assert round['collection_count']==1 and round['publication_count']==0 and not round['completed'];assert git('rev-parse','HEAD').decode().strip()==p['head'] and not git('status','--porcelain').strip()\nfor path,r in e.items():\n f=V/path;assert not f.is_symlink();b=f.read_bytes() if f.is_file() else None;assert (sha(b) if b is not None else None)==r['afterSha256'],path\nbase={}\nfor row in git('ls-tree','-rz','--full-tree',p['base']).split(b'\\0'):\n if row:\n  meta,path=row.split(b'\\t',1);mode,kind,oid=meta.decode().split();base[path.decode()]={'mode':mode,'oid':oid}\nprior=json.loads((A.parent/'PR-212/producer-final-current-source-hashes-and-modes.json').read_text());outside=0\nfor path in (set(base)|set(prior))-set(e):\n f=V/path;r=base.get(path)\n if r is None:assert not f.is_file() and not f.is_symlink(),path;continue\n b=os.readlink(f).encode() if f.is_symlink() else f.read_bytes();mode='120000' if f.is_symlink() else '100755' if f.stat().st_mode&0o111 else '100644';assert hashlib.sha1(b'blob '+str(len(b)).encode()+b'\\0'+b).hexdigest()==r['oid'] and mode==r['mode'],path;outside+=1\nhistory=json.loads((A/'retained212-history-index.json').read_text());assert sha((A/'retained212-source-own-locks-installed-history.tar.gz').read_bytes())==history['archiveSha256'];old=json.loads((A.parent/'PR-212/ssd-routed-normal-install-admission.json').read_text());assert old['candidate']==str(V)\nd=plistlib.loads(subprocess.check_output(['diskutil','info','-plist','/Volumes/OS - Data']));assert d['VolumeUUID']=='B86D5097-6E24-3D1D-A590-8CF9D44B6245' and d['Writable'];paths=old['paths']\nfor path in paths.values():\n f=pathlib.Path(path);assert not f.is_symlink() and f.resolve().is_relative_to(pathlib.Path('/Volumes/OS - Data')) and f.stat().st_dev==V.stat().st_dev and os.access(f,os.W_OK)\nprobe=pathlib.Path(paths['tmp'])/'pr213-normal-install-writable';assert not probe.exists();probe.write_text('owned preflight\\n');probe.unlink();free=shutil.disk_usage(V).free/2**30;assert free>=15\nnode=subprocess.check_output(['node','--version']).decode().strip();npm=subprocess.check_output(['npm','--version']).decode().strip();assert node.startswith('v22.') and npm.startswith('10.')\nout={'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'candidate':str(V),'head':p['head'],'base':p['base'],'volumeUUID':d['VolumeUUID'],'paths':paths,'ssdAvailableGiB':free,'outsidePlanExactBasePaths':outside,'combined205AfterimagesExact':True,'retained212ArchiveVerified':True,'lockSha256Before':sha((V/'package-lock.json').read_bytes()),'installAllowed':True,'normalCommand':['npm','ci','--no-audit','--no-fund'],'scriptsEnabled':True,'node':node,'npm':npm,'noNewRootOrConsumer':True,'standaloneConversionAdmitted':False,'publicationGateClosed':True};(A/'ssd-routed-normal-install-admission.json').write_text(json.dumps(out,indent=2)+'\\n');print(json.dumps(out,indent=2))\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":3263,"output":1404,"cacheRead":194432,"cacheWrite":0,"reasoning":263,"totalTokens":199099,"cost":{"input":0.006526,"output":0.01404,"cacheRead":0.0194432,"cacheWrite":0,"total":0.0400092}},"stopReason":"toolUse","timestamp":1791350374814,"responseId":"resp_055fb762f51dfcfc016ac5d667994087d09569c19bfcb9e43e","rawStopReason":"completed","thinkingLevel":"high"}}
