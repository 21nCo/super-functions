iteral;\n   206\t  });\n   207\t  const secretPattern = patterns.length ? new RegExp(patterns.join(\"|\"), \"g\") : undefined;\n   208\t  const replacementPattern = patterns.length ? new RegExp(patterns.join(\"|\")) : undefined;\n   209\t  const preserveStructural = (input: string): string => {\n   210\t    if (replacementPattern?.test(input)) {\n   211\t      throw new McpFnRedactionLimitError(\n   212\t        \"Credential collides with a required structural artifact field\",\n   213\t      );\n   214\t    }\n   215\t    return input;\n   216\t  };\n   217\t  const preserveStructuralKey = (input: string): string => {\n   218\t    if (replacementPattern?.test(input)) {\n   219\t      throw new McpFnStructuralCredentialCollisionError();\n   220\t    }\n   221\t    return input;\n   222\t  };\n   223\t  // A requested marker is itself output and must not reproduce a credential.\n   224\t  if (secretPattern) {\n   225\t    const markerContainsSecret = secretPattern.test(redactionMarker ?? \"[REDACTED]\");\n   226\t    secretPattern.lastIndex = 0;\n   227\t    if (markerContainsSecret) redactionMarker = \"\";\n   228\t  }\n   229\t  const scrubString = (input: string, role: string, field: string, finalPass: boolean): string => {\n   230\t    const structuralField = `${role}:${field}`;\n   231\t    if (unrestrictedStructuralValueFields.has(structuralField) ||\n   232\t        structuralArtifactValues.get(structuralField)?.has(input)) {\n   233\t      return preserveStructural(input);\n   234\t    }\n   235\t    // Whole-string rejection cannot compose another credential by joining pieces.\n   236\t    // Run after both redactors; never feed this result through another redactor.\n   237\t    if (finalPass) return replacementPattern?.test(input) ? \"\" : input;\n   238\t    if (!secretPattern) return input;\n   239\t    return input.replace(secretPattern, secret => {\n   240\t      const maskCharacter = secret.includes(\"*\") ? \"#\" : \"*\";\n   241\t      const defaultReplacement = secret.length < 10\n   242\t        ? maskCharacter.repeat(secret.length)\n   243\t        : \"[REDACTED]\";\n   244\t      const replacement = redactionMarker ?? defaultReplacement;\n   245\t      // Every generated mask must be safe against the entire credential set.\n   246\t      return replacementPattern!.test(replacement) ? \"\" : replacement;\n   247\t    });\n   248\t  };\n   249\t  const scrub = (input: unknown, role = \"payload\", field = \"\", finalPass = false): unknown => {\n   250\t    input = specialValue(input);\n   251\t    if (typeof input === \"string\") return scrubString(input, role, field, finalPass);\n   252\t    if (Array.isArray(input)) {\n   253\t      const result = input.map(entry => scrub(entry, role, \"\", finalPass));\n   254\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   255\t      return result;\n   256\t    }\n   257\t    if (input && typeof input === \"object\") {\n   258\t      const entries: Array<[string, unknown]> = [];\n   259\t      const keys = new Set<string>();\n   260\t      for (const [key, entry] of Object.entries(input)) {\n   261\t        const fixed = envelopeKeys[role]?.has(key) ?? false;\n   262\t        if (fixed) preserveStructuralKey(key);\n   263\t        let childRole = \"payload\";\n   264\t        if (fixed) {\n   265\t          if (key === \"results\") childRole = \"result\";\n   266\t          else if (key === \"timeline\") childRole = (value as any)?.kind === \"mcpfn.inspector-snapshot\" ? \"inspectorEvent\" : \"diagnostic\";\n   267\t          else if ([\"failure\", \"runtime\", \"packages\", \"droppedInventoryEntries\", \"target\"].includes(key)) childRole = key;\n   268\t          else if (role === \"inspectorEvent\" && key === \"event\") childRole = (input as { source?: string }).source === \"client\" ? \"root\" : \"diagnostic\";\n   269\t        }\n   270\t        const scrubbedKey = fixed ? key : scrub(key, \"payload\", \"\", finalPass) as string;\n   271\t        if (keys.has(scrubbedKey)) {\n   272\t          throw new McpFnRedactionLimitError(\n   273\t            \"Credential redaction created duplicate object keys\",\n   274\t          );\n   275\t        }\n   276\t        keys.add(scrubbedKey);\n   277\t        const scrubbedEntry = typeof entry === \"string\"\n   278\t          ? scrub(entry, fixed ? role : \"payload\", key, finalPass)\n   279\t          : scrub(entry, childRole, \"\", finalPass);\n   280\t        entries.push([scrubbedKey, scrubbedEntry]);\n   281\t      }\n   282\t      const result = Object.fromEntries(entries);\n   283\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   284\t      return result;\n   285\t    }\n   286\t    return input;\n   287\t  };\n   288\t  const timelineEvent = value && typeof value === \"object\" && [\"client\", \"diagnostic\"].includes((value as { source?: string }).source ?? \"\");\n   289\t  let role = \"payload\";\n   290\t  if (preserveKeys) role = timelineEvent ? \"inspectorEvent\" : \"root\";\n   291\t  const scrubbed = scrub(value, role);\n   292\t  const generic = redactOAuthValue(scrubbed, { maxStringLength: 262_144, maxDepth: 64, maxArrayEntries: 100_000, maxObjectEntries: 100_000, ...(redactionMarker !== undefined ? { redactionMarker } : {}) });\n   293\t  const result = scrub(generic, role, \"\", true) as T;\n   294\t  assertPayloadSerialization(\n   295\t    result,\n   296\t    \"payload\",\n   297\t    true,\n   298\t    replacementPattern,\n   299\t  );\n   300\t  return result;\n   301\t}\n   302\t\n   303\tfunction assertPayloadSerialization(\n   304\t  value: unknown,\n   305\t  role: string,\n   306\t  finalPass: boolean,\n   307\t  credentialPattern: RegExp | undefined,\n   308\t): void {\n   309\t  if (!finalPass || role !== \"payload\" || !credentialPattern) return;\n   310\t  const serialized = JSON.stringify(value);\n   311\t  if (serialized !== undefined && credentialPattern.test(serialized)) {\n   312\t    throw new McpFnRedactionLimitError(\n   313\t      \"Credential redaction could not guarantee safe serialized output\",\n   314\t    );\n   315\t  }\n   316\t}\n   317\t\n   318\t/** Remove known opaque credential values as well as credential-shaped fields. */\n   319\texport function redactTargetCredentials<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean; redactionMarker?: string } = {}): T {\n   320\t  const state = targetSecrets.get(target);\n   321\t  return scrubCredentials(value, new Set([...(state?.active.keys() ?? []), ...[...(state?.scopes ?? [])].flatMap((scope) => [...scope])]), options.preserveKeys, options.redactionMarker);\n   322\t}\n   323\t\n   324\t/** Redact authenticated conformance output using the acquired credential. */\n   325\texport function redactRemoteCredential<T>(credential: McpFnRemoteCredential, value: T, options: { preserveKeys?: boolean } = {}): T {\n   326\t  return scrubCredentials(value, credentialValues(credential.headers), options.preserveKeys);\n   327\t}\n   328\t\n   329\tconst MAX_CREDENTIAL_HEADERS = 32;\n   330\tconst MAX_CREDENTIAL_HEADER_BYTES = 16_384;\n     1\timport type { McpFnDiagnosticPhase } from \"@mcpfn/client\";\n     2\timport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n     3\t\n     4\timport type { McpFnTargetSuiteReport } from \"./suite.js\";\n     5\t\n     6\tdeclare const __MCPFN_TESTING_VERSION__: string;\n     7\t\n     8\texport const MCPFN_TESTING_VERSION = __MCPFN_TESTING_VERSION__;\n     9\texport const MCPFN_REPORT_SCHEMA_VERSION = \"1.0.0\";\n    10\t\n    11\texport type McpFnFailureLayer =\n    12\t  | \"mcpfn-preflight\"\n    13\t  | \"authorization-server\"\n    14\t  | \"resource-server\"\n    15\t  | \"mcp-initialization\"\n    16\t  | \"scenario\"\n    17\t  | \"upstream-conformance\";\n    18\t\n    19\texport interface McpFnReportFailure {\n    20\t  name: string;\n    21\t  message: string;\n    22\t  layer: McpFnFailureLayer;\n    23\t  code?: string;\n    24\t  phase?: string;\n    25\t  details?: Record<string, unknown>;\n    26\t}\n    27\t\n    28\texport interface McpFnJunitOptions {\n    29\t  /** Aggregate XML size cap after serialization. Defaults to 1 MiB. */\n    30\t  maxBytes?: number;\n    31\t}\n    32\t\n    33\texport function normalizeMcpFnReportFailure(\n    34\t  error: unknown,\n    35\t  fallbackPhase?: McpFnDiagnosticPhase | \"scenario\" | \"upstream-conformance\",\n    36\t): McpFnReportFailure {\n    37\t  const redacted = redactOAuthValue(error, {\n    38\t    maxDepth: 6,\n    39\t    maxArrayEntries: 50,\n    40\t    maxObjectEntries: 50,\n    41\t    maxStringLength: 2_048,\n    42\t  });\n    43\t  const record = redacted && typeof redacted === \"object\" && !Array.isArray(redacted)\n    44\t    ? redacted as Record<string, unknown>\n    45\t    : {};\n    46\t  const phase = stringField(record.phase) ?? fallbackPhase;\n    47\t  const details = record.details && typeof record.details === \"object\" &&\n    48\t      !Array.isArray(record.details)\n    49\t    ? record.details as Record<string, unknown>\n    50\t    : undefined;\n    51\t  let message = stringField(record.message) ?? String(\n    52\t    redactOAuthValue(error instanceof Error ? error.message : String(error)),\n    53\t  );\n    54\t  const cause = error && typeof error === \"object\"\n    55\t    ? (error as { cause?: unknown }).cause\n    56\t    : undefined;\n    57\t  const redactedCause = cause === undefined\n    58\t    ? undefined\n    59\t    : redactOAuthValue(cause, {\n    60\t      maxDepth: 4,\n    61\t      maxArrayEntries: 20,\n    62\t      maxObjectEntries: 20,\n    63\t      maxStringLength: 1_024,\n    64\t    });\n    65\t  const causeRecord = redactedCause && typeof redactedCause === \"object\" &&\n    66\t      !Array.isArray(redactedCause)\n    67\t    ? redactedCause as Record<string, unknown>\n    68\t    : undefined;\n    69\t  const causeMessage = stringField(causeRecord?.message);\n    70\t  if (causeMessage && !message.includes(causeMessage)) message = `${message}: ${causeMessage}`;\n    71\t  const combinedDetails = causeRecord ? { ...details, cause: causeRecord } : details;\n    72\t  const layer = failureLayer(phase);\n    73\t  const deniedByResource = layer !== \"authorization-server\" &&\n    74\t    [causeRecord?.code, causeRecord?.status, record.code, record.status]\n    75\t      .some(value => [401, 403].includes(Number(value)));\n    76\t  return {\n    77\t    name: stringField(record.name) ?? \"Error\",\n    78\t    message,\n    79\t    layer: deniedByResource ? \"resource-server\" : layer,\n    80\t    ...(stringField(record.code) ? { code: stringField(record.code)! } : {}),\n    81\t    ...(phase ? { phase } : {}),\n    82\t    ...(combinedDetails ? { details: combinedDetails } : {}),\n    83\t  };\n    84\t}\n    85\t\n    86\t/** Serialize a redacted target-suite report as bounded JUnit XML. */\n    87\texport function createMcpFnTargetSuiteJUnit(\n    88\t  report: McpFnTargetSuiteReport,\n    89\t  options: McpFnJunitOptions = {},\n    90\t): string {\n    60\t}\n    61\t\n    62\tconst inspectorCleanupOwners = new WeakMap<\n    63\t  McpFnInspectorCleanupError,\n    64\t  { close: () => Promise<void>; pending?: Promise<void> }\n    65\t>();\n    66\t\n    67\t/** Inspector cleanup failed. Retain this error until its transport closes. */\n    68\texport class McpFnInspectorCleanupError extends Error {\n    69\t  constructor(close: () => Promise<void>, cause: unknown) {\n    70\t    super(\n    71\t      \"Inspector cleanup failed; retain this error and retryCleanup()\",\n    72\t      { cause },\n    73\t    );\n    74\t    this.name = \"McpFnInspectorCleanupError\";\n    75\t    inspectorCleanupOwners.set(this, { close });\n    76\t  }\n    77\t\n    78\t  retryCleanup(): Promise<void> {\n    79\t    const owner = inspectorCleanupOwners.get(this);\n    80\t    if (!owner) return Promise.resolve();\n    81\t    if (owner.pending) return owner.pending;\n    82\t    const pending = Promise.resolve().then(owner.close).then(\n    83\t      () => { inspectorCleanupOwners.delete(this); },\n    84\t      () => { throw this; },\n    85\t    ).finally(() => { owner.pending = undefined; });\n    86\t    owner.pending = pending;\n    87\t    return pending;\n    88\t  }\n    89\t}\n    90\t\n    91\ttype CliCleanupError =\n    92\t  | McpFnTestClientCleanupError\n    93\t  | McpFnTargetSuiteArtifactCleanupError\n    94\t  | McpFnTargetSuiteCleanupError\n    95\t  | McpFnConformanceCleanupError\n    96\t  | McpFnInspectorCleanupError;\n    97\t\n    98\tfunction isCliCleanupError(error: unknown): error is CliCleanupError {\n    99\t  return error instanceof McpFnTestClientCleanupError ||\n   100\t    error instanceof McpFnTargetSuiteArtifactCleanupError ||\n    45\t/** Test-client cleanup failed and remains owned by this retryable error. */\n    46\texport class McpFnTestClientCleanupError extends Error {\n    47\t  constructor(close: () => Promise<void>, cause: unknown) {\n    48\t    super(\n    49\t      \"Test client cleanup remains pending; retain this error and retryCleanup()\",\n    50\t      { cause },\n    51\t    );\n    52\t    this.name = \"McpFnTestClientCleanupError\";\n    53\t    testClientCleanupOwners.set(this, { close });\n    54\t  }\n    55\t\n    56\t  retryCleanup(): Promise<void> {\n    57\t    const owner = testClientCleanupOwners.get(this);\n    58\t    if (!owner) return Promise.resolve();\n    59\t    if (owner.pending) return owner.pending;\n    60\t    const pending = Promise.resolve().then(owner.close).then(\n    61\t      () => { testClientCleanupOwners.delete(this); },\n    62\t      () => { throw this; },\n    63\t    ).finally(() => { owner.pending = undefined; });\n    64\t    owner.pending = pending;\n    65\t    return pending;\n    66\t  }\n    67\t}\n    68\t\n    69\texport class McpFnTestClient<TContext = undefined> {\n    70\t  readonly session: McpFnCl