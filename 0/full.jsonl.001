{"type":"message","id":"0adcbed1","parentId":"1071df19","timestamp":"2026-10-05T18:31:31.203Z","message":{"role":"toolResult","toolCallId":"call_1xXZ8o8oi14ks7GNoMSh5FI3|fc_055fb762f51dfcfc016ac3ed022f1887d099e304d2b259d2be","toolName":"read","content":[{"type":"text","text":"import assert from 'node:assert/strict';\nimport {spawn} from 'node:child_process';\nimport fs from 'node:fs';\nimport path from 'node:path';\nconst root=path.resolve(process.argv[2]);const prefix=process.argv[3];\nconst results=[];\nfor(const [i,product] of ['clifn','authfn','filefn'].entries()){\n const directory=path.join(root,product,'docs'),port=6930+i;\n const log=fs.openSync(`${prefix}-${product}.log`,'w');\n const child=spawn('npm',['exec','--','vite','dev','--host','127.0.0.1','--port',String(port),'--strictPort'],{cwd:directory,detached:true,stdio:['ignore',log,log]});\n try{\n  let ready=false;\n  for(let n=0;n<100;n++){\n   if(child.exitCode!==null)throw Error(`dev exited ${child.exitCode}`);\n   try{await fetch(`http://127.0.0.1:${port}/`,{signal:AbortSignal.timeout(1000)});ready=true;break;}catch{}\n   await new Promise(r=>setTimeout(r,100));\n  }\n  assert(ready);\n  const response=await fetch(`http://127.0.0.1:${port}/docs/search.json`);\n  const body=await response.text();\n  const missing=await fetch(`http://127.0.0.1:${port}/docs/__pr210_missing__`);\n  results.push({product,status:response.status,missingStatus:missing.status,body:body.slice(0,160)});\n }finally{\n  try{process.kill(-child.pid,'SIGTERM');}catch(e){if(e.code!=='ESRCH')throw e;}\n  await new Promise(r=>child.exitCode!==null?r():child.once('exit',r));fs.closeSync(log);\n }\n}\nconsole.log(JSON.stringify(results,null,2));\nfor(const r of results){\n assert.equal(r.status,200,`${r.product} actual standalone Vite dev search HTTP`);\n assert.equal(r.missingStatus,404,`${r.product} actual standalone Vite dev framework error identity`);\n}\n"}],"isError":false,"timestamp":1791225091203}}
