{"type":"message","id":"3649d996","parentId":"2fbb87fe","timestamp":"2026-10-07T09:49:54.199Z","message":{"role":"toolResult","toolCallId":"call_VpO3S8bEbjyrDDs1maT79hux|fc_055fb762f51dfcfc016ac615c1bdec87d0800fd2dec24b678a","toolName":"read","content":[{"type":"text","text":"import pathlib,json,subprocess,hashlib,tarfile\nA=pathlib.Path(__file__).parent;inputs=json.loads((A/'controlled-current-input-contents.json').read_text());results=[]\n# Preserve reviewed CF emitted worker/config artifacts before ordinary local builds.\nV=A/'verification-latest-base-root';archive=A/'current-complete-owner-cf-emitted-workers.tar.gz'\nassert not archive.exists()\nwith tarfile.open(archive,'w:gz') as tar:\n for product in ['botfn','authfn','filefn']:\n  for sub in ['.svelte-kit/cloudflare','.cloudflare-docs-wrangler.jsonc']:\n   p=V/product/'docs'/sub\n   assert p.exists(),p;tar.add(p,arcname=product+'/docs/'+sub)\nfor name in ['verification-latest-base-root','standalone-current-npm11']:\n tree=A/name\n assert all(not (tree/f).exists() for f in inputs)\n try:\n  for f,body in inputs.items():p=tree/f;p.parent.mkdir(parents=True,exist_ok=True);p.write_text(body)\n  for product in ['authfn','filefn']:\n   cmd=['npm','run','build'];log=A/('controlled-latest-'+name+'-'+product+'-build.log')\n   with log.open('w') as out:r=subprocess.run(cmd,cwd=tree/product/'docs',stdout=out,stderr=subprocess.STDOUT)\n   assert r.returncode==0,log\n  script=A.parent/'PR-207/verify-native-blog-contract.mjs';log=A/('controlled-latest-'+name+'-native-blog-contract.log')\n  with log.open('w') as out:r=subprocess.run(['node',str(script),str(tree)],stdout=out,stderr=subprocess.STDOUT)\n  assert r.returncode==0,log\n  log=A/('controlled-latest-'+name+'-native-lean-page-data.log')\n  with log.open('w') as out:r=subprocess.run(['node',str(A/'verify-lean-page-data.mjs'),str(tree)],stdout=out,stderr=subprocess.STDOUT)\n  assert r.returncode==0,log\n  results.append({'tree':name,'nativeBlogSearchRssAliasesUnicodeDraftExclusionAndDecodedProjection':True})\n finally:\n  for f,body in inputs.items():\n   p=tree/f\n   if p.exists():assert p.read_text()==body;p.unlink()\n  assert all(not (tree/f).exists() for f in inputs)\n  results.append({'tree':name,'ownedTenInputsRestoredOriginalAbsence':True})\n(A/'controlled-latest-blog-restoration.json').write_text(json.dumps({'results':results,'cfArchive':str(archive),'privateInputsNotPublishable':True,'executionCheckoutNotMutated':True},indent=2)+'\\n')\nprint('Both current owner contexts pass native controlled Blog/search/RSS/Unicode/aliases/draft exclusion/thin decoding; inputs absent again.')\n"}],"isError":false,"timestamp":1791366594199}}
{"type":"message","id":"2c310416","parentId":"3649d996","timestamp":"2026-10-07T09:49:54.199Z","message":{"role":"toolResult","toolCallId":"call_tu7xBO4Jy1LnOHv0dK4e9yxY|fc_055fb762f51dfcfc016ac615c1bdf487d0bebca301ad8a3f72","toolName":"read","content":[{"type":"text","text":"import assert from 'node:assert/strict';\nimport path from 'node:path';\nimport {pathToFileURL} from 'node:url';\nimport {createRequire} from 'node:module';\nconst tree=path.resolve(process.argv[2]);\nfor(const product of ['authfn','filefn']) {\n const owner=path.join(tree,product,'docs');const require=createRequire(path.join(owner,'package.json'));const {unflatten}=require('devalue');const {createDocsSearchRuntime}=require('@docsfn/core');\n const {Server}=await import(pathToFileURL(path.join(owner,'.svelte-kit/output/server/index.js')));const {manifest}=await import(pathToFileURL(path.join(owner,'.svelte-kit/output/server/manifest.js')));const server=new Server(manifest);await server.init({env:{}});\n const origin='https://'+product+'.com';\n const get=async(route,status=200)=>{const r=await server.respond(new Request(origin+route),{getClientAddress:()=> '127.0.0.1'});assert.equal(r.status,status,route);return r;};\n const index=await (await get('/docs/blog')).text();assert(index.includes('href=\"/docs/blog/native-proof-post\"'));assert(index.includes('href=\"/docs/blog/native-proof/child\"'));assert(!index.includes('href=\"/blog/'));\n await get('/docs/blog/native-proof-post');await get('/docs/blog/native-proof/child');await get('/docs/blog/missing',404);await get('/docs/blog/draft-proof',404);await get('/docs/blog/draft-proof.md',404);await get('/docs/blog/missing.md',404);\n const rss=await (await get('/docs/blog/rss.xml')).text();assert(rss.includes(origin+'/docs/blog/native-proof/child'));assert(!rss.includes(origin+'/blog/'));assert(!rss.includes('PRIVATE Draft'));\n const artifact=await (await get('/docs/search.json')).json();const posts=artifact.documents.filter(d=>d.kind==='post');assert.equal(posts.length,4);for(const p of posts) {const html=await (await get(p.path)).text();if(p.title==='Native Colon Index Proof') {assert(html.includes('href=\"/docs/blog/native-proof-post.md\"'),'actual first-colon index source identity/SDK sibling link');const alias=await get('/docs/blog/native-proof-post.md',308);assert.equal(alias.headers.get('location'),'/docs/blog/native-proof-post');await get(alias.headers.get('location'));}}assert(posts.every(d=>d.path.startsWith('/docs/blog/')));assert(!JSON.stringify(artifact.snapshot).includes('\"path\":\"/blog/'));assert(!JSON.stringify(artifact).includes('PRIVATE Draft'));\n const runtime=createDocsSearchRuntime({artifact});const hits=await runtime.query({query:'Native Provider Proof',scope:'blog'});assert(hits.some(h=>h.path==='/docs/blog/native-proof-post'));assert(hits.every(h=>h.path.startsWith('/docs/blog/')));\n const payloads=[];for(const route of ['/docs/blog',...posts.map(p=>p.path)]) {const data=await (await get(route+'/__data.json')).json();const nodes=data.nodes.filter(n=>n?.type==='data').map(n=>unflatten(n.data));const parent=nodes.find(n=>n.source);assert.deepEqual(Object.keys(parent.source).sort(),['config','siteTitle']);assert.deepEqual(Object.keys(parent.source.config).sort(),['navigation','site']);for(const node of nodes){assert(!('manifest'in node));assert(!('searchArtifact'in node));if(node.posts)for(const p of node.posts){assert(!('body'in p));assert(!('frontmatter'in p));}if(node.post){assert(!('body'in node.post));assert(!('frontmatter'in node.post));assert(node.post.path.startsWith('/docs/blog/'));const sourceAlias='/docs/blog/'+node.post.id.slice(node.post.id.indexOf(':')+1);const redirected=await get(sourceAlias,308);const location=new URL(node.post.path,origin).pathname;assert.equal(redirected.headers.get('location'),location);await get(location);}}payloads.push({route,bytes:JSON.stringify(data).length});}\n console.log(JSON.stringify({product,realPostPaths:posts.map(p=>p.path),actualSearchHits:hits.map(h=>h.path),payloads,scope:'real native HTTP/SDK snapshot/runtime/lean payload; controlled provider Markdown; no live edge'}));\n}\n"}],"isError":false,"timestamp":1791366594199}}
