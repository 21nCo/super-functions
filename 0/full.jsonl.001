t":140}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":850,"output":721,"cacheRead":181632,"cacheWrite":0,"reasoning":516,"totalTokens":183203,"cost":{"input":0.0017,"output":0.00721,"cacheRead":0.0181632,"cacheWrite":0,"total":0.0270732}},"stopReason":"toolUse","timestamp":1791367085177,"responseId":"resp_055fb762f51dfcfc016ac617adf92087d09b43b1337387ecea","rawStopReason":"completed","thinkingLevel":"high"}}
{"type":"message","id":"5431f4ae","parentId":"01b6cb16","timestamp":"2026-10-07T09:58:42.232Z","message":{"role":"toolResult","toolCallId":"call_QZ77Ge2jMIrDAgGyVcXPV29w|fc_055fb762f51dfcfc016ac617d1e28487d094f8e1561a658571","toolName":"read","content":[{"type":"text","text":"   ssr: {\n-    // Force @docsfn/core through Vite's transform pipeline so the\n-    // `@searchfn/client` alias below resolves the workspace source in dev.\n-    // Without this, the dynamic `import(\"@searchfn/client\")` inside\n-    // @docsfn/core is externalized and resolved by Node, which fails because\n-    // @searchfn/client is not installed as a dependency and its dist is not\n-    // built in the monorepo.\n+    // Declared consumer peers resolve public exports; Turbo prepares workspace dist.\n     noExternal: [\"@docsfn/core\", \"@docsfn/svelte\"],\n   },\n   resolve: {\n     alias: [\n       // Resolve shared source against this site's pinned DocsFn installation.\n-      { find: /^@searchfn\\/client$/, replacement: path.resolve(dirname, \"../../searchfn/client/src/index.ts\") },\n-      { find: /^@searchfn\\/core$/, replacement: path.resolve(dirname, \"../../searchfn/core/src/index.ts\") },\n-      { find: /^@searchfn\\/adapter-contracts$/, replacement: path.resolve(dirname, \"../../searchfn/adapter-contracts/src/index.ts\") },\n-      { find: /^@searchfn\\/adapter-memory$/, replacement: path.resolve(dirname, \"../../searchfn/adapter-memory/src/index.ts\") },\n-      { find: /^@searchfn\\/adapter-indexeddb$/, replacement: path.resolve(dirname, \"../../searchfn/adapter-indexeddb/src/index.ts\") },\n     ],\n   },\n });\n--- exact-provenance/filefn/docs/content/docs/ai-resources/claude.md\n+++ proposed213/filefn/docs/content/docs/ai-resources/claude.md\n@@ -14,7 +14,7 @@\n   \"mcpServers\": {\n     \"filefn\": {\n       \"type\": \"http\",\n-      \"url\": \"https://docs.filefn.dev/mcp\"\n+      \"url\": \"https://filefn.com/docs/mcp\"\n     }\n   }\n }\n@@ -25,13 +25,13 @@\n ## Claude Code\n \n ```bash\n-claude mcp add filefn https://docs.filefn.dev/mcp --type http\n+claude mcp add filefn https://filefn.com/docs/mcp --type http\n ```\n \n Or use Droid's wrapper:\n \n ```bash\n-droid mcp add filefn https://docs.filefn.dev/mcp --type http\n+droid mcp add filefn https://filefn.com/docs/mcp --type http\n ```\n \n ## CLAUDE.md\n--- exact-provenance/filefn/docs/content/docs/ai-resources/codex.md\n+++ proposed213/filefn/docs/content/docs/ai-resources/codex.md\n@@ -9,7 +9,7 @@\n \n ## System prompt bundle\n \n-Drop `https://docs.filefn.dev/llms.txt` (lightweight) or `https://docs.filefn.dev/llms-full.txt` (full) into the agent's system prompt. The lightweight version is ~3 KiB and gives the agent enough scaffolding to know what's available; the full version is ~150 KiB and is suitable for agents that pre-cache context.\n+Drop `https://filefn.com/docs/llms.txt` (lightweight) or `https://filefn.com/docs/llms-full.txt` (full) into the agent's system prompt. The lightweight version is ~3 KiB and gives the agent enough scaffolding to know what's available; the full version is ~150 KiB and is suitable for agents that pre-cache context.\n \n ## Function tools\n \n@@ -50,11 +50,11 @@\n \n async function handleToolCall(name, args) {\n   if (name === \"filefn_search_docs\") {\n-    return await fetch(`https://docs.filefn.dev/search.json?q=${encodeURIComponent(args.query)}&limit=${args.limit}`)\n+    return await fetch(`https://filefn.com/docs/search.json?q=${encodeURIComponent(args.query)}&limit=${args.limit}`)\n       .then((r) => r.json());\n   }\n   if (name === \"filefn_fetch_page\") {\n-    return await fetch(`https://docs.filefn.dev/docs/${args.slug}/raw`).then((r) => r.text());\n+    return await fetch(`https://filefn.com/docs/docs/${args.slug}/raw`).then((r) => r.text());\n   }\n }\n ```\n@@ -66,7 +66,7 @@\n In the GPT builder:\n \n 1. Knowledge → Upload `llms-full.txt`.\n-2. Actions → Import the OpenAPI from `https://docs.filefn.dev/api/filefn.json` (the docs site OpenAPI, not the filefn server's OpenAPI).\n+2. Actions → Import the OpenAPI from `https://filefn.com/docs/api/filefn.json` (the docs site OpenAPI, not the filefn server's OpenAPI).\n 3. Instructions → \"When the user asks about filefn, search the knowledge base or call the search_docs / fetch_page actions before answering.\"\n \n ## Continue.dev\n@@ -79,7 +79,7 @@\n     {\n       \"name\": \"filefn\",\n       \"type\": \"http\",\n-      \"url\": \"https://docs.filefn.dev/mcp\"\n+      \"url\": \"https://filefn.com/docs/mcp\"\n     }\n   ]\n }\n--- exact-provenance/filefn/docs/content/docs/ai-resources/cursor.md\n+++ proposed213/filefn/docs/content/docs/ai-resources/cursor.md\n@@ -14,7 +14,7 @@\n   \"mcpServers\": {\n     \"filefn\": {\n       \"type\": \"http\",\n-      \"url\": \"https://docs.filefn.dev/mcp\"\n+      \"url\": \"https://filefn.com/docs/mcp\"\n     }\n   }\n }\n@@ -39,7 +39,7 @@\n - Wire @superfunctions/db and @superfunctions/storage adapters.\n - For processing, use processors from @filefn/processing.\n \n-Reference docs at https://docs.filefn.dev. Use the MCP search_docs / fetch_page tools to find the latest content.\n+Reference docs at https://filefn.com/docs. Use the MCP search_docs / fetch_page tools to find the latest content.\n ```\n \n ## Project rules folder\n--- exact-provenance/filefn/docs/content/docs/ai-resources/llms-txt.md\n+++ proposed213/filefn/docs/content/docs/ai-resources/llms-txt.md\n@@ -26,23 +26,23 @@\n \n ## Docs\n \n-- [Welcome](https://docs.filefn.dev/docs): Overview and capability matrix.\n-- [Getting started](https://docs.filefn.dev/docs/getting-started): 9-step walkthrough.\n-- [Quickstart](https://docs.filefn.dev/docs/quickstart): Framework-specific.\n-- [Core Concepts](https://docs.filefn.dev/docs/core-concepts): Architecture.\n-- [Features](https://docs.filefn.dev/docs/features): Bundled features.\n-- [SDKs](https://docs.filefn.dev/docs/sdk): Server, client, Python, Swift.\n-- [Adapters](https://docs.filefn.dev/docs/adapters): Storage and DB.\n-- [Frameworks](https://docs.filefn.dev/docs/frameworks): Production wiring.\n-- [Recipes](https://docs.filefn.dev/docs/recipes): Production patterns.\n-- [Examples](https://docs.filefn.dev/docs/examples): Reference apps.\n-- [Reference](https://docs.filefn.dev/docs/reference): Routes, errors, events, schema.\n+- [Welcome](https://filefn.com/docs/docs): Overview and capability matrix.\n+- [Getting started](https://filefn.com/docs/docs/getting-started): 9-step walkthrough.\n+- [Quickstart](https://filefn.com/docs/docs/quickstart): Framework-specific.\n+- [Core Concepts](https://filefn.com/docs/docs/core-concepts): Architecture.\n+- [Features](https://filefn.com/docs/docs/features): Bundled features.\n+- [SDKs](https://filefn.com/docs/docs/sdk): Server, client, Python, Swift.\n+- [Adapters](https://filefn.com/docs/docs/adapters): Storage and DB.\n+- [Frameworks](https://filefn.com/docs/docs/frameworks): Production wiring.\n+- [Recipes](https://filefn.com/docs/docs/recipes): Production patterns.\n+- [Examples](https://filefn.com/docs/docs/examples): Reference apps.\n+- [Reference](https://filefn.com/docs/docs/reference): Routes, errors, events, schema.\n \n ## Optional\n \n-- [llms-full.txt](https://docs.filefn.dev/llms-full.txt): The whole site.\n-- [OpenAPI](https://docs.filefn.dev/api/filefn.json): Annotated spec.\n-- [MCP](https://docs.filefn.dev/docs/ai-resources/mcp): Live search + fetch.\n+- [llms-full.txt](https://filefn.com/docs/llms-full.txt): The whole site.\n+- [OpenAPI](https://filefn.com/docs/api/filefn.json): Annotated spec.\n+- [MCP](https://filefn.com/docs/docs/ai-resources/mcp): Live search + fetch.\n ```\n \n\n[294 more lines in file. Use offset=291 to continue.]"}],"isError":false,"timestamp":1791367122232}}
{"type":"message","id":"129c15a1","parentId":"5431f4ae","timestamp":"2026-10-07T09:58:42.232Z","message":{"role":"toolResult","toolCallId":"call_K2RXJkTEzXlRDWF7HgGi4lS5|fc_055fb762f51dfcfc016ac617d1e29887d0b5c7245fc84bba58","toolName":"read","content":[{"type":"text","text":"--- reviewed42a/extfn/docs/.gitignore\n+++ preserved213/extfn/docs/.gitignore\n@@ -0,0 +1,10 @@\n+.DS_Store\n+node_modules\n+/.svelte-kit\n+/build\n+.env\n+.env.*\n+!.env.example\n+vite.config.js.timestamp-*\n+vite.config.ts.timestamp-*\n+/.docsfn\n--- reviewed42a/extfn/docs/README.md\n+++ preserved213/extfn/docs/README.md\n@@ -0,0 +1,24 @@\n+# ExtFn documentation site\n+\n+This SvelteKit site uses DocsFn. Consumer guides live in `content/docs`; detailed reference pages mirror the existing Markdown guides in this directory to preserve repository links. Keep both copies aligned when changing an ExtFn contract.\n+\n+From the repository root:\n+\n+```sh\n+npm --workspace @extfn/docs run dev\n+npm --workspace @extfn/docs run build\n+```\n+\n+The build regenerates `static/llms.txt` and `static/llms-full.txt`. For CLI validation, first build the SearchFn workspace dependencies from the repository root (the Vite site build uses source aliases and does not require these separate builds):\n+\n+```sh\n+npm run build --workspace @searchfn/core\n+npm run build --workspace @searchfn/adapter-contracts\n+npm run build --workspace @searchfn/adapter-memory\n+npm run build --workspace @searchfn/adapter-indexeddb\n+npm run build --workspace @searchfn/client\n+npm exec --workspace @extfn/docs -- docsfn validate --root .\n+```\n+The site defaults to port 6015. The public documentation route is `/docs`.\n+\n+The LLM resources are served at `/docs/llms.txt` and `/docs/llms-full.txt`.\n--- reviewed42a/extfn/docs/cli.md\n+++ preserved213/extfn/docs/cli.md\n@@ -114,7 +114,7 @@\n \n Behavior:\n \n-- Builds first if required.\n+- Always rebuilds the selected targets before scanning or creating archives, even when build output already exists.\n - Runs `scan` by default before emitting archives.\n - Chromium archives use `.zip`.\n - Firefox archives use `.xpi`.\n--- reviewed42a/extfn/docs/consumer-host-abstraction.md\n+++ preserved213/extfn/docs/consumer-host-abstraction.md\n@@ -74,21 +74,20 @@\n import { createRuntime } from \"@extfn/core\";\n \n const runtime = createRuntime({\n-  globals: globalThis as never,\n-  rawBrowser:\n-    (globalThis as { browser?: unknown; chrome?: unknown }).browser ??\n-    (globalThis as { browser?: unknown; chrome?: unknown }).chrome ??\n-    {},\n   target: \"chromium-mv3\",\n });\n \n export const extfnHost = {\n   navigation: {\n     async goto(url: string) {\n-      await runtime.browser.call(\"tabs.create\", { url });\n+      if (runtime.address.context === \"content\") {\n+        globalThis.location.assign(url); // Navigates the host page.\n+      } else {\n+        await runtime.browser.call(\"tabs.create\", { url });\n+      }\n     },\n     currentPath() {\n-      return runtime.address.context;\n+      return globalThis.location?.pathname ?? \"\";\n     },\n   },\n   session: {\n@@ -98,6 +97,8 @@\n   },\n };\n ```\n+\n+Content scripts cannot call `tabs.create` directly. This adapter navigates the host page in a content context and opens a new tab from extension pages. If a content-mounted panel needs to open a tab without navigating its host, delegate that operation to a validated background RPC handler. `currentPath()` reads the current document pathname; it is not the runtime context label.\n \n ## Migration plan away from `$app/*`\n \n--- reviewed42a/extfn/docs/content/docs/cli.md\n+++ preserved213/extfn/docs/content/docs/cli.md\n@@ -0,0 +1,15 @@\n+---\n+title: CLI workflow\n+description: Develop, build, scan, and package extension targets.\n+---\n+\n+`@extfn/cli` ships the `extfn` binary. `dev` watches exactly one target and supports `--open`, `--no-open`, and `--browser`. `build` builds all config targets by default or a selected target list. `scan` analyzes emitted files and manifests. `package` always rebuilds the extension, scans by default, and writes store-uploadable archives.\n+\n+```sh\n+npm exec extfn dev -- --config extfn.config.ts --target chromium-mv3 --no-open\n+npm exec extfn build -- --config extfn.config.ts --target chromium-mv3,firefox-mv3\n+npm exec extfn scan -- --config extfn.config.ts --format sarif\n+npm exec extfn package -- --config extfn.config.ts --target firefox-mv3\n+```\n+\n+Global output flags are `--json`, `--quiet`, `--verbose`, and `--color`. Scan is strict by default: error-severity findings cause a nonzero exit. `--no-strict` preserves findings while allowing success; `package --no-scan` skips scanning. Use these opt-outs deliberately and review the reports before distribution. The [full CLI reference](/docs/reference/cli) lists every option and output path.\n--- reviewed42a/extfn/docs/content/docs/configuration.md\n+++ preserved213/extfn/docs/content/docs/configuration.md\n@@ -0,0 +1,31 @@\n+---\n+title: Configuration\n+description: Choose targets, background handlers, page surfaces, and content mounts.\n+---\n+\n+`defineExtension` takes a name, version, target list, and background definition. The resolver requires a nonempty name and version and a `background.serviceWorker`. Supported targets are `chromium-mv3` and `firefox-mv3`. Add `popup`, `options`, or `sidepanel` surfaces with entry files, and declare `contentScripts` with stable IDs, entries, URL matches, and anchors.\n+\n+An example with modular background handlers:\n+\n+```ts\n+import { defineExtension } from \"@extfn/core\";\n+\n+export default defineExtension({\n+  name: \"Example Extension\",\n+  version: \"0.1.0\",\n+  targets: [\"chromium-mv3\", \"firefox-mv3\"],\n+  background: {\n+    serviceWorker: \"./src/background/index.ts\",\n+    messageHandlersDir: \"./src/background/messages\",\n+    portHandlersDir: \"./src/background/ports\",\n+  },\n+  contentScripts: [{\n+    id: \"panel\",\n+    entry: \"./src/contents/panel.ts\",\n+    matches: [\"https://example.com/*\"],\n+    anchors: [{ kind: \"selector-list\", selector: \"[data-panel]\", mountMode: \"append\" }],\n+  }],\n+});\n+```\n\n[1109 more lines in file. Use offset=141 to continue.]"}],"isError":false,"timestamp":1791367122232}}
{"type":"message","id":"3b32aeed","parentId":"129c15a1","timestamp":"2026-10-07T09:58:42.233Z","message":{"role":"toolResult","toolCallId":"call_drZwwv9JETEwDoBLbGuAVFTJ|fc_055fb762f51dfcfc016ac617d1e2a087d0baa78928d4016356","toolName":"read","content":[{"type":"text","text":"## PRRT_kwDOP-e7KM6mNmGb extfn/docs/src/lib/server/docs-site-source.ts\n![kody code-review](https://img.shields.io/badge/kody-code--review-312B4B?labelColor=C9BBF2) ![Bug](https://img.shields.io/badge/Bug-B71C1C) ![medium](https://img.shields.io/badge/severity_level-medium-1A7BBE)\n\n\nparseFrontmatter only recognizes frontmatter when the file starts with exactly \"---\\n\" (LF, no BOM), and it scans for \"\\n---\" without allowing CRLF before the closing fence. a markdown file with CRLF line endings or a BOM has its frontmatter treated as page body, so the title/description leak visibly into rendered docs pages and llms.txt artifacts. match /^---\\r?\\n/ for the opening fence and /\\r?\\n---(\\r?\\n|$)/ for the closing fence.\n\n```typescript\nif (!/^---\\r?\\n/.test(source)) {\n    return { body: source, frontmatter: {} };\n  }\n\n  const closingIndex = source.search(/\\r?\\n---(\\r?\\n|$)/, );\n```\n\n\n\n<details>\n\n<summary>Prompt for LLM</summary>\n\n```\n\nFile extfn/docs/src/lib/server/docs-site-source.ts:\n\nLine 447 to 457:\n\nparseFrontmatter only recognizes frontmatter when the file starts with exactly \"---\\n\" (LF, no BOM), and it scans for \"\\n---\" without allowing CRLF before the closing fence. a markdown file with CRLF line endings or a BOM has its frontmatter treated as page body, so the title/description leak visibly into rendered docs pages and llms.txt artifacts. match /^---\\r?\\n/ for the opening fence and /\\r?\\n---(\\r?\\n|$)/ for the closing fence.\n\nSuggested Code:\n\nif (!/^---\\r?\\n/.test(source)) {\n    return { body: source, frontmatter: {} };\n  }\n\n  const closingIndex = source.search(/\\r?\\n---(\\r?\\n|$)/, );\n\n```\n\n</details>\n\n\n<sub>Talk to Kody by mentioning @kody</sub>\n\n\n<sub>Was this suggestion helpful? React with 👍 or 👎 to help Kody learn from this interaction.</sub>\n\n<!-- kody-codereview -->&#8203;\n&#8203;\n\n## PRRT_kwDOP-e7KM6mNmI6 extfn/docs/src/lib/server/docs-site-source.ts\n![kody code-review](https://img.shields.io/badge/kody-code--review-312B4B?labelColor=C9BBF2) ![Bug](https://img.shields.io/badge/Bug-B71C1C) ![medium](https://img.shields.io/badge/severity_level-medium-1A7BBE)\n\n\nparseFrontmatter only recognizes frontmatter when the file starts with exactly `\"---\\n\"` and locates the closing delimiter with `indexOf(\"\\n---\", 4)`. any markdown file with CRLF line endings (e.g. authored on Windows) or a leading BOM silently fails frontmatter detection, so `title`/`description` render as literal body text and the page title falls back to the filename via deriveTitleFromPath. accept `---\\r\\n` (e.g. test with `/^---\\r?\\n/` or normalize line endings before parsing) and treat a BOM-prefixed source as frontmatter-bearing.\n\n\n\n\n\n<details>\n\n<summary>Prompt for LLM</summary>\n\n```\n\nFile extfn/docs/src/lib/server/docs-site-source.ts:\n\nLine 447 to 457:\n\nparseFrontmatter only recognizes frontmatter when the file starts with exactly `\"---\\n\"` and locates the closing delimiter with `indexOf(\"\\n---\", 4)`. any markdown file with CRLF line endings (e.g. authored on Windows) or a leading BOM silently fails frontmatter detection, so `title`/`description` render as literal body text and the page title falls back to the filename via deriveTitleFromPath. accept `---\\r\\n` (e.g. test with `/^---\\r?\\n/` or normalize line endings before parsing) and treat a BOM-prefixed source as frontmatter-bearing.\n\n```\n\n</details>\n\n\n<sub>Talk to Kody by mentioning @kody</sub>\n\n\n<sub>Was this suggestion helpful? React with 👍 or 👎 to help Kody learn from this interaction.</sub>\n\n<!-- kody-codereview -->&#8203;\n&#8203;\n\n## PRRT_kwDOP-e7KM6mNogZ extfn/docs/src/routes/+layout.server.ts\n<!-- cubic:v=11e9947b-9a89-45cf-9ffd-2ceb123583ac -->\n<!-- cubic:review-run=89d77ea6-21bc-5bb6-986a-2332a2024346 -->\n<!-- metadata:{\"confidence\":8} -->\nP2: The root layout returns the entire `DocsSiteSource` (manifest with every page's body, the full search artifact, and config) from a server load. SvelteKit serializes this into the client payload of every page and every client-side navigation, even though the client only reads `source.config.navigation.topNav`, `source.config.site.showFooter`/`description`, and `source.siteTitle` (+layout.svelte, +page.svelte). `manifest` and `searchArtifact` are consumed only server-side by `/docs/[...slug]/+page.server.ts` via `parent()` (search already has its own `/search.json` endpoint), so the whole corpus and search index are duplicated into every HTML response. Return only the config fields the chrome needs and let child server loads import the state directly.\n\n<details>\n<summary>Prompt for AI agents</summary>\n\n```text\nCheck if this issue is valid — if so, understand the root cause and fix it. At extfn/docs/src/routes/+layout.server.ts, line 6:\n\n<comment>The root layout returns the entire `DocsSiteSource` (manifest with every page's body, the full search artifact, and config) from a server load. SvelteKit serializes this into the client payload of every page and every client-side navigation, even though the client only reads `source.config.navigation.topNav`, `source.config.site.showFooter`/`description`, and `source.siteTitle` (+layout.svelte, +page.svelte). `manifest` and `searchArtifact` are consumed only server-side by `/docs/[...slug]/+page.server.ts` via `parent()` (search already has its own `/search.json` endpoint), so the whole corpus and search index are duplicated into every HTML response. Return only the config fields the chrome needs and let child server loads import the state directly.</comment>\n\n<file context>\n@@ -0,0 +1,8 @@\n+\n+export const load: LayoutServerLoad = async () => {\n+  return {\n+    source: await loadDocsSiteSource(),\n+  };\n+};\n</file context>\n```\n\n</details>\n\n✅ Addressed in [`3dd6ff1`](https://github.com/21nCo/super-functions/commit/3dd6ff1a256c8289979ff29b10f4a59a31869d47)\n\n## PRRT_kwDOP-e7KM6mNoga extfn/docs/vite.config.ts\n<!-- cubic:v=3f7dcd66-bd01-48b1-aaba-983ff346f98a -->\n<!-- cubic:review-run=89d77ea6-21bc-5bb6-986a-2332a2024346 -->\n<!-- metadata:{\"confidence\":6} -->\nP2: Vite's string `find` aliases match by prefix, so these entries also intercept subpath imports. `searchfn/client/package.json` exports `@searchfn/client/constructors` and `@searchfn/client/in-memory-search`; if `@docsfn/core` or `@searchfn` source imports either, the import is rewritten to `searchfn/client/src/index.ts/constructors` (a non-existent path) instead of `src/constructors.ts`, breaking dev/build resolution. Anchor each alias with an anchored regex or a `$`-terminated find so only the bare specifier matches.\n\n<details>\n<summary>Prompt for AI agents</summary>\n\n```text\nCheck if this issue is valid — if so, understand the root cause and fix it. At extfn/docs/vite.config.ts, line 21:\n\n<comment>Vite's string `find` aliases match by prefix, so these entries also intercept subpath imports. `searchfn/client/package.json` exports `@searchfn/client/constructors` and `@searchfn/client/in-memory-search`; if `@docsfn/core` or `@searchfn` source imports either, the import is rewritten to `searchfn/client/src/index.ts/constructors` (a non-existent path) instead of `src/constructors.ts`, breaking dev/build resolution. Anchor each alias with an anchored regex or a `$`-terminated find so only the bare specifier matches.</comment>\n\n<file context>\n@@ -0,0 +1,28 @@\n+  },\n+  resolve: {\n+    alias: [\n+      { find: \"@searchfn/client\", replacement: path.resolve(dirname, \"../../searchfn/client/src/index.ts\") },\n+      { find: \"@searchfn/core\", replacement: path.resolve(dirname, \"../../searchfn/core/src/index.ts\") },\n+      { find: \"@searchfn/adapter-contracts\", replacement: path.resolve(dirname, \"../../searchfn/adapter-contracts/src/index.ts\") },\n</file context>\n```\n\n</details>\n\n\n[908 more lines in file. Use offset=141 to continue.]"}],"isError":false,"timestamp":1791367122233}}
