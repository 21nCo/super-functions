gest(),{'body':b,'ids':[]})['ids'].append(row.get('id'))\n novel={h:r for h,r in unique.items() if h not in oldBodies};text='\\n\\n'.join(f'## {name} ids={r[\"ids\"]} bodySHA256={h}\\n{r[\"body\"]}' for h,r in novel.items());(A/(name+'-novel-bodies.txt')).write_text(text+'\\n');summary[name]={'unique':len(unique),'historicalExactReuse':len(unique)-len(novel),'novel':len(novel),'novelLines':len(text.splitlines()),'qualification':'Exact historical bodies retain historical displayed-reading/pre-use qualifications; novel bodies require fresh visible reading, not inferred from generated map.'}\n(A/'supplementary-body-reuse-map.json').write_text(json.dumps(summary,indent=2)+'\\n');print(json.dumps(summary,indent=2))\nfiles=json.loads((A/'files.json').read_text());meta=json.loads((A/'meta.json').read_text());reuse={};novel=[];human=[]\nrefs=['3c733afa29ffb7c721870a8d5318cf656f3f1ca4','4e67ac86a5de697568b6bf61c6064f13d925f88d']\ndef blob(ref,p):\n row=subprocess.check_output(['git','-C',str(T),'ls-tree','-z',ref,'--',p]).split(b'\\0')[0]\n if not row:return None,None\n m,n=row.split(b'\\t',1);mode,kind,oid=m.decode().split();assert n.decode()==p and kind=='blob';return subprocess.check_output(['git','-C',str(T),'cat-file','blob',oid]),mode\nfor row in files:\n p=row['filename']\n if p=='package-lock.json' or '/static/llms' in p or '/public/llms' in p:continue\n body,mode=blob(meta['headRefOid'],p);record=None\n for ref in refs:\n  b,m=blob(ref,p)\n  if body is not None and body==b and mode==m:record={'status':'exact-byte-mode-reuse','ref':ref,'sha256':hashlib.sha256(body).hexdigest(),'qualification':'Prior source review/timing/display qualifications retained; not new fresh full reading.'};break\n if not record:\n  record={'status':'novel-or-different','sha256':hashlib.sha256(body).hexdigest() if body is not None else None,'gitMode':mode};novel.append(p)\n  before,_=blob(meta['baseRefOid'],p);human.extend(difflib.unified_diff((before or b'').decode().splitlines(True),(body or b'').decode().splitlines(True),fromfile='apiBase7c6/'+p,tofile='frozenf155/'+p))\n reuse[p]=record\n(A/'frozen-human-source-reuse-map.json').write_text(json.dumps(reuse,indent=2)+'\\n');(A/'frozen-novel-human-source.patch').write_text(''.join(human));print('Human',len(reuse),'reuse',len(reuse)-len(novel),'novel',len(novel),'lines',len(human));print('\\n'.join(novel))\nPY","timeout":180}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":316,"output":1529,"cacheRead":249728,"cacheWrite":0,"reasoning":516,"totalTokens":251573,"cost":{"input":0.000632,"output":0.015290000000000002,"cacheRead":0.024972800000000003,"cacheWrite":0,"total":0.04089480000000001}},"stopReason":"toolUse","timestamp":1791330543360,"responseId":"resp_055fb762f51dfcfc016ac588eff8dc87d0b2ef7ec4634d63e0","rawStopReason":"completed","thinkingLevel":"high"}}
