{"type":"message","id":"e46c89e5","parentId":"8786892f","timestamp":"2026-10-07T09:52:50.573Z","message":{"role":"toolResult","toolCallId":"call_otBEKmg1lwm9K36VVWovxt32|fc_055fb762f51dfcfc016ac616721f4087d0832c1d245285ad84","toolName":"read","content":[{"type":"text","text":"import fs from 'node:fs';\nimport http from 'node:http';\nimport path from 'node:path';\nimport assert from 'node:assert/strict';\nimport {createRequire} from 'node:module';\nimport {pathToFileURL} from 'node:url';\nconst root=path.resolve(process.argv[2]);\nconst failures=[];\nconst originalCwd=process.cwd();\nfor(const product of [process.argv[3]??'botfn']){\n const directory=path.join(root,product,'docs');\n const require=createRequire(path.join(directory,'package.json'));\n const {createServer}=await import(pathToFileURL(require.resolve('vite')));\n const fixtureName='__actual_asset_admission';\n const source='UTF8 probe: 主\\n';\n const extensions=['txt','json','yaml','yml','md','mdx'];\n const files=extensions.map(ext=>path.join(directory,'static',`${fixtureName}.${ext}`));\n files.push(path.join(directory,'static',`${fixtureName}.png`));\n const caller=path.join(directory,'src/lib/server/docs-site-source.ts');\n const observedCaller=path.join(directory,'src/lib/server/__actual_asset_admission.ts');\n assert(!fs.existsSync(observedCaller));\n assert(files.every(f=>!fs.existsSync(f)),'owned probe must start absent');\n let server, local;\n try{\n  for(const file of files)fs.writeFileSync(file,file.endsWith('.png')?Buffer.from([137,80,78,71,0,255]):source);\n  process.chdir(directory); // SvelteKit derives config ownership from cwd, not Vite root alone\n  server=await createServer({root:directory,server:{middlewareMode:true},appType:'custom'});\n  // Exact production caller/glob/imports, with only a test observer export appended.\n  // Published Core does not expose assets on DocsManifest; don't invent that API.\n  fs.writeFileSync(observedCaller,fs.readFileSync(caller,'utf8')+'\\nexport const __probeAssets=assets;\\n');\n  const {__probeAssets}=await server.ssrLoadModule('/src/lib/server/__actual_asset_admission.ts');\n  for(const extension of extensions){\n   const key=`../../../static/${fixtureName}.${extension}`;\n   const asset=__probeAssets[key];\n   console.log(product,key,asset??'MISSING');\n   try{assert.equal(asset,source,`${product} caller must admit exact UTF8 ${extension}`);}catch(error){failures.push(String(error));}\n  }\n  assert(!Object.hasOwn(__probeAssets,`../../../static/${fixtureName}.png`),'binary remains adapter/static-owned, not raw text admission');\n  local=http.createServer(server.middlewares);\n  await new Promise(resolve=>local.listen(0,'127.0.0.1',resolve));\n  const url=`http://127.0.0.1:${local.address().port}${server.config.base}${fixtureName}.png`;\n  const response=await fetch(url);assert.equal(response.status,200,url);\n  assert.deepEqual(Buffer.from(await response.arrayBuffer()),Buffer.from([137,80,78,71,0,255]),'native Vite static HTTP preserves binary bytes');\n  console.log(JSON.stringify({product,binaryStaticHttp200:true,exactPngBytes:true,url}));\n }finally{\n  if(local)await new Promise(resolve=>local.close(resolve));\n  if(server)await server.close();\n  process.chdir(originalCwd);\n  for(const file of [...files,observedCaller])if(fs.existsSync(file))fs.unlinkSync(file); // only exact owned, initially absent probe files\n }\n}\nconsole.log(JSON.stringify({failures,restoredOwnedProbeAbsence:true}));\nif(failures.length)process.exitCode=1;\n"}],"isError":false,"timestamp":1791366770573}}
{"type":"message","id":"31a7392d","parentId":"e46c89e5","timestamp":"2026-10-07T09:52:50.573Z","message":{"role":"toolResult","toolCallId":"call_58oJ3jR4ep7selun1asaY3M3|fc_055fb762f51dfcfc016ac616721f4887d0b997e1ce7bf39113","toolName":"read","content":[{"type":"text","text":"{\n  \"name\": \"@extfn/cli\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Canonical extfn CLI for development and release workflows\",\n  \"type\": \"module\",\n  \"main\": \"./dist/index.js\",\n  \"types\": \"./dist/index.d.ts\",\n  \"bin\": {\n    \"extfn\": \"./dist/cli.js\"\n  },\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"import\": \"./dist/index.js\"\n    }\n  },\n  \"files\": [\n    \"dist\"\n  ],\n  \"scripts\": {\n    \"build\": \"tsc\",\n    \"dev\": \"tsc --watch\",\n    \"test\": \"vitest\",\n    \"test:watch\": \"vitest --watch\",\n    \"lint\": \"echo 'lint not configured'\",\n    \"clean\": \"rm -rf dist\"\n  },\n  \"keywords\": [\n    \"extfn\",\n    \"cli\",\n    \"browser-extension\",\n    \"superfunctions\"\n  ],\n  \"author\": \"21n\",\n  \"license\": \"MIT\",\n  \"dependencies\": {\n    \"@extfn/vite\": \"0.1.2\",\n    \"@clifn/core\": \"0.1.0\",\n    \"@extfn/core\": \"0.1.0\",\n    \"commander\": \"^12.1.0\",\n    \"fflate\": \"^0.8.2\",\n    \"vite\": \"^5.4.21\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^22.0.0\",\n    \"typescript\": \"^5.6.0\",\n    \"vitest\": \"^3.2.4\"\n  },\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/21nCo/super-functions.git\",\n    \"directory\": \"extfn/cli\"\n  },\n  \"publishConfig\": {\n    \"access\": \"public\"\n  }\n}\n"}],"isError":false,"timestamp":1791366770573}}
