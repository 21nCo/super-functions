51\t          results: execution.results.map(result =\u003e ({\n   352\t            ...result,\n   353\t            name: redactSuiteArtifact(options.target, result.name, { preserveKeys: false }),\n   354\t            operation: redactSuiteArtifact(options.target, result.operation, { preserveKeys: false }),\n   355\t            ...(result.tool === undefined ? {} : {\n   356\t              tool: redactSuiteArtifact(options.target, result.tool, { preserveKeys: false }),\n   357\t            }),\n   358\t          })),\n   359\t        },\n   360\t      };\n   361\t    } catch {\n   362\t      return { ...fallback, failure: \"redaction\" };\n   363\t    }\n   364\t  } catch {\n   365\t    return { ...fallback, failure: \"serialization\" };\n   366\t  }\n   367\t}\n   368\t\n   369\tconst suiteStructureKeys = [\n   370\t  \"formatVersion\", \"kind\", \"status\", \"runtime\", \"ok\", \"target\", \"server\",\n   371\t  \"capabilities\", \"manifestChecked\", \"manifestHash\", \"total\", \"passed\", \"failed\",\n   372\t  \"incomplete\", \"droppedResults\", \"droppedObservedEvents\",\n   373\t  \"redactionOmittedObservedEvents\", \"incompleteReason\", \"failure\", \"timeline\",\n   374\t  \"droppedTimelineEvents\", \"results\", \"node\", \"scenarioFormatVersion\",\n   375\t  \"reportSchemaVersion\", \"packages\", \"testing\", \"name\", \"message\", \"layer\", \"code\",\n   376\t  \"phase\", \"details\", \"outcome\", \"requestId\", \"at\", \"sideEffect\", \"durationMs\",\n   377\t  \"error\", \"operation\", \"tool\",\n   378\t] as const;\n   379\t\n   380\tconst suiteStructureValues = [\n   381\t  \"mcpfn.target-suite-report\", \"complete\", \"incomplete\", \"passed\", \"failed\",\n   382\t  \"started\", \"succeeded\", \"none\", \"idempotent\", \"non-idempotent\",\n   383\t  \"mcpfn-preflight\", \"authorization-server\", \"resource-server\", \"mcp-initialization\",\n   384\t  \"scenario\", \"upstream-conformance\", \"resource-discovery\",\n   385\t  \"authorization-server-discovery\", \"client-registration\", \"authorization-request\",\n   386\t  \"authorization-callback\", \"token-exchange\", \"token-refresh\", \"token-revocation\",\n   387\t  \"transport-connect\", \"mcp-initialize\", \"capability-operation\", \"transport-close\",\n   388\t  \"authenticated-streamable-http\", \"streamable-http\", \"stdio\", \"in-memory\", \"custom\",\n   389\t] as const;\n   390\t\n   391\tinterface SuiteStructureGuard {\n   392\t  assert(value: string): void;\n   393\t}\n   394\t\n   395\tfunction captureSuiteStructureGuard(\n   396\t  target: McpFnTarget,\n   397\t  projection: SuiteProjection,\n   398\t  diagnostics: SuiteDiagnosticCollector,\n   399\t): SuiteStructureGuard {\n   400\t  const candidates = new Set\u003cstring\u003e([\n   401\t    ...suiteStructureKeys,\n   402\t    ...suiteStructureValues,\n   403\t    process.version,\n   404\t    MCPFN_REPORT_SCHEMA_VERSION,\n   405\t    MCPFN_TESTING_VERSION,\n   406\t    projection.target.kind,\n   407\t  ]);\n   408\t  for (const result of projection.execution.results) {\n   409\t    candidates.add(result.status);\n   410\t    if (result.sideEffect) candidates.add(result.sideEffect);\n   411\t  }\n   412\t  for (const event of diagnostics.timeline) {\n   413\t    candidates.add(event.phase);\n   414\t    candidates.add(event.outcome);\n   415\t    if (event.target?.kind) candidates.add(event.target.kind);\n   416\t  }\n   417\t  const safe = new Set\u003cstring\u003e();\n   418\t  for (const candidate of candidates) {\n   419\t    try {\n   420\t      if (redactSuiteArtifact(target, candidate, { preserveKeys: false }) === candidate) {\n   421\t        safe.add(candidate);\n   422\t      }\n   423\t    } catch {\n   424\t      // If the live custom scrubber cannot classify a string, fail closed only\n   425\t      // when the final report actually needs that unproven structure.\n   426\t    }\n   427\t  }\n   428\t  return {\n   429\t    assert(value: string): void {\n   430\t      if (!safe.has(value)) throw new McpFnStructuralCredentialCollisionError();\n   431\t    },\n   432\t  };\n   433\t}\n   434\t\n   435\tfunction assertStructureKeys(value: object, guard: SuiteStructureGuard): void {\n   436\t  for (const key of Object.keys(value)) guard.assert(key);\n   437\t}\n   438\t\n   439\tfunction assertTargetStructure(\n   440\t  target: McpFnTargetDescriptor,\n   441\t  guard: SuiteStructureGuard,\n   442\t): void {\n   443\t  guard.assert(\"kind\");\n   444\t  guard.assert(target.kind);\n   445\t}\n   446\t\n   447\tfunction assertSuiteReportStructure(\n   448\t  report: McpFnTargetSuiteReport,\n   449\t  guard: SuiteStructureGuard,\n   450\t): void {\n   451\t  assertStructureKeys(report, guard);\n   452\t  guard.assert(report.kind);\n   453\t  guard.assert(report.status);\n   454\t  assertStructureKeys(report.runtime, guard);\n   455\t  guard.assert(report.runtime.node);\n   456\t  guard.assert(report.runtime.reportSchemaVersion);\n   457\t  assertStructureKeys(report.runtime.packages, guard);\n   458\t  guard.assert(report.runtime.packages.testing);\n   459\t  assertTargetStructure(report.target, guard);\n   460\t  if (report.failure) {\n   461\t    assertStructureKeys(report.failure, guard);\n   462\t    guard.assert(report.failure.layer);\n   463\t    if (report.failure.phase) guard.assert(report.failure.phase);\n   464\t  }\n   465\t  for (const event of report.timeline) {\n   466\t    assertStructureKeys(event, guard);\n   467\t    guard.assert(event.phase);\n   468\t    guard.assert(event.outcome);\n   469\t    if (event.target) assertTargetStructure(event.target, guard);\n   470\t  }\n   471\t  for (const result of report.results) {\n   472\t    assertStructureKeys(result, guard);\n   473\t    guard.assert(result.status);\n   474\t    if (result.sideEffect) guard.assert(result.sideEffect);\n   475\t  }\n   476\t}\n   477\t\n   478\tasync function closeSuiteClient(client: McpFnTestClient | undefined): Promise\u003c{\n   479\t  cleanupFailure?: McpFnReportFailure;\n   480\t  retainedCleanup?: () =\u003e Promise\u003cvoid\u003e;\n   481\t}\u003e {\n   482\t  try {\n   483\t    await client?.close();\n   484\t    return {};\n   485\t  } catch (error) {\n   486\t    let retainedCleanup: (() =\u003e Promise\u003cvoid\u003e) | undefined;\n   487\t    if (error instanceof McpFnTestClientCleanupError) {\n   488\t      retainedCleanup = () =\u003e error.retryCleanup();\n   489\t    } else if (client) {\n   490\t      retainedCleanup = () =\u003e client.close();\n   491\t    }\n   492\t    const terminal = error instanceof McpFnTestClientCleanupError \u0026\u0026 error.cause !== undefined\n   493\t      ? error.cause\n   494\t      : error;\n   495\t    const phase = terminal \u0026\u0026 typeof terminal === \"object\" \u0026\u0026\n   496\t        (terminal as { phase?: unknown }).phase === \"token-revocation\"\n   497\t      ? \"token-revocation\"\n   498\t      : \"transport-close\";\n   499\t    return {\n   500\t      retainedCleanup,\n   501\t      cleanupFailure: normalizeMcpFnReportFailure({\n   502\t        name: \"CleanupError\",\n   503\t        message: \"Target cleanup failed\",\n   504\t        code: \"MCPFN_TARGET_CLEANUP_FAILED\",\n   505\t        phase,\n   506\t      }),\n   507\t    };\n   508\t  }\n   509\t}\n   510\t\n   511\tinterface SuiteConnection {\n   512\t  client?: McpFnTestClient;\n   513\t  manifestChecked: boolean;\n   514\t  failure?: McpFnReportFailure;\n   515\t  execution: SuiteExecution;\n   516\t}\n   517\t\n   518\tasync function connectSuite(\n   519\t  options: RunMcpFnTargetSuiteOptions,\n   520\t  diagnostics: SuiteDiagnosticCollector,\n   521\t): Promise\u003cSuiteConnection\u003e {\n   522\t  let client: McpFnTestClient | undefined;\n   523\t  let manifestChecked = false;\n   524\t  let failure: McpFnReportFailure | undefined;\n   525\t  let execution: SuiteExecution = { results: [] };\n   526\t  try {\n   527\t    client = McpFnTestClient.createTarget(\n   528\t      options.target,\n   529\t      options.clientInfo ?? { name: \"mcpfn-suite\", version: \"0.0.1\" },\n   530\t      {\n   531\t        ...options.client,\n   532\t        diagnostics: event =\u003e diagnostics.record(client, event),\n   533\t      },\n   534\t    );\n   535\t    diagnostics.captureBaseline(client);\n   536\t    await client.session.connect();\n   537\t    ({ execution, manifestChecked } = await executeConnectedSuite(client, options));\n   538\t  } catch (error) {\n   539\t    failure = safeTargetFailure(options.target, error);\n   540\t  }\n   541\t  return { client, manifestChecked, failure, execution };\n   542\t}\n   543\t\n   544\tasync function projectAndCloseSuite(\n   545\t  options: RunMcpFnTargetSuiteOptions,\n   546\t  diagnostics: SuiteDiagnosticCollector,\n   547\t  connection: SuiteConnection,\n   548\t): Promise\u003c{\n   549\t  projection: SuiteProjection;\n   550\t  structureGuard: SuiteStructureGuard;\n   551\t  closeResult: Awaited\u003cReturnType\u003ctypeof closeSuiteClient\u003e\u003e;\n   552\t}\u003e {\n   553\t  let projection: SuiteProjection = {\n   554\t    target: { kind: \"custom\" },\n   555\t    execution: connection.execution,\n   556\t    failure: \"serialization\",\n   557\t  };\n   558\t  let structureGuard: SuiteStructureGuard = {\n   559\t    assert: () =\u003e { throw new McpFnStructuralCredentialCollisionError(); },\n   560\t  };\n   561\t  let closeResult: Awaited\u003cReturnType\u003ctypeof closeSuiteClient\u003e\u003e = {};\n   562\t  try {\n   563\t    projection = projectSuiteArtifacts(options, connection.client, connection.execution);\n   564\t    structureGuard = captureSuiteStructureGuard(options.target, projection, diagnostics);\n   565\t  } finally {\n   566\t    closeResult = await closeSuiteClient(connection.client);\n   567\t  }\n   568\t  return { projection, structureGuard, closeResult };\n   569\t}\n   570\t\n   571\tfunction suiteIncompleteReasons(\n   572\t  failure: McpFnReportFailure | undefin