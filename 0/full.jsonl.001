{"type":"message","id":"ec192238","parentId":"755ac76e","timestamp":"2026-10-06T11:31:56.770Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_nhCLDRsNvcVzFmPx3xukY3fo|fc_055fb762f51dfcfc016ac4dc14c21087d097580dd8956b50f6","name":"write","arguments":{"path":"/Users/serro/Documents/dev/n/audits/sf-docs-review-20260930/sequential-20261003T184612Z/PR-212/verify-final-promotion-admission.py","content":"import pathlib,json,hashlib,stat,os,subprocess,datetime\nA=pathlib.Path(__file__).resolve().parent;R=A.parents[1];T=pathlib.Path('/Users/serro/orca/workspaces/superfunctions/docs-pr-206-review-20260930');plan=json.loads((A/'reviewed-candidate-plan.json').read_text());V=pathlib.Path(plan['candidate']);S=V.parent/'standalone-current-npm11'\ndef entry(p):\n b=os.readlink(p).encode() if p.is_symlink() else p.read_bytes() if p.is_file() else None\n return {'sha256':hashlib.sha256(b).hexdigest() if b is not None else None,'gitMode':'120000' if p.is_symlink() else ('100755' if p.stat().st_mode&0o111 else '100644') if b is not None else None}\ndef git(*args):return subprocess.check_output(['git','-C',str(T),*args],text=True).strip()\nl=json.loads((R/'parent-ledger.json').read_text());json.loads((R/'checkpoint.json').read_text());round=l['prs']['212']['current_sequential_round'];assert l['execution']['current_sequential_sweep']['active_pr']==212 and round['collection_count']==1 and round['publication_count']==0\nassert l['digest']==round['skill_digest']=='sha256:b6a6e7a8c670bc5ab12540910401d153e8eedd533d89fd1a1925bc9979112726';assert hashlib.sha256((A/'SKILL.md').read_bytes()).hexdigest()=='78e6b66300287085d26e1cf15657a5010c6c93d0c2c23a9d4240064a6cdcd91c'\nassert git('rev-parse','HEAD')==plan['head'] and not git('status','--porcelain');assert git('branch','--show-current')=='codex/docs-devfn-20260926'\nsource=json.loads((A/'producer-final-current-source-hashes-and-modes.json').read_text());assert len(source)==8314\nfor p,e in source.items():assert entry(V/p)==e,p\nfor p,h in json.loads((A/'execution-protected-before-switch.json').read_text()).items():assert entry(T/p)['sha256']==h and entry(V/p)['sha256']==h,p\nassert not (S/'package.json').exists() and not (S/'node_modules').exists()\nfor p,e in source.items():\n if p.startswith(('devfn/docs/','authfn/docs/','filefn/docs/','scripts/docs-site/')):assert entry(S/p)==e,('standalone source mismatch',p)\nfor p in json.loads((A/'controlled212-inputs.json').read_text()):assert not (V/p).exists() and not (S/p).exists() and not (T/p).exists(),p\nfor root in [V,S]:\n assert not list((root/'scripts/docs-site').glob('__*')),root\n for product in ['devfn','authfn','filefn']:assert not list((root/product/'docs').glob('__*')),(root,product)\nreceipts=['current212-root-normal-npm-ci','current212-secfn-native-contract-tests','current212-secfn-native-types','producer212-final-offline-cf-dryrun','producer212-devfn-native-cli-validate']\nfor context in ['root','standalone']:\n receipts.extend([f'producer212-final-{context}-native-text-http',f'producer212-final-{context}-devfn-browser'])\n for product in ['devfn','authfn','filefn']:\n  receipts.extend(f'producer212-final-{context}-{product}-{test}' for test in ['pristine-build','tests','types','native-vite-http'])\nfor n in receipts:assert json.loads((A/(n+'.receipt.json')).read_text())['exitCode']==0,n\nfor n in ['current212-root-physical-closures.json','current212-genuine-standalone-physical-closures.json']:\n d=json.loads((A/n).read_text());assert all(not r['failures'] for r in d['rows']),n\nmatrix=json.loads((A/'executing-producer-origin-matrix.json').read_text());assert len(matrix['results'])==6 and matrix['staticArchiveVerifiedBeforeWriter']\nfor row in matrix['results']:assert all(row[k] is True for k in ['assetsOnlyEqualsNormal','actualCliPublicLinksNotAssets','nondeploymentPublicIgnored','staticBytesAndModesRestored'])\nidentity=json.loads((A/'final-precommit-pr-identity.json').read_text());assert identity['headRefOid']==plan['head'] and identity['headRefName']=='codex/docs-devfn-20260926' and identity['baseRefName']=='dev' and identity['state']=='OPEN' and not identity['isCrossRepository']\nrefs=(A/'pre-promotion-remote-refs.txt').read_text();assert plan['head']+'\\trefs/heads/codex/docs-devfn-20260926' in refs and plan['base']+'\\trefs/heads/dev' in refs\nassert (A/'final-source-review-assessment.md').exists()\nout=A/'final-promotion-admission.json';assert not out.exists();out.write_text(json.dumps({'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'passed':True,'canonicalPaths':len(source),'receipts':receipts,'controlledInputsAbsent':True,'standaloneSourceAgreement':True,'protectedBytesUnchanged':True,'collections':1,'publications':0,'hostedMergeGateClosed':True},indent=2)+'\\n');print('Final source/native/protected/three-context/ledger admission passes')\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":390,"output":1306,"cacheRead":179072,"cacheWrite":0,"reasoning":0,"totalTokens":180768,"cost":{"input":0.00078,"output":0.01306,"cacheRead":0.0179072,"cacheWrite":0,"total":0.0317472}},"stopReason":"toolUse","timestamp":1791286290335,"responseId":"resp_055fb762f51dfcfc016ac4dc12e18487d0a034b4c5b71c572d","rawStopReason":"completed","thinkingLevel":"high"}}
