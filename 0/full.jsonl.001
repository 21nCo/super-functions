(value: T): T => JSON.parse(\n   237\t        JSON.stringify(value).replaceAll(secret, \"[REDACTED]\"),\n   238\t      ) as T,\n   239\t    }),\n   240\t  });\n   241\t  const inspector = new McpFnInspector(client);\n   242\t  expect(() => inspector.exportScenario(\n   243\t    \"reflection\",\n   244\t    { kind: \"tools.call\", name: \"echo\" },\n   245\t    { content: [] },\n   246\t  )).toThrow(\"MCP artifact structure conflicts with credential redaction\");\n   247\t});\n   248\t\n   249\tit(\"declares placeholders introduced in redacted property keys\", () => {\n   250\t  const secret = \"opaque-property-key\";\n   251\t  const target = customTarget({\n   252\t    kind: \"custom\",\n   253\t    open: async () => { throw new Error(\"unused\"); },\n   254\t    redact: <T>(value: T, options): T => JSON.parse(\n   255\t      JSON.stringify(value).replaceAll(secret, options?.redactionMarker ?? \"[REDACTED]\"),\n   256\t    ) as T,\n   257\t  });\n   258\t  const inspector = new McpFnInspector(new McpFnClient({ target }));\n   259\t  const scenario = inspector.exportScenario(\n   260\t    \"redacted key\",\n   261\t    { kind: \"tools.call\", name: \"echo\", arguments: { [secret]: \"value\" } },\n   262\t    { content: [], structuredContent: { [secret]: \"value\" } },\n   263\t  );\n   264\t  expect(scenario.variables).toEqual([\"MCPFN_SECRET\"]);\n   265\t  expect(scenario.arguments).toEqual({ \"${MCPFN_SECRET}\": \"${MCPFN_SECRET}\" });\n   266\t  expect(scenario.expect?.structuredContent).toEqual({\n   267\t    \"${MCPFN_SECRET}\": \"${MCPFN_SECRET}\",\n   268\t  });\n   269\t});\n   270\t\n   271\tit(\"selects a replayable placeholder when the preferred marker contains the credential\", () => {\n   272\t  const secret = \"MCPFN\";\n   273\t  const target = customTarget({\n   274\t    kind: \"custom\",\n   275\t    open: async () => { throw new Error(\"unused\"); },\n   276\t    redact: <T>(value: T, options): T => JSON.parse(\n   277\t      JSON.stringify(value).replaceAll(secret, options?.redactionMarker ?? \"[REDACTED]\"),\n   278\t    ) as T,\n   279\t  });\n   280\t  const inspector = new McpFnInspector(new McpFnClient({ target }));\n   281\t  const scenario = inspector.exportScenario(\n   282\t    \"redacted key\",\n   283\t    { kind: \"tools.call\", name: \"echo\", arguments: { [secret]: \"value\" } },\n   284\t    { content: [] },\n   285\t  );\n   286\t  expect(scenario.variables).toEqual([\"SECRET\"]);\n   287\t  expect(scenario.arguments).toEqual({ \"${SECRET}\": \"${SECRET}\" });\n   288\t});\n   289\t\n   290\tit(\"marks an export incomplete when credential redaction collapses payload keys\", async () => {\n   291\t  const secret = \"opaque-secret\";\n   292\t  const fixture = await startAuthenticatedServer(secret);\n   293\t  const client = new McpFnClient({\n   294\t    target: authenticatedHttpTarget(fixture.url, {\n   295\t      credential: { headers: { authorization: `Bearer ${secret}` } },\n   296\t    }),\n   297\t  });\n   298\t  const inspector = new McpFnInspector(client);\n   299\t  try {\n   300\t    await inspector.connect();\n   301\t    const scenario = inspector.exportScenario(\n   302\t      \"colliding keys\",\n   303\t      {\n   304\t        kind: \"tools.call\",\n   305\t        name: \"echo\",\n   306\t        arguments: { [secret]: 1, \"${MCPFN_SECRET}\": 2 },\n   307\t      },\n   308\t      { content: [] },\n   309\t    );\n   310\t    expect(scenario).toMatchObject({\n   311\t      kind: \"tools.call\",\n   312\t      status: \"incomplete\",\n   313\t      incompleteReason: \"Inspector export omitted payload because credential redaction failed\",\n   314\t    });\n   315\t    expect(JSON.stringify(scenario)).not.toContain(secret);\n   316\t  } finally {\n   317\t    try { await inspector.close(); } finally { await fixture.close(); }\n   318\t  }\n   319\t});\n   320\t\n   321\tit(\"rejects an export when no structural value is safe\", () => {\n   322\t  const target = customTarget({\n   323\t    kind: \"custom\",\n   324\t    open: async () => { throw new Error(\"unused\"); },\n   325\t    redact: <T>(): T => \"\" as T,\n   326\t  });\n   327\t  const inspector = new McpFnInspector(new McpFnClient({ target }));\n   328\t  expect(() => inspector.exportScenario(\n   329\t    \"redacted key\",\n   330\t    { kind: \"tools.call\", name: \"echo\", arguments: { secret: \"value\" } },\n   331\t    { content: [] },\n   332\t  )).toThrow(\"MCP artifact structure conflicts with credential redaction\");\n   333\t});\n   334\t\n   335\t\n   336\tit.each([\"connected\", \"passed\", \"logging.message\", \"custom\"])(\"redacts envelope-shaped scenario payloads containing %s\", async secret => {\n   337\t  const fixture = await startAuthenticatedServer(secret, true);\n   338\t  const client = new McpFnClient({ target: authenticatedHttpTarget(fixture.url, {\n   339\t    credential: { headers: { authorization: `Bearer ${secret}` } },\n   340\t  }) });\n   341\t  const inspector = new McpFnInspector(client);\n   342\t  try {\n   343\t    await inspector.connect();\n   344\t    const payload = { clientState: secret, status: secret, kind: secret,\n   345\t      target: { kind: secret }, nested: [{ clientState: secret }] };\n   346\t    const scenario = inspector.exportScenario(\"reflection\", {\n   347\t      kind: \"tools.call\", name: \"identity\", arguments: payload,\n   348\t    }, { content: [], structuredContent: payload });\n   349\t    expect(scenario.kind).toBe(\"tools.call\");\n   350\t    expect(scenario.sideEffect).toBe(\"non-idempotent\");\n   351\t    expect(JSON.stringify(scenario)).not.toContain(secret);\n   352\t    expect(JSON.stringify(scenario)).toContain(\"${MCPFN_SECRET}\");\n   353\t  } finally { try { await client.close(); } finally { await fixture.close(); } }\n   354\t});\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0b992-9248-7613-95d3-df05acb573b9","create_time":1789820343.11348}},"metadata":{"client_authored":false,"f