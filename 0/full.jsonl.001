({'role':name,'origin':origin,'tasks':{key:{'hash':row['hash'],'environmentVariables':row.get('environmentVariables')} for key,row in tasks.items()}})\nassert subprocess.check_output(['git','-C',str(T),'status','--porcelain'],text=True)==status\nsame={key:results[0]['tasks'][key]['hash']==results[1]['tasks'][key]['hash'] for key in results[0]['tasks']}\nif mode=='negative':assert all(same.values()),same\nelse:assert not any(same.values()),same\nout=A/(label+'-result.json');assert not out.exists();out.write_text(json.dumps({'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'mode':mode,'sameHashesAcrossDistinctPublicOrigins':same,'results':results,'toolOwner':str(V/'node_modules/.bin/turbo'),'configurationOwner':str(T),'actualCLI':True,'buildTasksExecuted':False,'qualification':'Installed Turbo used only as audit tooling; actual frozen213 workspace/config/inputs dry-run hash proof, not consumer installation/build or live deployment proof'},indent=2)+'\\n');print(json.dumps(same,indent=2))\n"}],"isError":false,"timestamp":1791347899459}}
