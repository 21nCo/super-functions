{"timestamp":"2026-09-19T12:17:15.562Z","ordinal":5231,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b3f5-d570-7a72-b668-401efd539e3b","turn_id":"01a0b992-9248-7613-95d3-df05acb573b9","item":{"type":"CommandExecution","id":"exec-94ae0f47-88e7-4fe5-b8f1-470ea9712278","process_id":"65364","command":["/bin/zsh","-lc","nl -ba mcpfn/testing/src/suite.ts | sed -n '360,680p'\nnl -ba mcpfn/testing/src/remote-target.ts | sed -n '1,330p'\nnl -ba mcpfn/testing/src/reports.ts | sed -n '1,130p'\nnl -ba mcpfn/inspector/src/index.ts | sed -n '210,275p'\nnl -ba mcpfn/testing/tests/suite.test.ts | sed -n '215,385p'\nnl -ba mcpfn/testing/tests/suite.test.ts | sed -n '480,550p'"],"cwd":"file:///Users/serro/Documents/dev/n/worktrees/superfunctions/PR-170","parsed_cmd":[{"type":"read","cmd":"nl -ba mcpfn/testing/src/suite.ts","name":"suite.ts","path":"mcpfn/testing/src/suite.ts"},{"type":"read","cmd":"nl -ba mcpfn/testing/src/remote-target.ts","name":"remote-target.ts","path":"mcpfn/testing/src/remote-target.ts"},{"type":"read","cmd":"nl -ba mcpfn/testing/src/reports.ts","name":"reports.ts","path":"mcpfn/testing/src/reports.ts"},{"type":"read","cmd":"nl -ba mcpfn/inspector/src/index.ts","name":"index.ts","path":"mcpfn/inspector/src/index.ts"},{"type":"read","cmd":"nl -ba mcpfn/testing/tests/suite.test.ts","name":"suite.test.ts","path":"mcpfn/testing/tests/suite.test.ts"}],"source":"unified_exec_startup","status":"completed","stdout":"   360\t  } catch {\n   361\t    return { ...fallback, failure: \"serialization\" };\n   362\t  }\n   363\t}\n   364\t\n   365\tasync function closeSuiteClient(client: McpFnTestClient | undefined): Promise<{\n   366\t  cleanupFailure?: McpFnReportFailure;\n   367\t  retainedCleanup?: () => Promise<void>;\n   368\t}> {\n   369\t  try {\n   370\t    await client?.close();\n   371\t    return {};\n   372\t  } catch (error) {\n   373\t    let retainedCleanup: (() => Promise<void>) | undefined;\n   374\t    if (error instanceof McpFnTestClientCleanupError) {\n   375\t      retainedCleanup = () => error.retryCleanup();\n   376\t    } else if (client) {\n   377\t      retainedCleanup = () => client.close();\n   378\t    }\n   379\t    const terminal = error instanceof McpFnTestClientCleanupError && error.cause !== undefined\n   380\t      ? error.cause\n   381\t      : error;\n   382\t    const phase = terminal && typeof terminal === \"object\" &&\n   383\t        (terminal as { phase?: unknown }).phase === \"token-revocation\"\n   384\t      ? \"token-revocation\"\n   385\t      : \"transport-close\";\n   386\t    return {\n   387\t      retainedCleanup,\n   388\t      cleanupFailure: normalizeMcpFnReportFailure({\n   389\t        name: \"CleanupError\",\n   390\t        message: \"Target cleanup failed\",\n   391\t        code: \"MCPFN_TARGET_CLEANUP_FAILED\",\n   392\t        phase,\n   393\t      }),\n   394\t    };\n   395\t  }\n   396\t}\n   397\t\n   398\tasync function runTargetSuite(options: RunMcpFnTargetSuiteOptions): Promise<McpFnTargetSuiteReport> {\n   399\t  const maxTimelineEvents = options.maxTimelineEvents ?? 500;\n   400\t  if (!Number.isInteger(maxTimelineEvents) || maxTimelineEvents < 1) {\n   401\t    throw new Error(\"maxTimelineEvents must be a positive integer\");\n   402\t  }\n   403\t  const maxReportBytes = options.maxReportBytes ?? 1_048_576;\n   404\t  validateReportCap(maxReportBytes);\n   405\t  const consumerDiagnostic = options.client?.diagnostics;\n   406\t  const diagnostics = new SuiteDiagnosticCollector(\n   407\t    maxTimelineEvents,\n   408\t    maxReportBytes,\n   409\t    options.target,\n   410\t    consumerDiagnostic,\n   411\t  );\n   412\t  let client: McpFnTestClient | undefined;\n   413\t  let manifestChecked = false;\n   414\t  let failure: McpFnReportFailure | undefined;\n   415\t  let execution: SuiteExecution = { results: [] };\n   416\t  try {\n   417\t    client = McpFnTestClient.createTarget(\n   418\t      options.target,\n   419\t      options.clientInfo ?? { name: \"mcpfn-suite\", version: \"0.0.1\" },\n   420\t      {\n   421\t        ...options.client,\n   422\t        diagnostics: event => diagnostics.record(client, event),\n   423\t      },\n   424\t    );\n   425\t    diagnostics.captureBaseline(client);\n   426\t    await client.session.connect();\n   427\t    ({ execution, manifestChecked } = await executeConnectedSuite(client, options));\n   428\t  } catch (error) {\n   429\t    failure = safeTargetFailure(options.target, error);\n   430\t  }\n   431\t  // Custom hooks may depend on credentials cleared by close. Capture every\n   432\t  // target-controlled report value while the session still owns that state.\n   433\t  const projection = projectSuiteArtifacts(options, client, execution);\n   434\t  execution = projection.execution;\n   435\t  const { cleanupFailure: closeFailure, retainedCleanup } = await closeSuiteClient(client);\n   436\t  diagnostics.captureUnobserved(client);\n   437\t  let cleanupFailure = closeFailure;\n   438\t  cleanupFailure ??= diagnostics.cleanupFailure;\n   439\t  failure ??= cleanupFailure;\n   440\t  const results = execution.results;\n   441\t  const failed = results.filter((result) => result.status === \"failed\").length;\n   442\t  const incomplete = results.filter((result) => result.status === \"incomplete\").length;\n   443\t  const droppedObservedEvents = results.reduce(\n   444\t    (total, result) => total + (result.droppedObservedEvents ?? 0),\n   445\t    0,\n   446\t  );\n   447\t  const redactionOmittedObservedEvents = results.reduce(\n   448\t    (total, result) => total + (result.redactionOmittedObservedEvents ?? 0),\n   449\t    0,\n   450\t  );\n   451\t  const overflowedObservedEvents = droppedObservedEvents - redactionOmittedObservedEvents;\n   452\t  const artifactIncomplete = Boolean(failure) || incomplete > 0 ||\n   453\t    diagnostics.dropped > 0 ||\n   454\t    droppedObservedEvents > 0;\n   455\t  const report: McpFnTargetSuiteReport = {\n   456\t    formatVersion: 1,\n   457\t    kind: \"mcpfn.target-suite-report\",\n   458\t    status: artifactIncomplete ? \"incomplete\" : \"complete\",\n   459\t    runtime: {\n   460\t      node: process.version,\n   461\t      scenarioFormatVersion: 1,\n   462\t      reportSchemaVersion: MCPFN_REPORT_SCHEMA_VERSION,\n   463\t      packages: { testing: MCPFN_TESTING_VERSION },\n   464\t    },\n   465\t    ok: failed === 0 && !artifactIncomplete,\n   466\t    target: projection.target,\n   467\t    server: execution.server,\n   468\t    capabilities: execution.capabilities,\n   469\t    manifestChecked,\n   470\t    ...(projection.manifestHash === undefined ? {} : { manifestHash: projection.manifestHash }),\n   471\t    total: results.length,\n   472\t    passed: results.length - failed - incomplete,\n   473\t    failed,\n   474\t    incomplete,\n   475\t    droppedResults: 0,\n   476\t    droppedObservedEvents,\n   477\t    ...(redactionOmittedObservedEvents > 0 ? { redactionOmittedObservedEvents } : {}),\n   478\t    ...(failure || diagnostics.dropped > 0 || droppedObservedEvents > 0\n   479\t      ? {\n   480\t        incompleteReason: [\n   481\t          ...(failure ? [`${failure.layer}: ${failure.message}`] : []),\n   482\t          ...(cleanupFailure ? [`Cleanup: ${cleanupFailure.message}`] : []),\n   483\t          ...(diagnostics.serializationFailed ? [\"Diagnostic timeline contained non-JSON data\"] : []),\n   484\t          ...(diagnostics.redactionFailed ? [\"Diagnostic timeline redaction failed; original events omitted\"] : []),\n   485\t          ...(diagnostics.countExceeded ? [\"Diagnostic timeline exceeded maxTimelineEvents\"] : []),\n   486\t          ...(diagnostics.bytesExceeded ? [\"Diagnostic timeline exceeded maxReportBytes\"] : []),\n   487\t          ...(redactionOmittedObservedEvents > 0\n   488\t            ? [\"Observed client events were omitted because credential redaction failed\"]\n   489\t            : []),\n   490\t          ...(overflowedObservedEvents > 0\n   491\t            ? [\"Observed client events exceeded maxObservedEvents\"]\n   492\t            : []),\n   493\t        ].join(\"; \"),\n   494\t      }\n   495\t      : {}),\n   496\t    ...(failure ? { failure } : {}),\n   497\t    timeline: diagnostics.timeline,\n   498\t    droppedTimelineEvents: diagnostics.dropped,\n   499\t    results,\n   500\t  };\n   501\t  let finalized: McpFnTargetSuiteReport;\n   502\t  try {\n   503\t    if (projection.failure) throw new Error(\"Report payload projection failed\");\n   504\t    // Custom redaction already completed before cleanup. Built-in report scopes\n   505\t    // remain active here for bounded final serialization.\n   506\t    finalized = enforceReportCap(redactTargetCredentials(options.target, report, { preserveKeys: true }), maxReportBytes);\n   507\t  } catch (error) {\n   508\t    if (error instanceof McpFnStructuralCredentialCollisionError) {\n   509\t      const failure = new McpFnClientError(\n   510\t        \"MCPFN_OPERATION_FAILED\",\n   511\t        \"Target report cannot be serialized because a credential conflicts with required artifact structure\",\n   512\t        { phase: \"capability-operation\" },\n   513\t      );\n   514\t      if (retainedCleanup) {\n   515\t        throw new McpFnTargetSuiteArtifactCleanupError(retainedCleanup, failure);\n   516\t      }\n   517\t      throw failure;\n   518\t    }\n   519\t    finalized = enforceReportCap({ ...report, ok: false, status: \"incomplete\",\n   520\t      incompleteReason: reportProjectionFailureReason(error, projection.failure),\n   521\t      target: { kind: \"custom\" }, server: undefined, capabilities: undefined, manifestHash: undefined,\n   522\t      failure: undefined, results: [], timeline: [],\n   523\t      droppedResults: report.results.length, droppedTimelineEvents: report.droppedTimelineEvents + report.timeline.length,\n   524\t    }, maxReportBytes);\n   525\t  }\n   526\t  if (retainedCleanup) throw new McpFnTargetSuiteCleanupError(finalized, retainedCleanup);\n   527\t  return finalized;\n   528\t}\n   529\t\n   530\tfunction enforceReportCap(\n   531\t  report: McpFnTargetSuiteReport,\n   532\t  maxBytes: number,\n   533\t): McpFnTargetSuiteReport {\n   534\t  validateReportCap(maxBytes);\n   535\t  const bounded = structuredClone(report);\n   536\t  if (jsonBytes(bounded) > maxBytes) {\n   537\t    bounded.ok = false;\n   538\t    bounded.status = \"incomplete\";\n   539\t    bounded.incompleteReason = \"Report content exceeded maxReportBytes and was truncated\";\n   540\t  }\n   541\t  while (jsonBytes(bounded) > maxBytes && bounded.results.length > 0) {\n   542\t    bounded.results.pop();\n   543\t    bounded.droppedResults += 1;\n   544\t  }\n   545\t  if (jsonBytes(bounded) > maxBytes) {\n   546\t    bounded.target = { kind: report.target.kind };\n   547\t    bounded.server = undefined;\n   548\t    bounded.capabilities = undefined;\n   549\t    bounded.timeline = [];\n   550\t    bounded.droppedTimelineEvents += report.timeline.length;\n   551\t    if (bounded.failure) {\n   552\t      bounded.failure.details = undefined;\n   553\t      bounded.failure.message = \"Target operation failed; details omitted to fit report budget\";\n   554\t    }\n   555\t  }\n   556\t  if (bounded.droppedResults > 0 || jsonBytes(bounded) > maxBytes) {\n   557\t    bounded.ok = false;\n   558\t    bounded.status = \"incomplete\";\n   559\t    bounded.incompleteReason = \"Report content exceeded maxReportBytes and was truncated\";\n   560\t  }\n   561\t  if (jsonBytes(bounded) > maxBytes) {\n   562\t    throw new Error(\"The minimum target suite report exceeds maxReportBytes\");\n   563\t  }\n   564\t  return bounded;\n   565\t}\n   566\t\n   567\tfunction validateReportCap(maxBytes: number): void {\n   568\t  if (!Number.isInteger(maxBytes) || maxBytes < 1_024) {\n   569\t    throw new Error(\"maxReportBytes must be an integer of at least 1024\");\n   570\t  }\n   571\t}\n   572\t\n   573\tfunction jsonBytes(value: unknown): number {\n   574\t  return new TextEncoder().encode(JSON.stringify(value)).byteLength;\n   575\t}\n     1\timport {\n     2\t  McpFnClientError,\n     3\t  customTarget,\n     4\t  streamableHttpTarget,\n     5\t  type McpFnStreamableHttpTargetOptions,\n     6\t  type McpFnTarget,\n     7\t  type McpFnTransportHandle,\n     8\t} from \"@mcpfn/client\";\n     9\t\n    10\timport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n    11\t\n    12\ttype SecretState = { active: Map<string, number>; scopes: Set<Set<string>> };\n    13\tconst targetSecrets = new WeakMap<McpFnTarget, SecretState>();\n    14\tconst utf8Encoder = new TextEncoder();\n    15\t\n    16\t/** Retain released credentials only for the lifetime of a report operation. */\n    17\texport function beginTargetCredentialRedaction(target: McpFnTarget): () => void {\n    18\t  const state = targetSecrets.get(target);\n    19\t  if (!state) return () => undefined;\n    20\t  const scope = new Set(state.active.keys());\n    21\t  state.scopes.add(scope);\n    22\t  return () => { state.scopes.delete(scope); scope.clear(); };\n    23\t}\n    24\t\n    25\tfunction credentialValues(headers: HeadersInit): Set<string> {\n    26\t  const values = boundedCredentialEntries(headers);\n    27\t  const secrets = new Set<string>();\n    28\t  for (const [header, raw] of values) {\n    29\t    if (!raw.trim()) continue;\n    30\t    secrets.add(raw);\n    31\t    secrets.add(raw.trim());\n    32\t    const normalizedHeader = header.toLowerCase();\n    33\t    if ([\"authorization\", \"proxy-authorization\"].includes(normalizedHeader)) {\n    34\t      addAuthorizationSecrets(raw, secrets);\n    35\t    }\n    36\t    if (normalizedHeader === \"cookie\") addCookieSecrets(raw, secrets);\n    37\t  }\n    38\t  return secrets;\n    39\t}\n    40\t\n    41\tfunction addAuthorizationSecrets(raw: string, secrets: Set<string>): void {\n    42\t  const trimmed = raw.trim();\n    43\t  const separator = trimmed.search(/\\s/);\n    44\t  if (separator <= 0) return;\n    45\t  const scheme = trimmed.slice(0, separator).toLowerCase();\n    46\t  const token = trimmed.slice(separator).trim();\n    47\t  if (token) secrets.add(token);\n    48\t  if (scheme !== \"basic\" || !/^[\\dA-Za-z+/]+={0,2}$/.test(token)) return;\n    49\t  const decoded = Buffer.from(token, \"base64\");\n    50\t  // Round-trip validation avoids interpreting malformed tokens as credentials.\n    51\t  if (decoded.toString(\"base64\").replace(/=+$/, \"\") !== token.replace(/=+$/, \"\")) return;\n    52\t  for (const encoding of [\"utf8\", \"latin1\"] as const) {\n    53\t    const pair = decoded.toString(encoding);\n    54\t    const colon = pair.indexOf(\":\");\n    55\t    if (colon < 0) continue;\n    56\t    for (const value of [pair, pair.slice(0, colon), pair.slice(colon + 1)]) {\n    57\t      if (value) secrets.add(value);\n    58\t    }\n    59\t  }\n    60\t}\n    61\t\n    62\tfunction addCookieSecrets(raw: string, secrets: Set<string>): void {\n    63\t  // Cookie values are independently reflectable even though the request\n    64\t  // authenticates with the complete header. RFC 6265 cookie values cannot\n    65\t  // contain comma or semicolon, so both delimiters cover combined entries.\n    66\t  for (const part of raw.split(/[;,]/)) {\n    67\t    const pair = part.trim();\n    68\t    if (!pair) continue;\n    69\t    const equals = pair.indexOf(\"=\");\n    70\t    if (equals < 1) {\n    71\t      throw new TypeError(\"Cookie credential headers must contain name=value pairs\");\n    72\t    }\n    73\t    const value = pair.slice(equals + 1).trim();\n    74\t    if (!value) continue;\n    75\t    secrets.add(value);\n    76\t    addUnquotedCookieSecret(value, secrets);\n    77\t  }\n    78\t}\n    79\t\n    80\tfunction addUnquotedCookieSecret(value: string, secrets: Set<string>): void {\n    81\t  if (!value.startsWith('\"') && !value.endsWith('\"')) return;\n    82\t  if (value.length < 2 || !value.startsWith('\"') || !value.endsWith('\"')) {\n    83\t    throw new TypeError(\"Cookie credential values must use balanced quotes\");\n    84\t  }\n    85\t  const unquoted = value.slice(1, -1);\n    86\t  if (unquoted.includes('\"') || unquoted.includes(\"\\\\\")) {\n    87\t    throw new TypeError(\"Cookie credential values must use RFC 6265 syntax\");\n    88\t  }\n    89\t  if (unquoted) secrets.add(unquoted);\n    90\t}\n    91\t\n    92\texport class McpFnRedactionLimitError extends Error {\n    93\t  constructor(message = \"Credential redaction exceeded its traversal budget\") { super(message); }\n    94\t}\n    95\t\n    96\t/** No typed artifact can preserve this authored key without exposing a credential. */\n    97\texport class McpFnStructuralCredentialCollisionError extends McpFnRedactionLimitError {\n    98\t  constructor() {\n    99\t    super(\"Credential collides with a required structural artifact key\");\n   100\t  }\n   101\t}\n   102\t\n   103\t// Only these locally authored envelope paths retain structural keys. Unknown\n   104\t// children (including inspector events and server metadata) are always payloads.\n   105\tconst envelopeKeys: Record<string, Set<string>> = Object.fromEntries(Object.entries({\n   106\t  root: \"formatVersion kind status runtime ok target server capabilities manifestChecked manifestHash total passed failed incomplete droppedResults droppedObservedEvents redactionOmittedObservedEvents incompleteReason failure timeline droppedTimelineEvents results count clientState tools resources resourceTemplates prompts droppedEvents timelineComplete droppedInventoryEntries inventoryComplete suiteVersion exitCode stdout stderr phase outcome code requestId at details payload\",\n   107\t  result: \"formatVersion name operation tool status sideEffect durationMs error droppedObservedEvents redactionOmittedObservedEvents\",\n   108\t  diagnostic: \"phase outcome code requestId at target details\",\n   109\t  inspectorEvent: \"formatVersion source kind at event\",\n   110\t  failure: \"name message layer code phase details\",\n   111\t  runtime: \"node scenarioFormatVersion reportSchemaVersion packages\",\n   112\t  packages: \"testing\",\n   113\t  droppedInventoryEntries: \"tools resources resourceTemplates prompts\",\n   114\t  target: \"kind\",\n   115\t}).map(([role, keys]) => [role, new Set(keys.split(\" \"))]));\n   116\t\n   117\tconst structuralArtifactValues = new Map<string, Set<string>>([\n   118\t  [\"root:kind\", new Set([\"logging.message\", \"progress\", \"tasks.status\", \"resources.updated\", \"tools.list_changed\", \"resources.list_changed\", \"prompts.list_changed\", \"resources.subscribed\", \"resources.unsubscribed\", \"client.roots\", \"client.sampling\", \"client.elicitation\", \"mcpfn.target-suite-report\", \"mcpfn.inspector-snapshot\", \"mcpfn.official-conformance-report\"])],\n   119\t  [\"inspectorEvent:kind\", new Set([\"logging.message\", \"progress\", \"tasks.status\", \"resources.updated\", \"tools.list_changed\", \"resources.list_changed\", \"prompts.list_changed\", \"resources.subscribed\", \"resources.unsubscribed\", \"client.roots\", \"client.sampling\", \"client.elicitation\"])],\n   120\t  [\"root:clientState\", new Set([\"idle\", \"connecting\", \"authorization-required\", \"connected\", \"closing\", \"closed\"])],\n   121\t  [\"target:kind\", new Set([\"authenticated-streamable-http\", \"streamable-http\", \"stdio\", \"in-memory\", \"custom\"])],\n   122\t  [\"root:status\", new Set([\"passed\", \"failed\", \"incomplete\", \"complete\"])],\n   123\t  [\"result:status\", new Set([\"passed\", \"failed\", \"incomplete\", \"complete\"])],\n   124\t  [\"root:outcome\", new Set([\"started\", \"succeeded\", \"failed\"])],\n   125\t  [\"diagnostic:outcome\", new Set([\"started\", \"succeeded\", \"failed\"])],\n   126\t  ...[\"root\", \"diagnostic\", \"failure\"].map(role => [\n   127\t    `${role}:phase`,\n   128\t    new Set([\"resource-discovery\", \"authorization-server-discovery\", \"client-registration\", \"authorization-request\", \"authorization-callback\", \"token-exchange\", \"token-refresh\", \"token-revocation\", \"transport-connect\", \"mcp-initialize\", \"capability-operation\", \"transport-close\"]),\n   129\t  ] as [string, Set<string>]),\n   130\t  [\"failure:layer\", new Set([\"mcpfn-preflight\", \"authorization-server\", \"resource-server\", \"mcp-initialization\", \"scenario\", \"upstream-conformance\"])],\n   131\t  [\"inspectorEvent:source\", new Set([\"diagnostic\", \"client\"])],\n   132\t  [\"result:sideEffect\", new Set([\"none\", \"idempotent\", \"non-idempotent\"])],\n   133\t]);\n   134\t\n   135\tconst unrestrictedStructuralValueFields = new Set([\n   136\t  \"packages:testing\",\n   137\t  \"runtime:node\",\n   138\t  \"runtime:reportSchemaVersion\",\n   139\t  \"root:suiteVersion\",\n   140\t]);\n   141\t\n   142\tfunction specialValue(input: unknown): unknown {\n   143\t  if (input instanceof Error) return normalizeErrorValue(input);\n   144\t  if (input instanceof Date) return Number.isNaN(input.getTime()) ? \"Invalid Date\" : input.toISOString();\n   145\t  if (input instanceof URL) return input.href;\n   146\t  if (input instanceof Map) {\n   147\t    if (Object.getOwnPropertyDescriptor(Map.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   148\t    return { type: \"Map\", entries: [...Map.prototype.entries.call(input)] };\n   149\t  }\n   150\t  if (input instanceof Set) {\n   151\t    if (Object.getOwnPropertyDescriptor(Set.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   152\t    return { type: \"Set\", values: [...Set.prototype.values.call(input)] };\n   153\t  }\n   154\t  return input;\n   155\t}\n   156\t\n   157\tfunction normalizeErrorValue(input: Error): Record<string, unknown> {\n   158\t  // Error instances may expose attacker-controlled enumerable keys. A\n   159\t  // null-prototype accumulator keeps `__proto__` as ordinary payload data.\n   160\t  const normalized = Object.create(null) as Record<string, unknown>;\n   161\t  let enumerableFields = 0;\n   162\t  for (const key in input) {\n   163\t    if (!Object.hasOwn(input, key)) continue;\n   164\t    if (++enumerableFields > 100_000) throw new McpFnRedactionLimitError();\n   165\t    normalized[key] = (input as unknown as Record<string, unknown>)[key];\n   166\t  }\n   167\t  normalized.name = input.name;\n   168\t  normalized.message = input.message;\n   169\t  normalized.stack = input.stack;\n   170\t  if (input.cause !== undefined) normalized.cause = input.cause;\n   171\t  return normalized;\n   172\t}\n   173\t\n   174\tfunction scrubCredentials<T>(value: T, values: Iterable<string>, preserveKeys = false, redactionMarker?: string): T {\n   175\t  // Preserve whether a pattern came from opaque text or a serializer. Literal\n   176\t  // percent sequences in credentials must not acquire URL hex-case semantics.\n   177\t  const variants = [...values].filter(Boolean).flatMap(secret => [\n   178\t    { value: secret, encoded: false },\n   179\t    { value: JSON.stringify(secret).slice(1, -1), encoded: false },\n   180\t    { value: encodeURIComponent(secret), encoded: true },\n   181\t    { value: new URLSearchParams({ value: secret }).toString().slice(\"value=\".length), encoded: true },\n   182\t  ]).sort((a, b) => b.value.length - a.value.length);\n   183\t  let entries = 0, stringBytes = 0;\n   184\t  const budget = (input: unknown, depth = 0): void => {\n   185\t    input = specialValue(input);\n   186\t    if ((Array.isArray(input) && input.length > 100_000) || ++entries > 100_000 || depth > 32) throw new McpFnRedactionLimitError();\n   187\t    if (typeof input === \"string\") {\n   188\t      stringBytes += Buffer.byteLength(input);\n   189\t      if (input.length > 262_144 || stringBytes > 2_097_152) throw new McpFnRedactionLimitError();\n   190\t    } else if (input && typeof input === \"object\") {\n   191\t      for (const key in input) if (Object.hasOwn(input, key)) {\n   192\t        budget(key, depth + 1);\n   193\t        budget((input as Record<string, unknown>)[key], depth + 1);\n   194\t      }\n   195\t    }\n   196\t  };\n   197\t  // Check before either redactor allocates copies. Exceeding a budget is an\n   198\t  // explicit failure, never silent truncation of a typed report collection.\n   199\t  budget(value);\n   200\t  const patterns = variants.map(({ value, encoded }) => {\n   201\t    const literal = value.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n   202\t    // Only generated percent escapes accept mixed-case hex digits.\n   203\t    return encoded\n   204\t      ? literal.replace(/%[\\dA-Fa-f]{2}/g, escape => escape.replace(/[A-Fa-f]/g, hex => `[${hex.toLowerCase()}${hex.toUpperCase()}]`))\n   205\t      : literal;\n   206\t  });\n   207\t  const secretPattern = patterns.length ? new RegExp(patterns.join(\"|\"), \"g\") : undefined;\n   208\t  const replacementPattern = patterns.length ? new RegExp(patterns.join(\"|\")) : undefined;\n   209\t  const preserveStructural = (input: string): string => {\n   210\t    if (replacementPattern?.test(input)) {\n   211\t      throw new McpFnRedactionLimitError(\n   212\t        \"Credential collides with a required structural artifact field\",\n   213\t      );\n   214\t    }\n   215\t    return input;\n   216\t  };\n   217\t  const preserveStructuralKey = (input: string): string => {\n   218\t    if (replacementPattern?.test(input)) {\n   219\t      throw new McpFnStructuralCredentialCollisionError();\n   220\t    }\n   221\t    return input;\n   222\t  };\n   223\t  // A requested marker is itself output and must not reproduce a credential.\n   224\t  if (secretPattern) {\n   225\t    const markerContainsSecret = secretPattern.test(redactionMarker ?? \"[REDACTED]\");\n   226\t    secretPattern.lastIndex = 0;\n   227\t    if (markerContainsSecret) redactionMarker = \"\";\n   228\t  }\n   229\t  const scrubString = (input: string, role: string, field: string, finalPass: boolean): string => {\n   230\t    const structuralField = `${role}:${field}`;\n   231\t    if (unrestrictedStructuralValueFields.has(structuralField) ||\n   232\t        structuralArtifactValues.get(structuralField)?.has(input)) {\n   233\t      return preserveStructural(input);\n   234\t    }\n   235\t    // Whole-string rejection cannot compose another credential by joining pieces.\n   236\t    // Run after both redactors; never feed this result through another redactor.\n   237\t    if (finalPass) return replacementPattern?.test(input) ? \"\" : input;\n   238\t    if (!secretPattern) return input;\n   239\t    return input.replace(secretPattern, secret => {\n   240\t      const maskCharacter = secret.includes(\"*\") ? \"#\" : \"*\";\n   241\t      const defaultReplacement = secret.length < 10\n   242\t        ? maskCharacter.repeat(secret.length)\n   243\t        : \"[REDACTED]\";\n   244\t      const replacement = redactionMarker ?? defaultReplacement;\n   245\t      // Every generated mask must be safe against the entire credential set.\n   246\t      return replacementPattern!.test(replacement) ? \"\" : replacement;\n   247\t    });\n   248\t  };\n   249\t  const scrub = (input: unknown, role = \"payload\", field = \"\", finalPass = false): unknown => {\n   250\t    input = specialValue(input);\n   251\t    if (typeof input === \"string\") return scrubString(input, role, field, finalPass);\n   252\t    if (Array.isArray(input)) {\n   253\t      const result = input.map(entry => scrub(entry, role, \"\", finalPass));\n   254\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   255\t      return result;\n   256\t    }\n   257\t    if (input && typeof input === \"object\") {\n   258\t      const entries: Array<[string, unknown]> = [];\n   259\t      const keys = new Set<string>();\n   260\t      for (const [key, entry] of Object.entries(input)) {\n   261\t        const fixed = envelopeKeys[role]?.has(key) ?? false;\n   262\t        if (fixed) preserveStructuralKey(key);\n   263\t        let childRole = \"payload\";\n   264\t        if (fixed) {\n   265\t          if (key === \"results\") childRole = \"result\";\n   266\t          else if (key === \"timeline\") childRole = (value as any)?.kind === \"mcpfn.inspector-snapshot\" ? \"inspectorEvent\" : \"diagnostic\";\n   267\t          else if ([\"failure\", \"runtime\", \"packages\", \"droppedInventoryEntries\", \"target\"].includes(key)) childRole = key;\n   268\t          else if (role === \"inspectorEvent\" && key === \"event\") childRole = (input as { source?: string }).source === \"client\" ? \"root\" : \"diagnostic\";\n   269\t        }\n   270\t        const scrubbedKey = fixed ? key : scrub(key, \"payload\", \"\", finalPass) as string;\n   271\t        if (keys.has(scrubbedKey)) {\n   272\t          throw new McpFnRedactionLimitError(\n   273\t            \"Credential redaction created duplicate object keys\",\n   274\t          );\n   275\t        }\n   276\t        keys.add(scrubbedKey);\n   277\t        const scrubbedEntry = typeof entry === \"string\"\n   278\t          ? scrub(entry, fixed ? role : \"payload\", key, finalPass)\n   279\t          : scrub(entry, childRole, \"\", finalPass);\n   280\t        entries.push([scrubbedKey, scrubbedEntry]);\n   281\t      }\n   282\t      const result = Object.fromEntries(entries);\n   283\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   284\t      return result;\n   285\t    }\n   286\t    return input;\n   287\t  };\n   288\t  const timelineEvent = value && typeof value === \"object\" && [\"client\", \"diagnostic\"].includes((value as { source?: string }).source ?? \"\");\n   289\t  let role = \"payload\";\n   290\t  if (preserveKeys) role = timelineEvent ? \"inspectorEvent\" : \"root\";\n   291\t  const scrubbed = scrub(value, role);\n   292\t  const generic = redactOAuthValue(scrubbed, { maxStringLength: 262_144, maxDepth: 64, maxArrayEntries: 100_000, maxObjectEntries: 100_000, ...(redactionMarker !== undefined ? { redactionMarker } : {}) });\n   293\t  const result = scrub(generic, role, \"\", true) as T;\n   294\t  assertPayloadSerialization(\n   295\t    result,\n   296\t    \"payload\",\n   297\t    true,\n   298\t    replacementPattern,\n   299\t  );\n   300\t  return result;\n   301\t}\n   302\t\n   303\tfunction assertPayloadSerialization(\n   304\t  value: unknown,\n   305\t  role: string,\n   306\t  finalPass: boolean,\n   307\t  credentialPattern: RegExp | undefined,\n   308\t): void {\n   309\t  if (!finalPass || role !== \"payload\" || !credentialPattern) return;\n   310\t  const serialized = JSON.stringify(value);\n   311\t  if (serialized !== undefined && credentialPattern.test(serialized)) {\n   312\t    throw new McpFnRedactionLimitError(\n   313\t      \"Credential redaction could not guarantee safe serialized output\",\n   314\t    );\n   315\t  }\n   316\t}\n   317\t\n   318\t/** Remove known opaque credential values as well as credential-shaped fields. */\n   319\texport function redactTargetCredentials<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean; redactionMarker?: string } = {}): T {\n   320\t  const state = targetSecrets.get(target);\n   321\t  return scrubCredentials(value, new Set([...(state?.active.keys() ?? []), ...[...(state?.scopes ?? [])].flatMap((scope) => [...scope])]), options.preserveKeys, options.redactionMarker);\n   322\t}\n   323\t\n   324\t/** Redact authenticated conformance output using the acquired credential. */\n   325\texport function redactRemoteCredential<T>(credential: McpFnRemoteCredential, value: T, options: { preserveKeys?: boolean } = {}): T {\n   326\t  return scrubCredentials(value, credentialValues(credential.headers), options.preserveKeys);\n   327\t}\n   328\t\n   329\tconst MAX_CREDENTIAL_HEADERS = 32;\n   330\tconst MAX_CREDENTIAL_HEADER_BYTES = 16_384;\n     1\timport type { McpFnDiagnosticPhase } from \"@mcpfn/client\";\n     2\timport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n     3\t\n     4\timport type { McpFnTargetSuiteReport } from \"./suite.js\";\n     5\t\n     6\tdeclare const __MCPFN_TESTING_VERSION__: string;\n     7\t\n     8\texport const MCPFN_TESTING_VERSION = __MCPFN_TESTING_VERSION__;\n     9\texport const MCPFN_REPORT_SCHEMA_VERSION = \"1.0.0\";\n    10\t\n    11\texport type McpFnFailureLayer =\n    12\t  | \"mcpfn-preflight\"\n    13\t  | \"authorization-server\"\n    14\t  | \"resource-server\"\n    15\t  | \"mcp-initialization\"\n    16\t  | \"scenario\"\n    17\t  | \"upstream-conformance\";\n    18\t\n    19\texport interface McpFnReportFailure {\n    20\t  name: string;\n    21\t  message: string;\n    22\t  layer: McpFnFailureLayer;\n    23\t  code?: string;\n    24\t  phase?: string;\n    25\t  details?: Record<string, unknown>;\n    26\t}\n    27\t\n    28\texport interface McpFnJunitOptions {\n    29\t  /** Aggregate XML size cap after serialization. Defaults to 1 MiB. */\n    30\t  maxBytes?: number;\n    31\t}\n    32\t\n    33\texport function normalizeMcpFnReportFailure(\n    34\t  error: unknown,\n    35\t  fallbackPhase?: McpFnDiagnosticPhase | \"scenario\" | \"upstream-conformance\",\n    36\t): McpFnReportFailure {\n    37\t  const redacted = redactOAuthValue(error, {\n    38\t    maxDepth: 6,\n    39\t    maxArrayEntries: 50,\n    40\t    maxObjectEntries: 50,\n    41\t    maxStringLength: 2_048,\n    42\t  });\n    43\t  const record = redacted && typeof redacted === \"object\" && !Array.isArray(redacted)\n    44\t    ? redacted as Record<string, unknown>\n    45\t    : {};\n    46\t  const phase = stringField(record.phase) ?? fallbackPhase;\n    47\t  const details = record.details && typeof record.details === \"object\" &&\n    48\t      !Array.isArray(record.details)\n    49\t    ? record.details as Record<string, unknown>\n    50\t    : undefined;\n    51\t  let message = stringField(record.message) ?? String(\n    52\t    redactOAuthValue(error instanceof Error ? error.message : String(error)),\n    53\t  );\n    54\t  const cause = error && typeof error === \"object\"\n    55\t    ? (error as { cause?: unknown }).cause\n    56\t    : undefined;\n    57\t  const redactedCause = cause === undefined\n    58\t    ? undefined\n    59\t    : redactOAuthValue(cause, {\n    60\t      maxDepth: 4,\n    61\t      maxArrayEntries: 20,\n    62\t      maxObjectEntries: 20,\n    63\t      maxStringLength: 1_024,\n    64\t    });\n    65\t  const causeRecord = redactedCause && typeof redactedCause === \"object\" &&\n    66\t      !Array.isArray(redactedCause)\n    67\t    ? redactedCause as Record<string, unknown>\n    68\t    : undefined;\n    69\t  const causeMessage = stringField(causeRecord?.message);\n    70\t  if (causeMessage && !message.includes(causeMessage)) message = `${message}: ${causeMessage}`;\n    71\t  const combinedDetails = causeRecord ? { ...details, cause: causeRecord } : details;\n    72\t  const layer = failureLayer(phase);\n    73\t  const deniedByResource = layer !== \"authorization-server\" &&\n    74\t    [causeRecord?.code, causeRecord?.status, record.code, record.status]\n    75\t      .some(value => [401, 403].includes(Number(value)));\n    76\t  return {\n    77\t    name: stringField(record.name) ?? \"Error\",\n    78\t    message,\n    79\t    layer: deniedByResource ? \"resource-server\" : layer,\n    80\t    ...(stringField(record.code) ? { code: stringField(record.code)! } : {}),\n    81\t    ...(phase ? { phase } : {}),\n    82\t    ...(combinedDetails ? { details: combinedDetails } : {}),\n    83\t  };\n    84\t}\n    85\t\n    86\t/** Serialize a redacted target-suite report as bounded JUnit XML. */\n    87\texport function createMcpFnTargetSuiteJUnit(\n    88\t  report: McpFnTargetSuiteReport,\n    89\t  options: McpFnJunitOptions = {},\n    90\t): string {\n    91\t  const maxBytes = options.maxBytes ?? 1_048_576;\n    92\t  validateArtifactCap(maxBytes);\n    93\t  const safe = redactOAuthValue(report, {\n    94\t    maxDepth: 10,\n    95\t    maxArrayEntries: 1_000,\n    96\t    maxObjectEntries: 200,\n    97\t    maxStringLength: 4_096,\n    98\t  }) as unknown as McpFnTargetSuiteReport;\n    99\t  // Redaction appends a string sentinel when an array exceeds its cap.\n   100\t  const results = safe.results.filter((result) => result && typeof result === \"object\" && typeof result.name === \"string\");\n   101\t  const omitted = report.results.length - results.length;\n   102\t  const cases = results.map((result) => {\n   103\t    const duration = Math.max(0, result.durationMs ?? 0) / 1_000;\n   104\t    let failure = \"\";\n   105\t    if (result.status !== \"passed\") {\n   106\t      const failureType = result.status === \"failed\" ? \"scenario\" : \"incomplete\";\n   107\t      failure = junitFailure(result.error ?? `Scenario ${result.status}`, failureType);\n   108\t    }\n   109\t    return `    <testcase name=\"${xml(result.name)}\" classname=\"mcpfn.scenario\" time=\"${duration.toFixed(3)}\">${failure}</testcase>`;\n   110\t  });\n   111\t  if (safe.failure) {\n   112\t    cases.unshift(\n   113\t      `    <testcase name=\"${xml(safe.failure.phase ?? \"target\")}\" classname=\"mcpfn.${xml(safe.failure.layer)}\" time=\"0.000\">${junitFailure(safe.failure.message, safe.failure.code ?? safe.failure.layer)}</testcase>`,\n   114\t    );\n   115\t  }\n   116\t  if (safe.status === \"incomplete\" || omitted > 0 || (!safe.ok && !safe.failure && results.every((result) => result.status === \"passed\"))) {\n   117\t    cases.push(`    <testcase name=\"suite-incomplete\" classname=\"mcpfn.report\" time=\"0.000\">${junitFailure(safe.incompleteReason ?? \"Suite evidence is incomplete or omitted\", \"incomplete\")}</testcase>`);\n   118\t  }\n   119\t  if (cases.length === 0) {\n   120\t    cases.push(\n   121\t      '    <testcase name=\"target-suite\" classname=\"mcpfn.target\" time=\"0.000\"></testcase>',\n   122\t    );\n   123\t  }\n   124\t  const failures = cases.filter((entry) => entry.includes(\"<failure \")).length;\n   125\t  let serialized = junitDocument(safe, cases, failures);\n   126\t  if (bytes(serialized) <= maxBytes) return serialized;\n   127\t\n   128\t  const boundedCases = [\n   129\t    `    <testcase name=\"artifact-cap\" classname=\"mcpfn.report\" time=\"0.000\">${junitFailure(\"JUnit content exceeded maxBytes and was truncated\", \"incomplete\")}</testcase>`,\n   130\t  ];\n   210\t  async run(operation: McpFnInspectorOperation): Promise<McpFnInspectorOperationResult> {\n   211\t    if (operation.kind === \"tools.call\") {\n   212\t      return this.client.tools.call(operation.name, operation.arguments);\n   213\t    }\n   214\t    if (operation.kind === \"tools.call:task\") {\n   215\t      return this.client.tools.createTask(operation.name, operation.arguments, operation.task);\n   216\t    }\n   217\t    if (operation.kind === \"resources.read\") {\n   218\t      return this.client.resources.read(operation.uri);\n   219\t    }\n   220\t    if (operation.kind === \"resources.subscribe\") {\n   221\t      return this.client.resources.subscribe(operation.uri);\n   222\t    }\n   223\t    if (operation.kind === \"resources.unsubscribe\") {\n   224\t      return this.client.resources.unsubscribe(operation.uri);\n   225\t    }\n   226\t    if (operation.kind === \"prompts.get\") {\n   227\t      return this.client.prompts.get(operation.name, operation.arguments);\n   228\t    }\n   229\t    if (operation.kind === \"tasks.get\") return this.client.tasks.get(operation.taskId);\n   230\t    if (operation.kind === \"tasks.result\") return this.client.tasks.result(operation.taskId);\n   231\t    if (operation.kind === \"tasks.cancel\") return this.client.tasks.cancel(operation.taskId);\n   232\t    return this.client.tasks.list(operation.cursor);\n   233\t  }\n   234\t\n   235\t  exportScenario(\n   236\t    name: string,\n   237\t    operation: McpFnInspectorOperation,\n   238\t    result: McpFnInspectorOperationResult,\n   239\t  ): McpFnExportedScenario {\n   240\t    const scenario = createMcpFnScenario(name, operation, result);\n   241\t    // Top-level scenario keys are authored schema, not payload. If a credential\n   242\t    // collides with one of them, no replayable typed artifact can be emitted.\n   243\t    for (const key of [\n   244\t      ...Object.keys(scenario),\n   245\t      \"status\",\n   246\t      \"incompleteReason\",\n   247\t      \"variables\",\n   248\t    ]) {\n   249\t      this.client.preserveArtifactStructure(key);\n   250\t    }\n   251\t    const { formatVersion, kind, sideEffect, ...payload } = scenario;\n   252\t    if (kind === undefined || sideEffect === undefined) {\n   253\t      throw new Error(\"Inspector scenario export requires normalized structure\");\n   254\t    }\n   255\t    const safeKind = this.client.preserveArtifactStructure(kind);\n   256\t    const safeSideEffect = this.client.preserveArtifactStructure(sideEffect);\n   257\t    const secretMarker = selectScenarioSecretMarker(this.client);\n   258\t    let redacted: Record<string, unknown>;\n   259\t    try {\n   260\t      redacted = {\n   261\t        ...Object.fromEntries(Object.entries(payload).map(([key, value]) => [key, this.client.redact(value, {\n   262\t          ...SCENARIO_REDACTION_LIMITS,\n   263\t          // These are user payloads, even when their keys resemble an envelope.\n   264\t          preserveKeys: false,\n   265\t          redactionMarker: secretMarker ?? \"\",\n   266\t        })])),\n   267\t        formatVersion, kind: safeKind, sideEffect: safeSideEffect,\n   268\t      };\n   269\t    } catch {\n   270\t      return {\n   271\t        formatVersion,\n   272\t        kind: safeKind,\n   273\t        sideEffect: safeSideEffect,\n   274\t        name: \"\",\n   275\t        status: this.client.preserveArtifactStructure(\"incomplete\"),\n   215\t    kind: \"failed-open\", open: async () => { throw new Error(\"cannot open\"); }, cleanup,\n   216\t  }) });\n   217\t  expect(report.ok).toBe(false);\n   218\t  expect(cleanup).toHaveBeenCalledOnce();\n   219\t  expect(report.incompleteReason).not.toContain(\"Target cleanup failed\");\n   220\t});\n   221\t\n   222\t\n   223\tit.each([\"metadata\", \"failure\", \"throwing-redactor\"])(\"applies custom target redaction to finalized suite %s\", async mode => {\n   224\t  const secret = \"custom-owned-secret\";\n   225\t  const server = createMcpFnServer({\n   226\t    info: { name: secret, version: \"1.0.0\" },\n   227\t    registry: new McpFnRegistry().register({\n   228\t      name: \"visible-tool\", description: \"Fixture tool\", inputSchema: { type: \"object\" },\n   229\t      handler: async () => structuredResult({ ok: true }),\n   230\t    }),\n   231\t  });\n   232\t  const target = customTarget({\n   233\t    kind: \"custom\",\n   234\t    descriptor: { label: secret },\n   235\t    redact: <T>(value: T): T => {\n   236\t      if (mode === \"throwing-redactor\") throw new Error(secret);\n   237\t      const plain = value instanceof Error ? { name: value.name, message: value.message } : value;\n   238\t      return JSON.parse(JSON.stringify(plain).replaceAll(secret, \"[REDACTED]\")) as T;\n   239\t    },\n   240\t    open: async () => {\n   241\t      const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();\n   242\t      await server.connect(serverTransport);\n   243\t      return { transport: clientTransport, close: () => server.close() };\n   244\t    },\n   245\t  });\n   246\t  const report = await runMcpFnTargetSuite({\n   247\t    target,\n   248\t    ...(mode === \"failure\" ? { expectedToolNames: [secret] } : {}),\n   249\t  });\n   250\t  expect(JSON.stringify(report)).not.toContain(secret);\n   251\t  if (mode === \"metadata\") {\n   252\t    expect(report.ok).toBe(true);\n   253\t    expect(report.server?.name).toBe(\"[REDACTED]\");\n   254\t    expect(report.target.label).toBe(\"[REDACTED]\");\n   255\t  } else if (mode === \"failure\") {\n   256\t    expect(report.ok).toBe(false);\n   257\t    expect(report.failure?.message).toContain(\"[REDACTED]\");\n   258\t  } else {\n   259\t    expect(report.status).toBe(\"incomplete\");\n   260\t    expect(report.server).toBeUndefined();\n   261\t    expect(report.timeline).toEqual([]);\n   262\t  }\n   263\t});\n   264\t\n   265\tit(\"fails a custom target report closed when its dynamic kind conflicts with redaction\", async () => {\n   266\t  const secretKind = \"custom-kind-owned-secret\";\n   267\t  const server = createMcpFnServer({\n   268\t    info: { name: \"kind-collision\", version: \"1.0.0\" },\n   269\t    registry: new McpFnRegistry(),\n   270\t  });\n   271\t  const target = customTarget({\n   272\t    kind: secretKind,\n   273\t    redact: <T>(value: T): T => JSON.parse(\n   274\t      JSON.stringify(value).replaceAll(secretKind, \"[REDACTED]\"),\n   275\t    ) as T,\n   276\t    open: async () => {\n   277\t      const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();\n   278\t      await server.connect(serverTransport);\n   279\t      return { transport: clientTransport, close: () => server.close() };\n   280\t    },\n   281\t  });\n   282\t\n   283\t  const report = await runMcpFnTargetSuite({ target });\n   284\t\n   285\t  expect(report).toMatchObject({\n   286\t    ok: false,\n   287\t    status: \"incomplete\",\n   288\t    target: { kind: \"custom\" },\n   289\t  });\n   290\t  expect(report.incompleteReason).toContain(\"Credential redaction\");\n   291\t  expect(JSON.stringify(report)).not.toContain(secretKind);\n   292\t});\n   293\t\n   294\t\n   295\tit(\"transfers failed shutdown ownership and serializes safe cleanup retries\", async () => {\n   296\t  const secret = \"private-cleanup-secret\";\n   297\t  const server = createMcpFnServer({ info: { name: \"cleanup\", version: \"1\" }, registry: new McpFnRegistry() });\n   298\t  let fail = true;\n   299\t  const close = vi.fn(async () => { if (fail) throw new Error(secret); await server.close(); });\n   300\t  const target = customTarget({ kind: \"custom\", open: async () => {\n   301\t    const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();\n   302\t    await server.connect(serverTransport);\n   303\t    return { transport: clientTransport, close };\n   304\t  } });\n   305\t  const error = await runMcpFnTargetSuite({ target }).catch(error => error);\n   306\t  expect(error).toBeInstanceOf(McpFnTargetSuiteCleanupError);\n   307\t  expect(error.report.ok).toBe(false);\n   308\t  expect(error.message).not.toContain(secret);\n   309\t  expect(JSON.stringify(error.report)).not.toContain(secret);\n   310\t  const first = error.retryCleanup();\n   311\t  expect(error.retryCleanup()).toBe(first);\n   312\t  await expect(first).rejects.toBe(error);\n   313\t  fail = false;\n   314\t  await Promise.all([error.retryCleanup(), error.retryCleanup()]);\n   315\t  const calls = close.mock.calls.length;\n   316\t  await error.retryCleanup();\n   317\t  expect(close).toHaveBeenCalledTimes(calls);\n   318\t  expect(error.report.ok).toBe(false); // Immutable historical failure evidence.\n   319\t});\n   320\t\n   321\tit.each([\"complete\", \"passed\"])(\"keeps suite structure when a custom secret is %s\", async secret => {\n   322\t  const server = createMcpFnServer({ info: { name: secret, version: \"1\" }, registry: new McpFnRegistry() });\n   323\t  const report = await runMcpFnTargetSuite({ target: customTarget({ kind: \"custom\", descriptor: { label: secret },\n   324\t    redact: <T>(value: T): T => JSON.parse(JSON.stringify(value).replaceAll(secret, \"[REDACTED]\")),\n   325\t    open: async () => {\n   326\t      const [client, remote] = InMemoryTransport.createLinkedPair();\n   327\t      await server.connect(remote);\n   328\t      return { transport: client, close: () => server.close() };\n   329\t    },\n   330\t  }) });\n   331\t  expect(report.status).toBe(\"complete\");\n   332\t  expect(report.kind).toBe(\"mcpfn.target-suite-report\");\n   333\t  expect(report.passed).toBe(0);\n   334\t  expect(report.server?.name).toBe(\"[REDACTED]\");\n   335\t  expect(report.target.label).toBe(\"[REDACTED]\");\n   336\t});\n   337\t\n   338\tit(\"uses payload redaction for standalone suite projections\", async () => {\n   339\t  const secret = \"passed\";\n   340\t  const server = createMcpFnServer({\n   341\t    info: { name: secret, version: \"1\" },\n   342\t    registry: new McpFnRegistry().register({\n   343\t      name: secret,\n   344\t      description: \"Fixture tool\",\n   345\t      inputSchema: { type: \"object\" },\n   346\t      handler: async () => structuredResult({ ok: true }),\n   347\t    }),\n   348\t  });\n   349\t  const modes: Array<boolean | undefined> = [];\n   350\t  const report = await runMcpFnTargetSuite({\n   351\t    target: customTarget({\n   352\t      kind: \"custom\",\n   353\t      descriptor: { label: secret },\n   354\t      redact: <T>(value: T, options?: { preserveKeys?: boolean }): T => {\n   355\t        modes.push(options?.preserveKeys);\n   356\t        if (options?.preserveKeys !== false) return value;\n   357\t        return JSON.parse(JSON.stringify(value).replaceAll(secret, \"[REDACTED]\")) as T;\n   358\t      },\n   359\t      open: async () => {\n   360\t        const [client, remote] = InMemoryTransport.createLinkedPair();\n   361\t        await server.connect(remote);\n   362\t        return { transport: client, close: () => server.close() };\n   363\t      },\n   364\t    }),\n   365\t    scenarios: [{ name: secret, tool: secret }],\n   366\t  });\n   367\t\n   368\t  expect(modes).toContain(false);\n   369\t  expect(report.status).toBe(\"complete\");\n   370\t  expect(report.results[0]).toMatchObject({\n   371\t    status: \"passed\",\n   372\t    name: \"[REDACTED]\",\n   373\t    tool: \"[REDACTED]\",\n   374\t  });\n   375\t  expect(report.server?.name).toBe(\"[REDACTED]\");\n   376\t  expect(report.target.label).toBe(\"[REDACTED]\");\n   377\t});\n   378\t\n   379\tit(\"delivers diagnostics after exactly one custom redaction and bounds their retained bytes\", async () => {\n   380\t  const server = createMcpFnServer({ info: { name: \"diagnostics\", version: \"1\" }, registry: new McpFnRegistry() });\n   381\t  const observed: unknown[] = [];\n   382\t  let redactionCalls = 0;\n   383\t  const report = await runMcpFnTargetSuite({ maxReportBytes: 1024,\n   384\t    client: { diagnostics: event => { observed.push(event); } },\n   385\t    target: customTarget({ kind: \"custom\", redact: <T>(value: T): T => {\n   480\t  const persisted = JSON.parse(JSON.stringify(report));\n   481\t  const expected = amount instanceof Map\n   482\t    ? { type: \"Map\", entries: [[\"key\", \"evidence\"]] }\n   483\t    : { type: \"Set\", values: [\"evidence\"] };\n   484\t  expect(persisted.timeline.find((event: { details?: { amount?: unknown } }) =>\n   485\t    event.details?.amount !== undefined,\n   486\t  )?.details.amount).toEqual(expected);\n   487\t  expect(() => JSON.stringify(report)).not.toThrow();\n   488\t});\n   489\t\n   490\t\n   491\tit.each([\"stdio\", \"streamable-http\", \"authenticated-streamable-http\"])(\"preserves %s connection failure with an unchecked manifest\", async kind => {\n   492\t  const server = createMcpFnServer({ info: { name: \"manifest\", version: \"1\" }, registry: new McpFnRegistry() });\n   493\t  const report = await runMcpFnTargetSuite({ manifest: server.manifest(), target: customTarget({ kind,\n   494\t    open: async () => { throw new Error(\"Connection refused\"); },\n   495\t  }) });\n   496\t  expect(report.target.kind).toBe(kind);\n   497\t  expect(report.manifestChecked).toBe(false);\n   498\t  expect(report.manifestHash).toBeUndefined();\n   499\t  expect(report.failure?.phase).toBe(\"transport-connect\");\n   500\t  expect(report.incompleteReason).not.toContain(\"serialization\");\n   501\t  expect(report.ok).toBe(false);\n   502\t});\n   503\t\n   504\tit.each([\"throw\", \"proxy\"])(\"fails closed for a hostile live descriptor (%s)\", async mode => {\n   505\t  const secret = \"hostile-live-descriptor-secret\";\n   506\t  const server = createMcpFnServer({ info: { name: \"fixture\", version: \"1\" }, registry: new McpFnRegistry() });\n   507\t  const close = vi.fn(() => server.close());\n   508\t  const target = customTarget({ kind: \"custom\", open: async () => {\n   509\t    const [client, remote] = InMemoryTransport.createLinkedPair();\n   510\t    await server.connect(remote);\n   511\t    return { transport: client, close };\n   512\t  } });\n   513\t  target.describe = () => {\n   514\t    if (mode === \"throw\") throw new Error(secret);\n   515\t    return new Proxy({ kind: \"custom\" }, { ownKeys() { throw new Error(secret); } });\n   516\t  };\n   517\t  const report = await runMcpFnTargetSuite({ target });\n   518\t  expect(close).toHaveBeenCalledOnce();\n   519\t  expect(report).toMatchObject({ ok: false, status: \"incomplete\", target: { kind: \"custom\" }, results: [], timeline: [] });\n   520\t  expect(report.incompleteReason).toContain(\"safe serialization failed\");\n   521\t  expect(JSON.stringify(report)).not.toContain(secret);\n   522\t});\n   523\t\n   524\t\n   525\tit(\"marks reports incomplete when post-close credential redaction is unavailable\", async () => {\n   526\t  let released = false;\n   527\t  const server = createMcpFnServer({ info: { name: \"fixture\", version: \"1\" }, registry: new McpFnRegistry() });\n   528\t  const report = await runMcpFnTargetSuite({ target: customTarget({ kind: \"custom\",\n   529\t    redact: <T>(value: T): T => { if (released) throw new Error(\"private-redaction-state\"); return value; },\n   530\t    open: async () => {\n   531\t      const [client, remote] = InMemoryTransport.createLinkedPair();\n   532\t      await server.connect(remote);\n   533\t      return { transport: client, close: async () => { await server.close(); released = true; } };\n   534\t    },\n   535\t  }) });\n   536\t  expect(released).toBe(true);\n   537\t  expect(report.status).toBe(\"incomplete\");\n   538\t  expect(report.ok).toBe(false);\n   539\t  expect(report.failure).toBeUndefined();\n   540\t  expect(report.droppedTimelineEvents).toBeGreaterThan(0);\n   541\t  expect(report.incompleteReason).toContain(\"redaction failed\");\n   542\t  expect(report.timeline.some(event => event.code === \"MCPFN_DIAGNOSTIC_REDACTION_FAILED\")).toBe(false);\n   543\t  expect(JSON.stringify(report)).not.toContain(\"private-redaction-state\");\n   544\t});\n   545\t\n   546\t\n   547\tit(\"does not count a target-authored diagnostic code collision as an omission\", async () => {\n   548\t  const server = createMcpFnServer({ info: { name: \"fixture\", version: \"1\" }, registry: new McpFnRegistry() });\n   549\t  const target = customTarget({ kind: \"custom\", open: async context => {\n   550\t    await context.diagnostic({ phase: \"capability-operation\", outcome: \"succeeded\",\n","stderr":"","aggregated_output":"   360\t  } catch {\n   361\t    return { ...fallback, failure: \"serialization\" };\n   362\t  }\n   363\t}\n   364\t\n   365\tasync function closeSuiteClient(client: McpFnTestClient | undefined): Promise<{\n   366\t  cleanupFailure?: McpFnReportFailure;\n   367\t  retainedCleanup?: () => Promise<void>;\n   368\t}> {\n   369\t  try {\n   370\t    await client?.close();\n   371\t    return {};\n   372\t  } catch (error) {\n   373\t    let retainedCleanup: (() => Promise<void>) | undefined;\n   374\t    if (error instanceof McpFnTestClientCleanupError) {\n   375\t      retainedCleanup = () => error.retryCleanup();\n   376\t    } else if (client) {\n   377\t      retainedCleanup = () => client.close();\n   378\t    }\n   379\t    const terminal = error instanceof McpFnTestClientCleanupError && error.cause !== undefined\n   380\t      ? error.cause\n   381\t      : error;\n   382\t    const phase = terminal && typeof terminal === \"object\" &&\n   383\t        (terminal as { phase?: unknown }).phase === \"token-revocation\"\n   384\t      ? \"token-revocation\"\n   385\t      : \"transport-close\";\n   386\t    return {\n   387\t      retainedCleanup,\n   388\t      cleanupFailure: normalizeMcpFnReportFailure({\n   389\t        name: \"CleanupError\",\n   390\t        message: \"Target cleanup failed\",\n   391\t        code: \"MCPFN_TARGET_CLEANUP_FAILED\",\n   392\t        phase,\n   393\t      }),\n   394\t    };\n   395\t  }\n   396\t}\n   397\t\n   398\tasync function runTargetSuite(options: RunMcpFnTargetSuiteOptions): Promise<McpFnTargetSuiteReport> {\n   399\t  const maxTimelineEvents = options.maxTimelineEvents ?? 500;\n   400\t  if (!Number.isInteger(maxTimelineEvents) || maxTimelineEvents < 1) {\n   401\t    throw new Error(\"maxTimelineEvents must be a positive integer\");\n   402\t  }\n   403\t  const maxReportBytes = options.maxReportBytes ?? 1_048_576;\n   404\t  validateReportCap(maxReportBytes);\n   405\t  const consumerDiagnostic = options.client?.diagnostics;\n   406\t  const diagnostics = new SuiteDiagnosticCollector(\n   407\t    maxTimelineEvents,\n   408\t    maxReportBytes,\n   409\t    options.target,\n   410\t    consumerDiagnostic,\n   411\t  );\n   412\t  let client: McpFnTestClient | undefined;\n   413\t  let manifestChecked = false;\n   414\t  let failure: McpFnReportFailure | undefined;\n   415\t  let execution: SuiteExecution = { results: [] };\n   416\t  try {\n   417\t    client = McpFnTestClient.createTarget(\n   418\t      options.target,\n   419\t      options.clientInfo ?? { name: \"mcpfn-suite\", version: \"0.0.1\" },\n   420\t      {\n   421\t        ...options.client,\n   422\t        diagnostics: event => diagnostics.record(client, event),\n   423\t      },\n   424\t    );\n   425\t    diagnostics.captureBaseline(client);\n   426\t    await client.session.connect();\n   427\t    ({ execution, manifestChecked } = await executeConnectedSuite(client, options));\n   428\t  } catch (error) {\n   429\t    failure = safeTargetFailure(options.target, error);\n   430\t  }\n   431\t  // Custom hooks may depend on credentials cleared by close. Capture every\n   432\t  // target-controlled report value while the session still owns that state.\n   433\t  const projection = projectSuiteArtifacts(options, client, execution);\n   434\t  execution = projection.execution;\n   435\t  const { cleanupFailure: closeFailure, retainedCleanup } = await closeSuiteClient(client);\n   436\t  diagnostics.captureUnobserved(client);\n   437\t  let cleanupFailure = closeFailure;\n   438\t  cleanupFailure ??= diagnostics.cleanupFailure;\n   439\t  failure ??= cleanupFailure;\n   440\t  const results = execution.results;\n   441\t  const failed = results.filter((result) => result.status === \"failed\").length;\n   442\t  const incomplete = results.filter((result) => result.status === \"incomplete\").length;\n   443\t  const droppedObservedEvents = results.reduce(\n   444\t    (total, result) => total + (result.droppedObservedEvents ?? 0),\n   445\t    0,\n   446\t  );\n   447\t  const redactionOmittedObservedEvents = results.reduce(\n   448\t    (total, result) => total + (result.redactionOmittedObservedEvents ?? 0),\n   449\t    0,\n   450\t  );\n   451\t  const overflowedObservedEvents = droppedObservedEvents - redactionOmittedObservedEvents;\n   452\t  const artifactIncomplete = Boolean(failure) || incomplete > 0 ||\n   453\t    diagnostics.dropped > 0 ||\n   454\t    droppedObservedEvents > 0;\n   455\t  const report: McpFnTargetSuiteReport = {\n   456\t    formatVersion: 1,\n   457\t    kind: \"mcpfn.target-suite-report\",\n   458\t    status: artifactIncomplete ? \"incomplete\" : \"complete\",\n   459\t    runtime: {\n   460\t      node: process.version,\n   461\t      scenarioFormatVersion: 1,\n   462\t      reportSchemaVersion: MCPFN_REPORT_SCHEMA_VERSION,\n   463\t      packages: { testing: MCPFN_TESTING_VERSION },\n   464\t    },\n   465\t    ok: failed === 0 && !artifactIncomplete,\n   466\t    target: projection.target,\n   467\t    server: execution.server,\n   468\t    capabilities: execution.capabilities,\n   469\t    manifestChecked,\n   470\t    ...(projection.manifestHash === undefined ? {} : { manifestHash: projection.manifestHash }),\n   471\t    total: results.length,\n   472\t    passed: results.length - failed - incomplete,\n   473\t    failed,\n   474\t    incomplete,\n   475\t    droppedResults: 0,\n   476\t    droppedObservedEvents,\n   477\t    ...(redactionOmittedObservedEvents > 0 ? { redactionOmittedObservedEvents } : {}),\n   478\t    ...(failure || diagnostics.dropped > 0 || droppedObservedEvents > 0\n   479\t      ? {\n   480\t        incompleteReason: [\n   481\t          ...(failure ? [`${failure.layer}: ${failure.message}`] : []),\n   482\t          ...(cleanupFailure ? [`Cleanup: ${cleanupFailure.message}`] : []),\n   483\t          ...(diagnostics.serializationFailed ? [\"Diagnostic timeline contained non-JSON data\"] : []),\n   484\t          ...(diagnostics.redactionFailed ? [\"Diagnostic timeline redaction failed; original events omitted\"] : []),\n   485\t          ...(diagnostics.countExceeded ? [\"Diagnostic timeline exceeded maxTimelineEvents\"] : []),\n   486\t          ...(diagnostics.bytesExceeded ? [\"Diagnostic timeline exceeded maxReportBytes\"] : []),\n   487\t          ...(redactionOmittedObservedEvents > 0\n   488\t            ? [\"Observed client events were omitted because credential redaction failed\"]\n   489\t            : []),\n   490\t          ...(overflowedObservedEvents > 0\n   491\t            ? [\"Observed client events exceeded maxObservedEvents\"]\n   492\t            : []),\n   493\t        ].join(\"; \"),\n   494\t      }\n   495\t      : {}),\n   496\t    ...(failure ? { failure } : {}),\n   497\t    timeline: diagnostics.timeline,\n   498\t    droppedTimelineEvents: diagnostics.dropped,\n   499\t    results,\n   500\t  };\n   501\t  let finalized: McpFnTargetSuiteReport;\n   502\t  try {\n   503\t    if (projection.failure) throw new Error(\"Report payload projection failed\");\n   504\t    // Custom redaction already completed before cleanup. Built-in report scopes\n   505\t    // remain active here for bounded final serialization.\n   506\t    finalized = enforceReportCap(redactTargetCredentials(options.target, report, { preserveKeys: true }), maxReportBytes);\n   507\t  } catch (error) {\n   508\t    if (error instanceof McpFnStructuralCredentialCollisionError) {\n   509\t      const failure = new McpFnClientError(\n   510\t        \"MCPFN_OPERATION_FAILED\",\n   511\t        \"Target report cannot be serialized because a credential conflicts with required artifact structure\",\n   512\t        { phase: \"capability-operation\" },\n   513\t      );\n   514\t      if (retainedCleanup) {\n   515\t        throw new McpFnTargetSuiteArtifactCleanupError(retainedCleanup, failure);\n   516\t      }\n   517\t      throw failure;\n   518\t    }\n   519\t    finalized = enforceReportCap({ ...report, ok: false, status: \"incomplete\",\n   520\t      incompleteReason: reportProjectionFailureReason(error, projection.failure),\n   521\t      target: { kind: \"custom\" }, server: undefined, capabilities: undefined, manifestHash: undefined,\n   522\t      failure: undefined, results: [], timeline: [],\n   523\t      droppedResults: report.results.length, droppedTimelineEvents: report.droppedTimelineEvents + report.timeline.length,\n   524\t    }, maxReportBytes);\n   525\t  }\n   526\t  if (retainedCleanup) throw new McpFnTargetSuiteCleanupError(finalized, retainedCleanup);\n   527\t  return finalized;\n   528\t}\n   529\t\n   530\tfunction enforceReportCap(\n   531\t  report: McpFnTargetSuiteReport,\n   532\t  maxBytes: number,\n   533\t): McpFnTargetSuiteReport {\n   534\t  validateReportCap(maxBytes);\n   535\t  const bounded = structuredClone(report);\n   536\t  if (jsonBytes(bounded) > maxBytes) {\n   537\t    bounded.ok = false;\n   538\t    bounded.status = \"incomplete\";\n   539\t    bounded.incompleteReason = \"Report content exceeded maxReportBytes and was truncated\";\n   540\t  }\n   541\t  while (jsonBytes(bounded) > maxBytes && bounded.results.length > 0) {\n   542\t    bounded.results.pop();\n   543\t    bounded.droppedResults += 1;\n   544\t  }\n   545\t  if (jsonBytes(bounded) > maxBytes) {\n   546\t    bounded.target = { kind: report.target.kind };\n   547\t    bounded.server = undefined;\n   548\t    bounded.capabilities = undefined;\n   549\t    bounded.timeline = [];\n   550\t    bounded.droppedTimelineEvents += report.timeline.length;\n   551\t    if (bounded.failure) {\n   552\t      bounded.failure.details = undefined;\n   553\t      bounded.failure.message = \"Target operation failed; details omitted to fit report budget\";\n   554\t    }\n   555\t  }\n   556\t  if (bounded.droppedResults > 0 || jsonBytes(bounded) > maxBytes) {\n   557\t    bounded.ok = false;\n   558\t    bounded.status = \"incomplete\";\n   559\t    bounded.incompleteReason = \"Report content exceeded maxReportBytes and was truncated\";\n   560\t  }\n   561\t  if (jsonBytes(bounded) > maxBytes) {\n   562\t    throw new Error(\"The minimum target suite report exceeds maxReportBytes\");\n   563\t  }\n   564\t  return bounded;\n   565\t}\n   566\t\n   567\tfunction validateReportCap(maxBytes: number): void {\n   568\t  if (!Number.isInteger(maxBytes) || maxBytes < 1_024) {\n   569\t    throw new Error(\"maxReportBytes must be an integer of at least 1024\");\n   570\t  }\n   571\t}\n   572\t\n   573\tfunction jsonBytes(value: unknown): number {\n   574\t  return new TextEncoder().encode(JSON.stringify(value)).byteLength;\n   575\t}\n     1\timport {\n     2\t  McpFnClientError,\n     3\t  customTarget,\n     4\t  streamableHttpTarget,\n     5\t  type McpFnStreamableHttpTargetOptions,\n     6\t  type McpFnTarget,\n     7\t  type McpFnTransportHandle,\n     8\t} from \"@mcpfn/client\";\n     9\t\n    10\timport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n    11\t\n    12\ttype SecretState = { active: Map<string, number>; scopes: Set<Set<string>> };\n    13\tconst targetSecrets = new WeakMap<McpFnTarget, SecretState>();\n    14\tconst utf8Encoder = new TextEncoder();\n    15\t\n    16\t/** Retain released credentials only for the lifetime of a report operation. */\n    17\texport function beginTargetCredentialRedaction(target: McpFnTarget): () => void {\n    18\t  const state = targetSecrets.get(target);\n    19\t  if (!state) return () => undefined;\n    20\t  const scope = new Set(state.active.keys());\n    21\t  state.scopes.add(scope);\n    22\t  return () => { state.scopes.delete(scope); scope.clear(); };\n    23\t}\n    24\t\n    25\tfunction credentialValues(headers: HeadersInit): Set<string> {\n    26\t  const values = boundedCredentialEntries(headers);\n    27\t  const secrets = new Set<string>();\n    28\t  for (const [header, raw] of values) {\n    29\t    if (!raw.trim()) continue;\n    30\t    secrets.add(raw);\n    31\t    secrets.add(raw.trim());\n    32\t    const normalizedHeader = header.toLowerCase();\n    33\t    if ([\"authorization\", \"proxy-authorization\"].includes(normalizedHeader)) {\n    34\t      addAuthorizationSecrets(raw, secrets);\n    35\t    }\n    36\t    if (normalizedHeader === \"cookie\") addCookieSecrets(raw, secrets);\n    37\t  }\n    38\t  return secrets;\n    39\t}\n    40\t\n    41\tfunction addAuthorizationSecrets(raw: string, secrets: Set<string>): void {\n    42\t  const trimmed = raw.trim();\n    43\t  const separator = trimmed.search(/\\s/);\n    44\t  if (separator <= 0) return;\n    45\t  const scheme = trimmed.slice(0, separator).toLowerCase();\n    46\t  const token = trimmed.slice(separator).trim();\n    47\t  if (token) secrets.add(token);\n    48\t  if (scheme !== \"basic\" || !/^[\\dA-Za-z+/]+={0,2}$/.test(token)) return;\n    49\t  const decoded = Buffer.from(token, \"base64\");\n    50\t  // Round-trip validation avoids interpreting malformed tokens as credentials.\n    51\t  if (decoded.toString(\"base64\").replace(/=+$/, \"\") !== token.replace(/=+$/, \"\")) return;\n    52\t  for (const encoding of [\"utf8\", \"latin1\"] as const) {\n    53\t    const pair = decoded.toString(encoding);\n    54\t    const colon = pair.indexOf(\":\");\n    55\t    if (colon < 0) continue;\n    56\t    for (const value of [pair, pair.slice(0, colon), pair.slice(colon + 1)]) {\n    57\t      if (value) secrets.add(value);\n    58\t    }\n    59\t  }\n    60\t}\n    61\t\n    62\tfunction addCookieSecrets(raw: string, secrets: Set<string>): void {\n    63\t  // Cookie values are independently reflectable even though the request\n    64\t  // authenticates with the complete header. RFC 6265 cookie values cannot\n    65\t  // contain comma or semicolon, so both delimiters cover combined entries.\n    66\t  for (const part of raw.split(/[;,]/)) {\n    67\t    const pair = part.trim();\n    68\t    if (!pair) continue;\n    69\t    const equals = pair.indexOf(\"=\");\n    70\t    if (equals < 1) {\n    71\t      throw new TypeError(\"Cookie credential headers must contain name=value pairs\");\n    72\t    }\n    73\t    const value = pair.slice(equals + 1).trim();\n    74\t    if (!value) continue;\n    75\t    secrets.add(value);\n    76\t    addUnquotedCookieSecret(value, secrets);\n    77\t  }\n    78\t}\n    79\t\n    80\tfunction addUnquotedCookieSecret(value: string, secrets: Set<string>): void {\n    81\t  if (!value.startsWith('\"') && !value.endsWith('\"')) return;\n    82\t  if (value.length < 2 || !value.startsWith('\"') || !value.endsWith('\"')) {\n    83\t    throw new TypeError(\"Cookie credential values must use balanced quotes\");\n    84\t  }\n    85\t  const unquoted = value.slice(1, -1);\n    86\t  if (unquoted.includes('\"') || unquoted.includes(\"\\\\\")) {\n    87\t    throw new TypeError(\"Cookie credential values must use RFC 6265 syntax\");\n    88\t  }\n    89\t  if (unquoted) secrets.add(unquoted);\n    90\t}\n    91\t\n    92\texport class McpFnRedactionLimitError extends Error {\n    93\t  constructor(message = \"Credential redaction exceeded its traversal budget\") { super(message); }\n    94\t}\n    95\t\n    96\t/** No typed artifact can preserve this authored key without exposing a credential. */\n    97\texport class McpFnStructuralCredentialCollisionError extends McpFnRedactionLimitError {\n    98\t  constructor() {\n    99\t    super(\"Credential collides with a required structural artifact key\");\n   100\t  }\n   101\t}\n   102\t\n   103\t// Only these locally authored envelope paths retain structural keys. Unknown\n   104\t// children (including inspector events and server metadata) are always payloads.\n   105\tconst envelopeKeys: Record<string, Set<string>> = Object.fromEntries(Object.entries({\n   106\t  root: \"formatVersion kind status runtime ok target server capabilities manifestChecked manifestHash total passed failed incomplete droppedResults droppedObservedEvents redactionOmittedObservedEvents incompleteReason failure timeline droppedTimelineEvents results count clientState tools resources resourceTemplates prompts droppedEvents timelineComplete droppedInventoryEntries inventoryComplete suiteVersion exitCode stdout stderr phase outcome code requestId at details payload\",\n   107\t  result: \"formatVersion name operation tool status sideEffect durationMs error droppedObservedEvents redactionOmittedObservedEvents\",\n   108\t  diagnostic: \"phase outcome code requestId at target details\",\n   109\t  inspectorEvent: \"formatVersion source kind at event\",\n   110\t  failure: \"name message layer code phase details\",\n   111\t  runtime: \"node scenarioFormatVersion reportSchemaVersion packages\",\n   112\t  packages: \"testing\",\n   113\t  droppedInventoryEntries: \"tools resources resourceTemplates prompts\",\n   114\t  target: \"kind\",\n   115\t}).map(([role, keys]) => [role, new Set(keys.split(\" \"))]));\n   116\t\n   117\tconst structuralArtifactValues = new Map<string, Set<string>>([\n   118\t  [\"root:kind\", new Set([\"logging.message\", \"progress\", \"tasks.status\", \"resources.updated\", \"tools.list_changed\", \"resources.list_changed\", \"prompts.list_changed\", \"resources.subscribed\", \"resources.unsubscribed\", \"client.roots\", \"client.sampling\", \"client.elicitation\", \"mcpfn.target-suite-report\", \"mcpfn.inspector-snapshot\", \"mcpfn.official-conformance-report\"])],\n   119\t  [\"inspectorEvent:kind\", new Set([\"logging.message\", \"progress\", \"tasks.status\", \"resources.updated\", \"tools.list_changed\", \"resources.list_changed\", \"prompts.list_changed\", \"resources.subscribed\", \"resources.unsubscribed\", \"client.roots\", \"client.sampling\", \"client.elicitation\"])],\n   120\t  [\"root:clientState\", new Set([\"idle\", \"connecting\", \"authorization-required\", \"connected\", \"closing\", \"closed\"])],\n   121\t  [\"target:kind\", new Set([\"authenticated-streamable-http\", \"streamable-http\", \"stdio\", \"in-memory\", \"custom\"])],\n   122\t  [\"root:status\", new Set([\"passed\", \"failed\", \"incomplete\", \"complete\"])],\n   123\t  [\"result:status\", new Set([\"passed\", \"failed\", \"incomplete\", \"complete\"])],\n   124\t  [\"root:outcome\", new Set([\"started\", \"succeeded\", \"failed\"])],\n   125\t  [\"diagnostic:outcome\", new Set([\"started\", \"succeeded\", \"failed\"])],\n   126\t  ...[\"root\", \"diagnostic\", \"failure\"].map(role => [\n   127\t    `${role}:phase`,\n   128\t    new Set([\"resource-discovery\", \"authorization-server-discovery\", \"client-registration\", \"authorization-request\", \"authorization-callback\", \"token-exchange\", \"token-refresh\", \"token-revocation\", \"transport-connect\", \"mcp-initialize\", \"capability-operation\", \"transport-close\"]),\n   129\t  ] as [string, Set<string>]),\n   130\t  [\"failure:layer\", new Set([\"mcpfn-preflight\", \"authorization-server\", \"resource-server\", \"mcp-initialization\", \"scenario\", \"upstream-conformance\"])],\n   131\t  [\"inspectorEvent:source\", new Set([\"diagnostic\", \"client\"])],\n   132\t  [\"result:sideEffect\", new Set([\"none\", \"idempotent\", \"non-idempotent\"])],\n   133\t]);\n   134\t\n   135\tconst unrestrictedStructuralValueFields = new Set([\n   136\t  \"packages:testing\",\n   137\t  \"runtime:node\",\n   138\t  \"runtime:reportSchemaVersion\",\n   139\t  \"root:suiteVersion\",\n   140\t]);\n   141\t\n   142\tfunction specialValue(input: unknown): unknown {\n   143\t  if (input instanceof Error) return normalizeErrorValue(input);\n   144\t  if (input instanceof Date) return Number.isNaN(input.getTime()) ? \"Invalid Date\" : input.toISOString();\n   145\t  if (input instanceof URL) return input.href;\n   146\t  if (input instanceof Map) {\n   147\t    if (Object.getOwnPropertyDescriptor(Map.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   148\t    return { type: \"Map\", entries: [...Map.prototype.entries.call(input)] };\n   149\t  }\n   150\t  if (input instanceof Set) {\n   151\t    if (Object.getOwnPropertyDescriptor(Set.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   152\t    return { type: \"Set\", values: [...Set.prototype.values.call(input)] };\n   153\t  }\n   154\t  return input;\n   155\t}\n   156\t\n   157\tfunction normalizeErrorValue(input: Error): Record<string, unknown> {\n   158\t  // Error instances may expose attacker-controlled enumerable keys. A\n   159\t  // null-prototype accumulator keeps `__proto__` as ordinary payload data.\n   160\t  const normalized = Object.create(null) as Record<string, unknown>;\n   161\t  let enumerableFields = 0;\n   162\t  for (const key in input) {\n   163\t    if (!Object.hasOwn(input, key)) continue;\n   164\t    if (++enumerableFields > 100_000) throw new McpFnRedactionLimitError();\n   165\t    normalized[key] = (input as unknown as Record<string, unknown>)[key];\n   166\t  }\n   167\t  normalized.name = input.name;\n   168\t  normalized.message = input.message;\n   169\t  normalized.stack = input.stack;\n   170\t  if (input.cause !== undefined) normalized.cause = input.cause;\n   171\t  return normalized;\n   172\t}\n   173\t\n   174\tfunction scrubCredentials<T>(value: T, values: Iterable<string>, preserveKeys = false, redactionMarker?: string): T {\n   175\t  // Preserve whether a pattern came from opaque text or a serializer. Literal\n   176\t  // percent sequences in credentials must not acquire URL hex-case semantics.\n   177\t  const variants = [...values].filter(Boolean).flatMap(secret => [\n   178\t    { value: secret, encoded: false },\n   179\t    { value: JSON.stringify(secret).slice(1, -1), encoded: false },\n   180\t    { value: encodeURIComponent(secret), encoded: true },\n   181\t    { value: new URLSearchParams({ value: secret }).toString().slice(\"value=\".length), encoded: true },\n   182\t  ]).sort((a, b) => b.value.length - a.value.length);\n   183\t  let entries = 0, stringBytes = 0;\n   184\t  const budget = (input: unknown, depth = 0): void => {\n   185\t    input = specialValue(input);\n   186\t    if ((Array.isArray(input) && input.length > 100_000) || ++entries > 100_000 || depth > 32) throw new McpFnRedactionLimitError();\n   187\t    if (typeof input === \"string\") {\n   188\t      stringBytes += Buffer.byteLength(input);\n   189\t      if (input.length > 262_144 || stringBytes > 2_097_152) throw new McpFnRedactionLimitError();\n   190\t    } else if (input && typeof input === \"object\") {\n   191\t      for (const key in input) if (Object.hasOwn(input, key)) {\n   192\t        budget(key, depth + 1);\n   193\t        budget((input as Record<string, unknown>)[key], depth + 1);\n   194\t      }\n   195\t    }\n   196\t  };\n   197\t  // Check before either redactor allocates copies. Exceeding a budget is an\n   198\t  // explicit failure, never silent truncation of a typed report collection.\n   199\t  budget(value);\n   200\t  const patterns = variants.map(({ value, encoded }) => {\n   201\t    const literal = value.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n   202\t    // Only generated percent escapes accept mixed-case hex digits.\n   203\t    return encoded\n   204\t      ? literal.replace(/%[\\dA-Fa-f]{2}/g, escape => escape.replace(/[A-Fa-f]/g, hex => `[${hex.toLowerCase()}${hex.toUpperCase()}]`))\n   205\t      : literal;\n   206\t  });\n   207\t  const secretPattern = patterns.length ? new RegExp(patterns.join(\"|\"), \"g\") : undefined;\n   208\t  const replacementPattern = patterns.length ? new RegExp(patterns.join(\"|\")) : undefined;\n   209\t  const preserveStructural = (input: string): string => {\n   210\t    if (replacementPattern?.test(input)) {\n   211\t      throw new McpFnRedactionLimitError(\n   212\t        \"Credential collides with a required structural artifact field\",\n   213\t      );\n   214\t    }\n   215\t    return input;\n   216\t  };\n   217\t  const preserveStructuralKey = (input: string): string => {\n   218\t    if (replacementPattern?.test(input)) {\n   219\t      throw new McpFnStructuralCredentialCollisionError();\n   220\t    }\n   221\t    return input;\n   222\t  };\n   223\t  // A requested marker is itself output and must not reproduce a credential.\n   224\t  if (secretPattern) {\n   225\t    const markerContainsSecret = secretPattern.test(redactionMarker ?? \"[REDACTED]\");\n   226\t    secretPattern.lastIndex = 0;\n   227\t    if (markerContainsSecret) redactionMarker = \"\";\n   228\t  }\n   229\t  const scrubString = (input: string, role: string, field: string, finalPass: boolean): string => {\n   230\t    const structuralField = `${role}:${field}`;\n   231\t    if (unrestrictedStructuralValueFields.has(structuralField) ||\n   232\t        structuralArtifactValues.get(structuralField)?.has(input)) {\n   233\t      return preserveStructural(input);\n   234\t    }\n   235\t    // Whole-string rejection cannot compose another credential by joining pieces.\n   236\t    // Run after both redactors; never feed this result through another redactor.\n   237\t    if (finalPass) return replacementPattern?.test(input) ? \"\" : input;\n   238\t    if (!secretPattern) return input;\n   239\t    return input.replace(secretPattern, secret => {\n   240\t      const maskCharacter = secret.includes(\"*\") ? \"#\" : \"*\";\n   241\t      const defaultReplacement = secret.length < 10\n   242\t        ? maskCharacter.repeat(secret.length)\n   243\t        : \"[REDACTED]\";\n   244\t      const replacement = redactionMarker ?? defaultReplacement;\n   245\t      // Every generated mask must be safe against the entire credential set.\n   246\t      return replacementPattern!.test(replacement) ? \"\" : replacement;\n   247\t    });\n   248\t  };\n   249\t  const scrub = (input: unknown, role = \"payload\", field = \"\", finalPass = false): unknown => {\n   250\t    input = specialValue(input);\n   251\t    if (typeof input === \"string\") return scrubString(input, role, field, finalPass);\n   252\t    if (Array.isArray(input)) {\n   253\t      const result = input.map(entry => scrub(entry, role, \"\", finalPass));\n   254\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   255\t      return result;\n   256\t    }\n   257\t    if (input && typeof input === \"object\") {\n   258\t      const entries: Array<[string, unknown]> = [];\n   259\t      const keys = new Set<string>();\n   260\t      for (const [key, entry] of Object.entries(input)) {\n   261\t        const fixed = envelopeKeys[role]?.has(key) ?? false;\n   262\t        if (fixed) preserveStructuralKey(key);\n   263\t        let childRole = \"payload\";\n   264\t        if (fixed) {\n   265\t          if (key === \"results\") childRole = \"result\";\n   266\t          else if (key === \"timeline\") childRole = (value as any)?.kind === \"mcpfn.inspector-snapshot\" ? \"inspectorEvent\" : \"diagnostic\";\n   267\t          else if ([\"failure\", \"runtime\", \"packages\", \"droppedInventoryEntries\", \"target\"].includes(key)) childRole = key;\n   268\t          else if (role === \"inspectorEvent\" && key === \"event\") childRole = (input as { source?: string }).source === \"client\" ? \"root\" : \"diagnostic\";\n   269\t        }\n   270\t        const scrubbedKey = fixed ? key : scrub(key, \"payload\", \"\", finalPass) as string;\n   271\t        if (keys.has(scrubbedKey)) {\n   272\t          throw new McpFnRedactionLimitError(\n   273\t            \"Credential redaction created duplicate object keys\",\n   274\t          );\n   275\t        }\n   276\t        keys.add(scrubbedKey);\n   277\t        const scrubbedEntry = typeof entry === \"string\"\n   278\t          ? scrub(entry, fixed ? role : \"payload\", key, finalPass)\n   279\t          : scrub(entry, childRole, \"\", finalPass);\n   280\t        entries.push([scrubbedKey, scrubbedEntry]);\n   281\t      }\n   282\t      const result = Object.fromEntries(entries);\n   283\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   284\t      return result;\n   285\t    }\n   286\t    return input;\n   287\t  };\n   288\t  const timelineEvent = value && typeof value === \"object\" && [\"client\", \"diagnostic\"].includes((value as { source?: string }).source ?? \"\");\n   289\t  let role = \"payload\";\n   290\t  if (preserveKeys) role = timelineEvent ? \"inspectorEvent\" : \"root\";\n   291\t  const scrubbed = scrub(value, role);\n   292\t  const generic = redactOAuthValue(scrubbed, { maxStringLength: 262_144, maxDepth: 64, maxArrayEntries: 100_000, maxObjectEntries: 100_000, ...(redactionMarker !== undefined ? { redactionMarker } : {}) });\n   293\t  const result = scrub(generic, role, \"\", true) as T;\n   294\t  assertPayloadSerialization(\n   295\t    result,\n   296\t    \"payload\",\n   297\t    true,\n   298\t    replacementPattern,\n   299\t  );\n   300\t  return result;\n   301\t}\n   302\t\n   303\tfunction assertPayloadSerialization(\n   304\t  value: unknown,\n   305\t  role: string,\n   306\t  finalPass: boolean,\n   307\t  credentialPattern: RegExp | undefined,\n   308\t): void {\n   309\t  if (!finalPass || role !== \"payload\" || !credentialPattern) return;\n   310\t  const serialized = JSON.stringify(value);\n   311\t  if (serialized !== undefined && credentialPattern.test(serialized)) {\n   312\t    throw new McpFnRedactionLimitError(\n   313\t      \"Credential redaction could not guarantee safe serialized output\",\n   314\t    );\n   315\t  }\n   316\t}\n   317\t\n   318\t/** Remove known opaque credential values as well as credential-shaped fields. */\n   319\texport function redactTargetCredentials<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean; redactionMarker?: string } = {}): T {\n   320\t  const state = targetSecrets.get(target);\n   321\t  return scrubCredentials(value, new Set([...(state?.active.keys() ?? []), ...[...(state?.scopes ?? [])].flatMap((scope) => [...scope])]), options.preserveKeys, options.redactionMarker);\n   322\t}\n   323\t\n   324\t/** Redact authenticated conformance output using the acquired credential. */\n   325\texport function redactRemoteCredential<T>(credential: McpFnRemoteCredential, value: T, options: { preserveKeys?: boolean } = {}): T {\n   326\t  return scrubCredentials(value, credentialValues(credential.headers), options.preserveKeys);\n   327\t}\n   328\t\n   329\tconst MAX_CREDENTIAL_HEADERS = 32;\n   330\tconst MAX_CREDENTIAL_HEADER_BYTES = 16_384;\n     1\timport type { McpFnDiagnosticPhase } from \"@mcpfn/client\";\n     2\timport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n     3\t\n     4\timport type { McpFnTargetSuiteReport } from \"./suite.js\";\n     5\t\n     6\tdeclare const __MCPFN_TESTING_VERSION__: string;\n     7\t\n     8\texport const MCPFN_TESTING_VERSION = __MCPFN_TESTING_VERSION__;\n     9\texport const MCPFN_REPORT_SCHEMA_VERSION = \"1.0.0\";\n    10\t\n    11\texport type McpFnFailureLayer =\n    12\t  | \"mcpfn-preflight\"\n    13\t  | \"authorization-server\"\n    14\t  | \"resource-server\"\n    15\t  | \"mcp-initialization\"\n    16\t  | \"scenario\"\n    17\t  | \"upstream-conformance\";\n    18\t\n    19\texport interface McpFnReportFailure {\n    20\t  name: string;\n    21\t  message: string;\n    22\t  layer: McpFnFailureLayer;\n    23\t  code?: string;\n    24\t  phase?: string;\n    25\t  details?: Record<string, unknown>;\n    26\t}\n    27\t\n    28\texport interface McpFnJunitOptions {\n    29\t  /** Aggregate XML size cap after serialization. Defaults to 1 MiB. */\n    30\t  maxBytes?: number;\n    31\t}\n    32\t\n    33\texport function normalizeMcpFnReportFailure(\n    34\t  error: unknown,\n    35\t  fallbackPhase?: McpFnDiagnosticPhase | \"scenario\" | \"upstream-conformance\",\n    36\t): McpFnReportFailure {\n    37\t  const redacted = redactOAuthValue(error, {\n    38\t    maxDepth: 6,\n    39\t    maxArrayEntries: 50,\n    40\t    maxObjectEntries: 50,\n    41\t    maxStringLength: 2_048,\n    42\t  });\n    43\t  const record = redacted && typeof redacted === \"object\" && !Array.isArray(redacted)\n    44\t    ? redacted as Record<string, unknown>\n    45\t    : {};\n    46\t  const phase = stringField(record.phase) ?? fallbackPhase;\n    47\t  const details = record.details && typeof record.details === \"object\" &&\n    48\t      !Array.isArray(record.details)\n    49\t    ? record.details as Record<string, unknown>\n    50\t    : undefined;\n    51\t  let message = stringField(record.message) ?? String(\n    52\t    redactOAuthValue(error instanceof Error ? error.message : String(error)),\n    53\t  );\n    54\t  const cause = error && typeof error === \"object\"\n    55\t    ? (error as { cause?: unknown }).cause\n    56\t    : undefined;\n    57\t  const redactedCause = cause === undefined\n    58\t    ? undefined\n    59\t    : redactOAuthValue(cause, {\n    60\t      maxDepth: 4,\n    61\t      maxArrayEntries: 20,\n    62\t      maxObjectEntries: 20,\n    63\t      maxStringLength: 1_024,\n    64\t    });\n    65\t  const causeRecord = redactedCause && typeof redactedCause === \"object\" &&\n    66\t      !Array.isArray(redactedCause)\n    67\t    ? redactedCause as Record<string, unknown>\n    68\t    : undefined;\n    69\t  const causeMessage = stringField(causeRecord?.message);\n    70\t  if (causeMessage && !message.includes(causeMessage)) message = `${message}: ${causeMessage}`;\n    71\t  const combinedDetails = causeRecord ? { ...details, cause: causeRecord } : details;\n    72\t  const layer = failureLayer(phase);\n    73\t  const deniedByResource = layer !== \"authorization-server\" &&\n    74\t    [causeRecord?.code, causeRecord?.status, record.code, record.status]\n    75\t      .some(value => [401, 403].includes(Number(value)));\n    76\t  return {\n    77\t    name: stringField(record.name) ?? \"Error\",\n    78\t    message,\n    79\t    layer: deniedByResource ? \"resource-server\" : layer,\n    80\t    ...(stringField(record.code) ? { code: stringField(record.code)! } : {}),\n    81\t    ...(phase ? { phase } : {}),\n    82\t    ...(combinedDetails ? { details: combinedDetails } : {}),\n    83\t  };\n    84\t}\n    85\t\n    86\t/** Serialize a redacted target-suite report as bounded JUnit XML. */\n    87\texport function createMcpFnTargetSuiteJUnit(\n    88\t  report: McpFnTargetSuiteReport,\n    89\t  options: McpFnJunitOptions = {},\n    90\t): string {\n    91\t  const maxBytes = options.maxBytes ?? 1_048_576;\n    92\t  validateArtifactCap(maxBytes);\n    93\t  const safe = redactOAuthValue(report, {\n    94\t    maxDepth: 10,\n    95\t    maxArrayEntries: 1_000,\n    96\t    maxObjectEntries: 200,\n    97\t    maxStringLength: 4_096,\n    98\t  }) as unknown as McpFnTargetSuiteReport;\n    99\t  // Redaction appends a string sentinel when an array exceeds its cap.\n   100\t  const results = safe.results.filter((result) => result && typeof result === \"object\" && typeof result.name === \"string\");\n   101\t  const omitted = report.results.length - results.length;\n   102\t  const cases = results.map((result) => {\n   103\t    const duration = Math.max(0, result.durationMs ?? 0) / 1_000;\n   104\t    let failure = \"\";\n   105\t    if (result.status !== \"passed\") {\n   106\t      const failureType = result.status === \"failed\" ? \"scenario\" : \"incomplete\";\n   107\t      failure = junitFailure(result.error ?? `Scenario ${result.status}`, failureType);\n   108\t    }\n   109\t    return `    <testcase name=\"${xml(result.name)}\" classname=\"mcpfn.scenario\" time=\"${duration.toFixed(3)}\">${failure}</testcase>`;\n   110\t  });\n   111\t  if (safe.failure) {\n   112\t    cases.unshift(\n   113\t      `    <testcase name=\"${xml(safe.failure.phase ?? \"target\")}\" classname=\"mcpfn.${xml(safe.failure.layer)}\" time=\"0.000\">${junitFailure(safe.failure.message, safe.failure.code ?? safe.failure.layer)}</testcase>`,\n   114\t    );\n   115\t  }\n   116\t  if (safe.status === \"incomplete\" || omitted > 0 || (!safe.ok && !safe.failure && results.every((result) => result.status === \"passed\"))) {\n   117\t    cases.push(`    <testcase name=\"suite-incomplete\" classname=\"mcpfn.report\" time=\"0.000\">${junitFailure(safe.incompleteReason ?? \"Suite evidence is incomplete or omitted\", \"incomplete\")}</testcase>`);\n   118\t  }\n   119\t  if (cases.length === 0) {\n   120\t    cases.push(\n   121\t      '    <testcase name=\"target-suite\" classname=\"mcpfn.target\" time=\"0.000\"></testcase>',\n   122\t    );\n   123\t  }\n   124\t  const failures = cases.filter((entry) => entry.includes(\"<failure \")).length;\n   125\t  let serialized = junitDocument(safe, cases, failures);\n   126\t  if (bytes(serialized) <= maxBytes) return serialized;\n   127\t\n   128\t  const boundedCases = [\n   129\t    `    <testcase name=\"artifact-cap\" classname=\"mcpfn.report\" time=\"0.000\">${junitFailure(\"JUnit content exceeded maxBytes and was truncated\", \"incomplete\")}</testcase>`,\n   130\t  ];\n   210\t  async run(operation: McpFnInspectorOperation): Promise<McpFnInspectorOperationResult> {\n   211\t    if (operation.kind === \"tools.call\") {\n   212\t      return this.client.tools.call(operation.name, operation.arguments);\n   213\t    }\n   214\t    if (operation.kind === \"tools.call:task\") {\n   215\t      return this.client.tools.createTask(operation.name, operation.arguments, operation.task);\n   216\t    }\n   217\t    if (operation.kind === \"resources.read\") {\n   218\t      return this.client.resources.read(operation.uri);\n   219\t    }\n   220\t    if (operation.kind === \"resources.subscribe\") {\n   221\t      return this.client.resources.subscribe(operation.uri);\n   222\t    }\n   223\t    if (operation.kind === \"resources.unsubscribe\") {\n   224\t      return this.client.resources.unsubscribe(operation.uri);\n   225\t    }\n   226\t    if (operation.kind === \"prompts.get\") {\n   227\t      return this.client.prompts.get(operation.name, operation.arguments);\n   228\t    }\n   229\t    if (operation.kind === \"tasks.get\") return this.client.tasks.get(operation.taskId);\n   230\t    if (operation.kind === \"tasks.result\") return this.client.tasks.result(operation.taskId);\n   231\t    if (operation.kind === \"tasks.cancel\") return this.client.tasks.cancel(operation.taskId);\n   232\t    return this.client.tasks.list(operation.cursor);\n   233\t  }\n   234\t\n   235\t  exportScenario(\n   236\t    name: string,\n   237\t    operation: McpFnInspectorOperation,\n   238\t    result: McpFnInspectorOperationResult,\n   239\t  ): McpFnExportedScenario {\n   240\t    const scenario = createMcpFnScenario(name, operation, result);\n   241\t    // Top-level scenario keys are authored schema, not payload. If a credential\n   242\t    // collides with one of them, no replayable typed artifact can be emitted.\n   243\t    for (const key of [\n   244\t      ...Object.keys(scenario),\n   245\t      \"status\",\n   246\t      \"incompleteReason\",\n   247\t      \"variables\",\n   248\t    ]) {\n   249\t      this.client.preserveArtifactStructure(key);\n   250\t    }\n   251\t    const { formatVersion, kind, sideEffect, ...payload } = scenario;\n   252\t    if (kind === undefined || sideEffect === undefined) {\n   253\t      throw new Error(\"Inspector scenario export requires normalized structure\");\n   254\t    }\n   255\t    const safeKind = this.client.preserveArtifactStructure(kind);\n   256\t    const safeSideEffect = this.client.preserveArtifactStructure(sideEffect);\n   257\t    const secretMarker = selectScenarioSecretMarker(this.client);\n   258\t    let redacted: Record<string, unknown>;\n   259\t    try {\n   260\t      redacted = {\n   261\t        ...Object.fromEntries(Object.entries(payload).map(([key, value]) => [key, this.client.redact(value, {\n   262\t          ...SCENARIO_REDACTION_LIMITS,\n   263\t          // These are user payloads, even when their keys resemble an envelope.\n   264\t          preserveKeys: false,\n   265\t          redactionMarker: secretMarker ?? \"\",\n   266\t        })])),\n   267\t        formatVersion, kind: safeKind, sideEffect: safeSideEffect,\n   268\t      };\n   269\t    } catch {\n   270\t      return {\n   271\t        formatVersion,\n   272\t        kind: safeKind,\n   273\t        sideEffect: safeSideEffect,\n   274\t        name: \"\",\n   275\t        status: this.client.preserveArtifactStructure(\"incomplete\"),\n   215\t    kind: \"failed-open\", open: async () => { throw new Error(\"cannot open\"); }, cleanup,\n   216\t  }) });\n   217\t  expect(report.ok).toBe(false);\n   218\t  expect(cleanup).toHaveBeenCalledOnce();\n   219\t  expect(report.incompleteReason).not.toContain(\"Target cleanup failed\");\n   220\t});\n   221\t\n   222\t\n   223\tit.each([\"metadata\", \"failure\", \"throwing-redactor\"])(\"applies custom target redaction to finalized suite %s\", async mode => {\n   224\t  const secret = \"custom-owned-secret\";\n   225\t  const server = createMcpFnServer({\n   226\t    info: { name: secret, version: \"1.0.0\" },\n   227\t    registry: new McpFnRegistry().register({\n   228\t      name: \"visible-tool\", description: \"Fixture tool\", inputSchema: { type: \"object\" },\n   229\t      handler: async () => structuredResult({ ok: true }),\n   230\t    }),\n   231\t  });\n   232\t  const target = customTarget({\n   233\t    kind: \"custom\",\n   234\t    descriptor: { label: secret },\n   235\t    redact: <T>(value: T): T => {\n   236\t      if (mode === \"throwing-redactor\") throw new Error(secret);\n   237\t      const plain = value instanceof Error ? { name: value.name, message: value.message } : value;\n   238\t      return JSON.parse(JSON.stringify(plain).replaceAll(secret, \"[REDACTED]\")) as T;\n   239\t    },\n   240\t    open: async () => {\n   241\t      const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();\n   242\t      await server.connect(serverTransport);\n   243\t      return { transport: clientTransport, close: () => server.close() };\n   244\t    },\n   245\t  });\n   246\t  const report = await runMcpFnTargetSuite({\n   247\t    target,\n   248\t    ...(mode === \"failure\" ? { expectedToolNames: [secret] } : {}),\n   249\t  });\n   250\t  expect(JSON.stringify(report)).not.toContain(secret);\n   251\t  if (mode === \"metadata\") {\n   252\t    expect(report.ok).toBe(true);\n   253\t    expect(report.server?.name).toBe(\"[REDACTED]\");\n   254\t    expect(report.target.label).toBe(\"[REDACTED]\");\n   255\t  } else if (mode === \"failure\") {\n   256\t    expect(report.ok).toBe(false);\n   257\t    expect(report.failure?.message).toContain(\"[REDACTED]\");\n   258\t  } else {\n   259\t    expect(report.status).toBe(\"incomplete\");\n   260\t    expect(report.server).toBeUndefined();\n   261\t    expect(report.timeline).toEqual([]);\n   262\t  }\n   263\t});\n   264\t\n   265\tit(\"fails a custom target report closed when its dynamic kind conflicts with redaction\", async () => {\n   266\t  const secretKind = \"custom-kind-owned-secret\";\n   267\t  const server = createMcpFnServer({\n   268\t    info: { name: \"kind-collision\", version: \"1.0.0\" },\n   269\t    registry: new McpFnRegistry(),\n   270\t  });\n   271\t  const target = customTarget({\n   272\t    kind: secretKind,\n   273\t    redact: <T>(value: T): T => JSON.parse(\n   274\t      JSON.stringify(value).replaceAll(secretKind, \"[REDACTED]\"),\n   275\t    ) as T,\n   276\t    open: async () => {\n   277\t      const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();\n   278\t      await server.connect(serverTransport);\n   279\t      return { transport: clientTransport, close: () => server.close() };\n   280\t    },\n   281\t  });\n   282\t\n   283\t  const report = await runMcpFnTargetSuite({ target });\n   284\t\n   285\t  expect(report).toMatchObject({\n   286\t    ok: false,\n   287\t    status: \"incomplete\",\n   288\t    target: { kind: \"custom\" },\n   289\t  });\n   290\t  expect(report.incompleteReason).toContain(\"Credential redaction\");\n   291\t  expect(JSON.stringify(report)).not.toContain(secretKind);\n   292\t});\n   293\t\n   294\t\n   295\tit(\"transfers failed shutdown ownership and serializes safe cleanup retries\", async () => {\n   296\t  const secret = \"private-cleanup-secret\";\n   297\t  const server = createMcpFnServer({ info: { name: \"cleanup\", version: \"1\" }, registry: new McpFnRegistry() });\n   298\t  let fail = true;\n   299\t  const close = vi.fn(async () => { if (fail) throw new Error(secret); await server.close(); });\n   300\t  const target = customTarget({ kind: \"custom\", open: async () => {\n   301\t    const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();\n   302\t    await server.connect(serverTransport);\n   303\t    return { transport: clientTransport, close };\n   304\t  } });\n   305\t  const error = await runMcpFnTargetSuite({ target }).catch(error => error);\n   306\t  expect(error).toBeInstanceOf(McpFnTargetSuiteCleanupError);\n   307\t  expect(error.report.ok).toBe(false);\n   308\t  expect(error.message).not.toContain(secret);\n   309\t  expect(JSON.stringify(error.report)).not.toContain(secret);\n   310\t  const first = error.retryCleanup();\n   311\t  expect(error.retryCleanup()).toBe(first);\n   312\t  await expect(first).rejects.toBe(error);\n   313\t  fail = false;\n   314\t  await Promise.all([error.retryCleanup(), error.retryCleanup()]);\n   315\t  const calls = close.mock.calls.length;\n   316\t  await error.retryCleanup();\n   317\t  expect(close).toHaveBeenCalledTimes(calls);\n   318\t  expect(error.report.ok).toBe(false); // Immutable historical failure evidence.\n   319\t});\n   320\t\n   321\tit.each([\"complete\", \"passed\"])(\"keeps suite structure when a custom secret is %s\", async secret => {\n   322\t  const server = createMcpFnServer({ info: { name: secret, version: \"1\" }, registry: new McpFnRegistry() });\n   323\t  const report = await runMcpFnTargetSuite({ target: customTarget({ kind: \"custom\", descriptor: { label: secret },\n   324\t    redact: <T>(value: T): T => JSON.parse(JSON.stringify(value).replaceAll(secret, \"[REDACTED]\")),\n   325\t    open: async () => {\n   326\t      const [client, remote] = InMemoryTransport.createLinkedPair();\n   327\t      await server.connect(remote);\n   328\t      return { transport: client, close: () => server.close() };\n   329\t    },\n   330\t  }) });\n   331\t  expect(report.status).toBe(\"complete\");\n   332\t  expect(report.kind).toBe(\"mcpfn.target-suite-report\");\n   333\t  expect(report.passed).toBe(0);\n   334\t  expect(report.server?.name).toBe(\"[REDACTED]\");\n   335\t  expect(report.target.label).toBe(\"[REDACTED]\");\n   336\t});\n   337\t\n   338\tit(\"uses payload redaction for standalone suite projections\", async () => {\n   339\t  const secret = \"passed\";\n   340\t  const server = createMcpFnServer({\n   341\t    info: { name: secret, version: \"1\" },\n   342\t    registry: new McpFnRegistry().register({\n   343\t      name: secret,\n   344\t      description: \"Fixture tool\",\n   345\t      inputSchema: { type: \"object\" },\n   346\t      handler: async () => structuredResult({ ok: true }),\n   347\t    }),\n   348\t  });\n   349\t  const modes: Array<boolean | undefined> = [];\n   350\t  const report = await runMcpFnTargetSuite({\n   351\t    target: customTarget({\n   352\t      kind: \"custom\",\n   353\t      descriptor: { label: secret },\n   354\t      redact: <T>(value: T, options?: { preserveKeys?: boolean }): T => {\n   355\t        modes.push(options?.preserveKeys);\n   356\t        if (options?.preserveKeys !== false) return value;\n   357\t        return JSON.parse(JSON.stringify(value).replaceAll(secret, \"[REDACTED]\")) as T;\n   358\t      },\n   359\t      open: async () => {\n   360\t        const [client, remote] = InMemoryTransport.createLinkedPair();\n   361\t        await server.connect(remote);\n   362\t        return { transport: client, close: () => server.close() };\n   363\t      },\n   364\t    }),\n   365\t    scenarios: [{ name: secret, tool: secret }],\n   366\t  });\n   367\t\n   368\t  expect(modes).toContain(false);\n   369\t  expect(report.status).toBe(\"complete\");\n   370\t  expect(report.results[0]).toMatchObject({\n   371\t    status: \"passed\",\n   372\t    name: \"[REDACTED]\",\n   373\t    tool: \"[REDACTED]\",\n   374\t  });\n   375\t  expect(report.server?.name).toBe(\"[REDACTED]\");\n   376\t  expect(report.target.label).toBe(\"[REDACTED]\");\n   377\t});\n   378\t\n   379\tit(\"delivers diagnostics after exactly one custom redaction and bounds their retained bytes\", async () => {\n   380\t  const server = createMcpFnServer({ info: { name: \"diagnostics\", version: \"1\" }, registry: new McpFnRegistry() });\n   381\t  const observed: unknown[] = [];\n   382\t  let redactionCalls = 0;\n   383\t  const report = await runMcpFnTargetSuite({ maxReportBytes: 1024,\n   384\t    client: { diagnostics: event => { observed.push(event); } },\n   385\t    target: customTarget({ kind: \"custom\", redact: <T>(value: T): T => {\n   480\t  const persisted = JSON.parse(JSON.stringify(report));\n   481\t  const expected = amount instanceof Map\n   482\t    ? { type: \"Map\", entries: [[\"key\", \"evidence\"]] }\n   483\t    : { type: \"Set\", values: [\"evidence\"] };\n   484\t  expect(persisted.timeline.find((event: { details?: { amount?: unknown } }) =>\n   485\t    event.details?.amount !== undefined,\n   486\t  )?.details.amount).toEqual(expected);\n   487\t  expect(() => JSON.stringify(report)).not.toThrow();\n   488\t});\n   489\t\n   490\t\n   491\tit.each([\"stdio\", \"streamable-http\", \"authenticated-streamable-http\"])(\"preserves %s connection failure with an unchecked manifest\", async kind => {\n   492\t  const server = createMcpFnServer({ info: { name: \"manifest\", version: \"1\" }, registry: new McpFnRegistry() });\n   493\t  const report = await runMcpFnTargetSuite({ manifest: server.manifest(), target: customTarget({ kind,\n   494\t    open: async () => { throw new Error(\"Connection refused\"); },\n   495\t  }) });\n   496\t  expect(report.target.kind).toBe(kind);\n   497\t  expect(report.manifestChecked).toBe(false);\n   498\t  expect(report.manifestHash).toBeUndefined();\n   499\t  expect(report.failure?.phase).toBe(\"transport-connect\");\n   500\t  expect(report.incompleteReason).not.toContain(\"serialization\");\n   501\t  expect(report.ok).toBe(false);\n   502\t});\n   503\t\n   504\tit.each([\"throw\", \"proxy\"])(\"fails closed for a hostile live descriptor (%s)\", async mode => {\n   505\t  const secret = \"hostile-live-descriptor-secret\";\n   506\t  const server = createMcpFnServer({ info: { name: \"fixture\", version: \"1\" }, registry: new McpFnRegistry() });\n   507\t  const close = vi.fn(() => server.close());\n   508\t  const target = customTarget({ kind: \"custom\", open: async () => {\n   509\t    const [client, remote] = InMemoryTransport.createLinkedPair();\n   510\t    await server.connect(remote);\n   511\t    return { transport: client, close };\n   512\t  } });\n   513\t  target.describe = () => {\n   514\t    if (mode === \"throw\") throw new Error(secret);\n   515\t    return new Proxy({ kind: \"custom\" }, { ownKeys() { throw new Error(secret); } });\n   516\t  };\n   517\t  const report = await runMcpFnTargetSuite({ target });\n   518\t  expect(close).toHaveBeenCalledOnce();\n   519\t  expect(report).toMatchObject({ ok: false, status: \"incomplete\", target: { kind: \"custom\" }, results: [], timeline: [] });\n   520\t  expect(report.incompleteReason).toContain(\"safe serialization failed\");\n   521\t  expect(JSON.stringify(report)).not.toContain(secret);\n   522\t});\n   523\t\n   524\t\n   525\tit(\"marks reports incomplete when post-close credential redaction is unavailable\", async () => {\n   526\t  let released = false;\n   527\t  const server = createMcpFnServer({ info: { name: \"fixture\", version: \"1\" }, registry: new McpFnRegistry() });\n   528\t  const report = await runMcpFnTargetSuite({ target: customTarget({ kind: \"custom\",\n   529\t    redact: <T>(value: T): T => { if (released) throw new Error(\"private-redaction-state\"); return value; },\n   530\t    open: async () => {\n   531\t      const [client, remote] = InMemoryTransport.createLinkedPair();\n   532\t      await server.connect(remote);\n   533\t      return { transport: client, close: async () => { await server.close(); released = true; } };\n   534\t    },\n   535\t  }) });\n   536\t  expect(released).toBe(true);\n   537\t  expect(report.status).toBe(\"incomplete\");\n   538\t  expect(report.ok).toBe(false);\n   539\t  expect(report.failure).toBeUndefined();\n   540\t  expect(report.droppedTimelineEvents).toBeGreaterThan(0);\n   541\t  expect(report.incompleteReason).toContain(\"redaction failed\");\n   542\t  expect(report.timeline.some(event => event.code === \"MCPFN_DIAGNOSTIC_REDACTION_FAILED\")).toBe(false);\n   543\t  expect(JSON.stringify(report)).not.toContain(\"private-redaction-state\");\n   544\t});\n   545\t\n   546\t\n   547\tit(\"does not count a target-authored diagnostic code collision as an omission\", async () => {\n   548\t  const server = createMcpFnServer({ info: { name: \"fixture\", version: \"1\" }, registry: new McpFnRegistry() });\n   549\t  const target = customTarget({ kind: \"custom\", open: async context => {\n   550\t    await context.diagnostic({ phase: \"capability-operation\", outcome: \"succeeded\",\n","exit_code":0,"duration":{"secs":0,"nanos":1791},"formatted_output":"Warning: truncated output (original token count: 12752)\nTotal output lines: 984\n\n   360\t  } catch {\n   361\t    return { ...fallback, failure: \"serialization\" };\n   362\t  }\n   363\t}\n   364\t\n   365\tasync function closeSuiteClient(client: McpFnTestClient | undefined): Promise<{\n   366\t  cleanupFailure?: McpFnReportFailure;\n   367\t  retainedCleanup?: () => Promise<void>;\n   368\t}> {\n   369\t  try {\n   370\t    await client?.close();\n   371\t    return {};\n   372\t  } catch (error) {\n   373\t    let retainedCleanup: (() => Promise<void>) | undefined;\n   374\t    if (error instanceof McpFnTestClientCleanupError) {\n   375\t      retainedCleanup = () => error.retryCleanup();\n   376\t    } else if (client) {\n   377\t      retainedCleanup = () => client.close();\n   378\t    }\n   379\t    const terminal = error instanceof McpFnTestClientCleanupError && error.cause !== undefined\n   380\t      ? error.cause\n   381\t      : error;\n   382\t    const phase = terminal && typeof terminal === \"object\" &&\n   383\t        (terminal as { phase?: unknown }).phase === \"token-revocation\"\n   384\t      ? \"token-revocation\"\n   385\t      : \"transport-close\";\n   386\t    return {\n   387\t      retainedCleanup,\n   388\t      cleanupFailure: normalizeMcpFnReportFailure({\n   389\t        name: \"CleanupError\",\n   390\t        message: \"Target cleanup failed\",\n   391\t        code: \"MCPFN_TARGET_CLEANUP_FAILED\",\n   392\t        phase,\n   393\t      }),\n   394\t    };\n   395\t  }\n   396\t}\n   397\t\n   398\tasync function runTargetSuite(options: RunMcpFnTargetSuiteOptions): Promise<McpFnTargetSuiteReport> {\n   399\t  const maxTimelineEvents = options.maxTimelineEvents ?? 500;\n   400\t  if (!Number.isInteger(maxTimelineEvents) || maxTimelineEvents < 1) {\n   401\t    throw new Error(\"maxTimelineEvents must be a positive integer\");\n   402\t  }\n   403\t  const maxReportBytes = options.maxReportBytes ?? 1_048_576;\n   404\t  validateReportCap(maxReportBytes);\n   405\t  const consumerDiagnostic = options.client?.diagnostics;\n   406\t  const diagnostics = new SuiteDiagnosticCollector(\n   407\t    maxTimelineEvents,\n   408\t    maxReportBytes,\n   409\t    options.target,\n   410\t    consumerDiagnostic,\n   411\t  );\n   412\t  let client: McpFnTestClient | undefined;\n   413\t  let manifestChecked = false;\n   414\t  let failure: McpFnReportFailure | undefined;\n   415\t  let execution: SuiteExecution = { results: [] };\n   416\t  try {\n   417\t    client = McpFnTestClient.createTarget(\n   418\t      options.target,\n   419\t      options.clientInfo ?? { name: \"mcpfn-suite\", version: \"0.0.1\" },\n   420\t      {\n   421\t        ...options.client,\n   422\t        diagnostics: event => diagnostics.record(client, event),\n   423\t      },\n   424\t    );\n   425\t    diagnostics.captureBaseline(client);\n   426\t    await client.session.connect();\n   427\t    ({ execution, manifestChecked } = await executeConnectedSuite(client, options));\n   428\t  } catch (error) {\n   429\t    failure = safeTargetFailure(options.target, error);\n   430\t  }\n   431\t  // Custom hooks may depend on credentials cleared by close. Capture every\n   432\t  // target-controlled report value while the session still owns that state.\n   433\t  const projection = projectSuiteArtifacts(options, client, execution);\n   434\t  execution = projection.execution;\n   435\t  const { cleanupFailure: closeFailure, retainedCleanup } = await closeSuiteClient(client);\n   436\t  diagnostics.captureUnobserved(client);\n   437\t  let cleanupFailure = closeFailure;\n   438\t  cleanupFailure ??= diagnostics.cleanupFailure;\n   439\t  failure ??= cleanupFailure;\n   440\t  const results = execution.results;\n   441\t  const failed = results.filter((result) => result.status === \"failed\").length;\n   442\t  const incomplete = results.filter((result) => result.status === \"incomplete\").length;\n   443\t  const droppedObservedEvents = results.reduce(\n   444\t    (total, result) => total + (result.droppedObservedEvents ?? 0),\n   445\t    0,\n   446\t  );\n   447\t  const redactionOmittedObservedEvents = results.reduce(\n   448\t    (total, result) => total + (result.redactionOmittedObservedEvents ?? 0),\n   449\t    0,\n   450\t  );\n   451\t  const overflowedObservedEvents = droppedObservedEvents - redactionOmittedObservedEvents;\n   452\t  const artifactIncomplete = Boolean(failure) || incomplete > 0 ||\n   453\t    diagnostics.dropped > 0 ||\n   454\t    droppedObservedEvents > 0;\n   455\t  const report: McpFnTargetSuiteReport = {\n   456\t    formatVersion: 1,\n   457\t    kind: \"mcpfn.target-suite-report\",\n   458\t    status: artifactIncomplete ? \"incomplete\" : \"complete\",\n   459\t    runtime: {\n   460\t      node: process.version,\n   461\t      scenarioFormatVersion: 1,\n   462\t      reportSchemaVersion: MCPFN_REPORT_SCHEMA_VERSION,\n   463\t      packages: { testing: MCPFN_TESTING_VERSION },\n   464\t    },\n   465\t    ok: failed === 0 && !artifactIncomplete,\n   466\t    target: projection.target,\n   467\t    server: execution.server,\n   468\t    capabilities: execution.capabilities,\n   469\t    manifestChecked,\n   470\t    ...(projection.manifestHash === undefined ? {} : { manifestHash: projection.manifestHash }),\n   471\t    total: results.length,\n   472\t    passed: results.length - failed - incomplete,\n   473\t    failed,\n   474\t    incomplete,\n   475\t    droppedResults: 0,\n   476\t    droppedObservedEvents,\n   477\t    ...(redactionOmittedObservedEvents > 0 ? { redactionOmittedObservedEvents } : {}),\n   478\t    ...(failure || diagnostics.dropped > 0 || droppedObservedEvents > 0\n   479\t      ? {\n   480\t        incompleteReason: [\n   481\t          ...(failure ? [`${failure.layer}: ${failure.message}`] : []),\n   482\t          ...(cleanupFailure ? [`Cleanup: ${cleanupFailure.message}`] : []),\n   483\t          ...(diagnostics.serializationFailed ? [\"Diagnostic timeline contained non-JSON data\"] : []),\n   484\t          ...(diagnostics.redactionFailed ? [\"Diagnostic timeline redaction failed; original events omitted\"] : []),\n   485\t          ...(diagnostics.countExceeded ? [\"Diagnostic timeline exceeded maxTimelineEvents\"] : []),\n   486\t          ...(diagnostics.bytesExceeded ? [\"Diagnostic timeline exceeded maxReportBytes\"] : []),\n   487\t          ...(redactionOmittedObservedEvents > 0\n   488\t            ? [\"Observed client events were omitted because credential redaction failed\"]\n   489\t            : []),\n   490\t          ...(overflowedObservedEvents > 0\n   491\t            ? [\"Observed client events exceeded maxObservedEvents\"]\n   492\t            : []),\n   493\t        ].join(\"; \"),\n   494\t      }\n   495\t      : {}),\n   496\t    ...(failure ? { failure } : {}),\n   497\t    timeline: diag