upplement.json').read_text());assert s1['originalPlanSha256']==s2['originalPlanSha256']==sha((A/'reviewed-candidate-plan.json').read_bytes());assert s2['precedingSupplementSha256']==sha((A/'composition-assessment-supplement.json').read_bytes());entries={**plan['entries'],**s1['entries'],**s2['entries']};V=pathlib.Path(plan['candidate']);assert V.resolve()==V and str(V).startswith('/Volumes/OS - Data/') and not (V/'.git').exists()\nL=json.loads((R/'parent-ledger.json').read_text());round=L['prs']['213']['current_sequential_round'];assert L['execution']['current_sequential_sweep']['active_pr']==213 and round['collection_count']==1 and round['publication_count']==0 and not round['completed'] and round['mode']=='architecture_reset';assert sha((A/'SKILL.md').read_bytes())=='78e6b66300287085d26e1cf15657a5010c6c93d0c2c23a9d4240064a6cdcd91c'\nfor family in ['docs.page-provider-path-and-payload','docs.consumer-conditional-runtime-ownership']:\n assert all(round['architecture_reset_assessment'][family].get(k) for k in ['invariant','old_head_evidence','coordinated_plan','independent_acceptance'])\nassert git('rev-parse','HEAD').decode().strip()==plan['head'] and git('branch','--show-current').decode().strip()=='codex/docs-extfn-20260926' and not git('status','--porcelain').strip()\nassert git('remote','get-url','origin').decode().strip()=='https://github.com/21nCo/super-functions.git'\nfor name in ['candidate-source-admission.json','candidate-source-application-start.json','candidate-source-application-receipt.json']:assert not (A/name).exists(),'one-shot output already present; inspect, never rerun'\nassert (A/'source-composition-pre-use-assessment.md').is_file()\nhistory=json.loads((A/'retained212-history-index.json').read_text());archive=A/'retained212-source-own-locks-installed-history.tar.gz';assert sha(archive.read_bytes())==history['archiveSha256'] and history['verifiedArchiveAndUnchangedOriginals']\nd=plistlib.loads(subprocess.check_output(['diskutil','info','-plist','/Volumes/OS - Data']));assert d['VolumeUUID']=='B86D5097-6E24-3D1D-A590-8CF9D44B6245' and d['Writable'] and shutil.disk_usage(V).free>=15*1024**3\nprior=json.loads((A.parent/'PR-212/producer-final-current-source-hashes-and-modes.json').read_text())\ndef physical(root,p):\n f=root/p;return os.readlink(f).encode() if f.is_symlink() else f.read_bytes() if f.is_file() else None\ndef mode(f):return '120000' if f.is_symlink() else '100755' if f.stat().st_mode&0o111 else '100644'\ndef tree(ref):\n rows={}\n for line in git('ls-tree','-rz','--full-tree',ref).split(b'\\0'):\n  if line:\n   meta,p=line.split(b'\\t',1);m,kind,oid=meta.decode().split();assert kind=='blob';rows[p.decode()]={'gitMode':m,'blob':oid}\n return rows\nbase=tree(plan['base']);head=tree(plan['head']);publication=tree(plan['relatedPublication'])\nfor p,r in prior.items():\n f=V/p;assert sha(physical(V,p))==r['sha256'],('retained212 drift',p)\n if r['sha256'] is not None:assert mode(f)==r['gitMode'],p\nfor p,r in entries.items():\n assert '..' not in pathlib.PurePosixPath(p).parts and not pathlib.PurePosixPath(p).is_absolute();assert not p.startswith(('.git/','.conduct/','.entire/')) and 'node_modules' not in pathlib.PurePosixPath(p).parts\n f=V/p;assert not f.is_symlink(),('source plan unexpected symlink',p)\n for parent in f.parents:\n  if parent==V:break\n  assert not parent.is_symlink(),('parent symlink',p)\n b=physical(V,p);assert sha(b)==r['beforeSha256'] and (stat.S_IMODE(f.stat().st_mode) if b is not None else None)==r['beforePosixMode'],p\n after=r['contents'].encode() if r['contents'] is not None else None;assert sha(after)==r['afterSha256'],p\n if b is not None:assert history['regularFiles']['root/'+p]['sha256']==sha(b) and history['regularFiles']['root/'+p]['mode']==r['beforePosixMode'],p\n assert r['gitMode'] in ['100644','100755'],p\nassert set(plan['original85'])=={x['filename'] for x in json.loads((A/'files.json').read_text())} and set(plan['original85'])<=set(entries)\n# Outside explicit plan every canonical byte/mode must be preparation42a, not unrelated212 features.\ncanonical=set(base)|set(head)|set(publication)|set(prior)|set(entries)\nfor p in sorted(canonical-set(entries)):\n row=base.get(p);b=git('cat-file','blob',row['blob']) if row else None;assert sha(physical(V,p))==sha(b),('outside plan not exact42a',p)\n if row:assert mode(V/p)==row['gitMode'],p\nlock=json.loads(entries['package-lock.json']['contents']);baseLock=json.loads(git('show',plan['base']+':package-lock.json'));delta=sorted(k for k in set(lock['packages'])|set(baseLock['packages']) if lock['packages'].get(k)!=baseLock['packages'].get(k));assert delta==plan['focusedLockMaps'] and len(delta)==35\nfor p in ['packages/db','secfn/core','secfn/server']:assert lock['packages'][p]==baseLock['packages'][p]\nfor product in ['authfn','filefn','extfn']:\n m=json.loads(entries[product+'/docs/package.json']['contents']);assert lock['packages'][product+'/docs']['dependencies']==m['dependencies'] and lock['packages'][product+'/docs']['devDependencies']==m['devDependencies'];assert m['devDependencies']['vitest']=='^3.2.4'\n# Own standalone roots/locks are untouched by this admission.\nS=V.parent/'standalone-current-npm11';assert not (S/'package.json').exists() and not (S/'node_modules').exists()\nfor product,c in history['contexts'].items():assert pathlib.Path(c['physicalPath'])==S/product/'docs' and sha((S/product/'docs/package-lock.json').read_bytes())==c['ownLockSha256'] and (S/product/'docs/node_modules').is_dir()\nout={'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'head':plan['head'],'base':plan['base'],'entries':len(entries),'original85Covered':True,'canonicalProjectedMembership':len(canonical),'outsidePlanExact42a':True,'focusedLockMaps':35,'sourceAdmissionOpen':True,'archiveVerifiedBeforeWrites':True,'standaloneConversionAdmitted':False,'installationGateOpen':False,'publicationGateOpen':False,'qualification':'Source application solely for independent local verification. Historical read/pre-use qualifications retained; generated artifacts provisional, no native/build/publication/merge acceptance inferred. Original plans remain immutable.'}\n(A/'candidate-source-admission.json').write_text(json.dumps(out,indent=2)+'\\n');(A/'candidate-source-application-start.json').write_text(json.dumps({'at':out['at'],'candidate':str(V),'sourceAdmissionSha256':sha((A/'candidate-source-admission.json').read_bytes()),'plannedChangedPaths':[p for p,r in entries.items() if r['beforeSha256']!=r['afterSha256']]},indent=2)+'\\n')\nchanged=[]\nfor p,r in sorted(entries.items()):\n if r['beforeSha256']==r['afterSha256']:continue\n f=V/p;assert sha(physical(V,p))==r['beforeSha256'],p;b=r['contents'].encode() if r['contents'] is not None else None\n if b is None:assert f.is_file();f.unlink()\n else:\n  f.parent.mkdir(parents=True,exist_ok=True);f.write_bytes(b);permissions=r['beforePosixMode'] if r['beforePosixMode'] is not None else 0o644;permissions=(permissions|0o111) if r['gitMode']=='100755' else permissions&~0o111;f.chmod(permissions)\n changed.append(p)\nfor p,r in entries.items():\n assert sha(physical(V,p))==r['afterSha256'],p\n if r['afterSha256'] is not None:assert mode(V/p)==r['gitMode'],p\nfor p in canonical-set(entries):\n row=base.get(p);b=git('cat-file','blob',row['blob']) if row else None;assert sha(physical(V,p))==sha(b),p\n if row:assert mode(V/p)==row['gitMode'],p\nfor product,c in history['contexts'].items():assert sha((S/product/'docs/package-lock.json').read_bytes())==c['ownLockSha256']\nassert git('rev-parse','HEAD').decode().strip()==plan['head'] and not git('status','--porcelain').strip()\nout.update({'candidate':str(V),'changedPaths':changed,'standaloneContextsUnchanged':True,'normalInstalls':0,'TcleanUnchanged':True});(A/'candidate-source-application-receipt.json').write_text(json.dumps(out,indent=2)+'\\n');print(json.dumps({k:v for k,v in out.items() if k!='changedPaths'},indent=2));print('changed',len(changed))\n"}}],"api":"openai