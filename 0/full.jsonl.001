ge.json\\\")\\n  cursor=$(jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.endCursor // empty' \\\"$snapshot_dir/threads-$page.json\\\")\\n  if [ \\\"$has_next\\\" != 'true' ]; then break; fi\\n  page=$((page + 1))\\ndone\\nGH_CONFIG_DIR=/Users/serro/.config/gh-other gh api --paginate --slurp repos/21nCo/super-functions/pulls/170/reviews > \\\"$snapshot_dir/reviews-pages.json\\\"\\nGH_CONFIG_DIR=/Users/serro/.config/gh-other gh api --paginate --slurp repos/21nCo/super-functions/issues/170/comments > \\\"$snapshot_dir/issue-comments-pages.json\\\"\\nGH_CONFIG_DIR=/Users/serro/.config/gh-other gh api --paginate --slurp repos/21nCo/super-functions/pulls/170/comments > \\\"$snapshot_dir/inline-comments-pages.json\\\"\\nGH_CONFIG_DIR=/Users/serro/.config/gh-other gh pr view 170 --repo 21nCo/super-functions --json state,headRefOid > \\\"$snapshot_dir/pr-end.json\\\"\\nprintf 'thread_pages=%s\\\\n' \\\"$page\\\"\\nprintf 'thread_count=%s\\\\n' \\\"$(jq -s '[.[].data.repository.pullRequest.reviewThreads.nodes[]] | length' \\\"$snapshot_dir\\\"/threads-*.json)\\\"\\nprintf 'nested_pending=%s\\\\n' \\\"$(jq -s '[.[].data.repository.pullRequest.reviewThreads.nodes[].comments.pageInfo.hasNextPage] | map(select(. == true)) | length' \\\"$snapshot_dir\\\"/threads-*.json)\\\"\\nprintf 'page_heads=%s\\\\n' \\\"$(jq -s '[.[].data.repository.pullRequest.headRefOid] | unique | join(\\\",\\\")' \\\"$snapshot_dir\\\"/threads-*.json)\\\"\\nprintf 'reviews=%s\\\\n' \\\"$(jq 'add | length' \\\"$snapshot_dir/reviews-pages.json\\\")\\\"\\nprintf 'issue_comments=%s\\\\n' \\\"$(jq 'add | length' \\\"$snapshot_dir/issue-comments-pages.json\\\")\\\"\\nprintf 'inline_comments=%s\\\\n' \\\"$(jq 'add | length' \\\"$snapshot_dir/inline-comments-pages.json\\\")\\\"\\nprintf 'snapshot_head=%s\\\\n' \\\"$(jq -r '.headRefOid' \\\"$snapshot_dir/pr-snapshot.json\\\")\\\"\\nprintf 'end=%s\\\\n' \\\"$(jq -c . \\\"$snapshot_dir/pr-end.json\\\")\\\"\",\"workdir\":\"/Users/serro/Documents/dev/n/worktrees/superfunctions/PR-170\",\"yield_time_ms\":30000,\"max_output_tokens\":20000}); text(r.output); if (r.session_id) text(`SESSION_ID=${r.session_id}`);\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a0c31e-6a96-7383-bda9-a191f2448a61","create_time":1789980009.616515}}}
