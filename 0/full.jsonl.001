 \"visible-tool\", description: \"Fixture tool\", inputSchema: { type: \"object\" },\n      handler: async () =\u003e structuredResult({ ok: true }),\n    }),\n  });\n  const target = customTarget({\n    kind: \"custom\",\n    descriptor: { label: secret },\n    redact: \u003cT\u003e(value: T): T =\u003e {\n      if (mode === \"throwing-redactor\") throw new Error(secret);\n      const plain = value instanceof Error ? { name: value.name, message: value.message } : value;\n      return JSON.parse(JSON.stringify(plain).replaceAll(secret, \"[REDACTED]\")) as T;\n    },\n    open: async () =\u003e {\n      const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();\n      await server.connect(serverTransport);\n      return { transport: clientTransport, close: () =\u003e server.close() };\n    },\n  });\n  const report = await runMcpFnTargetSuite({\n    target,\n    ...(mode === \"failure\" ? { expectedToolNames: [secret] } : {}),\n  });\n  expect(JSON.stringify(report)).not.toContain(secret);\n  if (mode === \"metadata\") {\n    expect(report.ok).toBe(true);\n    expect(report.server?.name).toBe(\"[REDACTED]\");\n    expect(report.target.label).toBe(\"[REDACTED]\");\n  } else if (mode === \"failure\") {\n    expect(report.ok).toBe(false);\n    expect(report.failure?.message).toContain(\"[REDACTED]\");\n  } else {\n    expect(report.status).toBe(\"incomplete\");\n    expect(report.server).toBeUndefined();\n    expect(report.timeline).toEqual([]);\n  }\n});\n\nit(\"fails a custom target report closed when its dynamic kind conflicts with redaction\", async () =\u003e {\n  const secretKind = \"custom-kind-owned-secret\";\n  const server = createMcpFnServer({\n    info: { name: \"kind-collision\", version: \"1.0.0\" },\n    registry: new McpFnRegistry(),\n  });\n  const target = customTarget({\n    kind: secretKind,\n    redact: \u003cT\u003e(value: T): T =\u003e JSON.parse(\n      JSON.stringify(value).replaceAll(secretKind, \"[REDACTED]\"),\n    ) as T,\n    open: async () =\u003e {\n      const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();\n      await server.connect(serverTransport);\n      return { transport: clientTransport, close: () =\u003e server.close() };\n    },\n  });\n\n  const report = await runMcpFnTargetSuite({ target });\n\n  expect(report).toMatchObject({\n    ok: false,\n    status: \"incomplete\",\n    target: { kind: \"custom\" },\n  });\n  expect(report.incompleteReason).toContain(\"Credential redaction\");\n  expect(JSON.stringify(report)).not.toContain(secretKind);\n});\n\n\nit(\"transfers failed shutdown ownership and serializes safe cleanup retries\", async () =\u003e {\n  const secret = \"private-cleanup-secret\";\n  const server = createMcpFnServer({ info: { name: \"cleanup\", version: \"1\" }, registry: new McpFnRegistry() });\n  let fail = true;\n  const close = vi.fn(async () =\u003e { if (fail) throw new Error(secret); await server.close(); });\n  const target = customTarget({ kind: \"custom\", open: async () =\u003e {\n    const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();\n    await server.connect(serverTransport);\n    return { transport: clientTransport, close };\n  } });\n  const error = await runMcpFnTargetSuite({ target }).catch(error =\u003e error);\n  expect(error).toBeInstanceOf(McpFnTargetSuiteCleanupError);\n  expect(error.report.ok).toBe(false);\n  expect(error.message).not.toContain(secret);\n  expect(JSON.stringify(error.report)).not.toContain(secret);\n  const first = error.retryCleanup();\n  expect(error.retryCleanup()).toBe(first);\n  await expect(first).rejects.toBe(error);\n  fail = false;\n  await Promise.all([error.retryCleanup(), error.retryCleanup()]);\n  const calls = close.mock.calls.length;\n  await error.retryCleanup();\n  expect(close).toHaveBeenCalledTimes(calls);\n  expect(error.report.ok).toBe(false); // Immutable historical failure evidence.\n});\n\nit.each([\"complete\", \"passed\"])(\"keeps suite structure when a custom secret is %s\", async secret =\u003e {\n  const server = createMcpFnServer({ info: { name: secret, version: \"1\" }, registry: new McpFnRegistry() });\n  const report = await runMcpFnTargetSuite({ target: customTarget({ kind: \"custom\", descriptor: { label: secret },\n    redact: \u003cT\u003e(value: T): T =\u003e JSON.parse(JSON.stringify(value).replaceAll(secret, \"[REDACTED]\")),\n    open: async () =\u003e {\n      const [client, remote] = InMemoryTransport.createLinkedPair();\n      await server.connect(remote);\n      return { transport: client, close: () =\u003e server.close() };\n    },\n  }) });\n  expect(report.status).toBe(\"complete\");\n  expect(report.kind).toBe(\"mcpfn.target-suite-report\");\n  expect(report.passed).toBe(0);\n  expect(report.server?.name).toBe(\"[REDACTED]\");\n  expect(report.target.label).toBe(\"[REDACTED]\");\n});\n\nit(\"uses payload redaction for standalone suite projections\", async () =\u003e {\n  const secret = \"passed\";\n  const server = createMcpFnServer({\n    info: { name: secret, version: \"1\" },\n    registry: new McpFnRegistry().register({\n      name: secret,\n      description: \"Fixture tool\",\n      inputSchema: { type: \"object\" },\n      handler: async () =\u003e structuredResult({ ok: true }),\n    }),\n  });\n  const modes: Array\u003cboolean | undefined\u003e = [];\n  const report = await runMcpFnTargetSuite({\n    target: customTarget({\n      kind: \"custom\",\n      descriptor: { label: secret },\n      redact: \u003cT\u003e(value: T, options?: { preserveKeys?: boolean }): T =\u003e {\n        modes.push(options?.preserveKeys);\n        if (options?.preserveKeys !== false) return value;\n        return JSON.parse(JSON.stringify(value).replaceAll(secret, \"[REDACTED]\")) as T;\n      },\n      open: async () =\u003e {\n        const [client, remote] = InMemoryTransport.createLinkedPair();\nmcpfn/testing/tests/remote-target.test.ts:49:  it(\"rejects plaintext remote credentials and removes descriptor query values\", () =\u003e {\nmcpfn/testing/tests/remote-target.test.ts:70:    expect(report.incompleteReason).toContain(\"Target cleanup failed\");\nmcpfn/testing/tests/remote-target.test.ts:131:      status: \"incomplete\",\nmcpfn/testing/tests/remote-target.test.ts:308:  expect(createMcpFnTargetSuiteJUnit({ ...redacted, target: { kind: \"custom\" }, runtime: { node: process.version }, status: \"complete\", total: 1, passed: 1, failed: 0, incomplete: 0, droppedResults: 0, droppedObservedEvents: 0, droppedTimelineEvents: 0 } as any)).not.toContain(\"\u003cfailure\");\nmcpfn/testing/tests/remote-target.test.ts:478:      scenarios: [{ name: \"incomplete\", tool: \"identity\", status: \"incomplete\", incompleteReason: \"x\".repeat(40) + secret }],\nmcpfn/testing/tests/remote-target.test.ts:481:    expect(report.results[0]?.status).toBe(\"incomplete\");\nmcpfn/testing/tests/remote-target.test.ts:496:    expect(report.status).toBe(\"incomplete\");\nmcpfn/testing/tests/remote-target.test.ts:556:it.each(['oversized', 'throwing-proxy'])(\"returns a safe incomplete report when error redaction encounters %s\", async mode =\u003e {\nmcpfn/testing/tests/remote-target.test.ts:565:    expect(report.status).toBe('incomplete');\nmcpfn/testing/tests/remote-target.test.ts:593:it.each([\"throw\", \"proxy\", \"long-secret\"])(\"captures a safe descriptor before its %s post-cleanup behavior\", async mode =\u003e {\nmcpfn/testing/tests/remote-target.test.ts:594:  const secret = \"opaque-descriptor-\" + \"z\".repeat(5000);\nmcpfn/testing/tests/remote-target.test.ts:610:    expect(JSON.stringify(report)).not.toContain(\"opaque-descriptor-\");\nmcpfn/testing/tests/remote-target.test.ts:630:it(\"marks the report incomplete when a credential matches the structural target kind\", async () =\u003e {\nmcpfn/testing/tests/remote-target.test.ts:637:    expect(report.status).toBe(\"incomplete\");\nmcpfn/testing/tests/remote-target.test.ts:638:    expect(report.incompleteReason).toContain(\"Credential redaction\");\nmcpfn/testing/tests/remote-target.test.ts:709:    expect(report.incompleteReason).toContain(\"Target cleanup failed\");\nmcpfn/inspector/tests/authenticated-artifacts.test.ts:290:it(\"marks an export incomplete when credential redaction collapses payload keys\", async () =\u003e {\nmcpfn/inspector/tests/authenticated-artifacts.test.ts:312:      status: \"incomplete\",\nmcpfn/inspector/tests/authenticated-artifacts.test.ts:313:      incompleteReason: \"Inspector export omitted payload because credential redaction failed\",\nmcpfn/inspector/tests/authenticated-artifacts.test.ts:336:it.each([\"connected\", \"passed\", \"logging.message\", \"custom\"])(\"redacts envelope-shaped scenario payloads containing %s\", async secret =\u003e {\nmcpfn/testing/tests/suite.test.ts:23:        descriptor: {\nmcpfn/testing/tests/suite.test.ts:65:  it(\"marks target reports incomplete when observed events exceed the scenario cap\", async () =\u003e {\nmcpfn/testing/tests/suite.test.ts:112:      status: \"incomplete\",\nmcpfn/testing/tests/suite.test.ts:114:      incompleteReason: \"Observed client events exceeded maxObservedEvents\",\nmcpfn/testing/tests/suite.test.ts:159:      status: \"incomplete\",\nmcpfn/testing/tests/suite.test.ts:162:      incompleteReason: \"Observed client events were omitted because credential redaction failed\",\nmcpfn/testing/tests/suite.test.ts:165:    expect(report.incompleteReason).not.toContain(\"maxObservedEvents\");\nmcpfn/testing/tests/suite.test.ts:169:it(\"marks otherwise successful suites incomplete when custom close rejects\", async () =\u003e {\nmcpfn/testing/tests/suite.test.ts:180:  expect(report.incompleteReason).toContain(\"Target cleanup failed\");\nmcpfn/testing/tests/suite.test.ts:188:  expect(report.status).toBe('incomplete');\nmcpfn/testing/tests/suite.test.ts:219:  expect(report.incompleteReason).not.toContain(\"Target cleanup failed\");\nmcpfn/testing/tests/suite.test.ts:223:it.each([\"metadata\", \"failure\", \"throwing-redactor\"])(\"applies custom target redaction to finalized suite %s\", async mode =\u003e {\nmcpfn/testing/tests/suite.test.ts:234:    descriptor: { label: secret },\nmcpfn/testing/tests/suite.test.ts:259:    expect(report.status).toBe(\"incomplete\");\nmcpfn/testing/tests/suite.test.ts:265:it(\"fails a custom target report closed when its dynamic kind conflicts with redaction\", async () =\u003e {\nmcpfn/testing/tests/suite.test.ts:287:    status: \"incomplete\",\nmcpfn/testing/tests/suite.test.ts:290:  expect(report.incompleteReason).toContain(\"Credential redaction\");\nmcpfn/testing/tests/suite.test.ts:323:  const report = await runMcpFnTargetSuite({ target: customTarget({ kind: \"custom\", descriptor: { label: secret },\nmcpfn/testing/tests/suite.test.ts:338:it(\"uses payload redaction for standalone suite projections\", async () =\u003e {\nmcpfn/testing/tests/suite.test.ts:353:      descriptor: { label: secret },\nmcpfn/testing/tests/suite.test.ts:379:it(\"delivers diagnostics after exactly one custom redaction and bounds their retained bytes\", async () =\u003e {\nmcpfn/testing/tests/suite.test.ts:385:    target: customTarget({ kind: \"custom\", redact: \u003cT\u003e(value: T): T =\u003e {\nmcpfn/testing/tests/suite.test.ts:409:  expect(report.incompleteReason).toContain(\"maxReportBytes\");\nmcpfn/testing/tests/suite.test.ts:410:  expect(report.incompleteReason).not.toContain(\"maxTimelineEvents\");\nmcpfn/testing/tests/suite.test.ts:416:it.each([1n, () =\u003e undefined, Symbol(\"diagnostic\"), undefined, NaN, Infinity])(\"marks unserializable diagnostic data as dropped and incomplete (%s)\", async amount =\u003e {\nmcpfn/testing/tests/suite.test.ts:430:  expect(report.status).toBe(\"incomplete\");\nmcpfn/testing/tests/suite.test.ts:434:  expect(report.incompleteReason).toContain(\"non-JSON data\");\nmcpfn/testing/tests/suite.test.ts:443:  const report = await runMcpFnTargetSuite({ target: customTarget({ kind: \"custom\", descriptor: { label: secret },\nmcpfn/testing/tests/suite.test.ts:500:  expect(report.incompleteReason).not.toContain(\"serialization\");\nmcpfn/testing/tests/suite.test.ts:504:it.each([\"throw\", \"proxy\"])(\"fails closed for a hostile live descriptor (%s)\", async mode =\u003e {\nmcpfn/testing/tests/suite.test.ts:505:  const secret = \"hostile-live-descriptor-secret\";\nmcpfn/testing/tests/suite.test.ts:519:  expect(report).toMatchObject({ ok: false, status: \"incomplete\", target: { kind: \"custom\" }, results: [], timeline: [] });\nmcpfn/testing/tests/suite.test.ts:520:  expect(report.incompleteReason).toContain(\"safe serialization failed\");\nmcpfn/testing/tests/suite.test.ts:525:it(\"marks reports incomplete when post-close credential redaction is unavailable\", async () =\u003e {\nmcpfn/testing/tests/suite.test.ts:537:  expect(report.status).toBe(\"incomplete\");\nmcpfn/testing/tests/suite.test.ts:541:  expect(report.incompleteReason).toContain(\"redaction failed\");\n","type":"input_text"}],"type":"custom_tool_call_output"}],"latest_token_usage_record":{"response_id":"resp_05349b17f5ad9d6a016aae7cd3eec487d09982b312ed32884c","root_turn_id":"01a0b992-9248-7613-95d3-df05acb573b9","session_id":"01a0b3f5-d570-7a72-b668-401efd539e3b","thread_id":"01a0b3f5-d570-7a72-b668-401efd539e3b","thread_token_usage":{"cache_write_input_tokens":0,"cached_input_tokens":88331520,"input_tokens":90762858,"output_tokens":371004,"reasoning_output_tokens":134308,"total_tokens":91133862},"turn_id":"01a0b992-9248-7613-95d3-df05acb573b9","turn_token_usage":{"cache_write_input_tokens":0,"cached_input_tokens":2664448,"input_tokens":2718785,"output_tokens":15398,"reasoning_output_tokens":5626,"total_tokens":2734183},"usage":{"cache_write_input_tokens":0,"cached_input_tokens":211840,"input_tokens":224083,"output_tokens":5030,"reasoning_output_tokens":0,"total_tokens":229113}},"message":"","previous_window_id":"01a0b91d-d6a5-7aa3-8eb4-d07185a4902e","replacement_history":[{"content":[{"tex