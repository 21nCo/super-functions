oid,'type':typ}\ndef blob(p,sha=BASE):\n result=subprocess.run(['git','-C',str(T),'show',sha+':'+p],capture_output=True)\n return result.stdout if result.returncode==0 else None\noriginal=json.loads((A/'original-full-pr-69-paths.json').read_text());assert len(original)==69\nwanted={};owners={}\ndef put(p,b,owner):wanted[p]=b;owners[p]=owner\n# All37 newly observed prerequisite paths stay exact, including test removals and release metadata.\nnewpaths=git('diff','--name-only',OLD,BASE).decode().splitlines();assert len(newpaths)==37\nfor p in newpaths:put(p,blob(p),'exact new prerequisite base42a')\n# Retained BotFn feature files are archived/restored to base, never admitted into210.\nfor p in authority:\n if p.startswith('botfn/docs/') or p.startswith('.github/') or p.startswith('scripts/cloudflare-docs/'):\n  put(p,blob(p),'restore exact newest base before original210 feature overlay')\nfor p in original:\n if p not in ['package-lock.json','filefn/docs/static/llms-full.txt']:\n  put(p,(T/p).read_bytes() if (T/p).is_file() else None,'complete original210 feature input')\nfor p in authority:\n if p.startswith(('authfn/docs/','filefn/docs/','scripts/docs-site/')) and p not in ['scripts/docs-site/LandingPage.svelte','scripts/docs-site/layout.ts','scripts/docs-site/llms.mjs','scripts/docs-site/vitest.config.ts']:\n  put(p,(V/p).read_bytes() if (V/p).is_file() else None,'reviewed related owner/page/Blog/LLM/caller correction')\n# Explicit original69 corpus disposition: keep newest-base bytes as generator input,\n# not omitted from69 coverage and not a frozen210 overwrite; regenerate in acceptance.\nput('filefn/docs/static/llms-full.txt',blob('filefn/docs/static/llms-full.txt'),'exact newest-base corpus input, pending normal current-base regeneration')\nassert set(original)<=set(wanted)|{'package-lock.json'}\n# Preserve original210 reduced motion/positive height and complete public-origin API.\nfor p in ['scripts/docs-site/LandingPage.svelte','scripts/docs-site/layout.ts','scripts/docs-site/llms.mjs','scripts/docs-site/vitest.config.ts']:\n put(p,(T/p).read_bytes(),'original210 correction preserved, scoped coordinated changes only')\ndef transform(p,fn,reason):\n before=wanted.get(p)\n if before is None:before=blob(p)\n assert before is not None,p\n after=fn(before.decode());assert isinstance(after,str)\n put(p,after.encode(),reason)\ndef replace_once(s,a,b):\n assert s.count(a)==1,(a,s.count(a));return s.replace(a,b,1)\ntransform('scripts/docs-site/llms.mjs',lambda s:replace_once(s,'.map((page) => [page.path, page.id.slice(\"docs:\".length)]));','.map((page) => [new URL(page.path, \"https://docs.invalid\").pathname, page.id.slice(\"docs:\".length)]));'),'preserve canonicalUrl option/return, add reviewed Unicode pathname normalization')\n# Source README only: copy four reviewed corrected examples, not unrelated published-reference copy policy.\ncore=(T/'clifn/core/README.md').read_text();ref=(T/'clifn/docs/content/docs/reference/core-readme.md').read_text()\nfor heading in ['## Conduct CLI-style usage','### `commander`','### `cac`','### `node:util.parseArgs`']:\n pattern=re.escape(heading)+r'\\n\\n```ts\\n(.*?)\\n```'\n old=re.search(pattern,core,re.S);new=re.search(pattern,ref,re.S);assert old and new,heading\n core=core[:old.start(1)]+new.group(1)+core[old.end(1):]\nput('clifn/core/README.md',core.encode(),'four already-corrected reference examples synchronize source; all other source README policy preserved')\n# Keep Node18-compatible original consumer tooling rather than borrowing private209 Vitest4.\nfor product in ['authfn','filefn','clifn']:\n p=f'{product}/docs/package.json';data=json.loads(wanted[p]);data['dependencies']['@searchfn/client']='0.3.0';data['devDependencies']['vitest']='^3.2.4'\n data['scripts']['test']='npm run check:llms && node --test ../../scripts/docs-site/check-built-site.test.mjs && vitest run --config ../../scripts/docs-site/vitest.config.ts'\n put(p,(json.dumps(data,indent=2)+'\\n').encode(),'actual decl