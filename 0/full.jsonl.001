').read_text());H=plan['head'];B=plan['base'];P=plan['relatedPublication'];git=lambda *a:subprocess.check_output(['git','-C',T,*a]);sha=lambda b:hashlib.sha256(b).hexdigest();entries={};patch=[]\nassert not (A/'composition-assessment-supplement.json').exists();assert git('rev-parse','HEAD').decode().strip()==H and not git('status','--porcelain').strip()\ndef put(p,s,reason):\n old=plan['entries'].get(p)\n if old:r=copy.deepcopy(old);before=old['contents'] or ''\n else:\n  f=pathlib.Path(plan['candidate'])/p;data=f.read_bytes() if f.exists() else None;r={'beforeSha256':sha(data) if data else None,'beforePosixMode':f.stat().st_mode&0o777 if data else None,'gitMode':'100644'};before=(git('show',B+':'+p).decode() if data else '')\n r.update({'afterSha256':sha(s.encode()),'contents':s,'owner':reason});entries[p]=r;patch.extend(difflib.unified_diff(before.splitlines(True),s.splitlines(True),fromfile='immutable-original-plan/'+p,tofile='explicit-supplement/'+p))\n# Preserve all original affected shared consumers, not a hard-coded three-product subset.\np='scripts/cloudflare-docs/select-products.mjs';s=git('show',H+':'+p).decode();s=s.replace('if (/^apifn\\\\/docsfn\\\\//.test(file)) return existingProductIds();','if (/^(apifn\\\\/docsfn|docsfn)\\\\//.test(file)) return existingProductIds();');assert 'scripts\\\\/docs-site\\\\/' in s and 'devfn/docs' not in s and '\"authfn\", \"extfn\", \"filefn\"' not in s;put(p,s,'full existingProductIds for shared runtime/SDK input; preserve frozen selector scope and current registration')\np='turbo.json';s=git('show',B+':'+p).decode();assert s.endswith('  }\\n}\\n');s=s[:-4]+',\\n  \"globalEnv\": [\"CLOUDFLARE_DOCS_DEPLOY\", \"CLOUDFLARE_DOCS_PUBLIC_ORIGIN\", \"CLOUDFLARE_DOCS_ASSETS_ORIGIN\"]\\n}\\n';json.loads(s);put(p,s,'same three role hash inputs, preserve reviewed42a existing formatting/tasks')\n# Complete the primary AuthFn public-origin siblings without regressing native generator guidance.\nfor name in ['index','claude','codex','cursor','llms-txt']:\n p=f'authfn/docs/content/docs/ai-resources/{name}.md';s=git('show',P+':'+p).decode().replace('https://authfn.superfunctions.dev','https://authfn.com/docs');put(p,s,'reviewed212 native LLM generation and endpoint guide plus explicit authoritative-host consistency')\n# Route inventory has no MCP/raw/skills/API/llms-rich handlers. No URL substitution can create them.\ntexts={\n'index':('AI Resources','Use FileFn documentation as assistant context without assuming unimplemented integrations.', '''FileFn provides generated documentation context at its configured publication URLs:\n\n- [Short index](https://filefn.com/docs/llms.txt)\n- [Full context](https://filefn.com/docs/llms-full.txt)\n\nSee [LLM artifacts](./llms-txt) for generation and local verification. A successful local build does not establish live hosting.\n\n| Guide | Scope |\n| --- | --- |\n| [Claude](./claude) | Repository instructions and documentation context. |\n| [Cursor](./cursor) | Project rules and documentation context. |\n| [Codex](./codex) | Repository-aware context and review. |\n| [MCP](./mcp) | Boundaries for an independently implemented integration. |\n| [Skills](./skills) | Application-owned recipes, not bundled executable tools. |\n'''),\n'llms-txt':('llms.txt','The two generated FileFn documentation context files and their native docs routes.', '''The site generates two text artifacts:\n\n| Configured publication URL | Content |\n| --- | --- |\n| `https://filefn.com/docs/llms.txt` | Page outline and links. |\n| `https://filefn.com/docs/llms-full.txt` | Full documentation context and configured API material. |\n\nThese are configured URLs, not a claim of live deployment. Native prerendered `/docs/llms.txt` and `/docs/llms-full.txt` routes publish the artifacts; root-level static copies are not the advertised docs-owner URLs. There is no `llms-rich.json` generator or endpoint in this site.\n\n## Generate and check\n\nPrepare the repository-owned dependencies and build from the repository root:\n\n```sh\nnpm exec -- turbo run build --filter=@filefn/docs\n```\n\nAfter prerequisites are built, from `filefn/docs`:\n\n```sh\nnpm run generate:llms\nnpm run check:llms\n```\n\nThe generator loads the consumer's published DocsFn configuration and filesystem provider, builds a manifest, and writes `static/llms.txt` and `static/llms-full.txt`. The shared builder passes `site.canonicalUrl`, uses the published `includeBlog: false` option, and retains the returned canonical URL. `check:llms` compares content without writing.\n\n## Use as context\n\nAn assistant that supports URL retrieval can use the configured URLs above. If it cannot fetch them, supply a generated local file through that tool's supported context interface. Generated sizes vary with content; use the outline for smaller context budgets.\n\nThe default local port is 6001:\n\n```text\nhttp://localhost:6001/docs/llms.txt\nhttp://localhost:6001/docs/llms-full.txt\n```\n\nDocumentation context does not authenticate an assistant, grant access to your FileFn server, or create [MCP tools](./mcp).\n'''),\n'claude':('Claude','Ground Claude in reviewed FileFn source and generated documentation context.', '''Use the generated [LLM context files](./llms-txt) through the context mechanism supported by your Claude client. For repository work, add project-specific instructions to `CLAUDE.md`:\n\n```md\n# FileFn project instructions\n\n- Read FileFn documentation at https://filefn.com/docs.\n- Inspect the installed package versions and public exports before changing configuration.\n- Keep file authorization, tenant context, and upload-session tokens intact.\n- Verify changes with this repository's tests before running them against live storage.\n```\n\nThese are instructions you own, not installed tools or an automatic workflow. This docs site does not implement a FileFn MCP endpoint or publish a verified tool list. See [MCP integration boundaries](./mcp) before registering any independently supplied service.\n'''),\n'cursor':('Cursor','Use FileFn documentation and project rules as Cursor context.', '''Supply the [LLM context files](./llms-txt) using the context interface supported by your Cursor version. Example project rules:\n\n```md\n# FileFn\n\nDocumentation: https://filefn.com/docs\n\n- Confirm installed @filefn/server and @filefn/client public contracts.\n- Preserve policy checks, tenant context, and server-side authorization.\n- Use CAS-capable stores.atomicKv when the FileFn server requires strict shared rate limits.\n- Run the project's type checks and tests; do not infer live readiness from a local build.\n```\n\nThis site does not implement a FileFn MCP service, expose executable skills, or guarantee editor-specific automatic discovery. [MCP integration](./mcp) and [recipes](./skills) require separate application ownership.\n'''),\n'codex':('Codex','Provide FileFn source and generated documentation context to coding agents.', '''Give your agent the [short index or full context](./llms-txt) through its supported URL or file context interface. Prefer inspected installed versions and repository source over guessed APIs.\n\nSuggested repository instructions:\n\n```md\nUse https://filefn.com/docs and the generated LLM context files for FileFn guidance.\nInspect the actual installed public exports before writing examples.\nPreserve policy, tenant, quota, and authorization checks.\nRun local tests before proposing changes; ask before operating live infrastructure.\n```\n\nThe native `/docs/search.json` route is a search index, not a `?q=` query API or MCP service. This docs site has no `/docs/<slug>/raw`, `/mcp`, `/skills/`, `/api/filefn.json`, or `llms-rich.json` route contract. Do not register tool wrappers against invented endpoints. Any independent tool service must define and verify its own schema, authentication, authorization, and deployment.\n'''),\n'mcp':('MCP integration boundaries','The current FileFn docs site does not implement an MCP server.', '''This FileFn docs site does not implement a `/mcp` endpoint. It does not publish `search_docs`, `fetch_page`, `get_route`, `get_error`, or executable skill tools. Changing a hostname in an editor configuration would not create those services.\n\nUse the generated [LLM context files](./llms-txt) or native documentation pages instead. The native `/docs/search.json` route supplies a search index, not a ready-made MCP tool protocol.\n\nIf your application provides a separate MCP service, use that application's verified endpoint and tool schema. Its operator owns authentication, authorization, request limits, data exposure, and deployment. Do not assume public documentation content authorizes tools to access or mutate your FileFn data.\n'''),\n'skills':('Application-owned recipes','Create and review local FileFn assistant recipes; no bundled executable skill endpoint is supplied.', '''The docs site does not publish executable FileFn skills, a `/skills/` endpoint, or `list_skills`/`run_skill` tools. Write recipes for your own assistant's documented skill format and review them as application code.\n\nA useful recipe can:\n\n1. Inspect installed FileFn versions and existing server configuration.\n2. Read the relevant [documentation](https://filefn.com/docs) or [LLM context files](./llms-txt).\n3. Propose a narrowly scoped configuration or processor change.\n4. Run the project's tests and type checks.\n5. Obtain separate authorization before operating live storage or infrastructure.\n\nFileFn policy checks and tenant authorization still apply. Assistant instructions are not credentials and do not bypass server-owned access control. Skill installation, discovery, and execution are specific to your assistant and are not implemented by this docs build.\n''')}\nfor name,(title,desc,body) in texts.items():\n s=f'---\\ntitle: {title}\\ndescription: {desc}\\n---\\n\\n# {title}\\n\\n{body}';put(f'filefn/docs/content/docs/ai-resources/{name}.md',s,'native-route-aware public-origin family: complete links and remove unsupported MCP/raw/rich/skills/deployment assertions; no new endpoint feature')\np='scripts/docs-site/atomic-write.test.mjs';s=(A/'proposed-atomic-write.test.mjs').read_text().replace('./proposed-atomic-llms.mjs','./llms.mjs');put(p,s,'controlled failure/ownership/check/mode tests; mocks explicitly scoped, independent native reader separate')\nfor product in ['authfn','filefn','extfn']:\n p=product+'/docs/package.json';s=plan['entries'][p]['contents'];assert 'node --test ../../scripts/docs-site/check-built-site.test.mjs' in s;s=s.replace('node --test ../../scripts/docs-site/check-built-site.test.mjs','node --test ../../scripts/docs-site/check-built-site.test.mjs ../../scripts/docs-site/atomic-write.test.mjs');put(p,s,'existing native test gates plus per-file atomic failure tests')\n# Script changes do not alter dependency maps; lock seed remains independently reviewed.\n(A/'composition-assessment-supplement.json').write_text(json.dumps({'originalPlanSha256':sha((A/'reviewed-candidate-plan.json').read_bytes()),'entries':entries,'sourceGateOpen':False,'installGateOpen':False,'publicationGateOpen':False,'standaloneContextConversionAdmitted':False},indent=2)+'\\n');(A/'composition-assessment-supplement.patch').write_text(''.join(patch));print(json.dumps({'supplementPaths':len(entries),'newBeyondOriginalPlan':sorted(set(entries)-set(plan['entries'])),'patchLines':len(patch),'sourceMutation':False},indent=2))\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":308,"output":3180,"cacheRead":115712,"cacheWrite":0,"reasoning":265,"totalTokens":119200,"cost":{"input":0.000616,"output":0.0318,"cacheRead":0.0115712,"cacheWrite":0,"total":0.043987200000000004}},"stopReason":"toolUse","timestamp":1791347771881,"responseId":"resp_055fb762f51dfcfc016ac5cc3c532487d0a274578f6df4ec1d","rawStopReason":"completed","thinkingLevel":"high"}}
