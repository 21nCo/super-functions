te and PKCE parameters for connection subjects\", async () =\u003e {\npackages/cli/src/__tests__/authfn-schema-discovery.test.ts:190:    const packageJson = JSON.parse(fs.readFileSync(authFnPackageJsonPath, 'utf-8'));\ndatafn/server/src/ws.ts:8: * SEC-001: Auth required via addClient authContext parameter\ndatafn/server/src/multi-region-routing.ts:73:  bodyDigest?: string;\ndatafn/server/src/multi-region-routing.ts:658:    const bodyDigest = prepared.bodyDigest;\ndatafn/server/src/multi-region-routing.ts:713:          ...(bodyDigest ? { bodyDigest } : {}),\ndatafn/server/src/multi-region-routing.ts:1565:        digest = await requestBodyDigest(\ndatafn/server/src/multi-region-routing.ts:1575:      if (digest !== claims.bodyDigest) throw new Error(\"routing assertion body digest mismatch\");\ndatafn/server/src/multi-region-routing.ts:1620:  bodyDigest?: string;\ndatafn/server/src/multi-region-routing.ts:1669:    bodyDigest: hash.digest(\"base64url\"),\ndatafn/server/src/multi-region-routing.ts:1694:async function requestBodyDigest(\ndatafn/server/__tests__/phase-08-envelopes-status-auth.test.ts:82:    it(\"passes parsed JSON body to authorize for POST endpoints\", async () =\u003e {\ndatafn/server/src/server.ts:1222:        // For POST/PUT/PATCH endpoints, parse JSON body FIRST before authorization\n   430\t  return { acquire: () =\u003e credential };\n   431\t}\n   432\t\n   433\t/** Acquire a credential and return an idempotent revoke-then-dispose lease. */\n   434\texport async function acquireRemoteCredential(\n   435\t  source: McpFnRemoteCredential | McpFnRemoteCredentialProvider,\n   436\t  context: McpFnRemoteCredentialContext,\n   437\t): Promise\u003cMcpFnRemoteCredentialLease\u003e {\n   438\t  let provider: McpFnRemoteCredentialProvider;\n   439\t  let acquired: McpFnRemoteCredential;\n   440\t  try {\n   441\t    provider = isCredentialProvider(source) ? source : staticRemoteCredentialProvider(source);\n   442\t    acquired = await provider.acquire(context);\n   443\t  } catch {\n   444\t    // Until acquisition returns, its opaque secrets are unknown to the redactor.\n   445\t    // The provider owns rollback of resources allocated before it rejects.\n   446\t    throw new Error(\"Target credential acquisition failed\");\n   447\t  }\n   448\t  let credential = acquired;\n   449\t  try {\n   450\t    // Detach all valid header forms from provider-owned mutable storage.\n   451\t    credential = { ...acquired, headers: boundedCredentialEntries(acquired.headers) };\n   452\t  } catch {\n   453\t    // Invalid headers are rejected by the caller's validation inside its cleanup\n   454\t    // boundary. Keep the acquired object so that rejection can still revoke it.\n   455\t  }\n   456\t  let releasePromise: Promise\u003cvoid\u003e | undefined;\n   457\t  let revoked = false;\n   458\t  let disposed = false;\n   459\t  let cleanupPhase: \"token-revocation\" | \"transport-close\" = credential.kind === \"oauth\"\n   460\t    ? \"token-revocation\"\n   461\t    : \"transport-close\";\n   462\t  return {\n   463\t    credential,\n   464\t    cleanupPhase: () =\u003e cleanupPhase,\n   465\t    release() {\n   466\t      releasePromise ??= (async () =\u003e {\n   467\t        // Cancellation of acquisition must not cancel revocation or its retries.\n   468\t        const cleanupContext = { ...context, signal: new AbortController().signal };\n   469\t        try {\n   470\t          // Provider-local state may be required to retry revocation.\n   471\t          if (!revoked) {\n   472\t            cleanupPhase = credential.kind === \"oauth\" ? \"token-revocation\" : \"transport-close\";\n   473\t            await provider.revoke?.(acquired, cleanupContext);\n   474\t            revoked = true;\n   475\t          }\n   476\t          if (!disposed) {\n   477\t            // Revocation already completed: a later disposal failure is not an\n   478\t            // authorization-server failure.\n   479\t            cleanupPhase = \"transport-close\";\n   480\t            await provider.dispose?.(acquired, cleanupContext);\n   481\t            disposed = true;\n   482\t          }\n   483\t        } catch {\n   484\t          throw new McpFnClientError(\n   485\t            \"MCPFN_OPERATION_FAILED\",\n   486\t            \"Target credential cleanup failed\",\n   487\t            { phase: cleanupPhase, retryable: true },\n   488\t          );\n   489\t        }\n   490\t      })().catch(error =\u003e { releasePromise = undefined; throw error; });\n   491\t      return releasePromise;\n   492\t    },\n   493\t  };\n   494\t}\n   495\t\n   496\t/**\n   497\t * A URL-plus-credential target for non-McpFn servers. It delegates MCP and\n   498\t * transport behavior to the production @mcpfn/client session engine.\n   499\t */\n   500\texport function authenticatedHttpTarget(\n   501\t  url: string | URL,\n   502\t  options: McpFnAuthenticatedHttpTargetOptions,\n   503\t): McpFnTarget {\n   504\t  const targetUrl = normalizeRemoteTargetUrl(url);\n   505\t  const descriptorUrl = new URL(targetUrl);\n   506\t  descriptorUrl.search = \"\";\n   507\t  const { credential: _credential, requestInit, ...transportOptions } = options;\n   508\t\n   509\t  const state: SecretState = { active: new Map(), scopes: new Set() };\n   510\t  const pendingReleases = new Set\u003c() =\u003e Promise\u003cvoid\u003e\u003e();\n","type":"input_text"}],"type":"custom_tool_call_output"}],"latest_token_usage_record":{"response_id":"resp_05349b17f5ad9d6a016ab0ee5562f487d0b9cafc2ea20c3ae3","root_turn_id":"01a0c31e-6a96-7383-bda9-a191f2448a61","session_id":"01a0b3f5-d570-7a72-b668-401efd539e3b","thread_id":"01a0b3f5-d570-7a72-b668-401efd539e3b","thread_token_usage":{"cache_write_input_tokens":0,"cached_input_tokens":96819712,"input_tokens":99643259,"output_tokens":414296,"reasoning_output_tokens":150253,"total_tokens":100057555},"turn_id":"01a0c31e-6a96-7383-bda9-a191f2448a61","turn_token_usage":{"cache_write_input_tokens":0,"c