,\n   307\t  \"trailer\",\n   308\t  \"transfer-encoding\",\n   309\t  \"upgrade\",\n   310\t]);\n   311\t\n   312\texport type McpFnRemoteCredentialKind = \"api-key\" | \"oauth\" | \"custom\";\n   313\t\n   314\texport interface McpFnRemoteCredential {\n   315\t  /** Credential headers are applied only to the fixed target origin. */\n   316\t  headers: HeadersInit;\n   317\t  kind?: McpFnRemoteCredentialKind;\n   318\t  label?: string;\n   319\t}\n   320\t\n   321\texport interface McpFnRemoteCredentialContext {\n   322\t  url: string;\n   323\t  requestId: string;\n   324\t  signal?: AbortSignal;\n   325\t}\n   326\t\n   327\t/**\n   328\t * Application-owned credential lifecycle for external MCP targets. McpFn\n   329\t * acquires once per target open, revokes before disposal, and never serializes\n   330\t * the returned headers into descriptors or reports. If acquisition rejects, the\n   331\t * provider must roll back its own partial resources; no lease has been returned.\n   332\t */\n   333\texport interface McpFnRemoteCredentialProvider {\n   334\t  acquire(\n   335\t    context: McpFnRemoteCredentialContext,\n   336\t  ): McpFnRemoteCredential | Promise<McpFnRemoteCredential>;\n   337\t  revoke?(\n   338\t    credential: McpFnRemoteCredential,\n   339\t    context: McpFnRemoteCredentialContext,\n   340\t  ): void | Promise<void>;\n   341\t  dispose?(\n   342\t    credential: McpFnRemoteCredential,\n   343\t    context: McpFnRemoteCredentialContext,\n   344\t  ): void | Promise<void>;\n   345\t}\n   346\t\n   347\texport interface McpFnRemoteCredentialLease {\n   348\t  credential: McpFnRemoteCredential;\n   349\t  release(): Promise<void>;\n   350\t  /** The lifecycle stage that most recently prevented credential release. */\n   351\t  cleanupPhase(): \"token-revocation\" | \"transport-close\";\n   352\t}\n   353\t\n   354\texport interface McpFnAuthenticatedHttpTargetOptions\n   355\t  extends Omit<McpFnStreamableHttpTargetOptions, \"authProvider\" | \"requestInit\"> {\n   356\t  credential: McpFnRemoteCredential | McpFnRemoteCredentialProvider;\n   357\t  requestInit?: Omit<RequestInit, \"headers\" | \"redirect\"> & { headers?: HeadersInit };\n   358\t}\n   359\t\n   360\t/** Create a provider for an already-bounded API key or OAuth-derived token. */\n   361\texport function staticRemoteCredentialProvider(\n   362\t  credential: McpFnRemoteCredential,\n   363\t): McpFnRemoteCredentialProvider {\n   364\t  return { acquire: () => credential };\n   365\t}\n   366\t\n   367\t/** Acquire a credential and return an idempotent revoke-then-dispose lease. */\n   368\texport async function acquireRemoteCredential(\n   369\t  source: McpFnRemoteCredential | McpFnRemoteCredentialProvider,\n   370\t  context: McpFnRemoteCredentialContext,\n   371\t): Promise<McpFnRemoteCredentialLease> {\n   372\t  let provider: McpFnRemoteCredentialProvider;\n   373\t  let acquired: McpFnRemoteCredential;\n   374\t  try {\n   375\t    provider = isCredentialProvider(source) ? source : staticRemoteCredentialProvider(source);\n   376\t    acquired = await provider.acquire(context);\n   377\t  } catch {\n   378\t    // Until acquisition returns, its opaque secrets are unknown to the redactor.\n   379\t    // The provider owns rollback of resources allocated before it rejects.\n   380\t    throw new Error(\"Target credential acquisition failed\");\n   381\t  }\n   382\t  let credential = acquired;\n   383\t  try {\n   384\t    // Detach all valid header forms from provider-owned mutable storage.\n   385\t    credential = { ...acquired, headers: boundedCredentialEntries(acquired.headers) };\n   386\t  } catch {\n   387\t    // Invalid headers are rejected by the caller's validation inside its cleanup\n   388\t    // boundary. Keep the acquired object so that rejection can still revoke it.\n   389\t  }\n   390\t  let releasePromise: Promise<void> | undefined;\n   391\t  let revoked = false;\n   392\t  let disposed = false;\n   393\t  let cleanupPhase: \"token-revocation\" | \"transport-close\" = credential.kind === \"oauth\"\n   394\t    ? \"token-revocation\"\n   395\t    : \"transport-close\";\n   396\t  return {\n   397\t    credential,\n   398\t    cleanupPhase: () => cleanupPhase,\n   399\t    release() {\n   400\t      releasePromise ??= (async () => {\n   401\t        // Cancellation of acquisition must not cancel revocation or its retries.\n   402\t        const cleanupContext = { ...context, signal: new AbortController().signal };\n   403\t        try {\n   404\t          // Provider-local state may be required to retry revocation.\n   405\t          if (!revoked) {\n   406\t            cleanupPhase = credential.kind === \"oauth\" ? \"token-revocation\" : \"transport-close\";\n   407\t            await provider.revoke?.(acquired, cleanupContext);\n   408\t            revoked = true;\n   409\t          }\n   410\t          if (!disposed) {\n   411\t            // Revocation already completed: a later disposal failure is not an\n   412\t            // authorization-server failure.\n   413\t            cleanupPhase = \"transport-close\";\n   414\t            await provider.dispose?.(acquired, cleanupContext);\n   415\t            disposed = true;\n   416\t          }\n   417\t        } catch (error) {\n   418\t          throw new McpFnClientError(\n   419\t            \"MCPFN_OPERATION_FAILED\",\n   420\t            \"Target credential cleanup failed\",\n   421\t            { phase: cleanupPhase, retryable: true },\n   422\t          );\n   423\t        }\n   424\t      })().catch(error => { releasePromise = undefined; throw error; });\n   425\t      return releasePromise;\n   426\t    },\n   427\t  };\n   428\t}\n   429\t\n   430\t/**\n   431\t * A URL-plus-credential target for non-McpFn servers. It delegates MCP and\n   432\t * transport behavior to the production @mcpfn/client session engine.\n   433\t */\n   434\texport function authenticatedHttpTarget(\n   435\t  url: string | URL,\n   436\t  options: McpFnAuthenticatedHttpTargetOptions,\n   437\t): McpFnTarget {\n   438\t  const targetUrl = normalizeRemoteTargetUrl(url);\n   439\t  const descriptorUrl = new URL(targetUrl);\n   440\t  descriptorUrl.search = \"\";\n   441\t  const { credential: _credential, requestInit, ...transportOptions } = options;\n   442\t  void _credential;\n   443\t\n   444\t  const state: SecretState = { active: new Map(), scopes: new Set() };\n   445\t  const pendingReleases = new Set<() => Promise<void>>();\n   446\t  const authenticated = customTarget({\n   447\t    kind: \"authenticated-streamable-http\",\n   448\t    descriptor: {\n   449\t      url: descriptorUrl.toString(),\n   450\t      authenticated: true,\n   451\t    },\n   452\t    redact: (value, redaction) => redactTargetCredentials(authenticated, value, { preserveKeys: true, ...redaction }),\n   453\t    async cleanup() {\n   454\t      const results = await Promise.allSettled([...pendingReleases].map(release => release()));\n   455\t      const failures = results.filter((result): result is PromiseRejectedResult => result.status === \"rejected\");\n   456\t      const failure = failures.find(({ reason }) => reason && typeof reason === \"object\" &&\n   457\t        (reason as { phase?: unknown }).phase === \"token-revocation\") ?? failures[0];\n   458\t      if (failure) throw failure.reason;\n   459\t    },\n   460\t    async open(targetContext): Promise<McpFnTransportHandle> {\n   461\t      const context: McpFnRemoteCredentialContext = {\n   462\t        url: targetUrl.toString(),\n   463\t        requestId: targetContext.requestId,\n   464\t        signal: targetContext.signal,\n   465\t      };\n   466\t      const lease = await acquireRemoteCredential(options.credential, context);\n   467\t      const secrets = new Set<string>();\n   468\t      const release = async () => {\n   469\t        try { await lease.release(); }\n   470\t        catch (error) { pendingReleases.add(release); throw error; }\n   471\t        pendingReleases.delete(release);\n   472\t        {\n   473\t          for (const secret of secrets) {\n   474\t            const count = (state.active.get(secret) ?? 1) - 1;\n   475\t            if (count) state.active.set(secret, count); else state.active.delete(secret);\n   476\t          }\n   477\t          secrets.clear();\n   478\t        }\n   479\t      };\n   480\t      let handle: McpFnTransportHandle | undefined;\n   481\t      try {\n   482\t        for (const secret of credentialValues(lease.credential.headers)) {\n   483\t          secrets.add(secret);\n   484\t          state.active.set(secret, (state.active.get(secret) ?? 0) + 1);\n   485\t          for (const scope of state.scopes) scope.add(secret);\n   486\t        }\n   487\t        const credentialHeaders = validateRemoteCredentialHeaders(lease.credential.headers);\n   488\t        const headers = new Headers(requestInit?.headers);\n   489\t        credentialHeaders.forEach((value, name) => headers.set(name, value));\n   490\t        const target = streamableHttpTarget(targetUrl, {\n   491\t          ...transportOptions,\n   492\t          requestInit: {\n   493\t            ...requestInit,\n   494\t            headers,\n   495\t            // Fetch must not replay credentials to a redirect destination.\n   496\t            redirect: \"error\",\n   497\t          },\n   498\t        });\n   499\t        handle = await target.open(targetContext);\n   500\t      } catch (error) {\n   501\t        // Sanitize while the lease still supplies its immutable header snapshot.\n   502\t        // Cleanup removes active secrets before the client emits failed-open diagnostics.\n   503\t        let message = \"Authenticated target could not be opened\";\n   504\t        try { message = redactRemoteCredential(lease.credential, error instanceof Error ? error.message : String(error)); }\n   505\t        catch { /* Invalid or oversized credentials must not escape through diagnostics. */ }\n   506\t        pendingReleases.add(release);\n   507\t        await release();\n   508\t        throw new Error(message);\n   509\t      }\n   510\t\n   511\t      let closePromise: Promise<void> | undefined;\n   512\t      let transportClosed = false;\n   513\t      return {\n   514\t        transport: handle.transport,\n   515\t        finishAuthorization: handle.finishAuthorization,\n   516\t        terminateSession: handle.terminateSession,\n   517\t        close() {\n   518\t          closePromise ??= Promise.resolve().then(async () => {\n   519\t            // The client coordinator retains this handle until both stages finish.\n   520\t            // Never release authentication while transport shutdown still needs retry.\n   521\t            if (!transportClosed) {\n   522\t              if (handle!.close) await handle!.close();\n   523\t              else await handle!.transport.close();\n   524\t              transportClosed = true;\n   525\t            }\n   526\t            await release();\n   527\t          }).catch(async (error) => {\n   528\t            closePromise = undefined;\n   529\t            const phase = transportClosed ? lease.cleanupPhase() : \"transport-close\";\n   530\t            await targetContext.diagnostic({\n   531\t              phase, outcome: \"failed\", code: \"MCPFN_CREDENTIAL_CLEANUP_FAILED\",\n   532\t              requestId: targetContext.requestId, at: new Date().toISOString(),\n   533\t              target: { kind: \"authenticated-streamable-http\", url: descriptorUrl.toString() },\n   534\t              details: { message: \"Target credential cleanup failed\" },\n   535\t            });\n   536\t            throw error;\n   537\t          });\n   538\t          return closePromise;\n   539\t        },\n   540\t      };\n   541\t    },\n   542\t  });\n   543\t  targetSecrets.set(authenticated, state);\n   544\t  return authenticated;\n   545\t}\n   546\t\n   547\tfunction normalizeRemoteTargetUrl(value: string | URL): URL {\n   548\t  const url = new URL(value.toString());\n   549\t  if (url.protocol !== \"http:\" && url.protocol !== \"https:\") {\n   550\t    throw new TypeError(\"Authenticated MCP targets must use HTTP or HTTPS\");\n   551\t  }\n   552\t  if (url.protocol === \"http:\" && url.hostname !== \"[::1]\" &&\n   553\t      !/^127(?:\\.\\d{1,3}){3}$/.test(url.hostname)) {\n   554\t    throw new TypeError(\"Credential-bearing HTTP targets require a literal loopback address; use HTTPS remotely\");\n   555\t  }\n   556\t  if (url.username || url.password || url.hash) {\n   557\t    throw new TypeError(\n   558\t      \"Authenticated MCP target URLs must not contain userinfo or a fragment\",\n   559\t    );\n   560\t  }\n   561\t  return url;\n   562\t}\n   563\t\n   564\tfunction isCredentialProvider(\n   565\t  value: McpFnRemoteCredential | McpFnRemoteCredentialProvider,\n   566\t): value is McpFnRemoteCredentialProvider {\n   567\t  return \"acquire\" in value && typeof value.acquire === \"function\";\n   568\t}\n   569\t\n   570\tfunction boundedCredentialEntries(value: HeadersInit): Array<[string, string]> {\n   571\t  const entries: Array<[string, string]> = [];\n   572\t  let bytes = 0;\n   573\t  const append = (name: string, headerValue: string) => {\n   574\t    if (entries.length >= MAX_CREDENTIAL_HEADERS) throw new TypeError(\"Credential headers exceed the header limit\");\n   575\t    if (typeof name !== \"string\" || typeof headerValue !== \"string\") throw new TypeError(\"Credential header values must be strings\");\n   576\t    if (name.length > MAX_CREDENTIAL_HEADER_BYTES || headerValue.length > MAX_CREDENTIAL_HEADER_VALUE_BYTES) throw new TypeError(\"Credential header exceeds the value-size limit\");\n   577\t    if (new TextEncoder().encode(headerValue).byteLength > MAX_CREDENTIAL_HEADER_VALUE_BYTES) throw new TypeError(\"Credential header exceeds the value-size limit\");\n   578\t    bytes += new TextEncoder().encode(`${name}: ${headerValue}\\r\\n`).byteLength;\n   579\t    if (bytes > MAX_CREDENTIAL_HEADER_BYTES) throw new TypeError(\"Credential headers exceed the aggregate size limit\");\n   580\t    entries.push([name, headerValue]);\n   581\t  };\n   582\t  if (value instanceof Headers) value.forEach((v, k) => append(k, v));\n   583\t  else if (Array.isArray(value)) {\n   584\t    if (value.length > MAX_CREDENTIAL_HEADERS) throw new TypeError(\"Credential headers exceed the header limit\");\n   585\t    for (const entry of value) append(entry[0], entry[1]);\n   586\t  } else {\n   587\t    for (const name in value) if (Object.prototype.hasOwnProperty.call(value, name)) append(name, value[name]);\n   588\t  }\n   589\t  return entries;\n   590\t}\n   591\t\n   592\texport function validateRemoteCredentialHeaders(value: HeadersInit): Headers {\n   593\t  const headers = new Headers(boundedCredentialEntries(value));\n   594\t  const entries: Array<[string, string]> = [];\n   595\t  headers.forEach((headerValue, name) => entries.push([name, headerValue]));\n   596\t  if (entries.length === 0) {\n   597\t    throw new TypeError(\"Authenticated MCP targets require at least one credential header\");\n   598\t  }\n   599\t  if (entries.length > MAX_CREDENTIAL_HEADERS) {\n   600\t    throw new TypeError(`Credential headers exceed the ${MAX_CREDENTIAL_HEADERS}-header limit`);\n   601\t  }\n   602\t  let bytes = 0;\n   603\t  for (const [name, headerValue] of entries) {\n   604\t    if (!headerValue.trim()) throw new TypeError(\"Credential header values must not be blank\");\n   605\t    if (FORBIDDEN_CREDENTIAL_HEADERS.has(name)) {\n   606\t      throw new TypeError(`Credential header ${name} is not allowed`);\n   607\t    }\n   608\t    const valueBytes = new TextEncoder().encode(headerValue).byteLength;\n   609\t    if (valueBytes > MAX_CREDENTIAL_HEADER_VALUE_BYTES) {\n   610\t      throw new TypeError(`Credential header ${name} exceeds the value-size limit`);\n   611\t    }\n   612\t    if (new TextEncoder().encode(headerValue).byteLength > MAX_CREDENTIAL_HEADER_VALUE_BYTES) throw new TypeError(\"Credential header exceeds the value-size limit\");\n   613\t    bytes += new TextEncoder().encode(`${name}: ${headerValue}\\r\\n`).byteLength;\n   614\t  }\n   615\t  if (bytes > MAX_CREDENTIAL_HEADER_BYTES) {\n   616\t    throw new TypeError(\"Credential headers exceed the aggregate size limit\");\n   617\t  }\n   618\t  return headers;\n   619\t}\n   200\t    },\n   201\t  ];\n   202\t}\n   203\t\n   204\t/** Run the independently-configured hosted-authorization matrix. */\n   205\texport async function runHostedAuthorizationRegression(\n   206\t  target: McpFnHostedAuthorizationTargetAdapter,\n   207\t  fixtures: readonly McpFnHostedAuthorizationCase[],\n   208\t): Promise<McpFnHostedAuthorizationCaseResult[]> {\n   209\t  const results: McpFnHostedAuthorizationCaseResult[] = [];\n   210\t  for (const fixture of fixtures) {\n   211\t    results.push(await runHostedCase(target, fixture));\n   212\t  }\n   213\t  return results;\n   214\t}\n   215\t\n   216\tasync function runHostedCase(\n   217\t  target: McpFnHostedAuthorizationTargetAdapter,\n   218\t  fixture: McpFnHostedAuthorizationCase,\n   219\t): Promise<McpFnHostedAuthorizationCaseResult> {\n   220\t  let phase: McpFnHostedAuthorizationCaseResult[\"phase\"] = \"client-registration\";\n   221\t  let responseStatus: number | undefined;\n   222\t  try {\n   223\t    await target.prepareRegistration(structuredClone(fixture.registration));\n   224\t    phase = \"authorization-request\";\n   225\t    const authorization = new URL(\"authorize\", ensureTrailingSlash(target.issuer));\n   226\t    authorization.searchParams.set(\"response_type\", \"code\");\n   227\t    authorization.searchParams.set(\"client_id\", fixture.authorization.clientId);\n   228\t    authorization.searchParams.set(\"redirect_uri\", fixture.authorization.redirectUri);\n   229\t    authorization.searchParams.set(\n   230\t      \"code_challenge\",\n   231\t      derivePkceS256