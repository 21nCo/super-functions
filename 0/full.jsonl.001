{"timestamp":"2026-09-19T10:03:43.816Z","ordinal":4585,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b3f5-d570-7a72-b668-401efd539e3b","turn_id":"01a0b91a-027b-7173-bd75-a52040008bc7","item":{"type":"CommandExecution","id":"exec-d6d75154-a7dc-41da-91e3-4f22b5d4080b","process_id":"92737","command":["/bin/zsh","-lc","nl -ba mcpfn/testing/src/remote-target.ts | sed -n '1,640p'\nnl -ba mcpfn/testing/src/host-authorization.ts | sed -n '180,430p'\nnl -ba mcpfn/testing/src/reports.ts | sed -n '1,150p'\nnl -ba mcpfn/cli/src/index.ts | sed -n '110,150p;540,570p'\nnl -ba mcpfn/inspector/src/index.ts | sed -n '1,50p;260,290p'\nnl -ba mcpfn/testing/src/conformance.ts | sed -n '300,380p'\nnl -ba mcpfn/client/src/targets.ts | sed -n '25,50p'\nnl -ba mcpfn/test-support/authenticated-server.ts | sed -n '65,90p'\nnl -ba mcpfn/examples/external-http-server.mjs | sed -n '120,145p'"],"cwd":"file:///Users/serro/Documents/dev/n/worktrees/superfunctions/PR-170","parsed_cmd":[{"type":"read","cmd":"nl -ba mcpfn/testing/src/remote-target.ts","name":"remote-target.ts","path":"mcpfn/testing/src/remote-target.ts"},{"type":"read","cmd":"nl -ba mcpfn/testing/src/host-authorization.ts","name":"host-authorization.ts","path":"mcpfn/testing/src/host-authorization.ts"},{"type":"read","cmd":"nl -ba mcpfn/testing/src/reports.ts","name":"reports.ts","path":"mcpfn/testing/src/reports.ts"},{"type":"read","cmd":"nl -ba mcpfn/cli/src/index.ts","name":"index.ts","path":"mcpfn/cli/src/index.ts"},{"type":"read","cmd":"nl -ba mcpfn/inspector/src/index.ts","name":"index.ts","path":"mcpfn/inspector/src/index.ts"},{"type":"read","cmd":"nl -ba mcpfn/testing/src/conformance.ts","name":"conformance.ts","path":"mcpfn/testing/src/conformance.ts"},{"type":"read","cmd":"nl -ba mcpfn/client/src/targets.ts","name":"targets.ts","path":"mcpfn/client/src/targets.ts"},{"type":"read","cmd":"nl -ba mcpfn/test-support/authenticated-server.ts","name":"authenticated-server.ts","path":"mcpfn/test-support/authenticated-server.ts"},{"type":"read","cmd":"nl -ba mcpfn/examples/external-http-server.mjs","name":"external-http-server.mjs","path":"mcpfn/examples/external-http-server.mjs"}],"source":"unified_exec_startup","status":"completed","stdout":"     1\timport {\n     2\t  McpFnClientError,\n     3\t  customTarget,\n     4\t  streamableHttpTarget,\n     5\t  type McpFnStreamableHttpTargetOptions,\n     6\t  type McpFnTarget,\n     7\t  type McpFnTransportHandle,\n     8\t} from \"@mcpfn/client\";\n     9\t\n    10\timport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n    11\t\n    12\ttype SecretState = { active: Map<string, number>; scopes: Set<Set<string>> };\n    13\tconst targetSecrets = new WeakMap<McpFnTarget, SecretState>();\n    14\t\n    15\t/** Retain released credentials only for the lifetime of a report operation. */\n    16\texport function beginTargetCredentialRedaction(target: McpFnTarget): () => void {\n    17\t  const state = targetSecrets.get(target);\n    18\t  if (!state) return () => undefined;\n    19\t  const scope = new Set(state.active.keys());\n    20\t  state.scopes.add(scope);\n    21\t  return () => { state.scopes.delete(scope); scope.clear(); };\n    22\t}\n    23\t\n    24\tfunction credentialValues(headers: HeadersInit): Set<string> {\n    25\t  const values = boundedCredentialEntries(headers);\n    26\t  const secrets = new Set<string>();\n    27\t  for (const [header, raw] of values) {\n    28\t    if (typeof raw !== \"string\" || !raw.trim()) continue;\n    29\t    secrets.add(raw);\n    30\t    secrets.add(raw.trim());\n    31\t    const trimmed = raw.trim();\n    32\t    const separator = trimmed.search(/\\s/);\n    33\t    const scheme = separator > 0 ? trimmed.slice(0, separator).toLowerCase() : \"\";\n    34\t    const authorization = [\"authorization\", \"proxy-authorization\"].includes(header.toLowerCase());\n    35\t    // Authorization headers carry schemes, including supported custom ones.\n    36\t    // Other credential headers are opaque even when their values contain spaces.\n    37\t    if (authorization && separator > 0) {\n    38\t      const token = trimmed.slice(separator).trim();\n    39\t      if (token) secrets.add(token);\n    40\t      if (scheme === \"basic\" && /^[A-Za-z0-9+/]+={0,2}$/.test(token)) {\n    41\t        const decoded = Buffer.from(token, \"base64\");\n    42\t        // Round-trip validation avoids interpreting malformed tokens as credentials.\n    43\t        if (decoded.toString(\"base64\").replace(/=+$/, \"\") === token.replace(/=+$/, \"\")) {\n    44\t          for (const encoding of [\"utf8\", \"latin1\"] as const) {\n    45\t            const pair = decoded.toString(encoding);\n    46\t            const colon = pair.indexOf(\":\");\n    47\t            if (colon < 0) continue;\n    48\t            for (const value of [pair, pair.slice(0, colon), pair.slice(colon + 1)]) {\n    49\t              if (value) secrets.add(value);\n    50\t            }\n    51\t          }\n    52\t        }\n    53\t      }\n    54\t    }\n    55\t    if (header.toLowerCase() === \"cookie\") {\n    56\t      // Cookie values are independently reflectable even though the request\n    57\t      // authenticates with the complete header. RFC 6265 cookie values cannot\n    58\t      // contain comma or semicolon, so both delimiters safely cover combined\n    59\t      // Headers entries as well as the normal Cookie serialization.\n    60\t      for (const part of raw.split(/[;,]/)) {\n    61\t        const pair = part.trim();\n    62\t        if (!pair) continue;\n    63\t        const equals = pair.indexOf(\"=\");\n    64\t        if (equals < 1) {\n    65\t          throw new TypeError(\"Cookie credential headers must contain name=value pairs\");\n    66\t        }\n    67\t        const value = pair.slice(equals + 1).trim();\n    68\t        if (!value) continue;\n    69\t        secrets.add(value);\n    70\t        if (value.startsWith('\"') || value.endsWith('\"')) {\n    71\t          if (value.length < 2 || !value.startsWith('\"') || !value.endsWith('\"')) {\n    72\t            throw new TypeError(\"Cookie credential values must use balanced quotes\");\n    73\t          }\n    74\t          const unquoted = value.slice(1, -1);\n    75\t          if (unquoted.includes('\"') || unquoted.includes(\"\\\\\")) {\n    76\t            throw new TypeError(\"Cookie credential values must use RFC 6265 syntax\");\n    77\t          }\n    78\t          if (unquoted) secrets.add(unquoted);\n    79\t        }\n    80\t      }\n    81\t    }\n    82\t  }\n    83\t  return secrets;\n    84\t}\n    85\t\n    86\texport class McpFnRedactionLimitError extends Error {\n    87\t  constructor(message = \"Credential redaction exceeded its traversal budget\") { super(message); }\n    88\t}\n    89\t\n    90\t/** No typed artifact can preserve this authored key without exposing a credential. */\n    91\texport class McpFnStructuralCredentialCollisionError extends McpFnRedactionLimitError {\n    92\t  constructor() {\n    93\t    super(\"Credential collides with a required structural artifact key\");\n    94\t  }\n    95\t}\n    96\t\n    97\t// Only these locally authored envelope paths retain structural keys. Unknown\n    98\t// children (including inspector events and server metadata) are always payloads.\n    99\tconst envelopeKeys: Record<string, Set<string>> = Object.fromEntries(Object.entries({\n   100\t  root: \"formatVersion kind status runtime ok target server capabilities manifestChecked manifestHash total passed failed incomplete droppedResults droppedObservedEvents redactionOmittedObservedEvents incompleteReason failure timeline droppedTimelineEvents results count clientState tools resources resourceTemplates prompts droppedEvents timelineComplete droppedInventoryEntries inventoryComplete suiteVersion exitCode stdout stderr phase outcome code requestId at details payload\",\n   101\t  result: \"formatVersion name operation tool status sideEffect durationMs error droppedObservedEvents redactionOmittedObservedEvents\",\n   102\t  diagnostic: \"phase outcome code requestId at target details\",\n   103\t  inspectorEvent: \"formatVersion source kind at event\",\n   104\t  failure: \"name message layer code phase details\",\n   105\t  runtime: \"node scenarioFormatVersion reportSchemaVersion packages\",\n   106\t  packages: \"testing\",\n   107\t  droppedInventoryEntries: \"tools resources resourceTemplates prompts\",\n   108\t  target: \"kind\",\n   109\t}).map(([role, keys]) => [role, new Set(keys.split(\" \"))]));\n   110\t\n   111\tfunction specialValue(input: unknown): unknown {\n   112\t  if (input instanceof Error) {\n   113\t    // Error instances may expose attacker-controlled enumerable keys. A\n   114\t    // null-prototype accumulator keeps `__proto__` as ordinary payload data.\n   115\t    const normalized = Object.create(null) as Record<string, unknown>;\n   116\t    let enumerableFields = 0;\n   117\t    for (const key in input) {\n   118\t      if (!Object.hasOwn(input, key)) continue;\n   119\t      if (++enumerableFields > 100_000) throw new McpFnRedactionLimitError();\n   120\t      normalized[key] = (input as unknown as Record<string, unknown>)[key];\n   121\t    }\n   122\t    normalized.name = input.name;\n   123\t    normalized.message = input.message;\n   124\t    normalized.stack = input.stack;\n   125\t    if (input.cause !== undefined) normalized.cause = input.cause;\n   126\t    return normalized;\n   127\t  }\n   128\t  if (input instanceof Date) return Number.isNaN(input.getTime()) ? \"Invalid Date\" : input.toISOString();\n   129\t  if (input instanceof URL) return input.href;\n   130\t  if (input instanceof Map) {\n   131\t    if (Object.getOwnPropertyDescriptor(Map.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   132\t    return { type: \"Map\", entries: [...Map.prototype.entries.call(input)] };\n   133\t  }\n   134\t  if (input instanceof Set) {\n   135\t    if (Object.getOwnPropertyDescriptor(Set.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   136\t    return { type: \"Set\", values: [...Set.prototype.values.call(input)] };\n   137\t  }\n   138\t  return input;\n   139\t}\n   140\t\n   141\tfunction scrubCredentials<T>(value: T, values: Iterable<string>, preserveKeys = false, redactionMarker?: string): T {\n   142\t  // Preserve whether a pattern came from opaque text or a serializer. Literal\n   143\t  // percent sequences in credentials must not acquire URL hex-case semantics.\n   144\t  const variants = [...values].filter(Boolean).flatMap(secret => [\n   145\t    { value: secret, encoded: false },\n   146\t    { value: JSON.stringify(secret).slice(1, -1), encoded: false },\n   147\t    { value: encodeURIComponent(secret), encoded: true },\n   148\t    { value: new URLSearchParams({ value: secret }).toString().slice(\"value=\".length), encoded: true },\n   149\t  ]).sort((a, b) => b.value.length - a.value.length);\n   150\t  let entries = 0, stringBytes = 0;\n   151\t  const budget = (input: unknown, depth = 0): void => {\n   152\t    input = specialValue(input);\n   153\t    if ((Array.isArray(input) && input.length > 100_000) || ++entries > 100_000 || depth > 32) throw new McpFnRedactionLimitError();\n   154\t    if (typeof input === \"string\") {\n   155\t      stringBytes += Buffer.byteLength(input);\n   156\t      if (input.length > 262_144 || stringBytes > 2_097_152) throw new McpFnRedactionLimitError();\n   157\t    } else if (input && typeof input === \"object\") {\n   158\t      for (const key in input) if (Object.hasOwn(input, key)) {\n   159\t        budget(key, depth + 1);\n   160\t        budget((input as Record<string, unknown>)[key], depth + 1);\n   161\t      }\n   162\t    }\n   163\t  };\n   164\t  // Check before either redactor allocates copies. Exceeding a budget is an\n   165\t  // explicit failure, never silent truncation of a typed report collection.\n   166\t  budget(value);\n   167\t  const patterns = variants.map(({ value, encoded }) => {\n   168\t    const literal = value.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n   169\t    // Only generated percent escapes accept mixed-case hex digits.\n   170\t    return encoded\n   171\t      ? literal.replace(/%[0-9A-Fa-f]{2}/g, escape => escape.replace(/[A-Fa-f]/g, hex => `[${hex.toLowerCase()}${hex.toUpperCase()}]`))\n   172\t      : literal;\n   173\t  });\n   174\t  const secretPattern = patterns.length ? new RegExp(patterns.join(\"|\"), \"g\") : undefined;\n   175\t  const replacementPattern = patterns.length ? new RegExp(patterns.join(\"|\")) : undefined;\n   176\t  const preserveStructural = (input: string): string => {\n   177\t    if (replacementPattern?.test(input)) {\n   178\t      throw new McpFnRedactionLimitError(\n   179\t        \"Credential collides with a required structural artifact field\",\n   180\t      );\n   181\t    }\n   182\t    return input;\n   183\t  };\n   184\t  const preserveStructuralKey = (input: string): string => {\n   185\t    if (replacementPattern?.test(input)) {\n   186\t      throw new McpFnStructuralCredentialCollisionError();\n   187\t    }\n   188\t    return input;\n   189\t  };\n   190\t  // A requested marker is itself output and must not reproduce a credential.\n   191\t  if (secretPattern) {\n   192\t    const markerContainsSecret = secretPattern.test(redactionMarker ?? \"[REDACTED]\");\n   193\t    secretPattern.lastIndex = 0;\n   194\t    if (markerContainsSecret) redactionMarker = \"\";\n   195\t  }\n   196\t  const clientKinds = new Set([\"logging.message\", \"progress\", \"tasks.status\", \"resources.updated\", \"tools.list_changed\", \"resources.list_changed\", \"prompts.list_changed\", \"resources.subscribed\", \"resources.unsubscribed\", \"client.roots\", \"client.sampling\", \"client.elicitation\"]);\n   197\t  const scrub = (input: unknown, role = \"payload\", field = \"\", finalPass = false): unknown => {\n   198\t    input = specialValue(input);\n   199\t    if (typeof input === \"string\") {\n   200\t      if ((role === \"root\" || role === \"inspectorEvent\") && field === \"kind\" && clientKinds.has(input)) return preserveStructural(input);\n   201\t      if (role === \"root\" && field === \"clientState\" && [\"idle\", \"connecting\", \"authorization-required\", \"connected\", \"closing\", \"closed\"].includes(input)) return preserveStructural(input);\n   202\t      if (role === \"target\" && field === \"kind\" && [\"authenticated-streamable-http\", \"streamable-http\", \"stdio\", \"in-memory\", \"custom\"].includes(input)) return preserveStructural(input);\n   203\t      if ((role === \"packages\" && field === \"testing\") || (role === \"runtime\" && [\"node\", \"reportSchemaVersion\"].includes(field)) || (role === \"root\" && field === \"suiteVersion\")) return preserveStructural(input);\n   204\t      if ((role === \"root\" || role === \"result\") && field === \"status\" && [\"passed\", \"failed\", \"incomplete\", \"complete\"].includes(input)) return preserveStructural(input);\n   205\t      if ((role === \"root\" || role === \"diagnostic\") && field === \"outcome\" && [\"started\", \"succeeded\", \"failed\"].includes(input)) return preserveStructural(input);\n   206\t      if (role === \"root\" && field === \"kind\" && [\"mcpfn.target-suite-report\", \"mcpfn.inspector-snapshot\", \"mcpfn.official-conformance-report\"].includes(input)) return preserveStructural(input);\n   207\t      if ((role === \"root\" || role === \"diagnostic\" || role === \"failure\") && field === \"phase\" && [\"resource-discovery\", \"authorization-server-discovery\", \"client-registration\", \"authorization-request\", \"authorization-callback\", \"token-exchange\", \"token-refresh\", \"token-revocation\", \"transport-connect\", \"mcp-initialize\", \"capability-operation\", \"transport-close\"].includes(input)) return preserveStructural(input);\n   208\t      if (role === \"failure\" && field === \"layer\" && [\"mcpfn-preflight\", \"authorization-server\", \"resource-server\", \"mcp-initialization\", \"scenario\", \"upstream-conformance\"].includes(input)) return preserveStructural(input);\n   209\t      if (role === \"inspectorEvent\" && field === \"source\" && [\"diagnostic\", \"client\"].includes(input)) return preserveStructural(input);\n   210\t      if (role === \"result\" && field === \"sideEffect\" && [\"none\", \"idempotent\", \"non-idempotent\"].includes(input)) return preserveStructural(input);\n   211\t      // Whole-string rejection cannot compose another credential by joining pieces.\n   212\t      // Run after both redactors; never feed this result through another redactor.\n   213\t      if (finalPass) return replacementPattern?.test(input) ? \"\" : input;\n   214\t      return secretPattern ? input.replace(secretPattern, secret => {\n   215\t        const replacement = redactionMarker ?? (secret.length < 10 ? (secret.includes(\"*\") ? \"#\" : \"*\").repeat(secret.length) : \"[REDACTED]\");\n   216\t        // Every generated mask must be safe against the entire credential set.\n   217\t        return replacementPattern!.test(replacement) ? \"\" : replacement;\n   218\t      }) : input;\n   219\t    }\n   220\t    if (Array.isArray(input)) {\n   221\t      const result = input.map(entry => scrub(entry, role, \"\", finalPass));\n   222\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   223\t      return result;\n   224\t    }\n   225\t    if (input && typeof input === \"object\") {\n   226\t      const entries: Array<[string, unknown]> = [];\n   227\t      const keys = new Set<string>();\n   228\t      for (const [key, entry] of Object.entries(input)) {\n   229\t        const fixed = envelopeKeys[role]?.has(key) ?? false;\n   230\t        if (fixed) preserveStructuralKey(key);\n   231\t        let childRole = \"payload\";\n   232\t        if (fixed) {\n   233\t          if (key === \"results\") childRole = \"result\";\n   234\t          else if (key === \"timeline\") childRole = (value as any)?.kind === \"mcpfn.inspector-snapshot\" ? \"inspectorEvent\" : \"diagnostic\";\n   235\t          else if ([\"failure\", \"runtime\", \"packages\", \"droppedInventoryEntries\", \"target\"].includes(key)) childRole = key;\n   236\t          else if (role === \"inspectorEvent\" && key === \"event\") childRole = (input as { source?: string }).source === \"client\" ? \"root\" : \"diagnostic\";\n   237\t        }\n   238\t        const scrubbedKey = fixed ? key : scrub(key, \"payload\", \"\", finalPass) as string;\n   239\t        if (keys.has(scrubbedKey)) {\n   240\t          throw new McpFnRedactionLimitError(\n   241\t            \"Credential redaction created duplicate object keys\",\n   242\t          );\n   243\t        }\n   244\t        keys.add(scrubbedKey);\n   245\t        entries.push([\n   246\t          scrubbedKey,\n   247\t          typeof entry === \"string\"\n   248\t            ? scrub(entry, fixed ? role : \"payload\", key, finalPass)\n   249\t            : scrub(entry, childRole, \"\", finalPass),\n   250\t        ]);\n   251\t      }\n   252\t      const result = Object.fromEntries(entries);\n   253\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   254\t      return result;\n   255\t    }\n   256\t    return input;\n   257\t  };\n   258\t  const timelineEvent = value && typeof value === \"object\" && [\"client\", \"diagnostic\"].includes((value as { source?: string }).source ?? \"\");\n   259\t  const role = preserveKeys ? (timelineEvent ? \"inspectorEvent\" : \"root\") : \"payload\";\n   260\t  const scrubbed = scrub(value, role);\n   261\t  const generic = redactOAuthValue(scrubbed, { maxStringLength: 262_144, maxDepth: 64, maxArrayEntries: 100_000, maxObjectEntries: 100_000, ...(redactionMarker !== undefined ? { redactionMarker } : {}) });\n   262\t  const result = scrub(generic, role, \"\", true) as T;\n   263\t  assertPayloadSerialization(\n   264\t    result,\n   265\t    \"payload\",\n   266\t    true,\n   267\t    replacementPattern,\n   268\t  );\n   269\t  return result;\n   270\t}\n   271\t\n   272\tfunction assertPayloadSerialization(\n   273\t  value: unknown,\n   274\t  role: string,\n   275\t  finalPass: boolean,\n   276\t  credentialPattern: RegExp | undefined,\n   277\t): void {\n   278\t  if (!finalPass || role !== \"payload\" || !credentialPattern) return;\n   279\t  const serialized = JSON.stringify(value);\n   280\t  if (serialized !== undefined && credentialPattern.test(serialized)) {\n   281\t    throw new McpFnRedactionLimitError(\n   282\t      \"Credential redaction could not guarantee safe serialized output\",\n   283\t    );\n   284\t  }\n   285\t}\n   286\t\n   287\t/** Remove known opaque credential values as well as credential-shaped fields. */\n   288\texport function redactTargetCredentials<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean; redactionMarker?: string } = {}): T {\n   289\t  const state = targetSecrets.get(target);\n   290\t  return scrubCredentials(value, new Set([...(state?.active.keys() ?? []), ...[...(state?.scopes ?? [])].flatMap((scope) => [...scope])]), options.preserveKeys, options.redactionMarker);\n   291\t}\n   292\t\n   293\t/** Redact authenticated conformance output using the acquired credential. */\n   294\texport function redactRemoteCredential<T>(credential: McpFnRemoteCredential, value: T, options: { preserveKeys?: boolean } = {}): T {\n   295\t  return scrubCredentials(value, credentialValues(credential.headers), options.preserveKeys);\n   296\t}\n   297\t\n   298\tconst MAX_CREDENTIAL_HEADERS = 32;\n   299\tconst MAX_CREDENTIAL_HEADER_BYTES = 16_384;\n   300\tconst MAX_CREDENTIAL_HEADER_VALUE_BYTES = 8_192;\n   301\tconst FORBIDDEN_CREDENTIAL_HEADERS = new Set([\n   302\t  \"connection\",\n   303\t  \"content-length\",\n   304\t  \"host\",\n   305\t  \"proxy-connection\",\n   306\t  \"te\",\n   307\t  \"trailer\",\n   308\t  \"transfer-encoding\",\n   309\t  \"upgrade\",\n   310\t]);\n   311\t\n   312\texport type McpFnRemoteCredentialKind = \"api-key\" | \"oauth\" | \"custom\";\n   313\t\n   314\texport interface McpFnRemoteCredential {\n   315\t  /** Credential headers are applied only to the fixed target origin. */\n   316\t  headers: HeadersInit;\n   317\t  kind?: McpFnRemoteCredentialKind;\n   318\t  label?: string;\n   319\t}\n   320\t\n   321\texport interface McpFnRemoteCredentialContext {\n   322\t  url: string;\n   323\t  requestId: string;\n   324\t  signal?: AbortSignal;\n   325\t}\n   326\t\n   327\t/**\n   328\t * Application-owned credential lifecycle for external MCP targets. McpFn\n   329\t * acquires once per target open, revokes before disposal, and never serializes\n   330\t * the returned headers into descriptors or reports. If acquisition rejects, the\n   331\t * provider must roll back its own partial resources; no lease has been returned.\n   332\t */\n   333\texport interface McpFnRemoteCredentialProvider {\n   334\t  acquire(\n   335\t    context: McpFnRemoteCredentialContext,\n   336\t  ): McpFnRemoteCredential | Promise<McpFnRemoteCredential>;\n   337\t  revoke?(\n   338\t    credential: McpFnRemoteCredential,\n   339\t    context: McpFnRemoteCredentialContext,\n   340\t  ): void | Promise<void>;\n   341\t  dispose?(\n   342\t    credential: McpFnRemoteCredential,\n   343\t    context: McpFnRemoteCredentialContext,\n   344\t  ): void | Promise<void>;\n   345\t}\n   346\t\n   347\texport interface McpFnRemoteCredentialLease {\n   348\t  credential: McpFnRemoteCredential;\n   349\t  release(): Promise<void>;\n   350\t  /** The lifecycle stage that most recently prevented credential release. */\n   351\t  cleanupPhase(): \"token-revocation\" | \"transport-close\";\n   352\t}\n   353\t\n   354\texport interface McpFnAuthenticatedHttpTargetOptions\n   355\t  extends Omit<McpFnStreamableHttpTargetOptions, \"authProvider\" | \"requestInit\"> {\n   356\t  credential: McpFnRemoteCredential | McpFnRemoteCredentialProvider;\n   357\t  requestInit?: Omit<RequestInit, \"headers\" | \"redirect\"> & { headers?: HeadersInit };\n   358\t}\n   359\t\n   360\t/** Create a provider for an already-bounded API key or OAuth-derived token. */\n   361\texport function staticRemoteCredentialProvider(\n   362\t  credential: McpFnRemoteCredential,\n   363\t): McpFnRemoteCredentialProvider {\n   364\t  return { acquire: () => credential };\n   365\t}\n   366\t\n   367\t/** Acquire a credential and return an idempotent revoke-then-dispose lease. */\n   368\texport async function acquireRemoteCredential(\n   369\t  source: McpFnRemoteCredential | McpFnRemoteCredentialProvider,\n   370\t  context: McpFnRemoteCredentialContext,\n   371\t): Promise<McpFnRemoteCredentialLease> {\n   372\t  let provider: McpFnRemoteCredentialProvider;\n   373\t  let acquired: McpFnRemoteCredential;\n   374\t  try {\n   375\t    provider = isCredentialProvider(source) ? source : staticRemoteCredentialProvider(source);\n   376\t    acquired = await provider.acquire(context);\n   377\t  } catch {\n   378\t    // Until acquisition returns, its opaque secrets are unknown to the redactor.\n   379\t    // The provider owns rollback of resources allocated before it rejects.\n   380\t    throw new Error(\"Target credential acquisition failed\");\n   381\t  }\n   382\t  let credential = acquired;\n   383\t  try {\n   384\t    // Detach all valid header forms from provider-owned mutable storage.\n   385\t    credential = { ...acquired, headers: boundedCredentialEntries(acquired.headers) };\n   386\t  } catch {\n   387\t    // Invalid headers are rejected by the caller's validation inside its cleanup\n   388\t    // boundary. Keep the acquired object so that rejection can still revoke it.\n   389\t  }\n   390\t  let releasePromise: Promise<void> | undefined;\n   391\t  let revoked = false;\n   392\t  let disposed = false;\n   393\t  let cleanupPhase: \"token-revocation\" | \"transport-close\" = credential.kind === \"oauth\"\n   394\t    ? \"token-revocation\"\n   395\t    : \"transport-close\";\n   396\t  return {\n   397\t    credential,\n   398\t    cleanupPhase: () => cleanupPhase,\n   399\t    release() {\n   400\t      releasePromise ??= (async () => {\n   401\t        // Cancellation of acquisition must not cancel revocation or its retries.\n   402\t        const cleanupContext = { ...context, signal: new AbortController().signal };\n   403\t        try {\n   404\t          // Provider-local state may be required to retry revocation.\n   405\t          if (!revoked) {\n   406\t            cleanupPhase = credential.kind === \"oauth\" ? \"token-revocation\" : \"transport-close\";\n   407\t            await provider.revoke?.(acquired, cleanupContext);\n   408\t            revoked = true;\n   409\t          }\n   410\t          if (!disposed) {\n   411\t            // Revocation already completed: a later disposal failure is not an\n   412\t            // authorization-server failure.\n   413\t            cleanupPhase = \"transport-close\";\n   414\t            await provider.dispose?.(acquired, cleanupContext);\n   415\t            disposed = true;\n   416\t          }\n   417\t        } catch (error) {\n   418\t          throw new McpFnClientError(\n   419\t            \"MCPFN_OPERATION_FAILED\",\n   420\t            \"Target credential cleanup failed\",\n   421\t            { phase: cleanupPhase, retryable: true },\n   422\t          );\n   423\t        }\n   424\t      })().catch(error => { releasePromise = undefined; throw error; });\n   425\t      return releasePromise;\n   426\t    },\n   427\t  };\n   428\t}\n   429\t\n   430\t/**\n   431\t * A URL-plus-credential target for non-McpFn servers. It delegates MCP and\n   432\t * transport behavior to the production @mcpfn/client session engine.\n   433\t */\n   434\texport function authenticatedHttpTarget(\n   435\t  url: string | URL,\n   436\t  options: McpFnAuthenticatedHttpTargetOptions,\n   437\t): McpFnTarget {\n   438\t  const targetUrl = normalizeRemoteTargetUrl(url);\n   439\t  const descriptorUrl = new URL(targetUrl);\n   440\t  descriptorUrl.search = \"\";\n   441\t  const { credential: _credential, requestInit, ...transportOptions } = options;\n   442\t  void _credential;\n   443\t\n   444\t  const state: SecretState = { active: new Map(), scopes: new Set() };\n   445\t  const pendingReleases = new Set<() => Promise<void>>();\n   446\t  const authenticated = customTarget({\n   447\t    kind: \"authenticated-streamable-http\",\n   448\t    descriptor: {\n   449\t      url: descriptorUrl.toString(),\n   450\t      authenticated: true,\n   451\t    },\n   452\t    redact: (value, redaction) => redactTargetCredentials(authenticated, value, { preserveKeys: true, ...redaction }),\n   453\t    async cleanup() {\n   454\t      const results = await Promise.allSettled([...pendingReleases].map(release => release()));\n   455\t      const failures = results.filter((result): result is PromiseRejectedResult => result.status === \"rejected\");\n   456\t      const failure = failures.find(({ reason }) => reason && typeof reason === \"object\" &&\n   457\t        (reason as { phase?: unknown }).phase === \"token-revocation\") ?? failures[0];\n   458\t      if (failure) throw failure.reason;\n   459\t    },\n   460\t    async open(targetContext): Promise<McpFnTransportHandle> {\n   461\t      const context: McpFnRemoteCredentialContext = {\n   462\t        url: targetUrl.toString(),\n   463\t        requestId: targetContext.requestId,\n   464\t        signal: targetContext.signal,\n   465\t      };\n   466\t      const lease = await acquireRemoteCredential(options.credential, context);\n   467\t      const secrets = new Set<string>();\n   468\t      const release = async () => {\n   469\t        try { await lease.release(); }\n   470\t        catch (error) { pendingReleases.add(release); throw error; }\n   471\t        pendingReleases.delete(release);\n   472\t        {\n   473\t          for (const secret of secrets) {\n   474\t            const count = (state.active.get(secret) ?? 1) - 1;\n   475\t            if (count) state.active.set(secret, count); else state.active.delete(secret);\n   476\t          }\n   477\t          secrets.clear();\n   478\t        }\n   479\t      };\n   480\t      let handle: McpFnTransportHandle | undefined;\n   481\t      try {\n   482\t        for (const secret of credentialValues(lease.credential.headers)) {\n   483\t          secrets.add(secret);\n   484\t          state.active.set(secret, (state.active.get(secret) ?? 0) + 1);\n   485\t          for (const scope of state.scopes) scope.add(secret);\n   486\t        }\n   487\t        const credentialHeaders = validateRemoteCredentialHeaders(lease.credential.headers);\n   488\t        const headers = new Headers(requestInit?.headers);\n   489\t        credentialHeaders.forEach((value, name) => headers.set(name, value));\n   490\t        const target = streamableHttpTarget(targetUrl, {\n   491\t          ...transportOptions,\n   492\t          requestInit: {\n   493\t            ...requestInit,\n   494\t            headers,\n   495\t            // Fetch must not replay credentials to a redirect destination.\n   496\t            redirect: \"error\",\n   497\t          },\n   498\t        });\n   499\t        handle = await target.open(targetContext);\n   500\t      } catch (error) {\n   501\t        // Sanitize while the lease still supplies its immutable header snapshot.\n   502\t        // Cleanup removes active secrets before the client emits failed-open diagnostics.\n   503\t        let message = \"Authenticated target could not be opened\";\n   504\t        try { message = redactRemoteCredential(lease.credential, error instanceof Error ? error.message : String(error)); }\n   505\t        catch { /* Invalid or oversized credentials must not escape through diagnostics. */ }\n   506\t        pendingReleases.add(release);\n   507\t        await release();\n   508\t        throw new Error(message);\n   509\t      }\n   510\t\n   511\t      let closePromise: Promise<void> | undefined;\n   512\t      let transportClosed = false;\n   513\t      return {\n   514\t        transport: handle.transport,\n   515\t        finishAuthorization: handle.finishAuthorization,\n   516\t        terminateSession: handle.terminateSession,\n   517\t        close() {\n   518\t          closePromise ??= Promise.resolve().then(async () => {\n   519\t            // The client coordinator retains this handle until both stages finish.\n   520\t            // Never release authentication while transport shutdown still needs retry.\n   521\t            if (!transportClosed) {\n   522\t              if (handle!.close) await handle!.close();\n   523\t              else await handle!.transport.close();\n   524\t              transportClosed = true;\n   525\t            }\n   526\t            await release();\n   527\t          }).catch(async (error) => {\n   528\t            closePromise = undefined;\n   529\t            const phase = transportClosed ? lease.cleanupPhase() : \"transport-close\";\n   530\t            await targetContext.diagnostic({\n   531\t              phase, outcome: \"failed\", code: \"MCPFN_CREDENTIAL_CLEANUP_FAILED\",\n   532\t              requestId: targetContext.requestId, at: new Date().toISOString(),\n   533\t              target: { kind: \"authenticated-streamable-http\", url: descriptorUrl.toString() },\n   534\t              details: { message: \"Target credential cleanup failed\" },\n   535\t            });\n   536\t            throw error;\n   537\t          });\n   538\t          return closePromise;\n   539\t        },\n   540\t      };\n   541\t    },\n   542\t  });\n   543\t  targetSecrets.set(authenticated, state);\n   544\t  return authenticated;\n   545\t}\n   546\t\n   547\tfunction normalizeRemoteTargetUrl(value: string | URL): URL {\n   548\t  const url = new URL(value.toString());\n   549\t  if (url.protocol !== \"http:\" && url.protocol !== \"https:\") {\n   550\t    throw new TypeError(\"Authenticated MCP targets must use HTTP or HTTPS\");\n   551\t  }\n   552\t  if (url.protocol === \"http:\" && url.hostname !== \"[::1]\" &&\n   553\t      !/^127(?:\\.\\d{1,3}){3}$/.test(url.hostname)) {\n   554\t    throw new TypeError(\"Credential-bearing HTTP targets require a literal loopback address; use HTTPS remotely\");\n   555\t  }\n   556\t  if (url.username || url.password || url.hash) {\n   557\t    throw new TypeError(\n   558\t      \"Authenticated MCP target URLs must not contain userinfo or a fragment\",\n   559\t    );\n   560\t  }\n   561\t  return url;\n   562\t}\n   563\t\n   564\tfunction isCredentialProvider(\n   565\t  value: McpFnRemoteCredential | McpFnRemoteCredentialProvider,\n   566\t): value is McpFnRemoteCredentialProvider {\n   567\t  return \"acquire\" in value && typeof value.acquire === \"function\";\n   568\t}\n   569\t\n   570\tfunction boundedCredentialEntries(value: HeadersInit): Array<[string, string]> {\n   571\t  const entries: Array<[string, string]> = [];\n   572\t  let bytes = 0;\n   573\t  const append = (name: string, headerValue: string) => {\n   574\t    if (entries.length >= MAX_CREDENTIAL_HEADERS) throw new TypeError(\"Credential headers exceed the header limit\");\n   575\t    if (typeof name !== \"string\" || typeof headerValue !== \"string\") throw new TypeError(\"Credential header values must be strings\");\n   576\t    if (name.length > MAX_CREDENTIAL_HEADER_BYTES || headerValue.length > MAX_CREDENTIAL_HEADER_VALUE_BYTES) throw new TypeError(\"Credential header exceeds the value-size limit\");\n   577\t    if (new TextEncoder().encode(headerValue).byteLength > MAX_CREDENTIAL_HEADER_VALUE_BYTES) throw new TypeError(\"Credential header exceeds the value-size limit\");\n   578\t    bytes += new TextEncoder().encode(`${name}: ${headerValue}\\r\\n`).byteLength;\n   579\t    if (bytes > MAX_CREDENTIAL_HEADER_BYTES) throw new TypeError(\"Credential headers exceed the aggregate size limit\");\n   580\t    entries.push([name, headerValue]);\n   581\t  };\n   582\t  if (value instanceof Headers) value.forEach((v, k) => append(k, v));\n   583\t  else if (Array.isArray(value)) {\n   584\t    if (value.length > MAX_CREDENTIAL_HEADERS) throw new TypeError(\"Credential headers exceed the header limit\");\n   585\t    for (const entry of value) append(entry[0], entry[1]);\n   586\t  } else {\n   587\t    for (const name in value) if (Object.prototype.hasOwnProperty.call(value, name)) append(name, value[name]);\n   588\t  }\n   589\t  return entries;\n   590\t}\n   591\t\n   592\texport function validateRemoteCredentialHeaders(value: HeadersInit): Headers {\n   593\t  const headers = new Headers(boundedCredentialEntries(value));\n   594\t  const entries: Array<[string, string]> = [];\n   595\t  headers.forEach((headerValue, name) => entries.push([name, headerValue]));\n   596\t  if (entries.length === 0) {\n   597\t    throw new TypeError(\"Authenticated MCP targets require at least one credential header\");\n   598\t  }\n   599\t  if (entries.length > MAX_CREDENTIAL_HEADERS) {\n   600\t    throw new TypeError(`Credential headers exceed the ${MAX_CREDENTIAL_HEADERS}-header limit`);\n   601\t  }\n   602\t  let bytes = 0;\n   603\t  for (const [name, headerValue] of entries) {\n   604\t    if (!headerValue.trim()) throw new TypeError(\"Credential header values must not be blank\");\n   605\t    if (FORBIDDEN_CREDENTIAL_HEADERS.has(name)) {\n   606\t      throw new TypeError(`Credential header ${name} is not allowed`);\n   607\t    }\n   608\t    const valueBytes = new TextEncoder().encode(headerValue).byteLength;\n   609\t    if (valueBytes > MAX_CREDENTIAL_HEADER_VALUE_BYTES) {\n   610\t      throw new TypeError(`Credential header ${name} exceeds the value-size limit`);\n   611\t    }\n   612\t    if (new TextEncoder().encode(headerValue).byteLength > MAX_CREDENTIAL_HEADER_VALUE_BYTES) throw new TypeError(\"Credential header exceeds the value-size limit\");\n   613\t    bytes += new TextEncoder().encode(`${name}: ${headerValue}\\r\\n`).byteLength;\n   614\t  }\n   615\t  if (bytes > MAX_CREDENTIAL_HEADER_BYTES) {\n   616\t    throw new TypeError(\"Credential headers exceed the aggregate size limit\");\n   617\t  }\n   618\t  return headers;\n   619\t}\n   180\t    },\n   181\t    {\n   182\t      id: \"actual-unsupported-token-grant\",\n   183\t      host: \"generic\",\n   184\t      registration: registration(\n   185\t        \"unsupported-token-client\",\n   186\t        \"pre-registered\",\n   187\t        \"https://client.example.com/callback\",\n   188\t        supported,\n   189\t      ),\n   190\t      authorization: authorization(\n   191\t        \"unsupported-token-client\",\n   192\t        \"https://client.example.com/callback\",\n   193\t      ),\n   194\t      token: { grantType: \"urn:example:unsupported-token-grant\" },\n   195\t      expected: {\n   196\t        outcome: \"rejected\",\n   197\t        errorCode: \"unsupported_grant_type\",\n   198\t        phase: \"token-exchange\",\n   199\t      },\n   200\t    },\n   201\t  ];\n   202\t}\n   203\t\n   204\t/** Run the independently-configured hosted-authorization matrix. */\n   205\texport async function runHostedAuthorizationRegression(\n   206\t  target: McpFnHostedAuthorizationTargetAdapter,\n   207\t  fixtures: readonly McpFnHostedAuthorizationCase[],\n   208\t): Promise<McpFnHostedAuthorizationCaseResult[]> {\n   209\t  const results: McpFnHostedAuthorizationCaseResult[] = [];\n   210\t  for (const fixture of fixtures) {\n   211\t    results.push(await runHostedCase(target, fixture));\n   212\t  }\n   213\t  return results;\n   214\t}\n   215\t\n   216\tasync function runHostedCase(\n   217\t  target: McpFnHostedAuthorizationTargetAdapter,\n   218\t  fixture: McpFnHostedAuthorizationCase,\n   219\t): Promise<McpFnHostedAuthorizationCaseResult> {\n   220\t  let phase: McpFnHostedAuthorizationCaseResult[\"phase\"] = \"client-registration\";\n   221\t  let responseStatus: number | undefined;\n   222\t  try {\n   223\t    await target.prepareRegistration(structuredClone(fixture.registration));\n   224\t    phase = \"authorization-request\";\n   225\t    const authorization = new URL(\"authorize\", ensureTrailingSlash(target.issuer));\n   226\t    authorization.searchParams.set(\"response_type\", \"code\");\n   227\t    authorization.searchParams.set(\"client_id\", fixture.authorization.clientId);\n   228\t    authorization.searchParams.set(\"redirect_uri\", fixture.authorization.redirectUri);\n   229\t    authorization.searchParams.set(\n   230\t      \"code_challenge\",\n   231\t      derivePkceS256Challenge(fixture.authorization.codeVerifier),\n   232\t    );\n   233\t    authorization.searchParams.set(\"code_challenge_method\", \"S256\");\n   234\t    authorization.searchParams.set(\"state\", fixture.authorization.state);\n   235\t    authorization.searchParams.set(\"resource\", fixture.authorization.resource);\n   236\t    authorization.searchParams.set(\"scope\", fixture.authorization.scopes.join(\" \"));\n   237\t    responseStatus = undefined;\n   238\t    const authorizationResponse = await target.request(new Request(authorization, {\n   239\t      redirect: \"manual\",\n   240\t    }));\n   241\t    responseStatus = authorizationResponse.status;\n   242\t    const authorizationError = await oauthError(authorizationResponse);\n   243\t    if (authorizationError) {\n   244\t      await validateOAuthRejection(authorizationResponse, fixture, target.issuer, true);\n   245\t      return assessHostedCase(fixture, phase, authorizationResponse.status, authorizationError);\n   246\t    }\n   247\t    if (!isRedirect(authorizationResponse.status)) {\n   248\t      throw new Error(`Authorization request did not redirect (HTTP ${authorizationResponse.status})`);\n   249\t    }\n   250\t    const code = validatedRedirectCode(authorizationResponse, fixture, target.issuer);\n   251\t    if (fixture.token) {\n   252\t      phase = fixture.token.grantType === \"refresh_token\"\n   253\t        ? \"token-refresh\"\n   254\t        : \"token-exchange\";\n   255\t      const tokenBody = new URLSearchParams({\n   256\t        grant_type: fixture.token.grantType,\n   257\t        client_id: fixture.authorization.clientId,\n   258\t      });\n   259\t      if (fixture.token.grantType === \"authorization_code\") {\n   260\t        tokenBody.set(\"code\", fixture.token.code ?? code);\n   261\t        tokenBody.set(\"redirect_uri\", fixture.authorization.redirectUri);\n   262\t        tokenBody.set(\"code_verifier\", fixture.authorization.codeVerifier);\n   263\t        tokenBody.set(\"resource\", fixture.authorization.resource);\n   264\t      } else if (fixture.token.refreshToken) {\n   265\t        tokenBody.set(\"refresh_token\", fixture.token.refreshToken);\n   266\t        tokenBody.set(\"resource\", fixture.authorization.resource);\n   267\t      }\n   268\t      responseStatus = undefined;\n   269\t      const tokenResponse = await target.request(new Request(\n   270\t        new URL(\"token\", ensureTrailingSlash(target.issuer)),\n   271\t        {\n   272\t          method: \"POST\",\n   273\t          redirect: \"manual\",\n   274\t          headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n   275\t          body: tokenBody,\n   276\t        },\n   277\t      ));\n   278\t      responseStatus = tokenResponse.status;\n   279\t      const tokenError = await oauthError(tokenResponse);\n   280\t      if (tokenError) {\n   281\t        await validateOAuthRejection(tokenResponse, fixture, target.issuer);\n   282\t        return assessHostedCase(fixture, phase, tokenResponse.status, tokenError);\n   283\t      }\n   284\t      if (!tokenResponse.ok) throw new Error(`Token request returned HTTP ${tokenResponse.status}`);\n   285\t      const tokenSet = await validatedTokenSet(tokenResponse);\n   286\t      responseStatus = tokenResponse.status;\n   287\t      if (fixture.token.refreshAfterExchange) {\n   288\t        if (typeof tokenSet.refresh_token !== \"string\" || !tokenSet.refresh_token) {\n   289\t          throw new Error(\"Authorization-code response did not include a refresh token\");\n   290\t        }\n   291\t        phase = \"token-refresh\";\n   292\t        responseStatus = undefined;\n   293\t        const refreshResponse = await target.request(new Request(\n   294\t          new URL(\"token\", ensureTrailingSlash(target.issuer)),\n   295\t          {\n   296\t            method: \"POST\",\n   297\t            redirect: \"manual\",\n   298\t            headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n   299\t            body: new URLSearchParams({\n   300\t              grant_type: \"refresh_token\",\n   301\t              client_id: fixture.authorization.clientId,\n   302\t              refresh_token: tokenSet.refresh_token,\n   303\t              resource: fixture.authorization.resource,\n   304\t            }),\n   305\t          },\n   306\t        ));\n   307\t        responseStatus = refreshResponse.status;\n   308\t        const refreshError = await oauthError(refreshResponse);\n   309\t        if (refreshError) {\n   310\t          await validateOAuthRejection(refreshResponse, fixture, target.issuer);\n   311\t          return assessHostedCase(fixture, phase, refreshResponse.status, refreshError);\n   312\t        }\n   313\t        if (!refreshResponse.ok) {\n   314\t          throw new Error(`Refresh request returned HTTP ${refreshResponse.status}`);\n   315\t        }\n   316\t        await validatedTokenSet(refreshResponse);\n   317\t        responseStatus = refreshResponse.status;\n   318\t      }\n   319\t    }\n   320\t    return assessHostedCase(fixture, phase, responseStatus);\n   321\t  } catch (error) {\n   322\t    const redacted = redactOAuthValue(error);\n   323\t    const safe = redacted && typeof redacted === \"object\" ? redacted as Record<string, unknown> : {};\n   324\t    const code = typeof safe.code === \"string\" ? safe.code : undefined;\n   325\t    const message = typeof safe.message === \"string\" ? safe.message : String(redacted);\n   326\t    return assessHostedCase(fixture, phase, responseStatus, code, message || \"Hosted adapter failed\");\n   327\t  }\n   328\t}\n   329\t\n   330\tfunction assessHostedCase(\n   331\t  fixture: McpFnHostedAuthorizationCase,\n   332\t  phase: McpFnHostedAuthorizationCaseResult[\"phase\"],\n   333\t  responseStatus?: number,\n   334\t  errorCode?: string,\n   335\t  error?: string,\n   336\t): McpFnHostedAuthorizationCaseResult {\n   337\t  const observedOutcome = errorCode || error ? \"rejected\" : \"allowed\";\n   338\t  const expected = fixture.expected;\n   339\t  const passed = !error && observedOutcome === expected.outcome &&\n   340\t    (expected.errorCode === undefined || expected.errorCode === errorCode) &&\n   341\t    (expected.phase === undefined || expected.phase === phase);\n   342\t  return {\n   343\t    formatVersion: 1,\n   344\t    id: fixture.id,\n   345\t    host: fixture.host,\n   346\t    status: passed ? \"passed\" : \"failed\",\n   347\t    phase,\n   348\t    layer: phase === \"client-registration\" ? \"mcpfn-preflight\" : \"authorization-server\",\n   349\t    ...(responseStatus === undefined ? {} : { responseStatus }),\n   350\t    ...(errorCode ? { errorCode } : {}),\n   351\t    ...(!passed || error ? {\n   352\t      error: error ??\n   353\t        `Expected ${expected.outcome}${expected.errorCode ? `:${expected.errorCode}` : \"\"}, received ${observedOutcome}${errorCode ? `:${errorCode}` : \"\"}`,\n   354\t    } : {}),\n   355\t  };\n   356\t}\n   357\t\n   358\tfunction isJsonResponse(response: Response): boolean {\n   359\t  const mediaType = (response.headers.get(\"content-type\") ?? \"\").split(\";\", 1)[0].trim().toLowerCase();\n   360\t  return mediaType === \"application/json\" || /^application\\/[a-z0-9!#$&^_.+-]+\\+json$/.test(mediaType);\n   361\t}\n   362\t\n   363\tasync function oauthError(response: Response): Promise<string | undefined> {\n   364\t  const location = response.headers.get(\"location\");\n   365\t  if (location) {\n   366\t    const code = new URL(location).searchParams.get(\"error\");\n   367\t    if (code) return code;\n   368\t  }\n   369\t  if (!isJsonResponse(response)) return undefined;\n   370\t  const body = await response.clone().json().catch(() => undefined) as\n   371\t    | { error?: unknown }\n   372\t    | undefined;\n   373\t  return typeof body?.error === \"string\" ? body.error : undefined;\n   374\t}\n   375\t\n   376\tasync function validateOAuthRejection(\n   377\t  response: Response,\n   378\t  fixture: McpFnHostedAuthorizationCase,\n   379\t  issuer: string,\n   380\t  authorization = false,\n   381\t): Promise<void> {\n   382\t  if (authorization && isRedirect(response.status)) {\n   383\t    const callback = new URL(response.headers.get(\"location\") ?? \"\");\n   384\t    // Redirects must target the registered URI, never a rejected requested URI.\n   385\t    const registered = fixture.registration.metadata.redirect_uris as string[];\n   386\t    if (!registered?.includes(fixture.authorization.redirectUri)) throw new Error(\"Rejected redirect URI must not receive a callback\");\n   387\t    const errors = callback.searchParams.getAll(\"error\");\n   388\t    if (errors.length !== 1 || !errors[0] || callback.searchParams.has(\"code\")) throw new Error(\"Invalid OAuth error callback\");\n   389\t    if (errors[0] === \"invalid_client\") throw new Error(\"Invalid-client authorization failures must not redirect\");\n   390\t    callback.searchParams.delete(\"error\");\n   391\t    callback.searchParams.delete(\"error_description\");\n   392\t    callback.searchParams.delete(\"error_uri\");\n   393\t    callback.searchParams.set(\"code\", \"error-envelope-validation\");\n   394\t    validatedRedirectCode(\n   395\t      new Response(null, { status: response.status, headers: { location: callback.toString() } }),\n   396\t      fixture,\n   397\t      issuer,\n   398\t    );\n   399\t  } else {\n   400\t    const body = await response.clone().json().catch(() => undefined);\n   401\t    // An unrecognized/incompatible client must not receive a redirect. Other\n   402\t    // authorization errors for the registered callback must use that callback.\n   403\t    if (authorization && body?.error !== \"invalid_client\" && (fixture.registration.metadata.redirect_uris as string[])?.includes(fixture.authorization.redirectUri)) {\n   404\t      throw new Error(\"Registered authorization requests require an OAuth error callback\");\n   405\t    }\n   406\t    if (response.status !== 400) throw new Error(\"OAuth error response has invalid HTTP status\");\n   407\t    if (response.headers.has(\"location\") || !isJsonResponse(response) ||\n   408\t        !body || typeof body.error !== \"string\" || !body.error) {\n   409\t      throw new Error(\"OAuth error response must be a JSON error envelope\");\n   410\t    }\n   411\t  }\n   412\t}\n   413\t\n   414\tfunction validatedRedirectCode(\n   415\t  response: Response,\n   416\t  fixture: McpFnHostedAuthorizationCase,\n   417\t  issuer: string,\n   418\t): string {\n   419\t  const location = response.headers.get(\"location\");\n   420\t  if (!location) throw new Error(\"Authorization callback is missing\");\n   421\t  const callback = new URL(location);\n   422\t  const expected = new URL(fixture.authorization.redirectUri);\n   423\t  const codes = callback.searchParams.getAll(\"code\");\n   424\t  const states = callback.searchParams.getAll(\"state\");\n   425\t  if (codes.length !== 1 || !codes[0] || states.length !== 1 || states[0] !== fixture.authorization.state) {\n   426\t    throw new Error(\"Authorization callback code or state is invalid\");\n   427\t  }\n   428\t  const issuers = callback.searchParams.getAll(\"iss\");\n   429\t  if (issuers.length > 1 || (issuers.length === 1 && issuers[0] !== issuer)) {\n   430\t    throw new Error(\"Authorization callback issuer is invalid\");\n     1\timport type { McpFnDiagnosticPhase } from \"@mcpfn/client\";\n     2\timport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n     3\t\n     4\timport type { McpFnTargetSuiteReport } from \"./suite.js\";\n     5\t\n     6\tdeclare const __MCPFN_TESTING_VERSION__: string;\n     7\t\n     8\texport const MCPFN_TESTING_VERSION = __MCPFN_TESTING_VERSION__;\n     9\texport const MCPFN_REPORT_SCHEMA_VERSION = \"1.0.0\";\n    10\t\n    11\texport type McpFnFailureLayer =\n    12\t  | \"mcpfn-preflight\"\n    13\t  | \"authorization-server\"\n    14\t  | \"resource-server\"\n    15\t  | \"mcp-initialization\"\n    16\t  | \"scenario\"\n    17\t  | \"upstream-conformance\";\n    18\t\n    19\texport interface McpFnReportFailure {\n    20\t  name: string;\n    21\t  message: string;\n    22\t  layer: McpFnFailureLayer;\n    23\t  code?: string;\n    24\t  phase?: string;\n    25\t  details?: Record<string, unknown>;\n    26\t}\n    27\t\n    28\texport interface McpFnJunitOptions {\n    29\t  /** Aggregate XML size cap after serialization. Defaults to 1 MiB. */\n    30\t  maxBytes?: number;\n    31\t}\n    32\t\n    33\texport function normalizeMcpFnReportFailure(\n    34\t  error: unknown,\n    35\t  fallbackPhase?: McpFnDiagnosticPhase | \"scenario\" | \"upstream-conformance\",\n    36\t): McpFnReportFailure {\n    37\t  const redacted = redactOAuthValue(error, {\n    38\t    maxDepth: 6,\n    39\t    maxArrayEntries: 50,\n    40\t    maxObjectEntries: 50,\n    41\t    maxStringLength: 2_048,\n    42\t  });\n    43\t  const record = redacted && typeof redacted === \"object\" && !Array.isArray(redacted)\n    44\t    ? redacted as Record<string, unknown>\n    45\t    : {};\n    46\t  const phase = stringField(record.phase) ?? fallbackPhase;\n    47\t  const details = record.details && typeof record.details === \"object\" &&\n    48\t      !Array.isArray(record.details)\n    49\t    ? record.details as Record<string, unknown>\n    50\t    : undefined;\n    51\t  let message = stringField(record.message) ?? String(\n    52\t    redactOAuthValue(error instanceof Error ? error.message : String(error)),\n    53\t  );\n    54\t  const cause = error && typeof error === \"object\"\n    55\t    ? (error as { cause?: unknown }).cause\n    56\t    : undefined;\n    57\t  const redactedCause = cause === undefined\n    58\t    ? undefined\n    59\t    : redactOAuthValue(cause, {\n    60\t      maxDepth: 4,\n    61\t      maxArrayEntries: 20,\n    62\t      maxObjectEntries: 20,\n    63\t      maxStringLength: 1_024,\n    64\t    });\n    65\t  const causeRecord = redactedCause && typeof redactedCause === \"object\" &&\n    66\t      !Array.isArray(redactedCause)\n    67\t    ? redactedCause as Record<string, unknown>\n    68\t    : undefined;\n    69\t  const causeMessage = stringField(causeRecord?.message);\n    70\t  if (causeMessage && !message.includes(causeMessage)) message = `${message}: ${causeMessage}`;\n    71\t  const combinedDetails = causeRecord\n    72\t    ? { ...(details ?? {}), cause: causeRecord }\n    73\t    : details;\n    74\t  return {\n    75\t    name: stringField(record.name) ?? \"Error\",\n    76\t    message,\n    77\t    layer: failureLayer(phase) !== \"authorization-server\" && [causeRecord?.code, causeRecord?.status, record.code, record.status].some(value => [401, 403].includes(Number(value)))\n    78\t      ? \"resource-server\" : failureLayer(phase),\n    79\t    ...(stringField(record.code) ? { code: stringField(record.code)! } : {}),\n    80\t    ...(phase ? { phase } : {}),\n    81\t    ...(combinedDetails ? { details: combinedDetails } : {}),\n    82\t  };\n    83\t}\n    84\t\n    85\t/** Serialize a redacted target-suite report as bounded JUnit XML. */\n    86\texport function createMcpFnTargetSuiteJUnit(\n    87\t  report: McpFnTargetSuiteReport,\n    88\t  options: McpFnJunitOptions = {},\n    89\t): string {\n    90\t  const maxBytes = options.maxBytes ?? 1_048_576;\n    91\t  validateArtifactCap(maxBytes);\n    92\t  const safe = redactOAuthValue(report, {\n    93\t    maxDepth: 10,\n    94\t    maxArrayEntries: 1_000,\n    95\t    maxObjectEntries: 200,\n    96\t    maxStringLength: 4_096,\n    97\t  }) as unknown as McpFnTargetSuiteReport;\n    98\t  // Redaction appends a string sentinel when an array exceeds its cap.\n    99\t  const results = safe.results.filter((result) => result && typeof result === \"object\" && typeof result.name === \"string\");\n   100\t  const omitted = report.results.length - results.length;\n   101\t  const cases = results.map((result) => {\n   102\t    const duration = Math.max(0, result.durationMs ?? 0) / 1_000;\n   103\t    const failure = result.status === \"passed\"\n   104\t      ? \"\"\n   105\t      : junitFailure(\n   106\t        result.error ?? `Scenario ${result.status}`,\n   107\t        result.status === \"failed\" ? \"scenario\" : \"incomplete\",\n   108\t      );\n   109\t    return `    <testcase name=\"${xml(result.name)}\" classname=\"mcpfn.scenario\" time=\"${duration.toFixed(3)}\">${failure}</testcase>`;\n   110\t  });\n   111\t  if (safe.failure) {\n   112\t    cases.unshift(\n   113\t      `    <testcase name=\"${xml(safe.failure.phase ?? \"target\")}\" classname=\"mcpfn.${xml(safe.failure.layer)}\" time=\"0.000\">${junitFailure(safe.failure.message, safe.failure.code ?? safe.failure.layer)}</testcase>`,\n   114\t    );\n   115\t  }\n   116\t  if (safe.status === \"incomplete\" || omitted > 0 || (!safe.ok && !safe.failure && results.every((result) => result.status === \"passed\"))) {\n   117\t    cases.push(`    <testcase name=\"suite-incomplete\" classname=\"mcpfn.report\" time=\"0.000\">${junitFailure(safe.incompleteReason ?? \"Suite evidence is incomplete or omitted\", \"incomplete\")}</testcase>`);\n   118\t  }\n   119\t  if (cases.length === 0) {\n   120\t    cases.push(\n   121\t      '    <testcase name=\"target-suite\" classname=\"mcpfn.target\" time=\"0.000\"></testcase>',\n   122\t    );\n   123\t  }\n   124\t  const failures = cases.filter((entry) => entry.includes(\"<failure \")).length;\n   125\t  let serialized = junitDocument(safe, cases, failures);\n   126\t  if (bytes(serialized) <= maxBytes) return serialized;\n   127\t\n   128\t  const boundedCases = [\n   129\t    `    <testcase name=\"artifact-cap\" classname=\"mcpfn.report\" time=\"0.000\">${junitFailure(\"JUnit content exceeded maxBytes and was truncated\", \"incomplete\")}</testcase>`,\n   130\t  ];\n   131\t  serialized = junitDocument(safe, boundedCases, 1, true);\n   132\t  if (bytes(serialized) > maxBytes) {\n   133\t    throw new Error(\"The minimum McpFn JUnit report exceeds maxBytes\");\n   134\t  }\n   135\t  return serialized;\n   136\t}\n   137\t\n   138\tfunction junitDocument(\n   139\t  report: McpFnTargetSuiteReport,\n   140\t  cases: string[],\n   141\t  failures: number,\n   142\t  truncated = false,\n   143\t): string {\n   144\t  const suiteName = String(redactOAuthValue(`mcpfn:${report.target.kind}`));\n   145\t  return [\n   146\t    '<?xml version=\"1.0\" encoding=\"UTF-8\"?>',\n   147\t    `<testsuite name=\"${xml(suiteName)}\" tests=\"${cases.length}\" failures=\"${failures}\" errors=\"0\" skipped=\"0\">`,\n   148\t    \"  <properties>\",\n   149\t    `    <property name=\"mcpfn.report.schema\" value=\"${xml(MCPFN_REPORT_SCHEMA_VERSION)}\"/>`,\n   150\t    `    <property name=\"mcpfn.testing.version\" value=\"${xml(MCPFN_TESTING_VERSION)}\"/>`,\n   110\t  } catch (error) {\n   111\t    if (owner) throw owner;\n   112\t    if (failureMessage) {\n   113\t      throw new McpFnClientError(\n   114\t        \"MCPFN_OPERATION_FAILED\",\n   115\t        failureMessage,\n   116\t        { phase: \"capability-operation\" },\n   117\t      );\n   118\t    }\n   119\t    throw error;\n   120\t  }\n   121\t}\n   122\t\n   123\texport async function runCli(\n   124\t  argv = process.argv.slice(2),\n   125\t  runOptions: CliRunOptions = {},\n   126\t): Promise<number> {\n   127\t  const cwd = runOptions.cwd ?? process.cwd();\n   128\t  const stdout = runOptions.stdout ?? ((text: string) => writeProcessOutput(process.stdout, text));\n   129\t  const stderr = runOptions.stderr ?? ((text: string) => writeProcessOutput(process.stderr, text));\n   130\t  let exitCode = 0;\n   131\t  const cli = cac(\"mcpfn\");\n   132\t\n   133\t  cli.command(\"manifest <source>\", \"Generate a canonical manifest from a server or registry module\")\n   134\t    .option(\"--output <path>\", \"Write the manifest to a file\")\n   135\t    .option(\"--name <name>\", \"Server name when source exports a registry\")\n   136\t    .option(\"--version <version>\", \"Server version when source exports a registry\")\n   137\t    .action(async (source: string, options: { output?: string; name?: string; version?: string }) => {\n   138\t      const info = options.name && options.version\n   139\t        ? { name: options.name, version: options.version }\n   140\t        : undefined;\n   141\t      const { manifest } = await loadManifestSource(source, cwd, info);\n   142\t      const serialized = `${JSON.stringify(manifest, null, 2)}\\n`;\n   143\t      if (options.output) {\n   144\t        const outputPath = path.resolve(cwd, options.output);\n   145\t        await writeFile(outputPath, serialized, \"utf8\");\n   146\t        await stdout(`Wrote ${outputPath}\\n`);\n   147\t      } else {\n   148\t        await stdout(serialized);\n   149\t      }\n   150\t    });\n   540\t      if (error) reject(error);\n   541\t      else resolve();\n   542\t    });\n   543\t  });\n   544\t}\n   545\t\n   546\tfunction readRemoteCredential(\n   547\t  options: RemoteAuthCliOptions,\n   548\t): { credential: McpFnRemoteCredential; environmentName: string } | undefined {\n   549\t  if (options.bearerTokenEnv && options.apiKeyEnv) {\n   550\t    throw new Error(\"Use only one of --bearer-token-env or --api-key-env\");\n   551\t  }\n   552\t  if (options.apiKeyHeader && !options.apiKeyEnv) {\n   553\t    throw new Error(\"--api-key-header requires --api-key-env\");\n   554\t  }\n   555\t  const environmentName = options.bearerTokenEnv ?? options.apiKeyEnv;\n   556\t  if (!environmentName) return undefined;\n   557\t  if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(environmentName)) {\n   558\t    throw new Error(\"Credential environment variable names must be portable identifiers\");\n   559\t  }\n   560\t  const value = process.env[environmentName];\n   561\t  if (value === undefined || value.length === 0) {\n   562\t    throw new Error(`Credential environment variable ${environmentName} is missing or empty`);\n   563\t  }\n   564\t  if (options.bearerTokenEnv) {\n   565\t    try { new Headers({ authorization: `Bearer ${value}` }); }\n   566\t    catch { throw new Error(\"Bearer token must be a valid HTTP header value\"); }\n   567\t    if (!/^[A-Za-z0-9._~+/-]+=*$/.test(value)) throw new Error(\"Bearer token must follow the RFC 6750 token grammar\");\n   568\t    return {\n   569\t      environmentName,\n   570\t      credential: {\n     1\timport type {\n     2\t  CallToolResult,\n     3\t  CreateTaskResult,\n     4\t  GetPromptResult,\n     5\t  Implementation,\n     6\t  Prompt,\n     7\t  ReadResourceResult,\n     8\t  Resource,\n     9\t  ResourceTemplate,\n    10\t  ServerCapabilities,\n    11\t  Tool,\n    12\t  Task,\n    13\t  ListTasksResult,\n    14\t} from \"@modelcontextprotocol/sdk/types.js\";\n    15\timport {\n    16\t  McpFnClient,\n    17\t  type McpFnClientOptions,\n    18\t  type McpFnClientEvent,\n    19\t  type McpFnDiagnosticEvent,\n    20\t  type McpFnTargetDescriptor,\n    21\t} from \"@mcpfn/client\";\n    22\timport {\n    23\t  createMcpFnScenario,\n    24\t  type McpFnScenario,\n    25\t} from \"@mcpfn/testing\";\n    26\t\n    27\tconst SCENARIO_REDACTION_LIMITS = {\n    28\t  maxDepth: 8,\n    29\t  maxArrayEntries: 100,\n    30\t  maxObjectEntries: 100,\n    31\t  maxStringLength: 2_048,\n    32\t} as const;\n    33\tconst SCENARIO_SECRET_MARKER = \"${MCPFN_SECRET}\";\n    34\tconst SCENARIO_SECRET_MARKERS = [\n    35\t  SCENARIO_SECRET_MARKER,\n    36\t  \"${SECRET}\",\n    37\t  \"${CREDENTIAL}\",\n    38\t  ...Array.from({ length: 26 }, (_, index) => `\\${${String.fromCharCode(65 + index)}}`),\n    39\t];\n    40\t\n    41\texport interface McpFnInspectorSnapshot {\n    42\t  formatVersion: 2;\n    43\t  kind: \"mcpfn.inspector-snapshot\";\n    44\t  target: McpFnTargetDescriptor;\n    45\t  clientState: string;\n    46\t  server?: Implementation;\n    47\t  capabilities?: ServerCapabilities;\n    48\t  tools: Tool[];\n    49\t  resources: Resource[];\n    50\t  resourceTemplates: ResourceTemplate[];\n   260\t      return {\n   261\t        formatVersion,\n   262\t        kind: safeKind,\n   263\t        sideEffect: safeSideEffect,\n   264\t        name: \"\",\n   265\t        status: this.client.preserveArtifactStructure(\"incomplete\"),\n   266\t        incompleteReason: this.client.redact(\n   267\t          \"Inspector export omitted payload because credential redaction failed\",\n   268\t          { preserveKeys: false, redactionMarker: \"\" },\n   269\t        ),\n   270\t      } as McpFnExportedScenario;\n   271\t    }\n   272\t    const replaced = redacted as unknown as McpFnExportedScenario;\n   273\t    const incompleteReason = secretMarker === undefined\n   274\t      ? \"Inspector export could not select a replayable redaction placeholder\"\n   275\t      : exceedsRedactionBounds(scenario, redacted, SCENARIO_REDACTION_LIMITS)\n   276\t        ? \"Inspector export exceeded redaction bounds and was truncated\"\n   277\t        : undefined;\n   278\t    const exported = incompleteReason\n   279\t      ? {\n   280\t        ...replaced,\n   281\t        status: this.client.preserveArtifactStructure(\"incomplete\"),\n   282\t        incompleteReason: this.client.redact(incompleteReason, {\n   283\t          preserveKeys: false,\n   284\t          redactionMarker: \"\",\n   285\t        }),\n   286\t      }\n   287\t      : replaced;\n   288\t    const variables = collectVariables(exported);\n   289\t    return variables.length ? { ...exported, variables } : exported;\n   290\t  }\n   300\t    let settled = false;\n   301\t    child.once(\"error\", (error) => {\n   302\t      if (settled) return;\n   303\t      settled = true;\n   304\t      const failure = normalizeMcpFnReportFailure(error, \"upstream-conformance\");\n   305\t      resolve({\n   306\t        formatVersion: 1,\n   307\t        kind: \"mcpfn.official-conformance-report\",\n   308\t        ok: false,\n   309\t        suiteVersion: OFFICIAL_CONFORMANCE_VERSION,\n   310\t        exitCode: 1,\n   311\t        stdout: \"\",\n   312\t        stderr: failure.message,\n   313\t        failure,\n   314\t      });\n   315\t    });\n   316\t    const finish = (code: number | null) => {\n   317\t      if (settled) return;\n   318\t      settled = true;\n   319\t      let exitCode = code ?? 1;\n   320\t      let safeStdout = \"\";\n   321\t      let safeStderr = \"\";\n   322\t      try {\n   323\t        if (outputExceeded) throw new Error(\"capture limit\");\n   324\t        safeStdout = redactOutput(stdout);\n   325\t        safeStderr = redactOutput(stderr);\n   326\t      } catch {\n   327\t        exitCode = 1;\n   328\t        safeStdout = \"\";\n   329\t        safeStderr = outputExceeded ? \"Conformance output exceeded its capture limit\" : \"Conformance output omitted because credential redaction exceeded its bounds\";\n   330\t      }\n   331\t      const failure = exitCode === 0\n   332\t        ? undefined\n   333\t        : normalizeMcpFnReportFailure(\n   334\t          new Error(safeStderr || safeStdout || `Official conformance exited ${exitCode}`),\n   335\t          \"upstream-conformance\",\n   336\t        );\n   337\t      resolve({\n   338\t        formatVersion: 1,\n   339\t        kind: \"mcpfn.official-conformance-report\",\n   340\t        ok: exitCode === 0,\n   341\t        suiteVersion: OFFICIAL_CONFORMANCE_VERSION,\n   342\t        exitCode,\n   343\t        stdout: safeStdout,\n   344\t        stderr: safeStderr,\n   345\t        ...(failure ? { failure } : {}),\n   346\t      });\n   347\t    };\n   348\t    child.once(\"close\", finish);\n   349\t  });\n   350\t}\n   351\t\n   352\tconst retainedConformanceCleanup = new WeakMap<Error, () => Promise<void>>();\n   353\t\n   354\t/** Cleanup failed after retries. Retain this error and call retryCleanup(). */\n   355\texport class McpFnConformanceCleanupError extends Error {\n   356\t  constructor(release: () => Promise<void>, readonly result?: OfficialConformanceResult) {\n   357\t    super(\"Authenticated conformance credential cleanup failed; retry cleanup\");\n   358\t    this.name = \"McpFnConformanceCleanupError\";\n   359\t    retainedConformanceCleanup.set(this, release);\n   360\t  }\n   361\t  async retryCleanup(): Promise<void> {\n   362\t    const release = retainedConformanceCleanup.get(this);\n   363\t    if (!release) return;\n   364\t    try { await release(); }\n   365\t    catch { throw this; }\n   366\t    retainedConformanceCleanup.delete(this);\n   367\t  }\n   368\t}\n   369\t\n   370\t/**\n   371\t * Run the pinned official suite against an authenticated MCP endpoint.\n   372\t * Always captures stdio (even when inherit is requested) to redact credentials.\n   373\t * outputDir is rejected before acquisition; only the returned redacted result is safe to persist.\n   374\t */\n   375\texport async function runAuthenticatedOfficialConformance(\n   376\t  options: AuthenticatedOfficialConformanceOptions,\n   377\t): Promise<OfficialConformanceResult> {\n   378\t  if (options.outputDir !== undefined) throw new TypeError(\"Authenticated conformance does not support outputDir; serialize the redacted result instead\");\n   379\t  const { headers, credential, ...conformance } = options;\n   380\t  if ((headers === undefined) === (credential === undefined)) {\n    25\t  authProvider?: OAuthClientProvider;\n    26\t}\n    27\t\n    28\tinterface StateValidatingOAuthProvider extends OAuthClientProvider {\n    29\t  validateAuthorizationState?(state: string | undefined): void | Promise<void>;\n    30\t  invalidatePendingAuthorization?(): void | Promise<void>;\n    31\t}\n    32\t\n    33\texport function customTarget(options: {\n    34\t  kind: string;\n    35\t  descriptor?: Record<string, unknown>;\n    36\t  open(context: McpFnTargetContext): Promise<McpFnTransportHandle> | McpFnTransportHandle;\n    37\t  cleanup?(): Promise<void>;\n    38\t  redact?: McpFnTarget[\"redact\"];\n    39\t}): McpFnTarget {\n    40\t  const descriptor = Object.freeze({ kind: options.kind, ...options.descriptor });\n    41\t  return {\n    42\t    kind: options.kind,\n    43\t    describe: () => ({ ...descriptor }),\n    44\t    open: (context) => Promise.resolve(options.open(context)),\n    45\t    ...(options.cleanup ? { cleanup: () => options.cleanup!() } : {}),\n    46\t    ...(options.redact ? { redact: options.redact } : {}),\n    47\t  };\n    48\t}\n    49\t\n    50\texport function transportTarget(\n    65\tasync function toWebRequest(request: IncomingMessage): Promise<Request> {\n    66\t  const chunks: Buffer[] = [];\n    67\t  for await (const chunk of request) {\n    68\t    chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk));\n    69\t  }\n    70\t  const body = Buffer.concat(chunks);\n    71\t  return new Request(\n    72\t    new URL(request.url ?? \"/\", `http://${request.headers.host ?? \"127.0.0.1\"}`),\n    73\t    {\n    74\t      method: request.method,\n    75\t      headers: new Headers(Object.entries(request.headers).flatMap(([name, value]) =>\n    76\t        Array.isArray(value)\n    77\t          ? value.map((entry) => [name, entry] as [string, string])\n    78\t          : value === undefined ? [] : [[name, value] as [string, string]],\n    79\t      )),\n    80\t      ...(body.length ? { body } : {}),\n    81\t    },\n    82\t  );\n    83\t}\n    84\t\n    85\tasync function sendWebResponse(response: ServerResponse, web: Response): Promise<void> {\n    86\t  response.writeHead(web.status, Object.fromEntries(web.headers));\n    87\t  if (!web.body) { response.end(); return; }\n    88\t  await pipeline(Readable.fromWeb(web.body as Parameters<typeof Readable.fromWeb>[0]), response);\n    89\t}\n    90\t\n   120\t  const chunks = [];\n   121\t  let size = 0;\n   122\t  for await (const chunk of incoming) {\n   123\t    const buffer = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);\n   124\t    size += buffer.length;\n   125\t    if (size > MAX_REQUEST_BYTES) throw new Error(\"Request body too large\");\n   126\t    chunks.push(buffer);\n   127\t  }\n   128\t  const body = Buffer.concat(chunks);\n   129\t  return new Request(url, {\n   130\t    method: incoming.method,\n   131\t    headers: new Headers(Object.entries(incoming.headers).flatMap(([name, value]) =>\n   132\t      Array.isArray(value)\n   133\t        ? value.map((entry) => [name, entry])\n   134\t        : value === undefined ? [] : [[name, value]],\n   135\t    )),\n   136\t    ...(body.length ? { body } : {}),\n   137\t  });\n   138\t}\n   139\t\n   140\tasync function sendWebResponse(outgoing, response) {\n   141\t  outgoing.writeHead(response.status, Object.fromEntries(response.headers));\n   142\t  if (!response.body) {\n   143\t    outgoing.end();\n   144\t    return;\n   145\t  }\n","stderr":"","aggregated_output":"     1\timport {\n     2\t  McpFnClientError,\n     3\t  customTarget,\n     4\t  streamableHttpTarget,\n     5\t  type McpFnStreamableHttpTargetOptions,\n     6\t  type McpFnTarget,\n     7\t  type McpFnTransportHandle,\n     8\t} from \"@mcpfn/client\";\n     9\t\n    10\timport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n    11\t\n    12\ttype SecretState = { active: Map<string, number>; scopes: Set<Set<string>> };\n    13\tconst targetSecrets = new WeakMap<McpFnTarget, SecretState>();\n    14\t\n    15\t/** Retain released credentials only for the lifetime of a report operation. */\n    16\texport function beginTargetCredentialRedaction(target: McpFnTarget): () => void {\n    17\t  const state = targetSecrets.get(target);\n    18\t  if (!state) return () => undefined;\n    19\t  const scope = new Set(state.active.keys());\n    20\t  state.scopes.add(scope);\n    21\t  return () => { state.scopes.delete(scope); scope.clear(); };\n    22\t}\n    23\t\n    24\tfunction credentialValues(headers: HeadersInit): Set<string> {\n    25\t  const values = boundedCredentialEntries(headers);\n    26\t  const secrets = new Set<string>();\n    27\t  for (const [header, raw] of values) {\n    28\t    if (typeof raw !== \"string\" || !raw.trim()) continue;\n    29\t    secrets.add(raw);\n    30\t    secrets.add(raw.trim());\n    31\t    const trimmed = raw.trim();\n    32\t    const separator = trimmed.search(/\\s/);\n    33\t    const scheme = separator > 0 ? trimmed.slice(0, separator).toLowerCase() : \"\";\n    34\t    const authorization = [\"authorization\", \"proxy-authorization\"].includes(header.toLowerCase());\n    35\t    // Authorization headers carry schemes, including supported custom ones.\n    36\t    // Other credential headers are opaque even when their values contain spaces.\n    37\t    if (authorization && separator > 0) {\n    38\t      const token = trimmed.slice(separator).trim();\n    39\t      if (token) secrets.add(token);\n    40\t      if (scheme === \"basic\" && /^[A-Za-z0-9+/]+={0,2}$/.test(token)) {\n    41\t        const decoded = Buffer.from(token, \"base64\");\n    42\t        // Round-trip validation avoids interpreting malformed tokens as credentials.\n    43\t        if (decoded.toString(\"base64\").replace(/=+$/, \"\") === token.replace(/=+$/, \"\")) {\n    44\t          for (const encoding of [\"utf8\", \"latin1\"] as const) {\n    45\t            const pair = decoded.toString(encoding);\n    46\t            const colon = pair.indexOf(\":\");\n    47\t            if (colon < 0) continue;\n    48\t            for (const value of [pair, pair.slice(0, colon), pair.slice(colon + 1)]) {\n    49\t              if (value) secrets.add(value);\n    50\t            }\n    51\t          }\n    52\t        }\n    53\t      }\n    54\t    }\n    55\t    if (header.toLowerCase() === \"cookie\") {\n    56\t      // Cookie values are independently reflectable even though the request\n    57\t      // authenticates with the complete header. RFC 6265 cookie values cannot\n    58\t      // contain comma or semicolon, so both delimiters safely cover combined\n    59\t      // Headers entries as well as the normal Cookie serialization.\n    60\t      for (const part of raw.split(/[;,]/)) {\n    61\t        const pair = part.trim();\n    62\t        if (!pair) continue;\n    63\t        const equals = pair.indexOf(\"=\");\n    64\t        if (equals < 1) {\n    65\t          throw new TypeError(\"Cookie credential headers must contain name=value pairs\");\n    66\t        }\n    67\t        const value = pair.slice(equals + 1).trim();\n    68\t        if (!value) continue;\n    69\t        secrets.add(value);\n    70\t        if (value.startsWith('\"') || value.endsWith('\"')) {\n    71\t          if (value.length < 2 || !value.startsWith('\"') || !value.endsWith('\"')) {\n    72\t            throw new TypeError(\"Cookie credential values must use balanced quotes\");\n    73\t          }\n    74\t          const unquoted = value.slice(1, -1);\n    75\t          if (unquoted.includes('\"') || unquoted.includes(\"\\\\\")) {\n    76\t            throw new TypeError(\"Cookie credential values must use RFC 6265 syntax\");\n    77\t          }\n    78\t          if (unquoted) secrets.add(unquoted);\n    79\t        }\n    80\t      }\n    81\t    }\n    82\t  }\n    83\t  return secrets;\n    84\t}\n    85\t\n    86\texport class McpFnRedactionLimitError extends Error {\n    87\t  constructor(message = \"Credential redaction exceeded its traversal budget\") { super(message); }\n    88\t}\n    89\t\n    90\t/** No typed artifact can preserve this authored key without exposing a credential. */\n    91\texport class McpFnStructuralCredentialCollisionError extends McpFnRedactionLimitError {\n    92\t  constructor() {\n    93\t    super(\"Credential collides with a required structural artifact key\");\n    94\t  }\n    95\t}\n    96\t\n    97\t// Only these locally authored envelope paths retain structural keys. Unknown\n    98\t// children (including inspector events and server metadata) are always payloads.\n    99\tconst envelopeKeys: Record<string, Set<string>> = Object.fromEntries(Object.entries({\n   100\t  root: \"formatVersion kind status runtime ok target server capabilities manifestChecked manifestHash total passed failed incomplete droppedResults droppedObservedEvents redactionOmittedObservedEvents incompleteReason failure timeline droppedTimelineEvents results count clientState tools resources resourceTemplates prompts droppedEvents timelineComplete droppedInventoryEntries inventoryComplete suiteVersion exitCode stdout stderr phase outcome code requestId at details payload\",\n   101\t  result: \"formatVersion name operation tool status sideEffect durationMs error droppedObservedEvents redactionOmittedObservedEvents\",\n   102\t  diagnostic: \"phase outcome code requestId at target details\",\n   103\t  inspectorEvent: \"formatVersion source kind at event\",\n   104\t  failure: \"name message layer code phase details\",\n   105\t  runtime: \"node scenarioFormatVersion reportSchemaVersion packages\",\n   106\t  packages: \"testing\",\n   107\t  droppedInventoryEntries: \"tools resources resourceTemplates prompts\",\n   108\t  target: \"kind\",\n   109\t}).map(([role, keys]) => [role, new Set(keys.split(\" \"))]));\n   110\t\n   111\tfunction specialValue(input: unknown): unknown {\n   112\t  if (input instanceof Error) {\n   113\t    // Error instances may expose attacker-controlled enumerable keys. A\n   114\t    // null-prototype accumulator keeps `__proto__` as ordinary payload data.\n   115\t    const normalized = Object.create(null) as Record<string, unknown>;\n   116\t    let enumerableFields = 0;\n   117\t    for (const key in input) {\n   118\t      if (!Object.hasOwn(input, key)) continue;\n   119\t      if (++enumerableFields > 100_000) throw new McpFnRedactionLimitError();\n   120\t      normalized[key] = (input as unknown as Record<string, unknown>)[key];\n   121\t    }\n   122\t    normalized.name = input.name;\n   123\t    normalized.message = input.message;\n   124\t    normalized.stack = input.stack;\n   125\t    if (input.cause !== undefined) normalized.cause = input.cause;\n   126\t    return normalized;\n   127\t  }\n   128\t  if (input instanceof Date) return Number.isNaN(input.getTime()) ? \"Invalid Date\" : input.toISOString();\n   129\t  if (input instanceof URL) return input.href;\n   130\t  if (input instanceof Map) {\n   131\t    if (Object.getOwnPropertyDescriptor(Map.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   132\t    return { type: \"Map\", entries: [...Map.prototype.entries.call(input)] };\n   133\t  }\n   134\t  if (input instanceof Set) {\n   135\t    if (Object.getOwnPropertyDescriptor(Set.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   136\t    return { type: \"Set\", values: [...Set.prototype.values.call(input)] };\n   137\t  }\n   138\t  return input;\n   139\t}\n   140\t\n   141\tfunction scrubCredentials<T>(value: T, values: Iterable<string>, preserveKeys = false, redactionMarker?: string): T {\n   142\t  // Preserve whether a pattern came from opaque text or a serializer. Literal\n   143\t  // percent sequences in credentials must not acquire URL hex-case semantics.\n   144\t  const variants = [...values].filter(Boolean).flatMap(secret => [\n   145\t    { value: secret, encoded: false },\n   146\t    { value: JSON.stringify(secret).slice(1, -1), encoded: false },\n   147\t    { value: encodeURIComponent(secret), encoded: true },\n   148\t    { value: new URLSearchParams({ value: secret }).toString().slice(\"value=\".length), encoded: true },\n   149\t  ]).sort((a, b) => b.value.length - a.value.length);\n   150\t  let entries = 0, stringBytes = 0;\n   151\t  const budget = (input: unknown, depth = 0): void => {\n   152\t    input = specialValue(input);\n   153\t    if ((Array.isArray(input) && input.length > 100_000) || ++entries > 100_000 || depth > 32) throw new McpFnRedactionLimitError();\n   154\t    if (typeof input === \"string\") {\n   155\t      stringBytes += Buffer.byteLength(input);\n   156\t      if (input.length > 262_144 || stringBytes > 2_097_152) throw new McpFnRedactionLimitError();\n   157\t    } else if (input && typeof input === \"object\") {\n   158\t      for (const key in input) if (Object.hasOwn(input, key)) {\n   159\t        budget(key, depth + 1);\n   160\t        budget((input as Record<string, unknown>)[key], depth + 1);\n   161\t      }\n   162\t    }\n   163\t  };\n   164\t  // Check before either redactor allocates copies. Exceeding a budget is an\n   165\t  // explicit failure, never silent truncation of a typed report collection.\n   166\t  budget(value);\n   167\t  const patterns = variants.map(({ value, encoded }) => {\n   168\t    const literal = value.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n   169\t    // Only generated percent escapes accept mixed-case hex digits.\n   170\t    return encoded\n   171\t      ? literal.replace(/%[0-9A-Fa-f]{2}/g, escape => escape.replace(/[A-Fa-f]/g, hex => `[${hex.toLowerCase()}${hex.toUpperCase()}]`))\n   172\t      : literal;\n   173\t  });\n   174\t  const secretPattern = patterns.length ? new RegExp(patterns.join(\"|\"), \"g\") : undefined;\n   175\t  const replacementPattern = patterns.length ? new RegExp(patterns.join(\"|\")) : undefined;\n   176\t  const preserveStructural = (input: string): string => {\n   177\t    if (replacementPattern?.test(input)) {\n   178\t      throw new McpFnRedactionLimitError(\n   179\t        \"Credential collides with a required structural artifact field\",\n   180\t      );\n   181\t    }\n   182\t    return input;\n   183\t  };\n   184\t  const preserveStructuralKey = (input: string): string => {\n   185\t    if (replacementPattern?.test(input)) {\n   186\t      throw new McpFnStructuralCredentialCollisionError();\n   187\t    }\n   188\t    return input;\n   189\t  };\n   190\t  // A requested marker is itself output and must not reproduce a credential.\n   191\t  if (secretPattern) {\n   192\t    const markerContainsSecret = secretPattern.test(redactionMarker ?? \"[REDACTED]\");\n   193\t    secretPattern.lastIndex = 0;\n   194\t    if (markerContainsSecret) redactionMarker = \"\";\n   195\t  }\n   196\t  const clientKinds = new Set([\"logging.message\", \"progress\", \"tasks.status\", \"resources.updated\", \"tools.list_changed\", \"resources.list_changed\", \"prompts.list_changed\", \"resources.subscribed\", \"resources.unsubscribed\", \"client.roots\", \"client.sampling\", \"client.elicitation\"]);\n   197\t  const scrub = (input: unknown, role = \"payload\", field = \"\", finalPass = false): unknown => {\n   198\t    input = specialValue(input);\n   199\t    if (typeof input === \"string\") {\n   200\t      if ((role === \"root\" || role === \"inspectorEvent\") && field === \"kind\" && clientKinds.has(input)) return preserveStructural(input);\n   201\t      if (role === \"root\" && field === \"clientState\" && [\"idle\", \"connecting\", \"authorization-required\", \"connected\", \"closing\", \"closed\"].includes(input)) return preserveStructural(input);\n   202\t      if (role === \"target\" && field === \"kind\" && [\"authenticated-streamable-http\", \"streamable-http\", \"stdio\", \"in-memory\", \"custom\"].includes(input)) return preserveStructural(input);\n   203\t      if ((role === \"packages\" && field === \"testing\") || (role === \"runtime\" && [\"node\", \"reportSchemaVersion\"].includes(field)) || (role === \"root\" && field === \"suiteVersion\")) return preserveStructural(input);\n   204\t      if ((role === \"root\" || role === \"result\") && field === \"status\" && [\"passed\", \"failed\", \"incomplete\", \"complete\"].includes(input)) return preserveStructural(input);\n   205\t      if ((role === \"root\" || role === \"diagnostic\") && field === \"outcome\" && [\"started\", \"succeeded\", \"failed\"].includes(input)) return preserveStructural(input);\n   206\t      if (role === \"root\" && field === \"kind\" && [\"mcpfn.target-suite-report\", \"mcpfn.inspector-snapshot\", \"mcpfn.official-conformance-report\"].includes(input)) return preserveStructural(input);\n   207\t      if ((role === \"root\" || role === \"diagnostic\" || role === \"failure\") && field === \"phase\" && [\"resource-discovery\", \"authorization-server-discovery\", \"client-registration\", \"authorization-request\", \"authorization-callback\", \"token-exchange\", \"token-refresh\", \"token-revocation\", \"transport-connect\", \"mcp-initialize\", \"capability-operation\", \"transport-close\"].includes(input)) return preserveStructural(input);\n   208\t      if (role === \"failure\" && field === \"layer\" && [\"mcpfn-preflight\", \"authorization-server\", \"resource-server\", \"mcp-initialization\", \"scenario\", \"upstream-conformance\"].includes(input)) return preserveStructural(input);\n   209\t      if (role === \"inspectorEvent\" && field === \"source\" && [\"diagnostic\", \"client\"].includes(input)) return preserveStructural(input);\n   210\t      if (role === \"result\" && field === \"sideEffect\" && [\"none\", \"idempotent\", \"non-idempotent\"].includes(input)) return preserveStructural(input);\n   211\t      // Whole-string rejection cannot compose another credential by joining pieces.\n   212\t      // Run after both redactors; never feed this result through another redactor.\n   213\t      if (finalPass) return replacementPattern?.test(input) ? \"\" : input;\n   214\t      return secretPattern ? input.replace(secretPattern, secret => {\n   215\t        const replacement = redactionMarker ?? (secret.length < 10 ? (secret.includes(\"*\") ? \"#\" : \"*\").repeat(secret.length) : \"[REDACTED]\");\n   216\t        // Every generated mask must be safe against the entire credential set.\n   217\t        return replacementPattern!.test(replacement) ? \"\" : replacement;\n   218\t      }) : input;\n   219\t    }\n   220\t    if (Array.isArray(input)) {\n   221\t      const result = input.map(entry => scrub(entry, role, \"\", finalPass));\n   222\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   223\t      return result;\n   224\t    }\n   225\t    if (input && typeof input === \"object\") {\n   226\t      const entries: Array<[string, unknown]> = [];\n   227\t      const keys = new Set<string>();\n   228\t      for (const [key, entry] of Object.entries(input)) {\n   229\t        const fixed = envelopeKeys[role]?.has(key) ?? false;\n   230\t        if (fixed) preserveStructuralKey(key);\n   231\t        let childRole = \"payload\";\n   232\t        if (fixed) {\n   233\t          if (key === \"results\") childRole = \"result\";\n   234\t          else if (key === \"timeline\") childRole = (value as any)?.kind === \"mcpfn.inspector-snapshot\" ? \"inspectorEvent\" : \"diagnostic\";\n   235\t          else if ([\"failure\", \"runtime\", \"packages\", \"droppedInventoryEntries\", \"target\"].includes(key)) childRole = key;\n   236\t          else if (role === \"inspectorEvent\" && key === \"event\") childRole = (input as { source?: string }).source === \"client\" ? \"root\" : \"diagnostic\";\n   237\t        }\n   238\t        const scrubbedKey = fixed ? key : scrub(key, \"payload\", \"\", finalPass) as string;\n   239\t        if (keys.has(scrubbedKey)) {\n   240\t          throw new McpFnRedactionLimitError(\n   241\t            \"Credential redaction created duplicate object keys\",\n   242\t          );\n   243\t        }\n   244\t        keys.add(scrubbedKey);\n   245\t        entries.push([\n   246\t          scrubbedKey,\n   247\t          typeof entry === \"string\"\n   248\t            ? scrub(entry, fixed ? role : \"payload\", key, finalPass)\n   249\t            : scrub(entry, childRole, \"\", finalPass),\n   250\t        ]);\n   251\t      }\n   252\t      const result = Object.fromEntries(entries);\n   253\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   254\t      return result;\n   255\t    }\n   256\t    return input;\n   257\t  };\n   258\t  const timelineEvent = value && typeof value === \"object\" && [\"client\", \"diagnostic\"].includes((value as { source?: string }).source ?? \"\");\n   259\t  const role = preserveKeys ? (timelineEvent ? \"inspectorEvent\" : \"root\") : \"payload\";\n   260\t  const scrubbed = scrub(value, role);\n   261\t  const generic = redactOAuthValue(scrubbed, { maxStringLength: 262_144, maxDepth: 64, maxArrayEntries: 100_000, maxObjectEntries: 100_000, ...(redactionMarker !== undefined ? { redactionMarker } : {}) });\n   262\t  const result = scrub(generic, role, \"\", true) as T;\n   263\t  assertPayloadSerialization(\n   264\t    result,\n   265\t    \"payload\",\n   266\t    true,\n   267\t    replacementPattern,\n   268\t  );\n   269\t  return result;\n   270\t}\n   271\t\n   272\tfunction assertPayloadSerialization(\n   273\t  value: unknown,\n   274\t  role: string,\n   275\t  finalPass: boolean,\n   276\t  credentialPattern: RegExp | undefined,\n   277\t): void {\n   278\t  if (!finalPass || role !== \"payload\" || !credentialPattern) return;\n   279\t  const serialized = JSON.stringify(value);\n   280\t  if (serialized !== undefined && credentialPattern.test(serialized)) {\n   281\t    throw new McpFnRedactionLimitError(\n   282\t      \"Credential redaction could not guarantee safe serialized output\",\n   283\t    );\n   284\t  }\n   285\t}\n   286\t\n   287\t/** Remove known opaque credential values as well as credential-shaped fields. */\n   288\texport function redactTargetCredentials<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean; redactionMarker?: string } = {}): T {\n   289\t  const state = targetSecrets.get(target);\n   290\t  return scrubCredentials(value, new Set([...(state?.active.keys() ?? []), ...[...(state?.scopes ?? [])].flatMap((scope) => [...scope])]), options.preserveKeys, options.redactionMarker);\n   291\t}\n   292\t\n   293\t/** Redact authenticated conformance output using the acquired credential. */\n   294\texport function redactRemoteCredential<T>(credential: McpFnRemoteCredential, value: T, options: { preserveKeys?: boolean } = {}): T {\n   295\t  return scrubCredentials(value, credentialValues(credential.headers), options.preserveKeys);\n   296\t}\n   297\t\n   298\tconst MAX_CREDENTIAL_HEADERS = 32;\n   299\tconst MAX_CREDENTIAL_HEADER_BYTES = 16_384;\n   300\tconst MAX_CREDENTIAL_HEADER_VALUE_BYTES = 8_192;\n   301\tconst FORBIDDEN_CREDENTIAL_HEADERS = new Set([\n   302\t  \"connection\",\n   303\t  \"content-length\",\n   304\t  \"host\",\n   305\t  \"proxy-connection\",\n   306\t  \"te\",\n   307\t  \"trailer\",\n   308\t  \"transfer-encoding\",\n   309\t  \"upgrade\",\n   310\t]);\n   311\t\n   312\texport type McpFnRemoteCredentialKind = \"api-key\" | \"oauth\" | \"custom\";\n   313\t\n   314\texport interface McpFnRemoteCredential {\n   315\t  /** Credential headers are applied only to the fixed target origin. */\n   316\t  headers: HeadersInit;\n   317\t  kind?: McpFnRemoteCredentialKind;\n   318\t  label?: string;\n   319\t}\n   320\t\n   321\texport interface McpFnRemoteCredentialContext {\n   322\t  url: string;\n   323\t  requestId: string;\n   324\t  signal?: AbortSignal;\n   325\t}\n   326\t\n   327\t/**\n   328\t * Application-owned credential lifecycle for external MCP targets. McpFn\n   329\t * acquires once per target open, revokes before disposal, and never serializes\n   330\t * the returned headers into descriptors or reports. If acquisition rejects, the\n   331\t * provider must roll back its own partial resources; no lease has been returned.\n   332\t */\n   333\texport interface McpFnRemoteCredentialProvider {\n   334\t  acquire(\n   335\t    context: McpFnRemoteCredentialContext,\n   336\t  ): McpFnRemoteCredential | Promise<McpFnRemoteCredential>;\n   337\t  revoke?(\n   338\t    credential: McpFnRemoteCredential,\n   339\t    context: McpFnRemoteCredentialContext,\n   340\t  ): void | Promise<void>;\n   341\t  dispose?(\n   342\t    credential: McpFnRemoteCredential,\n   343\t    context: McpFnRemoteCredentialContext,\n   344\t  ): void | Promise<void>;\n   345\t}\n   346\t\n   347\texport interface McpFnRemoteCredentialLease {\n   348\t  credential: McpFnRemoteCredential;\n   349\t  release(): Promise<void>;\n   350\t  /** The lifecycle stage that most recently prevented credential release. */\n   351\t  cleanupPhase(): \"token-revocation\" | \"transport-close\";\n   352\t}\n   353\t\n   354\texport interface McpFnAuthenticatedHttpTargetOptions\n   355\t  extends Omit<McpFnStreamableHttpTargetOptions, \"authProvider\" | \"requestInit\"> {\n   356\t  credential: McpFnRemoteCredential | McpFnRemoteCredentialProvider;\n   357\t  requestInit?: Omit<RequestInit, \"headers\" | \"redirect\"> & { headers?: HeadersInit };\n   358\t}\n   359\t\n   360\t/** Create a provider for an already-bounded API key or OAuth-derived token. */\n   361\texport function staticRemoteCredentialProvider(\n   362\t  credential: McpFnRemoteCredential,\n   363\t): McpFnRemoteCredentialProvider {\n   364\t  return { acquire: () => credential };\n   365\t}\n   366\t\n   367\t/** Acquire a credential and return an idempotent revoke-then-dispose lease. */\n   368\texport async function acquireRemoteCredential(\n   369\t  source: McpFnRemoteCredential | McpFnRemoteCredentialProvider,\n   370\t  context: McpFnRemoteCredentialContext,\n   371\t): Promise<McpFnRemoteCredentialLease> {\n   372\t  let provider: McpFnRemoteCredentialProvider;\n   373\t  let acquired: McpFnRemoteCredential;\n   374\t  try {\n   375\t    provider = isCredentialProvider(source) ? source : staticRemoteCredentialProvider(source);\n   376\t    acquired = await provider.acquire(context);\n   377\t  } catch {\n   378\t    // Until acquisition returns, its opaque secrets are unknown to the redactor.\n   379\t    // The provider owns rollback of resources allocated before it rejects.\n   380\t    throw new Error(\"Target credential acquisition failed\");\n   381\t  }\n   382\t  let credential = acquired;\n   383\t  try {\n   384\t    // Detach all valid header forms from provider-owned mutable storage.\n   385\t    credential = { ...acquired, headers: boundedCredentialEntries(acquired.headers) };\n   386\t  } catch {\n   387\t    // Invalid headers are rejected by the caller's validation inside its cleanup\n   388\t    // boundary. Keep the acquired object so that rejection can still revoke it.\n   389\t  }\n   390\t  let releasePromise: Promise<void> | undefined;\n   391\t  let revoked = false;\n   392\t  let disposed = false;\n   393\t  let cleanupPhase: \"token-revocation\" | \"transport-close\" = credential.kind === \"oauth\"\n   394\t    ? \"token-revocation\"\n   395\t    : \"transport-close\";\n   396\t  return {\n   397\t    credential,\n   398\t    cleanupPhase: () => cleanupPhase,\n   399\t    release() {\n   400\t      releasePromise ??= (async () => {\n   401\t        // Cancellation of acquisition must not cancel revocation or its retries.\n   402\t        const cleanupContext = { ...context, signal: new AbortController().signal };\n   403\t        try {\n   404\t          // Provider-local state may be required to retry revocation.\n   405\t          if (!revoked) {\n   406\t            cleanupPhase = credential.kind === \"oauth\" ? \"token-revocation\" : \"transport-close\";\n   407\t            await provider.revoke?.(acquired, cleanupContext);\n   408\t            revoked = true;\n   409\t          }\n   410\t          if (!disposed) {\n   411\t            // Revocation already completed: a later disposal failure is not an\n   412\t            // authorization-server failure.\n   413\t            cleanupPhase = \"transport-close\";\n   414\t            await provider.dispose?.(acquired, cleanupContext);\n   415\t            disposed = true;\n   416\t          }\n   417\t        } catch (error) {\n   418\t          throw new McpFnClientError(\n   419\t            \"MCPFN_OPERATION_FAILED\",\n   420\t            \"Target credential cleanup failed\",\n   421\t            { phase: cleanupPhase, retryable: true },\n   422\t          );\n   423\t        }\n   424\t      })().catch(error => { releasePromise = undefined; throw error; });\n   425\t      return releasePromise;\n   426\t    },\n   427\t  };\n   428\t}\n   429\t\n   430\t/**\n   431\t * A URL-plus-credential target for non-McpFn servers. It delegates MCP and\n   432\t * transport behavior to the production @mcpfn/client session engine.\n   433\t */\n   434\texport function authenticatedHttpTarget(\n   435\t  url: string | URL,\n   436\t  options: McpFnAuthenticatedHttpTargetOptions,\n   437\t): McpFnTarget {\n   438\t  const targetUrl = normalizeRemoteTargetUrl(url);\n   439\t  const descriptorUrl = new URL(targetUrl);\n   440\t  descriptorUrl.search = \"\";\n   441\t  const { credential: _credential, requestInit, ...transportOptions } = options;\n   442\t  void _credential;\n   443\t\n   444\t  const state: SecretState = { active: new Map(), scopes: new Set() };\n   445\t  const pendingReleases = new Set<() => Promise<void>>();\n   446\t  const authenticated = customTarget({\n   447\t    kind: \"authenticated-streamable-http\",\n   448\t    descriptor: {\n   449\t      url: descriptorUrl.toString(),\n   450\t      authenticated: true,\n   451\t    },\n   452\t    redact: (value, redaction) => redactTargetCredentials(authenticated, value, { preserveKeys: true, ...redaction }),\n   453\t    async cleanup() {\n   454\t      const results = await Promise.allSettled([...pendingReleases].map(release => release()));\n   455\t      const failures = results.filter((result): result is PromiseRejectedResult => result.status === \"rejected\");\n   456\t      const failure = failures.find(({ reason }) => reason && typeof reason === \"object\" &&\n   457\t        (reason as { phase?: unknown }).phase === \"token-revocation\") ?? failures[0];\n   458\t      if (failure) throw failure.reason;\n   459\t    },\n   460\t    async open(targetContext): Promise<McpFnTransportHandle> {\n   461\t      const context: McpFnRemoteCredentialContext = {\n   462\t        url: targetUrl.toString(),\n   463\t        requestId: targetContext.requestId,\n   464\t        signal: targetContext.signal,\n   465\t      };\n   466\t      const lease = await acquireRemoteCredential(options.credential, context);\n   467\t      const secrets = new Set<string>();\n   468\t      const release = async () => {\n   469\t        try { await lease.release(); }\n   470\t        catch (error) { pendingReleases.add(release); throw error; }\n   471\t        pendingReleases.delete(release);\n   472\t        {\n   473\t          for (const secret of secrets) {\n   474\t            const count = (state.active.get(secret) ?? 1) - 1;\n   475\t            if (count) state.active.set(secret, count); else state.active.delete(secret);\n   476\t          }\n   477\t          secrets.clear();\n   478\t        }\n   479\t      };\n   480\t      let handle: McpFnTransportHandle | undefined;\n   481\t      try {\n   482\t        for (const secret of credentialValues(lease.credential.headers)) {\n   483\t          secrets.add(secret);\n   484\t          state.active.set(secret, (state.active.get(secret) ?? 0) + 1);\n   485\t          for (const scope of state.scopes) scope.add(secret);\n   486\t        }\n   487\t        const credentialHeaders = validateRemoteCredentialHeaders(lease.credential.headers);\n   488\t        const headers = new Headers(requestInit?.headers);\n   489\t        credentialHeaders.forEach((value, name) => headers.set(name, value));\n   490\t        const target = streamableHttpTarget(targetUrl, {\n   491\t          ...transportOptions,\n   492\t          requestInit: {\n   493\t            ...requestInit,\n   494\t            headers,\n   495\t            // Fetch must not replay credentials to a redirect destination.\n   496\t            redirect: \"error\",\n   497\t          },\n   498\t        });\n   499\t        handle = await target.open(targetContext);\n   500\t      } catch (error) {\n   501\t        // Sanitize while the lease still supplies its immutable header snapshot.\n   502\t        // Cleanup removes active secrets before the client emits failed-open diagnostics.\n   503\t        let message = \"Authenticated target could not be opened\";\n   504\t        try { message = redactRemoteCredential(lease.credential, error instanceof Error ? error.message : String(error)); }\n   505\t        catch { /* Invalid or oversized credentials must not escape through diagnostics. */ }\n   506\t        pendingReleases.add(release);\n   507\t        await release();\n   508\t        throw new Error(message);\n   509\t      }\n   510\t\n   511\t      let closePromise: Promise<void> | undefined;\n   512\t      let transportClosed = false;\n   513\t      return {\n   514\t        transport: handle.transport,\n   515\t        finishAuthorization: handle.finishAuthorization,\n   516\t        terminateSession: handle.terminateSession,\n   517\t        close() {\n   518\t          closePromise ??= Promise.resolve().then(async () => {\n   519\t            // The client coordinator retains this handle until both stages finish.\n   520\t            // Never release authentication while transport shutdown still needs retry.\n   521\t            if (!transportClosed) {\n   522\t              if (handle!.close) await handle!.close();\n   523\t              else await handle!.transport.close();\n   524\t              transportClosed = true;\n   525\t            }\n   526\t            await release();\n   527\t          }).catch(async (error) => {\n   528\t            closePromise = undefined;\n   529\t            const phase = transportClosed ? lease.cleanupPhase() : \"transport-close\";\n   530\t            await targetContext.diagnostic({\n   531\t              phase, outcome: \"failed\", code: \"MCPFN_CREDENTIAL_CLEANUP_FAILED\",\n   532\t              requestId: targetContext.requestId, at: new Date().toISOString(),\n   533\t              target: { kind: \"authenticated-streamable-http\", url: descriptorUrl.toString() },\n   534\t              details: { message: \"Target credential cleanup failed\" },\n   535\t            });\n   536\t            throw error;\n   537\t          });\n   538\t          return closePromise;\n   539\t        },\n   540\t      };\n   541\t    },\n   542\t  });\n   543\t  targetSecrets.set(authenticated, state);\n   544\t  return authenticated;\n   545\t}\n   546\t\n   547\tfunction normalizeRemoteTargetUrl(value: string | URL): URL {\n   548\t  const url = new URL(value.toString());\n   549\t  if (url.protocol !== \"http:\" && url.protocol !== \"https:\") {\n   550\t    throw new TypeError(\"Authenticated MCP targets must use HTTP or HTTPS\");\n   551\t  }\n   552\t  if (url.protocol === \"http:\" && url.hostname !== \"[::1]\" &&\n   553\t      !/^127(?:\\.\\d{1,3}){3}$/.test(url.hostname)) {\n   554\t    throw new TypeError(\"Credential-bearing HTTP targets require a literal loopback address; use HTTPS remotely\");\n   555\t  }\n   556\t  if (url.username || url.password || url.hash) {\n   557\t    throw new TypeError(\n   558\t      \"Authenticated MCP target URLs must not contain userinfo or a fragment\",\n   559\t    );\n   560\t  }\n   561\t  return url;\n   562\t}\n   563\t\n   564\tfunction isCredentialProvider(\n   565\t  value: McpFnRemoteCredential | McpFnRemoteCredentialProvider,\n   566\t): value is McpFnRemoteCredentialProvider {\n   567\t  return \"acquire\" in value && typeof value.acquire === \"function\";\n   568\t}\n   569\t\n   570\tfunction boundedCredentialEntries(value: HeadersInit): Array<[string, string]> {\n   571\t  const entries: Array<[string, string]> = [];\n   572\t  let bytes = 0;\n   573\t  const append = (name: string, headerValue: string) => {\n   574\t    if (entries.length >= MAX_CREDENTIAL_HEADERS) throw new TypeError(\"Credential headers exceed the header limit\");\n   575\t    if (typeof name !== \"string\" || typeof headerValue !== \"string\") throw new TypeError(\"Credential header values must be strings\");\n   576\t    if (name.length > MAX_CREDENTIAL_HEADER_BYTES || headerValue.length > MAX_CREDENTIAL_HEADER_VALUE_BYTES) throw new TypeError(\"Credential header exceeds the value-size limit\");\n   577\t    if (new TextEncoder().encode(headerValue).byteLength > MAX_CREDENTIAL_HEADER_VALUE_BYTES) throw new TypeError(\"Credential header exceeds the value-size limit\");\n   578\t    bytes += new TextEncoder().encode(`${name}: ${headerValue}\\r\\n`).byteLength;\n   579\t    if (bytes > MAX_CREDENTIAL_HEADER_BYTES) throw new TypeError(\"Credential headers exceed the aggregate size limit\");\n   580\t    entries.push([name, headerValue]);\n   581\t  };\n   582\t  if (value instanceof Headers) value.forEach((v, k) => append(k, v));\n   583\t  else if (Array.isArray(value)) {\n   584\t    if (value.length > MAX_CREDENTIAL_HEADERS) throw new TypeError(\"Credential headers exceed the header limit\");\n   585\t    for (const entry of value) append(entry[0], entry[1]);\n   586\t  } else {\n   587\t    for (const name in value) if (Object.prototype.hasOwnProperty.call(value, name)) append(name, value[name]);\n   588\t  }\n   589\t  return entries;\n   590\t}\n   591\t\n   592\texport function validateRemoteCredentialHeaders(value: HeadersInit): Headers {\n   593\t  const headers = new Headers(boundedCredentialEntries(value));\n   594\t  const entries: Array<[string, string]> = [];\n   595\t  headers.forEach((headerValue, name) => entries.push([name, headerValue]));\n   596\t  if (entries.length === 0) {\n   597\t    throw new TypeError(\"Authenticated MCP targets require at least one credential header\");\n   598\t  }\n   599\t  if (entries.length > MAX_CREDENTIAL_HEADERS) {\n   600\t    throw new TypeError(`Credential headers exceed the ${MAX_CREDENTIAL_HEADERS}-header limit`);\n   601\t  }\n   602\t  let bytes = 0;\n   603\t  for (const [name, headerValue] of entries) {\n   604\t    if (!headerValue.trim()) throw new TypeError(\"Credential header values must not be blank\");\n   605\t    if (FORBIDDEN_CREDENTIAL_HEADERS.has(name)) {\n   606\t      throw new TypeError(`Credential header ${name} is not allowed`);\n   607\t    }\n   608\t    const valueBytes = new TextEncoder().encode(headerValue).byteLength;\n   609\t    if (valueBytes > MAX_CREDENTIAL_HEADER_VALUE_BYTES) {\n   610\t      throw new TypeError(`Credential header ${name} exceeds the value-size limit`);\n   611\t    }\n   612\t    if (new TextEncoder().encode(headerValue).byteLength > MAX_CREDENTIAL_HEADER_VALUE_BYTES) throw new TypeError(\"Credential header exceeds the value-size limit\");\n   613\t    bytes += new TextEncoder().encode(`${name}: ${headerValue}\\r\\n`).byteLength;\n   614\t  }\n   615\t  if (bytes > MAX_CREDENTIAL_HEADER_BYTES) {\n   616\t    throw new TypeError(\"Credential headers exceed the aggregate size limit\");\n   617\t  }\n   618\t  return headers;\n   619\t}\n   180\t    },\n   181\t    {\n   182\t      id: \"actual-unsupported-token-grant\",\n   183\t      host: \"generic\",\n   184\t      registration: registration(\n   185\t        \"unsupported-token-client\",\n   186\t        \"pre-registered\",\n   187\t        \"https://client.example.com/callback\",\n   188\t        supported,\n   189\t      ),\n   190\t      authorization: authorization(\n   191\t        \"unsupported-token-client\",\n   192\t        \"https://client.example.com/callback\",\n   193\t      ),\n   194\t      token: { grantType: \"urn:example:unsupported-token-grant\" },\n   195\t      expected: {\n   196\t        outcome: \"rejected\",\n   197\t        errorCode: \"unsupported_grant_type\",\n   198\t        phase: \"token-exchange\",\n   199\t      },\n   200\t    },\n   201\t  ];\n   202\t}\n   203\t\n   204\t/** Run the independently-configured hosted-authorization matrix. */\n   205\texport async function runHostedAuthorizationRegression(\n   206\t  target: McpFnHostedAuthorizationTargetAdapter,\n   207\t  fixtures: readonly McpFnHostedAuthorizationCase[],\n   208\t): Promise<McpFnHostedAuthorizationCaseResult[]> {\n   209\t  const results: McpFnHostedAuthorizationCaseResult[] = [];\n   210\t  for (const fixture of fixtures) {\n   211\t    results.push(await runHostedCase(target, fixture));\n   212\t  }\n   213\t  return results;\n   214\t}\n   215\t\n   216\tasync function runHostedCase(\n   217\t  target: McpFnHostedAuthorizationTargetAdapter,\n   218\t  fixture: McpFnHostedAuthorizationCase,\n   219\t): Promise<McpFnHostedAuthorizationCaseResult> {\n   220\t  let phase: McpFnHostedAuthorizationCaseResult[\"phase\"] = \"client-registration\";\n   221\t  let responseStatus: number | undefined;\n   222\t  try {\n   223\t    await target.prepareRegistration(structuredClone(fixture.registration));\n   224\t    phase = \"authorization-request\";\n   225\t    const authorization = new URL(\"authorize\", ensureTrailingSlash(target.issuer));\n   226\t    authorization.searchParams.set(\"response_type\", \"code\");\n   227\t    authorization.searchParams.set(\"client_id\", fixture.authorization.clientId);\n   228\t    authorization.searchParams.set(\"redirect_uri\", fixture.authorization.redirectUri);\n   229\t    authorization.searchParams.set(\n   230\t      \"code_challenge\",\n   231\t      derivePkceS256Challenge(fixture.authorization.codeVerifier),\n   232\t    );\n   233\t    authorization.searchParams.set(\"code_challenge_method\", \"S256\");\n   234\t    authorization.searchParams.set(\"state\", fixture.authorization.state);\n   235\t    authorization.searchParams.set(\"resource\", fixture.authorization.resource);\n   236\t    authorization.searchParams.set(\"scope\", fixture.authorization.scopes.join(\" \"));\n   237\t    responseStatus = undefined;\n   238\t    const authorizationResponse = await target.request(new Request(authorization, {\n   239\t      redirect: \"manual\",\n   240\t    }));\n   241\t    responseStatus = authorizationResponse.status;\n   242\t    const authorizationError = await oauthError(authorizationResponse);\n   243\t    if (authorizationError) {\n   244\t      await validateOAuthRejection(authorizationResponse, fixture, target.issuer, true);\n   245\t      return assessHostedCase(fixture, phase, authorizationResponse.status, authorizationError);\n   246\t    }\n   247\t    if (!isRedirect(authorizationResponse.status)) {\n   248\t      throw new Error(`Authorization request did not redirect (HTTP ${authorizationResponse.status})`);\n   249\t    }\n   250\t    const code = validatedRedirectCode(authorizationResponse, fixture, target.issuer);\n   251\t    if (fixture.token) {\n   252\t      phase = fixture.token.grantType === \"refresh_token\"\n   253\t        ? \"token-refresh\"\n   254\t        : \"token-exchange\";\n   255\t      const tokenBody = new URLSearchParams({\n   256\t        grant_type: fixture.token.grantType,\n   257\t        client_id: fixture.authorization.clientId,\n   258\t      });\n   259\t      if (fixture.token.grantType === \"authorization_code\") {\n   260\t        tokenBody.set(\"code\", fixture.token.code ?? code);\n   261\t        tokenBody.set(\"redirect_uri\", fixture.authorization.redirectUri);\n   262\t        tokenBody.set(\"code_verifier\", fixture.authorization.codeVerifier);\n   263\t        tokenBody.set(\"resource\", fixture.authorization.resource);\n   264\t      } else if (fixture.token.refreshToken) {\n   265\t        tokenBody.set(\"refresh_token\", fixture.token.refreshToken);\n   266\t        tokenBody.set(\"resource\", fixture.authorization.resource);\n   267\t      }\n   268\t      responseStatus = undefined;\n   269\t      const tokenResponse = await target.request(new Request(\n   270\t        new URL(\"token\", ensureTrailingSlash(target.issuer)),\n   271\t        {\n   272\t          method: \"POST\",\n   273\t          redirect: \"manual\",\n   274\t          headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n   275\t          body: tokenBody,\n   276\t        },\n   277\t      ));\n   278\t      responseStatus = tokenResponse.status;\n   279\t      const tokenError = await oauthError(tokenResponse);\n   280\t      if (tokenError) {\n   281\t        await validateOAuthRejection(tokenResponse, fixture, target.issuer);\n   282\t        return assessHostedCase(fixture, phase, tokenResponse.status, tokenError);\n   283\t      }\n   284\t      if (!tokenResponse.ok) throw new Error(`Token request returned HTTP ${tokenResponse.status}`);\n   285\t      const tokenSet = await validatedTokenSet(tokenResponse);\n   286\t      responseStatus = tokenResponse.status;\n   287\t      if (fixture.token.refreshAfterExchange) {\n   288\t        if (typeof tokenSet.refresh_token !== \"string\" || !tokenSet.refresh_token) {\n   289\t          throw new Error(\"Authorization-code response did not include a refresh token\");\n   290\t        }\n   291\t        phase = \"token-refresh\";\n   292\t        responseStatus = undefined;\n   293\t        const refreshResponse = await target.request(new Request(\n   294\t          new URL(\"token\", ensureTrailingSlash(target.issuer)),\n   295\t          {\n   296\t            method: \"POST\",\n   297\t            redirect: \"manual\",\n   298\t            headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n   299\t            body: new URLSearchParams({\n   300\t              grant_type: \"refresh_token\",\n   301\t              client_id: fixture.authorization.clientId,\n   302\t              refresh_token: tokenSet.refresh_token,\n   303\t              resource: fixture.authorization.resource,\n   304\t            }),\n   305\t          },\n   306\t        ));\n   307\t        responseStatus = refreshResponse.status;\n   308\t        const refreshError = await oauthError(refreshResponse);\n   309\t        if (refreshError) {\n   310\t          await validateOAuthRejection(refreshResponse, fixture, target.issuer);\n   311\t          return assessHostedCase(fixture, phase, refreshResponse.status, refreshError);\n   312\t        }\n   313\t        if (!refreshResponse.ok) {\n   314\t          throw new Error(`Refresh request returned HTTP ${refreshResponse.status}`);\n   315\t        }\n   316\t        await validatedTokenSet(refreshResponse);\n   317\t        responseStatus = refreshResponse.status;\n   318\t      }\n   319\t    }\n   320\t    return assessHostedCase(fixture, phase, responseStatus);\n   321\t  } catch (error) {\n   322\t    const redacted = redactOAuthValue(error);\n   323\t    const safe = redacted && typeof redacted === \"object\" ? redacted as Record<string, unknown> : {};\n   324\t    const code = typeof safe.code === \"string\" ? safe.code : undefined;\n   325\t    const message = typeof safe.message === \"string\" ? safe.message : String(redacted);\n   326\t    return assessHostedCase(fixture, phase, responseStatus, code, message || \"Hosted adapter failed\");\n   327\t  }\n   328\t}\n   329\t\n   330\tfunction assessHostedCase(\n   331\t  fixture: McpFnHostedAuthorizationCase,\n   332\t  phase: McpFnHostedAuthorizationCaseResult[\"phase\"],\n   333\t  responseStatus?: number,\n   334\t  errorCode?: string,\n   335\t  error?: string,\n   336\t): McpFnHostedAuthorizationCaseResult {\n   337\t  const observedOutcome = errorCode || error ? \"rejected\" : \"allowed\";\n   338\t  const expected = fixture.expected;\n   339\t  const passed = !error && observedOutcome === expected.outcome &&\n   340\t    (expected.errorCode === undefined || expected.errorCode === errorCode) &&\n   341\t    (expected.phase === undefined || expected.phase === phase);\n   342\t  return {\n   343\t    formatVersion: 1,\n   344\t    id: fixture.id,\n   345\t    host: fixture.host,\n   346\t    status: passed ? \"passed\" : \"failed\",\n   347\t    phase,\n   348\t    layer: phase === \"client-registration\" ? \"mcpfn-preflight\" : \"authorization-server\",\n   349\t    ...(responseStatus === undefined ? {} : { responseStatus }),\n   350\t    ...(errorCode ? { errorCode } : {}),\n   351\t    ...(!passed || error ? {\n   352\t      error: error ??\n   353\t        `Expected ${expected.outcome}${expected.errorCode ? `:${expected.errorCode}` : \"\"}, received ${observedOutcome}${errorCode ? `:${errorCode}` : \"\"}`,\n   354\t    } : {}),\n   355\t  };\n   356\t}\n   357\t\n   358\tfunction isJsonResponse(response: Response): boolean {\n   359\t  const mediaType = (response.headers.get(\"content-type\") ?? \"\").split(\";\", 1)[0].trim().toLowerCase();\n   360\t  return mediaType === \"application/json\" || /^application\\/[a-z0-9!#$&^_.+-]+\\+json$/.test(mediaType);\n   361\t}\n   362\t\n   363\tasync function oauthError(response: Response): Promise<string | undefined> {\n   364\t  const location = response.headers.get(\"location\");\n   365\t  if (location) {\n   366\t    const code = new URL(location).searchParams.get(\"error\");\n   367\t    if (code) return code;\n   368\t  }\n   369\t  if (!isJsonResponse(response)) return undefined;\n   370\t  const body = await response.clone().json().catch(() => undefined) as\n   371\t    | { error?: unknown }\n   372\t    | undefined;\n   373\t  return typeof body?.error === \"string\" ? body.error : undefined;\n   374\t}\n   375\t\n   376\tasync function validateOAuthRejection(\n   377\t  response: Response,\n   378\t  fixture: McpFnHostedAuthorizationCase,\n   379\t  issuer: string,\n   380\t  authorization = false,\n   381\t): Promise<void> {\n   382\t  if (authorization && isRedirect(response.status)) {\n   383\t    const callback = new URL(response.headers.get(\"location\") ?? \"\");\n   384\t    // Redirects must target the registered URI, never a rejected requested URI.\n   385\t    const registered = fixture.registration.metadata.redirect_uris as string[];\n   386\t    if (!registered?.includes(fixture.authorization.redirectUri)) throw new Error(\"Rejected redirect URI must not receive a callback\");\n   387\t    const errors = callback.searchParams.getAll(\"error\");\n   388\t    if (errors.length !== 1 || !errors[0] || callback.searchParams.has(\"code\")) throw new Error(\"Invalid OAuth error callback\");\n   389\t    if (errors[0] === \"invalid_client\") throw new Error(\"Invalid-client authorization failures must not redirect\");\n   390\t    callback.searchParams.delete(\"error\");\n   391\t    callback.searchParams.delete(\"error_description\");\n   392\t    callback.searchParams.delete(\"error_uri\");\n   393\t    callback.searchParams.set(\"code\", \"error-envelope-validation\");\n   394\t    validatedRedirectCode(\n   395\t      new Response(null, { status: response.status, headers: { location: callback.toString() } }),\n   396\t      fixture,\n   397\t      issuer,\n   398\t    );\n   399\t  } else {\n   400\t    const body = await response.clone().json().catch(() => undefined);\n   401\t    // An unrecognized/incompatible client must not receive a redirect. Other\n   402\t    // authorization errors for the registered callback must use that callback.\n   403\t    if (authorization && body?.error !== \"invalid_client\" && (fixture.registration.metadata.redirect_uris as string[])?.includes(fixture.authorization.redirectUri)) {\n   404\t      throw new Error(\"Registered authorization requests require an OAuth error callback\");\n   405\t    }\n   406\t    if (response.status !== 400) throw new Error(\"OAuth error response has invalid HTTP status\");\n   407\t    if (response.headers.has(\"location\") || !isJsonResponse(response) ||\n   408\t        !body || typeof body.error !== \"string\" || !body.error) {\n   409\t      throw new Error(\"OAuth error response must be a JSON error envelope\");\n   410\t    }\n   411\t  }\n   412\t}\n   413\t\n   414\tfunction validatedRedirectCode(\n   415\t  response: Response,\n   416\t  fixture: McpFnHostedAuthorizationCase,\n   417\t  issuer: string,\n   418\t): string {\n   419\t  const location = response.headers.get(\"location\");\n   420\t  if (!location) throw new Error(\"Authorization callback is missing\");\n   421\t  const callback = new URL(location);\n   422\t  const expected = new URL(fixture.authorization.redirectUri);\n   423\t  const codes = callback.searchParams.getAll(\"code\");\n   424\t  const states = callback.searchParams.getAll(\"state\");\n   425\t  if (codes.length !== 1 || !codes[0] || states.length !== 1 || states[0] !== fixture.authorization.state) {\n   426\t    throw new Error(\"Authorization callback code or state is invalid\");\n   427\t  }\n   428\t  const issuers = callback.searchParams.getAll(\"iss\");\n   429\t  if (issuers.length > 1 || (issuers.length === 1 && issuers[0] !== issuer)) {\n   430\t    throw new Error(\"Authorization callback issuer is invalid\");\n     1\timport type { McpFnDiagnosticPhase } from \"@mcpfn/client\";\n     2\timport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n     3\t\n     4\timport type { McpFnTargetSuiteReport } from \"./suite.js\";\n     5\t\n     6\tdeclare const __MCPFN_TESTING_VERSION__: string;\n     7\t\n     8\texport const MCPFN_TESTING_VERSION = __MCPFN_TESTING_VERSION__;\n     9\texport const MCPFN_REPORT_SCHEMA_VERSION = \"1.0.0\";\n    10\t\n    11\texport type McpFnFailureLayer =\n    12\t  | \"mcpfn-preflight\"\n    13\t  | \"authorization-server\"\n    14\t  | \"resource-server\"\n    15\t  | \"mcp-initialization\"\n    16\t  | \"scenario\"\n    17\t  | \"upstream-conformance\";\n    18\t\n    19\texport interface McpFnReportFailure {\n    20\t  name: string;\n    21\t  message: string;\n    22\t  layer: McpFnFailureLayer;\n    23\t  code?: string;\n    24\t  phase?: string;\n    25\t  details?: Record<string, unknown>;\n    26\t}\n    27\t\n    28\texport interface McpFnJunitOptions {\n    29\t  /** Aggregate XML size cap after serialization. Defaults to 1 MiB. */\n    30\t  maxBytes?: number;\n    31\t}\n    32\t\n    33\texport function normalizeMcpFnReportFailure(\n    34\t  error: unknown,\n    35\t  fallbackPhase?: McpFnDiagnosticPhase | \"scenario\" | \"upstream-conformance\",\n    36\t): McpFnReportFailure {\n    37\t  const redacted = redactOAuthValue(error, {\n    38\t    maxDepth: 6,\n    39\t    maxArrayEntries: 50,\n    40\t    maxObjectEntries: 50,\n    41\t    maxStringLength: 2_048,\n    42\t  });\n    43\t  const record = redacted && typeof redacted === \"object\" && !Array.isArray(redacted)\n    44\t    ? redacted as Record<string, unknown>\n    45\t    : {};\n    46\t  const phase = stringField(record.phase) ?? fallbackPhase;\n    47\t  const details = record.details && typeof record.details === \"object\" &&\n    48\t      !Array.isArray(record.details)\n    49\t    ? record.details as Record<string, unknown>\n    50\t    : undefined;\n    51\t  let message = stringField(record.message) ?? String(\n    52\t    redactOAuthValue(error instanceof Error ? error.message : String(error)),\n    53\t  );\n    54\t  const cause = error && typeof error === \"object\"\n    55\t    ? (error as { cause?: unknown }).cause\n    56\t    : undefined;\n    57\t  const redactedCause = cause === undefined\n    58\t    ? undefined\n    59\t    : redactOAuthValue(cause, {\n    60\t      maxDepth: 4,\n    61\t      maxArrayEntries: 20,\n    62\t      maxObjectEntries: 20,\n    63\t      maxStringLength: 1_024,\n    64\t    });\n    65\t  const causeRecord = redactedCause && typeof redactedCause === \"object\" &&\n    66\t      !Array.isArray(redactedCause)\n    67\t    ? redactedCause as Record<string, unknown>\n    68\t    : undefined;\n    69\t  const causeMessage = stringField(causeRecord?.message);\n    70\t  if (causeMessage && !message.includes(causeMessage)) message = `${message}: ${causeMessage}`;\n    71\t  const combinedDetails = causeRecord\n    72\t    ? { ...(details ?? {}), cause: causeRecord }\n    73\t    : details;\n    74\t  return {\n    75\t    name: stringField(record.name) ?? \"Error\",\n    76\t    message,\n    77\t    layer: failureLayer(phase) !== \"authorization-server\" && [causeRecord?.code, causeRecord?.status, record.code, record.status].some(value => [401, 403].includes(Number(value)))\n    78\t      ? \"resource-server\" : failureLayer(phase),\n    79\t    ...(stringField(record.code) ? { code: stringField(record.code)! } : {}),\n    80\t    ...(phase ? { phase } : {}),\n    81\t    ...(combinedDetails ? { details: combinedDetails } : {}),\n    82\t  };\n    83\t}\n    84\t\n    85\t/** Serialize a redacted target-suite report as bounded JUnit XML. */\n    86\texport function createMcpFnTargetSuiteJUnit(\n    87\t  report: McpFnTargetSuiteReport,\n    88\t  options: McpFnJunitOptions = {},\n    89\t): string {\n    90\t  const maxBytes = options.maxBytes ?? 1_048_576;\n    91\t  validateArtifactCap(maxBytes);\n    92\t  const safe = redactOAuthValue(report, {\n    93\t    maxDepth: 10,\n    94\t    maxArrayEntries: 1_000,\n    95\t    maxObjectEntries: 200,\n    96\t    maxStringLength: 4_096,\n    97\t  }) as unknown as McpFnTargetSuiteReport;\n    98\t  // Redaction appends a string sentinel when an array exceeds its cap.\n    99\t  const results = safe.results.filter((result) => result && typeof result === \"object\" && typeof result.name === \"string\");\n   100\t  const omitted = report.results.length - results.length;\n   101\t  const cases = results.map((result) => {\n   102\t    const duration = Math.max(0, result.durationMs ?? 0) / 1_000;\n   103\t    const failure = result.status === \"passed\"\n   104\t      ? \"\"\n   105\t      : junitFailure(\n   106\t        result.error ?? `Scenario ${result.status}`,\n   107\t        result.status === \"failed\" ? \"scenario\" : \"incomplete\",\n   108\t      );\n   109\t    return `    <testcase name=\"${xml(result.name)}\" classname=\"mcpfn.scenario\" time=\"${duration.toFixed(3)}\">${failure}</testcase>`;\n   110\t  });\n   111\t  if (safe.failure) {\n   112\t    cases.unshift(\n   113\t      `    <testcase name=\"${xml(safe.failure.phase ?? \"target\")}\" classname=\"mcpfn.${xml(safe.failure.layer)}\" time=\"0.000\">${junitFailure(safe.failure.message, safe.failure.code ?? safe.failure.layer)}</testcase>`,\n   114\t    );\n   115\t  }\n   116\t  if (safe.status === \"incomplete\" || omitted > 0 || (!safe.ok && !safe.failure && results.every((result) => result.status === \"passed\"))) {\n   117\t    cases.push(`    <testcase name=\"suite-incomplete\" classname=\"mcpfn.report\" time=\"0.000\">${junitFailure(safe.incompleteReason ?? \"Suite evidence is incomplete or omitted\", \"incomplete\")}</testcase>`);\n   118\t  }\n   119\t  if (cases.length === 0) {\n   120\t    cases.push(\n   121\t      '    <testcase name=\"target-suite\" classname=\"mcpfn.target\" time=\"0.000\"></testcase>',\n   122\t    );\n   123\t  }\n   124\t  const failures = cases.filter((entry) => entry.includes(\"<failure \")).length;\n   125\t  let serialized = junitDocument(safe, cases, failures);\n   126\t  if (bytes(serialized) <= maxBytes) return serialized;\n   127\t\n   128\t  const boundedCases = [\n   129\t    `    <testcase name=\"artifact-cap\" classname=\"mcpfn.report\" time=\"0.000\">${junitFailure(\"JUnit content exceeded maxBytes and was truncated\", \"incomplete\")}</testcase>`,\n   130\t  ];\n   131\t  serialized = junitDocument(safe, boundedCases, 1, true);\n   132\t  if (bytes(serialized) > maxBytes) {\n   133\t    throw new Error(\"The minimum McpFn JUnit report exceeds maxBytes\");\n   134\t  }\n   135\t  return serialized;\n   136\t}\n   137\t\n   138\tfunction junitDocument(\n   139\t  report: McpFnTargetSuiteReport,\n   140\t  cases: string[],\n   141\t  failures: number,\n   142\t  truncated = false,\n   143\t): string {\n   144\t  const suiteName = String(redactOAuthValue(`mcpfn:${report.target.kind}`));\n   145\t  return [\n   146\t    '<?xml version=\"1.0\" encoding=\"UTF-8\"?>',\n   147\t    `<testsuite name=\"${xml(suiteName)}\" tests=\"${cases.length}\" failures=\"${failures}\" errors=\"0\" skipped=\"0\">`,\n   148\t    \"  <properties>\",\n   149\t    `    <property name=\"mcpfn.report.schema\" value=\"${xml(MCPFN_REPORT_SCHEMA_VERSION)}\"/>`,\n   150\t    `    <property name=\"mcpfn.testing.version\" value=\"${xml(MCPFN_TESTING_VERSION)}\"/>`,\n   110\t  } catch (error) {\n   111\t    if (owner) throw owner;\n   112\t    if (failureMessage) {\n   113\t      throw new McpFnClientError(\n   114\t        \"MCPFN_OPERATION_FAILED\",\n   115\t        failureMessage,\n   116\t        { phase: \"capability-operation\" },\n   117\t      );\n   118\t    }\n   119\t    throw error;\n   120\t  }\n   121\t}\n   122\t\n   123\texport async function runCli(\n   124\t  argv = process.argv.slice(2),\n   125\t  runOptions: CliRunOptions = {},\n   126\t): Promise<number> {\n   127\t  const cwd = runOptions.cwd ?? process.cwd();\n   128\t  const stdout = runOptions.stdout ?? ((text: string) => writeProcessOutput(process.stdout, text));\n   129\t  const stderr = runOptions.stderr ?? ((text: string) => writeProcessOutput(process.stderr, text));\n   130\t  let exitCode = 0;\n   131\t  const cli = cac(\"mcpfn\");\n   132\t\n   133\t  cli.command(\"manifest <source>\", \"Generate a canonical manifest from a server or registry module\")\n   134\t    .option(\"--output <path>\", \"Write the manifest to a file\")\n   135\t    .option(\"--name <name>\", \"Server name when source exports a registry\")\n   136\t    .option(\"--version <version>\", \"Server version when source exports a registry\")\n   137\t    .action(async (source: string, options: { output?: string; name?: string; version?: string }) => {\n   138\t      const info = options.name && options.version\n   139\t        ? { name: options.name, version: options.version }\n   140\t        : undefined;\n   141\t      const { manifest } = await loadManifestSource(source, cwd, info);\n   142\t      const serialized = `${JSON.stringify(manifest, null, 2)}\\n`;\n   143\t      if (options.output) {\n   144\t        const outputPath = path.resolve(cwd, options.output);\n   145\t        await writeFile(outputPath, serialized, \"utf8\");\n   146\t        await stdout(`Wrote ${outputPath}\\n`);\n   147\t      } else {\n   148\t        await stdout(serialized);\n   149\t      }\n   150\t    });\n   540\t      if (error) reject(error);\n   541\t      else resolve();\n   542\t    });\n   543\t  });\n   544\t}\n   545\t\n   546\tfunction readRemoteCredential(\n   547\t  options: RemoteAuthCliOptions,\n   548\t): { credential: McpFnRemoteCredential; environmentName: string } | undefined {\n   549\t  if (options.bearerTokenEnv && options.apiKeyEnv) {\n   550\t    throw new Error(\"Use only one of --bearer-token-env or --api-key-env\");\n   551\t  }\n   552\t  if (options.apiKeyHeader && !options.apiKeyEnv) {\n   553\t    throw new Error(\"--api-key-header requires --api-key-env\");\n   554\t  }\n   555\t  const environmentName = options.bearerTokenEnv ?? options.apiKeyEnv;\n   556\t  if (!environmentName) return undefined;\n   557\t  if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(environmentName)) {\n   558\t    throw new Error(\"Credential environment variable names must be portable identifiers\");\n   559\t  }\n   560\t  const value = process.env[environmentName];\n   561\t  if (value === undefined || value.length === 0) {\n   562\t    throw new Error(`Credential environment variable ${environmentName} is missing or empty`);\n   563\t  }\n   564\t  if (options.bearerTokenEnv) {\n   565\t    try { new Headers({ authorization: `Bearer ${value}` }); }\n   566\t    catch { throw new Error(\"Bearer token must be a valid HTTP header value\"); }\n   567\t    if (!/^[A-Za-z0-9._~+/-]+=*$/.test(value)) throw new Error(\"Bearer token must follow the RFC 6750 token grammar\");\n   568\t    return {\n   569\t      environmentName,\n   570\t      credential: {\n     1\timport type {\n     2\t  CallToolResult,\n     3\t  CreateTaskResult,\n     4\t  GetPromptResult,\n     5\t  Implementation,\n     6\t  Prompt,\n     7\t  ReadResourceResult,\n     8\t  Resource,\n     9\t  ResourceTemplate,\n    10\t  ServerCapabilities,\n    11\t  Tool,\n    12\t  Task,\n    13\t  ListTasksResult,\n    14\t} from \"@modelcontextprotocol/sdk/types.js\";\n    15\timport {\n    16\t  McpFnClient,\n    17\t  type McpFnClientOptions,\n    18\t  type McpFnClientEvent,\n    19\t  type McpFnDiagnosticEvent,\n    20\t  type McpFnTargetDescriptor,\n    21\t} from \"@mcpfn/client\";\n    22\timport {\n    23\t  createMcpFnScenario,\n    24\t  type McpFnScenario,\n    25\t} from \"@mcpfn/testing\";\n    26\t\n    27\tconst SCENARIO_REDACTION_LIMITS = {\n    28\t  maxDepth: 8,\n    29\t  maxArrayEntries: 100,\n    30\t  maxObjectEntries: 100,\n    31\t  maxStringLength: 2_048,\n    32\t} as const;\n    33\tconst SCENARIO_SECRET_MARKER = \"${MCPFN_SECRET}\";\n    34\tconst SCENARIO_SECRET_MARKERS = [\n    35\t  SCENARIO_SECRET_MARKER,\n    36\t  \"${SECRET}\",\n    37\t  \"${CREDENTIAL}\",\n    38\t  ...Array.from({ length: 26 }, (_, index) => `\\${${String.fromCharCode(65 + index)}}`),\n    39\t];\n    40\t\n    41\texport interface McpFnInspectorSnapshot {\n    42\t  formatVersion: 2;\n    43\t  kind: \"mcpfn.inspector-snapshot\";\n    44\t  target: McpFnTargetDescriptor;\n    45\t  clientState: string;\n    46\t  server?: Implementation;\n    47\t  capabilities?: ServerCapabilities;\n    48\t  tools: Tool[];\n    49\t  resources: Resource[];\n    50\t  resourceTemplates: ResourceTemplate[];\n   260\t      return {\n   261\t        formatVersion,\n   262\t        kind: safeKind,\n   263\t        sideEffect: safeSideEffect,\n   264\t        name: \"\",\n   265\t        status: this.client.preserveArtifactStructure(\"incomplete\"),\n   266\t        incompleteReason: this.client.redact(\n   267\t          \"Inspector export omitted payload because credential redaction failed\",\n   268\t          { preserveKeys: false, redactionMarker: \"\" },\n   269\t        ),\n   270\t      } as McpFnExportedScenario;\n   271\t    }\n   272\t    const replaced = redacted as unknown as McpFnExportedScenario;\n   273\t    const incompleteReason = secretMarker === undefined\n   274\t      ? \"Inspector export could not select a replayable redaction placeholder\"\n   275\t      : exceedsRedactionBounds(scenario, redacted, SCENARIO_REDACTION_LIMITS)\n   276\t        ? \"Inspector export exceeded redaction bounds and was truncated\"\n   277\t        : undefined;\n   278\t    const exported = incompleteReason\n   279\t      ? {\n   280\t        ...replaced,\n   281\t        status: this.client.preserveArtifactStructure(\"incomplete\"),\n   282\t        incompleteReason: this.client.redact(incompleteReason, {\n   283\t          preserveKeys: false,\n   284\t          redactionMarker: \"\",\n   285\t        }),\n   286\t      }\n   287\t      : replaced;\n   288\t    const variables = collectVariables(exported);\n   289\t    return variables.length ? { ...exported, variables } : exported;\n   290\t  }\n   300\t    let settled = false;\n   301\t    child.once(\"error\", (error) => {\n   302\t      if (settled) return;\n   303\t      settled = true;\n   304\t      const failure = normalizeMcpFnReportFailure(error, \"upstream-conformance\");\n   305\t      resolve({\n   306\t        formatVersion: 1,\n   307\t        kind: \"mcpfn.official-conformance-report\",\n   308\t        ok: false,\n   309\t        suiteVersion: OFFICIAL_CONFORMANCE_VERSION,\n   310\t        exitCode: 1,\n   311\t        stdout: \"\",\n   312\t        stderr: failure.message,\n   313\t        failure,\n   314\t      });\n   315\t    });\n   316\t    const finish = (code: number | null) => {\n   317\t      if (settled) return;\n   318\t      settled = true;\n   319\t      let exitCode = code ?? 1;\n   320\t      let safeStdout = \"\";\n   321\t      let safeStderr = \"\";\n   322\t      try {\n   323\t        if (outputExceeded) throw new Error(\"capture limit\");\n   324\t        safeStdout = redactOutput(stdout);\n   325\t        safeStderr = redactOutput(stderr);\n   326\t      } catch {\n   327\t        exitCode = 1;\n   328\t        safeStdout = \"\";\n   329\t        safeStderr = outputExceeded ? \"Conformance output exceeded its capture limit\" : \"Conformance output omitted because credential redaction exceeded its bounds\";\n   330\t      }\n   331\t      const failure = exitCode === 0\n   332\t        ? undefined\n   333\t        : normalizeMcpFnReportFailure(\n   334\t          new Error(safeStderr || safeStdout || `Official conformance exited ${exitCode}`),\n   335\t          \"upstream-conformance\",\n   336\t        );\n   337\t      resolve({\n   338\t        formatVersion: 1,\n   339\t        kind: \"mcpfn.official-conformance-report\",\n   340\t        ok: exitCode === 0,\n   341\t        suiteVersion: OFFICIAL_CONFORMANCE_VERSION,\n   342\t        exitCode,\n   343\t        stdout: safeStdout,\n   344\t        stderr: safeStderr,\n   345\t        ...(failure ? { failure } : {}),\n   346\t      });\n   347\t    };\n   348\t    child.once(\"close\", finish);\n   349\t  });\n   350\t}\n   351\t\n   352\tconst retainedConformanceCleanup = new WeakMap<Error, () => Promise<void>>();\n   353\t\n   354\t/** Cleanup failed after retries. Retain this error and call retryCleanup(). */\n   355\texport class McpFnConformanceCleanupError extends Error {\n   356\t  constructor(release: () => Promise<void>, readonly result?: OfficialConformanceResult) {\n   357\t    super(\"Authenticated conformance credential cleanup failed; retry cleanup\");\n   358\t    this.name = \"McpFnConformanceCleanupError\";\n   359\t    retainedConformanceCleanup.set(this, release);\n   360\t  }\n   361\t  async retryCleanup(): Promise<void> {\n   362\t    const release = retainedConformanceCleanup.get(this);\n   363\t    if (!release) return;\n   364\t    try { await release(); }\n   365\t    catch { throw this; }\n   366\t    retainedConformanceCleanup.delete(this);\n   367\t  }\n   368\t}\n   369\t\n   370\t/**\n   371\t * Run the pinned official suite against an authenticated MCP endpoint.\n   372\t * Always captures stdio (even when inherit is requested) to redact credentials.\n   373\t * outputDir is rejected before acquisition; only the returned redacted result is safe to persist.\n   374\t */\n   375\texport async function runAuthenticatedOfficialConformance(\n   376\t  options: AuthenticatedOfficialConformanceOptions,\n   377\t): Promise<OfficialConformanceResult> {\n   378\t  if (options.outputDir !== undefined) throw new TypeError(\"Authenticated conformance does not support outputDir; serialize the redacted result instead\");\n   379\t  const { headers, credential, ...conformance } = options;\n   380\t  if ((headers === undefined) === (credential === undefined)) {\n    25\t  authProvider?: OAuthClientProvider;\n    26\t}\n    27\t\n    28\tinterface StateValidatingOAuthProvider extends OAuthClientProvider {\n    29\t  validateAuthorizationState?(state: string | undefined): void | Promise<void>;\n    30\t  invalidatePendingAuthorization?(): void | Promise<void>;\n    31\t}\n    32\t\n    33\texport function customTarget(options: {\n    34\t  kind: string;\n    35\t  descriptor?: Record<string, unknown>;\n    36\t  open(context: McpFnTargetContext): Promise<McpFnTransportHandle> | McpFnTransportHandle;\n    37\t  cleanup?(): Promise<void>;\n    38\t  redact?: McpFnTarget[\"redact\"];\n    39\t}): McpFnTarget {\n    40\t  const descriptor = Object.freeze({ kind: options.kind, ...options.descriptor });\n    41\t  return {\n    42\t    kind: options.kind,\n    43\t    describe: () => ({ ...descriptor }),\n    44\t    open: (context) => Promise.resolve(options.open(context)),\n    45\t    ...(options.cleanup ? { cleanup: () => options.cleanup!() } : {}),\n    46\t    ...(options.redact ? { redact: options.redact } : {}),\n    47\t  };\n    48\t}\n    49\t\n    50\texport function transportTarget(\n    65\tasync function toWebRequest(request: IncomingMessage): Promise<Request> {\n    66\t  const chunks: Buffer[] = [];\n    67\t  for await (const chunk of request) {\n    68\t    chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk));\n    69\t  }\n    70\t  const body = Buffer.concat(chunks);\n    71\t  return new Request(\n    72\t    new URL(request.url ?? \"/\", `http://${request.headers.host ?? \"127.0.0.1\"}`),\n    73\t    {\n    74\t      method: request.method,\n    75\t      headers: new Headers(Object.entries(request.headers).flatMap(([name, value]) =>\n    76\t        Array.isArray(value)\n    77\t          ? value.map((entry) => [name, entry] as [string, string])\n    78\t          : value === undefined ? [] : [[name, value] as [string, string]],\n    79\t      )),\n    80\t      ...(body.length ? { body } : {}),\n    81\t    },\n    82\t  );\n    83\t}\n    84\t\n    85\tasync function sendWebResponse(response: ServerResponse, web: Response): Promise<void> {\n    86\t  response.writeHead(web.status, Object.fromEntries(web.headers));\n    87\t  if (!web.body) { response.end(); return; }\n    88\t  await pipeline(Readable.fromWeb(web.body as Parameters<typeof Readable.fromWeb>[0]), response);\n    89\t}\n    90\t\n   120\t  const chunks = [];\n   121\t  let size = 0;\n   122\t  for await (const chunk of incoming) {\n   123\t    const buffer = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);\n   124\t    size += buffer.length;\n   125\t    if (size > MAX_REQUEST_BYTES) throw new Error(\"Request body too large\");\n   126\t    chunks.push(buffer);\n   127\t  }\n   128\t  const body = Buffer.concat(chunks);\n   129\t  return new Request(url, {\n   130\t    method: incoming.method,\n   131\t    headers: new Headers(Object.entries(incoming.headers).flatMap(([name, value]) =>\n   132\t      Array.isArray(value)\n   133\t        ? value.map((entry) => [name, entry])\n   134\t        : value === undefined ? [] : [[name, value]],\n   135\t    )),\n   136\t    ...(body.length ? { body } : {}),\n   137\t  });\n   138\t}\n   139\t\n   140\tasync function sendWebResponse(outgoing, response) {\n   141\t  outgoing.writeHead(response.status, Object.fromEntries(response.headers));\n   142\t  if (!response.body) {\n   143\t    outgoing.end();\n   144\t    return;\n   145\t  }\n","exit_code":0,"duration":{"secs":0,"nanos":2250},"formatted_output":"Warning: truncated output (original token count: 16976)\nTotal output lines: 1332\n\n     1\timport {\n     2\t  McpFnClientError,\n     3\t  customTarget,\n     4\t  streamableHttpTarget,\n     5\t  type McpFnStreamableHttpTargetOptions,\n     6\t  type McpFnTarget,\n     7\t  type McpFnTransportHandle,\n     8\t} from \"@mcpfn/client\";\n     9\t\n    10\timport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n    11\t\n    12\ttype SecretState = { active: Map<string, number>; scopes: Set<Set<string>> };\n    13\tconst targetSecrets = new WeakMap<McpFnTarget, SecretState>();\n    14\t\n    15\t/** Retain released credentials only for the lifetime of a report operation. */\n    16\texport function beginTargetCredentialRedaction(target: McpFnTarget): () => void {\n    17\t  const state = targetSecrets.get(target);\n    18\t  if (!state) return () => undefined;\n    19\t  const scope = new Set(state.active.keys());\n    20\t  state.scopes.add(scope);\n    21\t  return () => { state.scopes.delete(scope); scope.clear(); };\n    22\t}\n    23\t\n    24\tfunction credentialValues(headers: HeadersInit): Set<string> {\n    25\t  const values = boundedCredentialEntries(headers);\n    26\t  const secrets = new Set<string>();\n    27\t  for (const [header, raw] of values) {\n    28\t    if (typeof raw !== \"string\" || !raw.trim()) continue;\n    29\t    secrets.add(raw);\n    30\t    secrets.add(raw.trim());\n    31\t    const trimmed = raw.trim();\n    32\t    const separator = trimmed.search(/\\s/);\n    33\t    const scheme = separator > 0 ? trimmed.slice(0, separator).toLowerCase() : \"\";\n    34\t    const authorization = [\"authorization\", \"proxy-authorization\"].includes(header.toLowerCase());\n    35\t    // Authorization headers carry schemes, including supported custom ones.\n    36\t    // Other credential headers are opaque even when their values contain spaces.\n    37\t    if (authorization && separator > 0) {\n    38\t      const token = trimmed.slice(separator).trim();\n    39\t      if (token) secrets.add(token);\n    40\t      if (scheme === \"basic\" && /^[A-Za-z0-9+/]+={0,2}$/.test(token)) {\n    41\t        const decoded = Buffer.from(token, \"base64\");\n    42\t        // Round-trip validation avoids interpreting malformed tokens as credentials.\n    43\t        if (decoded.toString(\"base64\").replace(/=+$/, \"\") === token.replace(/=+$/, \"\")) {\n    44\t          for (const encoding of [\"utf8\", \"latin1\"] as const) {\n    45\t            const pair = decoded.toString(encoding);\n    46\t            const colon = pair.indexOf(\":\");\n    47\t            if (colon < 0) continue;\n    48\t            for (const value of [pair, pair.slice(0, colon), pair.slice(colon + 1)]) {\n    49\t              if (value) secrets.add(value);\n    50\t            }\n    51\t          }\n    52\t        }\n    53\t      }\n    54\t    }\n    55\t    if (header.toLowerCase() === \"cookie\") {\n    56\t      // Cookie values are independently reflectable even though the request\n    57\t      // authenticates with the complete header. RFC 6265 cookie values cannot\n    58\t      // contain comma or semicolon, so both delimiters safely cover combined\n    59\t      // Headers entries as well as the normal Cookie serialization.\n    60\t      for (const part of raw.split(/[;,]/)) {\n    61\t        const pair = part.trim();\n    62\t        if (!pair) continue;\n    63\t        const equals = pair.indexOf(\"=\");\n    64\t        if (equals < 1) {\n    65\t          throw new TypeError(\"Cookie credential headers must contain name=value pairs\");\n    66\t        }\n    67\t        const value = pair.slice(equals + 1).trim();\n    68\t        if (!value) continue;\n    69\t        secrets.add(value);\n    70\t        if (value.startsWith('\"') || value.endsWith('\"')) {\n    71\t          if (value.length < 2 || !value.startsWith('\"') || !value.endsWith('\"')) {\n    72\t            throw new TypeError(\"Cookie credential values must use balanced quotes\");\n    73\t          }\n    74\t          const unquoted = value.slice(1, -1);\n    75\t          if (unquoted.includes('\"') || unquoted.includes(\"\\\\\")) {\n    76\t            throw new TypeError(\"Cookie credential values must use RFC 6265 syntax\");\n    77\t          }\n    78\t          if (unquoted) secrets.add(unquoted);\n    79\t        }\n    80\t      }\n    81\t    }\n    82\t  }\n    83\t  return secrets;\n    84\t}\n    85\t\n    86\texport class McpFnRedactionLimitError extends Error {\n    87\t  constructor(message = \"Credential redaction exceeded its traversal budget\") { super(message); }\n    88\t}\n    89\t\n    90\t/** No typed artifact can preserve this authored key without exposing a credential. */\n    91\texport class McpFnStructuralCredentialCollisionError extends McpFnRedactionLimitError {\n    92\t  constructor() {\n    93\t    super(\"Credential collides with a required structural artifact key\");\n    94\t  }\n    95\t}\n    96\t\n    97\t// Only these locally authored envelope paths retain structural keys. Unknown\n    98\t// children (including inspector events and server metadata) are always payloads.\n    99\tconst envelopeKeys: Record<string, Set<string>> = Object.fromEntries(Object.entries({\n   100\t  root: \"formatVersion kind status runtime ok target server capabilities manifestChecked manifestHash total passed failed incomplete droppedResults droppedObservedEvents redactionOmittedObservedEvents incompleteReason failure timeline droppedTimelineEvents results count clientState tools resources resourceTemplates prompts droppedEvents timelineComplete droppedInventoryEntries inventoryComplete suiteVersion exitCode stdout stderr phase outcome code requestId at details payload\",\n   101\t  result: \"formatVersion name operation tool status sideEffect durationMs error droppedObservedEvents redactionOmittedObservedEvents\",\n   102\t  diagnostic: \"phase outcome code requestId at target details\",\n   103\t  inspectorEvent: \"formatVersion source kind at event\",\n   104\t  failure: \"name message layer code phase details\",\n   105\t  runtime: \"node scenarioFormatVersion reportSchemaVersion packages\",\n   106\t  packages: \"testing\",\n   107\t  droppedInventoryEntries: \"tools resources resourceTemplates prompts\",\n   108\t  target: \"kind\",\n   109\t}).map(([role, keys]) => [role, new Set(keys.split(\" \"))]));\n   110\t\n   111\tfunction specialValue(input: unknown): unknown {\n   112\t  if (input instanceof Error) {\n   113\t    // Error instances may expose attacker-controlled enumerable keys. A\n   114\t    // null-prototype accumulator keeps `__proto__` as ordinary payload data.\n   115\t    const normalized = Object.create(null) as Record<string, unknown>;\n   116\t    let enumerableFields = 0;\n   117\t    for (const key in input) {\n   118\t      if (!Object.hasOwn(input, key)) continue;\n   119\t      if (++enumerableFields > 100_000) throw new McpFnRedactionLimitError();\n   120\t      normalized[key] = (input as unknown as Record<string, unknown>)[key];\n   121\t    }\n   122\t    normalized.name = input.name;\n   123\t    normalized.message = input.message;\n   124\t    normalized.stack = input.stack;\n   125\t    if (input.cause !== undefined) normalized.cause = input.cause;\n   126\t    return normalized;\n   127\t  }\n   128\t  if (input instanceof Date) return Number.isNaN(input.getTime()) ? \"Invalid Date\" : input.toISOString();\n   129\t  if (input instanceof URL) return input.href;\n   130\t  if (input instanceof Map) {\n   131\t    if (Object.getOwnPropertyDescriptor(Map.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   132\t    return { type: \"Map\", entries: [...Map.prototype.entries.call(input)] };\n   133\t  }\n   134\t  if (input instanceof Set) {\n   135\t    if (Object.getOwnPropertyDescriptor(Set.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   136\t    return { type: \"Set\", values: [...Set.prototype.values.call(input)] };\n   137\t  }\n   138\t  return input;\n   139\t}\n   140\t\n   141\tfunction scrubCredentials<T>(value: T, values: Iterable<string>, preserveKeys = false, redactionMarker?: string): T {\n   142\t  // Preserve whether a pattern came from opaque text or a serializer. Literal\n   143\t  // percent sequences in credentials must not acquire URL hex-case semantics.\n   144\t  const variants = [...values].filter(Boolean).flatMap(secret => [\n   145\t    { value: secret, encoded: false },\n   146\t    { value: JSON.stringify(secret).slice(1, -1), encoded: false },\n   147\t    { value: encodeURIComponent(secret), encoded: true },\n   148\t    { value: new URLSearchParams({ value: secret }).toString().slice(\"value=\".length), encoded: true },\n   149\t  ]).sort((a, b) => b.value.length - a.value.length);\n   150\t  let entries = 0, stringBytes = 0;\n   151\t  const budget = (input: unknown, depth = 0): void => {\n   152\t    input = specialValue(input);\n   153\t    if ((Array.isArray(input) && input.length > 100_000) || ++entries > 100_000 || depth > 32) throw new McpFnRedactionLimitError();\n   154\t    if (typeof input === \"string\") {\n   155\t      stringBytes += Buffer.byteLength(input);\n   156\t      if (input.length > 262_144 || stringBytes > 2_097_152) throw new McpFnRedactionLimitError();\n   157\t    } else if (input && typeof input === \"object\") {\n   158\t      for (const key in input) if (Object.hasOwn(input, key)) {\n   159\t        budget(key, depth + 1);\n   160\t        budget((input as Record<string, unknown>)[key], depth + 1);\n   161\t      }\n   162\t    }\n   163\t  };\n   164\t  // Check before either redactor allocates copies. Exceeding a budget is an\n   165\t  // explicit failure, never silent truncation of a typed report collection.\n   166\t  budget(value);\n   167\t  const patterns = variants.map(({ value, encoded }) => {\n   168\t    const literal = value.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n   169\t    // Only generated percent escapes accept mixed-case hex digits.\n   170\t    return encoded\n   171\t      ? literal.replace(/%[0-9A-Fa-f]{2}/g, escape => escape.replace(/[A-Fa-f]/g, hex => `[${hex.toLowerCase()}${hex.toUpperCase()}]`))\n   172\t      : literal;\n   173\t  });\n   174\t  const secretPattern = patterns.length ? new RegExp(patterns.join(\"|\"), \"g\") : undefined;\n   175\t  const replacementPattern = patterns.length ? new RegExp(patterns.join(\"|\")) : undefined;\n   176\t  const preserveStructural = (input: string): string => {\n   177\t    if (replacementPattern?.test(input)) {\n   178\t      throw new McpFnRedactionLimitError(\n   179\t        \"Credential collides with a required structural artifact field\",\n   180\t      );\n   181\t    }\n   182\t    return input;\n   183\t  };\n   184\t  const preserveStructuralKey = (input: string): string => {\n   185\t    if (replacementPattern?.test(input)) {\n   186\t      throw new McpFnStructuralCredentialCollisionError();\n   187\t    }\n   188\t    return input;\n   189\t  };\n   190\t  // A requested marker is itself output and must not reproduce a credential.\n   191\t  if (secretPattern) {\n   192\t    const markerContainsSecret = secretPattern.test(redactionMarker ?? \"[REDACTED]\");\n   193\t    secretPattern.lastIndex = 0;\n   194\t    if (markerContainsSecret) redactionMarker = \"\";\n   195\t  }\n   196\t  const clientKinds = new Set([\"logging.message\", \"progress\", \"tasks.status\", \"resources.updated\", \"tools.list_changed\", \"resources.list_changed\", \"prompts.list_changed\", \"resources.subscribed\", \"resources.unsubscribed\", \"client.roots\", \"client.sampling\", \"client.elicitation\"]);\n   197\t  const scrub = (input: unknown, role = \"payload\", field = \"\", finalPass = false): unknown => {\n   198\t    input = specialValue(input);\n   199\t    if (typeof input === \"string\") {\n   200\t      if ((role === \"root\" || role === \"inspectorEvent\") && field === \"kind\" && clientKinds.has(input)) return preserveStructural(input);\n   201\t      if (role === \"root\" && field === \"clientState\" && [\"idle\", \"connecting\", \"authorization-required\", \"connected\", \"closing\", \"closed\"].includes(input)) return preserveStructural(input);\n   202\t      if (role === \"target\" && field === \"kind\" && [\"authenticated-streamable-http\", \"streamable-http\", \"stdio\", \"in-memory\", \"custom\"].includes(input)) return preserveStructural(input);\n   203\t      if ((role === \"packages\" && field === \"testing\") || (role === \"runtime\" && [\"node\", \"reportSchemaVersion\"].includes(field)) || (role === \"root\" && field === \"suiteVersion\")) return preserveStructural(input);\n   204\t      if ((role === \"root\" || role === \"result\") && field === \"status\" && [\"passed\", \"failed\", \"incomplete\", \"complete\"].includes(input)) return preserveStructural(input);\n   205\t      if ((role === \"root\" || role === \"diagnostic\") && field === \"outcome\" && [\"started\", \"succeeded\", \"failed\"].includes(input)) return preserveStructural(input);\n   206\t      if (role === \"root\" && field === \"kind\" && [\"mcpfn.target-suite-report\", \"mcpfn.inspector-snapshot\", \"mcpfn.official-conformance-report\"].includes(input)) return preserveStructural(input);\n   207\t      if ((role === \"root\" || role === \"diagnostic\" || role === \"failure\") && field === \"phase\" && [\"resource-discovery\", \"authorization-server-discovery\", \"client-registration\", \"authorization-request\", \"authorization-callback\", \"token-exchange\", \"token-refresh\", \"token-revocation\", \"transport-connect\", \"mcp-initialize\", \"capability-operation\", \"transport-close\"].includes(input)) return preserveStructural(input);\n   208\t      if (role === \"failure\" && field === \"layer\" && [\"mcpfn-preflight\", \"authorization-server\", \"resource-server\", \"mcp-initialization\", \"scenario\", \"upstream-conformance\"].includes(input)) return preserveStructural(input);\n   209\t      if (role === \"inspectorEvent\" && field === \"source\" && [\"diagnostic\", \"client\"].includes(input)) return preserveStructural(input);\n   210\t      if (role === \"result\" && field === \"sideEffect\" && [\"none\", \"idempotent\", \"non-idempotent\"].includes(input)) return preserveStructural(input);\n   211\t      // Whole-string rejection cannot compose another credential by joining pieces.\n   212\t      // Run after both redactors; never feed this result through another redactor.\n   213\t      if (finalPass) return replacementPattern?.test(input) ? \"\" : input;\n   214\t      return secretPattern ? input.replace(secretPattern, secret => {\n   215\t        const replacement = redactionMarker ?? (secret.length < 10 ? (secret.includes(\"*\") ? \"#\" : \"*\").repeat(secret.length) : \"[REDACTED]\");\n   216\t        // Every generated mask must be safe against the entire credential set.\n   217\t        return replacementPattern!.test(replacement) ? \"\" : replacement;\n   218\t      }) : input;\n   219\t    }\n   220\t    if (Array.isArray(input)) {\n   221\t      const result = input.map(entry => scrub(entry, role, \"\", finalPass));\n   222\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   223\t      return result;\n   224\t    }\n   225\t    if (input && typeof input === \"object\") {\n   226\t      const entries: Array<[string, unknown]> = [];\n   227\t      const keys = new Set<string>();\n   228\t      for (const [key, entry] of Object.entries(input)) {\n   229\t        const fixed = envelopeKeys[role]?.has(key) ?? false;\n   230\t        if (fixed) preserveStructuralKey(key);\n   231\t        let childRole = \"payload\";\n   232\t        if (fixed) {\n   233\t          if (key === \"results\") childRole = \"result\";\n   234\t          else if (key === \"timeline\") childRole = (value as any)?.kind === \"mcpfn.inspector-snapshot\" ? \"inspectorEvent\" : \"diagnostic\";\n   235\t          else if ([\"failure\", \"runtime\", \"packages\", \"droppedInventoryEntries\", \"target\"].includes(key)) childRole = key;\n   236\t          else if (role === \"inspectorEvent\" && key === \"event\") childRole = (input as { source?: string }).source === \"client\" ? \"root\" : \"diagnostic\";\n   237\t        }\n   238\t        const scrubbedKey = fixed ? key : scrub(key, \"payload\", \"\", finalPass) as string;\n   239\t        if (keys.has(scrubbedKey)) {\n   240\t          throw new McpFnRedactionLimitError(\n   241\t            \"Credential redaction created duplicate object keys\",\n   242\t          );\n   243\t        }\n   244\t        keys.add(scrubbedKey);\n   245\t        entries.push([\n   246\t          scrubbedKey,\n   247\t          typeof entry === \"string\"\n   248\t            ? scrub(entry, fixed ? role : \"payload\", key, finalPass)\n   249\t            : scrub(entry, childRole, \"\", finalPass),\n   250\t        ]);\n   251\t      }\n   252\t      const result = Object.fromEntries(entries);\n   253\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   254\t      return result;\n   255\t    }\n   256\t    return input;\n   257\t  };\n   258\t  const timelineEvent = value && typeof value === \"object\" && [\"client\", \"diagnostic\"].includes((value as { source?: string }).source ?? \"\");\n   259\t  const role = preserveKeys ? (timelineEvent ? \"inspectorEvent\" : \"root\") : \"payload\";\n   260\t  const scrubbed = scrub(value, role);\n   261\t  const generic = redactOAuthValue(scrubbed, { maxStringLength: 262_144, maxDepth: 64, maxArrayEntries: 100_000, maxObjectEntries: 100_000, ...(redactionMarker !== undefined ? { redactionMarker } : {}) });\n   262\t  const result = scrub(generic, role, \"\", true) as T;\n   263\t  assertPayloadSerialization(\n   264\t    result,\n   265\t    \"payload\",\n   266\t    true,\n   267\t    replacementPattern,\n   268\t  );\n   269\t  return result;\n   270\t}\n   271\t\n   272\tfunction assertPayloadSerialization(\n   273\t  value: unknown,\n   274\t  role: string,\n   275\t  finalPass: boolean,\n   276\t  credentialPattern: RegExp | undefined,\n   277\t): void {\n   278\t  if (!finalPass || role !== \"payload\" || !credentialPattern) return;\n   279\t  const serialized = JSON.stringify(value);\n   280\t  if (serialized !== undefined && credentialPattern.test(serialized)) {\n   281\t    throw new McpFnRedactionLimitError(\n   282\t      \"Credential redaction could not guarantee safe serialized output\",\n   283\t    );\n   284\t  }\n   285\t}\n   286\t\n   287\t/** Remove known opaque credential values as well as credential-shaped fields. */\n   288\texport function redactTargetCredentials<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean; redactionMarker?: string } = {}): T {\n   289\t  const state = targetSecrets.get(target);\n   290\t  return scrubCredentials(value, new Set([...(state?.active.keys() ?? []), ...[...(state?.scopes ?? [])].flatMap((scope) => [...scope])]), options.preserveKeys, options.redactionMarker);\n   291\t}\n   292\t\n   293\t/** Redact authenticated conformance output using the acquired credential. */\n   294\texport function redactRemoteCredential<T>(credential: McpFnRemoteCredential, value: T, options: { preserveKeys?: boolean } = {}): T {\n   295\t  return scrubCredentials(value, credentialValues(credential.headers), options.preserveKeys);\n   296\t}\n   297\t\n   298\tconst MAX_CREDENTIAL_HEADERS = 32;\n   299\tconst MAX_CREDENTIAL_HEADER_BYTES = 16_384;\n   300\tconst MAX_CREDENTIAL_HEADER_VALUE_BYTES = 8_192;\n   301\tconst FORBIDDEN_CREDENTIAL_HEADERS = new Set([\n   302\t  \"connection\",\n   303\t  \"content-length\",\n   304\t  \"host\",\n   305\t  \"proxy-connection\",\n   306\t  \"te\",\n   307\t  \"trailer\",\n   308\t  \"transfer-encoding\",\n   309\t  \"upgrade\",\n   310\t]);\n   311\t\n   312\texport type McpFnRemoteCredentialKind = \"api-key\" | \"oauth\" | \"custom\";\n   313\t\n   314\texport interface McpFnRemoteCredential {\n   315\t  /** Credential headers are applied only to the fixed target origin. */\n   316\t  headers: HeadersInit;\n   317\t  kind?: McpFnRemoteCredentialKind;\n   318\t  label?: string;\n   319\t}\n   320\t\n   321\texport interface McpFnRemoteCredentialContext {\n   322\t  url: string;\n   323\t  requestId: string;\n   324\t  signal?: AbortSignal;\n   325\t}\n   326\t\n   327\t/**\n   328\t * Application-owned credential lifecycle for external MCP targets. McpFn\n   329\t * acquires once per target open, revokes before disposal, and never serializes\n   330\t * the returned headers into descriptors or reports. If acquisition rejects, the\n   331\t * provider must roll back its own partial resources; no lease has been returned.\n   332\t */\n   333\texport interface McpFnRemoteCredentialProvider {\n   334\t  acquire(\n   335\t    context: McpFnRemoteCredentialContext,\n   336\t  ): McpFnRemoteCredential | Promise<McpFnRemoteCredential>;\n   337\t  revoke?(\n   338\t    credential: McpFnRemoteCredential,\n   3…6976 tokens truncated…MCPFN_TESTING_VERSION__;\n     9\texport const MCPFN_REPORT_SCHEMA_VERSION = \"1.0.0\";\n    10\t\n    11\texport type McpFnFailureLayer =\n    12\t  | \"mcpfn-preflight\"\n    13\t  | \"authorization-server\"\n    14\t  | \"resource-server\"\n    15\t  | \"mcp-initialization\"\n    16\t  | \"scenario\"\n    17\t  | \"upstream-conformance\";\n    18\t\n    19\texport interface McpFnReportFailure {\n    20\t  name: string;\n    21\t  message: string;\n    22\t  layer: McpFnFailureLayer;\n    23\t  code?: string;\n    24\t  phase?: string;\n    25\t  details?: Record<string, unknown>;\n    26\t}\n    27\t\n    28\texport interface McpFnJunitOptions {\n    29\t  /** Aggregate XML size cap after serialization. Defaults to 1 MiB. */\n    30\t  maxBytes?: number;\n    31\t}\n    32\t\n    33\texport function normalizeMcpFnReportFailure(\n    34\t  error: unknown,\n    35\t  fallbackPhase?: McpFnDiagnosticPhase | \"scenario\" | \"upstream-conformance\",\n    36\t): McpFnReportFailure {\n    37\t  const redacted = redactOAuthValue(error, {\n    38\t    maxDepth: 6,\n    39\t    maxArrayEntries: 50,\n    40\t    maxObjectEntries: 50,\n    41\t    maxStringLength: 2_048,\n    42\t  });\n    43\t  const record = redacted && typeof redacted === \"object\" && !Array.isArray(redacted)\n    44\t    ? redacted as Record<string, unknown>\n    45\t    : {};\n    46\t  const phase = stringField(record.phase) ?? fallbackPhase;\n    47\t  const details = record.details && typeof record.details === \"object\" &&\n    48\t      !Array.isArray(record.details)\n    49\t    ? record.details as Record<string, unknown>\n    50\t    : undefined;\n    51\t  let message = stringField(record.message) ?? String(\n    52\t    redactOAuthValue(error instanceof Error ? error.message : String(error)),\n    53\t  );\n    54\t  const cause = error && typeof error === \"object\"\n    55\t    ? (error as { cause?: unknown }).cause\n    56\t    : undefined;\n    57\t  const redactedCause = cause === undefined\n    58\t    ? undefined\n    59\t    : redactOAuthValue(cause, {\n    60\t      maxDepth: 4,\n    61\t      maxArrayEntries: 20,\n    62\t      maxObjectEntries: 20,\n    63\t      maxStringLength: 1_024,\n    64\t    });\n    65\t  const causeRecord = redactedCause && typeof redactedCause === \"object\" &&\n    66\t      !Array.isArray(redactedCause)\n    67\t    ? redactedCause as Record<string, unknown>\n    68\t    : undefined;\n    69\t  const causeMessage = stringField(causeRecord?.message);\n    70\t  if (causeMessage && !message.includes(causeMessage)) message = `${message}: ${causeMessage}`;\n    71\t  const combinedDetails = causeRecord\n    72\t    ? { ...(details ?? {}), cause: causeRecord }\n    73\t    : details;\n    74\t  return {\n    75\t    name: stringField(record.name) ?? \"Error\",\n    76\t    message,\n    77\t    layer: failureLayer(phase) !== \"authorization-server\" && [causeRecord?.code, causeRecord?.status, record.code, record.status].some(value => [401, 403].includes(Number(value)))\n    78\t      ? \"resource-server\" : failureLayer(phase),\n    79\t    ...(stringField(record.code) ? { code: stringField(record.code)! } : {}),\n    80\t    ...(phase ? { phase } : {}),\n    81\t    ...(combinedDetails ? { details: combinedDetails } : {}),\n    82\t  };\n    83\t}\n    84\t\n    85\t/** Serialize a redacted target-suite report as bounded JUnit XML. */\n    86\texport function createMcpFnTargetSuiteJUnit(\n    87\t  report: McpFnTargetSuiteReport,\n    88\t  options: McpFnJunitOptions = {},\n    89\t): string {\n    90\t  const maxBytes = options.maxBytes ?? 1_048_576;\n    91\t  validateArtifactCap(maxBytes);\n    92\t  const safe = redactOAuthValue(report, {\n    93\t    maxDepth: 10,\n    94\t    maxArrayEntries: 1_000,\n    95\t    maxObjectEntries: 200,\n    96\t    maxStringLength: 4_096,\n    97\t  }) as unknown as McpFnTargetSuiteReport;\n    98\t  // Redaction appends a string sentinel when an array exceeds its cap.\n    99\t  const results = safe.results.filter((result) => result && typeof result === \"object\" && typeof result.name === \"string\");\n   100\t  const omitted = report.results.length - results.length;\n   101\t  const cases = results.map((result) => {\n   102\t    const duration = Math.max(0, result.durationMs ?? 0) / 1_000;\n   103\t    const failure = result.status === \"passed\"\n   104\t      ? \"\"\n   105\t      : junitFailure(\n   106\t        result.error ?? `Scenario ${result.status}`,\n   107\t        result.status === \"failed\" ? \"scenario\" : \"incomplete\",\n   108\t      );\n   109\t    return `    <testcase name=\"${xml(result.name)}\" classname=\"mcpfn.scenario\" time=\"${duration.toFixed(3)}\">${failure}</testcase>`;\n   110\t  });\n   111\t  if (safe.failure) {\n   112\t    cases.unshift(\n   113\t      `    <testcase name=\"${xml(safe.failure.phase ?? \"target\")}\" classname=\"mcpfn.${xml(safe.failure.layer)}\" time=\"0.000\">${junitFailure(safe.failure.message, safe.failure.code ?? safe.failure.layer)}</testcase>`,\n   114\t    );\n   115\t  }\n   116\t  if (safe.status === \"incomplete\" || omitted > 0 || (!safe.ok && !safe.failure && results.every((result) => result.status === \"passed\"))) {\n   117\t    cases.push(`    <testcase name=\"suite-incomplete\" classname=\"mcpfn.report\" time=\"0.000\">${junitFailure(safe.incompleteReason ?? \"Suite evidence is incomplete or omitted\", \"incomplete\")}</testcase>`);\n   118\t  }\n   119\t  if (cases.length === 0) {\n   120\t    cases.push(\n   121\t      '    <testcase name=\"target-suite\" classname=\"mcpfn.target\" time=\"0.000\"></testcase>',\n   122\t    );\n   123\t  }\n   124\t  const failures = cases.filter((entry) => entry.includes(\"<failure \")).length;\n   125\t  let serialized = junitDocument(safe, cases, failures);\n   126\t  if (bytes(serialized) <= maxBytes) return serialized;\n   127\t\n   128\t  const boundedCases = [\n   129\t    `    <testcase name=\"artifact-cap\" classname=\"mcpfn.report\" time=\"0.000\">${junitFailure(\"JUnit content exceeded maxBytes and was truncated\", \"incomplete\")}</testcase>`,\n   130\t  ];\n   131\t  serialized = junitDocument(safe, boundedCases, 1, true);\n   132\t  if (bytes(serialized) > maxBytes) {\n   133\t    throw new Error(\"The minimum McpFn JUnit report exceeds maxBytes\");\n   134\t  }\n   135\t  return serialized;\n   136\t}\n   137\t\n   138\tfunction junitDocument(\n   139\t  report: McpFnTargetSuiteReport,\n   140\t  cases: string[],\n   141\t  failures: number,\n   142\t  truncated = false,\n   143\t): string {\n   144\t  const suiteName = String(redactOAuthValue(`mcpfn:${report.target.kind}`));\n   145\t  return [\n   146\t    '<?xml version=\"1.0\" encoding=\"UTF-8\"?>',\n   147\t    `<testsuite name=\"${xml(suiteName)}\" tests=\"${cases.length}\" failures=\"${failures}\" errors=\"0\" skipped=\"0\">`,\n   148\t    \"  <properties>\",\n   149\t    `    <property name=\"mcpfn.report.schema\" value=\"${xml(MCPFN_REPORT_SCHEMA_VERSION)}\"/>`,\n   150\t    `    <property name=\"mcpfn.testing.version\" value=\"${xml(MCPFN_TESTING_VERSION)}\"/>`,\n   110\t  } catch (error) {\n   111\t    if (owner) throw owner;\n   112\t    if (failureMessage) {\n   113\t      throw new McpFnClientError(\n   114\t        \"MCPFN_OPERATION_FAILED\",\n   115\t        failureMessage,\n   116\t        { phase: \"capability-operation\" },\n   117\t      );\n   118\t    }\n   119\t    throw error;\n   120\t  }\n   121\t}\n   122\t\n   123\texport async function runCli(\n   124\t  argv = process.argv.slice(2),\n   125\t  runOptions: CliRunOptions = {},\n   126\t): Promise<number> {\n   127\t  const cwd = runOptions.cwd ?? process.cwd();\n   128\t  const stdout = runOptions.stdout ?? ((text: string) => writeProcessOutput(process.stdout, text));\n   129\t  const stderr = runOptions.stderr ?? ((text: string) => writeProcessOutput(process.stderr, text));\n   130\t  let exitCode = 0;\n   131\t  const cli = cac(\"mcpfn\");\n   132\t\n   133\t  cli.command(\"manifest <source>\", \"Generate a canonical manifest from a server or registry module\")\n   134\t    .option(\"--output <path>\", \"Write the manifest to a file\")\n   135\t    .option(\"--name <name>\", \"Server name when source exports a registry\")\n   136\t    .option(\"--version <version>\", \"Server version when source exports a registry\")\n   137\t    .action(async (source: string, options: { output?: string; name?: string; version?: string }) => {\n   138\t      const info = options.name && options.version\n   139\t        ? { name: options.name, version: options.version }\n   140\t        : undefined;\n   141\t      const { manifest } = await loadManifestSource(source, cwd, info);\n   142\t      const serialized = `${JSON.stringify(manifest, null, 2)}\\n`;\n   143\t      if (options.output) {\n   144\t        const outputPath = path.resolve(cwd, options.output);\n   145\t        await writeFile(outputPath, serialized, \"utf8\");\n   146\t        await stdout(`Wrote ${outputPath}\\n`);\n   147\t      } else {\n   148\t        await stdout(serialized);\n   149\t      }\n   150\t    });\n   540\t      if (error) reject(error);\n   541\t      else resolve();\n   542\t    });\n   543\t  });\n   544\t}\n   545\t\n   546\tfunction readRemoteCredential(\n   547\t  options: RemoteAuthCliOptions,\n   548\t): { credential: McpFnRemoteCredential; environmentName: string } | undefined {\n   549\t  if (options.bearerTokenEnv && options.apiKeyEnv) {\n   550\t    throw new Error(\"Use only one of --bearer-token-env or --api-key-env\");\n   551\t  }\n   552\t  if (options.apiKeyHeader && !options.apiKeyEnv) {\n   553\t    throw new Error(\"--api-key-header requires --api-key-env\");\n   554\t  }\n   555\t  const environmentName = options.bearerTokenEnv ?? options.apiKeyEnv;\n   556\t  if (!environmentName) return undefined;\n   557\t  if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(environmentName)) {\n   558\t    throw new Error(\"Credential environment variable names must be portable identifiers\");\n   559\t  }\n   560\t  const value = process.env[environmentName];\n   561\t  if (value === undefined || value.length === 0) {\n   562\t    throw new Error(`Credential environment variable ${environmentName} is missing or empty`);\n   563\t  }\n   564\t  if (options.bearerTokenEnv) {\n   565\t    try { new Headers({ authorization: `Bearer ${value}` }); }\n   566\t    catch { throw new Error(\"Bearer token must be a valid HTTP header value\"); }\n   567\t    if (!/^[A-Za-z0-9._~+/-]+=*$/.test(value)) throw new Error(\"Bearer token must follow the RFC 6750 token grammar\");\n   568\t    return {\n   569\t      environmentName,\n   570\t      credential: {\n     1\timport type {\n     2\t  CallToolResult,\n     3\t  CreateTaskResult,\n     4\t  GetPromptResult,\n     5\t  Implementation,\n     6\t  Prompt,\n     7\t  ReadResourceResult,\n     8\t  Resource,\n     9\t  ResourceTemplate,\n    10\t  ServerCapabilities,\n    11\t  Tool,\n    12\t  Task,\n    13\t  ListTasksResult,\n    14\t} from \"@modelcontextprotocol/sdk/types.js\";\n    15\timport {\n    16\t  McpFnClient,\n    17\t  type McpFnClientOptions,\n    18\t  type McpFnClientEvent,\n    19\t  type McpFnDiagnosticEvent,\n    20\t  type McpFnTargetDescriptor,\n    21\t} from \"@mcpfn/client\";\n    22\timport {\n    23\t  createMcpFnScenario,\n    24\t  type McpFnScenario,\n    25\t} from \"@mcpfn/testing\";\n    26\t\n    27\tconst SCENARIO_REDACTION_LIMITS = {\n    28\t  maxDepth: 8,\n    29\t  maxArrayEntries: 100,\n    30\t  maxObjectEntries: 100,\n    31\t  maxStringLength: 2_048,\n    32\t} as const;\n    33\tconst SCENARIO_SECRET_MARKER = \"${MCPFN_SECRET}\";\n    34\tconst SCENARIO_SECRET_MARKERS = [\n    35\t  SCENARIO_SECRET_MARKER,\n    36\t  \"${SECRET}\",\n    37\t  \"${CREDENTIAL}\",\n    38\t  ...Array.from({ length: 26 }, (_, index) => `\\${${String.fromCharCode(65 + index)}}`),\n    39\t];\n    40\t\n    41\texport interface McpFnInspectorSnapshot {\n    42\t  formatVersion: 2;\n    43\t  kind: \"mcpfn.inspector-snapshot\";\n    44\t  target: McpFnTargetDescriptor;\n    45\t  clientState: string;\n    46\t  server?: Implementation;\n    47\t  capabilities?: ServerCapabilities;\n    48\t  tools: Tool[];\n    49\t  resources: Resource[];\n    50\t  resourceTemplates: ResourceTemplate[];\n   260\t      return {\n   261\t        formatVersion,\n   262\t        kind: safeKind,\n   263\t        sideEffect: safeSideEffect,\n   264\t        name: \"\",\n   265\t        status: this.client.preserveArtifactStructure(\"incomplete\"),\n   266\t        incompleteReason: this.client.redact(\n   267\t          \"Inspector export omitted payload because credential redaction failed\",\n   268\t          { preserveKeys: false, redactionMarker: \"\" },\n   269\t        ),\n   270\t      } as McpFnExportedScenario;\n   271\t    }\n   272\t    const replaced = redacted as unknown as McpFnExportedScenario;\n   273\t    const incompleteReason = secretMarker === undefined\n   274\t      ? \"Inspector export could not select a replayable redaction placeholder\"\n   275\t      : exceedsRedactionBounds(scenario, redacted, SCENARIO_REDACTION_LIMITS)\n   276\t        ? \"Inspector export exceeded redaction bounds and was truncated\"\n   277\t        : undefined;\n   278\t    const exported = incompleteReason\n   279\t      ? {\n   280\t        ...replaced,\n   281\t        status: this.client.preserveArtifactStructure(\"incomplete\"),\n   282\t        incompleteReason: this.client.redact(incompleteReason, {\n   283\t          preserveKeys: false,\n   284\t          redactionMarker: \"\",\n   285\t        }),\n   286\t      }\n   287\t      : replaced;\n   288\t    const variables = collectVariables(exported);\n   289\t    return variables.length ? { ...exported, variables } : exported;\n   290\t  }\n   300\t    let settled = false;\n   301\t    child.once(\"error\", (error) => {\n   302\t      if (settled) return;\n   303\t      settled = true;\n   304\t      const failure = normalizeMcpFnReportFailure(error, \"upstream-conformance\");\n   305\t      resolve({\n   306\t        formatVersion: 1,\n   307\t        kind: \"mcpfn.official-conformance-report\",\n   308\t        ok: false,\n   309\t        suiteVersion: OFFICIAL_CONFORMANCE_VERSION,\n   310\t        exitCode: 1,\n   311\t        stdout: \"\",\n   312\t        stderr: failure.message,\n   313\t        failure,\n   314\t      });\n   315\t    });\n   316\t    const finish = (code: number | null) => {\n   317\t      if (settled) return;\n   318\t      settled = true;\n   319\t      let exitCode = code ?? 1;\n   320\t      let safeStdout = \"\";\n   321\t      let safeStderr = \"\";\n   322\t      try {\n   323\t        if (outputExceeded) throw new Error(\"capture limit\");\n   324\t        safeStdout = redactOutput(stdout);\n   325\t        safeStderr = redactOutput(stderr);\n   326\t      } catch {\n   327\t        exitCode = 1;\n   328\t        safeStdout = \"\";\n   329\t        safeStderr = outputExceeded ? \"Conformance output exceeded its capture limit\" : \"Conformance output omitted because credential redaction exceeded its bounds\";\n   330\t      }\n   331\t      const failure = exitCode === 0\n   332\t        ? undefined\n   333\t        : normalizeMcpFnReportFailure(\n   334\t          new Error(safeStderr || safeStdout || `Official conformance exited ${exitCode}`),\n   335\t          \"upstream-conformance\",\n   336\t        );\n   337\t      resolve({\n   338\t        formatVersion: 1,\n   339\t        kind: \"mcpfn.official-conformance-report\",\n   340\t        ok: exitCode === 0,\n   341\t        suiteVersion: OFFICIAL_CONFORMANCE_VERSION,\n   342\t        exitCode,\n   343\t        stdout: safeStdout,\n   344\t        stderr: safeStderr,\n   345\t        ...(failure ? { failure } : {}),\n   346\t      });\n   347\t    };\n   348\t    child.once(\"close\", finish);\n   349\t  });\n   350\t}\n   351\t\n   352\tconst retainedConformanceCleanup = new WeakMap<Error, () => Promise<void>>();\n   353\t\n   354\t/** Cleanup failed after retries. Retain this error and call retryCleanup(). */\n   355\texport class McpFnConformanceCleanupError extends Error {\n   356\t  constructor(release: () => Promise<void>, readonly result?: OfficialConformanceResult) {\n   357\t    super(\"Authenticated conformance credential cleanup failed; retry cleanup\");\n   358\t    this.name = \"McpFnConformanceCleanupError\";\n   359\t    retainedConformanceCleanup.set(this, release);\n   360\t  }\n   361\t  async retryCleanup(): Promise<void> {\n   362\t    const release = retainedConformanceCleanup.get(this);\n   363\t    if (!release) return;\n   364\t    try { await release(); }\n   365\t    catch { throw this; }\n   366\t    retainedConformanceCleanup.delete(this);\n   367\t  }\n   368\t}\n   369\t\n   370\t/**\n   371\t * Run the pinned official suite against an authenticated MCP endpoint.\n   372\t * Always captures stdio (even when inherit is requested) to redact credentials.\n   373\t * outputDir is rejected before acquisition; only the returned redacted result is safe to persist.\n   374\t */\n   375\texport async function runAuthenticatedOfficialConformance(\n   376\t  options: AuthenticatedOfficialConformanceOptions,\n   377\t): Promise<OfficialConformanceResult> {\n   378\t  if (options.outputDir !== undefined) throw new TypeError(\"Authenticated conformance does not support outputDir; serialize the redacted result instead\");\n   379\t  const { headers, credential, ...conformance } = options;\n   380\t  if ((headers === undefined) === (credential === undefined)) {\n    25\t  authProvider?: OAuthClientProvider;\n    26\t}\n    27\t\n    28\tinterface StateValidatingOAuthProvider extends OAuthClientProvider {\n    29\t  validateAuthorizationState?(state: string | undefined): void | Promise<void>;\n    30\t  invalidatePendingAuthorization?(): void | Promise<void>;\n    31\t}\n    32\t\n    33\texport function customTarget(options: {\n    34\t  kind: string;\n    35\t  descriptor?: Record<string, unknown>;\n    36\t  open(context: McpFnTargetContext): Promise<McpFnTransportHandle> | McpFnTransportHandle;\n    37\t  cleanup?(): Promise<void>;\n    38\t  redact?: McpFnTarget[\"redact\"];\n    39\t}): McpFnTarget {\n    40\t  const descriptor = Object.freeze({ kind: options.kind, ...options.descriptor });\n    41\t  return {\n    42\t    kind: options.kind,\n    43\t    describe: () => ({ ...descriptor }),\n    44\t    open: (context) => Promise.resolve(options.open(context)),\n    45\t    ...(options.cleanup ? { cleanup: () => options.cleanup!() } : {}),\n    46\t    ...(options.redact ? { redact: options.redact } : {}),\n    47\t  };\n    48\t}\n    49\t\n    50\texport function transportTarget(\n    65\tasync function toWebRequest(request: IncomingMessage): Promise<Request> {\n    66\t  const chunks: Buffer[] = [];\n    67\t  for await (const chunk of request) {\n    68\t    chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk));\n    69\t  }\n    70\t  const body = Buffer.concat(chunks);\n    71\t  return new Request(\n    72\t    new URL(request.url ?? \"/\", `http://${request.headers.host ?? \"127.0.0.1\"}`),\n    73\t    {\n    74\t      method: request.method,\n    75\t      headers: new Headers(Object.entries(request.headers).flatMap(([name, value]) =>\n    76\t        Array.isArray(value)\n    77\t          ? value.map((entry) => [name, entry] as [string, string])\n    78\t          : value === undefined ? [] : [[name, value] as [string, string]],\n    79\t      )),\n    80\t      ...(body.length ? { body } : {}),\n    81\t    },\n    82\t  );\n    83\t}\n    84\t\n    85\tasync function sendWebResponse(response: ServerResponse, web: Response): Promise<void> {\n    86\t  response.writeHead(web.status, Object.fromEntries(web.headers));\n    87\t  if (!web.body) { response.end(); return; }\n    88\t  await pipeline(Readable.fromWeb(web.body as Parameters<typeof Readable.fromWeb>[0]), response);\n    89\t}\n    90\t\n   120\t  const chunks = [];\n   121\t  let size = 0;\n   122\t  for await (const chunk of incoming) {\n   123\t    const buffer = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);\n   124\t    size += buffer.length;\n   125\t    if (size > MAX_REQUEST_BYTES) throw new Error(\"Request body too large\");\n   126\t    chunks.push(buffer);\n   127\t  }\n   128\t  const body = Buffer.concat(chunks);\n   129\t  return new Request(url, {\n   130\t    method: incoming.method,\n   131\t    headers: new Headers(Object.entries(incoming.headers).flatMap(([name, value]) =>\n   132\t      Array.isArray(value)\n   133\t        ? value.map((entry) => [name, entry])\n   134\t        : value === undefined ? [] : [[name, value]],\n   135\t    )),\n   136\t    ...(body.length ? { body } : {}),\n   137\t  });\n   138\t}\n   139\t\n   140\tasync function sendWebResponse(outgoing, response) {\n   141\t  outgoing.writeHead(response.status, Object.fromEntries(response.headers));\n   142\t  if (!response.body) {\n   143\t    outgoing.end();\n   144\t    return;\n   145\t  }\n"},"started_at_ms":1789812223816,"completed_at_ms":1789812223816}}
{"timestamp":"2026-09-19T10:03:43.950Z","ordinal":4586,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0b91f-2fcd-7851-b60b-cf892ccacd6b","call_id":"call_9kzOT62sx1RDt10sywMHP8Ev","output":[{"type":"input_text","text":"Script completed\nWall time 0.3 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 16976)\nTotal output lines: 1332\n\n     1\timport {\n     2\t  McpFnClientError,\n     3\t  customTarget,\n     4\t  streamableHttpTarget,\n     5\t  type McpFnStreamableHttpTargetOptions,\n     6\t  type McpFnTarget,\n     7\t  type McpFnTransportHandle,\n     8\t} from \"@mcpfn/client\";\n     9\t\n    10\timport { redactOAuthValue } from \"@superfunctions/oauth-core\";\n    11\t\n    12\ttype SecretState = { active: Map<string, number>; scopes: Set<Set<string>> };\n    13\tconst targetSecrets = new WeakMap<McpFnTarget, SecretState>();\n    14\t\n    15\t/** Retain released credentials only for the lifetime of a report operation. */\n    16\texport function beginTargetCredentialRedaction(target: McpFnTarget): () => void {\n    17\t  const state = targetSecrets.get(target);\n    18\t  if (!state) return () => undefined;\n    19\t  const scope = new Set(state.active.keys());\n    20\t  state.scopes.add(scope);\n    21\t  return () => { state.scopes.delete(scope); scope.clear(); };\n    22\t}\n    23\t\n    24\tfunction credentialValues(headers: HeadersInit): Set<string> {\n    25\t  const values = boundedCredentialEntries(headers);\n    26\t  const secrets = new Set<string>();\n    27\t  for (const [header, raw] of values) {\n    28\t    if (typeof raw !== \"string\" || !raw.trim()) continue;\n    29\t    secrets.add(raw);\n    30\t    secrets.add(raw.trim());\n    31\t    const trimmed = raw.trim();\n    32\t    const separator = trimmed.search(/\\s/);\n    33\t    const scheme = separator > 0 ? trimmed.slice(0, separator).toLowerCase() : \"\";\n    34\t    const authorization = [\"authorization\", \"proxy-authorization\"].includes(header.toLowerCase());\n    35\t    // Authorization headers carry schemes, including supported custom ones.\n    36\t    // Other credential headers are opaque even when their values contain spaces.\n    37\t    if (authorization && separator > 0) {\n    38\t      const token = trimmed.slice(separator).trim();\n    39\t      if (token) secrets.add(token);\n    40\t      if (scheme === \"basic\" && /^[A-Za-z0-9+/]+={0,2}$/.test(token)) {\n    41\t        const decoded = Buffer.from(token, \"base64\");\n    42\t        // Round-trip validation avoids interpreting malformed tokens as credentials.\n    43\t        if (decoded.toString(\"base64\").replace(/=+$/, \"\") === token.replace(/=+$/, \"\")) {\n    44\t          for (const encoding of [\"utf8\", \"latin1\"] as const) {\n    45\t            const pair = decoded.toString(encoding);\n    46\t            const colon = pair.indexOf(\":\");\n    47\t            if (colon < 0) continue;\n    48\t            for (const value of [pair, pair.slice(0, colon), pair.slice(colon + 1)]) {\n    49\t              if (value) secrets.add(value);\n    50\t            }\n    51\t          }\n    52\t        }\n    53\t      }\n    54\t    }\n    55\t    if (header.toLowerCase() === \"cookie\") {\n    56\t      // Cookie values are independently reflectable even though the request\n    57\t      // authenticates with the complete header. RFC 6265 cookie values cannot\n    58\t      // contain comma or semicolon, so both delimiters safely cover combined\n    59\t      // Headers entries as well as the normal Cookie serialization.\n    60\t      for (const part of raw.split(/[;,]/)) {\n    61\t        const pair = part.trim();\n    62\t        if (!pair) continue;\n    63\t        const equals = pair.indexOf(\"=\");\n    64\t        if (equals < 1) {\n    65\t          throw new TypeError(\"Cookie credential headers must contain name=value pairs\");\n    66\t        }\n    67\t        const value = pair.slice(equals + 1).trim();\n    68\t        if (!value) continue;\n    69\t        secrets.add(value);\n    70\t        if (value.startsWith('\"') || value.endsWith('\"')) {\n    71\t          if (value.length < 2 || !value.startsWith('\"') || !value.endsWith('\"')) {\n    72\t            throw new TypeError(\"Cookie credential values must use balanced quotes\");\n    73\t          }\n    74\t          const unquoted = value.slice(1, -1);\n    75\t          if (unquoted.includes('\"') || unquoted.includes(\"\\\\\")) {\n    76\t            throw new TypeError(\"Cookie credential values must use RFC 6265 syntax\");\n    77\t          }\n    78\t          if (unquoted) secrets.add(unquoted);\n    79\t        }\n    80\t      }\n    81\t    }\n    82\t  }\n    83\t  return secrets;\n    84\t}\n    85\t\n    86\texport class McpFnRedactionLimitError extends Error {\n    87\t  constructor(message = \"Credential redaction exceeded its traversal budget\") { super(message); }\n    88\t}\n    89\t\n    90\t/** No typed artifact can preserve this authored key without exposing a credential. */\n    91\texport class McpFnStructuralCredentialCollisionError extends McpFnRedactionLimitError {\n    92\t  constructor() {\n    93\t    super(\"Credential collides with a required structural artifact key\");\n    94\t  }\n    95\t}\n    96\t\n    97\t// Only these locally authored envelope paths retain structural keys. Unknown\n    98\t// children (including inspector events and server metadata) are always payloads.\n    99\tconst envelopeKeys: Record<string, Set<string>> = Object.fromEntries(Object.entries({\n   100\t  root: \"formatVersion kind status runtime ok target server capabilities manifestChecked manifestHash total passed failed incomplete droppedResults droppedObservedEvents redactionOmittedObservedEvents incompleteReason failure timeline droppedTimelineEvents results count clientState tools resources resourceTemplates prompts droppedEvents timelineComplete droppedInventoryEntries inventoryComplete suiteVersion exitCode stdout stderr phase outcome code requestId at details payload\",\n   101\t  result: \"formatVersion name operation tool status sideEffect durationMs error droppedObservedEvents redactionOmittedObservedEvents\",\n   102\t  diagnostic: \"phase outcome code requestId at target details\",\n   103\t  inspectorEvent: \"formatVersion source kind at event\",\n   104\t  failure: \"name message layer code phase details\",\n   105\t  runtime: \"node scenarioFormatVersion reportSchemaVersion packages\",\n   106\t  packages: \"testing\",\n   107\t  droppedInventoryEntries: \"tools resources resourceTemplates prompts\",\n   108\t  target: \"kind\",\n   109\t}).map(([role, keys]) => [role, new Set(keys.split(\" \"))]));\n   110\t\n   111\tfunction specialValue(input: unknown): unknown {\n   112\t  if (input instanceof Error) {\n   113\t    // Error instances may expose attacker-controlled enumerable keys. A\n   114\t    // null-prototype accumulator keeps `__proto__` as ordinary payload data.\n   115\t    const normalized = Object.create(null) as Record<string, unknown>;\n   116\t    let enumerableFields = 0;\n   117\t    for (const key in input) {\n   118\t      if (!Object.hasOwn(input, key)) continue;\n   119\t      if (++enumerableFields > 100_000) throw new McpFnRedactionLimitError();\n   120\t      normalized[key] = (input as unknown as Record<string, unknown>)[key];\n   121\t    }\n   122\t    normalized.name = input.name;\n   123\t    normalized.message = input.message;\n   124\t    normalized.stack = input.stack;\n   125\t    if (input.cause !== undefined) normalized.cause = input.cause;\n   126\t    return normalized;\n   127\t  }\n   128\t  if (input instanceof Date) return Number.isNaN(input.getTime()) ? \"Invalid Date\" : input.toISOString();\n   129\t  if (input instanceof URL) return input.href;\n   130\t  if (input instanceof Map) {\n   131\t    if (Object.getOwnPropertyDescriptor(Map.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   132\t    return { type: \"Map\", entries: [...Map.prototype.entries.call(input)] };\n   133\t  }\n   134\t  if (input instanceof Set) {\n   135\t    if (Object.getOwnPropertyDescriptor(Set.prototype, \"size\")!.get!.call(input) > 100_000) throw new McpFnRedactionLimitError();\n   136\t    return { type: \"Set\", values: [...Set.prototype.values.call(input)] };\n   137\t  }\n   138\t  return input;\n   139\t}\n   140\t\n   141\tfunction scrubCredentials<T>(value: T, values: Iterable<string>, preserveKeys = false, redactionMarker?: string): T {\n   142\t  // Preserve whether a pattern came from opaque text or a serializer. Literal\n   143\t  // percent sequences in credentials must not acquire URL hex-case semantics.\n   144\t  const variants = [...values].filter(Boolean).flatMap(secret => [\n   145\t    { value: secret, encoded: false },\n   146\t    { value: JSON.stringify(secret).slice(1, -1), encoded: false },\n   147\t    { value: encodeURIComponent(secret), encoded: true },\n   148\t    { value: new URLSearchParams({ value: secret }).toString().slice(\"value=\".length), encoded: true },\n   149\t  ]).sort((a, b) => b.value.length - a.value.length);\n   150\t  let entries = 0, stringBytes = 0;\n   151\t  const budget = (input: unknown, depth = 0): void => {\n   152\t    input = specialValue(input);\n   153\t    if ((Array.isArray(input) && input.length > 100_000) || ++entries > 100_000 || depth > 32) throw new McpFnRedactionLimitError();\n   154\t    if (typeof input === \"string\") {\n   155\t      stringBytes += Buffer.byteLength(input);\n   156\t      if (input.length > 262_144 || stringBytes > 2_097_152) throw new McpFnRedactionLimitError();\n   157\t    } else if (input && typeof input === \"object\") {\n   158\t      for (const key in input) if (Object.hasOwn(input, key)) {\n   159\t        budget(key, depth + 1);\n   160\t        budget((input as Record<string, unknown>)[key], depth + 1);\n   161\t      }\n   162\t    }\n   163\t  };\n   164\t  // Check before either redactor allocates copies. Exceeding a budget is an\n   165\t  // explicit failure, never silent truncation of a typed report collection.\n   166\t  budget(value);\n   167\t  const patterns = variants.map(({ value, encoded }) => {\n   168\t    const literal = value.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n   169\t    // Only generated percent escapes accept mixed-case hex digits.\n   170\t    return encoded\n   171\t      ? literal.replace(/%[0-9A-Fa-f]{2}/g, escape => escape.replace(/[A-Fa-f]/g, hex => `[${hex.toLowerCase()}${hex.toUpperCase()}]`))\n   172\t      : literal;\n   173\t  });\n   174\t  const secretPattern = patterns.length ? new RegExp(patterns.join(\"|\"), \"g\") : undefined;\n   175\t  const replacementPattern = patterns.length ? new RegExp(patterns.join(\"|\")) : undefined;\n   176\t  const preserveStructural = (input: string): string => {\n   177\t    if (replacementPattern?.test(input)) {\n   178\t      throw new McpFnRedactionLimitError(\n   179\t        \"Credential collides with a required structural artifact field\",\n   180\t      );\n   181\t    }\n   182\t    return input;\n   183\t  };\n   184\t  const preserveStructuralKey = (input: string): string => {\n   185\t    if (replacementPattern?.test(input)) {\n   186\t      throw new McpFnStructuralCredentialCollisionError();\n   187\t    }\n   188\t    return input;\n   189\t  };\n   190\t  // A requested marker is itself output and must not reproduce a credential.\n   191\t  if (secretPattern) {\n   192\t    const markerContainsSecret = secretPattern.test(redactionMarker ?? \"[REDACTED]\");\n   193\t    secretPattern.lastIndex = 0;\n   194\t    if (markerContainsSecret) redactionMarker = \"\";\n   195\t  }\n   196\t  const clientKinds = new Set([\"logging.message\", \"progress\", \"tasks.status\", \"resources.updated\", \"tools.list_changed\", \"resources.list_changed\", \"prompts.list_changed\", \"resources.subscribed\", \"resources.unsubscribed\", \"client.roots\", \"client.sampling\", \"client.elicitation\"]);\n   197\t  const scrub = (input: unknown, role = \"payload\", field = \"\", finalPass = false): unknown => {\n   198\t    input = specialValue(input);\n   199\t    if (typeof input === \"string\") {\n   200\t      if ((role === \"root\" || role === \"inspectorEvent\") && field === \"kind\" && clientKinds.has(input)) return preserveStructural(input);\n   201\t      if (role === \"root\" && field === \"clientState\" && [\"idle\", \"connecting\", \"authorization-required\", \"connected\", \"closing\", \"closed\"].includes(input)) return preserveStructural(input);\n   202\t      if (role === \"target\" && field === \"kind\" && [\"authenticated-streamable-http\", \"streamable-http\", \"stdio\", \"in-memory\", \"custom\"].includes(input)) return preserveStructural(input);\n   203\t      if ((role === \"packages\" && field === \"testing\") || (role === \"runtime\" && [\"node\", \"reportSchemaVersion\"].includes(field)) || (role === \"root\" && field === \"suiteVersion\")) return preserveStructural(input);\n   204\t      if ((role === \"root\" || role === \"result\") && field === \"status\" && [\"passed\", \"failed\", \"incomplete\", \"complete\"].includes(input)) return preserveStructural(input);\n   205\t      if ((role === \"root\" || role === \"diagnostic\") && field === \"outcome\" && [\"started\", \"succeeded\", \"failed\"].includes(input)) return preserveStructural(input);\n   206\t      if (role === \"root\" && field === \"kind\" && [\"mcpfn.target-suite-report\", \"mcpfn.inspector-snapshot\", \"mcpfn.official-conformance-report\"].includes(input)) return preserveStructural(input);\n   207\t      if ((role === \"root\" || role === \"diagnostic\" || role === \"failure\") && field === \"phase\" && [\"resource-discovery\", \"authorization-server-discovery\", \"client-registration\", \"authorization-request\", \"authorization-callback\", \"token-exchange\", \"token-refresh\", \"token-revocation\", \"transport-connect\", \"mcp-initialize\", \"capability-operation\", \"transport-close\"].includes(input)) return preserveStructural(input);\n   208\t      if (role === \"failure\" && field === \"layer\" && [\"mcpfn-preflight\", \"authorization-server\", \"resource-server\", \"mcp-initialization\", \"scenario\", \"upstream-conformance\"].includes(input)) return preserveStructural(input);\n   209\t      if (role === \"inspectorEvent\" && field === \"source\" && [\"diagnostic\", \"client\"].includes(input)) return preserveStructural(input);\n   210\t      if (role === \"result\" && field === \"sideEffect\" && [\"none\", \"idempotent\", \"non-idempotent\"].includes(input)) return preserveStructural(input);\n   211\t      // Whole-string rejection cannot compose another credential by joining pieces.\n   212\t      // Run after both redactors; never feed this result through another redactor.\n   213\t      if (finalPass) return replacementPattern?.test(input) ? \"\" : input;\n   214\t      return secretPattern ? input.replace(secretPattern, secret => {\n   215\t        const replacement = redactionMarker ?? (secret.length < 10 ? (secret.includes(\"*\") ? \"#\" : \"*\").repeat(secret.length) : \"[REDACTED]\");\n   216\t        // Every generated mask must be safe against the entire credential set.\n   217\t        return replacementPattern!.test(replacement) ? \"\" : replacement;\n   218\t      }) : input;\n   219\t    }\n   220\t    if (Array.isArray(input)) {\n   221\t      const result = input.map(entry => scrub(entry, role, \"\", finalPass));\n   222\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   223\t      return result;\n   224\t    }\n   225\t    if (input && typeof input === \"object\") {\n   226\t      const entries: Array<[string, unknown]> = [];\n   227\t      const keys = new Set<string>();\n   228\t      for (const [key, entry] of Object.entries(input)) {\n   229\t        const fixed = envelopeKeys[role]?.has(key) ?? false;\n   230\t        if (fixed) preserveStructuralKey(key);\n   231\t        let childRole = \"payload\";\n   232\t        if (fixed) {\n   233\t          if (key === \"results\") childRole = \"result\";\n   234\t          else if (key === \"timeline\") childRole = (value as any)?.kind === \"mcpfn.inspector-snapshot\" ? \"inspectorEvent\" : \"diagnostic\";\n   235\t          else if ([\"failure\", \"runtime\", \"packages\", \"droppedInventoryEntries\", \"target\"].includes(key)) childRole = key;\n   236\t          else if (role === \"inspectorEvent\" && key === \"event\") childRole = (input as { source?: string }).source === \"client\" ? \"root\" : \"diagnostic\";\n   237\t        }\n   238\t        const scrubbedKey = fixed ? key : scrub(key, \"payload\", \"\", finalPass) as string;\n   239\t        if (keys.has(scrubbedKey)) {\n   240\t          throw new McpFnRedactionLimitError(\n   241\t            \"Credential redaction created duplicate object keys\",\n   242\t          );\n   243\t        }\n   244\t        keys.add(scrubbedKey);\n   245\t        entries.push([\n   246\t          scrubbedKey,\n   247\t          typeof entry === \"string\"\n   248\t            ? scrub(entry, fixed ? role : \"payload\", key, finalPass)\n   249\t            : scrub(entry, childRole, \"\", finalPass),\n   250\t        ]);\n   251\t      }\n   252\t      const result = Object.fromEntries(entries);\n   253\t      assertPayloadSerialization(result, role, finalPass, replacementPattern);\n   254\t      return result;\n   255\t    }\n   256\t    return input;\n   257\t  };\n   258\t  const timelineEvent = value && typeof value === \"object\" && [\"client\", \"diagnostic\"].includes((value as { source?: string }).source ?? \"\");\n   259\t  const role = preserveKeys ? (timelineEvent ? \"inspectorEvent\" : \"root\") : \"payload\";\n   260\t  const scrubbed = scrub(value, role);\n   261\t  const generic = redactOAuthValue(scrubbed, { maxStringLength: 262_144, maxDepth: 64, maxArrayEntries: 100_000, maxObjectEntries: 100_000, ...(redactionMarker !== undefined ? { redactionMarker } : {}) });\n   262\t  const result = scrub(generic, role, \"\", true) as T;\n   263\t  assertPayloadSerialization(\n   264\t    result,\n   265\t    \"payload\",\n   266\t    true,\n   267\t    replacementPattern,\n   268\t  );\n   269\t  return result;\n   270\t}\n   271\t\n   272\tfunction assertPayloadSerialization(\n   273\t  value: unknown,\n   274\t  role: string,\n   275\t  finalPass: boolean,\n   276\t  credentialPattern: RegExp | undefined,\n   277\t): void {\n   278\t  if (!finalPass || role !== \"payload\" || !credentialPattern) return;\n   279\t  const serialized = JSON.stringify(value);\n   280\t  if (serialized !== undefined && credentialPattern.test(serialized)) {\n   281\t    throw new McpFnRedactionLimitError(\n   282\t      \"Credential redaction could not guarantee safe serialized output\",\n   283\t    );\n   284\t  }\n   285\t}\n   286\t\n   287\t/** Remove known opaque credential values as well as credential-shaped fields. */\n   288\texport function redactTargetCredentials<T>(target: McpFnTarget, value: T, options: { preserveKeys?: boolean; redactionMarker?: string } = {}): T {\n   289\t  const state = targetSecrets.get(target);\n   290\t  return scrubCredentials(value, new Set([...(state?.active.keys() ?? []), ...[...(state?.scopes ?? [])].flatMap((scope) => [...scope])]), options.preserveKeys, options.redactionMarker);\n   291\t}\n   292\t\n   293\t/** Redact authenticated conformance output using the acquired credential. */\n   294\texport function redactRemoteCredential<T>(credential: McpFnRemoteCredential, value: T, options: { preserveKeys?: boolean } = {}): T {\n   295\t  return scrubCredentials(value, credentialValues(credential.headers), options.preserveKeys);\n   296\t}\n   297\t\n   298\tconst MAX_CREDENTIAL_HEADERS = 32;\n   299\tconst MAX_CREDENTIAL_HEADER_BYTES = 16_384;\n   300\tconst MAX_CREDENTIAL_HEADER_VALUE_BYTES = 8_192;\n   301\tconst FORBIDDEN_CREDENTIAL_HEADERS = new Set([\n   302\t  \"connection\",\n   303\t  \"content-length\",\n   304\t  \"host\",\n   305\t  \"proxy-connection\",\n   306\t  \"te\",\n   307\t  \"trailer\",\n   308\t  \"transfer-encoding\",\n   309\t  \"upgrade\",\n   310\t]);\n   311\t\n   312\texport type McpFnRemoteCredentialKind = \"api-key\" | \"oauth\" | \"custom\";\n   313\t\n   314\texport interface McpFnRemoteCredential {\n   315\t  /** Credential headers are applied only to the fixed target origin. */\n   316\t  headers: HeadersInit;\n   317\t  kind?: McpFnRemoteCredentialKind;\n   318\t  label?: string;\n   319\t}\n   320\t\n   321\texport interface McpFnRemoteCredentialContext {\n   322\t  url: string;\n   323\t  requestId: string;\n   324\t  signal?: AbortSignal;\n   325\t}\n   326\t\n   327\t/**\n   328\t * Application-owned credential lifecycle for external MCP targets. McpFn\n   329\t * acquires once per target open, revokes before disposal, and never serializes\n   330\t * the returned headers into descriptors or reports. If acquisition rejects, the\n   331\t * provider must roll back its own partial resources; no lease has been returned.\n   332\t */\n   333\texport interface McpFnRemoteCredentialProvider {\n   334\t  acquire(\n   335\t    context: McpFnRemoteCredentialContext,\n   336\t  ): McpFnRemoteCredential | Promise<McpFnRemoteCredential>;\n   337\t  revoke?(\n   338\t    credential: McpFnRemoteCredential,\n   3…6976 tokens truncated…MCPFN_TESTING_VERSION__;\n     9\texport const MCPFN_REPORT_SCHEMA_VERSION = \"1.0.0\";\n    10\t\n    11\texport type McpFnFailureLayer =\n    12\t  | \"mcpfn-preflight\"\n    13\t  | \"authorization-server\"\n    14\t  | \"resource-server\"\n    15\t  | \"mcp-initialization\"\n    16\t  | \"scenario\"\n    17\t  | \"upstream-conformance\";\n    18\t\n    19\texport interface McpFnReportFailure {\n    20\t  name: string;\n    21\t  message: string;\n    22\t  layer: McpFnFailureLayer;\n    23\t  code?: string;\n    24\t  phase?: string;\n    25\t  details?: Record<string, unknown>;\n    26\t}\n    27\t\n    28\texport interface McpFnJunitOptions {\n    29\t  /** Aggregate XML size cap after serialization. Defaults to 1 MiB. */\n    30\t  maxBytes?: number;\n    31\t}\n    32\t\n    33\texport function normalizeMcpFnReportFailure(\n    34\t  error: unknown,\n    35\t  fallbackPhase?: McpFnDiagnosticPhase | \"scenario\" | \"upstream-conformance\",\n    36\t): McpFnReportFailure {\n    37\t  const redacted = redactOAuthValue(error, {\n    38\t    maxDepth: 6,\n    39\t    maxArrayEntries: 50,\n    40\t    maxObjectEntries: 50,\n    41\t    maxStringLength: 2_048,\n    42\t  });\n    43\t  const record = redacted && typeof redacted === \"object\" && !Array.isArray(redacted)\n    44\t    ? redacted as Record<string, unknown>\n    45\t    : {};\n    46\t  const phase = stringField(record.phase) ?? fallbackPhase;\n    47\t  const details = record.details && typeof record.details === \"object\" &&\n    48\t      !Array.isArray(record.details)\n    49\t    ? record.details as Record<string, unknown>\n    50\t    : undefined;\n    51\t  let message = stringField(record.message) ?? String(\n    52\t    redactOAuthValue(error instanceof Error ? error.message : String(error)),\n    53\t  );\n    54\t  const cause = error && typeof error === \"object\"\n    55\t    ? (error as { cause?: unknown }).cause\n    56\t    : undefined;\n    57\t  const redactedCause = cause === undefined\n    58\t    ? undefined\n    59\t    : redactOAuthValue(cause, {\n    60\t      maxDepth: 4,\n    61\t      maxArrayEntries: 20,\n    62\t      maxObjectEntries: 20,\n    63\t      maxStringLength: 1_024,\n    64\t    });\n    65\t  const causeRecord = redactedCause && typeof redactedCause === \"object\" &&\n    66\t      !Array.isArray(redactedCause)\n    67\t    ? redactedCause as Record<string, unknown>\n    68\t    : undefined;\n    69\t  const causeMessage = stringField(causeRecord?.message);\n    70\t  if (causeMessage && !message.includes(causeMessage)) message = `${message}: ${causeMessage}`;\n    71\t  const combinedDetails = causeRecord\n    72\t    ? { ...(details ?? {}), cause: causeRecord }\n    73\t    : details;\n    74\t  return {\n    75\t    name: stringField(record.name) ?? \"Error\",\n    76\t    message,\n    77\t    layer: failureLayer(phase) !== \"authorization-server\" && [causeRecord?.code, causeRecord?.status, record.code, record.status].some(value => [401, 403].includes(Number(value)))\n    78\t      ? \"resource-server\" : failureLayer(phase),\n    79\t    ...(stringField(record.code) ? { code: stringField(record.code)! } : {}),\n    80\t    ...(phase ? { phase } : {}),\n    81\t    ...(combinedDetails ? { details: combinedDetails } : {}),\n    82\t  };\n    83\t}\n    84\t\n    85\t/** Serialize a redacted target-suite report as bounded JUnit XML. */\n    86\texport function createMcpFnTargetSuiteJUnit(\n    87\t  report: McpFnTargetSuiteReport,\n    88\t  options: McpFnJunitOptions = {},\n    89\t): string {\n    90\t  const maxBytes = options.maxBytes ?? 1_048_576;\n    91\t  validateArtifactCap(maxBytes);\n    92\t  const safe = redactOAuthValue(report, {\n    93\t    maxDepth: 10,\n    94\t    maxArrayEntries: 1_000,\n    95\t    maxObjectEntries: 200,\n    96\t    maxStringLength: 4_096,\n    97\t  }) as unknown as McpFnTargetSuiteReport;\n    98\t  // Redaction appends a string sentinel when an array exceeds its cap.\n    99\t  const results = safe.results.filter((result) => result && typeof result === \"object\" && typeof result.name === \"string\");\n   100\t  const omitted = report.results.length - results.length;\n   101\t  const cases = results.map((result) => {\n   102\t    const duration = Math.max(0, result.durationMs ?? 0) / 1_000;\n   103\t    const failure = result.status === \"passed\"\n   104\t      ? \"\"\n   105\t      : junitFailure(\n   106\t        result.error ?? `Scenario ${result.status}`,\n   107\t        result.status === \"failed\" ? \"scenario\" : \"incomplete\",\n   108\t      );\n   109\t    return `    <testcase name=\"${xml(result.name)}\" classname=\"mcpfn.scenario\" time=\"${duration.toFixed(3)}\">${failure}</testcase>`;\n   110\t  });\n   111\t  if (safe.failure) {\n   112\t    cases.unshift(\n   113\t      `    <testcase name=\"${xml(safe.failure.phase ?? \"target\")}\" classname=\"mcpfn.${xml(safe.failure.layer)}\" time=\"0.000\">${junitFailure(safe.failure.message, safe.failure.code ?? safe.failure.layer)}</testcase>`,\n   114\t    );\n   115\t  }\n   116\t  if (safe.status === \"incomplete\" || omitted > 0 || (!safe.ok && !safe.failure && results.every((result) => result.status === \"passed\"))) {\n   117\t    cases.push(`    <testcase name=\"suite-incomplete\" classname=\"mcpfn.report\" time=\"0.000\">${junitFailure(safe.incompleteReason ?? \"Suite evidence is incomplete or omitted\", \"incomplete\")}</testcase>`);\n   118\t  }\n   119\t  if (cases.length === 0) {\n   120\t    cases.push(\n   121\t      '    <testcase name=\"target-suite\" classname=\"mcpfn.target\" time=\"0.000\"></testcase>',\n   122\t    );\n   123\t  }\n   124\t  const failures = cases.filter((entry) => entry.includes(\"<failure \")).length;\n   125\t  let serialized = junitDocument(safe, cases, failures);\n   126\t  if (bytes(serialized) <= maxBytes) return serialized;\n   127\t\n   128\t  const boundedCases = [\n   129\t    `    <testcase name=\"artifact-cap\" classname=\"mcpfn.report\" time=\"0.000\">${junitFailure(\"JUnit content exceeded maxBytes and was truncated\", \"incomplete\")}</testcase>`,\n   130\t  ];\n   131\t  serialized = junitDocument(safe, boundedCases, 1, true);\n   132\t  if (bytes(serialized) > maxBytes) {\n   133\t    throw new Error(\"The minimum McpFn JUnit report exceeds maxBytes\");\n   134\t  }\n   135\t  return serialized;\n   136\t}\n   137\t\n   138\tfunction junitDocument(\n   139\t  report: McpFnTargetSuiteReport,\n   140\t  cases: string[],\n   141\t  failures: number,\n   142\t  truncated = false,\n   143\t): string {\n   144\t  const suiteName = String(redactOAuthValue(`mcpfn:${report.target.kind}`));\n   145\t  return [\n   146\t    '<?xml version=\"1.0\" encoding=\"UTF-8\"?>',\n   147\t    `<testsuite name=\"${xml(suiteName)}\" tests=\"${cases.length}\" failures=\"${failures}\" errors=\"0\" skipped=\"0\">`,\n   148\t    \"  <properties>\",\n   149\t    `    <property name=\"mcpfn.report.schema\" value=\"${xml(MCPFN_REPORT_SCHEMA_VERSION)}\"/>`,\n   150\t    `    <property name=\"mcpfn.testing.version\" value=\"${xml(MCPFN_TESTING_VERSION)}\"/>`,\n   110\t  } catch (error) {\n   111\t    if (owner) throw owner;\n   112\t    if (failureMessage) {\n   113\t      throw new McpFnClientError(\n   114\t        \"MCPFN_OPERATION_FAILED\",\n   115\t        failureMessage,\n   116\t        { phase: \"capability-operation\" },\n   117\t      );\n   118\t    }\n   119\t    throw error;\n   120\t  }\n   121\t}\n   122\t\n   123\texport async function runCli(\n   124\t  argv = process.argv.slice(2),\n   125\t  runOptions: CliRunOptions = {},\n   126\t): Promise<number> {\n   127\t  const cwd = runOptions.cwd ?? process.cwd();\n   128\t  const stdout = runOptions.stdout ?? ((text: string) => writeProcessOutput(process.stdout, text));\n   129\t  const stderr = runOptions.stderr ?? ((text: string) => writeProcessOutput(process.stderr, text));\n   130\t  let exitCode = 0;\n   131\t  const cli = cac(\"mcpfn\");\n   132\t\n   133\t  cli.command(\"manifest <source>\", \"Generate a canonical manifest from a server or registry module\")\n   134\t    .option(\"--output <path>\", \"Write the manifest to a file\")\n   135\t    .option(\"--name <name>\", \"Server name when source exports a registry\")\n   136\t    .option(\"--version <version>\", \"Server version when source exports a registry\")\n   137\t    .action(async (source: string, options: { output?: string; name?: string; version?: string }) => {\n   138\t      const info = options.name && options.version\n   139\t        ? { name: options.name, version: options.version }\n   140\t        : undefined;\n   141\t      const { manifest } = await loadManifestSource(source, cwd, info);\n   142\t      const serialized = `${JSON.stringify(manifest, null, 2)}\\n`;\n   143\t      if (options.output) {\n   144\t        const outputPath = path.resolve(cwd, options.output);\n   145\t        await writeFile(outputPath, serialized, \"utf8\");\n   146\t        await stdout(`Wrote ${outputPath}\\n`);\n   147\t      } else {\n   148\t        await stdout(serialized);\n   149\t      }\n   150\t    });\n   540\t      if (error) reject(error);\n   541\t      else resolve();\n   542\t    });\n   543\t  });\n   544\t}\n   545\t\n   546\tfunction readRemoteCredential(\n   547\t  options: RemoteAuthCliOptions,\n   548\t): { credential: McpFnRemoteCredential; environmentName: string } | undefined {\n   549\t  if (options.bearerTokenEnv && options.apiKeyEnv) {\n   550\t    throw new Error(\"Use only one of --bearer-token-env or --api-key-env\");\n   551\t  }\n   552\t  if (options.apiKeyHeader && !options.apiKeyEnv) {\n   553\t    throw new Error(\"--api-key-header requires --api-key-env\");\n   554\t  }\n   555\t  const environmentName = options.bearerTokenEnv ?? options.apiKeyEnv;\n   556\t  if (!environmentName) return undefined;\n   557\t  if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(environmentName)) {\n   558\t    throw new Error(\"Credential environment variable names must be portable identifiers\");\n   559\t  }\n   560\t  const value = process.env[environmentName];\n   561\t  if (value === undefined || value.length === 0) {\n   562\t    throw new Error(`Credential environment variable ${environmentName} is missing or empty`);\n   563\t  }\n   564\t  if (options.bearerTokenEnv) {\n   565\t    try { new Headers({ authorization: `Bearer ${value}` }); }\n   566\t    catch { throw new Error(\"Bearer token must be a valid HTTP header value\"); }\n   567\t    if (!/^[A-Za-z0-9._~+/-]+=*$/.test(value)) throw new Error(\"Bearer token must follow the RFC 6750 token grammar\");\n   568\t    return {\n   569\t      environmentName,\n   570\t      credential: {\n     1\timport type {\n     2\t  CallToolResult,\n     3\t  CreateTaskResult,\n     4\t  GetPromptResult,\n     5\t  Implementation,\n     6\t  Prompt,\n     7\t  ReadResourceResult,\n     8\t  Resource,\n     9\t  ResourceTemplate,\n    10\t  ServerCapabilities,\n    11\t  Tool,\n    12\t  Task,\n    13\t  ListTasksResult,\n    14\t} from \"@modelcontextprotocol/sdk/types.js\";\n    15\timport {\n    16\t  McpFnClient,\n    17\t  type McpFnClientOptions,\n    18\t  type McpFnClientEvent,\n    19\t  type McpFnDiagnosticEvent,\n    20\t  type McpFnTargetDescriptor,\n    21\t} from \"@mcpfn/client\";\n    22\timport {\n    23\t  createMcpFnScenario,\n    24\t  type McpFnScenario,\n    25\t} from \"@mcpfn/testing\";\n    26\t\n    27\tconst SCENARIO_REDACTION_LIMITS = {\n    28\t  maxDepth: 8,\n    29\t  maxArrayEntries: 100,\n    30\t  maxObjectEntries: 100,\n    31\t  maxStringLength: 2_048,\n    32\t} as const;\n    33\tconst SCENARIO_SECRET_MARKER = \"${MCPFN_SECRET}\";\n    34\tconst SCENARIO_SECRET_MARKERS = [\n    35\t  SCENARIO_SECRET_MARKER,\n    36\t  \"${SECRET}\",\n    37\t  \"${CREDENTIAL}\",\n    38\t  ...Array.from({ length: 26 }, (_, index) => `\\${${String.fromCharCode(65 + index)}}`),\n    39\t];\n    40\t\n    41\texport interface McpFnInspectorSnapshot {\n    42\t  formatVersion: 2;\n    43\t  kind: \"mcpfn.inspector-snapshot\";\n    44\t  target: McpFnTargetDescriptor;\n    45\t  clientState: string;\n    46\t  server?: Implementation;\n    47\t  capabilities?: ServerCapabilities;\n    48\t  tools: Tool[];\n    49\t  resources: Resource[];\n    50\t  resourceTemplates: ResourceTemplate[];\n   260\t      return {\n   261\t        formatVersion,\n   262\t        kind: safeKind,\n   263\t        sideEffect: safeSideEffect,\n   264\t        name: \"\",\n   265\t        status: this.client.preserveArtifactStructure(\"incomplete\"),\n   266\t        incompleteReason: this.client.redact(\n   267\t          \"Inspector export omitted payload because credential redaction failed\",\n   268\t          { preserveKeys: false, redactionMarker: \"\" },\n   269\t        ),\n   270\t      } as McpFnExportedScenario;\n   271\t    }\n   272\t    const replaced = redacted as unknown as McpFnExportedScenario;\n   273\t    const incompleteReason = secretMarker === undefined\n   274\t      ? \"Inspector export could not select a replayable redaction placeholder\"\n   275\t      : exceedsRedactionBounds(scenario, redacted, SCENARIO_REDACTION_LIMITS)\n   276\t        ? \"Inspector export exceeded redaction bounds and was truncated\"\n   277\t        : undefined;\n   278\t    const exported = incompleteReason\n   279\t      ? {\n   280\t        ...replaced,\n   281\t        status: this.client.preserveArtifactStructure(\"incomplete\"),\n   282\t        incompleteReason: this.client.redact(incompleteReason, {\n   283\t          preserveKeys: false,\n   284\t          redactionMarker: \"\",\n   285\t        }),\n   286\t      }\n   287\t      : replaced;\n   288\t    const variables = collectVariables(exported);\n   289\t    return variables.length ? { ...exported, variables } : exported;\n   290\t  }\n   300\t    let settled = false;\n   301\t    child.once(\"error\", (error) => {\n   302\t      if (settled) return;\n   303\t      settled = true;\n   304\t      const failure = normalizeMcpFnReportFailure(error, \"upstream-conformance\");\n   305\t      resolve({\n   306\t        formatVersion: 1,\n   307\t        kind: \"mcpfn.official-conformance-report\",\n   308\t        ok: false,\n   309\t        suiteVersion: OFFICIAL_CONFORMANCE_VERSION,\n   310\t        exitCode: 1,\n   311\t        stdout: \"\",\n   312\t        stderr: failure.message,\n   313\t        failure,\n   314\t      });\n   315\t    });\n   316\t    const finish = (code: number | null) => {\n   317\t      if (settled) return;\n   318\t      settled = true;\n   319\t      let exitCode = code ?? 1;\n   320\t      let safeStdout = \"\";\n   321\t      let safeStderr = \"\";\n   322\t      try {\n   323\t        if (outputExceeded) throw new Error(\"capture limit\");\n   324\t        safeStdout = redactOutput(stdout);\n   325\t        safeStderr = redactOutput(stderr);\n   326\t      } catch {\n   327\t        exitCode = 1;\n   328\t        safeStdout = \"\";\n   329\t        safeStderr = outputExceeded ? \"Conformance output exceeded its capture limit\" : \"Conformance output omitted because credential redaction exceeded its bounds\";\n   330\t      }\n   331\t      const failure = exitCode === 0\n   332\t        ? undefined\n   333\t        : normalizeMcpFnReportFailure(\n   334\t          new Error(safeStderr || safeStdout || `Official conformance exited ${exitCode}`),\n   335\t          \"upstream-conformance\",\n   336\t        );\n   337\t      resolve({\n   338\t        formatVersion: 1,\n   339\t        kind: \"mcpfn.official-conformance-report\",\n   340\t        ok: exitCode === 0,\n   341\t        suiteVersion: OFFICIAL_CONFORMANCE_VERSION,\n   342\t        exitCode,\n   343\t        stdout: safeStdout,\n   344\t        stderr: safeStderr,\n   345\t        ...(failure ? { failure } : {}),\n   346\t      });\n   347\t    };\n   348\t    child.once(\"close\", finish);\n   349\t  });\n   350\t}\n   351\t\n   352\tconst retainedConformanceCleanup = new WeakMap<Error, () => Promise<void>>();\n   353\t\n   354\t/** Cleanup failed after retries. Retain this error and call retryCleanup(). */\n   355\texport class McpFnConformanceCleanupError extends Error {\n   356\t  constructor(release: () => Promise<void>, readonly result?: OfficialConformanceResult) {\n   357\t    super(\"Authenticated conformance credential cleanup failed; retry cleanup\");\n   358\t    this.name = \"McpFnConformanceCleanupError\";\n   359\t    retainedConformanceCleanup.set(this, release);\n   360\t  }\n   361\t  async retryCleanup(): Promise<void> {\n   362\t    const release = retainedConformanceCleanup.get(this);\n   363\t    if (!release) return;\n   364\t    try { await release(); }\n   365\t    catch { throw this; }\n   366\t    retainedConformanceCleanup.delete(this);\n   367\t  }\n   368\t}\n   369\t\n   370\t/**\n   371\t * Run the pinned official suite against an authenticated MCP endpoint.\n   372\t * Always captures stdio (even when inherit is requested) to redact credentials.\n   373\t * outputDir is rejected before acquisition; only the returned redacted result is safe to persist.\n   374\t */\n   375\texport async function runAuthenticatedOfficialConformance(\n   376\t  options: AuthenticatedOfficialConformanceOptions,\n   377\t): Promise<OfficialConformanceResult> {\n   378\t  if (options.outputDir !== undefined) throw new TypeError(\"Authenticated conformance does not support outputDir; serialize the redacted result instead\");\n   379\t  const { headers, credential, ...conformance } = options;\n   380\t  if ((headers === undefined) === (credential === undefined)) {\n    25\t  authProvider?: OAuthClientProvider;\n    26\t}\n    27\t\n    28\tinterface StateValidatingOAuthProvider extends OAuthClientProvider {\n    29\t  validateAuthorizationState?(state: string | undefined): void | Promise<void>;\n    30\t  invalidatePendingAuthorization?(): void | Promise<void>;\n    31\t}\n    32\t\n    33\texport function customTarget(options: {\n    34\t  kind: string;\n    35\t  descriptor?: Record<string, unknown>;\n    36\t  open(context: McpFnTargetContext): Promise<McpFnTransportHandle> | McpFnTransportHandle;\n    37\t  cleanup?(): Promise<void>;\n    38\t  redact?: McpFnTarget[\"redact\"];\n    39\t}): McpFnTarget {\n    40\t  const descriptor = Object.freeze({ kind: options.kind, ...options.descriptor });\n    41\t  return {\n    42\t    kind: options.kind,\n    43\t    describe: () => ({ ...descriptor }),\n    44\t    open: (context) => Promise.resolve(options.open(context)),\n    45\t    ...(options.cleanup ? { cleanup: () => options.cleanup!() } : {}),\n    46\t    ...(options.redact ? { redact: options.redact } : {}),\n    47\t  };\n    48\t}\n    49\t\n    50\texport function transportTarget(\n    65\tasync function toWebRequest(request: IncomingMessage): Promise<Request> {\n    66\t  const chunks: Buffer[] = [];\n    67\t  for await (const chunk of request) {\n    68\t    chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk));\n    69\t  }\n    70\t  const body = Buffer.concat(chunks);\n    71\t  return new Request(\n    72\t    new URL(request.url ?? \"/\", `http://${request.headers.host ?? \"127.0.0.1\"}`),\n    73\t    {\n    74\t      method: request.method,\n    75\t      headers: new Headers(Object.entries(request.headers).flatMap(([name, value]) =>\n    76\t        Array.isArray(value)\n    77\t          ? value.map((entry) => [name, entry] as [string, string])\n    78\t          : value === undefined ? [] : [[name, value] as [string, string]],\n    79\t      )),\n    80\t      ...(body.length ? { body } : {}),\n    81\t    },\n    82\t  );\n    83\t}\n    84\t\n    85\tasync function sendWebResponse(response: ServerResponse, web: Response): Promise<void> {\n    86\t  response.writeHead(web.status, Object.fromEntries(web.headers));\n    87\t  if (!web.body) { response.end(); return; }\n    88\t  await pipeline(Readable.fromWeb(web.body as Parameters<typeof Readable.fromWeb>[0]), response);\n    89\t}\n    90\t\n   120\t  const chunks = [];\n   121\t  let size = 0;\n   122\t  for await (const chunk of incoming) {\n   123\t    const buffer = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);\n   124\t    size += buffer.length;\n   125\t    if (size > MAX_REQUEST_BYTES) throw new Error(\"Request body too large\");\n   126\t    chunks.push(buffer);\n   127\t  }\n   128\t  const body = Buffer.concat(chunks);\n   129\t  return new Request(url, {\n   130\t    method: incoming.method,\n   131\t    headers: new Headers(Object.entries(incoming.headers).flatMap(([name, value]) =>\n   132\t      Array.isArray(value)\n   133\t        ? value.map((entry) => [name, entry])\n   134\t        : value === undefined ? [] : [[name, value]],\n   135\t    )),\n   136\t    ...(body.length ? { body } : {}),\n   137\t  });\n   138\t}\n   139\t\n   140\tasync function sendWebResponse(outgoing, response) {\n   141\t  outgoing.writeHead(response.status, Object.fromEntries(response.headers));\n   142\t  if (!response.body) {\n   143\t    outgoing.end();\n   144\t    return;\n   145\t  }\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0b91a-027b-7173-bd75-a52040008bc7","create_time":1789812223.949936}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
