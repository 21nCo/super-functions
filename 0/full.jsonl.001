th(ad['paths']['tmp']);label='current213-native-cache';result=A/(label+'-result.json');assert not result.exists();env={**os.environ,'TMPDIR':str(tmp),'TMP':str(tmp),'TEMP':str(tmp),'TURBO_TELEMETRY_DISABLED':'1','DO_NOT_TRACK':'1','NODE_ENV':'production'};results=[]\nvariants=[('reference','1','https://dev.public.invalid','https://assets.invalid'),('public-only','1','https://public.invalid','https://assets.invalid'),('assets-only','1','https://dev.public.invalid','https://different.assets.invalid'),('deploy-only','0','https://dev.public.invalid','https://assets.invalid')]\nfor name,deploy,public,assets in variants:\n output=A/(label+'-'+name+'.json');assert not output.exists();r=subprocess.run([str(V/'node_modules/.bin/turbo'),'run','build','--filter=@extfn/docs','--filter=@authfn/docs','--filter=@filefn/docs','--env-mode=loose','--dry-run=json','--no-daemon','--cache-dir='+str(tmp/(label+'-cache'))],cwd=V,env={**env,'CLOUDFLARE_DOCS_DEPLOY':deploy,'CLOUDFLARE_DOCS_PUBLIC_ORIGIN':public,'CLOUDFLARE_DOCS_ASSETS_ORIGIN':assets},capture_output=True,text=True,timeout=120);(A/(label+'-'+name+'.stderr')).write_text(r.stderr);assert r.returncode==0,r.stderr;output.write_text(r.stdout);data=json.loads(r.stdout);tasks={t['taskId']:{'hash':t['hash'],'environmentVariables':t.get('environmentVariables')} for t in data['tasks'] if t['taskId'] in ['@extfn/docs#build','@authfn/docs#build','@filefn/docs#build']};assert len(tasks)==3;results.append({'variant':name,'deploy':deploy,'public':public,'assets':assets,'tasks':tasks,'globalCacheInputs':data.get('globalCacheInputs')})\nfor variant in results[1:]:\n for task in results[0]['tasks']:assert variant['tasks'][task]['hash']!=results[0]['tasks'][task]['hash'],(variant['variant'],task)\nout={'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'configurationOwner':str(V),'toolOwner':str(V/'node_modules/.bin/turbo'),'threeTasksDifferForEveryIndependentRoleChange':True,'actualInstalledCurrentRoot':True,'results':results,'buildTasksExecuted':False,'qualification':'Native actual Turbo hash/inherited globalEnv proof, not live deployment or unrelated cache/security clearance'};result.write_text(json.dumps(out,indent=2)+'\\n');print(json.dumps({'configurationOwner':str(V),'tasks':list(results[0]['tasks']),'variants':len(results),'allIndependentRoleHashesDiffer':True},indent=2))\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":401,"output":1031,"cacheRead":228480,"cacheWrite":0,"reasoning":263,"totalTokens":229912,"cost":{"input":0.000802,"output":0.010310000000000001,"cacheRead":0.022848000000000004,"cacheWrite":0,"total":0.033960000000000004}},"stopReason":"toolUse","timestamp":1791352081093,"responseId":"resp_055fb762f51dfcfc016ac5dd11e6d487d080355cb9de67a75f","rawStopReason":"completed","thinkingLevel":"high"}}
