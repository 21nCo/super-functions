ut/server/index.js')));\nconst { manifest } = await import(pathToFileURL(path.join(owner, '.svelte-kit/output/server/manifest.js')));\nconst server = new Server(manifest); await server.init({ env: {} });\nconst origin = `https://${product}.com`;\nconst get = async (route, status = 200) => { const response = await server.respond(new Request(origin + route), { getClientAddress: () => '127.0.0.1' }); assert.equal(response.status, status, route); return response; };\nconst flat = await (await get('/docs/__native213_flat')).text();\nassert(flat.includes('href=\"/docs/__native213_sibling\"'), 'Actual flat.md with descendants must still resolve sibling links from the filename directory');\nconst index = await (await get('/docs/__native213_index')).text();\nassert(index.includes('href=\"/docs/__native213_sibling\"'), 'Index filename links retain their own directory semantics');\nconst unicode = await (await get('/docs/__native213_unicode/%E4%B8%BB')).text(); assert(unicode.includes('Native213 Unicode'));\nconst missing = await get('/docs/__pr213_missing__', 404), html = await missing.text();\nconst titles = [...html.matchAll(/<title[^>]*>([\\s\\S]*?)<\\/title>/g)]; assert.equal(titles.length, 1); assert(titles[0][1].includes('404'));\nconst data = await (await get('/docs/__native213_flat/__data.json')).json();\nconst nodes = data.nodes.filter(node => node?.type === 'data').map(node => unflatten(node.data));\nconst layout = nodes.find(node => node.source); assert.deepEqual(Object.keys(layout.source).sort(), ['config', 'siteTitle']);\nassert.deepEqual(Object.keys(layout.source.config).sort(), ['navigation', 'site']);\nassert(!JSON.stringify(nodes).includes('PRIVATE_213_DOC_TOKEN'), 'Unrelated complete content cannot enter approved client DTO');\nfor (const node of nodes) for (const field of ['manifest', 'searchArtifact', 'searchDocumentCount', 'searchScopes', 'compatPreset']) assert(!(field in node));\nconst page = nodes.find(node => node.compiled); assert(page);\nassert.deepEqual(Object.keys(page).sort(), ['compiled', 'routeEntry', 'sidebar', 'siteTitle', 'surface']);\nassert.deepEqual(page.routeEntry, { kind: 'page' });\nconsole.log(JSON.stringify({ product, physicalOwner: owner, actualCompiledFlatAndIndexLinks: '/docs/__native213_sibling', nativeUnicode: true, decodedLayoutAndPageDtoAllowlist: true, privateSiblingNotSerialized: true, missingStatus: missing.status, singleErrorTitle: true, qualification: 'Actual per-owner compiled Kit/devalue/public SDK behavior with controlled isolated inputs, not full security/live/platform clearance' }));\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":232,"output":1358,"cacheRead":247552,"cacheWrite":0,"reasoning":516,"totalTokens":249142,"cost":{"input":0.000464,"output":0.013580000000000002,"cacheRead":0.0247552,"cacheWrite":0,"total":0.038799200000000006}},"stopReason":"toolUse","timestamp":1791352467441,"responseId":"resp_055fb762f51dfcfc016ac5de9453e087d0a9b6c92830148cd0","rawStopReason":"completed","thinkingLevel":"high"}}
