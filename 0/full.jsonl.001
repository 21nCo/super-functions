Bbot%5D/followers\",\"following_url\":\"https://api.github.com/users/pullfrog%5Bbot%5D/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/pullfrog%5Bbot%5D/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/pullfrog%5Bbot%5D/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/pullfrog%5Bbot%5D/subscriptions\",\"organizations_url\":\"https://api.github.com/users/pullfrog%5Bbot%5D/orgs\",\"repos_url\":\"https://api.github.com/users/pullfrog%5Bbot%5D/repos\",\"events_url\":\"https://api.github.com/users/pullfrog%5Bbot%5D/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/pullfrog%5Bbot%5D/received_events\",\"type\":\"Bot\",\"user_view_type\":\"public\",\"site_admin\":false},\"body\":\"> [!CAUTION]\\n> The prior P1 serialized-output finding remains only partially fixed, and the new key-substitution path can silently alter scenarios.\\n\\n`mcpfn/testing/src/remote-target.ts:191` limits the new serialization check to `role === \\\"payload\\\"`. Preserved envelopes therefore still bypass the boundary check: with credential `foo\\\":\\\"bar`, `redactRemoteCredential(credential, { target: { kind: \\\"custom\\\", foo: \\\"bar\\\" } }, { preserveKeys: true })` returns an object whose compact JSON contains the credential across the nested key/value separator. The final serialized artifact, or every enclosing role, must be checked without corrupting protected structural literals.\\n\\nThe mixed ESM/CommonJS omission-provenance finding is addressed by the client-instance method and mixed-entry release-gate probe; that prior thread has been resolved. `git diff --check` passes, as do the remote McpFn release gate, Node 18 CommonJS, and Node 20 compatibility checks. Local Vitest remained unavailable because root `npm ci` fails on missing Turbo platform lock records.\\n\\n<!-- PULLFROG_DIVIDER_DO_NOT_REMOVE_PLZ -->\\n<sup><a href=\\\"https://pullfrog.com\\\"><picture><source media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://pullfrog.com/logos/frog-white-full-18px.png\\\"><img src=\\\"https://pullfrog.com/logos/frog-green-full-18px.png\\\" width=\\\"9px\\\" height=\\\"9px\\\" style=\\\"vertical-align: middle; \\\" alt=\\\"Pullfrog\\\"></picture></a>&nbsp;&nbsp;｜ [Fix all ➔](https://pullfrog.com/trigger/21nCo/super-functions/170?action=fix&review_id=5209502883) ｜ [Fix 👍s ➔](https://pullfrog.com/trigger/21nCo/super-functions/170?action=fix-approved&review_id=5209502883) ｜ [View workflow run](https://github.com/21nCo/super-functions/actions/runs/34963261185/job/104361630625) ｜ Using `GPT Sol` ｜ [𝕏](https://x.com/pullfrogai)</sup>\",\"state\":\"COMMENTED\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/170#pullrequestreview-5209502883\",\"pull_request_url\":\"https://api.github.com/repos/21nCo/super-functions/pulls/170\",\"author_association\":\"NONE\",\"_links\":{\"html\":{\"href\":\"https://github.com/21nCo/super-functions/pull/170#pullrequestreview-5209502883\"},\"pull_request\":{\"href\":\"https://api.github.com/repos/21nCo/super-functions/pulls/170\"}},\"submitted_at\":\"2026-09-15T11:44:28Z\",\"commit_id\":\"1e27fd69af0c741bf68edfdc4d1611d7b647f90e\"},{\"id\":5210441955,\"node_id\":\"PRR_kwDOP-e7KM8AAAABNpEI4w\",\"user\":{\"login\":\"cubic-dev-ai[bot]\",\"id\":191113872,\"node_id\":\"BOT_kgDOC2QqkA\",\"avatar_url\":\"https://avatars.githubusercontent.com/in/1082092?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D\",\"html_url\":\"https://github.com/apps/cubic-dev-ai\",\"followers_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/followers\",\"following_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/subscr