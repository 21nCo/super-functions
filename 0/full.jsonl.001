after:$endCursor)` and separate `isOutdated` from current unresolved threads; snapshot base/head OIDs, commits, local exact-head source, and hosted checks independently. The captured head `aa08ef72e` was open/mergeable but `UNSTABLE`, with 34 current unresolved threads and 10 pending checks; do not call it merge-ready from focused tests or resolved threads. [Task 3]\n\n--- current head ---\ncodex/mcp-1-transport-neutral-conformance-0910\ncf76637ada4ba0263e36f30c23a278826c48dd0a\n?? .conduct/\n\n--- sonar auth ---\nVerifying token......\n[✓ Connected]\nServer  https://sonarcloud.io\nOrg     21nco\nSource  OS Keychain\n","type":"input_text"}],"type":"custom_tool_call_output"},{"encrypted_content":"REDACTED","id":"rs_05349b17f5ad9d6a016aae5b6d68f887d0bb2b40c6f51d27df","internal_chat_message_metadata_passthrough":{"turn_id":"01a0b914-adb8-75d2-a690-fafe68c720b9"},"summary":[{"text":"**Planning query output formatting**","type":"summary_text"},{"text":"**Designing TOON output parsing pipeline**","type":"summary_text"}],"type":"reasoning"},{"call_id":"call_3Xp3hoLhMwTxSXIwJFPFXMju","id":"ctc_05349b17f5ad9d6a016aae5b74de8c87d08eeaebcf4983408a","input":"const r = await tools.exec_command({cmd:\"sonar list issues -p 21nCo_super-functions --pull-request 170 --format toon --page-size 500 | awk '/^total:|^effortTotal:|^    rule:|^    severity:|^    component:|^    line:|^    message:|^    effort:/{print}'\",\"workdir\":\"/Users/serro/Documents/dev/n/worktrees/superfunctions/PR-170\",\"yield_time_ms\":30000,\"max_output_tokens\":20000}); text(r.output);\n","internal_chat_message_metadata_passthrough":{"create_time":1789811563.260998,"turn_id":"01a0b914-adb8-75d2-a690-fafe68c720b9"},"name":"exec","status":"completed","type":"custom_tool_call"},{"call_id":"call_3Xp3hoLhMwTxSXIwJFPFXMju","id":"ctco_01a0b915-4bc0-7433-98e7-d3387986fcd6","internal_chat_message_metadata_passthrough":{"create_time":1789811575.744549,"turn_id":"01a0b914-adb8-75d2-a690-fafe68c720b9"},"output":[{"text":"S