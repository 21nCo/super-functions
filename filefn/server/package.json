{
  "name": "@filefn/server",
  "version": "0.1.1",
  "description": "FileFn server SDK for file upload/download handling",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": ["file", "upload", "server", "filefn"],
  "author": "21n",
  "license": "MIT",
  "bugs": { "url": "https://github.com/21nCo/super-functions/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "filefn/server"
  },
  "publishConfig": { "access": "public" },
  "superfunctions": {
    "initFunction": "createFileFn",
    "schemaVersion": 1,
    "libraryNames": [
      "filefn"
    ]
  },
  "dependencies": {
    "@filefn/processing": "0.1.1",
    "@superfunctions/storage": "0.1.0",
    "@superfunctions/files": "0.1.0",
    "@superfunctions/db": "0.1.4",
    "@superfunctions/http": "0.1.3",
    "@superfunctions/middleware": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
