{
  "name": "@mdfn/source",
  "version": "0.1.0",
  "description": "Source editor, diagnostics, and source-visual synchronization for mdfn",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" } },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "test": "vitest run --config ../vitest.config.ts --root .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@mdfn/core": "0.1.0",
    "@mdfn/markdown": "0.1.0",
    "@mdfn/render": "0.1.0"
  },
  "devDependencies": { "jsdom": "^26.0.0", "tsup": "^8.0.0", "typescript": "^5.3.0", "vitest": "3.2.4" },
  "files": ["dist", "README.md"],
  "license": "MIT",
  "engines": { "node": ">=20 <25" },
  "repository": { "type": "git", "url": "git+https://github.com/21nCo/super-functions.git", "directory": "mdfn/source" },
  "publishConfig": { "access": "public" },
  "sideEffects": false,
  "mdfn": { "status": "stable-candidate", "layer": "browser", "schemaVersion": 1, "kernel": "codemirror" }
}
