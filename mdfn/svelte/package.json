{
  "name": "@mdfn/svelte",
  "version": "0.1.0",
  "description": "Svelte lifecycle and rendering bindings for the shared mdfn editor engine",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": { ".": { "types": "./dist/index.d.ts", "browser": "./dist/index.js", "node": "./dist/index.node.js", "svelte": "./dist/index.js", "import": "./dist/index.js", "default": "./dist/index.js" } },
  "scripts": {
    "build": "svelte-package -i src -o dist --tsconfig ./tsconfig.json && vite build --config vite.ssr.config.ts",
    "test": "vitest run --config vitest.config.ts --root .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "svelte-check --tsconfig ./tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": { "@mdfn/core": "0.1.0", "@mdfn/dom": "0.1.0", "@mdfn/source": "0.1.0", "@mdfn/adapter-kit": "0.1.0" },
  "peerDependencies": { "svelte": ">=5.0.0 <6" },
  "devDependencies": { "@mdfn/markdown": "0.1.0", "@sveltejs/package": "^2.5.8", "@sveltejs/vite-plugin-svelte": "^5.1.1", "jsdom": "^26.0.0", "svelte": "5.57.2", "svelte-check": "^4.7.3", "typescript": "^5.3.0", "vite": "^6.4.4", "vitest": "4.1.11" },
  "files": ["dist", "README.md"],
  "license": "MIT",
  "engines": { "node": ">=20 <25" },
  "repository": { "type": "git", "url": "git+https://github.com/21nCo/super-functions.git", "directory": "mdfn/svelte" },
  "publishConfig": { "access": "public" },
  "sideEffects": ["**/*.svelte"],
  "mdfn": { "status": "stable-candidate", "layer": "adapter", "framework": "svelte", "schemaVersion": 1 }
}
