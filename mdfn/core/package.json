{
  "name": "@mdfn/core",
  "version": "0.1.0",
  "description": "Environment-neutral document, transaction, command, history, extension, and migration engine for mdfn",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" } },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "devDependencies": { "tsup": "^8.0.0", "typescript": "^5.3.0", "vitest": "3.2.4" },
  "files": ["dist", "README.md"],
  "license": "MIT",
  "engines": { "node": ">=20 <25" },
  "repository": { "type": "git", "url": "git+https://github.com/21nCo/super-functions.git", "directory": "mdfn/core" },
  "publishConfig": { "access": "public" },
  "sideEffects": false,
  "mdfn": { "status": "stable-candidate", "layer": "core", "schemaVersion": 1 }
}
