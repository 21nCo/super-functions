{
  "name": "@mdfn/docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 6022",
    "build": "vite build",
    "preview": "vite preview --port 6022",
    "validate": "docsfn validate --root .",
    "test": "npm run check:llms && vitest run --config ../../scripts/docs-site/vitest.config.ts",
    "generate:llms": "node scripts/generate-llms.mjs",
    "prebuild": "npm run generate:llms",
    "check:llms": "node scripts/generate-llms.mjs --check"
  },
  "dependencies": {
    "@21n/fonts": "^1.0.1",
    "@docsfn/core": "0.0.5",
    "@docsfn/provider-fs": "0.0.2",
    "@docsfn/svelte": "0.0.3",
    "@docsfn/sveltekit": "0.0.2",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@docsfn/cli": "0.0.2",
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/adapter-cloudflare": "^7.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.0.0",
    "svelte": "^5.55.7",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.4",
    "yaml": "^2.8.2"
  }
}
