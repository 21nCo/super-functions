{
  "name": "@apifn/docsfn",
  "version": "0.0.2",
  "description": "docsfn plugin for ApiFn API reference",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./svelte": {
      "svelte": "./src/svelte/ApifnApiReference.svelte",
      "default": "./src/svelte/ApifnApiReference.svelte"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest --run"
  },
  "dependencies": {
    "@apifn/core": "0.0.2",
    "@apifn/react": "0.0.2",
    "@apifn/svelte": "0.0.2"
  },
  "peerDependencies": {
    "docsfn": "*",
    "react": "^18.0.0 || ^19.0.0",
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "docsfn": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  },
  "author": "21n",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "apifn/docsfn"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src/svelte"
  ]
}
